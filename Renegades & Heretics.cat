    <profile id="9fd3e50c-5d5b-71fc-95e7-69e4936f26fb-771e3" name="Destroyer Tank Hunter" page="51" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
        <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">14</characteristic>
