  </entryLinks><categoryEntries><categoryEntry name="Max Strength Traitors" id="da37-ecf0-576c-8d3a" hidden="true">
      <constraints>
        <constraint id="8eef-d016-8a94-db2a" field="selections" includeChildSelections="true" message="Due to the mission type and the Troop choices in the army so far, at least {value} Traitor units must be at max strength. Currently there are {current}." scope="force" shared="true" type="min" value="0" />
      </constraints>
      <modifiers>
        <modifier field="8eef-d016-8a94-db2a" type="set" value="2">
          <comment>This sets the Min to 2 when there 2 traitor units chosen and there are no other troops chosen.</comment>
          <conditionGroups>
            <conditionGroup type="or">
              <conditionGroups>
                <conditionGroup type="and">
                  <comment>Standard Missions require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="2" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" scope="mh-test-force" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Apoc Missions require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="2" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="949f-fced-04a6-c467" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Battle Defender require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="2" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="5d5f-cfa8-2970-4a50" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Raid Defender require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="2" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="b1dd-a74a-0fe1-35b8" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Breakthrough Defender require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="2" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="90e9-2e2f-1754-4917" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="8eef-d016-8a94-db2a" type="set" value="1">
          <comment>This sets the Min to 1 when at least one more troop was chosen (except for the missions requiring 1 troop...then when no other troops were chosen)</comment>
          <conditionGroups>
            <conditionGroup type="or">
              <conditionGroups>
                <conditionGroup type="and">
                  <comment>Standard Missions require 2 troops</comment>
                  <conditions>
                    <condition childId="any" field="selections" scope="mh-test-force" shared="true" type="instanceOf" value="1" />
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="greaterThan" value="0" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Apoc Missions require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="1" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="949f-fced-04a6-c467" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Battle Attacker require 1 troops</comment>
                  <conditions>
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="3f32-74fc-e29a-38e3" shared="true" type="instanceOf" value="1" />
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Battle Defender require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="1" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="5d5f-cfa8-2970-4a50" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Raid Attackers require 1 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" includeChildForces="true" includeChildSelections="true" scope="f0b5-294d-9445-a1b7" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Raid Defender require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="1" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="b1dd-a74a-0fe1-35b8" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Breakthrough Attacker require 1 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="172d-d416-c92b-3694" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
                <conditionGroup type="and">
                  <comment>Breakthrough Defender require 2 troops</comment>
                  <conditions>
                    <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                    <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="1" />
                    <condition childId="any" field="selections" includeChildSelections="true" scope="90e9-2e2f-1754-4917" shared="true" type="instanceOf" value="1" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="8eef-d016-8a94-db2a" type="set" value="1">
          <comment>This sets the Min to 1 when only 1 traitor was chosen and no other troops (so the warning message isn't weird).</comment>
          <conditions>
            <condition childId="4620-717e-bda2-802e" childName="Traitors" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="1" />
            <condition childId="6d8b-4fb5-e31a-e146" childName="Non-Traitor Troops" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
          </conditions>
        </modifier>
      </modifiers>
    </categoryEntry>
    <categoryEntry name="Non-Traitor Troops" id="6d8b-4fb5-e31a-e146" hidden="true" />
