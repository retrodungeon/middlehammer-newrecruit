            <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Blessing</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12"</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">A unit affected by this power gains the Fleet and Crusader special rules for its duration.</characteristic>
          </characteristics>
        </profile>
        <profile id="1fd3-4b4c-2ad0-e80f-771e3" name="Warp Flux" page="241" hidden="false" typeId="9c33-b0c8-74bd-e5a7" typeName="Psychic Power (Attack)">
