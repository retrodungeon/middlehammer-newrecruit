      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All infantry units from same Primary detachment with one or more models within 12" of the unit with the Banner of Hate roll 3D6 for Pinning and Morale, choosing the two lowest results.</characteristic>
      </characteristics>
    </profile>
    <profile id="ef03a2a3-287f-96e9-f9b6-570fb184cd1f-771e3" name="Banner of the Apostate" page="236" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Infantry unit carrying the Banner of the Apostate adds +1 to their score to determine which side wins an assault. The effects of multiple banners are not cumulative.</characteristic>
      </characteristics>
    </profile>
