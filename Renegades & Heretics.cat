    <profile id="b513ac41-1f57-fee1-6f8f-e8be75290a02-771e3" name="Psychic - Creeping Terror" page="241" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Malediction, Warp Charge 1, targets a single enemy unit within 12". The target unit has I1 and may only fire Snap Shots until the end of that unit's next turn. Units with Fearless are unaffected. Units with And They Shall Know No Fear, or Stubborn, may attempt an Ld test to ignore the effects if they pass.</characteristic>
      </characteristics>
    </profile>
    <profile id="0b9a8e86-3b8b-eb0f-a0b9-8d52529a8a28-771e3" name="Psychic - Gift of Contagion" page="71" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Malediction, Warp Charge 1, affects a single enemy unit within 48". Roll D3 for the effect on every model in the unit whilst the power is in effect. Multiple effects are cumulative. 1: Flyblown Palsy: -1A and Shrouded. 2: Muscular Atrophy: -1S and may not Run. 3: Liquefying Ague: -1S and -1T.</characteristic>
      </characteristics>
    </profile>
    <profile id="db02f73c-790e-4ba2-face-374feb4b7f99-771e3" name="Psychic - Nurgle's Rot" page="71" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">6</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">2</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Nova, Warp Charge 1, Assault D6+1, Poisoned (4+)</characteristic>
      </characteristics>
    </profile>
    <profile id="58a663f0-4a0f-9787-abb4-0685e80f0e1d-771e3" name="Psychic - Unnatural Vigour" page="241" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Blessing, Warp Charge 1, may target any friendly unit within 12". Unit affected gains Fleet and Crusader for the duration.</characteristic>
      </characteristics>
    </profile>
