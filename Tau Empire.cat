          </infoLinks>
          <profiles>
            <profile name="Honour Guard" id="d46d-e63c-6d0c-bf0a" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
              <characteristics>
                <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
                <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">4</characteristic>
