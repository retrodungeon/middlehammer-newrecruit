    <selectionEntry id="79fb-04c9-f70f-802f-a9821" name="The Eight" page="82" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="c00b-0706-6e05-3535-a9821" name="Inspiring Leaders" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>As long as at least one model from this Formation is still alive and on the battlefield, all friendly units with the Tau Empire Faction have the Subborn special rule.</description>
        </rule>
        <rule id="fe3d-4a6f-528a-c4a9-a9821" name="Unbreakable Bonds of Comradeship" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units from this Formation that have the Supporting Fire special rule can provide Supporting Fire to any other model in this Formation if they are within 24" of each other, rather than 6".</description>
        </rule>
