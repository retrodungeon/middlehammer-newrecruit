4696f6e23232344415441232323">At the Initiative 10 step, this item inflicts D6 S4 AP- hits on each enemy unit that charged the bearer, or his unit, this turn.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="adbe1d98-df0a-349f-5982-b356716b9915-6e23de5" name="Riptide battlesuit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="70"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Comes equipped with multi-tracker and blacksun filter.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c79280b3-f609-b4b2-2763-a13aa971f00e-6e23de5" name="Riptide Shas'vre" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="45"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Monstrous Creature</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">6</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">6</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">5</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">2</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/5++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7751a914-5eab-3447-f553-3989f3a9d667-6e23de5" name="Riptide Shield Generator" hidden="false" typeId="mh6-576172676