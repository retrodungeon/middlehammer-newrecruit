            <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Dawn Blade" id="4fb4-d113-3d4b-940d" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">No armour saves may be taken from hits caused by the dawn blade and O'Shovah rolls 2D6+5 when rolling to penetrate the armour of the vehicle.</characteristic>
          </characteristics>
        </profile>
        <profile name="Special Character" id="9752-7a88-a8fc-b95b" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">May not be included in a force with Aun'Va or Commander Shadowsun.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ork Fighter" id="b1c3-751f-7626-e944" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any Tau model in an army led by O'Shovah counts as having the Preferred Enemy special rule when fighting Orks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Breakaway Faction" id="1cc8-e4bf-720c-231c" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">No Ethereals, Kroot or Vespid units may be included in O'Shovah's force. You may only include a maximum of one Stealth Armour, Pathfinder Squads, Hammerhead, Broadside Battlesuits, Sky Ray gunships and Piranha Skimmers.</characteristic>
          </characteristics>
        </profile>
        <profile name="Blood Brothers" id="75f9-6759-c335-dae7" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Every model in Farsight's army with access to the Armoury gains a bonding knife at no additional cost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
