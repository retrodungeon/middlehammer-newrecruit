characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="2e4c8d16-a25b-edc1-5cfe-66c4739147fa-6e23de5" name="Onager Gauntlet" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="73"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">In the Fight sub-phase, this model can opt to substitute all his close combat attacks for a S10 AP1 attack.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="e56cb8f4-0144-427d-ec2d-119ce888f9fa-6e23de5" name="Orca" hidden="false" typeId="mh6-56656869636c6520285375706572204865617679205472616e73706f72742923232344415441232323" typeName="Vehicle (Super Heavy Transport)" page="189"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Structure Points" typeId="mh6-53747275637475726520506f696e747323232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer, Hover, Transport</characteristic><characteristic name="Transport Capacity" typeId="mh6-5472616e73706f727420436170616369747923232344415441232323">57</characteristic><characteristic name="Fire Points" typeId="mh6-4669