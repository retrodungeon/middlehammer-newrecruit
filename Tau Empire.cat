    <selectionEntry id="8aed-5435-9d49-3e8b-a9821" name="Rapid Insertion Force" page="73" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="954b-7982-7e0f-338b-a9821" name="Locked Coordinates" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Stealth Battlesuits in the Rapid Insertion Force must begin the game deployed on the battlefield. The rest of the forces in the Formation must be held in Reserve and arrive by Deep Strike. Any Crisis Battlesuits or Riptides from the Formation that choose to Deep Strike within 6" of this unit of Stealth Battlesuits do not scatter, and count all their weapons as Twin-linked in the ensuing Shooting phase.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
