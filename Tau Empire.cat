    <selectionEntry name="Aun'Va and Honour Guard" id="84fc-0a0c-b091-e728" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="205" />
      </costs>
      <profiles>
        <profile name="Aun'Va" id="a4a4-46e5-5a19-baec" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
          <characteristics>
            <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">1</characteristic>
            <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">3</characteristic>
            <characteristic name="S" typeId="09af-e927-0c3c-9d88">2</characteristic>
            <characteristic name="T" typeId="ff29-f8b2-5b20-b686">3(5)</characteristic>
            <characteristic name="W" typeId="4a81-ac45-a71c-c71e">4</characteristic>
            <characteristic name="I" typeId="8517-a46c-d6df-9c75">1</characteristic>
            <characteristic name="A" typeId="a535-0722-3bc1-4d3c">1</characteristic>
            <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
            <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">4+*</characteristic>
          </characteristics>
        </profile>
        <profile name="The Paradox of Duality" id="6a8c-8aa8-102e-03f1" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">This wargear grants Aun'Va and his Honour guard an increased Toughness characteristic (the unmodified value is used for the purposes of Instant Death) and a 4+ Cover Save, which may be re-rolled if it is failed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supremely Inspiring Presence" id="949a-6e35-4eb5-6f0f" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">All Tau units (not Kroot, Vespid or Drones) with a line of sight to Aun'Va are counted as Stubborn. If the Night Fighting rules are in use, roll to determine if the unit can see the Ethereal.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ultimate Price of Failure" id="c3e9-94c0-080f-f245" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Should Aun'Va be removed as a casualty, every Tau unit on the table (not Kroot, Vespid or drones) must take a Morale check if they are not in close combat or falling back. Every unit that takes the test gains the Preferred Enemy universal special rule in relation to the enemy army, and in addition gains the Furious Charge universal special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Honour Guard" id="c4c6-aa94-3f7a-40e4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4a50-b403-3d18-60db-min" field="selections" scope="parent" shared="true" type="min" value="2" />
            <constraint id="4a50-b403-3d18-60db-max" field="selections" scope="parent" shared="true" type="max" value="2" />
          </constraints>
          <infoLinks>
