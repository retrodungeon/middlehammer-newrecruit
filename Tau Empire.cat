    <selectionEntry id="d3da-a4e7-0471-1f1e-a9821" name="The Mirrorcodex" page="85" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="f987-1f7f-25a2-81bd-a9821" name="The Mirrorcodex" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model in your army has the Mirrorcodex, you can add 1 to your dice roll when Seizing the Initiative. Furthermore, if a model in your army is bearing the Mirrorcodex, roll a D6 at the beginning of each of your turns and consult the table below. The effects listed affect the bearer and all friendly units within 6", and last until the end of the turn.   1-3    No Effect  4       Preferred Enemy (Space Marines)  5       Preferred Enemy (Space Marines and Astra Militarum)  6       Preferred Enemy</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
      <infoLinks>
        <infoLink id="75f7-0204-e895-5c80-a9821" hidden="false" targetId="f217-b311-e5b1-c8c7" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
      </infoLinks>
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d3da-a4e7-0471-1f1e-maxSelections-a9821" type="max" />
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d3da-a4e7-0471-1f1e-maxInRoster-a9821" type="max" />
      </constraints>
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks />
      <costs>
        <cost name="Points" value="50.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="895f-f16f-d37f-a520-a9821" name="Tidewall Counterstrike Cadre" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="bde2-4715-64db-8349-a9821" name="Defensive Fusillade" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If a model from a Breacher Team in a Tidewall Counterstrike Cadre is on a Tidewall Shieldline from its Formation when it shoots, use the Pulse Blaster's "up to 5 inches" profile for enemies up to 10" away, and the "5-10 inches" profile for enemies up to 15" away.</description>
        </rule>
        <rule id="a5ec-9619-c818-555c-a9821" name="Precision Sweep" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models from the Strike Team in a Tidewall Counterstrike Cadre can re-roll failed to-hit rolls whilst on a Tidewall Gunrig or Droneport from their Formation.</description>
        </rule>
        <rule id="f703-902d-0755-b2f6-a9821" name="Rapid Advance" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Tidewall fortifications from a Tidewall Counterstrike Cadre can move up to 9" in their Movement phase so long as they end their move closer to the Pathfinder Team from the same Formation.</description>
        </rule>
        <rule id="2582-378f-9258-986b-a9821" name="Tidewall Counterstrike Cadre (Restriction)" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units in this Formation may not take Dedicated Transports. When deploying the Tidewall fortifications from this Formation, each Gunrig and Shieldline must be within 6" of the Droneport. If you wish to move the Tidewall Defense Network, this restriction must still be met once each element has moved.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="eec3-f8e8-1b20-e757-a9821" name="Pathfinders - 1 required w/o transport" hidden="false" collective="false" defaultSelectionEntryId="e2f5-97b0-ede6-6b65-a9821">
