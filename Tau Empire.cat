    <selectionEntry id="77ce58e0-6b78-1b5e-dc8e-55c87147e85c-a9821" name="Puretide Engram Neurochip" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="124e-2563-c9e7-8368-a9821" name="Puretide Engram Neurochip" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of this model's Movement phase, choose a special rule: Counter-attack, Furious Charge, Monster Hunter, Stubborn or Tank Hunters. This model has that rule until the start of his next Movement phase.</characteristic>
          </characteristics>
        </profile>
