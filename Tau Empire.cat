6523232344415441232323">30"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 4, Homing, Ignores Cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="9a16628a-6eb7-113c-bd88-67eed349f036-6e27b8e" name="Sniper Drone" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="46"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry (Drone)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">2</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">7</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="8cde78cb-879e-0192-6942-9c16f5fafc5f-6e27b8e" name="Stealth armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="27"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Confers Acute Senses</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="70df7b0c-98b4-dc76-7160-9a1e49e7ff3e-6e27b8e" name="Stealth battlesuit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="70"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Comes equipped with multi-tracker and blacksun filter, confers Stealth and Shrouded.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="81f8c013-8d26-bfe6-404a-950565937056-6e27b8e" name="Stealth field generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="27"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Confers Stealth and Shrouded</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="9390d52e-6c8f-3121-ef88-e477594e4ee3-6e27b8e" name="Stealth Shas'ui" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="43"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">3</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">2</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="a9fd281c-aaef-7dff-13e0-331c2e830a1e-6e27b8e" name="Stealth Shas'vre" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="43"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">3</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">2</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="bc5aa4ef-eb4c-21b7-1d88-514fb7654741-6e27b8e" name="Stimulant Injector" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Feel No Pain.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="4858af94-4a6c-7492-6ac2-e6a239ed201f-6e27b8e" name="Structural Analyser" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Non-vehicle targets of Darkstrider or his unit's shooting attacks have -1 Toughness against these shots. Their modified Toughness is used for Instant Death.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="beaa2ddb-52bf-b9c7-1f56-7227b568e4ef-6e27b8e" name="Sun Shark Bomber" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="48"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">11</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">10</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile><profile id="b6466a4f-626b-798c-6e32-acee6a2cf16d-6e27b8e" name="Target Lock" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Can shoot at different target than his unit.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="91fa0eb0-33d8-90e1-c8a5-9a7eec721a18-6e27b8e" name="Targeting array" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="28"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">+1 to BS, up to BS 5</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="04fe7420-794d-9f64-bcd7-488f7e3d0951-6e27b8e" name="Tetra" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="154"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">10</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">10</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Vehicle (Fast, Skimmer, Open-topped)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">2</characteristic></characteristics></profile><profile id="dd59b1d8-d880-bc3d-a271-b58e4831705f-6e27b8e" name="The Dawn Blade" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Armourbane</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="675460a7-849c-f2e0-a4e3-3a48a8dbd440-6e27b8e" name="The Paradox of Duality" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="61"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">For every unsaved Wound Aun'Va's unit suffers, roll a D6. If the roll is equal to or higher than the AP of the shot, the Wound is ignored. AP1 Wounds are automatically ignored and rolls cannot be made against AP- Wounds.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="621f82ea-1781-8648-a59c-ffc321de6b55-6e27b8e" name="Tiger Shark" hidden="false" typeId="mh6-56656869636c65202853757065722048656176792923232344415441232323" typeName="Vehicle (Super Heavy)" page="183"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Structure Points" typeId="mh6-53747275637475726520506f696e747323232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Super-heavy Flyer</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">6</characteristic></characteristics></profile><profile id="8497c564-f5ef-f3f2-1ef8-26e940e08681-6e27b8e" name="Vectored Retro-thrusters" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Fleet and Hit &amp; Run.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7ea009f0-d5ce-75c9-6932-17d8950d1d32-6e27b8e" name="Velocity Tracker" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Choose to have Skyfire, or not, each time it makes shooting attack (choose once for all weapons).</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="94a4e179-3afb-b45d-cc8b-bff70583e117-6e27b8e" name="Vespid Stingwing" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="39"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jump infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">3</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">6</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">6</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="ae980f0f-79a8-aed2-56e1-3291e3803df0-6e27b8e" name="Vespid Strain leader" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="39"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jump infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">3</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">6</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="38a27448-15b0-5b8d-d633-9e4712550ade-6e27b8e" name="XV02 Pilot Battlesuit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="62"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Supporting Fire, blacksun filter. Longstrike's Hammerhead can fire Overwatch once at each eligible charging unit.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="4bd79d4f-ee1e-6fd4-5182-9f9a59e1b4be-6e27b8e" name="XV22 Stealth Battlesuit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="59"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3+ Armour Save, 5+ invulnerable save, Stealth, Shrouded, multi-tracker, blacksun filter, Shadowsun can fire her fusion blasters at two different targets, though one must be at the same target as her unit, if she has joined one.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="41986b53-ddeb-6b81-9080-9d6cb7613737-6e27b8e" name="XV8-02 Crisis 'Iridium' Battlesuit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="73"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">+1 Toughness and 2+ Armour Save.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="1c5429f4-4ed1-78d0-c754-282aae713a67-6e27b8e" name="XV9 Close Support Battlesuit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="264"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Confers Acute Senses, counts as having Defensive grenades. XV9 suits may have drones and still use Vectored retro-thrusters to escape from close combat as per Codex: Tau Empire. If they choose to do so but also have drones, they abandon their drones which are destroyed but during the turn this occurs the XV9 automatically passes its Initiative test to disengage.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="02c91765-6330-2a40-f727-e7f6525780e9-6e23de5" name="Advanced Targeting System" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="68"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">To Hit rolls of a 6 in Shooting phase are Precision Shots. Characters make Precision Shots on 5 or 6.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="14c5ebde-2d2c-bd44-97aa-93cf9770cd73-6e23de5" name="Airbursting fragmentation projector" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="65"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Barrage, Ignores Cover, Large Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="6d061265-20ce-298f-e946-624bb4539267-6e23de5" name="Aun'Shi" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="64"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">3</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">4</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">-/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="d5b391e0-9dec-6f93-c7d9-d17b3884b6b1-6e23de5" name="Aun'Va" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="61"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">1</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">2</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">3</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">4</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">1</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">5+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="3c8ab6f4-f626-d1d4-5d79-fa9e1b4bdc62-6e23de5" name="Automated Repair System" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="72"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">At the end of each friendly turn, roll a D6 for each vehicle with an automated repair system that has suffered an Immobilised or Weapon Destroyed result. On a 6, one such result is repaired. Doesn't repair Hull Points.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="9598db7a-c41b-eef7-8e5b-86d80e927a4b-6e23de5" name="Barracuda" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="155"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">11</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">11</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">2</characteristic></characteristics></profile><profile id="31fbbe6a-8a4e-346e-2dc4-ab2dc1613f82-6e23de5" name="Blacksun Filter" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="68"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Night Vision and immune to Blind.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="23955c77-aa13-593b-d1ab-03b43d80cdca-6e23de5" name="Bonding knife" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="28"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Can always attempt to regroup using unmodified Ld</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="05a2cf0b-e2bf-39a1-5e22-e3c8f1b24fcb-6e23de5" name="Broadside battlesuit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="70"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Comes equipped with multi-tracker and blacksun filter.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="bd84ba48-adc0-a972-abcb-328879cc5a82-6e23de5" name="Broadside Shas'ui" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="42"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">5</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">2</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="68a84a04-db41-7b35-4d0e-416046143fc6-6e23de5" name="Broadside Shas'vre" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="42"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">5</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">2</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="098adddb-eedc-e062-e858-2e34ca7a7ef6-6e23de5" name="Burst cannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="65"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 4</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="2753f571-e4c9-97d3-b5e3-92612738f799-6e23de5" name="Cadre Fireblade" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="36"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">3</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">3</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="44f59538-ea8f-ddef-17f5-1d1b57d0c3c0-6e23de5" name="Command and Control Node" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If this model does not shoot in the Shooting phase, all shooting attacks made by other models in his unit re-roll failed To Hit rolls that phase. This cannot be used when firing Overwatch, but can be used at the same time as a Multi-spectrum Sensor Suite.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="f684355e-fcd6-457a-11a7-4625b17e18ba-6e23de5" name="Command-link" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="59"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">One unit within 12" re-rolls TO Hit rolls of 1 for that friendly Shooting phase.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="b6c1188e-78b6-eb19-2aea-4adf6656ea27-6e23de5" name="Command-link Drone" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="59"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry (Drone)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">2</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">7</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="e631d26b-d680-4fc4-479c-9d8aae7e72c0-6e23de5" name="Commander " hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="34"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">5</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">4</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">3</characteristic><ch