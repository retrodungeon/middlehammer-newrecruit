ristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="50c332d5-f3d2-46d3-ae46-8c0c337352e1-6e27b8e" name="Multi-spectrum Sensor Suite" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="73"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If this model does not shoot in the Shooting phase, all shooting attacks made by other models in his unit have Ignores Cover this phase. This cannot be used when firing Overwatch, but can be used at the same time as a Command and Control Node.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7d9c750a-732d-c50a-5099-74a7939af875-6e27b8e" name="Multi-Tracker" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Fire an extra weapon each Shooting phase.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="e296cf5a-a6ca-06be-c162-b285d2d80b93-6e27b8e" name="MV52 Shield Drone" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="59"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry (Drone)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">2</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">7</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+/3++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="be88abc1-51a6-f034-fd93-bd9fd6575202-6e27b8e" name="MV52 Shield Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="59"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3+ invulnerable save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="29d6528c-5680-76ff-2c75-7866b857516d-6e27b8e" name="Networked Markerlight" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">A markerlight that is always fired first and whose counters can be used by its own unit.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="49a02c72-bb06-fb08-7163-5adc3d3da3fd-6e27b8e" name="Neuroweb System Jammer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="73"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">At the start of each enemy Shooting phase, this model can target a single enemy unit in 12". All shooting weapons in the target unit have Gets Hot that phase.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="ea4abedd-fe5e-6ac6-5189-0a67aa01e477-6e27b8e" name="Neutron blaster" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="66"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="2e4c8d16-a25b-edc1-5cfe-66c4739147fa-6e27b8e" name="Onager Gauntlet" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="73"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">In the Fight sub-phase, this model can opt to substitute all his close combat attacks for a S10 AP1 attack.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="e56cb8f4-0144-427d-ec2d-119ce888f9fa-6e27b8e" name="Orca" hidden="false" typeId="mh6-56656869636c6520285375706572204865617679205472616e73706f72742923232344415441232323" typeName="Vehicle (Super Heavy Transport)" page="189"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Structure Points" typeId="mh6-53747275637475726520506f696e747323232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer, Hover, Transport</characteristic><characteristic name="Transport Capacity" typeId="mh6-5472616e73706f727420436170616369747923232344415441232323">57</characteristic><characteristic nam