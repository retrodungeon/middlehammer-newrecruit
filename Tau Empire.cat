723232344415441232323" /></characteristics></profile><profile id="50c332d5-f3d2-46d3-ae46-8c0c337352e1-6e23de5" name="Multi-spectrum Sensor Suite" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="73"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If this model does not shoot in the Shooting phase, all shooting attacks made by other models in his unit have Ignores Cover this phase. This cannot be used when firing Overwatch, but can be used at the same time as a Command and Control Node.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7d9c750a-732d-c50a-5099-74a7939af875-6e23de5" name="Multi-Tracker" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Fire an extra weapon each Shooting phase.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="e296cf5a-a6ca-06be-c162-b285d2d80b93-6e23de5" name="MV52 Shield Drone" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="59"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry (Drone)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">2</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-412323234