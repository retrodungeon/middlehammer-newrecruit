    <selectionEntry id="3104-8758-a1f1-50d9-a9821" name="Heavy Retribution Cadre" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="b535-10ae-99a4-7539-a9821" name="Monsoon of Destruction" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If an enemy unit is chosen as the target by at least two units from this Formation in the same shooting phase, that unit cannot Run or move Flat Out in their next turn. In addition, such units must halve the result of any Charge rolls they make in the next turn (rounding fractions down).</description>
        </rule>
        <rule id="c924-0304-af63-6e09-a9821" name="Optimum Fire Position" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>You can re-roll failed To Hit rolls for shooting attacks made by Stormsurges from this Formation if the target unit is within 12" of a Ghostkeel Battlesuit from this Formation.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
