    <selectionEntry id="a2d9-9248-e6b0-e67e-a9821" name="Infiltration Cadre Burning Dawn [BD]" page="27" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="94f4-d251-102d-a3bf-a9821" name="High Councillor" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Once per game, when using hte Invocation of the Elements special rule, Aun'Do can invoke up to two elemental powers, instead of just one.</description>
        </rule>
        <rule id="26ab-fb2e-206e-cb66-a9821" name="Infiltration Cadre" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
