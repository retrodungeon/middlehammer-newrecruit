        <selectionEntry id="21eea908-38f2-8dd0-d31a-22db76695248-a9821" name="Longstrike" page="62" hidden="false" collective="false" type="model">
          <profiles />
          <rules>
            <rule id="72f8387d-0281-54d2-02cc-34f7e6c8f972-a9821" name="Preferred Enemy (Astra Militarum)" page="40" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
