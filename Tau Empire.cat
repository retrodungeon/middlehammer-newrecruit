            <rule id="4942-cca0-456f-da39-a9821" name="Hammerhead Ace" page="48" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Longstrike's Hammerhead is BS 5. Longstrike also dies if his Hammerhead is destroyed. Longstrike and his vehicle count are a single unit for purposes of Victory Points.</description>
