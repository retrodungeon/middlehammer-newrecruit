nt" shared="true" id="e780ca02-b1a7-2d65-435e-ebc4b5001af9-maxSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /></constraints><infoLinks><infoLink id="9f0dc786-2e21-a8ac-f20c-b8a61b612037-6e23de5" name="Kroot rifle (sniper round)" hidden="false" targetId="f4e3522f-28af-e09d-cdfa-12e610d5a2ab-6e23de5" type="profile" /></infoLinks></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="68a7cc13-33b8-b179-e13d-d354c4172b1a-6e23de5" name="Kroot rifle" hidden="false" collective="true" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="68a7cc13-33b8-b179-e13d-d354c4172b1a-minSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="68a7cc13-33b8-b179-e13d-d354c4172b1a-maxSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /></constraints><infoLinks><infoLink id="ebf239e2-1a47-72f0-9555-51a6e3bc6c6b-6e23de5" name="Kroot rifle (pulse round)" hidden="false" targetId="46238f7d-1071-7507-e330-7daa2bf2b36f-6e23de5" type="profile" /><infoLink id="394d560e-17fd-13db-2a7b-433154d59886-6e23de5" name="Kroot rifle (melee)" hidden="false" targetId="3bbad8ad-b91f-73e7-72ef-7625aaf101f2-6e23de5" type="profile" /></infoLinks></selectionEntry><selectionEntry id="43149ae9-c07a-9e4b-930e-8d10da25d783-6e23de5" name="Landing gear" hidden="false" collective="true" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="43149ae9-c07a-9e4b-930e-8d10da25d783-minSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="43149ae9-c07a-9e4b-930e-8d10da25d783-maxSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /></constraints><infoLinks><infoLink id="fe4f7981-33d2-7d32-2b80-6a76848f53f3-6e23de5" name="Landing gear" hidden="false" targetId="c225aa18-6129-56a1-dd75-f4d7a2b353d8-6e23de5" type="profile" /></infoLinks></selectionEntry><selectionEntry id="c5ea0e80-60a6-4f16-8810-de0b177c4111-6e23de5" name="Manta" hidden="false" collective="false" import="true" type="model" page="195"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="2000" /></costs><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="c5ea0e80-60a6-4f16-8810-de0b177c4111-minSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="-1" field="selections" scope="parent" shared="true" id="c5ea0e80-60a6-4f16-8810-de0b177c4111-maxSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="0ee0a532-a3a9-722b-97a5-16fec2102700-6e23de5" name="AA Fire" hidden="false" page="195"><description>Due to it's size, when rolling to hit the Manta the opposing player does not need to fire Snap Shots and may instead use their model's BS as normal even if they do not possess the Skyfire rule.</description></rule><rule id="8a922b12-77ae-facd-a30d-a35526339376-6e23de5" name="Transport Elevator" hidden="false" page="195"><description>All units on the lower transport deck can disembark on the same turn.</description></rule><rule id="2e5ad271-1745-578d-43cf-0d005815d8a6-6e23de5" name="Transport Ramp" hidden="false" page="195"><description>Up to four units may exit from the Manta's rear transport ramp per turn.</description></rule><rule id="d34d0339-28fe-b57b-eb55-141fb7a359a3-6e23de5" name="Manta's Capacity" hidden="false" page="195"><description>The Manta has two transport bays that are treated separately as to what they may carry into battle:
- The upper deck may transport infantry models and drones only and has a transport capacity of 55.
- The lower deck has a transport capacity of 145, and uniquely may carry as part of this payload up to eight Crisis or Broadside battlesuits (which take up three spaces each) and up to four vehicles (which take up 30 spaces each). Vehicles being transported may carry troops themselves without the troops using up extra spaces.</description></rule></rules><infoLinks><infoLink id="4bdcdf43-62e6-61c3-cbe0-38adfeb92ce0-6e23de5" name="Manta" hidden="false" targetId="a3728243-f170-e423-8283-e392d4037e62-6e23de5" type="profile" /></infoLinks><selectionEntries><selectionEntry id="d68ceb30-ef46-4885-bba1-4340906593fb-6e23de5" name="Twin-linked long-barelled ion cannon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="3" field="selections" scope="parent" shared="true" id="d68ceb30-ef46-4885-bba1-4340906593fb-minSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="3" field="selections" scope="parent" shared="true" id="d68ceb30-ef46-4885-bba1-4340906593fb-maxSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7762bf59-5e96-94b6-d8da-b9f925ddad86-6e23de5" name="Long-barelled ion cannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">90"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 3</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62, Imperial Armour: Aeronautica</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6f15142e-60f6-4b17-a95a-993479da88fd-6e23de5" name="Energy Shield" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6f15142e-60f6-4b17-a95a-993479da88fd-minSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6f15142e-60f6-4b17-a95a-993479da88fd-maxSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="aa55bbb4-ebc6-3078-5a4c-ff8064f366db-6e23de5" name="Energy Shield" hidden="false" page="195"><description>The Manta's energy shield gives it 4+ Invulnerable Save against any hits it receives.</description></rule></rules></selectionEntry><selectionEntry id="e9f4bde4-051a-c34f-3529-828cca807651-6e23de5" name="Heavy railgun" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="2" field="selections" scope="parent" shared="true" id="e9f4bde4-051a-c34f-3529-828cca807651-minSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="e9f4bde4-051a-c34f-3529-828cca807651-maxSelections-6e23de5" includeChildSelections="false" includeChildForces="false" /></constraints><infoLinks><infoLink id="bf8f773c-1969-85f3-af73-86e30ee8202f-6e23de5" name="Heavy railgun" hidden="false" targetId="19f73d45-fd9b-6d4c-e901-244b0f09bb21-6e23de5" type="profile" /><infoLink id="12065f0c-3ab5-4016-01b4-6b7972bfbdf2-6e23de5" name="Heavy railgun (submunitions)" hidden="false" targetId="19fe7c71-ae2e-fb09-31ad-3158d4f796b1-6e23de5" type="profile" /></infoLinks></selectionEntry><selectionEntry id="d0cf451b-6ae0-f115-