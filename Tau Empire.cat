rofile><profile id="dc87bbf6-c5be-6bcf-4f68-339d2454b223-6e27b8e" name="DX-6 Remora" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="262"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">10</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">10</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Vehicle (Flyer, Hover)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">2</characteristic></characteristics></profile><profile id="9ea45941-5974-ce39-edcc-2b08753df675-6e27b8e" name="Early Warning Override" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="68"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Interceptor.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="35559a44-d95b-fd62-900a-1cec463c0707-6e27b8e" name="Ejection system" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="26"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Should the character lose his last wound to a shooting attack that does not cause Instant Death, the battlesuit is replaced with a single model, representing the pilot. The profile of this model is the same as before the pilot ejected, less 2 Strength, 1 Toughness and it has 1 Wound and no armour Save. It is equipped with a pulse pistol only.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="73d15279-9774-89fa-2b7f-fda14bf928da-6e27b8e" name="EMP grenades" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="68"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Haywire grenades, Wh40k rulebook pg62</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="105a8e06-2213-055f-40ce-9d62d3ae74b6-6e27b8e" name="Equalizer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="65"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="8d795dce-6f3b-ac25-ca1e-781b7bd456c6-6e27b8e" name="Ethereal" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="35"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">3</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">3</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232