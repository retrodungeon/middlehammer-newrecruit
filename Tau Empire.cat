    <selectionEntry name="Krootox" id="18de-0b66-0b31-85bd" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="c687-cf74-0e7e-adce" hidden="false" primary="true" targetId="9260-7d57-be5c-bd52" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="02dc-e73d-f9f7-357a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Attached Unit" id="f63a-d2a9-df66-57d0" hidden="false">
          <description>A unit of Krootox must be attacked to a Kroot Carnivore squad before the game. They are deployed along with the Kroot Carnivore squad as if they were all a single Troop choice selection from the Force Organisation chart (but the Krootox still occupies a Fast Attack choice). There cannot be more attached models (including Kroot Hounds) added to a Carnivor squad than Kroot.

Once attached, the Krootox function as part of the Carnivore squad they are attached to. Their Leadership and Armor save will be the same as the unit they are attached to.</description>
        </rule>
        <rule name="Toughness" id="fb74-40ac-1680-943a" hidden="false">
          <description>Krootox only have a Toughness of 3 for determing whether a weapon is capable of inflicting an instant kill, so weapons of Strength 6 or higher are able to kill them outright.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Krootox" id="2b4c-d10c-527b-bdbe" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Krootox" id="7f47-a6e3-912d-34cb" collective="false" hidden="false" import="true" type="model">
              <constraints>
                <constraint id="3cde-1cbd-900b-aa4b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3" />
                <constraint id="ef72-cdc8-b677-d09b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1" />
              </constraints>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50" />
              </costs>
              <infoLinks>
                <infoLink name="Krootox" id="a56d-8c81-e8b0-707c" hidden="false" targetId="8cc7-4bf0-4daf-4dc8" type="profile" />
                <infoLink name="Kroot Gun" id="c819-ae4f-ea53-3092" hidden="false" targetId="502c-f105-689a-3755" type="profile" />
              </infoLinks>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Commander Farsight" id="02dc-e73d-f9f7-357a" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HQ" id="bdbd-9163-9951-4e37" hidden="false" primary="true" targetId="ac8d-efba-1884-d3ad" />
      </categoryLinks>
      <constraints>
        <constraint id="54d2-74c5-ce38-d70f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
      </constraints>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="170" />
      </costs>
      <entryLinks>
        <entryLink name="Crisis Battlesuit Bodyguard Team" id="0bc8-fd42-baf0-a8de" collective="false" hidden="false" import="true" targetId="0a71-e2d2-9661-1972" type="selectionEntryGroup" />
      </entryLinks>
      <infoLinks>
        <infoLink name="Commander Farsight" id="081f-11d0-c2c4-04b1" hidden="false" targetId="a8a6-7b3c-f374-5939" type="profile" />
      </infoLinks>
      <rules>
        <rule name="Dawn Blade" id="98cd-27ad-cfab-7936" hidden="false">
          <description>Farsight counts as a Monstrous Creature in hand-to-hand combat, so he ignores Armour Saves and rolls 2D6+S for Armour Penetration against vehicles.</description>
        </rule>
        <rule name="Ork Fighter" id="8541-02ce-9b13-e6d7" hidden="false">
          <description>Any Tau unit in an army led by Farsight may improve both their WS and I by 1 at the cost of +5 points per model.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Aun'shi" id="d3e6-c09f-29a2-3804" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HQ" id="e5da-e4f2-5fd8-38b3" hidden="false" primary="true" targetId="ac8d-efba-1884-d3ad" />
        <categoryLink name="Infantry" id="2620-1126-d3da-1d8b" hidden="false" primary="false" targetId="6953-6bba-0bb9-d49d" />
      </categoryLinks>
      <constraints>
        <constraint id="b39a-b81d-e4ef-31aa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
      </constraints>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="105" />
      </costs>
      <infoLinks>
        <infoLink name="Aun'shi" id="c54e-b090-8d2a-eb70" hidden="false" targetId="36a1-be74-1347-8f58" type="profile" />
        <infoLink name="Independent Character" id="8717-249f-b019-530b" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
        <infoLink name="Honour Blade" id="6c8d-a246-da6f-bcd4" hidden="false" targetId="e4b3-561f-f686-b18d" type="rule" />
        <infoLink name="Invulnerable Saving Throw" id="94cd-c630-8840-aafe" hidden="false" targetId="97b3-810d-a09e-872b" type="rule" />
        <infoLink name="Photon Grenades" id="906a-28ba-a827-f162" hidden="false" targetId="5c1c-6924-1f3c-f6b7" type="profile" />
        <infoLink name="EMP Grenades" id="dac4-b445-5168-14d7" hidden="false" targetId="2140-93ef-49c8-1008" type="profile" />
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="02dc-e73d-f9f7-357a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Hard-wired Shield Generator" id="dfd7-71af-9bca-b3c1" hidden="false">
          <description>4+ Invulnerable Save</description>
        </rule>
        <rule name="Blade Master" id="bd46-1a14-6d8d-0265" hidden="false">
          <description>Aun'shi's skill with the blade grants the following two abilities:
* He may use none, some, or all of his Attacks to parry. He must declare how many he will use at the start of close combat before any dice are rolled. For each Attack he forfiets, reduce the number of Attacks of each enemy attacking him by one (to a minimum of 1 each).
* As normal his honour blade grants +2 S, and additionally causes an automatic wound with no Armour save possible if he rolls a 6 to hit.</description>
        </rule>
        <rule name="Inspiring Presence" id="553e-efc1-c279-2c50" hidden="false">
          <description>Tau units may re-roll any Moral tests (passed or failed) if Aun'shi is on the table. The re-rolled result stands. Any Tau units joined by Aun'shi is fearless, passing all Morale checks and Pinning tests automatically.
Additionally, any Tau unit joined by Aun'shi gain +1 I and +1 A in close combat while Aun'shi remains with them.</description>
        </rule>
        <rule name="Price of Failure" id="2c5d-8a09-4e64-fc2e" hidden="false">
          <description>If Aun'shi is killed, every friendly Tau unit on the tabletop must take a Morale check at the start of their next turn if not in close combat or already falling back. Any units that fail must Fall Back during their next Movement phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Tiger Shark (IA)" id="3335-09bc-e144-dc02" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Super-Heavy" id="c9f1-dda5-b60c-7b8f" hidden="false" primary="true" targetId="5968-f35e-18fd-612b" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="353" />
      </costs>
      <infoLinks>
        <infoLink name="Tiger Shark" id="6c51-ca03-4bec-6df4" hidden="false" targetId="ff85-0475-5daf-0d36" type="profile" />
        <infoLink name="Super-Heavy Flyer" id="dff2-b3d1-cd13-38d3" hidden="false" targetId="7ca6-da5f-a87c-f49b" type="rule" />
        <infoLink name="Ion Cannon" id="510a-353f-cc03-2923" hidden="false" targetId="43b2-2313-d8ca-a57b" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Twin-Linked Ion Cannon" />
          </modifiers>
        </infoLink>
        <infoLink name="Missle Pod" id="96c4-dbba-9750-0c52" hidden="false" targetId="0f38-81fa-b5b9-0663" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Twin-Linked Missle Pod" />
          </modifiers>
        </infoLink>
        <infoLink name="Burst Cannon" id="0ea5-a520-d520-e663" hidden="false" targetId="9e5e-b881-3c15-e101" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="2x Burst Cannon" />
          </modifiers>
        </infoLink>
        <infoLink name="Targetting Array" id="f9bf-3c16-fe10-d187" hidden="false" targetId="ce5a-d3df-81a4-b045" type="rule" />
        <infoLink name="Decoy Launchers" id="1fda-1600-043f-5186" hidden="false" targetId="e807-f290-815c-7312" type="rule" />
        <infoLink name="Twin-Linked" id="fc2e-336c-2f76-b07a" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Drone Racks" id="2acb-0d7b-18e2-a57c" hidden="false">
          <description>The Tiger Shark can carry up to 14 drones. These can be deployed in one or more squadrons. These may be deployed on any attack run without the flying needing to land. These drones deploy by the normal rules for Deep Strike, but as they deploy during the attack run in the opponent's turn, they may move, shoot, and assault normally in the Tau Player's upcoming turn. Any number of squadrons can be deployed in a single turn.</description>
        </rule>
        <rule name="Escape Pod" id="2c21-d99a-dffe-907e" hidden="false">
          <description>If the Tiger Shark is destroyed, nominate a point on the table and scatter the pod 2D6" as with the rules for Deep Strike. If the pod scatters off-table it is counted as having escaped safely. If not place two Tau models within 2", which count as Fire Warriors with no weapons. The crew are counted as below half-strength and are worth no Victory Points on their own, but the TIger Shark only counts as damaged for Victory Point purposes while the crew are alive or if they escape.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Drones" id="8b3b-389f-4cf4-f3f6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bc4d-5afd-9187-c880" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="14" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="12" />
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
