    <selectionEntry id="cf91-05c4-5bb3-d9d1-a9821" name="Air Superiority Cadre" page="81" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="796e-5055-e4c5-d967-a9821" name="Air Superiority" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In the Shooting phase, add 1 to the BS of all models from this Formation shooting at enemy Flyers, Super-heavy Flyers, Jetbikes, Skimmers, Flying Monsterous Creatures, or Flying Gargantuan Creatures.</description>
        </rule>
        <rule id="c074-b092-ded9-b1b2-a9821" name="Hyperlinked Drone Network" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>As long as at least one model from the formation is on the battlefield, then at start of the Tau Shooting phase, the Tau player gains D3 markerlight counters that can be placed on any enemy units on the battlefield.</description>
        </rule>
        <rule id="f75c-e6f7-f6cd-9023-a9821" name="Skywatch" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units from this Formation automatically enter play from Reserves without a dice roll being made if there are any enemy Flyers, Super-heavy Flyers, Jetbikes, Skimmers, Flying Monsterous Creatures, or Flying Gargantuan Creatures anywhere on the battlefield.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="a3dd-afca-8ed6-e8aa-a9821" name="Razorsharks - 3 required" hidden="false" collective="false" defaultSelectionEntryId="d6a2-a585-ff50-053e-a9821">
