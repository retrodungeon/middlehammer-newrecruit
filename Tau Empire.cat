      </constraints>
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks />
      <costs>
        <cost name="Points" value="10.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="568b-407f-d02c-8161-a9821" name="Farsight Enclaves" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="0775-a49c-a63b-6252-a9821" name="Battlesuit Spearhead" page="85" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In a Farsight Enclaves Detachment or Formation, XV8 Crisis Battlesuits are Troops choices instead of Elites choices</description>
        </rule>
        <rule id="bfe9-a393-c8af-bf5d-a9821" name="Ork Hunters" page="85" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units in a Farsight Enclaves Detachment or Formation have the Preferred Enemy (Orks) special rule when making close combat attacks.</description>
        </rule>
        <rule id="26ed-278c-8c03-257a-a9821" name="Ta'lissera Bond" page="85" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units in a Farsight Enclaves Detachment or Formation that have the option to take the Bonding Knife Ritual special rule must do so.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="84a4-06ab-ef0d-f7ae-a9821" hidden="false" targetId="f217-b311-e5b1-c8c7" type="rule">
