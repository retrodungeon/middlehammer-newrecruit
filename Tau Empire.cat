      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with a hover drone is not slowed by Difficult Terrain (even when charging), can move over all other models and terrain freely (but cannot end their move on top of other models or Impassable Terrain) and automatically passes Dangerous Terrain tests.</characteristic>
      </characteristics>
    </profile>
