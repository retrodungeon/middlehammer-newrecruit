    <selectionEntry id="3541-3bf1-ee2c-0e5a-a9821" name="Ranged Support Cadre" page="74" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="18db-8eb3-c487-0a13-a9821" name="Dedicated Spotting Teams" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Double the value of any markerlight counters placed by any of this Formation's Pathfinders if the counter is used by any of this Formation's Broadside units.</description>
        </rule>
        <rule id="ae2d-302d-5cec-9a60-a9821" name="Hidden Observers" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Pathfinder Teams in the formation have the Infiltrate and Shrouded special rules. The Shrouded special rule is lost immediately by any unit that moves from its starting location (for any reason), and by any unit that makes an attack with anything other than its markerlights.</description>
        </rule>
        <rule id="af35-1f98-65d1-eb28-a9821" name="Dedicated Support Units" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Broadside units in this Formation can provide Supporting Fire for the Pathfinder Teams in this Formation at any range, as long as it does not exceed their weapon's maximum range.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="e5bf-2eb4-632f-c5e2-a9821" name="Pathfinders - 3 required" hidden="false" collective="false" defaultSelectionEntryId="f22d-cdfe-8e04-b394-a9821">
