        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Night Vision and is immune to the effects of Blind.</characteristic>
      </characteristics>
    </profile>
    <profile id="23955c77-aa13-593b-d1ab-03b43d80cdca-a9821" name="Bonding Knife" page="28" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
