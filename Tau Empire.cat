          </conditions>
        </modifier>
        </modifiers>
      <rules>
        <rule name="Gun Drone Squadron" id="a8d5-143a-21e1-e311" hidden="false">
          <description>A Gun Drone squadron has its processors linked to enable it to have the capacity for independent action. They are programmed for self-preservation and take Leadership tests normally. If their numbers are reduced to less than 3 their Leadership drops to 4.</description>
        </rule>
      </rules>
