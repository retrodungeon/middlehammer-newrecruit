    <selectionEntry id="4fbd-d5db-f399-d59e-a9821" name="Armoured Interdiction Cadre" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="7066-bd4d-410a-5e3e-a9821" name="Interlaced Predictive Targeting" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Pick a point anywhere on the battlefield at the start of your Shooting phase. The point you pick is the centre of this Formation's Predictive Targeting Grid. You can re-roll failed To Hit rolls for attacks made by models from this Formation if the target unit is within 6" of the point that you picked.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
