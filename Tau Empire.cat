    <selectionEntry id="27c6-a68c-f511-3b40-a9821" name="Ethereal Council" page="78" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="e793-5753-79b2-aea7-a9821" name="Fanatical Fervour" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The range of the Failure Is Not An Option special rule is increased from 12" to 24" for all of the models in the Ethereal Council that have the rule.</description>
        </rule>
        <rule id="9caf-7007-0b76-50b5-a9821" name="Collective Elemental Power" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>As long as the Ethereal Council has at least 2 members, it invokes all four elemental powers each turn instead of only one power per member. The Ethereal Council, and all friendly non-vehicle units that have the Tau Empire Faction within 12" of it, benefit from the effects of all four elemental powers until the start of the Council's next Movement phase.</description>
        </rule>
        <rule id="08d8-4dfe-d56f-12a2-a9821" name="United Council" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The members of the Ethereal Council form a single unit, and are treated as Characters rather than Independent Characters as long as at least 2 members of the council remain alive.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="3178-f745-d7bb-dfb4-a9821" hidden="false" targetId="8d37-2e47-4a04-58f7" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
      </infoLinks>
      <modifiers />
      <constraints />
