            <rule id="ae9d-e88f-ff3e-8a20-a9821" name="Afterburners" page="48" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Can Turbo-boost like Jetbikes.</description>
            </rule>
            <rule id="8bff-4431-acc9-7e47-a9821" name="High Velocity Deployment" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Can disembark at any point during the Sun Shark's move (even though models cannot normally disembark from Zooming Flyers). Note that, unlike other Transports, a Sun Shark Bomber that moves before its Interceptor Drones disembark can continue its move immediately after they have disembarked.</description>
            </rule>
          </rules>
