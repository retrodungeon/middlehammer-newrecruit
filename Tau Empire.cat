    <selectionEntry id="4141bbe1-09fc-4b7c-9ded-6c9de6dd18d4-a9821" name="Orca" page="125" hidden="false" collective="false" type="model">
      <profiles />
      <rules>
        <rule id="498fd679-545d-c5c5-ce46-e6a9446e7278-a9821" name="Transport Ramp" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Up to four separate units may exit from the Orca's rear ramp each turn.</description>
        </rule>
        <rule id="cf4649c1-0720-324f-fdac-a30dca0ca96a-a9821" name="Transport Capacity (Orca)" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Orca may transport 57 models. It may transport models with the type Jet Pack Infantry (Drone), and up to six Tau Battlesuits with the type Jet Pack Infantry. These units take up transport capacity as normal.</description>
        </rule>
