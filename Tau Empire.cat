        </modifiers>
      <rules>
        <rule name="Anti-Air" id="8e0f-2f90-0b28-d0b9" hidden="false">
          <description>To fire at enemy aircraft the Sky Ray must first hit the target with its marker lights. It can target aircraft up to 36" away. If the target is hit, then any number of Seeker Missiles can be fired at the target. Each missiles hits on a roll of 2+.</description>
        </rule>
        <rule name="Landing Gear" id="a268-ef1f-b062-f938" hidden="false">
          <description>The Sky Ray make opt to set down at the beginning of its Movement phase, choosing to remain stationary that turn and to no longer count as a Skimmer.</description>
        </rule>
      </rules>
    </selectionEntry>
