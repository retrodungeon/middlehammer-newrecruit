    <selectionEntry id="5dff-af07-1b47-3871-a9821" name="Tidewall Defence Network" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="4347-fd1b-5e54-12d2-a9821" name="Indomitable Position" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models with the Tau Empire Faction have the Stubborn special rule whilst on a Tidewall Shieldline from a Tidewall Defence Network.</description>
        </rule>
        <rule id="d397-828d-998e-a731-a9821" name="Information Relay" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models with the Tau Empire Faction on a Tidewall Shieldline from a Tidewall Defence Network can operate the railgun or activate the Drones on its central platform.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
