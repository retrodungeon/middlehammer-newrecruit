32344415441232323" /></characteristics></profile><profile id="bcd3b1af-602d-8fc9-2e66-00203766d6ca-6e27b8e" name="Plasma rifle" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="66"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="15eadab0-2d20-42ad-5a5c-9c282ae2412f-6e27b8e" name="Point Defense Targeting Relay" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="72"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Supporting Fire and can fire Overwatch with weapopns of Strength 5 or less. Attached drones may also fire Overwatch with weapons of Strength 5 or less.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="4399fd29-0e42-7362-a9bf-e1231412fe4e-6e27b8e" name="Positional Relay" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Whilst the bearer is within 6" of a board edge, any Outflanking friendly Tau Empire unit can choose to move on from that board edge.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="cd5eb04f-4d5a-5e73-5264-5f6814617e7f-6e27b8e" name="Pulse Accelerator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All pulse weapoons in a unit with a pulse accelerator, increase their range by 6".</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="ac12022c-0625-2f56-f70a-766decb99e28-6e27b8e" name="Pulse Accelerator Drone" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="38"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jet Pack Infantry (Drone)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">2</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">2</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">7</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c7a9603a-6240-5f46-be00-7e6049bd8b55-6e27b8e" name="Pulse bomb" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="66"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Bomb, Large Blast, One Use Only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="dbf0d57e-f4d2-8b14-1371-8979b44fde21-6e27b8e" name="Pulse Bomb Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="69"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After a bombing run, roll a D6. On 2+, another pulse bomb is created. On a 1, no more bombs can be created.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="cbb0da66-186b-a0ad-d442-e6337658b410-6e27b8e" name="Pulse carbine" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="66"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2, Pinning</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="18efaa78-3c14-01f1-5e96-c517b97fbb61-6e27b8e" name="Pulse pistol" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="66"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Pistol</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="567cd349-df9b-44f9-1268-d770e5d2d4a3