    <selectionEntry id="f76ebd89-ec8b-2586-182e-9bd08675426b-a9821" name="Commander R'alai [FW]" page="265" hidden="false" collective="false" type="model">
      <profiles />
      <rules>
        <rule id="25e5104b-baa5-bd94-1e23-856319ca500e-a9821" name="Lone Warrior" page="265" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Shas'o R'alai can not leave or join units other than the unit he forms with his Blacklight Drones. In addition, he may not take an XV8 Crisis Bodyguard Team.</description>
