    <selectionEntry id="1742-d634-5a59-4962-a9821" name="Targeted Reconnaissance Cadre" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="5ce7-2b98-6b14-21fd-a9821" name="Mobile Insertion Force" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>As long as the Commander from this Formation is on the battlefield at the beginning of your turn, you can choose one unit from this Formation to move up to 6" before your Movement phase begins. The unit you choose cannot be locked in combat, Falling Back, or Pinned. If the unit doesn't move in the subsequent Movement phase, they are considered to be stationary.</description>
        </rule>
      </rules>
