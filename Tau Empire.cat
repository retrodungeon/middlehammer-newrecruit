      <rules>
        <rule id="0336-04da-735d-2937-a9821" name="Supreme Loyalty" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>While Aun'Va is alive, all friendly units with the Tau Empire Faction on the battlefield re-roll failed Fear, Morale, Pinning and Regroup tests.</description>
        </rule>
        <rule id="9014-ee90-68a8-7006-a9821" name="Great Invocation" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When using Invocation of the Elements special rule, Aun'Va invokes up to two elemental powers per turn, instead of just one.</description>
        </rule>
      </rules>
