    <selectionEntry id="e1fc-abb7-7061-fad8-a9821" name="Hunter Cadre" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="156a-6d2f-6abf-4f6a-a9821" name="Unbreakable Bonds of Comradeship" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units from this Formation that have the Supporting Fire special rule can provide Supporting Fire to any other model in this Formation if they are within 12" of each other, rather than 6".</description>
        </rule>
        <rule id="f2a8-d1de-257d-93ce-a9821" name="Ambushes and Feints" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units from this Formation that are within 12" of this Formation's Commander or Cadre Fireblade at the start of the Shooting phase can Run or move Flat Out and then shoot in that Shooting Phase. Each unit must complete both actions before you move onto the next unit - otherwise the chance to make the second action is forfeit.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries>
