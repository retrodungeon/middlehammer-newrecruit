    <selectionEntry name="Kroot Hound Pack" id="55b9-18b3-cd7a-8986" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Fast Attack" id="6d0b-3d16-8e3b-95b9" hidden="false" primary="true" targetId="74fe-37c3-fbbf-849e" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="02dc-e73d-f9f7-357a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Attached Unit" id="b29c-e65b-5fdd-5a1d" hidden="false">
          <description>A unit of Kroot Hounds must be attacked to a Kroot Carnivore squad before the game. They are deployed along with the Kroot Carnivore squad as if they were all a single Troop choice selection from the Force Organisation chart (but the Kroot Hound Pack still occupies a Fast Attack choice). There cannot be more attached models (including Krootox) added to a Carnivor squad than Kroot.

Once attached, the Kroot Hounds function as part of the Carnivore squad they are attached to. Their Leadership and Armor save will be the same as the unit they are attached to.</description>
        </rule>
        <rule name="Release the Hounds" id="e25a-eb1b-1bb2-5d3e" hidden="false">
          <description>If enemy Fall Back from close combat with a Kroot unit, each Kroot Hound will inflict a single automatic Strength 4 hit on an enemy model.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Kroot Hounds" id="a9b3-fd9d-ab18-b747" collective="false" defaultSelectionEntryId="ea29-0208-47f0-6160" hidden="false" import="true">
          <constraints>
            <constraint id="e55e-9807-1fcb-a5c0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="8" />
            <constraint id="f772-0a7f-e814-0484" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="2" />
