    <selectionEntry id="f8b8-8fa5-db78-921c-a9821" name="Retaliation Cadre" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="32e2-1780-9449-4d3f-a9821" name="Low Altitude Deployment" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If all of the units from this Formation start in Reserve, you can announce before the battle begins that they will use Low Altitude Deployment. If you do so, deploy the entire Formation using the Deep Strike special rule at the start of your Second Turn.</description>
        </rule>
        <rule id="d034-d535-e4fe-0c7c-a9821" name="Drop Zone Clear" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
