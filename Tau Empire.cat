    <selectionEntry id="cff3-d611-4cca-c8f9-a9821" name="Allied Advance Cadre" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="e405-c162-9e08-680d-a9821" name="Guerilla Fighters" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Vespid Stingwing units from this formation gain Infiltrate and Stealth (Forests) special rules.</description>
        </rule>
        <rule id="78cb-1f8d-4259-ba67-a9821" name="Strategic Intel" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Kroot Carnivore units from this Formation that are within 12" of a Vespid Stingwing unit from this Formation replace their Stealth (Forests) special rule with Shrouded (Forests) special rule, and add 1 to their BS.</description>
        </rule>
        <rule id="8a17-61df-6e8d-411e-a9821" name="Combined Battleforce" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units from this Formation have the Supporting Fire special rule, but can only provide Supporting Fire for other units from their Formation.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="fc3e-1f0b-75b0-1aa8-a9821" name="Kroot - 4 required" hidden="false" collective="false" defaultSelectionEntryId="2516-2c22-9e53-1be8-a9821">
