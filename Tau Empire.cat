    <selectionEntry id="4ede-4566-ba4e-77af-a9821" name="Drone-Net VX1-0" page="79" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="cde0-4bd1-214b-f29d-a9821" name="Collective Targeting Data" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In the Shooting phase, add 1 to the BS of all Drones (including Drones that are not part of this Formation) as long as at least 2 units from this Formation are on the Battlefield.</description>
        </rule>
        <rule id="d782-3035-347a-faab-a9821" name="Enhanced Tactical Responses" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Drones in this Formation have the Interceptor, Jink, Outflank, Precision Shots, and Split Fire special rules.</description>
