        <selectionEntry id="42a51180-f8e5-342e-8df8-229f9fee56d5-a9821" name="R'varna Battlesuit" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules>
            <rule id="d0fab238-7f43-14ad-d7c5-937ee451c034-a9821" name="XV107 Battlesuit" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
