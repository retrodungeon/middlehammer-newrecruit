        <entryLink id="mh-rad-blood-angels-e4d2-7806-fbb2-669e" name="Saturnine Pettern Terminator Armour" hidden="false" collective="false" import="true" targetId="mh-rad-blood-angels-cc0c-51d1-0f22-9809" type="selectionEntry">
