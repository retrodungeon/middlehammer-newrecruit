        <rule id="e52a5bc4-5af2-1500-db5a-6fe8e1e5d5e2-29754" name="Auro of Fervour" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All other friendly models with the Blood Angels Faction that are within 6" of the Sanguinor add 1 to their Attacks.</description>
        </rule>
