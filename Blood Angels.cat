    <selectionEntry id="7cdd-1acf-155d-2c20-29754" name="&quot;Golden Host&quot;" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="4573-61af-e4be-388c-29754" name="Airborne Assault" page="113" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>From your second turn, you may choose which turn the units from this Formation arrive from Reserve (no need to roll). All units must arrive on the same turn and all must Deep Strike. You may re-roll the scatter dice when Deep Striking units from this Formation.</description>
        </rule>
        <rule id="d39e-fd5c-a87e-78a1-29754" name="Glory of Sanguinius" page="113" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units from this Formation may charge on the turn they Deep Strike, but count as disordered if they do so.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
