            <selectionEntry type="upgrade" import="true" name="Standard Bearer" hidden="false" id="94c9-ab50-80ed-798c" sortIndex="7">
              <selectionEntryGroups>
                <selectionEntryGroup name="Standard" id="85b2-68ed-52b7-22b8" hidden="false">
                  <selectionEntries>
                    <selectionEntry type="upgrade" import="true" name="Company Standard" hidden="false" id="a68d-5e6c-cafd-c1a0" sortIndex="1">
                      <profiles>
                        <profile name="Company Standard" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="c0bd-f05d-e36a-0cf2">
                          <characteristics>
                            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A Company Standard allows any Space Marine unit with at last one model within 12" of the standard to re-roll any failed Morale or Pinning test.</characteristic>
                          </characteristics>
                          <alias>Company Banner</alias>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Blood Angels Chapter Banner" hidden="true" id="02a2-069e-f7eb-a794" sortIndex="2">
