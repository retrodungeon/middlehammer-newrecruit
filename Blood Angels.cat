            <infoLink id="mh-rad-blood-angels-b7b6-3c05-1ce5-b057" name="Power Axe" hidden="false" targetId="mh-rad-blood-angels-b3af-1eca-6629-4894" type="profile" />
            <infoLink id="mh-rad-blood-angels-4883-6894-6bfe-8fa0" name="New InfoLink" hidden="false" targetId="mh-rad-blood-angels-5eea-958c-d623-c3c9" type="rule" />
