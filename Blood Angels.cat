            <rule id="1009447c-bb4f-80f5-0de8-81bcebceb431-29754" name="Feedback" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>If a weapon with this type fails its Penetration roll or fails a To Wound roll a D6. On a 1 the firing model loses 1 Hull Point.</description>
            </rule>
          </rules>
