        <infoLink id="mh-rad-blood-angels-cdd4-293e-c4a2-8738" name="Armoured Ceramite" hidden="false" targetId="mh-rad-blood-angels-2e87b8ca-7cd1-78b9-2116-246015e7935e" type="profile" />
        <infoLink id="mh-rad-blood-angels-ec14-27f8-6e25-5eaf" name="Assault Vehicle" hidden="false" targetId="mh-rad-blood-angels-45cf-653a-4ff6-f22d" type="rule" />
