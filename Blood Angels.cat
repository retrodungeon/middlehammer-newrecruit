    <selectionEntry id="mh-rad-blood-angels-0fe8-c7be-8d32-0506" name="Crimson Paladins (Heresy)" publicationId="ca571888--pubN103311" page="207" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="mh-rad-blood-angels-55c6-cb1d-7253-a59b" name="The Blood is Forever" publicationId="ca571888--pubN103311" page="207" hidden="false">
          <description>While locked in combat with a unit that outnumbers them, a Crimson Paladin squad gains the Feel No Pain (5+) special rule. If outnumbered by more than twice their own number then they instead gain the Feel No Pain (4+) special rule. Any Independent Characters that join this squad do not gain this special rule and do not count for the purposes of determining when the squad is outnumbered. Each Crimson Paladin and Crimson Exemplar is counted as two models (as are any enemy models with the Bulky rule, models with other versions of the Bulky special rule count as the number of models they would for purposes of Transport Capacity).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-blood-angels-01a9-8c08-2b6a-298d" name="Stubborn" hidden="false" targetId="mh-rad-blood-angels-7be5-30af-1a02-0a89" type="rule" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="mh-rad-blood-angels-43cd-b008-df43-6c3d" name="Deep Strike" hidden="false" targetId="mh-rad-blood-angels-29f7-f993-6e8c-0a5d" primary="false" />
