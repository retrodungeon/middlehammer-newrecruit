            <selectionEntry name="Blood Talons" id="7726-d1ce-4b3a-2013" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1502-311d-1270-bf98" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1" />
              </constraints>
              <profiles>
                <profile name="Blood Talons" id="26a9-0674-d9f2-65e6" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
                  <characteristics>
                    <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Blood Talons follow the rules for Lightning Claws. In addition, if the Dreadnought has two Blood Talons, for every unsaved wound caused with a Blood Talon in close combat, the Dreadnought immediately makes an additional attack. These extra attacks can generate further additional attacks in the same way, until no further unsaved wounds are caused, or all the enemy are slain.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Blood Talons" id="d0d5-9fe5-0e36-7566" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
                  <characteristics>
                    <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Blood Talons follow the rules for Lightning Claws. In addition, if the Dreadnought has two Blood Talons, for every unsaved wound caused with a Blood Talon in close combat, the Dreadnought immediately makes an additional attack. These extra attacks can generate further additional attacks in the same way, until no further unsaved wounds are caused, or all the enemy are slain.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
