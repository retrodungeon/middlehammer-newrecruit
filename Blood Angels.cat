                <profile id="8c60b720-ceff-31fd-451a-ee132bf7bbd9-29754" name="Illum flares" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May drop a single flare each turn, these 'Flare marks' are used in the same manner as Bombs and work until the end of the turn. Any unit targeting an enemy within 12" of the Flare marker gains Night Vision for that Shooting phase. If the unit also has the Split Fire rule, it only benefits from Night Vision while firing at units with at leasto ne model within 12" of the Flare.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules />
              <infoLinks />
              <modifiers />
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ac480d41-1f5d-7411-84f4-6afd430dd6f4-maxSelections-29754" type="max" />
