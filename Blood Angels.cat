    <selectionEntry id="b1ed0383-107c-6855-405d-21a8e657d8bb-29754" name="Archangels Orbital Intervention Force" hidden="true" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="f7496255-b350-e24c-3ea5-316744f7cdcd-29754" name="Swift Deployment" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All unit in this Formation must be held back in Deep Strike Reserve. When making Reserve Rolls, make a single roll for the entire Formation. On a successful Reserves Roll, all of the units in this Formation arrive from Deep Strike Reserve. Units in this Formation can Run and then shoot on the turn they arrive by Deep Strike.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
