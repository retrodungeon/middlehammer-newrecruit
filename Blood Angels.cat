          <rules>
            <rule id="4c1ef69c-a306-9944-93f8-17814c6bb3e3-29754" name="Killing Strike" page="0" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>When a weapon with this special rule rolls a 6 To Wound, the target is wounded automatically, regardless of the target's Toughness, and the Wound has the Instant Death special rule.</description>
            </rule>
          </rules>
