              </profiles>
              <rules>
                <rule id="ced7-1d1c-303d-a07d-29754" name="Shell Shock" hidden="false">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <description>Due to the rapid impact of the Quad Mortar's shells, Pinning tests taken because of its attacks are made at a -1 Leadership penalty.</description>
                </rule>
                <rule id="875c-a31d-fd32-8a0e-29754" name="Sunder" hidden="false">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <description>Attacks with this special rule may re-roll failed Armour Penetration rolls.</description>
                </rule>
              </rules>
              <infoLinks />
              <modifiers />
