          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="810c7979-8467-7a54-7e27-98668cae6737-maxSelections-29754" type="max" />
