            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-blood-angels-198b-8408-7066-a175" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-blood-angels-365a-e5fb-b92b-14b5" name="The Cataphractii Primus" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">In addition to the standard rules for this armour type, the wearer gains the Eternal Warrior special rule and adds 1 to their Toughness characteristic against Shooting attacks.</characteristic></characteristics></profile>
          </profiles>
          <infoLinks>
            <infoLink id="mh-rad-blood-angels-66a9-1b3c-6b52-f5d1" name="Eternal Warrior" hidden="false" targetId="mh-rad-blood-angels-3e0b-be9f-b7eb-8c5e" type="rule" />
          </infoLinks>
          <categoryLinks>
            <categoryLink id="mh-rad-blood-angels-c5eb-70c9-468f-a663" name="Infantry" hidden="false" targetId="mh-rad-blood-angels-a2ba-16b0-8590-b017" primary="false" />
            <categoryLink id="mh-rad-blood-angels-ca93-10ad-9ead-5e1c" name="Terminators" hidden="false" targetId="mh-rad-blood-angels-37dc-7aa6-8150-41b0" primary="false" />
          </categoryLinks>
          <entryLinks>
            <entryLink id="mh-rad-blood-angels-adf9-2f75-a5b0-31dc" name="Terminator Armour" hidden="false" collective="false" import="true" targetId="mh-rad-blood-angels-fea8-8a3a-65d6-59bd" type="selectionEntry">
