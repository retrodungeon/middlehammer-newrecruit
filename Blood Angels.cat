            <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Blood Reaver" id="b72c-c9ff-c9e3-39ed" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Blood Reaver is a two-handed weapon. Hits from Blood Reaver are resolved at Strength 8 and have the Rending Special Rule.</characteristic>
          </characteristics>
        </profile>
        <profile name="Whirlwind of Gore" id="57fe-a670-490a-942b" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Instead of making his normal attacks, Seth can instead choose to whirl Blood Reaver in a gore-splattered arc. If he does so, Seth inflicts a single automatic hit on all enemy models in base contact. Declare whether or not Seth will perform this attack before any blows are struck.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ferocious Instincts" id="a81e-3c79-3089-9e53" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">For every roll of '1' to hit against Seth in close combat, enemy units immediately suffer an automatic Strength 4 hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
