                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units composed entirely of models in Terminator armour do not scatter when arriving from Deep Strike Reserve, so long as the first model is placed within 6" of the teleport homer's bearer. For this to work, the bearer must have been on the battlefield at the start of the turn.</characteristic>
