          </costs>
        </selectionEntry>
        <selectionEntry id="74038837-c970-d640-e2e1-194ee983c98b-29754" name="Blessed autosimulacra" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="16c9ef26-771e-734d-b42b-099768a0c19e-29754" name="Blessed autosimulacra" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
