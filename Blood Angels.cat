          <infoLinks>
            <infoLink id="mh-rad-blood-angels-6355-28a8-3cfc-c772" name="Power Maul" hidden="false" targetId="mh-rad-blood-angels-6bbe-f2c1-78e2-da59" type="profile" />
            <infoLink id="mh-rad-blood-angels-bf51-c5a8-ef8a-3657" name="New InfoLink" hidden="false" targetId="mh-rad-blood-angels-9d85-46f7-f5e6-a5f7" type="rule" />
          </infoLinks>
