    <entryLink id="46ae-e6a2-78d5-e6d3" name="Venerable Dreadnought (IA)" hidden="false" collective="false" import="true" targetId="784e-79ec-558e-26ee" type="selectionEntry">
      <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-8ac8-b0a2-9d27-1696" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints>
        <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1d1a-09d1-8279-5a9b" type="max" />
      </constraints>
      <rules>
        <rule id="8cd5-da41-1743-9a3a" name="Black Rage" hidden="false">
          <description>The dreadnought must always move towards the enemy as fast as possible, and must assault an enemy within range in the assault phase.</description>
        </rule>
        <rule id="0372-bcce-c560-0dff" name="Rampage" hidden="false">
          <description>The dreadnought ignores any Crew Shaken and Crew Stunned results.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="73e6-533e-02c3-eee4" name="Death Company Special Rules" hidden="false" targetId="71bf-c6ac-56a8-9599" type="infoGroup" />
