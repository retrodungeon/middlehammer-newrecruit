    <selectionEntry id="66b3c49a-b1d5-e68c-6f8d-0c06cf921108-29754" name="Archangels Sanguine Wing" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="15210b7e-3437-f32a-98bc-293be9fd8115-29754" name="Surgical Strike Force" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>This Formation's unit of Sternguard Veterans begins the game embarked upon the Formation's Stormraven Gunship. The Formation's Vanguard Veterans must be placed in Deep Strike Reserve. When making Reserve Rolls, make a single roll for the entire Formation, which you can choose to re-roll. On a successful Reserves Roll, all of the units in this Formation arrive from Reserve.</description>
        </rule>
        <rule id="deaab272-2c9a-e564-9939-672cf6a9c2cc-29754" name="1st Company Armoury" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Vanguard Veteran Squads from this Formation can take a single power weapon or lightning claw per model as a free upgrade. Sternguard Veteran Squads from this Formation can take a single storm bolter or combi-weapon per model as a free upgrade.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
