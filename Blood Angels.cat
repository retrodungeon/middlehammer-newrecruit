    <profile id="mh-rad-blood-angels-423f-013f-cb9f-b6bb" name="Twin-Linked Autocannon" publicationId="ca571888--pubN106502" page="176" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
