      </infoLinks>
      <rules>
        <rule name="Sanguinius' Chosen" id="ffa3-c0ea-f948-3514" hidden="false">
          <description>Any Blood Angel models within 6" of the High Priest may re-roll any missed 'to hit' rolls in the same turn that they charge into combat.</description>
        </rule>
        <rule name="The Red Grail" id="a95a-84ee-e6ee-61db" hidden="false">
          <description>Any Blood Angels unit with a model within 6" of a character with a Grail may roll an extra dice when making an advance after winning a close combat and discard the lowest. 
In addition, any Blood Angels models with 2D6" of Corbulo add +1 to their Attacks characteristic (roll at the start of every assault phase).</description>
        </rule>
      </rules>
