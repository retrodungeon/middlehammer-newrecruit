    <selectionEntry id="mh-rad-blood-angels-5826-b288-af71-533d" name="Dawnbreaker Cohort (Heresy)" publicationId="ca571888--pubN103311" page="206" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="mh-rad-blood-angels-0b43-5843-9abf-41c4" name="Set the Sky Aflame" publicationId="ca571888--pubN103311" page="206" hidden="false">
          <description>If this unit enters play via Deep Strike all enemy units within 6" immediately suffer D6 Str 4 Ap - hits. Roll once to determine the number of hits applied to all units within range.</description>
        </rule>
