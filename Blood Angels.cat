      <rules>
        <rule id="f730-83f4-f889-bad2-29754" name="Rites of Bloods" page="105" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In the turn a Death Company Chaplain charges, all Death Company Marines in his unit re-roll failed To Wound rolls. Does not apply to disordered charges.</description>
        </rule>
