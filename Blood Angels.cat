      <selectionEntries>
        <selectionEntry id="mh-rad-blood-angels-9b2d-5b84-bc67-4c65" name="Siege Melta Array" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-blood-angels-40d7-3c5e-fdef-ecb9" type="max" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-blood-angels-8b4c-ef30-6b4c-c9e7" type="min" />
          </constraints>
          <profiles>
            <profile id="mh-rad-blood-angels-8278-38f2-df1e-e78c" name="Siege Melta Array" publicationId="ca571888--pubN89821" page="242" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">9</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4, Blast, Melta, Stone Burner</characteristic></characteristics></profile>
