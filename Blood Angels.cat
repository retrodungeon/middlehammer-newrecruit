        <profile name="Stormraven Gunship" id="dd7f-8076-fb8f-464f" hidden="false" typeId="0092-3322-1b28-b657" typeName="Vehicle">
          <characteristics>
            <characteristic name="BS" typeId="b539-c71b-9239-8da0">4</characteristic>
