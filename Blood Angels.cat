    <selectionEntryGroup id="mh-rad-blood-angels-419e-5b16-d2d7-ee8c" name="Scions of the Hekatonystika" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-blood-angels-8429-0ef6-fe10-4312" type="max" />
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-blood-angels-3a27-b90b-be2d-ece7" type="min" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="mh-rad-blood-angels-003e-585f-8280-f892" name="Augurs of Weakness" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true" type="upgrade">
          <rules>
            <rule id="mh-rad-blood-angels-0768-5480-e25c-e2d2" name="Augurs of Weakness" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false">
              <description>When making an Armour Pentration roll against a target with Armour 11 or more on the facing targeted, a model with this special rule may add plus 1 to the Strength of the weapon used to make the attack.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-blood-angels-cd8c-3564-f83e-50d4" name="Icons of Resolve" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true" type="upgrade">
          <rules>
            <rule id="mh-rad-blood-angels-7543-74d5-0cf9-202c" name="Icons of Resolve" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false">
              <description>This model gains plus 1 Attacks on any turn in which it, or a unit it is part of, is Charged by one or more enemy units.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-blood-angels-bfed-7f04-3caa-1186" name="Guardians of Sanctity" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true" type="upgrade">
          <rules>
            <rule id="mh-rad-blood-angels-c8d6-becd-38d1-e78a" name="Guardians of Sanctity" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false">
              <description>When making a Deny the Witch roll for a unit that includes this model, roll an additional d6 and discard the lower result before determining if the roll succeeds or fails.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-blood-angels-8d3e-bb5c-efa0-eaf3" name="Slayers of Kings" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true" type="upgrade">
          <rules>
            <rule id="mh-rad-blood-angels-63a8-204f-42bf-84ae" name="Slayers of Kings" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false">
              <description>This model may re-roll failed To Hit rolls of '1' when engaged in combat or in a Challenge with any model with a Weapon Skill of 5 or higher.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-blood-angels-e915-4e75-bac3-24e3" name="Hunters of Beasts" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true" type="upgrade">
          <rules>
            <rule id="mh-rad-blood-angels-f0e0-2d25-4432-f2c5" name="Hunters of Beasts" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false">
              <description>This model may re-roll failed To Wound rolls of '1' when engaged in combat with any model with a Toughness of 5, or any failed To Wound roll if the target's Toughness is 6 or higher.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-blood-angels-2e27-76c9-4e48-1ea2" name="Reapers of Hosts" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true" type="upgrade">
          <rules>
            <rule id="mh-rad-blood-angels-d726-b385-f6e0-0ee3" name="Reapers of Hosts" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false">
              <description>This model gains plus 1 Attack in any Fight sub-phase wheich they being in base contact with more than one enemy model.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-blood-angels-7df4-c7ee-468d-e8f8" name="Breakers of Witches" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false" collective="false" import="true" type="upgrade">
          <rules>
            <rule id="mh-rad-blood-angels-bd43-c4ef-5be5-4378" name="Breakers of Witches" publicationId="690c-3e82-3080-6bc0" page="159" hidden="false">
              <description>This model may re-roll all To Hit and To Wound rolls in close combat when attacking an enemy unit affected by a Blessing psychic power, or an enemy unit with either the Psyker or Brotherhood of Psykers/Sorcerers, Psychic Pilot, Daemon, or Daemon of the Ruinstorm special rules.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
