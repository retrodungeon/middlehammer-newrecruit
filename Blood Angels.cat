        <infoLink name="Searchlight" id="da2e-872f-5f19-48d4" hidden="false" targetId="cdf1-af4d-b6a8-3a2a" type="rule" />
        <infoLink name="Smoke Launchers" id="dfd9-8866-3bb4-2aea" hidden="false" targetId="42cc-b2d9-b9f3-90ea" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Tear Attack" id="8244-9018-ccd9-2f0b" hidden="false">
          <description>The Furioso Dreadnought rolls 2D6 + Strength as Armour Penetration against vehicles</description>
        </rule>
        <rule name="Black Rage" id="c80e-0cfb-1df0-00fc" hidden="false">
          <description>Moriar must always move towards the enemy as fast as possible, and must assault an enemy within range in the assault phase.</description>
        </rule>
        <rule name="Rampage" id="7113-3fee-2d3b-1fd0" hidden="false">
          <description>Moriar ignores any Crew Shaken and Crew Stunned results.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Brother Captain Tycho (Death Company)" id="f974-9355-4ddd-ccb5" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HQ" id="5fd6-2c82-182d-9fcb" hidden="false" primary="true" targetId="ac8d-efba-1884-d3ad" />
        <categoryLink name="Blood Angel" id="7697-0801-0100-89e6" hidden="false" primary="false" targetId="a527-734f-2081-58cd" />
      </categoryLinks>
      <constraints>
        <constraint id="ff5e-e976-6622-01d5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1" />
      </constraints>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="120" />
      </costs>
      <infoLinks>
        <infoLink name="Tycho" id="2079-a7e6-5040-57e0" hidden="false" targetId="7397-98bf-66be-6525" type="profile" />
        <infoLink name="Boltgun" id="dd16-8f87-5774-653d" hidden="false" targetId="60bf-18fd-f6e6-6eb4" type="profile" />
        <infoLink name="Bolt Pistol" id="ea71-fdd5-abe1-f17d" hidden="false" targetId="e9ac-c779-51bb-3c9a" type="profile" />
        <infoLink name="Meltagun" id="be14-7bd3-bd36-0161" hidden="false" targetId="737d-c7ef-4cb5-e6fa" type="profile" />
        <infoLink name="Frag Grenades" id="5bfb-beab-4543-1353" hidden="false" targetId="9dd4-e950-2419-5934" type="profile" />
        <infoLink name="Krak Grenades" id="1c12-c606-ec70-318e" hidden="false" targetId="9c1b-bf93-059b-27f5" type="profile" />
        <infoLink name="Artificer Armor" id="2f25-241e-e743-87ad" hidden="false" targetId="7a02-cc04-9d97-3493" type="rule" />
        <infoLink name="Bionics" id="52ae-374d-0e02-53bc" hidden="false" targetId="93ed-72da-0689-8a2d" type="rule" />
        <infoLink name="Purity Seals" id="6344-e55f-5378-268d" hidden="false" targetId="8fca-253c-bbf8-9510" type="rule" />
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="5b52-fa19-64e5-2a60" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="ebb4-4e0b-f983-1fcf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Digi-lasers" id="f99a-5f6c-45db-1cfd" hidden="false">
          <description>One model in base contact with Tycho, suffers a wound on a D6 roll of 4+ at the start of the round before any close combat attacks are made. Normal saving throws are allowed. In addition, the digi-lasers provides an extra close combat weapon (to 4 A).</description>
        </rule>
        <rule name="Embittered" id="3c09-6241-fbe2-695c" hidden="false">
          <description>Any squad led by Tycho always moves towards the enemy D6".</description>
        </rule>
        <rule name="Hates Orks" id="fa04-1429-7043-b194" hidden="false">
          <description>When fighting against Orks, Tycho and any squad he leads automatically pass any Morale checks they are required to make. In close combat against Orks, Tycho always hits on a 3+.</description>
        </rule>
        <rule name="The Red Thirst" id="c64e-f6e4-302f-c092" hidden="false">
          <description>If a Death Company unit contains Tycho then it must move directly toward the nearest enemy as fast as possible and must make an assault if it can do so. This applies even if a Chaplain or a Sanguinary High Priest leads the Death Company.</description>
        </rule>
        <rule name="Ignore Injury" id="2795-8a00-e067-420f" hidden="false">
          <description>If a Death Company Space Marine loses a wound, roll a dice. On a 4+ the injury is ignored and the model continues fighting. This cannot be used against weapons which inflict instant death or against close combat weapons that allow no save.</description>
        </rule>
        <rule name="Transport" id="d7fc-70b7-6bf1-2d64" hidden="false">
          <description>A Death Company including Tycho may not use jump packs and must be mounted in a Rhino, unless there are more than 10 models in the unit, in which case they must march into battle on foot.</description>
        </rule>
        <rule name="Brother Captain Tycho (Death Company)" id="4bd2-992e-3e12-6a59" hidden="false">
          <description>Tycho must join the Death Company unit, which must contain a Chaplain. He fights as one of the Death Company and does not follow any of the independent character rules. Opponents may designate him as a target for melee attacks subject to the normal rules.</description>
        </rule>
      </rules>
    </selectionEntry>
