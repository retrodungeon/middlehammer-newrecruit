    <selectionEntry id="4dc0cf97-889b-6e57-369c-4302122e81ab-29754" name="Archangels Demi-company" hidden="true" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="1d8dfb5a-82f5-515f-ef75-61631e4f6ee7-29754" name="Stubborn" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        <description>When taking Morale tests, stubborn units always ignore any negative Leadership modifiers. Independent characters that are stubborn confer the ability onto any unit that they join.</description></rule>
