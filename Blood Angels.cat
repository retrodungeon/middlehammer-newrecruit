      <rules>
        <rule id="cd40710d-2f6d-ed71-1eb9-11f61f3b6f00-29754" name="Whirlwind of Gore" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When Gabriel Seth fights in close combat, any To Hit roll of a 6 causes 1 additional hit on the target.</description>
        </rule>
