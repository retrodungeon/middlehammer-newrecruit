    <profile id="mh-rad-blood-angels-4d8c-ee11-e291-bc32" name="Quad Launcher (Phosphex Cannister Shot)" publicationId="ca571888--pubN80998" page="125" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
