            <rule id="cb4f63ff-61b8-8d02-d227-77f9dab7dd57-29754" name="Preferred Enemy (Tyranids)" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            <description>Units with this ability can always re-roll their rolls to hit in close combat against their preferred enemy. This ability does not work when attacking vehicles without a Weapon Skill characteristic</description></rule>
