        <rule id="c6f421c9-96f6-5703-6be0-0c2e42b4096e-29754" name="Thunderhawk Transport (15)" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In addition to transporting 15 models, it may also carry two Rhino-sized Vehicles, or one Land Raider-sized vehicle (inc. Spartan, excluding Cerberus or Typhon). These Vehicles itself may also contain passengers.</description>
        </rule>
