            <profile name="The Blood Crozius" id="34c9-3dec-6c1a-0827" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
              <characteristics>
                <characteristic name="Ability" typeId="2113-98a2-4376-a94c">The Blood Crozius is a master-crafted power weapon.</characteristic>
              </characteristics>
            </profile>
            <profile name="Fury Unbound" id="6406-db2e-c5cb-6076" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If Lemartes suffers an unsaved wound, but is not slain, his Strength and Attacks both immediately increase to 5.</characteristic>
              </characteristics>
            </profile>
