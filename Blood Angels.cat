    <selectionEntry id="af80-794f-d6e2-31be-29754" name="&quot;Archangels Orbital Intervention Force&quot;" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="f916-6cc4-f4a4-6c25-29754" name="Swift Deplotment" page="109" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All units from this Formation must start in Deep Strike Reserve. When making Reserve Rolls, make a single roll for the whole Formation.</description>
        </rule>
        <rule id="b43c-455d-aa78-1ac9-29754" name="Orbital Intervention" page="109" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Terminator Squads may shoot twice in the turn they arrive by Deep Strike, at different targets if desired. Terminator Assault Squads may charge in the turn they arrive by Deep Strike, but count as disordered if they do so.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
