                <rule id="2c18f251-a0db-27a5-b4d1-9e49f41445c7-29754" name="Ferromantic Invulnerability" hidden="false">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <description>Ignores Lance and Melta-special rules by attacks made against it. Also reduces the effect of all damage-chart rolls by 1, except for Destroyer Weapons.</description>
