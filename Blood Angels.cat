              <profiles />
              <rules>
                <rule id="191d7408-a67b-4efb-06a7-9f1858c3eba7-29754" name="Heroic Intervention" page="0" hidden="false">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <description>Vanguard Veteran Squads ignore penalties for disordered charges. Furthermore, the Veteran Sergeant automatically passes the Initiative test if he wishes to make a Glorious Intervention.</description>
