        <selectionEntry id="e530-84b7-0b0d-7e2a-29754" name="Power capacitor" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="caf9-6786-13a6-f5d0-29754" name="Capacitor Fire" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the Vindicator Tank Destroyer has not moved this turn, the laser destroyer array becomes an Ordnance 2, Twin-linked weapon.</characteristic>
              </characteristics>
            </profile>
            <profile id="9745-fd56-50ab-4340-29754" name="Overcharged Fire" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The owning player may declare an overcharged volley if the vehicle has not moved this turn, in which case the laser destroyer array becomes Ordnance 3, Twin-linked. However, after the weapon is fired in this mode, roll a D6. On a roll of a 1, the Vindicator suffers a single Hull Point of damage.</characteristic>
              </characteristics>
            </profile>
          </profiles>
