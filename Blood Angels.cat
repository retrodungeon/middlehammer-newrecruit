    <selectionEntry id="8361f26c-35d6-6395-1834-0bedaef48045-29754" name="Flesh Tearers Vanguard Strike Force" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="da5f0eef-e2ac-3932-e9cd-0ea684f66b40-29754" name="Leading by Example" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Whilst this Formation's Vanguard Veteran squad is alive and on the battlefield, all units in this Formation ignore the penalties for disordered charges (including the penalty described in The Red Thirst, below) and have the Stubborn special rule.</description>
