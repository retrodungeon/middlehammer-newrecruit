        </profile>
      </profiles>
      <rules>
        <rule id="a13d9e46-55d1-169f-944a-15c25c8bc90e-29754" name="Liturgies of Blood" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In a turn in which Astorath charges into combat, all Death Company Marines in his unit re-roll failed To Wound rolls in the Fight sub-phase. A model that has made a disordered charge that turn receives no benefit from Liturgies of Blood.</description>
        </rule>
      </rules>
