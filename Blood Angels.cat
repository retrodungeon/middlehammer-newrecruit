      <rules>
        <rule name="Sanguinius' Chosen" id="984d-3460-2dd6-5894" hidden="false">
          <description>Any Blood Angel models within 6" of the High Priest may re-roll any missed 'to hit' rolls in the same turn that they charge into combat.</description>
