                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Concussive, Force, Rage-fuelled</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="9d8be4b7-169e-24c4-e608-bb52eb3fc406-29754" name="Rage-fuelled" hidden="false">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <description>A model with Gallian's Staff can re-roll any dice rolls of a 1 when making a Psychic Test, but will immediately suffer a Wound, with no saves of any kind allowed, for each re-rolled dice that is also a 1.</description>
                </rule>
              </rules>
              <infoLinks />
