        <selectionEntry id="7955cc45-639d-3cd1-9317-470d2dca409c-29754" name="Tarantula Sentry Gun" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules>
            <rule id="3c0ec3f5-1f82-5b55-ae1f-8cfe07deca13-29754" name="Firing Modes" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Select a firing mode before the game starts. Point Defence: Fixed arc of 90 degrees with 36" range. Sentry: 360 degrees arc with 18" range. Heavy Bolters automatically target the nearest enemy non-Vehicle. Lascannon/MM automatically target the nearest enemy Vehicle or MC.</description>
            </rule>
          </rules>
