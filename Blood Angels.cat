                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Nominate one non-Relic weapon of your Warlord to become Master-crafted.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="084b00b1-a77e-cddb-d25b-086462432dcb-29754" name="4. Soulwarden" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
