    <selectionEntry type="upgrade" import="true" name="Space Marine Bike" hidden="false" id="4836-38de-4ae4-40a8">
      <profiles>
        <profile name="Space Marine Bike" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="df64-18dc-274c-2ce3">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Models with Space Marine Bikes follow all rules for Bikes and are equipped with twin-linked bolters.</characteristic>
          </characteristics>
        </profile>
        <profile name="Teleport Homer" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear" hidden="false" id="6f5e-cc1c-f390-d522">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If Terminators wish to teleport onto the battlefield via Deep Strike and choose to do so within 6" of the model carrying the teleport homer, then they won't scatter. Note that the homer only worked for squads who are teleporting, not for squads entering play using jump packs, drop pods or other means of transport. Also note that the homer must already be on the table at the start of the turn for it to be used.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <modifiers>
        <modifier type="append" value="(5)" field="5.423232344415441e+21" scope="parent" affects="self.entries.profiles.Unit" join=" " position="3" />
        <modifier type="replace" value="Bike" field="556e6974205479706523232344415441232323" affects="self.entries.profiles.Unit" scope="parent" arg="Infantry" />
      </modifiers>
      <infoLinks>
        <infoLink name="Bolter" id="bf8b-a215-9d5f-37f4" hidden="false" type="profile" targetId="fa34-07ff-1a5d-fe9f">
          <modifiers>
            <modifier type="set" value="Twin-linked Bolter" field="name" />
            <modifier type="append" value="Twin-linked" field="8b10-045a-f593-605e" join=", " />
          </modifiers>
        </infoLink>
        <infoLink name="Turbo-Boosters" id="3847-df83-3e04-03fa" hidden="false" type="rule" targetId="793e-3ba7-feb3-8ad4" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="842e-322b-5a4c-f5e1">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="73e7-23e8-cfcc-1af9" includeChildSelections="false" />
