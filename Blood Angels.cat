          </constraints>
          <selectionEntries>
            <selectionEntry id="3e064b41-ab93-07dd-fc6f-8266816a7f86-29754" name="Vanguard Veteran Squad" hidden="false" collective="false" type="unit">
              <profiles />
              <rules>
                <rule id="4ee7a998-d9f7-ab6d-a2ee-cebe07b6338b-29754" name="Heroic Intervention" page="0" hidden="false">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <description>Vanguard Veteran Squads ignore penalties for disordered charges. Furthermore, the Veteran Sergeant automatically passes the Initiative test if he wishes to make a Glorious Intervention.</description>
                </rule>
              </rules>
