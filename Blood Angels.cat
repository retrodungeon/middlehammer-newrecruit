    <profile id="mh-rad-blood-angels-68c9dde3-0696-1478-ab0c-341dfa37bf16" name="Solarite Power Gauntlet" publicationId="ca571888--pubN113187" page="97" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Master-crafted, Unwieldy</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-580dd5a9-f85d-c9f3-eeff-e72d970ad9e5" name="Sonic Shrieker" page="" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Models with a Sonic Shrieker imposes a -1 WS penalty on enemy models in base contact in assault.  Enemies which are immune to Fear are also immune to this effect.  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-48ee-9a7f-07f1-22d0" name="Tartaros Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save.  Maodels in Tartarus armour may make Sweeping Advances in combat unlike other patterns of Terminator armour. If a model with Tartarus pattern armour is joined by a character equipped with a different pattern of Terminator armour or vice versa, this ability is lost. </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-345c9b22-c89e-3234-d710-9b9262a1fd38" name="Tempest Bolt Shells" publicationId="ca571888--pubN80998" page="85" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">6</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Rapid Fire, Blast (3")</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-b7d58e49-6b8c-56f3-df2c-472ac811a571" name="Trophies of Judgement" publicationId="ca571888--pubN113187" page="57" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides Fear special rule</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-fb27-514e-2487-c427" name="Unstable Internment" publicationId="ca571888--pubN89821" page="239" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Must always make Sweeping Advances when able, but may never be counted as a scoring unit.  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-67ae3255-7245-4f31-4997-ee38d71956b7" name="Vigil Pattern Storm Shield" publicationId="ca571888--pubN113187" page="97" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers  3+ Invulnerable save, but user may never claim the bonus attack for having 2 close combat weapons.  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-808b-34b7-2ca8-29fd" name="Tempest Rockets" publicationId="ca571888--pubN80998" page="47" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">60"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Sunder, One-shot</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-16f6-887b-504f-56da" name="Hellstrike Missiles" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">72"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Sunder, One-Shot</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-328c-2d71-a3d8-20c6" name="Arachnus heavy lascannon battery" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 2, Exoshock</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-a654-c4d7-5e67-0a65" name="Helical Targeting Array" publicationId="ca571888--pubN80998" page="79" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If the Dreadnought chooses to neither move nor Run in its turn it may, if its controlling player wishes, gain the Skyfire and Interceptor special rules for that entire game turn (ie, both the controlling player’s turn and their opponent’s following player turn) for all of its weapons except its heavy bolters/heavy flamers.</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-b33b-ae25-d3ca-3b18" name="Sicaran Pattern Tank" publicationId="ca571888--pubN80998" page="72 &amp; 73" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
      <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">13</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Vehicle (Tank, Fast)</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-5162-7d25-fd22-1b37" name="Quad Launcher (Shatter)" publicationId="ca571888--pubN80998" page="125" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4, Sunder</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-9d51-7566-2ac6-1c08" name="Quad Launcher (Splinter)" publicationId="ca571888--pubN80998" page="125" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">12" - 36"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4, Barrage, Blast, Rending</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-e2e6-c3ad-41be-d14d" name="Quad Launcher (Incendiary)" publicationId="ca571888--pubN80998" page="125" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
