  <infoGroup id="71bf-c6ac-56a8-9599" name="Death Company Special Rules" hidden="false">
      <rules>
        <rule id="d63f-23a2-9db2-0716" name="Ignore Injury" hidden="false">
          <description>If a Death Company Space Marine loses a wound, roll a dice. On a 4+ the injury is ignored and the model continues fighting. This cannot be used against weapons which inflict instant death or against close combat weapons that allow no save.</description>
        </rule>
        <rule id="b106-7a57-b2f8-c1db" name="Death Company" hidden="false">
          <description>All units add +1 A and +1 L. All characters gain +1 A.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="be59-3f62-1ef9-c4dc" name="The Black Rage" hidden="false" targetId="3782-e249-5b58-2b5f" type="rule" />
        <infoLink id="60cb-a904-d130-0036" name="Fearless" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
      </infoLinks>
    </infoGroup>
