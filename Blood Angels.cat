            <profile id="4348ed20-cabe-67c2-5ec1-827d4a8e8d48-29754" name="The Red Grail" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly units with the Blood Angels Faction within 6" of Corbulo (including Corbulo himself) add 1 to their Weapon Skill and Initiative. The bonus to Weapon Skill is not cumulative with the bonus granted by a blood chalice.</characteristic>
