    <selectionEntry id="mh-rad-blood-angels-9fb7-a82a-11cb-fc8e" name="Legion Seeker Squad (Heresy)" publicationId="ca571888--pubN80998" page="48" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="mh-rad-blood-angels-3376-8a4e-a355-3135" name="Special Issue Ammunition" publicationId="ca571888--pubN80998" page="48" hidden="false">
          <description>Seeker Space Marines are equipped with Kraken, Scorpius and Tempest bolt shells for their bolters (and combi-weapons where applicable), and may choose which to use each turn they fire.</description>
        </rule>
        <rule id="mh-rad-blood-angels-8e27-703d-8305-4072" name="Marked for Death" publicationId="ca571888--pubN80998" page="48" hidden="false">
          <description>After deployment, each Seeker unit may specify a single enemy unit or Independent Character as being 'Marked for Death.'  The Legion Seeker unit now counts as having the Preferred Enemy special rule against the chosen target.</description>
        </rule>
      </rules>
      <infoLinks>
