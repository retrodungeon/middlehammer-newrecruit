                    <rule id="8dd2bc7d-d9f0-c921-2e21-1083e9a79075-29754" name="Tremor" hidden="false">
                      <profiles />
                      <rules />
                      <infoLinks />
                      <modifiers />
                      <description>Any unit hit moves as if in difficult terrain on its next turn. If it is already in difficult terrain, it rolls one less dice than normal to determine distance moved. Vehicles hit must take a Dangerous Terrain test if they move in the subsequent turn.</description>
                    </rule>
