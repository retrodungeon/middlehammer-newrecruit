      </characteristics>
    </profile>
    <profile name="Black Rage" id="9440-c26d-6314-2e0c" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This unit is subject to the Rage special rule. Additionally, they never count as a scoring unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hand Flamer" id="389c-f7a0-ea2a-36e1" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
