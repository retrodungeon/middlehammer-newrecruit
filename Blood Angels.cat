    <selectionEntry id="a000-ae11-d402-1364-29754" name="Carmine Host" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="b71e-2bf6-7f55-ceef-29754" name="Honour of the Primarch" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Once per game, at the start of the turn, the Captain can call upon his battle-brothers to remember the glory of Sanguinius and emulate his greatness in the crucible of battle. Until the beginning of the next turn, the Captain and any units from the Carmine Host that are within 12" of him have Feel No Pain and It Will Not Die special rules.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups />
