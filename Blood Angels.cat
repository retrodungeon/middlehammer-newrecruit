    <selectionEntry id="16954bb8-fab1-8794-3a9e-85e9ce96b72c-29754" name="Chaplain" hidden="false" collective="false" type="unit">
      <profiles>
        <profile id="ef8b47fc-98b3-789a-8e95-c452391c5a9d-29754" name="Chaplain" page="0" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
