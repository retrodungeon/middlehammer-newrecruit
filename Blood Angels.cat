            <selectionEntry id="62f67bc1-f581-cad9-2b01-c470d6df0989-29754" name="Hekaton siege claw with twin-linked rad cleanser" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="23e47466-ec4f-e51c-4887-8369498ae327-29754" name="Rad cleanser" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
                  <profiles />
