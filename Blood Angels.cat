        <entryLink id="mh-rad-blood-angels-8cbe-2c98-30a2-a305" name="Cataphractii Pattern Terminator Armour" hidden="false" collective="false" import="true" targetId="mh-rad-blood-angels-8e48-47c8-48c4-6162" type="selectionEntry">
