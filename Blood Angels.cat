            <rule id="fa42de19-8d23-6b2b-1dfa-88d07d29693b-29754" name="Shock Pulse" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Any vehicle (including Super-heavy) that suffers a Penetrating hit from a weapon with this type may only fire Snap Shots in the following game turn.</description>
