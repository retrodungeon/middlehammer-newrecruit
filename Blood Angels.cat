                      <rules />
                      <infoLinks />
                      <modifiers />
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units from the Armies of the Imperium (see the Allies chart in Warhammer 40,000: The Rules) within 12" of your Warlord have the Fearless special rule.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
