    <selectionEntry id="mh-rad-blood-angels-7b26-a17d-d8da-c6c5" name="Command Company Nuncio Vox" hidden="true" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-blood-angels-e210-d02e-2b79-c5d8" type="max" />
      </constraints>
      <profiles>
        <profile id="mh-rad-blood-angels-8ca8-7d16-6198-24bf" name="Command Company Nuncio-vox" page="" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Units arriving via Deep Strike within 6"  of a Command Company Nuncio-vox do not scatter.  When barrage weapons are used by the controlling player, line of sight may be drawn from any model equipped with a Nuncio-vox as well as the firing model itself. Range is still drawn from the firing model.  It may not be used inside a vehicle.
Any unit equipped with a Command Company Nuncio Vox can benefit from the Cognis Signum carried by the Master of Signals (but still only one unit per turn)</characteristic></characteristics></profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10.0" />
      </costs>
    </selectionEntry>
