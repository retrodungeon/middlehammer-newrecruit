    <selectionEntry id="64ebe6fa-bff3-0f35-2087-4595ac1ee4f3-29754" name="The Archangels" hidden="false" collective="false" type="unit">
      <profiles>
        <profile id="ea4b2715-b9c8-82b2-b23d-b2d5dd7cb142-29754" name="Archangel's Strike Force" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Archangel's Strike Force is actually a Detachment and thus cannot be taken in Unbound armies. Due to the way Battlescribe works, I included this between the Formations for now.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="659deebf-23a2-3c22-d3cb-6f1a552df84c-29754" name="Storm of Angels" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>You can re-roll failed Reserve Rolls for units in this Detachment with the Deep Strike special rule. In addition, units in this Detachment arriving from Deep Strike Reserve scatter D6" less (normally D6" rather than 2D6").</description>
        </rule>
        <rule id="19d116fe-43c5-7471-8440-3ba4ccadf34d-29754" name="Lord of the Host" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If this Detachment is chosen as your Primary Detachment, you can re-roll the result when rolling on the Archangels Warlord Traits table.</description>
        </rule>
        <rule id="7f798ccb-1bb6-3250-61b5-9cec7ecff0d2-29754" name="Elite Strike Force" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>You make Reserve rolls for units from this Formation from your first turn.</description>
        </rule>
        <rule id="f0c62309-c5d8-aecd-9241-81beeabf6132-29754" name="Stubborn" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </rule>
      </rules>
