          <selectionEntries>
            <selectionEntry id="c4fb-47ae-22d9-f32c-29754" name="Leviathian Siege Claw w/ inbuilt Meltagun" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="5db1-186b-99ac-67d3-29754" name="Leviathian Siege Claw" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
                  <profiles />
