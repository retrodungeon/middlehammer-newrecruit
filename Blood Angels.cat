  <entryLink id="3a0f-d222-f3ba-16ed" name="Dreadnought" hidden="false" collective="false" import="true" targetId="3f7e-ad94-b024-1a57" type="selectionEntry">
      <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-8ac8-b0a2-9d27-1696" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><rules>
        <rule id="48bb-0a90-3782-da58" name="Black Rage" hidden="false">
          <description>The dreadnought must always move towards the enemy as fast as possible, and must assault an enemy within range in the assault phase.</description>
        </rule>
        <rule id="1ce7-4847-7502-084d" name="Rampage" hidden="false">
          <description>The dreadnought ignores any Crew Shaken and Crew Stunned results.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="58d2-5317-039c-f3cc" name="Death Company Special Rules" hidden="false" targetId="71bf-c6ac-56a8-9599" type="infoGroup" />
      </infoLinks>
