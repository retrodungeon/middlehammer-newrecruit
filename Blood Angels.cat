  <profile id="mh-rad-blood-angels-fde1-0fa8-0a36-2bed" name="Atomantic Deflector" publicationId="ca571888--pubN89821" page="239" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Grants a 5+ Invulnerable save against shooting attacks and explosions which originate from the front arc.  In addition, when suffering a Vehicle Explodes results, add 1" to the radius of the blast.  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-10f9-2548-8824-2e2a" name="Atomantic Overcharge" publicationId="ca571888--pubN89821" page="239" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">At the beginning of the controlling players turn, they may declare that the Contemptor-Cortus is overcharging its Atomantic reactor.  They may then apply one of the following bonuses until the end of the player turn:  - Rage special rule - 1" Move and Charge distances - 2" Run distance - 1 Initiative  At the end of its player turn, rolla  D6.  On a roll of a 1, lose a hull point.  If this is enough to wreck the dreadnought, it suffers an immediate Vehicle Explodes and the blast is increased by D3" instead of the usual 1".  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-239e677c-9ec8-69cf-7923-7a344b33711f" name="Banestrike Bolter Shells" publicationId="ca571888--pubN113187" page="9" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Reduces range of Boltgun and Combi-bolters to 18" and provides the Banestrike rule.  Weapons with Banestrike change their AP value to 3 on "to-wound" rolls of a 6. </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-38d51988-0d1a-0974-c0df-0bb6a5b2a693" name="Boarding Shield" publicationId="ca571888--pubN80998" page="89" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Boarding shields confer a 6+ invulnerable save, increased to 5+ in close combat. Models which have successfully charged any unit in which the majority of the models are equipped with boarding shields do not gain bonus Attacks from charging. However, if the charged unit was already locked in combat from a previous turn, the attackers gain bonus Attacks as normal. Boarding shields are far heavier and more cumbersome than combat shields; models equipped with them cannot claim the extra attack for being armed with an additional close combat weapon, and may not use any weapon with the Two-handed special rule.</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-99a47c75-0410-1c54-8124-3adcbd64aa7e" name="Breacher Charge" publicationId="ca571888--pubN80998" page="86" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Special</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, One Use, Blast, Wrecker</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-59304e4a-18c6-1283-455b-f79c559b207f" name="Cataphractii Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Cataphractii Terminator armour affords a +2 armour save and a 4+ Invulnerable save. No Run moves, Overwatch attacks, or Sweeping Advance. </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-4687f5b1-f0b1-12bd-8cc7-27f9f25befaf" name="Cognis-signum" publicationId="ca571888--pubN80998" page="88" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Model equipped with Cognis-sigum gains Night Vision special rule.  In addition, in lieu of firing a weapon in the Shooting phase, a single designated unit of the controlling player's choice withing 6" of the signum-equipped model (excluding Independent Characters and Super-Heavies) gains a bonus of 1 to their BS for that shooting phase.  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-244f6dcc-d526-1cef-a743-6120614e3898" name="Combat Shield" publicationId="ca571888--pubN80998" page="89" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers 6+ invulnverable save, increasing to a 5+ in close combat.</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-0ae81fbd-a9d1-4327-f3df-1fc26dce2ab1" name="Conversion Beamer (1)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">&lt; 18"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">-</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-bf49e57d-4c20-456e-40fc-2325493da257" name="Conversion Beamer (2)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">18" - 42"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-b2930d75-e708-3443-a9ba-fbba33fdf5a7" name="Conversion Beamer (3)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">42" - 72"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-a544-0b30-4b15-43ff" name="Cortex Designator" publicationId="ca571888--pubN89821" page="232" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When a model with this wargear makes a successful shooting attack against an enemy unit, any automata in the same unit gain Preferred Enemy when targeting that same enemy unit until the end of the controlling player's current turn.  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-6e80-170b-509c-fd64" name="Cyclone Missile Launcher (Frag)" publicationId="ca571888--pubN80998" page="92" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">6</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 2, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-5847-5921-80a7-195d" name="Cyclone Missile Launcher (Krak)" publicationId="ca571888--pubN80998" page="92" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 2</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-889ea663-40f5-0ecc-7ba9-4b68e2955022" name="Grenade Harness" publicationId="ca571888--pubN80998" page="83" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">-</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 2, Blast, One use</characteristic></characteristics></profile>
