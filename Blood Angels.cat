            <rule id="11f01e9c-846d-9aec-578c-bdf0ae3e11f5-29754" name="Relief Force" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>All non-vehicle units in this Formation that do not have the Deep Strike special rule or the Jump unit type must be embarked upon a transport vehicle which may not be a Drop Pod. All units in this Formation must be placed in Reserve. When making Reserve Rolls, make a single roll for the entire Formation. On a successful Reserves Roll, all of the units in this Formation arrive from Reserve.</description>
            </rule>
          </rules>
