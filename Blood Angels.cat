        <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="44046dc6-7733-033f-feb6-6577fe8207a8-maxInForce-29754" type="max" />
      </constraints>
      <selectionEntries />
