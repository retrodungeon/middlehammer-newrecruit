    <selectionEntry id="7eb5-6a7d-e896-2fa8-29754" name="&quot;Archangels Demi-company&quot;" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="75bf-a9ab-1214-71fe-29754" name="Stubborn" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        <description>When taking Morale tests, stubborn units always ignore any negative Leadership modifiers. Independent characters that are stubborn confer the ability onto any unit that they join.</description></rule>
        <rule id="d626-76f2-c741-ae4e-29754" name="Elite Strike Force" page="110" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Make Reserve Rolls for units in this Formation from your first turn.</description>
        </rule>
        <rule id="7738-dc7a-b49f-d48f-29754" name="Storm of Angels" page="110" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>You may re-roll failed Reserve Rolls for units with Deep Strike. Scatter D6" less when Deep Striking (normally D6" rather than 2D6").</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f4b8-311c-e535-e042-29754" hidden="false" targetId="1bb9bcf9-80ce-5279-14a5-5f8facbad6c2-29754" type="rule">
