    <profile id="mh-rad-blood-angels-0d8bdd64-39f0-7759-d8ca-0702ee1f0fd0" name="Iliastus Assault Cannon" publicationId="ca571888--pubN113187" page="97" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4, Rending, Malfunction</characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-b4c9d27d-b3cf-28bd-3367-b1bfddd5c401" name="Illum Flares" publicationId="ca571888--pubN80998" page="90" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">May drop a single flare per turn.  Fired just as bombs - flare is placed after scattering.  Leave in place until the end of the turn.  Any unit targeting an enemy within 12" of the flare gains Night Vision for the shooting phase.  Split fire does not apply.  </characteristic></characteristics></profile>
    <profile id="mh-rad-blood-angels-dae18398-f03c-63ac-5477-470244e1e687" name="Kraken Bolt Shells" publicationId="ca571888--pubN80998" page="85" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
