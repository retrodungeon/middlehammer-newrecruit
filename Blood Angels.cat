            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-blood-angels-d168-a6a3-bb8e-b0f3" type="min" />
          </constraints>
          <profiles>
            <profile id="mh-rad-blood-angels-d0cb-3bd8-df16-3847" name="Volkite Carronade" publicationId="ca571888--pubN80998" page="71" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Primary Weapon 1, Ignores Cover, Heavy Beam, Deflagrate, Haywire</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-blood-angels-39b7-3cb7-5a93-2d06" name="Heavy Beam" publicationId="ca571888--pubN80998" page="71" hidden="false">
              <description>Draw a line from the end of the barrel to the max range of the weapon 1" wide.  The initial target (first model in the path) must be an enemy model.

- All models in the beam area are hit, except Zooming Flyers, swooping monstrous creatures, and flying gargantuan creatures.
- Units struck are hit as many times as models are under the beam.
- If the beam strikes a Super-heavy vehicle, Gargantuan creature, or large intact building/fortification (bastion or bigger) the line of effect will not go any further.  The blocking target suffers 1D3 hits instead of 1.
- If a vehicle transporting models suffers a penetrating hit, the occupants suffer D6 Str4 AP- hits with the Deflagrate special rule.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="mh-rad-blood-angels-5fae-d5e1-6274-0755" name="Deflagrate" hidden="false" targetId="mh-rad-blood-angels-b46a-a3ec-91a5-5001" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
