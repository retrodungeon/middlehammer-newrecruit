    <selectionEntry id="50895676-2c6c-78fd-b19e-33982fb80068-29754" name="Caestus Assault Ram" hidden="false" collective="false" type="unit">
      <profiles>
        <profile id="264fbb00-e0f2-3041-8786-116667ba1bf7-29754" name="Caestus Assault Ram" hidden="false" typeId="3a08-ea03-a598-8615">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">4</characteristic>
            <characteristic name="Front" typeId="3a4e-bc1d-4a12-7176">13</characteristic>
            <characteristic name="Side" typeId="d12e-7bdb-191c-4849">13</characteristic>
            <characteristic name="Rear" typeId="a4cb-791a-6a75-4e4a">11</characteristic>
            <characteristic name="HP" typeId="93e6-d4b1-28a8-944b">3</characteristic>
            <characteristic name="Type" typeId="eb65-838c-8eaa-8b5d">Vehicle (Flyer, Hover, Transport, Tank)</characteristic>
            <characteristic name="Combat Role" typeId="d477-c087-173f-9f1c">N/A</characteristic>
            <characteristic name="Pursuit" typeId="e04d-332e-8b52-0071">N/A</characteristic>
            <characteristic name="Agility" typeId="ae34-f5c0-19af-4883">N/A</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="fb24a060-1288-bd18-0993-7efcc4e685f6-29754" name="Caestus Ram" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When conducting a ram attack, the player rolls 2D6 and picks the highest number when determining if it has penetraded the target's armour and adds +1 to any rolls on the damage chart. Also confers a 5++ against attacks made to the front armour, including damage from a ram.</description>
        </rule>
        <rule id="56c58148-8556-fc68-b8ef-0bcaf34c9691-29754" name="Misericorde" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Can transport 10 models with Power, Artificer or Terminator-armour and ignores the rules for Bulky.</description>
        </rule>
        <rule id="978c8e36-7495-1a55-5d52-029aa5eae013-29754" name="Supersonic" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="5067dfc1-93fd-4461-4a1d-ed0f9120f635-29754" hidden="false" targetId="8024-df0a-ec75-95c0" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
        <infoLink id="50db39e5-9f46-a12d-8063-9250d539ba58-29754" hidden="false" targetId="243a-b08c-3c8c-c363" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <repeats />
          <conditions />
          <conditionGroups>
            <conditionGroup type="or">
