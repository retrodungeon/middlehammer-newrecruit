        <profile name="Chapter Banner" id="1ee5-1d58-f57d-2703" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">All friendly units within 12" of the standard bearer re-rolls failed Morale and Pinning tests. In addition, all models in the same unit as the Chapter Banner have +1 Attack whilst the banner bearer is alive.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  <selectionEntry id="a6ac-e9cd-d203-59d0-29754" name="&quot;10th Company Ambush Force&quot;" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="043d-8d16-0548-9e7e-29754" name="Concealed Positions" page="111" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A unit from this Formation that deploys using Infiltrate, but does not have Stealth, gains Stealth until the first time it Moves, Runs, Charges, Turbo-boosts or Falls Back.</description>
        </rule>
        <rule id="c284-27f4-6245-bdc6-29754" name="The Trap is Sprung" page="111" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>During the first game turn, all units from this Formation have Prescision Shots.</description>
        </rule>
      </rules>
