              <profiles>
                <profile id="b9d1fb45-2b1e-df66-dd8c-84bd84cd1dac-29754" name="Gallian's Staff (replace Force weapon on Librarian)" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
