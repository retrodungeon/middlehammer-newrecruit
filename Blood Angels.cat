    <selectionEntry id="52f18002-c508-8236-2554-33d693c8b439-29754" name="Flesh Tearers Blood Rain Strike Force" hidden="false" collective="false" type="unit">
      <profiles>
        <profile id="e55980d6-7f44-c193-24f7-82f850cba5dc-29754" name="Flesh Tearers Blood Rain Strike Force - Restriction" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All models in this Formation must either be equipped with jump packs or begin the game embarked upon this Formation's Stormraven Gunship.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ebcb1d9c-e179-a85d-a74b-b1d0b037b381-29754" name="Crusader" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </rule>
        <rule id="b1a21bf3-b62f-6e02-f009-e8a2b636b639-29754" name="Crimson Thunderbolt" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>On a turn in which a unit from this Formation disembarks from this Formation's Stormraven Gunship, it can re-roll failed charge rolls and has the Rage special rule.</description>
        </rule>
        <rule id="f29cced0-d01e-6357-b462-a6cf774a05d5-29754" name="Poised to Strike" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All units in this Formation equipped with jump packs must be places in Deep Strike Reserve. When making Reserve Rolls, make a single roll for the entire Formation, which you can choose to re-roll. If succesful, all units in this Formation arrive from Reserve.</description>
        </rule>
        <rule id="856e9338-cb07-71c3-3c3c-f5f2d669d6c8-29754" name="Rain of Blood" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When a unit from this Formation arrives by Deep Strike, it gains the Counter-attack and Fearless special rules until the start of your next turn.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
