          <profiles>
            <profile id="mh-rad-blood-angels-76c2-cecc-6146-b636" name="Conversion Dissonator" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Use of the conversion dissonator is declared at the start of any game turn, and is used for that one game turn only. While in effect, all invulnerable saves, applicable to friend and foe alike, within 12" of the bearer suffer a modifier o f-2 (a save of s or 6 is negated entirely).</characteristic></characteristics></profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-blood-angels-e443542e-5253-9ad6-0179-b44fa84fd569" name="Zeroth Conductor Shield" publicationId="ca571888--pubN84158" page="227" hidden="false" collective="false" import="true" type="upgrade">
