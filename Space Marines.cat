      </characteristics>
    </profile>
    <profile id="5b99bf6a-b60b-4476-948a-f2c764c5b070-1c28e" name="Missile Launcher (Frag)" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
