      <profiles>
        <profile id="6387-ed1a-8656-ed75-02c2e" name="Ullanor Crusade" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A tank with this Ullanor Crusade Legacy of Glory gains the Preferred Enemy (Orks) Special Rule.  Enemy models charging a vehicle with the Ullanor Crusade Legacy of Glory must re-roll successful To Hit rolls in the first round of each combat.</characteristic>
          </characteristics>
        </profile>
      </profiles>
