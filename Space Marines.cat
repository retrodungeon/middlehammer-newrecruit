    </selectionEntry>
    <selectionEntry name="Attack Bike" id="89e8-fb61-d518-15f2" hidden="false" import="true" type="model">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50" />
      </costs>
      <infoLinks>
        <infoLink name="Bolter" id="d586-bfed-4eb6-4491" hidden="false" targetId="fa34-07ff-1a5d-fe9f" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Twin-linked Bolter" />
            <modifier field="8b10-045a-f593-605e" join=", " type="append" value="Twin-linked" />
          </modifiers>
        </infoLink>
        <infoLink name="Turbo-Boosters" id="baee-a0dd-c912-239e" hidden="false" targetId="793e-3ba7-feb3-8ad4" type="rule" />
        <infoLink name="And They Shall Know No Fear" id="b446-0b56-65fe-09a0" hidden="false" targetId="8eaf-de62-f965-125b" type="rule" />
      </infoLinks>
      <profiles>
        <profile name="Attack Bike" id="e30a-b06c-9fc0-cbd2" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Bike</characteristic>
