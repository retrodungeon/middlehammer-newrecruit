ill" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="122"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">9</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Specialist Weapon, Armourbane</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">122</characteristic></characteristics></profile><profile id="6d064663-3a04-b317-8a74-89043943de59-6e9c41a" name="Siege Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="126"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Automatically passes Dangerous Terrain tests.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="d7eeda14-0931-5ae4-5bfe-f74d10baf1d9-6e9c41a" name="Signum" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="125"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">At the start of the Shooting phase, a model witl1 a signum can choose to use it instead of shooting. If he does so, one model in his squad is Ballistic Skill 5 for the remainder of the Shooting phase. Declare that the signum is being used before any rolls To Hit are made.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="59d41f07-908f-f559-214c-74886d785953-6e9c41a" name="Silas Alberec, Keeper of Vigils" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="26"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479