          <rules>
            <rule id="15a4-ae9b-85fb-2a38-02c2e" name="Ghost Razor" publicationId="7ab0-ceb9-pubN179327" hidden="false">
              <description>Successful Invulnerable saves made against wounds caused by this weapon must be re-rolled (results of the second roll count as normal).</description>
