<profile id="9a77e0c2-1d22-fc80-675b-1e8cfe1fc5c7-ce98a" name="Chapter Banner" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units within 12" of the bearer of the Chapter Banner, drawn from the same Chapter, re-roll failed Morale checks, Pinning tests and Fear tests. In addition, all friendly models with the Space Marines Faction in the same unit as this banner have +1 Attack whilst the bearer is alive.</characteristic>
      </characteristics>
      <modifiers />
    </profile>
<profile id="d7042818-ab1b-c399-aa5b-a8284cdc68a7-ce98a" name="Chapter Banner (Lamenters)" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly units within 12" of the banner bearer re-roll failed Morale and Pinning Tests.  In addition, all models in the same unit as the Chapter Banner have +1 Attack whilst the banner bearer is alive.</characteristic>
      </characteristics>
      <modifiers />
    </profile>
