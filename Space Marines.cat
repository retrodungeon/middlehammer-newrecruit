        <infoLink name="Twin-Linked" id="e50a-cc4c-7073-03b7" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
        <infoLink name="Heavy Bolter" id="89cb-48fe-6b6d-267b" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Twin-Linked Heavy Bolter" />
          </modifiers>
        </infoLink>
        <infoLink name="Storm Bolter" id="322b-b542-0234-8ff0" hidden="false" targetId="4c6c-9de1-00a8-8016" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Pintle-mounted Storm Bolter" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Deus Ex Machina (IA)" id="d754-2d12-4043-24d3" hidden="false">
          <description>If the crew are stunned then the Machine Spirit will take over temporarily. The Land Raider may be moved directly forward up to its maximum move.</description>
        </rule>
        <rule name="Fire Control (IA)" id="7811-14ac-bf38-6369" hidden="false">
          <description>The Land Raider may always fire one additional weapon system to those it would normally be able to fire. This shot may be against a different target to that engaged by the crew. Automatic targeting is less accurate and therefore conducted with BS2. If the crew are stunned or shaken, the Machine Spirit may still fire a weapon using this rule.</description>
        </rule>
        <rule name="Improved Communications" id="2fb3-a5ad-684f-cc39" hidden="false">
          <description>The Space Marine player may re-roll a reinforcement dice once per turn.</description>
        </rule>
      </rules>
    </selectionEntry>
