      <profiles>
        <profile id="f59c-ec78-b8be-6643-02c2e" name="War of Murder" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Monster Hunter special rule. In addition, friendly Space Marine units within 6" of the vehicle gain the Fearless special rule.</characteristic>
