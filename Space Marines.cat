    <selectionEntry id="58f5-a1a8-c951-f3f7-02c2e" name="Chapter Relic: The Burning Blade" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5f2e-8ad3-7895-4dc4-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="1de8-eb25-a38c-a239-02c2e" name="Chapter Relic: The Burning Blade" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+3</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Blind, Incandescant</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5f57-4b09-5007-0897-02c2e" name="Incandescent" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>At the end of an Assault phase in which the bearer made one or more To Hit rolls with the Burning Blade, roll a D6.  On a roll of 2+, nothing happens.  On a roll of a 1, the bearer takes a Strength 4 AP2 hit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="cd2b-6332-b8f2-4e4d-02c2e" name="" hidden="false" targetId="8fad-693f-88b4-bac6" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="55.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="3099-4a51-d032-e9d2-02c2e" name="Chapter Relic: The Armour Indomitus" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4bc0-f7ee-0e6d-f91a-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="b661-d192-e4ec-02a6-02c2e" name="Chapter Relic: The Armour Indomitus" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Armour Indomitus confers a 2+ Armour Save and a 6+ invulnerable save. Once per game, at the beginning of any phase, the wearer can choose to temporarily push the armour's force field to its limit. For the duration of that phase, the Armour Indomitus confers a 2+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="60.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="de7e-a420-de5d-4ead-02c2e" name="Captain Sicarius" hidden="false" collective="false" import="true" type="model">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="bed2-6bd4-f664-9cdf-02c2e" type="lessThan" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ea55-efbe-7125-0582-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="f525-fb3f-6e9c-2070-02c2e" name="Captain Sicarius" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">6</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">5</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+/4++</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="597f-6cf2-c5ad-c72c-02c2e" name="Battle-forged Heroes" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>During deployment, choose one friendly Ultramarines Tactical Squad.  It gains one of the following special rules for the duration of the battle: Counter-attack, Infiltrate, Scout, or Tank Hunters.</description>
        </rule>
        <rule id="35e6-f845-1260-f27a-02c2e" name="Surprise Attack" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>If Captain Sicarius is alive and on the battlefield, you gain +1 to your Reserve Rolls</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="55a1-e6fa-0b85-7b99-02c2e" name="" hidden="false" targetId="894f-81b4-7aca-8eda-02c2e" type="rule">
