    <profile name="Honour of the Chapter" id="3cef-794d-3709-4116" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The Chaplain and all members of the squad he's joined are fearless</characteristic>
      </characteristics>
    </profile>
    <profile name="Liturgies of Battle" id="5399-2d62-77fe-8103" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">On a player turn in which he assaults, a Chaplain and all members of his squad can re-roll failed rolls to hit.</characteristic>
      </characteristics>
    </profile>
