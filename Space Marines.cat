        <profile id="c446-7d3e-8cfc-29a9-02c2e" name="Chapter Relic (RG): Ex Tenebris" publicationId="7ab0-ceb9-pubN65665" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
