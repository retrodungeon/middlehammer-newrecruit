        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Model gains Adamantium Will and knows Psychic Maelstrom from the Telekinesis discipline in addition to any others it knows. This is not considered when determining Psychic Focus.</characteristic>
      </characteristics>
    </profile>
    <profile id="88e755fb-6566-3a3d-3615-de83b34bfb58-800b0" name="Marauder Bomber" page="47" hidden="false" typeId="3a08-ea03-a598-8615">
