        <profile id="5531-5e11-8aad-f473-02c2e" name="Vindicator" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
          <characteristics>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
