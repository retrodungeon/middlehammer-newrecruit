      <selectionEntries>
        <selectionEntry name="2x Twin-linked Lascannons (Sponsons)" id="cc04-5fd7-9795-015e" hidden="false" import="true" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="ecd9-b470-4814-24b9" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1" />
