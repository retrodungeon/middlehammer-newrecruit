          <characteristics>
            <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">4</characteristic>
            <characteristic name="Front" typeId="3a4e-bc1d-4a12-7176">13</characteristic>
            <characteristic name="Side" typeId="d12e-7bdb-191c-4849">13</characteristic>
            <characteristic name="Rear" typeId="a4cb-791a-6a75-4e4a">11</characteristic>
