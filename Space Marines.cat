    <selectionEntry name="Thunderhawk Gunship (IA)" id="81c2-8110-65c2-82cd" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Super-Heavy" id="295b-dced-556b-1305" hidden="false" primary="true" targetId="5968-f35e-18fd-612b" />
