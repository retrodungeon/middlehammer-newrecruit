      </categoryLinks>
    <constraints><constraint id="mh-ia9-blaylock-unique" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="true" /></constraints><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="195" /></costs><infoLinks><infoLink name="Terminator Armour" id="mh-ia9-blaylock-link-0" hidden="false" targetId="a5fa-5ad7-54d4-fd1a" type="profile" /><infoLink name="Iron Halo" id="mh-ia9-blaylock-link-1" hidden="false" targetId="e427-87a4-ee08-b117" type="profile" /><infoLink name="Storm Bolter" id="mh-ia9-blaylock-link-2" hidden="false" targetId="a37b-6942-f8fb-4aee" type="profile" /><infoLink name="Chain Fist" id="mh-ia9-blaylock-link-3" hidden="false" targetId="5151-d1aa-1f80-cb94" type="profile" /><infoLink name="Master-crafted" id="mh-ia9-blaylock-link-4" hidden="false" targetId="03d9-2a91-7dcd-8f57" type="rule" /><infoLink name="And They Shall Know No Fear" id="mh-ia9-blaylock-link-5" hidden="false" targetId="73f8-658e-9da5-beba" type="rule" /><infoLink name="Independent Character" id="mh-ia9-blaylock-link-6" hidden="false" targetId="db9c-91d8-5b8a-ee16" type="profile" /><infoLink name="Combat Tactics" id="mh-ia9-blaylock-link-7" hidden="false" targetId="63e6-2a1c-88a5-4120" type="rule" /></infoLinks><profiles><profile name="Mordaci Blaylock" id="mh-ia9-blaylock-profile" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit"><characteristics><characteristic name="WS" typeId="15b1-a34a-6e7c-332e">6</characteristic><characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic><characteristic name="S" typeId="09af-e927-0c3c-9d88">4</characteristic><characteristic name="T" typeId="ff29-f8b2-5b20-b686">4</characteristic><characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic><characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic><characteristic name="A" typeId="a535-0722-3bc1-4d3c">3</characteristic><characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic><characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+</characteristic></characteristics></profile><profile name="Foe Ripper" id="mh-ia9-blaylock-weapon-0" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons"><characteristics><characteristic name="Ability" typeId="2113-98a2-4376-a94c">A master-crafted chainfist.</characteristic></characteristics></profile><profile name="Hard as Stone" id="mh-ia9-blaylock-ability-0" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities"><characteristics><characteristic name="Description" typeId="e24a-6018-20cf-d76c">Blaylock, and any Terminator squad he has joined, may choose to pass or fail any Morale test it is required to take, and cannot be pinned.</characteristic></characteristics></profile><profile name="Terminator Attack" id="mh-ia9-blaylock-ability-1" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities"><characteristics><characteristic name="Description" typeId="e24a-6018-20cf-d76c">If Blaylock is in your army, your Terminator Squads and Terminator Assault Squads are scoring units.</characteristic></characteristics></profile><profile name="Company Captain" id="mh-ia9-blaylock-ability-2" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities"><characteristics><characteristic name="Description" typeId="e24a-6018-20cf-d76c">Blaylock is an HQ choice for a Codex: Space Marines army. As a Company Captain he allows you to take a Space Marine Command Squad, which is an HQ choice that does not count against the army's HQ allowance.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry name="Command Squad" id="mh-ia9-blaylock-cs-0" hidden="false" import="true" type="unit">
          <constraints>
            <constraint id="mh-ia9-blaylock-cs-1" field="selections" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="115" />
          </costs>
          <selectionEntries>
            <selectionEntry name="Company Standard" id="mh-ia9-blaylock-cs-2" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="mh-ia9-blaylock-cs-3" field="selections" scope="parent" shared="true" type="max" value="1" />
