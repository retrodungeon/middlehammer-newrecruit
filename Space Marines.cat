7db3-6c4a-693b451a8387-6e59d31" name="AA Mount" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="245"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Grants the weapon Skyfire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="47d68efd-6255-087c-ad89-4beb85182eb8-6e59d31" name="Accelerator Autocannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="79"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">48</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 6, Rending, Rapid Tracking</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="827e75fa-dd23-114a-0a93-98f1e3e85d94-6e59d31" name="Actinic Halo" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="13"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3+ Invul Sv. Should this be failed &amp; Narvaez survives, then on a roll of 4+ on 1D6 it continues to work, otherwise it cannot be used for the rest of the battle.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="85e758f5-33df-fa1f-1dbe-a37d687a4b7c-6e59d31" name="Aegis Defence Line" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323" /><characteristic name="Pg" typeId="mh6-5067232323