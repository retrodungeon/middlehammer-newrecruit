    <profile id="827e75fa-dd23-114a-0a93-98f1e3e85d94-800b0" name="Actinic Halo" page="13" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">3+ Invul Sv. Should this be failed &amp; Narvaez survives, then on a roll of 4+ on 1D6 it continues to work, otherwise it cannot be used for the rest of the battle.</characteristic>
      </characteristics>
    </profile>
    <profile id="85e758f5-33df-fa1f-1dbe-a37d687a4b7c-800b0" name="Aegis Defence Line" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
