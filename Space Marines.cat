        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Shred, Specialist Weapon, Ghost Razors</characteristic>
      </characteristics>
    </profile>
    <profile id="35c1-b933-a4b9-e7e1-800b0" name="The Glaive of Vengeance" page="154" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
