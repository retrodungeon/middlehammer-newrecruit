      </infoLinks>
      <selectionEntries>
        <selectionEntry id="bcc8-a638-2dad-d1d8-02c2e" name="The Blade of the Scorpion" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ae87-9d00-51f5-d27f-02c2e" type="min" />
