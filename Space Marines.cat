      <rules>
        <rule name="Tyranid Hunter" id="04a0-656b-a23a-c779" hidden="false">
          <description>Chaplain Cassius and any Ultramarines squad led by him benefit from the Preferred Enemy (Tyranids) special rule.</description>
        </rule>
        <rule name="Great Knowledge" id="e504-db94-4451-0692" hidden="false">
          <description>Any Ultramarine squad within 6" of Cassius may re-roll their Morale checks, accepting the second result as final. Note that this ability can be used even if a Morale check is passed on the first roll, so you can use it to try to make sure Ultramarines fall back in disadvantageous or dangerous situations.</description>
        </rule>
      </rules>
