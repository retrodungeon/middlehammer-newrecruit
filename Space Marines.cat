    <selectionEntry id="8b71-4c20-4dba-0ec6-02c2e" name="Formation: Stormbringer Squadron" publicationId="7ab0-ceb9-pubN158942" page="60" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="22fb-3127-2922-c405-02c2e" name="Locate and Secure" publicationId="7ab0-ceb9-pubN109967" hidden="false">
          <description>Scout Squads from this Formation (bot not their Land Speeder Storms) have the Objective Secured special rule.</description>
        </rule>
        <rule id="8d52-3d37-b713-be88-02c2e" name="Outrider Support" publicationId="7ab0-ceb9-pubN109967" hidden="false">
          <description>Land Speeder Storms from this Formation receive a +1 bonus to any Jink saves if they are within 6" of a Land Speeder from this formation.</description>
        </rule>
        <rule id="d7ed-daf3-795a-76c5-02c2e" name="Rapid Deployment" publicationId="7ab0-ceb9-pubN109967" hidden="false">
          <description>Scout Squads from this Formation can disembark from their Land Speeder Storm after it has moved, so long as it has not moved more than 12".</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="bcb7-dadf-bcb7-4ce0-02c2e" name="" hidden="false" targetId="4764-48d9-da41-afaa" type="rule" />
      </infoLinks>
      <entryLinks>
        <entryLink id="f992-0ac3-c94c-4d92-02c2e" name="" hidden="false" collective="false" import="true" targetId="6f08-194e-a422-37e6-02c2e" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="65bf-3f66-ffac-b1ab-02c2e" type="min" />
