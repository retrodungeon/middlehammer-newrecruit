      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="9779-bfaf-19d1-019c-02c2e" name="Legacy: Isstvan V Dropsite Massacre" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7c4f-36d6-e0ee-21e1-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="4981-1533-83d0-c1b5-02c2e" name="Isstvan V Dropsite Massacre" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle never scatters when entering play via the Deep Strike special rule. Note this upgrade does not give the vehicle the Deep Strike rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="60f1-3593-b973-088b-02c2e" name="Legacy: Icon of Glory" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="27e4-8d73-9b41-54f9-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="5237-50d5-ad7d-8f66-02c2e" name="Icon of Glory" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has either +1 BS or +1 WS (declared before the game begins. Should the army's warlord be within 2" of the vehicle, the range of any Command Trait he has rolled on the warlord traits table is increased by +6"  In missions that use Objectives and Victory points to determine the winner, the destruction of the vehicle counts as an additional Secondary Objective, earning the opposing player an extra +1 Victory point.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="5ad1-410e-a77b-40d3-02c2e" name="Legacy: Burning of Prospero" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5699-45ae-e410-35d6-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="b1a1-274d-a204-153f-02c2e" name="Burning of Prospero" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Adamantium Will special rule. The bonus granted by this special rule is increased to +2 against Witchfire type psychic powers.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="d9a1-d09f-0a23-5f89-02c2e" name="" hidden="false" targetId="8714-46ad-62c0-ce35" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="7568-1c6f-3047-0244-02c2e" name="Legacy: Battle of Terra" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8205-55d6-3862-fc80-02c2e" type="max" />
