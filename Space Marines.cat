            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Walker)</characteristic>
          </characteristics>
        </profile>
        <profile id="571e-3145-ac81-c55c-02c2e" name="Augmented Atomantic Shielding" publicationId="7ab0-ceb9-pubN211261" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Hecaton Aiakos has a 4+ invulnerable save against shooting attacks and explosions, and a 5+ invulnerable save against attacks suffered in close comabt. In addition, if Aiakos suffers a vehicle explodes damage result, add +2" to the radius of the blast.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="2710-af2c-a073-34d4-02c2e" name="" hidden="false" targetId="043d-4926-4c9d-09c4-02c2e" type="rule" />
