                          <profiles>
                            <profile id="a7d1-a536-a3b4-4b81-02c2e" name="Volkite Charger" publicationId="7ab0-ceb9-pubN227548" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                              <characteristics>
