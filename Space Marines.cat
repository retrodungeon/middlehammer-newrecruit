          <profiles>
            <profile id="3c91-4a8f-860b-f580-02c2e" name="Siege Shield" publicationId="7ab0-ceb9-pubN174565" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with a Siege Shield automatically passes Dangerous Terrain tests.  Treat the front armour of this vehicle as 1 better when ramming.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10.0" />
