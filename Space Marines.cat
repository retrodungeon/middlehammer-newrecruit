    <selectionEntry id="66d4-6e65-9f4f-df65-02c2e" name="Formation: Armoured Task Force" publicationId="7ab0-ceb9-pubN113504" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="bc77-261f-c407-c23b-02c2e" name="Paregoric Cant" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>Vehicles from this Formation ignore the effects of Crew Shaken and Crew Stunned results while they are within 6" of the Techmarine or a Techmarine Gunner from this Formation</description>
        </rule>
        <rule id="20ea-84ab-0f34-7f3b-02c2e" name="The Will of the Omnissiah" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>The Techmarine and Techmarine Gunners from this Formation have a +1 bonus when making Blessings of the Omnissiah rolls to repair vehicles from this Formation.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="81f5-397c-1ed4-6e2a-02c2e" name="Armoured Forces" hidden="false" collective="false" import="true" defaultSelectionEntryId="4a27-fc38-19f2-b61e-02c2e">
