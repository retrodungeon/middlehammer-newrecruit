      <profiles>
        <profile id="81da-f2b4-ebfd-a32f-02c2e" name="Lucius Pattern Dreadnought Drop Pod" publicationId="7ab0-ceb9-pubN197499" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
          <characteristics>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">12</characteristic>
