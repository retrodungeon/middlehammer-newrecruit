            <profile id="d9ea-ea9f-23d4-d2cf-02c2e" name="Slake" publicationId="7ab0-ceb9-pubN146351" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
