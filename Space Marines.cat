f-9626-64c2-49e33b469807-6e60653" name="Power Lance" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1 (Charge) / User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3 (Charge) / 4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="4effd3b4-8ed0-0fab-bd9d-d3ada6ca41e4-6e60653" name="Power Maul" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="71581f2d-4a4a-89b9-ea95-7cedc042efbc-6e60653" name="Power Sword" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="a4c41c01-898f-9a39-e37c-27aaef365477-6e60653" name="Psychic Hood" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="68"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Each Time a unit (or model) is targeted by an enemy psychic power and is within 6" of a frieldly model with a psychic hood, the wearer may attempt to deny the witch as if he were in the unit.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">68</characteristic></characteristics></profile><profile id="8bb88d16-097e-98c6-e838-cf2c1d8ec420-6e60653" name="Rosarius" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile><profile id="4f1be1f2-4391-f99e-ec78-9dcb95bc4e68-6e60653" name="Rosarius" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="a13b539f-6337-76c2-6061-878ef4fde1cd-6e60653" name="Scorpius Multi-launcher" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">48</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Barrage, 3" Blast, Rocket Barrage</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="f0e6246d-137e-7921-4209-99318a073b42-6e60653" name="Searchlight" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After firing all weapons can illuninate the unit it shot at and it's self during night fighting</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile><profile id="2961cfae-3c26-dca6-a1c8-89fa947140aa-6e60653" name="Shotgun" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7cecbcd2-b268-c364-876d-bae5c9f0a2e0-6e60653" name="Siege Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Auto Pass Dangerous terrain</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="78739177-210f-dafa-9225-76de4f2837e5-6e60653" name="Signum" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Forego shoting to grant one other model in his unit BS 5, declare before any rolls are made.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="b2b9d48b-7476-c812-d0c9-621c3c072d46-6e60653" name="Smoke Launchers" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Once per game, instead of shooting or moving flat out, may gain a 5+ cover save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile><profile id="0b0885c5-ec0b-4ff8-e8b7-b2b22f0dda06-6e60653" name="Sniper Rifle" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">X</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Sniper</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="af24ad92-60f1-d46b-f438-e0a541cf2b3f-6e60653" name="Space Marine" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic na