<profile id="6370155d-69ef-fd4a-a94b-4957e3c9dde1-ce98a" name="Assault Drill" hidden="false" page="0" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2 (Max 10)</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">+D6 to pen. bunkers, fortifications, bastions, other buildings &amp; any vehicle classed as stationary that turn.</characteristic>
      </characteristics>
      <modifiers />
    </profile>
<profile id="7ea5e1f0-19de-ebb7-69f7-7a7faed89eb4-ce98a" name="Assault Drill In-built Heavy Flamer" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In addition to normal use, if the DCCW inflicts a pen. hit against a building/vehicle that is occupied, but the target is not destroyed outright, then all models inside suffer a single Heavy Flamer hit automatically after the Dreadnought's other attacks have been resolved (Str 5, Ap 4, distributed as per wounds from a shooting attack). This flamer hit only occurs once per Combat phase, not once per hit.</characteristic>
      </characteristics>
      <modifiers />
    </profile>
<profile id="ea1b2ee9-dd66-d035-b8fa-aef8719f33c1-ce98a" name="Atomantic Shielding" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invul Sv against shooting/explosions; 6+ Invul Sv against close combat. If the Contemptor suffers a 'Vehicle Explodes' damage result, add +1" to blast radius.</characteristic>
      </characteristics>
      <modifiers />
    </profile>
<profile id="bedb8717-58c9-3bb2-3065-55413d93eb7e-ce98a" name="Augur Shells" hidden="false" page="245" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Gets Hot, Cratering</characteristic>
      </characteristics>
      <modifiers />
    </profile>
<profile id="54eb0acc-bcd4-8340-5a46-db83a28727b2-ce98a" name="Auspex" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with an auspex can use it in place of making a shooting attack. If he does so, target an enemy unit within 12" (this does not count as choosing a target for his unit to shoot at). A unit that is targeted by one or more auspexes has its cover saves reduced by 1 until the end of the phase.</characteristic>
      </characteristics>
      <modifiers />
    </profile>
