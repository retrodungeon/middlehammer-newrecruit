        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Master-crafted, Rending, Shred</characteristic>
      </characteristics>
    </profile>
    <profile id="7031-aeaf-6296-a4ba-800b0" name="The Salamander's Mantle" page="95" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bearer has Eternal Warrior</characteristic>
      </characteristics>
    </profile>
    <profile id="c2e87e76-1195-9911-45de-56a06ba36c35-800b0" name="The Shield Eternal" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Storm Shield, grants Adamantium Will and Eternal Warrior. 3+ Invul Sv. Cannot claim +1 A for having two close combat weapons in Assault.</characteristic>
      </characteristics>
    </profile>
    <profile id="736b0fc9-05b7-add2-d10b-10028e61df60-800b0" name="The Spartean" page="83" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistol, Ignores Cover, Master-crafted</characteristic>
      </characteristics>
    </profile>
    <profile id="c723b43d-0b53-d900-6218-057ec475d4af-800b0" name="The Sword Excellus" page="25" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Rending, Soul Blaze, Specialist Weapon, Smash*</characteristic>
      </characteristics>
    </profile>
    <profile id="a78fe1e3-3d94-8122-698a-375bb152c2e9-800b0" name="The Tempered Helm" page="89" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When taking Morale tests, all friendly units within 24" of the bearer can use his Ld instead of their own. Furthermore, nominate a single friendly unit within 12" of  the bearer at the start of  each of  his Shooting phases. That unit can reroll all To Hit rolls of a 1 in that Shooting phase.  Both of these rules can be used even if the bearer is embarked in a vehicle or building.</characteristic>
      </characteristics>
    </profile>
    <profile id="7af4-8bdd-d0c4-2b98-800b0" name="The Tome of Vel'cona" page="95" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bearer knows the Pyromancy discipline power Molten Beam in addition to any others he knows. This is not considered when determining Psychic Focus. In addition, the bearer can add +1 Strength to all Pyromancy witchfire powers he uses.</characteristic>
      </characteristics>
    </profile>
    <profile id="a237-d337-788c-e0b7-800b0" name="Thermogenic Grenade Launcher" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">18</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1, Armourbane, 3" Blast, One Use Only</characteristic>
      </characteristics>
    </profile>
    <profile id="58c6cd77-4987-028f-761a-9fac0ad1c535-800b0" name="Thulsa Kane, Old Night" page="22" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
