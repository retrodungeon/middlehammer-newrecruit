      <rules>
        <rule id="3a90-e176-29ba-4f59-02c2e" name="Agile" publicationId="7ab0-ceb9-pubN209104" hidden="false">
          <description>In the shooting phase, a Warhound can choose to either:

-fire all available weapons
-fire a single weapon and then Run
-fire no weapons at all and Run twice</description>
        </rule>
      </rules>
