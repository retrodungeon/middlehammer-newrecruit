<profile id="bcf1203d-a31e-fd6c-e071-0d03ee30155f-ce98a" name="Weaken Resolve (Psychic)" hidden="false" page="47" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36"</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">-</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">This power is used during the Psyker Battle Squad's Shooting phase. Choose one enemy unit within 36" and line of sight of the Psyker Battle Squad. For the remained of the turn, the enemy unit's Leadership is reduced by the number of Sanctioned Psykers in the unit utilizing the power (to a minimum of 2).</characteristic>
      </characteristics>
      <modifiers />
    </profile>
