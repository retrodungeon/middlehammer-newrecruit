          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="2429-a5ec-5e79-8258-02c2e" name="Battle Auspex" publicationId="7ab0-ceb9-pubN169253" hidden="false">
          <description>The Prometheus has the Night Vision special rule. In addition, the cover saves of enemy targets that it fires on are reduced by -1</description>
        </rule>
        <rule id="63a1-c74b-56d5-87bf-02c2e" name="Improved Comms" publicationId="7ab0-ceb9-pubN169253" hidden="false">
          <description>The presence of one or more vehicles on the battlefield adds +1 to the result of the controlling player's Reserve rolls (note that this effect is not cumulative with other bonuses).</description>
        </rule>
      </rules>
