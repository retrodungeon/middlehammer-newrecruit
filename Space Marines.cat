    <selectionEntry id="e8a1-d0a8-a2fc-be98-02c2e" name="Formation: Triumvirate of the Primarch" publicationId="7ab0-ceb9-pubN67599" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="bed2-6bd4-f664-9cdf-02c2e" type="lessThan" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="e6a7-9932-e8f0-67fa-02c2e" name="Touched by Fate" publicationId="7ab0-ceb9-pubN67599" hidden="false">
          <description>You can re-roll one failed saving throw each turn for each model from this Formation.</description>
        </rule>
        <rule id="af2c-58eb-abcd-a6c2-02c2e" name="Inspiring Presence" publicationId="7ab0-ceb9-pubN67599" hidden="false">
          <description>Whilst Grand Mater Voldus and Roboute Guilliman are on the battlefield, all friendly units with the Armies of the Imperium Faction have the Stubborn special rule.</description>
        </rule>
      </rules>
      <entryLinks>
