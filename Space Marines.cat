79706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">92</characteristic></characteristics></profile><profile id="5a476120-509e-311a-a530-4915d13cce6e-6e9c41a" name="Teeth of Terra" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="127"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Rampage, Specialist Weapon, Strikedown</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">127</characteristic></characteristics></profile><profile id="72e202d2-1299-f96f-6688-145b6679593c-6e9c41a" name="Teleport Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="186"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Units arriving by teleport (using deep strike), which are part of the force containing the Damocles, do not scatter if they choose to arrive within 12" of Damocles.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="46cd6439-2dc3-2f42-0174-cb6b696f29e3-6e9c41a" name="Teleport Homer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="125"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly units composed entirely of models in Terminator armour do not scatter when they Deep Strike, so long as the first model is placed within 6" of the teleport homer's bearer. For this to work, the bearer of the teleport homer must have been on the battlefield at the start of the turn.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="460e99c5-9196-1f8d-2930-bc9d00f0adfe-6e9c41a" name="Terminator" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="90"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/5++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">90</characteristic></characteristics></profile><profile id="77cd0765-7ddf-d654-cc86-3de641888ae3-6e9c41a" name="Terminator Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="126"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv, 5+ Invul Sv, Relentless, Bulky, Deep Strike, may not make Sweeping Advances.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="79ca2b2b-c01e-00f5-7831-0693bd600b56-6e9c41a" name="Terminator Captain" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="79"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">79</characteristic></characteristics></profile><profile id="043a2dd2-ddd8-a8c7-cefb-ba1d58144afc-6e9c41a" name="Terminator Sergeant" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="90"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/5++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">90</characteristic></characteristics></profile><profile id="4d4cdb30-cd78-725f-0e9c-f354d2d6535f-6e9c41a" name="The Aenigmata Ferrum" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="22"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Any Space Marine on Kane's side within 12" of him can re-roll 1s when rolling to Wound in an Assault.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="0b307225-9492-9af9-bf9a-55276154ff2a-6e9c41a" name="The Angel of Sacrifice" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive, Only in Death</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="10552e74-4868-c717-bb89-27480edd9858-6e9c41a" name="The Armour Indomitus" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="127"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv, 6+ Invul Sv, Relentless. Once per game, at the beginning of any phase, the wearer can choose to temporarily push the armour's force field to its limit. For the duration of that phase, it confers a 2+ Invul Sv.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="67ce089d-561c-3f53-e8fb-00958d48c6bf-6e9c41a" name="The Armour Of Faith" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="118"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv, 4+ Invul Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="83af42ec-c7eb-453f-e36a-e8dd1fe52dba-6e9c41a" name="The Banner of Staganda" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">The Banner of Staganda can only be taken by a model that may take a Company Standard. The bearer has the Counter-Attack and Crusader special rules. In addition,  friendly units within 12" of the bearer, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="42dbd4c3-7516-9e61-6b18-e6eba32ffe56-6e9c41a" name="The Black Spear" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="31"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Specialist Weapon</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">31</characteristic></characteristics></profile><profile id="6c691d07-5f91-0cff-2bd3-24515955c0a0-6e9c41a" name="The Black Spear Lasbeam" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="31"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, One Use</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">31</characteristic></characteristics></profile><profile id="cfeff144-85cf-2e28-f0f3-e26d5f877ef4-6e9c41a" name="The Black Sword" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="118"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="58d84434-ef3d-9519-b836-34dd3945fa35-6e9c41a" name="The Black Sword (One-handed Stance)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="118"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted, Slay the Heretic</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="55e09aaa-39cd-d1dd-a97b-863a5e361921-6e9c41a" name="The Black Sword (Two-handed Stance)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="118"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted, Two-Handed, Unwieldy, Smite the Unclean</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="a6b18952-26e6-75e3-85c6-fc20f8318b9e-6e9c41a" name="The Blade of the Scorpion" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="9"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted, Smash*</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">9</characteristic></characteristics></profile><profile id="11a58870-2f99-78ce-8734-42f3669a9bff-6e9c41a" name="The Bones of Osrak" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">The Bones of Osrak can only be taken by a Librarian. The bearer generates an additional Warp Charge point, and can re-roll failed Psychic tests.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="f7754842-f151-6f5f-eabe-8f38525ab31c-6e9c41a" name="The Burning Blade" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="127"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Blind, Incandescent</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">127</characteristic></characteristics></profile><profile id="82b22d55-4092-0a4f-0157-90e5d9d493f7-6e9c41a" name="The Emperor's Champion" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="118"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="2ebc889b-4532-5db5-bd27-356563c16a18-6e9c41a" name="The Eye of Hypnoth" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">A model with the Eye of Hypnoth can use it in place of making a shooting attack. If he does, target an enemy unit or building within 18" (this does not count as choosing a target for his unit to shoot at). A unit targeted by the Eye of Hypnoth has its cover save reduced by 1 until the end of the phase (this is not cumulative with the similar bonus granted by an Auspex – see Codex: Space Marines). A building targeted by the Eye of Hypnoth instead has all of its Armour Values reduced by 1 (to a minimum of 1) until the end of the phase.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="0e78f2e1-8f37-d2ff-2371-6f1dac3173c0-6e9c41a" name="The Ghost Razors" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="27"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Shred, Specialist Weapon, Ghost Razors</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">27</characteristic></characteristics></profile><profile id="7805feca-5410-cf52-194c-e655e232ef68-6e9c41a" name="The Hellslayer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="26"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Unwieldy, Two-handed, Master-crafted, Concussive, Slayer (Daemon &amp; Psyker)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">26</characteristic></characteristics></profile><profile id="843ea57c-abf5-84a4-2938-4270692d8697-6e9c41a" name="The Lifetaker" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="22"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Unwieldy, Two-handed</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">22</characteristic></characteristics></profile><profile id="daf6edf3-d92b-3fb4-5a39-6cc500119f08-6e9c41a" name="The Primarch’s Wrath" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="127"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" type