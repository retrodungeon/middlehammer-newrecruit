        <selectionEntry name="Exchange Smite for Quickening" id="b5eb-cf90-023a-202b" hidden="false" import="true" sortIndex="2" type="upgrade">
          <comment>Howling Griffons</comment>
          <constraints>
            <constraint id="cd2a-f1d9-48b4-f4ba" field="selections" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5cf2-3b70-9fd5-518e" field="selections" scope="parent" shared="true" type="notInstanceOf" value="1" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Quickening" id="bf97-e5fb-be28-d457" hidden="false">
              <description>This psychic power may be attempted at the start of any assault phase. If successful one model in the psyker's unit (including themselves) gains +D3 Attacks in that assault phase.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
