        <profile id="c872-0300-20fb-9315-02c2e" name="Thramas Crusade" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly Space Marine models within 12" of the vehicle gain the Fearless special rule while within this distance.</characteristic>
