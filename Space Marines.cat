        <selectionEntry name="Command Squad" id="6a16-e965-588c-841b" hidden="false" import="true" type="unit">
          <constraints>
            <constraint id="5a7f-ad22-67ab-50eb" field="selections" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="115" />
          </costs>
          <selectionEntries>
            <selectionEntry name="Company Standard" id="0d4f-0487-896b-d14f" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1619-77da-0e39-5944" field="selections" scope="parent" shared="true" type="max" value="1" />
              </constraints>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
              </costs>
              <profiles>
                <profile name="Company Standard" id="ae9b-508f-6223-f070" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Any Space Marine unit within 12" of the Standard Bearer always re-rolls failed Morale and Pinning Tests. In addition, while the standard bearer is still alive, the Command squad counts as scoring one extra wound in close combat for the purposes of calculating assault results.</characteristic>
                  </characteristics>
                </profile>
