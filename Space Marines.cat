          </constraints>
          <profiles>
            <profile name="Signum" id="be7b-5e78-e2ca-d590" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Once per turn, you may reroll one missed shooting roll for the Techmarine or any squad that the Techmarine belongs to or has joined.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Servo-Harness" id="6d58-abb8-a6ab-7f85" hidden="false" import="true" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="783e-4786-f8b0-b867" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" />
