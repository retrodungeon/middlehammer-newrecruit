              <modifiers>
                <modifier field="name" type="set" value="Servo-arm (Power Fist)" />
              </modifiers>
            </infoLink>
          </infoLinks>
          <modifiers>
            <modifier field="3c91-ad63-6372-e008-min" type="set" value="2">
