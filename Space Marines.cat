        <profile id="7012-40b4-8bba-0b49-02c2e" name="Shadow Captain Solaq" publicationId="7ab0-ceb9-pubN162349" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic>
