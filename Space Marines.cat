    <selectionEntry name="The Lion Helm" id="16a3-b6bd-23d3-02a9" hidden="true" import="true" type="upgrade">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" />
      </costs>
      <modifiers>
        </modifiers>
      <profiles>
        <profile name="The Lion Helm" id="a1f4-df2b-6c7c-af6c" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Lion Helm is carried by a Helmet Bearer. It stays within 2" of the character with the Lion Helm. It can not attack or be attacked.
The Lion Helm projects a force field  that provides any model (friend or foe) within 3" of the Helmet Bearer with a 4+ Invulnerable save against any shooting attacks.
The effect of the Lion Helm does not extend to vehicles.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
