<profile id="95ab-2005-a753-a17d-ce98a" name="Rear Grapples" hidden="false" page="115" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May be used to transport a single Dreadnought. If a Zooming Stormraven is wrecked, or suffers a Crash and Burn! result, an embarked Dreadnought suffers an S10 hit on its rear armour; if the Stormraven is Hovering, the hit is S4.</characteristic>
      </characteristics>
      <modifiers />
    </profile>
