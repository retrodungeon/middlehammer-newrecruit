                        <condition childId="1028-7523-6719-7232" childName="Scions of Mars" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0" />
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <conditions>
                    <condition childId="terminatorsergeant" field="selections" scope="parent" shared="true" type="instanceOf" value="1" />
                    <condition childId="1202-16ac-4bf1-c237" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1" />
                    <condition childId="0dd7-5b1d-713c-3818" field="selections" scope="root-entry" shared="true" type="atLeast" value="1" />
                    <condition childId="1507-f6be-3680-5e10" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1" />
                    <condition childId="306d-a124-7618-8d4f" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1" />
                    <condition childId="213a-8bf1-e310-6baa" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier affects="self.entries.profiles.Unit" field="4c4423232344415441232323" position="1" scope="parent" type="floor" value="9" />
        <modifier affects="self.entries.profiles.Unit" field="4.123232344415441e+21" scope="parent" type="increment" value="1">
          <conditions>
            <condition childId="7461-f70a-5205-fe07" childName="Terminator Honours" field="selections" scope="parent" shared="true" type="equalTo" value="0" />
          </conditions>
        </modifier>
        <modifier field="6742-dff0-93e8-2b3e" type="set" value="0">
          <conditions>
            <condition childId="8f0b-efba-7e72-b45c" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Terminator Armour" id="3f6b-ceec-fad3-5e44" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A model wearing Terminator armour has a 2+ Armour Save and a 5+ Invulnerable Save. The wearer automatically has Terminator Honours at no additional cost.
Any model wearing Terminator armour can be teleported onto the battlefield. They can start the battle in Reserve and arrive using the Deep Strike special rule, even if it is not part of the mission being played.</characteristic>
          </characteristics>
        </profile>
        <profile name="Terminator Honours" id="c41a-ad49-3fd1-c456" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323" />
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Artificier Armour" id="ca63-bf9b-91fe-f3d0" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="64a1-9892-4d23-a322" field="selections" scope="parent" shared="true" type="max" value="1" />
        <constraint id="d2cd-142b-17f1-1555" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0" />
      </constraints>
