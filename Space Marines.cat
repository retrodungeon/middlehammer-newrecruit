    <profile id="6250-8c66-fd5e-ff71-800b0" name="Armorium Cherub" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One use only. One model in a unit equipped with an Armorium Cherub can re-roll all failed To Hit rolls in one Shooting Phase. Represented by a separate modlel that will always remain as close as possible to the unit. Model itself is purely decorative &amp; is always ignored for game purposes. Remove the model once it has been used or the unit that selected it has been completely destroyed.</characteristic>
      </characteristics>
    </profile>
    <profile id="0a484c81-bea5-3d73-316d-d80d2c888ede-800b0" name="Armour of Antilochus" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Terminator Armour with Teleport Homer. May perform Sweeping Advances.</characteristic>
      </characteristics>
    </profile>
    <profile id="67ce089d-561c-3f53-e8fb-00958d48c6bf-800b0" name="Armour Of Faith" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 4+ Invul Sv</characteristic>
      </characteristics>
    </profile>
    <profile id="af56ead8-a090-7078-808f-f541312af6dc-800b0" name="Armour of Selket" page="10" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, Artificer Armour with Psychic Hood. At the beginning of his turn, by expending a Warp Charge, Loth's save becomes a 2+ Invul Sv which lasts until the beginning of player's next turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="f672f65a-522d-9ad2-0ec9-b3304385dbe9-800b0" name="Armoured Cockpit" page="6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Ignore Crew Shaken or Crew Stunned on a 4+. However, during the Interception sub-phase of the Dogfight phase, vehicles equipped with this upgrade that are in Reserves or Ongoing Reserves count as Bombers for the purpose of calculating modifiers to rolls made in this sub-phase.</characteristic>
      </characteristics>
    </profile>
    <profile id="b8e37629-c94f-4ce2-32e3-5a63489e1975-800b0" name="Artificer Armour" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
