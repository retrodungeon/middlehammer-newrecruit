        <profile name="Titanic Might" id="3f81-cd56-da54-bd8d" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Calgar can re-roll all failed attempts to wound with shooting and close combat attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="God of War" id="34da-d65b-cb07-7874" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Calgar can choose whether to pass or fail any Morale check he is called upon to make. Whilst Calgar is on the table, all units with the Combat Tactics special rule can also choose whether to pass or fail any Morale check they are called upon to take.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gauntlets of Ultramar" id="1d9f-5e85-cf66-409d" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
