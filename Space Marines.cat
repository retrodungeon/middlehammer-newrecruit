              <profiles>
                <profile name="Company Standard" id="mh-ia9-blaylock-cs-4" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Any Space Marine unit within 12" of the Standard Bearer always re-rolls failed Morale and Pinning Tests. In addition, while the standard bearer is still alive, the Command squad counts as scoring one extra wound in close combat for the purposes of calculating assault results.</characteristic>
                  </characteristics>
