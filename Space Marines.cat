      </constraints>
      <profiles>
        <profile id="4d6d-f911-b3e7-4d53-02c2e" name="Battle of the Phall System" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The models Jink save is improved by +1. In the case of a Super-Heavy Flyer, which would not usually be allowed a Jink save, the vehicle gains a Jink save of 6+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40.0" />
      </costs>
