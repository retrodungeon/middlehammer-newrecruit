          <rules>
            <rule id="470f-5c79-54cb-73ed-02c2e" name="Machine Destroyer" hidden="false">
              <description>When attacking any target with an Armour value, rolls of 1 on the Destroyer Damage table may be re-rolled.</description>
            </rule>
