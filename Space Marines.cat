ypeId="mh6-5265617223232344415441232323">14</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Tank, Transport</characteristic><characteristic name="Transport Capacity" typeId="mh6-5472616e73706f727420436170616369747923232344415441232323">25</characteristic><characteristic name="Fire Points" typeId="mh6-4669726520506f696e747323232344415441232323">0</characteristic><characteristic name="Access Points" typeId="mh6-41636365737320506f696e747323232344415441232323">Front ramp plus 2 each side</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">5</characteristic></characteristics></profile><profile id="7873e61d-5605-c905-5bb1-57f8c3320be5-6e59d31" name="Spear of Vulkan" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="112"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Master-crafted, Melee, Two-handed</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="e892062a-767a-091d-83ad-6a569849209e-6e59d31" name="Spectre Pattern Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="28"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">28</characteristic></characteristics></profile><profile id="0b771be1-a3c0-535f-8e8d-ad9958d2aea8-6e59d31" name="Stalker" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="101"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4/2</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Tank</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">101</characteristic><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile><profile id="b9a2d8f4-fd8a-cfbf-bba4-34578e8fbb43-6e59d31" name="Standard of the Emperor Ascendant" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="127"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly units within 12" of the bearer, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests. In addition, friendly units chosen from Codex: Space Marines within 6" of the bearer of the Standard of the Emperor Ascendant have the Hatred special rule and add 1 to their total when determining assault results. Furthermore, the bearer of the Standard of the Emperor Ascendant and his unit have the Fear special rule.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="a2da2b98-1a14-9a16-f860-077c1544545d-6e59d31" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="134"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">134</characteristic></characteristics></profile><profile id="5cf884e6-1be5-c62b-3ce9-462d055e43e1-6e59d31" name="Storm Eagle - Roc Pattern" hidden="false" typeId="mh6-56656869636c6520285472616e73706f72742923232344415441232323" typeName="Vehicle (Transport)" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer, Hover, Transport</characteristic><characteristic name="Transport Capacity" typeId="mh6-5472616e73706f727420436170616369747923232344415441232323">14</characteristic><characteristic name="Fire Points" typeId="mh6-4669726520506f696e747323232344415441232323" /><characteristic name="Access Points" typeId="mh6-41636365737320506f696e747323232344415441232323">Front &amp; rear ramps, plus 1 door each side</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">4</characteristic></characteristics></profile><profile id="3fc6f0ba-e7f0-a031-e1c5-190dbde5a14f-6e59d31" name="Storm Eagle Gunship" hidden="false" typeId="mh6-56656869636c6520285472616e73706f72742923232344415441232323" typeName="Vehicle (Transport)" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer, Hover, Transport</characteristic><characteristic name="Transport Capacity" typeId="mh6-5472616e73706f727420436170616369747923232344415441232323">20</characteristic><characteristic name="Fire Points" typeId="mh6-4669726520506f696e747323232344415441232323" /><characteristic name="Access Points" typeId="mh6-41636365737320506f696e747323232344415441232323">Front &amp; rear ramps, plus 1 door each side</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">4</characteristic></characteristics></profile><profile id="4d818034-4bf4-6fbf-b1ea-408b69ef1843-6e59d31" name="Storm Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="125"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3+ Invul Sv. Cannot claim +1 A for having two Melee weapons in an assault.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="2d2a5274-c27c-af55-d3bf-b0495d5a292c-6e59d31" name="Stormraven Gunship" hidden="false" typeId="mh6-56656869636c6520285472616e73706f72742923232344415441232323" typeName="Vehicle (Transport)" page="97"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer, Hover, Transport</characteristic><characteristic name="Transport Capacity" typeId="mh6-5472616e73706f727420436170616369747923232344415441232323">12, inc. Jump Infantry, plus 1 Dreadnought</characteristic><characteristic name="Fire Points" typeId="mh6-4669726520506f696e747323232344415441232323">0</characteristic><characteristic name="Access Points" typeId="mh6-41636365737320506f696e747323232344415441232323">Front &amp; rear ramps plus 1 door each side</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">97</characteristic><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile><profile id="7deac14c-b9d3-5f67-04d8-93ba7320cdfa-6e59d31" name="Stormstrike Missile" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="121"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">72</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Concussive, One Shot</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">121</characteristic></characteristics></profile><profile id="5a362389-3cf8-1f2e-7f5e-a13a5ddf2d81-6e59d31" name="Stormtalon Gunship" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="96"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">11</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">11</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">11</characteristic><characteristic