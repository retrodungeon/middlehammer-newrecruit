      </characteristics>
    </profile>
    <profile id="0840-97d3-fc87-a022-02c2e" name="Servo-Arm" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
