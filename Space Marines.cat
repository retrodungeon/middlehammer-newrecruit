"mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="105"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Terminator Armour with Teleport Homer. May perform Sweeping Advances.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="af56ead8-a090-7078-808f-f541312af6dc-6e9c41a" name="Armour of Selket" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="10"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv, Artificer Armour with Psychic Hood. At the beginning of his turn, by expending a Warp Charge, Loth's save becomes a 2+ Invul Sv which lasts until the beginning of player's next turn.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="f672f65a-522d-9ad2-0ec9-b3304385dbe9-6e9c41a" name="Armoured Cockpit" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="6"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Ignore Crew Shaken or Crew Stunned on a 4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="b8e37629-c94f-4ce2-32e3-5a63489e1975-6e9c41a" name="Artificer Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="126"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="a280f76b-78de-0ce1-427d-c6ec883c3b27-6e9c41a" name="Assassin Bolts" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="149"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">48</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Sniper</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">149</characteristic></characteristics></profile><profile id="d9b6cbe0-83bc-ef23-2f50-cd5fd08d1d26-6e9c41a" name="Assault Cannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 4, Rending</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="6370155d-69ef-fd4a-a94b-4957e3c9dde1-6e9c41a" name="Assault Drill" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2 (Max 10)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">+D6 to pen. bunkers, fortifications, bastions, other buildings &amp; any vehicle classed as stationary that turn.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7ea5e1f0-19de-ebb7-69f7-7a7faed89eb4-6e9c41a" name="Assault Drill In-built Heavy Flamer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">In addition to normal use, if the DCCW inflicts a pen. hit against a building/vehicle that is occupied, but the target is not destroyed outright, then all models inside suffer a single Heavy Flamer hit automatically after the Dreadnought's other attacks have been resolved (Str 5, Ap 4, distributed as per wounds from a shooting attack). This flamer hit only occurs once per Combat phase, not once per hit.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="bf28b544-874f-f979-0fd7-de694a323e64-6e9c41a" name="Astartes Grenade Launcher (Frag)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="120"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, 3" Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">120</characteristic></characteristics></profile><profile id="f846626c-da98-cf9c-514c-604a02a8eb68-6e9c41a" name="Astartes Grenade Launcher (Krak)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="120"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">120</characteristic></characteristics></profile><profile id="fe7dfa6a-a16d-74b1-c625-3f1e0452dbae-6e9c41a" name="Asterion Moloc, The Brazen Warlord" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="31"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">4</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">4</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/3++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">31</characteristic></characteristics></profile><profile id="ea1b2ee9-dd66-d035-b8fa-aef8719f33c1-6e9c41a" name="Atomantic Shielding" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">5+ Invul Sv against shooting/explosions; 6+ Invul Sv against close combat. If the Contemptor suffers a 'Vehicle Explodes' damage result, add +1" to blast radius.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c0f827a7-dd29-e583-c8d7-ef268611de3d-6e9c41a" name="Attack Bike" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="84"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">84</characteristic></characteristics></profile><profile id="189ef190-7333-b576-bdb6-fa2c13e74c87-6e9c41a" name="Augmented Atomantic Shielding" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="147"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4+ Invul Sv against shooting/explosions; 5+ Invul Sv against close combat. If the Aiakos suffers a 'Vehicle Explodes' damage result, add +2" to blast radius.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="54eb0acc-bcd4-8340-5a46-db83a28727b2-6e9c41a" name="Auspex" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="124"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">A model with an auspex can use it in place of making a shooting attack. If he does so, target an enemy unit within 12" (this does not count as choosing a target for his unit to shoot at). A unit that is targeted by one or more auspexes has its cover saves reduced by 1 until the end of the phase.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="6f807806-1dc8-a300-0978-8c1eb8ef0e53-6e9c41a" name="Autocannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="134"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">48</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">134</characteristic></characteristics></profile><profile id="43bbe41b-e889-5bb4-b5ce-cb4d44cd8f35-6e9c41a" name="Aux Grenade Launcher (Frag)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="97"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, 3" Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">97</characteristic></characteristics></profile><profile id="e2ffd354-db80-45c0-ece0-1da69612a935-6e9c41a" name="Aux Grenade Launcher (Krak)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="97"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">97</characteristic></characteristics></profile><profile id="317e4fc4-3b4f-b23a-213e-5f7bc772e4fa-6e9c41a" name="Auxiliary Grenade Launcher" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="97"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">May be fired in addition to another weapon. Choose from Krak or Frag each time.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="69781626-a109-0c47-0c2a-eb30a475e2d5-6e9c41a" name="Avenger Bolt Cannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 7</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="f7b64554-430b-0752-9b9b-9ed57a8b7724-6e9c41a" name="Battle Alchemistry Hellfire Bolt Pistol" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="29"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic n