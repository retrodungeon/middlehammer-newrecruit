        <rule id="fb6a-5634-ee53-015a-02c2e" name="Scout Sergeant" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>Sergeant Telion may only join units of Scouts</description>
        </rule>
        <rule id="1f5c-9b68-4548-f4c1-02c2e" name="Eye of Vengeance" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>Shots fired by Sergeant Telion (excluding Snap Shots) are always Precision Shots</description>
        </rule>
        <rule id="8d37-31c2-b36a-9f68-02c2e" name="Voice of Experience" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>If Sergeant Telion does not make a shooting attack or Run in the Shooting phase, you can nominate one model in his squad.  That model can use Sergeant Telion's Ballistic Skill that phase.</description>
        </rule>
      </rules>
