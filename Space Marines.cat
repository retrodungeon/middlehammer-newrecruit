    <selectionEntry id="e570-4cbc-6389-003a-02c2e" name="Formation: Ultramarines 1st Company" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="ce31-7b58-3ecf-163c-02c2e" name="Veteran Doctrine" publicationId="7ab0-ceb9-pubN162620" hidden="false">
          <description>When activating either the Devastator, Assault or Tactical Doctrine as part of the Ultramarines Chapter Tactics, units from this Formation instaed re-roll all failed to Hit rolls in the Shooting and Assault phases of that turn.</description>
        </rule>
        <rule id="6d32-5f6b-2fe7-a7e1-02c2e" name="Paragons of the Imperium" publicationId="7ab0-ceb9-pubN162620" hidden="false">
          <description>Friendly units from the Armies of the Imperium within 6" of any units from this Formation have the Stubborn special rule.</description>
        </rule>
      </rules>
      <infoLinks>
