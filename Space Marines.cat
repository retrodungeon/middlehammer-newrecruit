        <profile id="d5c2-ba1a-3bf2-0ff6-02c2e" name="Cerberus Heavy Tank Destroyer" publicationId="7ab0-ceb9-pubN192504" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
          <characteristics>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">14</characteristic>
            <characteristic name="Side" typeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e">14</characteristic>
            <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">13</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">6</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Super-Heavy Tank)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="4a28-212d-86d5-48f0-02c2e" name="Reactor Blast" publicationId="7ab0-ceb9-pubN192504" hidden="false">
          <description>Should the Cerberus lose its last Hull Point, it rolls on the Catastrophic Damage table with a +1 modifier, The vehicle is then removed.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="0fba-ab21-1a2b-328a-02c2e" name="Twin-Linked Neutron Laser Battery" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5248-b917-43ec-ddd4-02c2e" type="min" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="fcef-3feb-0a5a-8050-02c2e" type="max" />
          </constraints>
          <profiles>
            <profile id="5e41-bea3-813b-26c8-02c2e" name="Neutron Laser Battery" publicationId="7ab0-ceb9-pubN192504" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">72"</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">10</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Primary Weapon D3, Concussive, Feedback, Shock Pulse</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="dd80-fff2-8d17-1582-02c2e" name="Feedback" publicationId="7ab0-ceb9-pubN192504" hidden="false">
              <description>If a weapon with this type fail it Penetration roll against a target vehicle's armour or fails a To Wound roll against a target model roll a D6. If the result is a 1, dangerous energy feedback along the beam causes the firing model to lose 1 Hull Point or Wound.</description>
            </rule>
            <rule id="30cc-f45f-1735-0cae-02c2e" name="Shock Pulse" publicationId="7ab0-ceb9-pubN192504" hidden="false">
              <description>Any vehicle (including super-heavy vehicles) that suffers a Penterating hit from a weapon with this type may only fire Snap Shots in the following game turn.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="f02a-2a8d-472e-8e31-02c2e" name="" hidden="false" targetId="d0ea-e2a6-032d-8754" type="rule" />
            <infoLink id="bf70-e5c5-96df-9737-02c2e" name="" hidden="false" targetId="3002-de38-7230-fbc6" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
