          <constraints>
            <constraint id="8ec0-156c-cc25-85b8" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1" />
            <constraint id="c4a4-e7e5-6df9-50c5" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1" />
