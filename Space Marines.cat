    <selectionEntry id="0e99-6a9e-bd14-214e-02c2e" name="Formation: Anti-Air Defence Force" publicationId="7ab0-ceb9-pubN113504" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="88d4-8102-2132-a934-02c2e" name="Formation: Anti-Air Defence Force" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>If a Hunter from this Formation causes a hit on an emey Flyer or Flying Monstrous Creature when firing its skyspear missile launcher, all stalkers in this Formation add 1 to their Ballistic Skill until the end of the phase when firing at the same target unit.	</description>
        </rule>
      </rules>
