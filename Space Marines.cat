        <profile id="18de-5b99-a82b-684d-02c2e" name="Land Raider Achilles (Transport)" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">6.</characteristic>
            <characteristic name="Fire Points" typeId="fe20-e124-2c11-86ee">None.</characteristic>
            <characteristic name="Access Points" typeId="21e5-4518-a31c-7e56">2. One on each side of the Hull.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ae85-0d1e-a2d5-007e-02c2e" name="Ferromantic Invulnerability" publicationId="7ab0-ceb9-pubN169253" hidden="false">
          <description>The Land Raider Achilles is not subject to the effects of the Lance and Melta special rules by attacks made against it. In addition, it reduces the effects of all roll son the damage chart caused by Penetrating hits by -1 (other than Destroyer Weaponry)</description>
        </rule>
      </rules>
