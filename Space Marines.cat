stic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Coup de Grace</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">106</characteristic></characteristics></profile><profile id="dda0d06d-cd85-cc1c-2e65-d0e7ee82c41d-6e59d31" name="Talisman of Sundered Souls" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="21"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">5+ Invul Sv. May re-roll a failed test to use a psychic power once per player turn (may negate Perils of the Warp)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7613090d-3a24-83ad-7226-67947dacf1e1-6e59d31" name="Tarantula" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Artillery</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">-</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">3</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">-</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">6</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">-</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">-</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">-</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="68413300-7d33-8f4a-cc31-48e50711aa21-6e59d31" name="Ta