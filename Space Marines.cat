              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Quickening" id="bf97-e5fb-be28-d457" hidden="false">
              <description>This psychic power may be attempted at the start of any assault phase. If successful one model in the psyker's unit (including themselves) gains +D3 Attacks in that assault phase.</description>
            </rule>
          </rules>
        </selectionEntry>
