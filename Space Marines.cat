ng an enemy unit which is within 12" of the Flare, gains Night Vision for that Shooting phase.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c68d4fda-c0dd-5159-5488-d19cef60622f-6e9c41a" name="Imperial Bastion" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323" /><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="94576e59-b8ee-0edf-7f35-81fac8d299fc-6e9c41a" name="Indynabula Array" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="29"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">5+ Invul Sv, has Counter-attack, 2x Dendrite Blades</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="94a8c3a2-58b3-1b5a-e8b2-9c19a1a43e82-6e9c41a" name="Inferno Cannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="268"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18 + Template</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">268</characteristic></characteristics></profile><profile id="92604412-9084-2792-95ec-c04f3ba5f567-6e9c41a" name="Inferno Gun (Titan)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="136"><characteristics><characteristic name="Range" typeId="mh6-52616e67652323234441544123232