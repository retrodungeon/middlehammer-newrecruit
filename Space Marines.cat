    </selectionEntry>
    <selectionEntry id="1998-cd2d-3636-614c-02c2e" name="Formation: Shadowstrike Kill Team" publicationId="7ab0-ceb9-pubN158942" page="63" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="36e4-fc22-3c24-3b5f-02c2e" name="On Time..." publicationId="7ab0-ceb9-pubN65665" hidden="false">
          <description>Instead of rolling to see whether a unit of Vanguarg Veterans from this Formation arrives from Reserve, you can choose whether to pass or fail that roll.</description>
        </rule>
        <rule id="228b-3ca2-0b8b-279e-02c2e" name="...On Target" publicationId="7ab0-ceb9-pubN65665" hidden="false">
          <description>Vanguard Veteran Squads from this Formation can charge on the turn they arrive from Deep Strike if the first model is placed within 9" of at least two Scout Squads from this Formation.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink id="a7aa-4200-4ec1-e93b-02c2e" name="" hidden="false" collective="false" import="true" targetId="a086-0fc3-ba8c-121b-02c2e" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="4.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b07d-d6cf-d64c-9403-02c2e" type="max" />
            <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="de72-f805-9345-8051-02c2e" type="min" />
