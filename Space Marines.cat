          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Reserves" id="8532-409c-2240-2c5f" hidden="false">
          <description>Units in drop pods are always in Reserve, even in missions that do not normally allow reserves to be used</description>
        </rule>
        <rule name="Drop Pod Deployment" id="b044-faa1-ea9d-ceb3" hidden="false">
          <description>See 1st Edition Imperial Armour v2</description>
        </rule>
        <rule name="Automated Weapons" id="bb84-de5f-7c74-3eb0" hidden="false">
          <description>When the Deathwind drop pod lands it opens fire. After landing, each unit (enemy and friendly) within 12" of the Deathwind and in line of sight is fired as a hail of missiles or bullets sweep the area. Roll to hit using the Deathwind's BS2 for either D3 frag missile attacks or a D3 assault cannon attacks (Heavy 3) against each target unit.
After the first turn of firing the Deathwind cannot fire again.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapons" id="3dc9-de4d-76bc-75f0" collective="false" hidden="false" import="true">
          <constraints>
