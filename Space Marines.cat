    <selectionEntry id="9181-a819-5447-e8b4-02c2e" name="Formation: 1st Company Task Force" publicationId="7ab0-ceb9-pubN113504" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="29c5-988c-bef2-1efe-02c2e" name="Extremis Level Threat" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>At the start of the game, before deployment, nominate one unit in the enemy army.  Units in this Formation have the Preferred Enemy special rule when making attacks against the nominated unit.</description>
        </rule>
        <rule id="0ff3-e411-5db7-025b-02c2e" name="Terrifying Proficiency" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>Enemy units subtrat 2 from their Leadership whilst they are within 12" of at least three units from this Formation.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="c9db-c8e4-99a0-71ff-02c2e" name="" hidden="false" targetId="280d-1a0c-5916-3012" type="rule" />
