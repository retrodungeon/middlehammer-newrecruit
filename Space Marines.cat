        </modifier>
      </modifiers>
      <profiles>
        <profile id="28ba-2e02-d2bc-6be1-02c2e" name="Deredeo Pattern Dreadnought" publicationId="7ab0-ceb9-pubN174565" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Walker">
