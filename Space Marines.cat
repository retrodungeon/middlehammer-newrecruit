    <selectionEntry id="6152-8c0d-9810-0873-02c2e" name="Chapter Relic (SAL): The Salamander's Mantle" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f80e-acc0-12db-04c1-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="e1c2-3fe8-7713-582c-02c2e" name="Chapter Relic (SAL): The Salamander's Mantle" publicationId="7ab0-ceb9-pubN65665" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer of the Salamander's Mantle has the Eternal Warrior special rule.</characteristic>
          </characteristics>
        </profile>
