      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6afe-61f8-697d-4957-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="00c9-5a01-d115-9b3f-02c2e" name="Ullanor Crusade" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Dreadnought with the Ullanor Crusade Legacy of Glory gains the Hatred (Orks) Special Rule.  Enemy models charging a vehicle with the Ullanor Crusade Legacy of Glory must re-roll successful To Hit rolls in the first round of each combat.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
