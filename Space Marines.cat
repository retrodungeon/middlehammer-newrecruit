    <selectionEntry id="6f6c-cab8-512b-6c1f-02c2e" name="Formation: Shadow Force" publicationId="7ab0-ceb9-pubN158942" page="67" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="fb77-8bc6-d26a-e9cc-02c2e" name="Swift Redeployment" publicationId="7ab0-ceb9-pubN65665" hidden="false">
          <description>Non-vehicle units in this Formation can re-roll the dice when determining their Run moves, and vehicle lunits in this Formation can move an additioanl 6" when moving Flat Out.</description>
        </rule>
      </rules>
      <infoLinks>
