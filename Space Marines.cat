    <selectionEntry name="Space Marine Bike" id="da0f-af82-52b0-763e" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Bolter" id="362b-d917-c294-5915" hidden="false" targetId="fa34-07ff-1a5d-fe9f" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Twin-linked Bolter" />
            <modifier field="8b10-045a-f593-605e" join=", " type="append" value="Twin-linked" />
          </modifiers>
        </infoLink>
        <infoLink name="Turbo-Boosters" id="fcbf-19be-fbf4-4cfb" hidden="false" targetId="793e-3ba7-feb3-8ad4" type="rule" />
      </infoLinks>
