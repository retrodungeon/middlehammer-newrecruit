      <rules>
        <rule id="d2a3-a785-0772-6fd7-02c2e" name="Severing Cut" publicationId="7ab0-ceb9-pubN174565" hidden="false">
          <description>Each time a non-vehicle model suffers a wound from this weapon, roll a D6. On a 4+, the model suffers an additional D3 wounds which must be saved separately using the weapon's profile (note that these wounds do not themselves generate more additional wounds)</description>
        </rule>
      </rules>
