      <rules>
        <rule id="fddc-658d-85aa-2501-02c2e" name="Linebreaker Bombardment" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>If this unit contains three Vindicators that can all fire their demolisher cannons, the squadron can fire a single Linebreaker Bombardment instead of firing normally.  To do so, nominate one model in the squadron as the firer; the firer's demolisher cannon changes its type from Large Blast to Apocalyptic Blast and gains the Ignores Cover special rule.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="c546-15df-b2c5-2383-02c2e" name="Siege Shield" hidden="false" collective="false" import="true" type="upgrade">
