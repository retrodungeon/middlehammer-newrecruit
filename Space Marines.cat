aracteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="f8b7d6ab-57de-4759-01b3-d37c7a935c83-6e59d31" name="Extra Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Count Crew Stunned results as Crew Shaken instead.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="6099b71d-a19e-cedc-c50b-f9695e1cd013-6e59d31" name="Fellblade" hidden="false" typeId="mh6-56656869636c65202853757065722048656176792923232344415441232323" typeName="Vehicle (Super Heavy)" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">14</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">13</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Structure Points" typeId="mh6-53747275637475726520506f696e747323232344415441232323" /><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Super-heavy Vehicle</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">12</characteristic></characteristics></profile><profile id="b24d1e74-572b-7e4d-a157-9ce36419ce9d-6e59d31" name="Fellblade Accelerator Cannon (AP Shell)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">100</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">9</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic>