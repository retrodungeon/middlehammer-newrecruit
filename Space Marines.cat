        <profile id="b91b-989b-9305-6ef3-02c2e" name="Warlord Trait: Legendary Fighter" publicationId="7ab0-ceb9-pubN179327" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">An army gains 1 Victory point for each enemy character slain by the Warlord in a challenge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="0e3c-d139-f1f2-7005-02c2e" name="The Tyrant's Champion" publicationId="7ab0-ceb9-pubN179327" hidden="false">
          <description>All friendly units, but not Independent Characters, chosen from Codex: Space Marines or the Space Marine Siege Assault Vanguard army list with the Chapter Tactics (Astral Claws) special rule as part of the same detachment as Corien Sumatris gain +1 WS while within 12" of him. Any squad he joins gains the Furious Charge special rule while he is part of the squad.</description>
        </rule>
      </rules>
