    <selectionEntry id="fe6c-f459-7cb6-e3b8-02c2e" name="Formation: Suppression Force" publicationId="7ab0-ceb9-pubN113504" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="c429-8131-ad66-03f8-02c2e" name="Datalink Telemetry" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>One Land Speeder from this Formation can nominate an enemy unit within 18" and in line of sight in its Shooting phase.  It cannot do this in the same turn it moves Flat Out. Until the end of the phase, all shooting attacks made with Whirlwind multiple missile launchers by models in this Formation against the nominated target can re-roll To Hit rolls and are treated as having an infinite range.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink id="b8f6-ab99-09fa-29b3-02c2e" name="" hidden="false" collective="false" import="true" targetId="6f08-194e-a422-37e6-02c2e" type="selectionEntry">
