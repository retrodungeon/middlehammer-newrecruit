          <infoLinks>
            <infoLink name="Flamer" id="344b-46a4-23fe-db49" hidden="false" targetId="e329-1729-419b-2bb6" type="profile" />
            <infoLink name="Plasma Pistol" id="393e-a948-d1e2-210d" hidden="false" targetId="00e2-6e56-5dfe-e202" type="profile">
              <modifiers>
                <modifier field="name" type="set" value="Plasma Cutter" />
                <modifier field="8b10-045a-f593-605e" join=", " type="append" value="Twin-linked" />
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Servo-Harness" id="c16e-487c-0ae3-2dd3" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A servo-harness incorporates the following features: artificer armour, a second servo-arm (giving two servo-arm attacks), a plasma cutter (which counts as a twin-linked plasma pistol), and a flamer. In the Shooting phase the Techmarine may fire both harness-mounted weapons or one harness-mounted weapon and one of his personal weapons. A Techmarine with a servo-harness may reroll the dice when attempting to repair a damaged vehicle (See Blessing of the Omnissiah special rule).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Servo-arm" id="7def-6aae-89be-f217" hidden="false" import="true" sortIndex="5" type="upgrade">
          <constraints>
            <constraint id="3c91-ad63-6372-e008-min" automatic="true" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1" />
            <constraint id="3c91-ad63-6372-e008-max" automatic="true" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <infoLinks>
