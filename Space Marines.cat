      </constraints>
      <rules>
        <rule id="7301-d1dc-01f3-58da-02c2e" name="One with the Darkness" publicationId="7ab0-ceb9-pubN162349" hidden="false">
          <description>So long as this unit does not move, run, or charge during your turn, it gains the Shrouded special rule until the start of your next turn.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="7629-60a7-4e2d-d61f-02c2e" name="" hidden="false" targetId="2e56-6b02-4343-0e40" type="rule" />
