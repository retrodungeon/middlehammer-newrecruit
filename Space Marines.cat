    <selectionEntry id="f7fc-bd16-5771-2dbf-02c2e" name="Formation: Victrix Guard" publicationId="7ab0-ceb9-pubN67599" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="bed2-6bd4-f664-9cdf-02c2e" type="lessThan" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="142a-8aa3-48b6-49c7-02c2e" name="Fight like Demigods" publicationId="7ab0-ceb9-pubN67599" hidden="false">
          <description>Add 1 to the Weapon Skill and Ballistic Skill characterisitcs of all models in this Formation</description>
        </rule>
        <rule id="f529-930a-4112-a478-02c2e" name="The Primarch's Chosen" publicationId="7ab0-ceb9-pubN67599" hidden="false">
          <description>While a unit from this Formation is within 3" of Roboute Guilliman, he can make Look Out, Sir rolls as if he was part of that unit.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="7d9b-ef5e-6fbb-d866-02c2e" name="Veterans" hidden="false" collective="false" import="true" defaultSelectionEntryId="7533-86e3-9e5e-0517-02c2e">
