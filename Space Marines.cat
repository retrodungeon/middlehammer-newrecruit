    <selectionEntry id="c579-39e3-c7d9-9f29-02c2e" name="Chapter Relic (SAL): The Tome of Vel'Cona" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="903f-d781-581d-bcf8-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="7930-85ce-d77b-6f3b-02c2e" name="Chapter Relic (SAL): The Tome of Vel'Cona" publicationId="7ab0-ceb9-pubN65665" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with the Tome of Vel'cona knows the Molten Beam power from the Pyromancy discipline in addition to any others he knows.  This is not considered when determining if he has Psychic Focus.  In addition, the bearer of the Tome of Vel'cona can add 1 to the Strength of all Pyromancy witchfire powers he uses.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="f7f2-20e6-32a1-174c-02c2e" name="Chapter Relic (SAL): Wrath of Prometheus" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b63e-7048-29c3-2b79-02c2e" type="max" />
