        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May re-roll failed Armour Sv against Shooting attacks only. May not run or make Sweeping Advances. Bulky. Must be modelled apporpriately.  ICs joining an equipped unit gain the benefits but must also abide by these restrictions.</characteristic>
      </characteristics>
    </profile>
    <profile id="c3dc882b-8e91-802f-681b-b59ed3d7b15b-800b0" name="Siege Master" page="0" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
