    <profile id="0ddd-2041-cc18-cb30-02c2e" name="Seismic Hammer" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
