          <infoLinks>
            <infoLink name="Power Weapon" id="018a-218a-caba-cf1b" hidden="false" targetId="5774-7187-2616-dd8a" type="profile">
              <modifiers>
                <modifier field="name" type="set" value="Artekus Scourge" />
                <modifier field="492d-1f80-b777-26f2" type="set" value="If the Scourge wounds a model with more than one wound, it must roll under its Ld on 3D6 or be instantly removed as a casualty." />
              </modifiers>
            </infoLink>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="71f1-cbf9-c4ed-47ac" childName="Relictor" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Daemon Weapon" id="111b-3738-5ee5-9e87" hidden="false">
              <description>In any turn the bearer inflicts at least one casuality with the Daemon weapon, the wielder must take a Leadership test at the end of the turn. If the test is failed the wielder suffers a Perils of the Warp attack.</description>
            </rule>
          </rules>
        </selectionEntry>
