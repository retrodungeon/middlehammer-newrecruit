            <profile id="3e25-7f25-47a3-9b29-02c2e" name="Aiolos Missile Launcher" publicationId="7ab0-ceb9-pubN174565" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
