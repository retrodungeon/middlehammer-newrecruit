32323">27</characteristic></characteristics></profile><profile id="f460e872-d876-d8df-f61b-ad7b2b8c29d6-6e9c41a" name="Biker Sergeant" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="84"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">84</characteristic></characteristics></profile><profile id="d4e59094-31a7-baac-f1ed-6c223fba79b8-6e9c41a" name="Biker Veteran Sergeant" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="84"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic nam