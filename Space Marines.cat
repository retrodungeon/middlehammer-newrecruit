            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+/4++</characteristic>
          </characteristics>
        </profile>
        <profile id="a047-f0c4-4972-8a96-02c2e" name="Warlord Trait: Proud to Live, Proud to Die, Hard to Kill" publicationId="7ab0-ceb9-pubN179327" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When calculating the victors of any and all assaults that take place within 12" of Carab Culln, the Red Scorpions player adds +1 to their score.  If Carab Culln is involved in a challenge during that particular Assault phase, bonus is increased to +2. However, Carab Culln may never benefit from the Look Out, Sir rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="112f-0776-1e75-0e5d-02c2e" name="Master of Battle" publicationId="7ab0-ceb9-pubN179327" hidden="false">
          <description>All units with the Chapter Tactics (Red Scorpions) in the same detachment as Carab Culln may use his Leadership value for determining the effects of all Pinning Tests and Morale Checks</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6041-2c22-e469-0a3b-02c2e" name="" hidden="false" targetId="894f-81b4-7aca-8eda-02c2e" type="rule">
