    <profile id="83af42ec-c7eb-453f-e36a-e8dd1fe52dba-800b0" name="The Banner of Staganda" page="83" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Banner of Staganda can only be taken by a model that may take a Company Standard. The bearer has the Counter-Attack and Crusader special rules. In addition,  friendly units within 12" of the bearer, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests.</characteristic>
      </characteristics>
    </profile>
    <profile id="82a7-4a86-b15d-79c0-800b0" name="The Banner of the Eagle" page="154" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly White Scars units within 12" have Fleet and Furious Charge.</characteristic>
      </characteristics>
    </profile>
