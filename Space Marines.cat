 typeId="mh6-556e697423232344415441232323" typeName="Unit" page="82"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">92</characteristic></characteristics></profile><profile id="5a476120-509e-311a-a530-4915d13cce6e-6e59d31" name="Teeth of Terra" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="127"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Rampage, Specialist Weapon, Strikedown</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">127</characteristic></characteristics></profile><profile id="72e202d2-1299-f96f-6688-145b6679593c-6e59d31" name="Teleport Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="148"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Units arriving by teleport (using deep strike), which are part of the force containing the Damocles, do not scatter if they choose to arrive within 12" of Damocles.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="46cd6439-2dc3-2f42-0174-cb6b696f29e3-6e59d31" name="Teleport Homer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="125"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly units composed entirely of models in Terminator armour do not scatter when they Deep Strike, so long as the first model is placed within 6" of the teleport homer's bearer. For this to work, the bearer of the teleport homer must have been on the battlefield at the start of the turn.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="460e99c5-9196-1f8d-2930-bc9d00f0adfe-6e59d31" name="Terminator" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="90"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/5++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">90</characteristic></characteristics></profile><profile id="77cd0765-7ddf-d654-cc86-3de641888ae3-6e59d31" name="Terminator Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="126"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv, 5+ Invul Sv, Relentless, Bulky, Deep Strike, may not make Sweeping Advances.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="79ca2b2b-c01e-00f5-7831-0693bd600b56-6e59d31" name="Terminator Captain" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="79"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">79</characteristic></characteristics></profile><profile id="043a2dd2-ddd8-a8c7-cefb-ba1d58144afc-6e59d31" name="Terminator Sergeant" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="90"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/5++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">90</characteristic></characteristics></profile><profile id="4d4cdb30-cd78-725f-0e9c-f354d2d6535f-6e59d31" name="The Aenigmata Ferrum" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="22"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Any Space Marine on Kane's side within 12" of him can re-roll 1s when rolling to Wound in an Assault.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="10552e74-4868-c717-bb89-27480edd9858-6e59d31" name="The Armour Indomitus" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="127"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv, 6+ Invul Sv, Relentless. Once per game, at the beginning of any phase, the wearer can choose to temporarily push the armour's force field to its limit. For the duration of that phase, it confers a 2+ Invul Sv.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="67ce089d-561c-3f53-e8fb-00958d48c6bf-6e59d31" name="The Armour Of Faith" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="118"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+ Armour Sv, 4+ Invul Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="d32cf74b-bc68-b5e4-f040-be95d2f21489-6e59d31" name="The Axe of Medusa" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted, Severing Strike, Unwieldy</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="42dbd4c3-7516-9e61-6b18-e6eba32ffe56-6e59d31" name="The Black Spear" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="31"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Specialist Weapon</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">31</characteristic></characteristics></profile><profile id="6c691d07-5f91-0cff-2bd3-24515955c0a0-6e59d31" name="The Black Spear Lasbeam" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="31"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, One Use</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">31</characteristic></characteristics></profile><profile id="cfeff144-85cf-2e28-f0f3-e26d5f877ef4-6e59d31" name="The Black Sword" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="118"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="58d84434-ef3d-9519-b836-34dd3945fa35-6e59d31" name="The Black Sword (One-handed Stance)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="118"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted, Slay the Heretic</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="55e09aaa-39cd-d1dd-a97b-863a5e361921-6e59d31" name="The Black Sword (Two-handed Stance)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="118"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted, Two-Handed, Unwieldy, Smite the Unclean</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="a6b18952-26e6-75e3-85c6-fc20f8318b9e-6e59d31" name="The Blade of the Scorpion" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="9"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted, Smash*</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">9</characteristic></characteristics></profile><profile id="f7754842-f151-6f5f-eabe-8f38525ab31c-6e59d31" name="The Burning Blade" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="127"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Blind, Incandescent</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">127</characteristic></characteristics></profile><profile id="82b22d55-4092-0a4f-0157-90e5d9d493f7-6e59d31" name="The Emperor's Champion" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="118"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">118</characteristic></characteristics></profile><profile id="0e78f2e1-8f37-d2ff-2371-6f1dac3173c0-6e59d31" name="The Ghost Razors" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="27"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Shred, Specialist Weapon, Ghost Razors</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">27</characteristic></characteristics></profile><profile id="5b17e610-5f5e-35e8-5349-11493dcbc9a6-6e59d31" name="The Gorgon’s Chain" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">The bearer of the Gorgon’s Chain has the following special rules, depending on how many unsaved Wounds he has suffered during  the battle:  Wounds Suffered - Special Rules  0 Wounds suffered - The bearer has a 3+ invulnerable save, +1 to his Feel No Pain rolls and the Eternal Warrior special rule. 1 Wound suffered - The bearer has a 3+ invulnerable save and the Eternal Warrior special rule. 2 Wounds suffered - The bearer has a 3+ invulnerable save. 3 Wounds suffered - The bearer has a 4+ invulnerable save.  Each time the bearer suffers an unsaved Wound or recovers a Wound as a result of the It Will Not Die special rule, the effects of the Gorgon’s Chain change immediately; you should roll the bearer’s saves individually.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7805feca-5410-cf52-194c-e655e232ef68-6e59d31" name="The Hellslayer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="26"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Unwieldy, Two-handed, Master-crafted, Concussive, Slayer (Daemon &amp; Psyker)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">26</characteristic></characteristics></profile><profile id="1c7813ab-1ef3-2643-95cd-426a15df7d98-6e59d31" name="The Ironstone" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly Clan Raukaan Tanks and Walkers within 6" of the bearer pass their It Will Not Die rolls on a 4+. If this roll is a 6, the Ironstone also repairs a Weapon Destroyed or Immobilised result that the vehicle suffered earlier in the battle (controlling player’s choice).</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="843ea57c-abf5-84a4-2938-4270692d8697-6e59d31" name="The Lifetaker" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="22"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Unwieldy, Two-handed</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">22</characteristic></characteristics></profile><profile id="0c434ede-6999-48c7-7c88-5972245d4e0b-6e59d31" name="The Mindforge Stave" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive, Force, Unwieldy</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="daf6edf3-d92b-3fb4-5a39-6cc500119f08-6e59d31" name="The Primarch’s Wrath" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="127"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Salvo 3/5, Shred, Master-crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">127</characteristic></characteristics></profile><profile id="bf65ce4d-eeb1-4f3e-9fdc-c937a8bcf962-6e59d31" name="The Raven's Talons" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="113"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rending, Melee, Master-crafted, Shred</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">113</characteristic></characteristics></profile><profile id="c2e87e76-1195-9911-45de-56a06ba36c35-6e59d31" name="The Shield Eternal" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="127"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Storm Shield, grants Adamantium Will and Eternal Warrior. 3+ Invul Sv. Cannot claim +1 A for having two close combat weapons in Assault.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c723b43d-0b53-d900-6218-057ec475d4af-6e59d31" name="The Sword Excellus" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="25"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Rending, Soul Blaze, Specialist Weapon, Smash*</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">25</characteristic></characteristics></profile><profile id="a78fe1e3-3d94-8122-698a-375bb152c2e9-6e59d31" name="The Tempered Helm" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">When taking Morale tests, all friendly units within 24" of the bearer can use his Ld instead of their own. Furthermore, nominate a single friendly unit within 12" of  the bearer at the start of  each of  his Shooting phases. That unit can reroll all To Hit rolls of a 1 in that Shooting phase.  Both of these rules can be used even if the bearer is embarked in a vehicle or building.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="58c6cd77-4987-028f-761a-9fac0ad1c535-6e59d31" name="Thulsa Kane, Old Night" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="22"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">22</characteristic></characteristics></profile><profile id="85d2dada-b527-d574-f923-56ea9f013e6d-6e59d31" name="Thunder Hammer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive, Specialist Weapon, Unwieldy</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="a9e2e899-40a3-0ccd-da7a-f23da1ab205b-6e59d31" name="Thunderfire (Airburst)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="122"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">60</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 4, Barrage, 3" Blast, Ignores Cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">122</characteristic></characteristics></profile><profile id="39b35939-3bd3-0ce1-c3a