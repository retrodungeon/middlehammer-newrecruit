    <selectionEntry id="24cc-1105-7cee-fb61-02c2e" name="Legion of the Damned" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="16f3-09b0-73a4-db79-02c2e" name="Unyeilding Spectors" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>The Legion of the Damned have a 3+ invulnverable save.</description>
        </rule>
        <rule id="1f2f-46cc-0952-08ba-02c2e" name="Aid Unlooked For" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>The Legion of the Damned cannot be joined by Independent Characters. They always start the game in Deep Strike Reserve. When they arrive by Deep Strike, you can choose to re-roll both the 2D6 and the scatter dice.</description>
        </rule>
        <rule id="b999-04c2-2077-7d20-02c2e" name="Flaming Projectiles" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>Ranged attacks made by the Lgion of the Damned have the Ignores Cover special rule.</description>
        </rule>
      </rules>
