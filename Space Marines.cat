            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">5</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+/4++</characteristic>
          </characteristics>
        </profile>
        <profile id="063b-40c6-5327-645b-02c2e" name="Warlord Trait: Proud to Live, Proud to Die, Hard to Kill" publicationId="7ab0-ceb9-pubN207770" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When calculating the victors of any and all assaults that take place within 12" of Carab Culln, the Red Scorpions player adds +1 to their score. If Carab Culln is involved in a challenge during that particular Assault phase, this bonus is increased to +2. However, Carab Culln may never benefit from the Look Out, Sir rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5968-1f8a-38d1-19d8-02c2e" name="Master of Battle" publicationId="7ab0-ceb9-pubN207770" hidden="false">
          <description>All units with Chapter Tactics (Red Scorpions) in the same detachment as Carab Culln may use his Leadership value for determining the effects of all Pinning tests and Morale checks.</description>
        </rule>
        <rule id="5861-bf80-ce09-956a-02c2e" name="Against All Odds" publicationId="7ab0-ceb9-pubN207770" hidden="false">
          <description>Commander Culln and any squad he joins may re-roll all attacks made in close combat when outnumbered in an assault. Whilst alive he also grants himself and his squad the Counter-attack and Stubborn special rules.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9f80-7ec8-f0cc-5420-02c2e" name="" hidden="false" targetId="1f6d-19c4-e3e6-eb87-02c2e" type="profile" />
        <infoLink id="1e2c-714e-0395-75b6-02c2e" name="" hidden="false" targetId="2e56-6b02-4343-0e40" type="rule" />
