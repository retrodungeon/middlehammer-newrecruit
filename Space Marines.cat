      </characteristics>
    </profile>
    <profile id="e174762b-9d4f-a42d-47fb-a3553cd7c4f3-1c28e" name="Missile Launcher (Krak)" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
