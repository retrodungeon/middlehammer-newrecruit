      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="2a12-8822-1dc2-5ab1-02c2e" name="Legacy: Shrouded Provenance" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c167-c33b-b41c-6a42-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="3f81-4238-8589-37da-02c2e" name="Shrouded Provenance" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Venerable special rule.  The vehicle always counts as an Ally of Convience to units in its own detachment, and as a Desperate Ally to units in any allied detachment.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="d151-f531-92a3-c1de-02c2e" name="" hidden="false" targetId="043d-4926-4c9d-09c4-02c2e" type="rule" />
