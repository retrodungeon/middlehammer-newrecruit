    <profile id="beaf-c0c8-a41d-b346-02c2e" name="Rear Grapples" publicationId="7ab0-ceb9-pubN109967" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Stormraven can transport a single Dreadnought with its rear grapples.  An embarked Dreadnought suffers a Strength 10 hit on its rear armour if a Zooming Stormraven is wrecked or suffers a Crash and Burn! result; the hit is Strength 4 if the Stormraven is Hovering.</characteristic>
      </characteristics>
    </profile>
