                  <profiles>
                    <profile id="7d83-b60b-835d-361d-02c2e" name="Rod of Command" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The range of the Land Raider Excelsior's Tactical Authority special rule is increased to 18"</characteristic>
                      </characteristics>
