    <selectionEntry id="228b-5f8b-ffd3-7de3-02c2e" name="Legacy: Schism of Mars" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5dfc-2dbc-9869-df21-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="1ac5-4278-0049-b539-02c2e" name="Schism of Mars" publicationId="7ab0-ceb9-pubN169253" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Tank Hunters special rule, and when targeting enemy models with the Daemonforge special rule, gains +1 BS. In addition, it ignores the effects of the Haywire special rule on a D6 roll of 4+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="8e67-fc2b-72a8-9433-02c2e" name="" hidden="false" targetId="4378-c0f8-107a-4e3e" type="rule" />
