                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60"</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 3, Pinning, Independent Tracking</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="5b05-79ec-a376-40b8-02c2e" name="Independent Tracking" publicationId="7ab0-ceb9-pubN174565" hidden="false">
              <description>This weapon may fire at a different target to that of the Doredeo's other shooting attacks if desired and ignores intervening obstacles to line of sight in open terrain.  When firing at vehicles, it attacks their Side Armour value.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35.0" />
          </costs>
        </selectionEntry>
