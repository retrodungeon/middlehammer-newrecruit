            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly White Scars units within 12" of a model with the Banner of the Eagle have the Fleet and Furious Charge special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="d9ec-91bf-aeb1-e5b2-02c2e" name="" hidden="false" targetId="39c6-1f20-a156-47f4" type="rule" />
