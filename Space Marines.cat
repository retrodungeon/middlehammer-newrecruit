        <modifier field="d2cd-142b-17f1-1555" type="set" value="1">
          <conditions>
            <condition childId="6d58-abb8-a6ab-7f85" field="selections" scope="parent" shared="true" type="atLeast" value="1" />
          </conditions>
        </modifier>
        <modifier field="6f18-a8fc-2c5b-9517" type="set" value="0">
          <conditions>
            <condition childId="6d58-abb8-a6ab-7f85" field="selections" scope="parent" shared="true" type="atLeast" value="1" />
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Artificier Armour" id="704e-0923-2684-ba47" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323" />
          </characteristics>
