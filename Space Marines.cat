        <infoLink name="Orbital Lander" id="bbdb-d6e5-bd2b-d140" hidden="false" targetId="7b1f-05c8-5a14-f539" type="rule" />
        <infoLink name="Twin-Linked" id="9cf6-264b-f3cd-48f8" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
