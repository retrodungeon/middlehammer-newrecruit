        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Unwieldy, Two-handed</characteristic>
      </characteristics>
    </profile>
    <profile id="0c434ede-6999-48c7-7c88-5972245d4e0b-800b0" name="The Mindforge Stave" page="89" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
