    <selectionEntry id="cf1d-9506-e262-6484-02c2e" name="Chapter Relic (IF): The Banner of Staganda" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e067-cc56-f853-96c2-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="2645-9acd-3b83-3280-02c2e" name="Chapter Relic (IF): The Banner of Staganda" publicationId="7ab0-ceb9-pubN65665" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has the Counter-Attack and Crusader special rules. In addition, friendly units with 12" of the bearer, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
