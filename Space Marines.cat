    <profile id="20b1-50bc-0ebf-dbac-02c2e" name="Armourium Cherub" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One use only.  One model in a unit equipped with an armorium cherub can re-roll all failed To Hit rolls in one Shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile id="8b0e-5fbf-a080-2cd4-02c2e" name="Helical Targeting Array" publicationId="7ab0-ceb9-pubN170041" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the Contemptor-Mortis remains stationary in the Movement phase, it gains the Skyfire and Interceptor special rules for that turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="de00-6118-2843-0d85-02c2e" name="Armoured Ceramite" publicationId="7ab0-ceb9-pubN170041" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Melta weapons do not roll an extra D6 armour penetration when shooting a vehicle equipped with armoured ceramite.</characteristic>
      </characteristics>
    </profile>
    <profile id="7320-3dec-26ec-618a-02c2e" name="Warlord Trait: Storm of Fire" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each of your Shooting phases, nominate on friendly unit within 12" of your Warlord that is drawn from the same Chapter as your Warlord.  That unit's ranged weapons have the Rending special rule until the end of the phase.</characteristic>
      </characteristics>
    </profile>
    <profile id="87f6-4c43-800a-9440-02c2e" name="Warlord Trait: Rites of War" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All models in your Warlord's Detachment can use his Leadership value in place of their own.</characteristic>
      </characteristics>
    </profile>
    <profile id="2c97-2290-20db-4a3e-02c2e" name="Void Shield" publicationId="7ab0-ceb9-pubN209783" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each hit scored against a Titan will instead hit a void shield (whilst at least one remains active).  Close combat attacks come from inside the shield and therefore are not stopped.  Void shields have an Armour Value of 12.  A Glancing hit or Penetrating hit (or any hit from a Destroyer Weapon) scored against a void shield causes it to collapse.  After all void shields have collapsed, further hits strike the Titan instead.  At the end of each of the Titan's turns, roll a D6 for each collapsed void shield.  Each roll of 5+ instantly restores one collapsed shield.</characteristic>
      </characteristics>
    </profile>
    <profile id="d4c0-9a45-5e62-0565-02c2e" name="Initiate" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry</characteristic>
        <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic>
        <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
        <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
        <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
        <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic>
        <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic>
        <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
        <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic>
      </characteristics>
    </profile>
    <profile id="32f2-8965-df9f-0e0f-02c2e" name="Tartaros Terminator Armour" publicationId="7ab0-ceb9-pubN227548" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model in Tartaros Terminator Armour has the Deep Strike, Relentless and Bulky special rules and a 5+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
