      </characteristics>
    </profile>
    <profile id="5b81-4e93-c365-f3a1-800b0" name="The Panoply of the Crusader" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv. The model and any unit they have joined gains the Stubborn and Preferred Enemy (Chaos Space Marines) special rules.</characteristic>
      </characteristics>
    </profile>
    <profile id="daf6edf3-d92b-3fb4-5a39-6cc500119f08-800b0" name="The Primarch's Wrath" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Salvo 3/5, Shred, Master-crafted</characteristic>
      </characteristics>
    </profile>
    <profile id="7c9b-9eca-824e-d371-800b0" name="The Raven Helm" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Non-vehicle units that target Shadow Captain Solaq or his unit with a shooting attack must first pass a Ld test. If this test is failed, that unit can onlf fire Snap Shots for the rest of the turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="f5a6-7ad4-aaa3-ccd1-800b0" name="The Raven Skull of Korvaad" page="166" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">+1WS and +1LD. if the model is removed as a casualty, note its last position. For the rest of the battle, friendly Raven Guard models have Hatred and Rage while they are within 6" of this position.</characteristic>
      </characteristics>
    </profile>
    <profile id="bf65ce4d-eeb1-4f3e-9fdc-c937a8bcf962-800b0" name="The Raven's Talons" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
