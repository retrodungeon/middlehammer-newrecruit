        <profile id="d570-0418-3ff7-8538-02c2e" name="Chapter Relic (SAL): Nocturne's Fury (Details)" publicationId="7ab0-ceb9-pubN65665" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Nocturne's Fury is a flamer weapon for the purposes of any special rules that interact with flamer weapons.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="46e9-aaf3-de5e-1bd0-02c2e" name="" hidden="false" targetId="5039-18f0-a9ed-0938" type="rule" />
