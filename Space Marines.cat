    <selectionEntry name="Hyperious Air Defence Battery (IA)" id="fde5-3ce5-0c7a-820c" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="185c-cf39-577d-213e" hidden="false" primary="true" targetId="9260-7d57-be5c-bd52" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Battery" id="21e9-0efc-b045-a446" hidden="false">
          <description>The platforms do not need to be deployed together, although each Hyperios platform must be less than 36" from the command platform.</description>
        </rule>
        <rule name="Firing Mode" id="82d8-3330-5084-1855" hidden="false">
          <description>The battery is always set to Air Defense mode. When an incoming aircraft is detected the control console selects the nearest platforms and relays the targetting information. The Hyperios then activates, spins, tracks, and fires.</description>
        </rule>
        <rule name="Victory Points" id="a737-6d17-43a4-9439" hidden="false">
          <description>The Air Defense Battery cannot claim to occupy table quarters or objectives.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Command Platform" id="64ec-afc8-48cc-9f2c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e9cb-6215-e57e-9fb5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
            <constraint id="21da-2a32-b853-9f02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
          <infoLinks>
            <infoLink name="Weapon Plaform" id="eb6f-0016-9ea5-0a59" hidden="false" targetId="a6bb-7a68-e3e4-d388" type="profile">
              <modifiers>
                <modifier field="b109-f88e-dcc7-8a24" type="set" value="2" />
              </modifiers>
            </infoLink>
            <infoLink name="Immobile" id="d1ee-03ae-b6fc-fdae" hidden="false" targetId="de3d-c21c-3d4f-5259" type="rule" />
          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Hyperios Platform" id="74f8-241c-210b-ed40" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a268-ea8e-5594-0b78" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="4" />
            <constraint id="81e3-30ac-e4fc-6ffc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" />
          </costs>
          <infoLinks>
            <infoLink name="Weapon Plaform" id="90dc-dabb-5d4d-743c" hidden="false" targetId="a6bb-7a68-e3e4-d388" type="profile">
              <modifiers>
                <modifier field="b109-f88e-dcc7-8a24" type="set" value="2" />
              </modifiers>
            </infoLink>
            <infoLink name="Immobile" id="56b9-ca13-b250-113f" hidden="false" targetId="de3d-c21c-3d4f-5259" type="rule" />
            <infoLink name="Hyperios Ant-Aircraft Missiles" id="d9c9-e427-7cdc-637a" hidden="false" targetId="beb4-876e-921a-2c8f" type="profile" />
          </infoLinks>
          <rules>
            <rule name="Anti Air" id="debe-94ce-59cc-73ee" hidden="false">
              <description>May fire at aircraft using normal BS</description>
            </rule>
            <rule name="Targeting" id="e455-32f8-4894-55bf" hidden="false">
              <description>A Hyperious platform will fire a single missile in its own Shooting phase at any enemy aircraft whose flight path takes it within 36" of a platform. If the aircraft's flight path takes it within 36" of multiple platforms then each plaform will fire a single missile.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Veteran Sergeant Naaman" id="fe78-3d4d-5e3b-9e66" collective="false" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Dark Angel" id="800f-e4d6-c6b9-b727" hidden="false" primary="false" targetId="a0a1-0673-b637-2cc4" />
      </categoryLinks>
      <constraints>
