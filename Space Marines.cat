      <selectionEntries>
        <selectionEntry id="1e49-40c6-0fc1-4aee-02c2e" name="Explorator Augury Web" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9a92-ae01-3d35-c6f9-02c2e" type="max" />
          </constraints>
          <profiles>
            <profile id="1983-4c94-8f86-9529-02c2e" name="Explorator Augury Web" publicationId="7ab0-ceb9-pubN192504" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a Proteus with this upgrade is on the table, at the start of any of the controlling player's turns, before any Reserve rolls ar emoade, they may declare that the PRoteus' auguries are being used in Disruption or Relay modes, their effect lasting until their next player turn.  If a Land Raider Proteus is fitted with an Explorator Augury Web, its transport capacity is reduced to eight models.  Distruption Mode: The opposing force sufers -1 to their Reserve Rolls in the next player turn.  Relay Mode: The controlling player's Reserve rolls may be re-rolled (Whether failed or successful) if they wish.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4b52-c5d5-a229-8ec6-02c2e" name="" hidden="false" targetId="1794-e0e0-bedf-e46b" type="rule" />
          </infoLinks>
          <costs>
