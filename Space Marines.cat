    <selectionEntry name="Chief Librarian Tigurius" id="73ee-183f-e238-b00f" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="230" />
      </costs>
      <infoLinks>
        <infoLink name="And They Shall Know No Fear" id="44a6-6141-02f6-a546" hidden="false" targetId="73f8-658e-9da5-beba" type="rule" />
        <infoLink name="Combat Tactics" id="a57d-b5b6-fd97-6056" hidden="false" targetId="63e6-2a1c-88a5-4120" type="rule" />
