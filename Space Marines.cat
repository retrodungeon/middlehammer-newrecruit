        <infoLink id="5f4f-7129-aff3-702d-02c2e" name="" hidden="false" targetId="41fe-9e25-f4a8-095b" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25.0" />
      </costs>
    </selectionEntry>
