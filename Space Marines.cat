    <entryLink name="Brother-Sergeant Chronus" id="a8b5-02a8-0966-266a" hidden="false" import="true" targetId="3267-00fa-12ba-327e" type="selectionEntry">
      <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-470f-53ad-7c60-5bcd" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints>
