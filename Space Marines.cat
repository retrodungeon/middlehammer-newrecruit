                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
              </costs>
            </selectionEntry>
            <selectionEntry id="0de7-8a40-3b89-9e95-02c2e" name="Exorcists" hidden="false" collective="false" import="true" type="upgrade">
              <rules>
                <rule id="15e6-673d-0535-e3a0-02c2e" name="Chapter Tactics Undetermined" publicationId="7ab0-ceb9-pubN174565" hidden="false">
                  <description>The Unknown Founding should be depicted by a Chapter Tactic of the player's choosing from Codex: Space Marines.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="628f-015a-4a8a-de1e-02c2e" name="Adeptus Astartes" hidden="false" collective="false" import="true">
          <modifiers>
            <modifier type="set" field="c28a-d369-f350-4b7b-02c2e" value="1">
              <conditions>
