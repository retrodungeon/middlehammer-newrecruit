      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>A model can fire its grenade harness in addition to its combi-bolter. In addition, models in the wearer's unit do not suffer the penalty to their Initiative for charging enemies through difficult terrain, but fight at their normal Initiative in the ensuing combat.</description>
    </rule>
