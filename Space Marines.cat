    <entryLink name="Librarian" id="9979-23da-a3cb-5935" collective="false" hidden="false" import="true" targetId="5338-cafe-fa14-f5d7" type="selectionEntry">
      <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-8e3f-eab8-cfa1-f223" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks>
        <categoryLink name="Salamander" id="fcc3-b9d2-89c5-2fef" hidden="false" primary="false" targetId="3c77-1326-2bf2-1b97" />
      </categoryLinks>
      <infoLinks>
        <infoLink name="Salamander Special Rules" id="54f5-9243-29a9-abad" hidden="false" targetId="3565-50ac-4ca8-3c68" type="infoGroup" />
      </infoLinks>
      <rules>
        <rule name="Fury of the Salamander" id="b315-f0de-5662-ff25" hidden="false">
          <description>Use in the shooting phase instead of firing a weapon. Nominate a direction from the Librarian and draw a line 3D6" long in that direction. You cannot choose a line that might pass through a unit in close combat. Any model (friend or foe) which the line crosses over takes a Strength 5 hit; normal saving throws allowed. A unit suffering any casualties from this attack must take an immediate Morale check or fall back. If the unit passes, but loses 25% or more of its models in that Shoot phase, it must still take the Morale check for casualties as normal.</description>
        </rule>
      </rules>
    </entryLink>
