        <selectionEntry id="2af8-822f-2b50-43e4-02c2e" name="Power Capacitor" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ea34-9785-8272-6c35-02c2e" type="min" />
