        <profile name="Chapter Tactics" id="1a21-0f41-8e18-bb59" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If you include He'stan then all units in your army lose the Combat Tactics special rule. Instead, all thunder hammers in your army will count as master-crafted, and all flamers, heavy flamers, meltaguns and multimeltas count as twim-linked. If more than one character in your army has the Chapter Tactics special rule, you must choose which version will apply.</characteristic>
          </characteristics>
        </profile>
        <profile name="Kesare's Mantle" id="00aa-0f95-860d-db08" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">This wargear grants the bearer a 3+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gauntlet of the Forge" id="abc1-a6b0-36e2-53a7" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
