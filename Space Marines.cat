    <selectionEntry id="b9fb-fe5e-fa95-3411-02c2e" name="Chapter Relic (WS): The Hunter's Eye" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="acfa-b6db-7a35-9d40-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="f329-aae6-e151-3c6c-02c2e" name="Chapter Relic (WS): The Hunter's Eye" publicationId="7ab0-ceb9-pubN65665" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with the Hunter's Eye adds one to his Ballistic Skill and all his ranged weapons have the Ignores Cover special rule.  Whilst a model equipped with the Hunter's Eye is part of a unit, all other ranged weapons carried by models in that unit also have the Ignores Cover special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="5db8-b66f-0c5c-680c-02c2e" name="" hidden="false" targetId="52f9-9dcb-b6ed-0562" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="9b63-6d51-91ed-4ced-02c2e" name="Chapter Relic (WS): Mantle of the Stormseer" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b36b-cc14-a328-b883-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="eb3a-d736-6703-3587-02c2e" name="Chapter Relic (WS): Mantle of the Stormseer" publicationId="7ab0-ceb9-pubN65665" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with the Mantle of the Stormseer has the Adamantium Will special rule and knows the Psychic Maelstrom power from the Telekinesis discipline in addition to any others he knows.  This is not considered when determining if he has Psychic Focus.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="2489-2424-0949-a7ab-02c2e" name="" hidden="false" targetId="8714-46ad-62c0-ce35" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20.0" />
      </costs>
    </selectionEntry>
