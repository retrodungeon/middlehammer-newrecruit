              </entryLinks>
              <modifiers>
                <modifier field="ecab-bd00-bd02-ad53" type="set" value="0">
                  <conditions>
                    <condition childId="8f0b-efba-7e72-b45c" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
