cteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">117</characteristic></characteristics></profile><profile id="d5b75774-b7db-2042-9129-2c8a424054ab-6e9c41a" name="Chaplain Ortan Cassius" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="108"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">6</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">108</characteristic></characteristics></profile><profile id="9a77e0c2-1d22-fc80-675b-1e8cfe1fc5c7-6e9c41a" name="Chapter Banner" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="124"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly units within 12" of the bearer of the Chapter Banner, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests. In addition, all friendly Space Marines models in the same unit as this banner have +1 Attack whilst the bearer is alive.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="b5672079-703e-521c-e23e-c0790050f0cd-6e9c41a" name="Chapter Champion" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="89"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">89</characteristic></characteristics></profile><profile id="c1b1c1d6-c6ef-9cd4-a4c2-a6cacb88deb0-6e9c41a" name="Chapter Master" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="79"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">4</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">79</characteristic></characteristics></profile><profile id="f00134b3-deb6-13fb-4a5e-d0c19fc294e9-6e9c41a" name="Chief Librarian Varro Tigurius" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="107"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">107</characteristic></characteristics></profile><profile id="5e9b5043-670c-f03a-842e-21d8f0b49d28-6e9c41a" name="Cinder Edge" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="18"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master-crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">18</characteristic></characteristics></profile><profile id="b5a15a10-378a-f59e-80a7-090b5c95a19d-6e9c41a" name="Close Combat Weapon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="ab7788d0-91c6-9250-06b8-b07f82536675-6e9c41a" name="Cluster Mine" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="124"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After your army deploys, Scouts redeploy and lnfiltrators deploy, but before the roll  to Seize the Initiative, each unit with cluster mines in your army may booby-trap a single piece of area terrain on the table. The piece of area terrain should be marked with a small marker to remind both players that it has been booby-trapped. Enemy models treat booby-trapped pieces of area terrain as dangerous terrain. Note that having multiple units booby-trap the same piece of area terrain has no additional effect. A unit with cluster mines which begins the game in Reserve may still booby-trap a piece of area terrain.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="fed1624b-0543-fad6-1691-d239f3e09687-6e9c41a" name="Combat Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="124"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">6+ Invul Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="b9acf151-1b3a-6d61-fc07-074c4ed705f2-6e9c41a" name="Combi-Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Bolter may be fired every turn, secondary weapon may be fired once. (Combi-plasma does have Rapid Fire). Cannot fire both in same turn.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="a95ace0e-b272-e2f5-5bbf-6a0ceeef9705-6e9c41a" name="Command Vox Relay" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">May add or subtract 1 from all reserve rolls while on the table</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7d582d30-5d14-485b-3821-bfceb2b28ff9-6e9c41a" name="Commander Carab Culln, Captain" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Unique)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="b503b8d7-d738-95d6-cbe3-3e1431306f3b-6e9c41a" name="Company Champion" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="88"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">88</characteristic></characteristics></profile><profile id="717aa675-ebad-4a28-30c0-9244fca0ee1e-6e9c41a" name="Company Standard" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="124"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly units within 12" of the bearer, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></charac