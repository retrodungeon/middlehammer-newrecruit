    <selectionEntry id="1428-33fe-375e-05e8-02c2e" name="Formation: Firespear Strike Force" publicationId="7ab0-ceb9-pubN158037" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="30de-18cc-dc21-c622-02c2e" name="Sustained Fire" publicationId="7ab0-ceb9-pubN158049" hidden="false">
          <description>At the start of your Movement phase, pick one unit from the Firespear Strike Force that is within 12" of its Captain.  The unit that you pick can immediately shoot as though it were the Shooting phase, but it cannot then move (or charge) for the rest of the turn.  This unit can shoot again in the Shooting phase (but it cannot run).</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink id="a9da-f6e3-ce07-ac56-02c2e" name="" hidden="false" collective="false" import="true" targetId="5d06-fec0-cdb5-f771-02c2e" type="selectionEntry">
