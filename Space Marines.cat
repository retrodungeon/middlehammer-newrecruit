            <profile id="865c-593c-c9b0-6d89-02c2e" name="Hunger &amp; Slake (Details)" publicationId="7ab0-ceb9-pubN146351" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Tyberos may divide his attacks in any assault freely between the profiles of Hunger and Slake simultaneously. Note that the additional attack for these two weapons has already been included in Tyberos' profile.</characteristic>
              </characteristics>
            </profile>
          </profiles>
