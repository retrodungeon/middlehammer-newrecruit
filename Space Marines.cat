            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Walker)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="6192-e626-101c-a5df-02c2e" name="Helical Targeting Array" publicationId="7ab0-ceb9-pubN174565" hidden="false">
          <description>If the Deredeo chooses to neither move nor Run in its turn it may, if the controlling player wishes, gain the Skyfire and Interceptor special rules for that entire game turn (ie, both the controlling player's turn and their opponent's following player turn) for all of its weapons except its heavy bolters/heavy flamers.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="b483-bdb0-c282-cf72-02c2e" name="" hidden="false" targetId="ce80-9d54-555b-abf3-02c2e" type="profile" />
        <infoLink id="15d8-0f21-29c3-ae2c-02c2e" name="" hidden="false" targetId="7f7d-95e4-7ddd-7439-02c2e" type="rule" />
