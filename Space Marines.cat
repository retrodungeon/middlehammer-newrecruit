      <rules>
        <rule id="70d7-8bc8-4cfa-66c5-02c2e" name="Litany of Hate" publicationId="7ab0-ceb9-pubN179327" hidden="false">
          <description>Chaplain Dreadnought Titus has the Hatred special rule.</description>
        </rule>
        <rule id="47a7-87e8-69a2-9c8e-02c2e" name="Living Icon of the Chapter" publicationId="7ab0-ceb9-pubN179327" hidden="false">
          <description>Friendly Howling Griffons units from either Codex: Space Marines or the Space Marine Siege Assault Vanguard army list, and at least one model within 12" of Chaplain Dreadnought Titus gain the Fearless special rule.</description>
        </rule>
      </rules>
