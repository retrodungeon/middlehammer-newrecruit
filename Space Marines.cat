      <rules>
        <rule id="d202-9fe2-80dc-7ec2-02c2e" name="Heroic Intervention" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>A unit with this special rule can re-roll one or both dice when determining its charge range.  Furthermore, a unit with this special rule ignores the penalty for disordered charges.</description>
