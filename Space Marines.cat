        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any Space Marine on Kane's side within 12" of him can re-roll 1s when rolling to Wound in an Assault.</characteristic>
      </characteristics>
    </profile>
