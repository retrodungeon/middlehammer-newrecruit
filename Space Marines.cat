    <selectionEntry name="Deathwind Drop Pod (IA)" id="9470-3822-9925-43d2" collective="false" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="e5f5-3383-8a83-815d" hidden="false" primary="true" targetId="9260-7d57-be5c-bd52" />
