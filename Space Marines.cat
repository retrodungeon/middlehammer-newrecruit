      <profiles>
        <profile id="4e38-762b-b1e5-f751-02c2e" name="Hecaton Aiakos" publicationId="7ab0-ceb9-pubN211261" page="" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Walker">
          <characteristics>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
