    <selectionEntry id="ca3b-2944-6a4d-c608-02c2e" name="Company Standard" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="b085-5a26-09b5-9335-02c2e" name="Company Standard" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units within 12" of a model equipped with the company standard, and drawn from the same Chapter Tactics, re-roll failed Morale checks, Pinning tests and Fear tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="236e-afd3-34eb-369f-02c2e" name="Chapter Banner" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0a3b-ef08-4cbd-b008-02c2e" type="max" />
      </constraints>
      <profiles>
        <profile id="6b62-9a90-c1e0-7b10-02c2e" name="Chapter Banner" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units within 12" of a model equipped with the Chapter banner, and drawn from the same Chapter, re-roll failed Morale checks, Pinning tests, and Fear tests.  In addition, all friendly models with the same Space Marines Faction in the same unit as this banner have +1 Attack whilst the bearer is alive.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25.0" />
