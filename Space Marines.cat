tem" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Increase cover save by 1, if no cover grants a 6+ cover save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="43d8d9ec-8695-aa55-3250-4e13f05cec93-6e60653" name="Chainfist" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="60"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Specialist Weapon, Unwieldly, Armourbane</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">60</characteristic></characteristics></profile><profile id="0c19a0e9-8130-09dd-6826-32b2946a7d48-6e60653" name="Chainsword" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="0cd13f08-e554-9874-9bb6-a38cd5de4df1-6e60653" name="Cltuster Mines" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After your army deploys, Scouts redeploy and lnfiltrators deploy, but before the roll to Seize the Initiative, each unit with cluster mines in your army may boobytrap a single piece of area terrain on the table. The piece of area terrain should be marked with a small marker (a coin will do) to remind both players that it has been booby-trapped. Enemy models treat booby-trapped pieces of area terrain as dangerous terrain. Note that having multiple units booby-trap the same piece of area terrain has no additional effect. A unit with cluster mines which begins the game in Reserve may still booby-trap a piece of area terrain.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="2243a13b-e858-8550-b2a9-b310b8015ba2-6e60653" name="Combat Knife" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="a3362f8f-5224-0633-6a22-4d07c4b3b554-6e60653" name="Combat Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">6++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="f3bbe6fc-8a95-5407-17fc-4ddaa9ce62d8-6e60653" name="Combi Plasma" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characte