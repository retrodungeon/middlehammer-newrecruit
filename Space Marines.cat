323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">4+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">85</characteristic></characteristics></profile><profile id="812cac35-f9b4-a56e-d7d9-8c930c540606-6e9c41a" name="Searchlight" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Used when the Night Fighting rules are in effect. If a vehicle has a searchlight, it can, after firing all of its weapons, choose to illuminate its target with the searchlight. If it does so, it also illuminates itself. Illumination lasts until the end of the following turn. Illuminated units gain no benefit from the Night Fighting special rule.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="64f36cdf-e1f4-390f-8f84-0bf4f2420f07-6e9c41a" name="Seismic Hammer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="122"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive, Specialist Weapon, Unwieldy</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">122</characteristic></characteristics></profile><profile id="cf1fc149-2107-93ac-fa7a-a9b4fef226ea-6e9c41a" name="Sergeant Antaro Chronus" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Un