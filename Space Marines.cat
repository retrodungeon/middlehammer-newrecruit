      <rules>
        <rule id="ff0d-650e-2b0f-6894-02c2e" name="Suppressive Bombardment" publicationId="7ab0-ceb9-pubN65751" hidden="false">
          <description>Whilst this unit includes three Whirlwinds, each model's Whirlwind multiple missile launcher has the Pinning and Shred special rules (regardless of which missile type it fires).</description>
        </rule>
      </rules>
