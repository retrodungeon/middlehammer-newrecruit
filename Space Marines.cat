    <selectionEntry id="05ab-765f-1ba9-b0da-02c2e" name="Formation: Ravenhawk Assault Group" publicationId="7ab0-ceb9-pubN158942" page="68" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="5178-5c3b-5a11-07b4-02c2e" name="Targeted Strike" publicationId="7ab0-ceb9-pubN65665" hidden="false">
          <description>When the first unit from this Formation is deployed or arrives from Reserve, nominate a unit in the enemy army to be the Assault Group's starget.  Units from this Formation re-roll failed To Hit rolls against that unit for the duration of the battle.</description>
        </rule>
        <rule id="73dc-3501-5c31-be0e-02c2e" name="Vertical Insertion" publicationId="7ab0-ceb9-pubN65665" hidden="false">
          <description>The Stormraven Gunship from this Formation has the Deep Strike special rule.  If it arrives from Deep Strike, it must Hover on the turn it arrives.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="7def-3509-ba9b-608c-02c2e" name="Dreadnought" hidden="false" collective="false" import="true" defaultSelectionEntryId="a16d-7e4b-2361-4271-02c2e">
