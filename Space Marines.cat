        <profile id="986d-fd60-2a76-6992-02c2e" name="Chapter Relic: Armour of Faith" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Armour of Faith confers a 2+ Armour Save and a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile id="0406-2e2f-df0d-b90c-02c2e" name="The Emperor's Champion" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
