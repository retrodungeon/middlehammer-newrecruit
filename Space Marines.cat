    <profile id="10552e74-4868-c717-bb89-27480edd9858-800b0" name="The Armour Indomitus" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 6+ Invul Sv. Once per game, at the beginning of any phase, the wearer can choose to temporarily push the armour's force field to its limit. For the duration of that phase, it confers a 2+ Invul Sv.</characteristic>
      </characteristics>
    </profile>
    <profile id="3c86-94cb-1598-fc84-800b0" name="The Armour of Shadows" page="166" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv. Model gains Stealth, or Shrouded if it did not Move, Run or Charge in the previous turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="d32cf74b-bc68-b5e4-f040-be95d2f21489-800b0" name="The Axe of Medusa" page="89" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
