      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Count Crew Stunned results as Crew Shaken instead.</characteristic>
      </characteristics>
    </profile>
