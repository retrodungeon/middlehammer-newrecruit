        <profile id="9c98-01ec-5884-0182-02c2e" name="Chapter Relic: The Shield Eternal" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Shield Eternal is a storm shield.  In addition, the bearer of the Shield Eternal gains the Adamantium Will and Eternal Warrior special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
