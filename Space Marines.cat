          </constraints>
          <profiles>
            <profile id="a9f3-a45b-b92a-3378-02c2e" name="Power Capacitor" publicationId="7ab0-ceb9-pubN174565" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the Vindicator Tank Destroyer has not moved this turn, the Laser Destroyer Array becomes an Ordnance 2, Twin-Linked weapon.  The owning player may declare an overcharged volly if the vehicle has nor moved this turn, in which case the Laser Destroyer Array becomes Ordnance 3, Twin-Linked.  However, after the weapon is fired in this mode, roll a D6.  On a roll of a 1, the Vindicator suffers a single Hull Point of damage.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="9aa7-3f0a-8fe0-a84e-02c2e" name="Siege Shield" hidden="false" collective="false" import="true" type="upgrade">
