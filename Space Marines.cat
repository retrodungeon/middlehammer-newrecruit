              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="45a7-a086-7339-c739" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="1" />
                    <condition childId="4d79-06bc-7daf-0aa0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="1" />
                    <condition childId="6c91-d214-036a-50a2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="1" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="8f0b-3e54-c10f-0a71" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Horsetail Talismans" id="345d-536b-15c7-a831" hidden="false">
              <description>This Holy Relic can be revealed in each and every White Scars' Movement Phase during which the bearer has moved and is no longer in a vehicle. Any unit of White Scares infantry or bikes that have at least one model within 6" of the bearer when it is revealed may move an extra D6" rather than firing in the following Shooting phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Grimoire Pandaemonica" id="951c-b07e-c2ee-33c4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="591e-f5ac-6897-28d4" field="selections" includeChildSelections="true" scope="force" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" />
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="71f1-cbf9-c4ed-47ac" childName="Relictor" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Grimoire Pandaemonica" id="f6d3-4170-c27c-ce89" hidden="false">
              <description>The bearer of the Grimoiro Pandaemonica may force his opponent to reroll a single Daemonic Possession or a single Daemonic Summoning roll each game turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Shard of the Monolith" id="e941-ce74-8a5a-3e97" hidden="false" import="true" type="upgrade">
