      <rules>
        <rule name="Vulkan's Sigil" id="eb55-dd8c-042f-b039" hidden="false">
          <description>Counts as a holy relic. It affects all Salamanders within 12" when it is revealed, instead of the normal 2D6".</description>
        </rule>
        <rule name="Salamanders Mantal" id="e597-ab89-12f5-c563" hidden="false">
          <description>Xavier is immune to suffering instant death by being hit by an attach which has a Strength value double his Toughness. He loses a single wound instead. Note that instant death can be suffered in other ways.</description>
        </rule>
      </rules>
    </selectionEntry>
