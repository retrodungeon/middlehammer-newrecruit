    <profile id="1f65-a047-1140-8c34-02c2e" name="Whirlwind Missile Launcher (Details)" publicationId="7ab0-ceb9-pubN65751" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
