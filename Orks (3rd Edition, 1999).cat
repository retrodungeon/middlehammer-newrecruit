            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5d32-356b-73c7-12b5" type="max" />
          </constraints>
          <rules>
            <rule id="1d8a-96fa-7928-884a" name="Stikkbomb Chucka" hidden="false">
              <description>A stikkbomb chukka allows a Mega Armoured Ork use frag stikkbombz so they can benefit from the frag grenades rule, but in order to do so they must attack with their base strength instead of using the Power Claw.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="1" />
          </costs>
        </selectionEntry>
        <selectionEntry id="ed97-2751-5a39-7b1d" name="Super Stikkbombz" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fdd0-6bc8-710f-4b77" type="notInstanceOf" />
