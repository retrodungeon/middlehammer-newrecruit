              </conditionGroups>
            </modifier>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
