        <selectionEntry id="f287-48d3-2273-0079" name="Stikkbomb Chucka" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1518-7a1b-daac-0172" type="notEqualTo" />
              </conditions>
