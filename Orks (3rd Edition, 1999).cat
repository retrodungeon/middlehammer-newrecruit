        <selectionEntry id="c3be-a758-856d-132f" name="Krusher (IA)" hidden="false" collective="false" import="true" type="upgrade" sortIndex="4">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e3a6-0077-1959-88e9" type="max" />
          </constraints>
          <rules>
            <rule id="6993-e3cb-2b06-a0d7" name="Krusher (IA)" hidden="false">
              <description>If the Battlewagon makes a Tank Shock attack on an enemy unit and the enemy don't fall back, then roll a D6 for each model forced to move out of the way of the vehicle. On a 4+ they are caught and crushed, and suffer a wound with normal armour saves allowed.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
        </selectionEntry>
      </selectionEntries>
