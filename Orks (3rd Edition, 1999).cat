          </constraints>
          <rules>
            <rule id="3226-941b-8308-0566" name="Mega Armor" hidden="false">
              <description>An Ork in Mega Armor gains a 2+ armor save and is armed with a shoota and power claw for free. However, an Ork in mega armor always moves as if in difficult terrain.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="1d10-4a50-92d9-413c" name="Shoota" hidden="false" targetId="894f-1760-04e4-77c4" type="profile" />
