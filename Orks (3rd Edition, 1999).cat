    <selectionEntry id="66b8-0644-f61f-4b12" name="Mad Dok Grotsnik" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="c792-e5b8-3503-cc66" name="Mad!" hidden="false">
          <description>Nutso, two slices short of a loaf, not playing with a full deck of Grot teeth - you get the picture! Because of this Grotsnik is completely immune to the effects of moral and pinning. During the Ork turn Grotsnik will always move straight towards the nearest enemy and assault if he is within range.</description>
        </rule>
        <rule id="1ebd-21cf-43b9-9925" name="Bad Influence" hidden="false">
          <description>If Grotsnik is part of a mob his crazed enthusiasm for mayhem infects the Boyz as well. Not only do they become immune to the effects of moral and pinning but they also move straight towards the nearest enemy unit and assault if it they can - they follow their Mad Dock in his headlong charge to glory!</description>
        </rule>
        <rule id="893a-b03c-6449-f0a1" name="More Machine than Ork" hidden="false">
          <description>The extensive rebuilding Mad Dock Grotsnik has undertaken increases his Toughness characteristic by 1.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="1842-1d7b-01ef-be83" name="Mad Dok Grotsnik" hidden="false" targetId="c017-ef4b-d0bf-9f22" type="profile" />
        <infoLink id="aef9-b72e-1120-cc82" name="Power Claw" hidden="false" targetId="ff9c-5b94-680f-36d5" type="profile" />
        <infoLink id="3aba-034c-6c29-049c" name="Slugga" hidden="false" targetId="1aaa-4805-c346-107e" type="profile" />
        <infoLink id="a65f-c6bb-8ed7-2b70" name="Independent Character" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
        <infoLink id="5a47-2742-50a0-db1d" name="Ork Mob Rule!" hidden="false" targetId="1586-dbe5-3b2e-7590" type="rule" />
        <infoLink id="6c83-973e-2582-8097" name="The Power of the WAAAGH!" hidden="false" targetId="7bb4-34ca-51f3-bb8c" type="rule" />
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="9340-ecde-23b6-485b" name="'eavy Armor" hidden="false" collective="false" import="true" type="upgrade" sortIndex="5">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3169-6a05-0ed0-f7ef" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1091-2004-ea45-e3d8" type="min" />
