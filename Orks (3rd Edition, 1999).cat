    <selectionEntry id="e2e8-e321-6af7-930b" name="Battle Fortress (IA)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        </modifiers>
      <rules>
        <rule id="5718-1065-8748-b598" name="Lumbering" hidden="false">
          <description>Can move up to 6" per turn and it must always move straight ahead. It can pivot up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="6bc0-ad77-3274-ae9c" name="Difficult Terrain" hidden="false">
          <description>The vehicle ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal. However, if they roll a 1 they are not immobilised, but instead lose D3" of movement.</description>
        </rule>
        <rule id="4918-d737-8658-b939" name="Targeting" hidden="false">
          <description>Instead of picking one target, pick a target for each of its weapons</description>
        </rule>
        <rule id="7e7f-2828-a657-c2e8" name="Tank Shock" hidden="false">
          <description>Enemy infantry test at -1 to their Leadership if they are Tank Shocked by a Battle Fortress</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2410-e412-b415-844f" name="Battle Fortress" hidden="false" targetId="9388-8c78-ce61-689c" type="profile" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="7390-7e76-6d15-df61" name="Super-Heavy" hidden="false" targetId="5968-f35e-18fd-612b" primary="true" />
