          <rules>
            <rule id="c8f3-91f0-a6d4-7a26" name="Mekboy's Tools" hidden="false">
              <description>A Mekboy equipped with Mekboy's Tools can attempt to repair a vehicle which has suffered an "Immobilised" or "Weapon Destroyed" damage result, or to fix a Big Gun that has been destroyed. If the Mekboy is in base-to-base contact with the vehicle or Big Gun at the end of his movement phase roll a D6. On a 1 the repair fails and the vehicle or Big Gun may not be repaired for the rest of the game. On a 2-5 the Mekboy fails the repair. On a 6 the repair succeeds and the Vehicle's weapon is fixed, or it is no longer immobilized, or a Big Gun is fixed.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="2" />
          </costs>
        </selectionEntry>
        <selectionEntry id="c7c7-636c-43d6-6278" name="Squighound" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
