    <selectionEntry id="63f3-37b6-de94-f5f6" name="Warlord Ghazghkull Mag Uruk Thraka" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="2e1b-ac13-ab83-4b7e" name="Powr of the WAAAGH!" hidden="false">
          <description>Once, during a battle, Ghazghkull can unleash the power of the waaagh!. This can be summoned at any time including during an opponent's turn. For the remainder of that player's turn and all of the following player's turn Ghazghkull gains a 2+ Invulnerable save. In addition, for the duration of the Waaagh! all Orks pass their Leadership tests and Morale checks automatically and recover from pinning immediately. Orks fighting in close combat double their Initiative just as if they had charged and passed a mob size check this turn.</description>
        </rule>
        <rule id="7c63-ca59-8837-aae0" name="Goff Army" hidden="false">
          <description>Ghazghkull is a member of the Goff clan and his army is shaped by his prejudices. An army including Ghazghkull must have at least one mob of Skarboyz but may not include more than one unit of each of the following: Kommandos, Burna Boyz, Warbuggies, Warbikes, Big Gunz, Lootas and Looted Vehicles.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2c3e-aa74-a803-8941" name="Warlord Ghazghkull Mad Uruk Thraka" hidden="false" targetId="5f06-0630-177e-74ab" type="profile" />
        <infoLink id="b3ac-f7e5-133b-30b6" name="Independent Character" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
        <infoLink id="7cf6-7881-9774-8e73" name="Ork Mob Rule!" hidden="false" targetId="1586-dbe5-3b2e-7590" type="rule" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="9997-c8a8-c91b-7460" name="Independent Character" hidden="false" targetId="3c96-248b-affd-e504" primary="false" />
        <categoryLink id="9820-2964-c075-ea2f" name="Infantry" hidden="false" targetId="6953-6bba-0bb9-d49d" primary="false" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="8878-0609-fd65-00ff" name="Iron Gob" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ca40-75a1-e945-b145" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3a0f-a374-0430-c885" type="min" />
          </constraints>
          <rules>
            <rule id="237e-c8ff-7f0d-51b9" name="Iron Gob" hidden="false">
              <description>A mob led by a Warboss or Nob with an Iron Gob add +1 to their Leadership value.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="346f-4990-8613-690c" name="Bosspole" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="69ff-f2f9-4261-565d" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3c6a-029e-f216-3efc" type="min" />
          </constraints>
          <rules>
            <rule id="9af3-4610-f2de-20f5" name="Bosspole" hidden="false">
              <description>An Ork mob trying to mob up with a mob carrying a bosspole may re-roll their Leadership test if they fail on the first try.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="7bdf-3ccd-6ee6-121d" name="Mega Armor" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="717b-961a-e21a-ad3d" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3d41-6451-1abf-fd42" type="min" />
          </constraints>
          <rules>
            <rule id="e9bf-6edc-cd76-09f6" name="Mega Armor" hidden="false">
              <description>An Ork in Mega Armor gains a 2+ armor save and is armed with a shoota and power claw for free. However, an Ork in mega armor always moves as if in difficult terrain.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="dfdd-bfec-642c-4065" name="Mega Boosta" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dc02-a691-7c4d-0481" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7a36-b571-a83f-5cca" type="min" />
          </constraints>
          <rules>
            <rule id="db5f-f5f1-abf0-39a4" name="Mega Boosta" hidden="false">
              <description>An Ork with Mega Boostas rerolls the dice to determine the distance they move when they are wearing Mega Armor. If a unit of Orks in Mega Armor includes some with Mega Boosters and some without, only the ones with Mega Boosters will gain the benefit of the re-roll while the others move the original distance rolled.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="700f-04b9-5c4a-6809" name="Stickbomb Chucka" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7249-7776-a874-6146" type="min" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e095-89c5-b9f5-8daa" type="max" />
          </constraints>
          <rules>
            <rule id="effb-fcc4-09e5-677d" name="Stikkbomb Chucka" hidden="false">
              <description>A stikkbomb chukka allows a Mega Armoured Ork use frag stikkbombz so they can benefit from the frag grenades rule, but in order to do so they must attack with their base strength instead of using the Power Claw.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="a956-f0a3-0b51-69ef" name="Adamantium Skull" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1c59-c7be-c2e5-3028" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8809-bdd7-9be7-4f02" type="min" />
          </constraints>
          <rules>
            <rule id="3942-d175-d6c5-13fb" name="Adamantium Skull" hidden="false">
              <description>The adamantium skull plate adds +1 Toughness. When Ghazghkull charges into combat he gets an extra free head butt attack against one model in base-to-base contact with him. The head butt is resolved as an attack made with an Initiative of 4, roll to hit as normal for a close combat blow and if a hit is scored roll to wound with Ghazghkull's Strength of 5. A model that suffers a wound from the head butt is stunned for the rest of the turn and may not attack in close combat.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="2b95-aa9c-7805-ae44" name="Kustom Shoota" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="de18-9a77-8445-6fe4" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="090f-b92e-ff54-d9b7" type="min" />
          </constraints>
          <profiles>
            <profile id="f9d4-b616-beab-3776" name="Kustom Shoota" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24"</characteristic>
                <characteristic name="S" typeId="24d8-2110-08fa-d844">5</characteristic>
                <characteristic name="AP" typeId="25ce-028f-0aae-2855">6</characteristic>
                <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 2</characteristic>
                <characteristic name="Abilities" typeId="492d-1f80-b777-26f2" />
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <entryLinks>
        <entryLink id="fd14-ee4c-94e4-dd27" name="Warboss's Bodyguard" hidden="false" collective="false" import="true" targetId="3ece-9eb9-c164-cf78" type="selectionEntryGroup" />
      </entryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="226" />
      </costs>
    </selectionEntry>
    <selectionEntry id="a9e0-22b3-d3be-c67a" name="Warlord Nazdreg Ug Urdgrub" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="1431-6826-fe5e-7f4f" name="Kunnin' Plans" hidden="false">
          <description>One Elites or Troops mob in Nazdreg's army can use either the Infiltrators or Deep Strike rules. If the option to Deep Strike is chosen, this may be used regardless of whether the scenario normally uses these rules. The mob chosen must be on foot and may not number more than twenty models.</description>
        </rule>
        <rule id="a146-e78d-3e2b-d2bd" name="Bad Moon Army" hidden="false">
          <description>Nazdreg is a member of the Bad Moon clan and his well equipped army will reflect this. If Nazdreg leads an army it may include up to one extra Heavy Support unit over and above the number shown on the force organisation chart. It may not include more than one unit of each of the following: Skarboyz, Stormboyz, Kommandos, Slugga Boyz, Stikk Bommas.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="b5c0-8a82-5385-5d44" name="Warlord Nazdreg Ug Urdgrub" hidden="false" targetId="7b32-495d-dcec-aa93" type="profile" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="7808-8bf7-c7f3-3321" name="Independent Character" hidden="false" targetId="3c96-248b-affd-e504" primary="false" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="f720-f1cc-2f71-2274" name="Bosspole" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="add7-0453-14c2-f6a2" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6fab-2e7e-2653-a099" type="min" />
          </constraints>
          <rules>
            <rule id="84bf-03d8-c0b0-701b" name="Bosspole" hidden="false">
              <description>An Ork mob trying to mob up with a mob carrying a bosspole may re-roll their Leadership test if they fail on the first try.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="a731-3b5c-c792-b250" name="Mega Armor" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="28be-d630-1bb6-d05c" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="63af-ec86-7e4b-e68d" type="min" />
          </constraints>
          <rules>
            <rule id="8f3c-084b-2817-e9da" name="Mega Armor" hidden="false">
              <description>An Ork in Mega Armor gains a 2+ armor save and is armed with a shoota and power claw for free. However, an Ork in mega armor always moves as if in difficult terrain.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="8d5c-4291-b294-f422" name="Mega Boosta" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="690f-93fe-786b-5652" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3249-408e-6440-4f4f" type="min" />
          </constraints>
          <rules>
            <rule id="4225-d9d0-04a8-486c" name="Mega Boosta" hidden="false">
              <description>An Ork with Mega Boostas rerolls the dice to determine the distance they move when they are wearing Mega Armor. If a unit of Orks in Mega Armor includes some with Mega Boosters and some without, only the ones with Mega Boosters will gain the benefit of the re-roll while the others move the original distance rolled.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="4208-3f24-65b2-3570" name="Stickbomb Chucka" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="07c2-b079-3887-e92a" type="min" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f8d4-4dfb-f774-4c30" type="max" />
          </constraints>
          <rules>
            <rule id="d8db-73e4-17d2-2152" name="Stikkbomb Chucka" hidden="false">
              <description>A stikkbomb chukka allows a Mega Armoured Ork use frag stikkbombz so they can benefit from the frag grenades rule, but in order to do so they must attack with their base strength instead of using the Power Claw.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="d7bb-b8bd-f4e7-7b25" name="Kustom Blast X" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4f6e-990d-edc2-0b01" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fad9-a8e4-636b-3df5" type="min" />
          </constraints>
          <profiles>
