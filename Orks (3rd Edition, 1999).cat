            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2ead-7ef4-ba55-911c" type="max" />
          </constraints>
          <rules>
            <rule id="6e08-037b-1ce2-ff5a" name="Indirect Fire" hidden="false">
              <description>May fire the earthshaker in Indirect File mode instead of direct fire. A weapon that does so changes its range to G36"-240".</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" />
          </costs>
        </selectionEntry>
