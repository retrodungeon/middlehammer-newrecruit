          <rules>
            <rule id="a435-9184-3b1f-16ef" name="Bosspole" hidden="false">
              <description>An Ork mob trying to mob up with a mob carrying a bosspole may re-roll their Leadership test if they fail on the first try.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="3" />
          </costs>
        </selectionEntry>
        <selectionEntry id="8af0-0343-cccb-8c71" name="Cybork Body" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
            </modifier>
          </modifiers>
