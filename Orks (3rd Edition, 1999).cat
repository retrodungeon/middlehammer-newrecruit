        <selectionEntry id="72f2-3d0e-384a-dd84" name="Ammo Runt" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
