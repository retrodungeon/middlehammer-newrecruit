            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="1" />
          </costs>
        </selectionEntry>
        <selectionEntry id="415b-103e-6bf1-7e9e" name="'Urty Syringe" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="011a-8595-ccba-4e6e" type="notInstanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ec58-4077-cd77-559c" type="notInstanceOf" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dd53-e52e-01df-f375" type="max" />
          </constraints>
          <rules>
            <rule id="7ca3-7c2d-8ba8-86aa" name="'Urty Syringe" hidden="false">
              <description>A Mad Dok (or Painboss) armed with a 'urty syringe always wounds on a 4+ regardless of the victim's Toughness. 'Urty syringes have no effect on vehicles, Tyranids, Daemons, Eldar Wraithguard or the Eldar Avatar.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="7cd8-4c00-4781-f12d" name="Two-Handed Weapons" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="be5f-7d1c-3cc2-26da" type="max" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="084e-87e9-cf47-b4f7" name="Big Shoota" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true" childId="1518-7a1b-daac-0172" type="equalTo" />
