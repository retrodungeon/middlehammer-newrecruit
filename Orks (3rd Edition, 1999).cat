            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="41ea-4c02-8e0f-1322" type="max" />
          </constraints>
          <rules>
            <rule id="d7b7-0ea4-ebd7-070c" name="Super Stikkbombz" hidden="false">
              <description>Super Stikkbombz work just like krak stikkbombz but have a armor penetration roll of 10+2D6. On a roll of double ones the attack is resolved like normal but the Mekboy using them sufffers a wound that may attempt to be saved as normal.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
        <selectionEntry id="5eff-36fe-24fc-062e" name="Tankbusta Bombz" hidden="false" collective="false" import="true" type="upgrade">
