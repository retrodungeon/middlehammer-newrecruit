          </constraints>
          <rules>
            <rule id="a129-6628-13eb-787a" name="Cybork Body" hidden="false">
              <description>An Ork with a Cybork Body has a 5+ Invulnerable Saving Throw.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="f015-912c-5b7f-c769" name="Invulnerable Saving Throw" hidden="false" targetId="97b3-810d-a09e-872b" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
        </selectionEntry>
        <selectionEntry id="9131-d3f0-ac51-1b1e" name="Dok's Tools" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="011a-8595-ccba-4e6e" type="notInstanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ec58-4077-cd77-559c" type="notInstanceOf" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
