          </constraints>
          <rules>
            <rule id="b416-6203-cf33-c230" name="Bolt-on Big Shootas" hidden="false">
              <description>These weapons must be fired by the Ork mob onboard.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="1f4d-7cd0-5f63-e1d1" name="Big Shoota" hidden="false" targetId="b467-e518-11c9-c23a" type="profile">
              <modifiers>
                <modifier type="set" field="name" value="Bolt-on Big Shoota" />
              </modifiers>
