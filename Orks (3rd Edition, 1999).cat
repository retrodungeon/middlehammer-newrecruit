        <selectionEntry id="18ce-1821-0982-20b3" name="Waaagh! Banner" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
