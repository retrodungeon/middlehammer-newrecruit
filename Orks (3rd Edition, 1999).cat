          <rules>
            <rule id="a175-0086-1b2a-078f" name="Tankbusta Bombz" hidden="false">
              <description>Tankbusta Bombz are used like krak stikkbombz to attack vehicles and bunkers, however Tankbusta Bombz have an armor penetration roll of 6+(D6x2).</description>
            </rule>
          </rules>
          <costs>
