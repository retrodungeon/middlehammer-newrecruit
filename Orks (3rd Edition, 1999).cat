            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="12" />
          </costs>
        </selectionEntry>
        <selectionEntry id="3be8-9837-0799-ad8a" name="Burna" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
