          <profiles>
            <profile id="250d-fa32-4361-5d57" name="Ammo Runt" hidden="false" typeId="1e16-2bd8-7cad-379b" typeName="Unit">
              <characteristics>
                <characteristic name="WS" typeId="c704-6128-f143-935a">2</characteristic>
                <characteristic name="BS" typeId="7928-3a9b-6080-ed95">2</characteristic>
                <characteristic name="S" typeId="df03-6292-d3f5-f778">2</characteristic>
                <characteristic name="T" typeId="e5f6-94c4-de8c-5fa8">2</characteristic>
