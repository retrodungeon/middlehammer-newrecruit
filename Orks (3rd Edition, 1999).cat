          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0aec-beb4-afe9-ca28" type="max" />
          </constraints>
          <rules>
            <rule id="4b41-1d54-66ae-cf9e" name="Dok's Tools" hidden="false">
              <description>Once per turn at the end of the enemy's shooting phase a Mad Dok with Dok's Tools may attempt to "heal" a wounded or killed model. Roll a D6. On a 1 the Ork suffers 1 wound and if reduced to zero wounds is removed as a casualty. On a 2-5 there is no effect. On a 6 the Ork regains 1 wound up to the maximum it started the game with.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="1" />
          </costs>
        </selectionEntry>
