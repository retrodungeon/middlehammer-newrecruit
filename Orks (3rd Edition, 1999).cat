        <selectionEntry id="10e7-55de-7dda-0597" name="Slugga" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true" childId="1518-7a1b-daac-0172" type="equalTo" />
              </conditions>
