          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fd3d-5be3-8fea-fc81" type="max" />
          </constraints>
          <rules>
            <rule id="b99b-d861-6a7b-62af" name="Sacred Item" hidden="false">
              <description>Any unit with members within 6" of a vehicle with a Sacred Item can re-roll their Morale Test after losing an Assault or after taking casualties in the Shooting Phase.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
          </costs>
        </selectionEntry>
        <selectionEntry id="dd29-27f4-b728-4fda" name="Extra Armour" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="89f8-afda-4652-edcc" type="max" />
          </constraints>
          <rules>
            <rule id="d3ad-3987-a59d-949b" name="Extra Armour" hidden="false">
              <description>Count the 'Crew Stunned' result as 'Crew Shaken' instead</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
        <selectionEntry id="9ec8-9b02-ce4a-9113" name="Pintle Mounted Storm Bolter" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e26a-9243-f94b-ce39" type="instanceOf" />
              </conditions>
            </modifier>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c2e9-f13d-dde8-8425" type="instanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5b66-562b-a3bf-c159" type="max" />
