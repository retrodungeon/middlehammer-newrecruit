        <selectionEntry id="fdb2-3279-3792-35e1" name="Master Crafted Weapons" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c406-23d3-1c02-6e7f" type="notInstanceOf" />
