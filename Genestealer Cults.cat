    <selectionEntry id="ee36-00b3-599c-3eb2-9889a" name="Dagger of the Swift Sacrifice" page="101" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="4f9b-5b8f-62e8-dba7-9889a" name="Dagger of the Swift Sacrifice" page="101" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Instant Death, Poisoned (2+)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ef66-201e-48fb-0d4a-9889a" name="Dagger of the Swift Sacrifice" page="101" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When making its close combat attacks, a model with the Dagger of the Swift Sacrifice can instead make a single attack, rolling To Hit as normal, using the profile of the weapon.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ee36-00b3-599c-3eb2-maxSelections-9889a" type="max" />
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ee36-00b3-599c-3eb2-maxInRoster-9889a" type="max" />
      </constraints>
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks />
      <costs>
        <cost name="Points" value="15.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="39d7-8363-ea30-25ee-9889a" name="Deliverance Broodsurge" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="93a5-9988-9f17-46b9-9889a" name="Reckless Fanaticism" page="87" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All units of Neophyte Hybrids from a Deliverance Broodsurge must begin the game embarked upon their Goliath Trucks. These units can disembark even if their vehicle moved at Cruising Speed, though each model that does so must take a Dangerous Terrain test.</description>
        </rule>
        <rule id="8c54-831a-4599-e390-9889a" name="Perfervid Crew" page="87" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each time a vehicle from this Formation suffers a Crew Stunned or Crew Shaken result, that result is ignored (though the vehicle still loses a Hull Point).</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
