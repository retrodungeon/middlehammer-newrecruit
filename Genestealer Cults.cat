        <rule id="50c6-bd0e-4b61-2c4c-9889a" name="Rugged Construction" page="84" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If this model suffers a Crew Shaken, Crew Stunned or Immobilised result, roll a dice. On a roll of 4 or more, the vehicle ignores the result, but loses a Hull Point as normal.</description>
        </rule>
        <rule id="7d3d-1d09-2f44-4bb5-9889a" name="Transport Capacity (Goliath Rockgrinder)" page="84" hidden="false">
