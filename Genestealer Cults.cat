    <selectionEntry id="67ab-28ad-55c2-a66d-9889a" name="Neophyte Cavalcade" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="f259-a634-fe53-120d-9889a" name="Mechanised Ambush" page="91" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>This Formation's units of Neophyte Hybrids must start the game embarked within their transports. Vehicle units from this Formation have the Outflank special rule. Scout Sentinels from this Formation instead gain the Cult Ambush special rule.</description>
        </rule>
        <rule id="030e-9e5a-8fea-766b-9889a" name="Devoted Crew" page="91" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Roll a dice each time a vehicle from this Formation suffers a Crew Stunned or Crew Shaken result. On a 4 or more that result is ignored (though the vehicle still loses a Hull Point).</description>
        </rule>
      </rules>
