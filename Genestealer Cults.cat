    <selectionEntryGroup id="4e97-0b02-a10d-56e4" name="Vehicle Upgrades" hidden="false" collective="false" import="true" collapsible="true">
      <selectionEntries>
        <selectionEntry id="0b67-ebe7-2e7d-baba" name="Sacred Item" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
