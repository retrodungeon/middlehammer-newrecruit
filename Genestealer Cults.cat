  </entryLinks><sharedSelectionEntries><selectionEntry id="c406-23d3-1c02-6e7f" name="Genestealer Magus" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="9d2f-f8aa-24a5-7ab3" name="He Who Runs Away..." hidden="false">
          <description>The Magus can make a Voluntary Fall-back by making a successful Leadership Test, leaving his Bodyguard to keep on fighting in an Assault. He will automatically Regroup after this movement has ended, or if he reaches the edge of the board.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0271-c8ea-031a-7d04" name="Independent Character" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
        <infoLink id="65c2-3871-8201-641a" name="Hypnotic Gaze" hidden="false" targetId="7480-6633-9906-f11b" type="rule" />
        <infoLink id="6956-f18b-6931-4555" name="Genestealer Magus" hidden="false" targetId="7626-8fa0-f433-5dba" type="profile" />
        <infoLink id="cb19-1a6c-3138-86f1" name="Laspistol" hidden="false" targetId="95a9-d270-d218-1772" type="profile" />
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="e19f-61e5-eacd-63fd" name="Bodyguard" hidden="false" collective="false" import="true" type="upgrade" sortIndex="3" collapsible="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9973-f58c-50bd-e859" type="max" />
          </constraints>
          <rules>
            <rule id="1907-25c5-fccb-29be" name="We Fall So That He May Live" hidden="false">
              <description>Bodyguards will never Fall Back for any reason. When the unit is hit by ranged fire, the Cult player may apply up to 3 hits per Bodyguard Initiate before having to allocate any hits on the Magus. In an assault, after all models have moved the Cult player may swap the Magus with another Bodyguard Initiate model. The same thing can be done when the unit is hit by any template or area effect weapons.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry id="9985-554f-d8c3-e81a" name="Frag Grenades" hidden="false" collective="false" import="true" type="upgrade" sortIndex="3">
