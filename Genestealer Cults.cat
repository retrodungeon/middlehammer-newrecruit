        <selectionEntry id="0fb4-3fc3-d390-807d" name="Smoke Launchers" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e741-fcf2-82fb-21ef" type="max" />
          </constraints>
          <rules>
            <rule id="215b-3c31-ab08-20e9" name="Smoke Launchers" hidden="false">
              <description>Once per game, after completing movement, a vehicle with smoke launchers may trigger them. The vehicle cannot fire and use its smoke launchers in the same turn. Any penetrating hits scored by the enemy in the next Shooting phase count as glancing hits.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="3" />
          </costs>
        </selectionEntry>
        <selectionEntry id="2643-3082-e052-a9ca" name="Mounted Heavy Stubber" hidden="false" collective="false" import="true" type="upgrade">
