    <selectionEntry id="091e-f0c1-1a4a-6b3b-9889a" name="Brood Cycle" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="d8f9-65f1-34ab-b842-9889a" name="Familial Pride" page="89" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any non-vehicle unit in this Formation that is within 6" of at least one other unit from the same Formation adds 1 to both its Leadership and its Weapon Skill.</description>
        </rule>
        <rule id="da65-b9f1-96e4-de04-9889a" name="Hold the Banner High" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All units from this Formation have the Furious Charge special rule while they are within 24" of their Acolyte Iconward. In addition, the range of the Acolyte Iconward's Nexus of Devotion special rule will effect units from this Formation that are within 24" of him, instead of just 12".</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="554f-e696-09d6-9ca8-9889a" name="Acolyte Iconward" hidden="false" collective="false" defaultSelectionEntryId="14eb-1190-c11e-4908-9889a">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="554f-e696-09d6-9ca8-minSelections-9889a" type="min" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="554f-e696-09d6-9ca8-maxSelections-9889a" type="max" />
          </constraints>
          <selectionEntries />
