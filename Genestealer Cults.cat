    <selectionEntry id="60a2-3961-8deb-e9aa" name="Brood Brothers Initiates" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="d1ac-c308-2f5c-7a15" name="Infiltrate" hidden="false">
          <description>One (and only one) Initiate unit may infiltrate if the scenario allows it, as long as the unit does not have any heavy weapons or a relic bearer, contains 20 or fewer models, and is not in a vehicle.</description>
        </rule>
      </rules>
      <infoLinks>
