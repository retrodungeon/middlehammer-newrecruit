    </profile>
    <profile id="e17b-c8c2-3c6f-d11e-9889a" name="Demolition Charge" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">6"</characteristic>
