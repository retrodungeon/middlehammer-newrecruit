          </costs>
        </selectionEntry>
        <selectionEntry id="686a-c538-22da-b12b" name="Rough Terrain Modifications" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4a52-3089-4485-65f9" type="max" />
          </constraints>
          <rules>
            <rule id="656a-630d-ba1e-42ff" name="Rough Terrain Modification" hidden="false">
              <description>A vehicle that moves no more than 6" may re-rolled failed Difficult Terrain tests</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
        <selectionEntry id="6536-e89e-1dd3-6669" name="Searchlight" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a630-c11c-ee90-de29" type="max" />
          </constraints>
          <rules>
            <rule id="b526-4e8a-fdb0-1343" name="Searchlight" hidden="false">
              <description>During Night Fighting missions, one enemy unit spotted by the vehicle can be fired at by any other Imperial Guard units in range and with line of fire. However, the vehicle using the Searchlight will then be exposed and can be fired at by any enemy units that are in range and line of sight of it until the next turn.</description>
            </rule>
          </rules>
          <costs>
