    <selectionEntry id="178b-a991-19ba-d4e2-f9b7f" name="Typhus" page="0" hidden="true" collective="false" type="upgrade">
      <profiles>
        <profile id="c806-c0d4-8715-e1f4-f9b7f" name="Typhus the Traveller" page="0" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
          <profiles />
          <rules />
          <infoLinks />
