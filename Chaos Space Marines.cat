      <rules>
        <rule name="Armour of Shrieking Souls" id="3adf-6a0c-54f0-4097" hidden="false">
          <description>Lucius has a 4+ invulnerable save. In addition, it counts as a Doom Siren</description>
        </rule>
        <rule name="Martial Pride" id="9520-e175-29ae-0535" hidden="false">
          <description>Lucius's Attacks characteristic is raised to 5 when in base contact with an enemy whose WS is 5 or more. It is lowed to 2 when all opponents in base contact have WS 2 or lower.</description>
        </rule>
      </rules>
