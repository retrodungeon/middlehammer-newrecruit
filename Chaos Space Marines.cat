      <rules>
        <rule id="3fc1-2d47-281b-ee27-f9b7f" name="Shriekwave" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Once per game, the bearer can make a special shooting attack instead of firing another weapon. This has the Shriekwave profile.</description>
        </rule>
        <rule id="bb62-5cb0-088d-db54-f9b7f" name="Mental Trauma" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Before making this attack, the target unit must first take a Leadership test. If failed, you can re-roll all failed To Wound rolls made for this attack.</description>
        </rule>
      </rules>
