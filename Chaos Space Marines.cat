        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Hull-mounted Demolisher Cannon" id="532c-d8d2-99e4-42f2" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">10</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Ordnance 1, Large Blast</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
      </characteristics>
    </profile>
    <profile name="Chaos Cultist" id="b488-bd26-b612-8944" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">3</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">3</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">3</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">3</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">1</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">3</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">1</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">7</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">6+</characteristic>
      </characteristics>
    </profile>
    <profile name="Cultist Champion" id="f35e-9066-b165-4b29" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">3</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">3</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">3</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">3</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">1</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">3</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">8</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">6+</characteristic>
      </characteristics>
    </profile>
    <profile name="Hades Autocannons" id="bafb-4518-082a-a093" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">36"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">8</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">4</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 4, Pinning</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
      </characteristics>
    </profile>
    <profile name="Ectoplasma Cannon" id="e8ab-0746-812b-3619" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">8</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 1, Blast</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
      </characteristics>
    </profile>
    <profile name="Forgefiend" id="3131-7aca-727a-6c95" hidden="false" typeId="acd3-2539-3641-1250" typeName="Walker Vehicle">
      <characteristics>
        <characteristic name="WS" typeId="3d9c-8977-9b95-824b">3</characteristic>
        <characteristic name="BS" typeId="ea47-07be-ab4a-6569">3</characteristic>
        <characteristic name="STR" typeId="a630-c404-957f-a49f">6</characteristic>
        <characteristic name="F" typeId="3549-2d9e-3052-b396">12</characteristic>
        <characteristic name="S" typeId="94fc-8af8-d4d4-7b1a">12</characteristic>
        <characteristic name="R" typeId="4eca-6e3c-2053-e75a">10</characteristic>
        <characteristic name="I" typeId="f706-f227-5d93-0fe3">3</characteristic>
        <characteristic name="A" typeId="12be-9dd2-0dd7-b17a">2</characteristic>
      </characteristics>
    </profile>
    <profile name="Enhanced Warriors" id="4bb1-5ff3-1242-fb48" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If Fabius Bile is included in a force, he can enhance some of the warriors in the army through genetic manipulation and drugs. For +3 pts per model, any number of Chaos Space Marine squads can be 'enhanced' by Bile's treatment. At the start of the battle, after both sides have set up but before the first turn takes place, roll a D6 for each enhanced squad and consult the table.


1: Berserk Rage! Make an Armour save for each warrior, removing any who fail. Survivors are Fearless and at +1 Strength for the remainder of the game.


2-5: Stable Mutation. The Enhanced warriors are Fearless and at +1 Strength for the entire game.


6: Created a Monster. The warriors are Fearless and add +2 to their Strength for the entire game. At the end of every owning player's turn, one of the squad's members is removed as a casualty (owner's choice).</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles><sharedRules><rule name="Possession" id="205f-1a34-20f7-6dbf" hidden="false" />
    <rule name="Fearsome" id="43fe-e3cb-692c-beaf" hidden="false">
      <description>Counts as having Daemonic Visage


Enemy units suffer -1 to LD after failing a close combat. If all units have Daemonic Visage or one unit is a Greater Daemon, the enemy suffers -2 to LD instead</description>
    </rule>
    <rule name="Wings" id="55cd-6d4e-ff80-6a56" hidden="false">
      <description>Makes a 12" move just as if he were wearing a jump pack, ignoring any intervening terrain between it and the target.</description>
    </rule>
    <rule name="Summoned" id="c8e1-dd0e-6e6d-ac2d" hidden="false">
      <description>All Daemons other than Princes or Nurglings begin in Reserve.


Starting on the 2nd turn, roll a D6. If greater than or equal to the following numbers, the unit becomes available


Turn 2: 4+


Turn 3: 3+


Turn 4: 2+


When deployed, place a large blast marker in contact with a model carrying a Chaos Icon and roll the Scatter dice and move the marker 2D6" of the arrow's direction unless a hit is rolled.</description>
    </rule>
    <rule name="Terminator Armor" id="7988-95d2-59f5-7715" hidden="false">
      <description>Increase Sv to 2+ and gain 5+ Invulnerable Save. Add +1 Attack. May teleport using Deep Strike if allowed by mission.</description>
    </rule>
  <rule name="Chaos Marine Bike" id="62a1-60b9-6226-b3e5" hidden="false">
      <description>Moves as bike. +1 Toughness. +1 Attack.</description>
    </rule>
    <rule name="Terminator Armor" id="e618-264f-224f-b699" hidden="false">
      <description>Increase Sv to 2+ and gain 5+ Invulnerable Save. Add +1 Attack. May teleport using Deep Strike if allowed by mission.</description>
    </rule>
    <rule name="Daemonic Visage" id="e8ac-c6ca-da7f-8b78" hidden="false">
      <description>Models that lose close combat against this model take the morale test at -1 Ld. If the model is a Greater Daemon the test is -2 Ld instead.</description>
    </rule>
    <rule name="Daemonic Flight" id="5826-d1ee-f676-f67d" hidden="false">
      <description>Gain the Jump Pack rule</description>
    </rule>
    <rule name="Living Icons" id="7def-dbdd-4f3a-f4dc" hidden="false">
      <description>Greater Daemons can be used as icons for the purposes of summoning daemons aligned to the same God.</description>
    </rule>
    <rule name="Daemonic Talons" id="f30e-a54a-174d-019f" hidden="false">
      <description>Any rolls to hit of a 6 causes an automatic wound with no armour saves allowed. Against vehicles, a roll of 6 allows the model to roll an additional dice to determine the total Armour Penetration score.</description>
    </rule>
    <rule name="Daemonic Mutation" id="7163-dcba-823c-993d" hidden="false">
      <description>+1 Attack</description>
    </rule>
    <rule name="Slow and Purposeful" id="dfb3-f2d0-e017-ab77" hidden="false">
      <description>Always count as stationary when firing, even if they moved in the same turn. But move as if in difficult terrain at all times, and never receive +1 Attack for charging. Also strike at I1 in close combat and never perform a Sweeping Advance.</description>
    </rule>
    <rule name="True Grit" id="5734-7de5-c430-cb4e" hidden="false">
      <description>Models with True Grit have learned how to use their bolters so that they can treat their bolters as a bolt pistol in close combat and will therefore be allowed to roll and extra Attack dice as if they had two close combat weapons. However, a model using their bolter in this manner may not receive the attack bonus for charging.</description>
    </rule>
    <rule name="Daemonic Resilience" id="f08b-40f4-0069-5126" hidden="false">
      <description>+1 Toughness</description>
    </rule>
    <rule name="Warp Scream" id="861f-7563-6ff8-dcea" hidden="false">
      <description>Models attacking a model with this ability has their Initiative reduced by 1 to a minimum of 1.</description>
    </rule>
    <rule name="Daemonic Essence" id="d822-e8e2-15a4-a999" hidden="false">
      <description>+1 Wound</description>
    </rule>
    <rule name="Summoned" id="f68a-ae35-39e1-bee8" hidden="false">
      <description>Must be summoned from a chaos icon matching their alignment.</description>
    </rule>
    <rule name="Invulnerable" id="aca4-0056-79e8-a262" hidden="false">
      <description>The Daemon has a 5+ invulnerable save.</description>
    </rule>
    <rule name="Instability" id="4d84-04be-e208-c7ce" hidden="false">
      <description>Any time a Daemon unit takes a Morale check the unit suffers one wound for each point they failed the Morale check by.</description>
    </rule>
    <rule name="Nurgle's Rot" id="49b9-7246-4d5f-4dac" hidden="false">
      <description>Any model within 6" of a model with Nurgle's Rot must roll a D6 at the end of the Chaos Shooting phase. On a roll of 6 the unit takes a wound, with armour and invulnerable saves as normal.</description>
    </rule>
    <rule name="Daemonic Venom" id="85d4-f5c5-831a-2689" hidden="false">
      <description>The model may have no other weapons but counts as having a pair of close combat weapons representing raking claws and fangs. When rolling to wound the model will never require more than 4+ irrespective of relative Strength and Toughness.</description>
    </rule>
    <rule name="Collar of Khorne" id="1fbc-f6af-2d3a-3c2e" hidden="false">
      <description>Force weapons lose their special rule against the bearer, and any psychic abilities that target the wearer or include him in their area of effect are nullified on a D6 roll of 2+</description>
    </rule>
    <rule name="Hit and Run" id="6430-6d5a-f438-6a72" hidden="false">
      <description>At the end of a round of close combat the Raptors may choose to break off if they and at least some of their close combat opponents do not have to fall back. The unit falls back 3D6" in any direction and automatically regroups at the end of the move. The enemy units may only consolidate.</description>
    </rule>
    <rule name="Chaos Icon" id="d212-2b75-e1ff-e2b7" hidden="false">
      <description>A chaos icon is a source for summoning. All units that have a Mark of Chaos bears one icon matching the mark.</description>
    </rule>
    <rule name="Furious Charge" id="1d78-45fd-b8f9-1354" hidden="false">
      <description>When the unit charges, all models are at +1 I and +1 S</description>
    </rule>
    <rule name="Siege Specialists" id="5527-08ad-de84-2f08" hidden="false">
      <description>+1 on Armour Penetration rolls against enemy bunkers and tank traps. When crossing minefields only trigger a mine on a 6.</description>
    </rule>
    <rule name="Daemonic Rune" id="7a9e-fdb4-a566-6f98" hidden="false">
      <description>Ignored Instant Death rule</description>
    </rule>
    <rule name="Spiky Bits" id="6672-774e-5795-93bd" hidden="false">
      <description>Re-roll misses in each round of close combat</description>
    </rule>
    <rule name="Demagogue" id="6488-c43f-8b5a-933b" hidden="false">
      <description>All Chaos units (other than Daemons) within 6" of the orator will automatically pass any Moral checks.</description>
    </rule>
    <rule name="Daemonic Armour" id="a5d0-fcc5-6cd9-243a" hidden="false">
      <description>Gain 2+ Armour save</description>
    </rule>
    <rule name="Talisman of Burning Blood" id="cc89-74f2-f167-7949" hidden="false">
      <description>Roll two dice instead of one to test for Blood Frenzy. If either is a 1 or 2 they advanced as described in the Blood Frenzy rule</description>
    </rule>
    <rule name="Rage of Khorne" id="adef-30c9-d9f0-cdd0" hidden="false">
      <description>The model gains +D3 attacks instead of +1 when charging.</description>
    </rule>
    <rule name="Warp Talisman" id="5398-cdc9-a12d-045a" hidden="false">
      <description>Re-roll one Psychic test per battle.</description>
    </rule>
    <rule name="Nurgling Infestation" id="8b1e-3bac-d92a-ddd8" hidden="false">
      <description>If the model is in close combat the Nurglings make an extra D6 S3 I3 attacks.</description>
    </rule>
    <rule name="Affliction" id="0b0c-b1f6-6e4d-3ac7" hidden="false">
      <description>Affliction: The psyker attempts to target an independent character or single model within a unit (the target player chooses the model). If you roll over the victim's Toughness on a D6, or a roll of 6 regardless of Toughness, then the target model takes a single wound with normal saves allowed.</description>
    </rule>
    <rule name="Miasma of Pestilence" id="9e95-e791-6089-82e2" hidden="false">
      <description>After the psychic test, place the small blast marker at any point within 24" the sorcerer can see. Roll the Scatter Dice and a D6 to determine the final location. Any enemy units with models under the templace must pass a Morale check or fall back using the normal rules.</description>
    </rule>
    <rule name="Combat Drugs" id="13ba-bf65-1890-7200" hidden="false">
      <description>At the start of any Assault phase the Slaaneshi can choose up to three abilities listed below. Roll a D6 for each power chosen. On a double the character takes one wound without saves. On a triple the character dies outright.
- Roll an additional dice when charging through difficult terrain
- +1 WS
- +1 S
- Ignore the first unsaved wound taken as long as it does not cause instant death
- +1 A</description>
    </rule>
    <rule name="Aura of Acquiescence" id="85e7-dab1-16d8-8c7e" hidden="false">
      <description>If an enemy unit fights in close combat against a model with the Aura of Acquiescence and loses they do not take a Morale check and will remain in combat.</description>
    </rule>
    <rule name="Daemonic Strength" id="aaff-eb44-7ee5-2ee6" hidden="false">
      <description>+1 Strength</description>
    </rule>
    <rule name="Fuelled by Pain" id="c292-2f5c-87d8-35ac" hidden="false">
      <description>Always active. For every close combat attack the wounds the psyker, but is stopped by his Armour save, he may make an additional attack after all other attacks have been resolved but before combat results are determined.</description>
    </rule>
    <rule name="Talisman of Tzeentch" id="5b12-b1bc-c56b-aacf" hidden="false">
      <description>Opposing psykers suffer a -1 modifier to their Leadership for psychic tests if the army includes a model with this talisman. The ability does not stack with other Talismans. If both players have this gift they cancel each other out and the normal rules apply.</description>
    </rule>
    <rule name="Mass Mutation" id="4275-903e-e63f-fc4e" hidden="false">
      <description>The power is used in the Shooting phase. If the test is passed, the unit of Chosen, Possessed, Marines, or Havocs joined by the Sorcerer gains an ability determined randomly by the table below for a single turn:
1 - No benefit. Roll a D6 for each model; On a roll of 1 the model is removed as a casualty
2 - Gain +1 S
3 - Cause -1 Ld versus units they win close combat against
4 - Gain +1 T
5 - Gain 5+ invulnerable save
6 - Gain +1 A</description>
    </rule>
    <rule name="Gift of Chaos" id="d8fe-9262-6b98-6c8d" hidden="false">
      <description>Pick an enemy or friendly model within 2" of the Sorcerer and then take a Psychic test. If the test is successful, for a D6. If you roll over the victim's Toughness, or roll a natural 6, the victim is transformed into a Chaos Spawn, with no armour save allowed.</description>
    </rule>
    <rule name="The Twisting Path" id="3761-7c2c-7bc7-e3c8" hidden="false">
      <description>This power is used in the Shooting Phase, has a range of 12" and requires LOS. The target unit makes a Leadership test and if they fail they are pinned until the start of the next Chaos turn.
Additionally, earn 50 Victory Points each time this power succeeds, but only earn these Victory Points once from any unit.</description>
    </rule>
    <rule name="Feel no Pain" id="8d48-9c43-3d92-6e1e" hidden="false">
      <description>If the model loses a wound roll a dice. On a 4+ the wound is ignored. This ability cannot be used against weapons whose strength is at least twice the Toughness of the model or against close combat weapons that allow no save.</description>
    </rule>
    <rule name="Night Vision" id="923d-664d-882f-c3ce" hidden="false">
      <description>Re-roll the dice when rolling to determine how far the unit can see.</description>
    </rule>
    <rule name="Favoured by Khorne" id="8204-d3bb-d855-a234" hidden="false">
      <description>Marines gain a free Aspiring Champion upgrade for a unit of 8 or 16 models. A daemon unit of 8 or 16 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Favoured by Nurgle" id="1e3a-0139-4ffe-ca76" hidden="false">
      <description>Marines gain a free Aspiring Champion upgrade for a unit of 7 or 14 models. A daemon unit of 7 or 14 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Favoured by Slaanesh" id="b6ea-41df-7f4c-ab3d" hidden="false">
      <description>Marines gain a free Aspiring Champion upgrade for a unit of 6, 12 or 18 models. A daemon unit of 6, 12 or 18 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Favoured by Tzeentch" id="382b-b6e8-56f1-6975" hidden="false">
      <description>Marines gain a free Aspiring Champion upgrade for a unit of 9 or 18 models. A daemon unit of 9 or 18 models may receive a +1 on the summoning dice.</description>
    </rule>
    <rule name="Possession" id="d1c9-1fdc-179b-02fa" hidden="false">
      <description>A Greater Daemon must possess another model to enter the battlefield.</description>
    </rule>
    <rule name="Iron Steeds" id="c5cb-a25a-e57f-2322" hidden="false">
      <description>Chaos Bikers get +1 T. Additionally, their bikers are covered in spikes, granting them +1 A. Chaos Space Marine Bikers gain no benefit from the Daemonic Resilience ability.</description>
    </rule>
    <rule name="Banner of Rage" id="0a48-ed75-7aed-27ce" hidden="false">
      <description>As well as functioning as a Icon, the banner may once per battle release its power. In any Assault phase the models in the same unit as the model bearing the Banner gain +1 A.</description>
    </rule>
    <rule name="Blasted Standard" id="6bad-d8ef-16e9-c6e6" hidden="false">
      <description>Once per battle in the Chaos player's Shooting Phase the standard can be aimed at any enemy unit with a model with 6" of the Icon Bearer and may even target a unit in close combat. The spell inflicts 2D6 S6 AP4 hits.</description>
    </rule>
    <rule name="Daemon Icon" id="8583-787f-824f-14ab" hidden="false">
      <description>A chaos icon is a source for summoning. All units that have a Mark of Chaos bears one icon matching the mark.</description>
    </rule>
    <rule name="Plague Banner" id="b1d2-398f-df75-16ed" hidden="false">
      <description>Functions as a normal Icon but in additional can once per battle cause any one enemy unit within 6" to take D6 wounds with no armour or cover saves possible.</description>
    </rule>
    <rule name="Rapturous Standard" id="c970-8491-d920-17b8" hidden="false">
      <description>As well as acting as a Icon once per game at the start of the Shooting Phase any model within 6" gains the Feel no Pain special ability for the remainder of the turn.</description>
    </rule>
    <rule name="Icon of Chaos Undivided" id="aaa1-4142-da6f-c80a" hidden="false">
      <description>The icon can be used to summon Daemons as normal and in addition any unit or model bearing the Mark of Chaos Undivided within 6" becomes Fearless</description>
    </rule>
    <rule name="Daemon Weapon" id="f4a4-cde3-aa56-bd53" hidden="false">
      <description>In any turn the bearer inflicts at least one casuality with the Daemon weapon, the wielder must take a Leadership test at the end of the turn. If the test is failed the wielder suffers a Perils of the Warp attack.</description>
    </rule>
    <rule name="Daemonic Speed" id="99e3-926e-3341-3425" hidden="false">
      <description>The model may choose to move as Cavalry, but must move as infantry on the turn it disembarks from a vehicle.</description>
    </rule>
    <rule name="Inferno Bolts" id="f3f8-e997-6ca3-57d7" hidden="false">
      <description>Inferno bolts grant the Blast ability to each shot of a bolter, combi-bolter or bolt pistol. Roll to hit as normal but place the small Blast marker to determine how many models are hit.</description>
    </rule>
    <rule name="Nurgle Minor Psyker Powers" id="8c31-703e-997d-0c69" hidden="false">
      <description>1. No Usable Power
2. Nurgle's Dance
3. Nausea
4. Affliction
5. Miasma of Pestilence
6. Aura of Decay</description>
    </rule>
    <rule name="Nurgle's Dance" id="5dd7-8ba8-e520-51dc" hidden="false">
      <description>During the Chaos player's shoot phase choose a unit or model with 12". After passing the psychic test, if the target is behind cover it must pass a Leadership test or lose the benefits of that cover for the remainder of the turn.</description>
    </rule>
    <rule name="Nausea" id="af91-4c5c-ce1d-094b" hidden="false">
      <description>During the enemy shooting phase, choose an enemy unit or independent character within 12" and LOS. After passing a psychic test the target will be at - BS for this shooting phase.</description>
    </rule>
    <rule name="Aura of Decay" id="464b-d7cf-290d-12b7" hidden="false">
      <description>During either player's assault phase, after passing a Psychic test, all enemy models in base contact with the sorcerer are at -1 Attack (to a minimum of 1). On a failed Psychic test all friendly models within 2" are impacted instead.</description>
    </rule>
    <rule name="Slaanesh Minor Psyker Powers" id="2add-8362-2dad-71ef" hidden="false">
      <description>1. No usable power
2. Fuelled by Pain
3. Siren
4. Beam of Slaanesh
5. Touch of Slaanesh
6. She Who Thirsts</description>
    </rule>
    <rule name="Siren" id="2fd6-8da5-9179-f4bd" hidden="false">
      <description>Usable by a Sorcerer that has no joined a unit or is part of a unit. During the enemy's shooting or assault phase, after passing a successful psychic test, the Sorcerer may not be targeted by shooting attacks or assaults this turn. This power cannot be used if the Sorcerer is already is base contact with an enemy model.</description>
    </rule>
    <rule name="Beam of Slaanesh" id="62d7-2061-30dc-db0a" hidden="false">
      <description>During the enemy shooting phase, choose a target within 18". On a successful psychic test the target model or unit must pass a Leadership Test or it counts as having moved for the purposes of determining which weapons can fire.</description>
    </rule>
    <rule name="Touch of Slaanesh" id="4072-d23f-5af0-00a4" hidden="false">
      <description>During the Chaos player's assault phase, after a successful psychic test, all enemy models in base contact with the psyker suffer a -1 WS penalty (to a minimum of 1) for the remainder of the phase.</description>
    </rule>
    <rule name="She Who Thirsts" id="7c12-406b-90bd-a04c" hidden="false">
      <description>During the Chaos player's assault phase, after a successful psychic test, if the psyker has killed one or more enemy models this phase then the unit or units they belonged to will be at -1 Leadership if they lose the combat and take a Morale check.</description>
    </rule>
    <rule name="Tzeentch Minor Psyker Powers" id="1eee-b303-b1ea-f78e" hidden="false">
      <description>1. No usable power
2. Pink Fire of Tzeentch
3. Psychic Duel
4. Reckoning of Tzeentch
5. Weaver of Fates
6. Withering Gaze</description>
    </rule>
    <rule name="Pink Fire of Tzeentch" id="6920-015e-17bd-1289" hidden="false">
      <description>During the Chaos player's shooting phase, instead of using their normal weapons they make an attack as if they had the Daemonic Fire gift</description>
    </rule>
    <rule name="Psychic Duel" id="b1cf-a68e-c8c0-52f9" hidden="false">
      <description>During the Chaos player's shooting phase, choose one enemy psyker on the battlefield. That psyker will be at -1 Leadership for Psychic tests for the next player turn. This modifer is cumulative with the Talisman of Tzeentch.</description>
    </rule>
    <rule name="Reckoning of Tzeentch" id="e5e3-a24e-9514-de50" hidden="false">
      <description>During the Chaos player's shooting phase, the psyker and any squad he is accompanied by may re-roll missed to hit rolls this shooting phase.</description>
    </rule>
    <rule name="Weaver of Fates" id="d3ec-f808-ba7f-c813" hidden="false">
      <description>At the start of the battle, the Tzeentch player's strategy rating is 3.</description>
    </rule>
    <rule name="Withering Gaze" id="3df6-5bbb-68c7-4feb" hidden="false">
      <description>During the enemy's assault phase, an enemy model or unit that wishes to assault the psyker or a unit he has joined must pass a Leadership test to succeed. If the test is failed the enemy model or unit may choose an alternative target if one is in range. Units which ignore or automatically pass Morale checks are unaffected by this power and the psyker cannot use this power if already in a melee.</description>
    </rule>
    <rule name="Lash of Torment" id="8e45-548c-e251-7aab" hidden="false">
      <description>Units that lost one or more models to the Lash of Torment will be at -1 Ld if they lose the combat.</description>
    </rule>
    <rule name="Chaos Hound" id="abed-4dad-d3ef-d286" hidden="false">
      <description>Moves at the same speed as their master and do not take Difficult Terrain tests. Removed if the master is killed.</description>
    </rule>
  <rule name="Chaos Icon" id="b2c2-5f7b-a147-6f46" hidden="false">
      <description>If models in Teminator armour or Obliterators are deployed onto the battlefield via Deep Strike and choose to do so within 6" of a model carrying an Icon, then they won't scatter. If the Icon Bearer is inside a transport, then the range of the icon is 6" from the transport vehicle itself. Lesser Daemons must enter the game by Deep Striking within 6" of an icon (see Summoning Daemons) Note that Icons only work for models in Terminator armour, Obliterators and Lesser Daemons, not for units entering play using jump packs or other means of transport. Also note that an icon must already be on the table at the start of the turn for it to be used.</description>
    </rule>
    <rule name="Summoned Daemon" id="8a27-2a6a-e114-eec0" hidden="false">
      <description>Units of Daemons always start the game in Reserve, even in Missions that do not normally allow the Reserves rule to be used. When a Daemon unit becomes available from Reserve, it must deploy as detailed in its section. 


Once deployed, the Daemons cannot do anything else in that turn's Movement phase, but after that they are free to act as normal (they can Assault in the same turn that they enter the game).</description>
    </rule>
