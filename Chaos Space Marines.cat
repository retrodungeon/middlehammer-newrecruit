    <selectionEntry id="f5d93a62-3ff7-d984-c64c-5ea5faaccf21-f9b7f" name="The Murder Sword" page="0" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="cdda2aa2-e152-b927-36cb-3236aea7fa26-f9b7f" name="The Murder Sword" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
