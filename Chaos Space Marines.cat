er></modifiers><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="009bd8ff-ec05-f17b-f5d7-d7f981728625-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="ef6143bb-32de-6cc3-de53-8c9b59c35c51-6eec309" name="Special Weapons" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="ef6143bb-32de-6cc3-de53-8c9b59c35c51-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="f73fd44e-2d67-a71d-1b15-082e51fb1521-6eec309" name="Flamer" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="f73fd44e-2d67-a71d-1b15-082e51fb1521-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="b87bb13e-9e89-3194-50a1-6513f9b4d163-6eec309" name="Meltagun" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="b87bb13e-9e89-3194-50a1-6513f9b4d163-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="1323d33c-9ab9-7f10-2bad-e5febf7aaefc-6eec309" name="Plasma Gun" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="1323d33c-9ab9-7f10-2bad-e5febf7aaefc-maxSe