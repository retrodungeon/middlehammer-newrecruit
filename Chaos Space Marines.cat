        <selectionEntry id="mh-rad-chaos-space-marines-ab39-d41c-7f2d-a92b" name="Combat Shield" publicationId="ca571888--pubN80998" page="131" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-8e0d-f89e-8c8d-2d29" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-96e4-a19a-7925-ebaa" name="Combat Shield" publicationId="ca571888--pubN80998" page="131" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Combat shields and boarding shields confer a 6+ Invulnerable save, increasing to 5 in close combat.</characteristic></characteristics></profile>
          </profiles>
