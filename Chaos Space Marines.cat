    <selectionEntry id="3112-8055-b691-9851-f9b7f" name="Kharn's Butcherhorde" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="d069-69c8-0061-4af1-f9b7f" name="Blood and Rage" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When a unit in this formation rolls an 8 for charge range (including re-rolls), then all models in that unit double their attack stat for that turn.</description>
        </rule>
        <rule id="79df-3fd9-61d3-b905-f9b7f" name="Slaughter without Respite" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each time a model in the formation scores a 6 on a to-hit roll, then it gains an extra attack. If additional 6's are rolled, then these also gain extra attacks.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers>
        <modifier type="set" field="hidden" value="false">
          <repeats />
          <conditions />
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
