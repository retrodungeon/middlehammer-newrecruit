          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" />
          </costs>
          <rules>
            <rule name="Mutated Hull" id="098c-9257-1641-42d2" hidden="false">
              <description>The armour value of each of the vehicle's sides is increased by +1 to a maximum of 14.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Parasitic Possession" id="3397-fb07-904c-bdf0" collective="false" hidden="false" import="true" type="upgrade">
