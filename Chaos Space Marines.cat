" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bd2bf975-1196-0ceb-8d07-f9cbe6b3ac5f-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="ba3dea26-e79b-1093-17d4-e9d37264530a-6eec309" name="Skulltaker" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="34" /></costs><constraints><constraint type="min" value="2" field="selections" scope="parent" shared="true" id="ba3dea26-e79b-1093-17d4-e9d37264530a-minSelections-6eec309" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="9" field="selections" scope="parent" shared="true" id="ba3dea26-e79b-1093-17d4-e9d37264530a-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="901a444a-e615-3d99-5017-539835c1dfcc-6eec309" name="Lightning Claw" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="3" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="901a444a-e615-3d99-5017-539835c1dfcc-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="c67c75db-38c6-0099-0565-c496ec421763-6eec309" name="Powerfist" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="7" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c67c75db-38c6-0099-0565-c496ec421763-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="8b8f3476-e24b-073c-7baa-68a96a53b9e6-6eec309" name="Chainfist" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="12" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8b8f3476-e24b-073c-7baa-68a96a53b9e6-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="b2ae6c08-e2ff-0bf0-40b8-fe9033361767-6eec309" name="Combi-melta, -flamer, -plasma" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b2ae6c08-e2ff-0bf0-40b8-fe9033361767-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="bb04f7fd-cf36-b7ab-ac18-cc59dc7da0fd-6eec309" name="Pair of Lightning Claws" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="7" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bb04f7fd-cf36-b7ab-ac18-cc59dc7da0fd-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="2b1f3963-0a77-30bb-53ea-10cab683c6d1-6eec309" name="Skulltaker Champion" hidden="false" collective="false" import="true" type="model"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="36" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2b1f3963-0a77-30bb-53ea-10cab683c6d1-minSelections-6eec309" includeChildSelections="false" includeChildForces="false" /><co