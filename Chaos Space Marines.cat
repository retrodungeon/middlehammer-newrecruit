        <categoryLink name="Super-Heavy" id="4808-b201-42c8-2eaa" hidden="false" primary="true" targetId="5968-f35e-18fd-612b" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="325" />
      </costs>
      <infoLinks>
        <infoLink name="Lord of Skulls" id="06fe-d2c0-44fc-83b8" hidden="false" targetId="16c5-f64d-65cd-5c4a" type="profile" />
        <infoLink name="Super Heavy Tank" id="1389-1a44-5068-7f73" hidden="false" targetId="d831-af9c-0b53-6da3" type="rule" />
        <infoLink name="Slow and Purposeful" id="ab5e-2229-9afc-e0a8" hidden="false" targetId="dfb3-f2d0-e017-ab77" type="rule" />
      </infoLinks>
      <modifiers>
        <modifier field="error" type="add" value="Khorne units may not be included in a force with a Slaanesh army leader.">
          <conditions>
            <condition childId="5ea5-737a-c89a-09e8" childName="Leader - Slaanesh" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Daemonic Possession" id="a4d6-d7fc-3ce1-8ecd" hidden="false">
          <description>A Daemon controls the vehicle and may ignore 'shaken' and 'stunned' results.</description>
        </rule>
        <rule name="Destroyer" id="f637-5178-ea0b-680e" hidden="false">
          <description>A tank with Destroyer upgrade causes enemy units forced to move due to a tank shock on a 4+ with normal saves allowed.
A Dreadnought with Destroyer upgrade may re-roll one close combat miss in each round of close combat, and when rolling for Fire Frenzy will trigger Blood Rage on a 1 or 2.</description>
        </rule>
      </rules>
