        <infoLink id="mh-rad-chaos-space-marines-1d99-c24e-6112-f26f-death-" name="Assault Vehicle" hidden="false" targetId="mh-rad-chaos-space-marines-45cf-653a-4ff6-f22d" type="rule" />
