    <selectionEntry id="17f4-9b8e-8684-fbfe-f9b7f" name="Daemon-Engine Hunting Pack" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="0d70-c046-82b6-eb5f-f9b7f" name="Hunting Pack" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>After deployment, but before the first turn, nominate one character model int eh enemy army. All vehicles in the spearhead have the Preferred Enemy rule when attacking this model. In addition, if the nominated enemy model is destroyed, the side this formation belongs to scores 1 Strategic Victory Point.</description>
        </rule>
        <rule id="92b6-d646-8f8d-f982-f9b7f" name="Prized Possessions" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of the battle, you may nominate one Chaos Warpsmith in the same army to be the Daemon Engine Pack's owner. Any models from this formation that are within 12" of the owner may use his WS and BS instead of their own.</description>
        </rule>
        <rule id="c238-177c-0266-8c6d-f9b7f" name="Thunderous Charge" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If the spearhead is in Rapier Attack Pattern, it may charge even if it Ran in the Shooting phase.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
