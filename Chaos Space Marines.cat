                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-ea6f-0a58-58b0-0d01-maxSelections" type="max" />
                  </constraints>
                  <profiles>
                    <profile id="mh-rad-chaos-space-marines-1f2f-ade8-ebc6-e020" name="Banner of the Aquila" publicationId="ca571888--pubN89821" page="234" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
                      <modifiers>
                        <modifier type="set" field="hidden" value="true">
                          </modifier>
                      </modifiers>
                      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Loyalist Herald and any Loyalist unit with the Legiones Astartes rule within 12" add 1 to their WS to a max of 5.  </characteristic></characteristics></profile>
                    <profile id="mh-rad-chaos-space-marines-c9db-d1fb-fdc2-d524" name="Banner of the Eye" publicationId="ca571888--pubN89821" page="234" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
                      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The traitor Herald and any traitor unit with the Legiones Astartes special rule within 12" add 1 to their Charge and Run distances and may re-roll To Hit rolls of 1 in assault on any turn in which they have successfully charged.  </characteristic></characteristics></profile>
                  </profiles>
                  <rules>
                    <rule id="mh-rad-chaos-space-marines-91b2-715e-b724-1fad" name="Fallen Honour" publicationId="ca571888--pubN89821" page="234" hidden="false">
                      <description>Should a Herald be slain, an additional victory point is scored by the opposing player where applicable.</description>
                    </rule>
                  </rules>
                  <infoLinks>
                    <infoLink id="mh-rad-chaos-space-marines-6878-e6d2-2525-bdd4" hidden="false" targetId="mh-rad-chaos-space-marines-dc4d-c7ca-3b5e-18f6" type="rule" />
