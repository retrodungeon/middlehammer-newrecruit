          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="c55f-ec20-9309-e550" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Personal Icon" id="417e-3179-ae5d-7944" hidden="false">
              <description>The model bears the Icon of the God aligned with their Mark. This Icon can be used for Daemon Summoning just like unit Icons.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Servo-Arm" id="f117-90fc-6191-80ce" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="654e-7a55-39ae-3b5b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" />
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="27ce-133c-8642-08c9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Servo-Arm" id="174c-9d86-b8c3-b62a" hidden="false">
              <description>A model with a servo arm can attempt to repair an immobilised vehicle it is in base contact with at the start of the Chaos turn. On a D6 roll of 6 the vehicle is repaired and may move normally. If used in close combat the beared can make one additional attack each round with the arm, which counts as a power fist used with the bearer's WS and S.</description>
            </rule>
          </rules>
        </selectionEntry>
