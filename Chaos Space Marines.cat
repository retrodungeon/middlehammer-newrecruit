    <profile id="mh-rad-chaos-space-marines-e672-ae99-88e6-cfd8" name="Thunder Hammer" publicationId="ca571888--pubN106502" page="181" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
