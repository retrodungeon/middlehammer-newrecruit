    <selectionEntry id="8ea9-ad95-4670-5a52-f9b7f" name="Athenaean Scrolls" hidden="true" collective="false" type="upgrade">
      <profiles>
        <profile id="d175-6043-c75b-be4b-f9b7f" name="Athenaean Scrolls" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the bearer makes a successful Psychic test that includes two or more dice of the same number, the power has been manifested with such unstoppable force that the target unit cannot choose to take a Deny the Witch test. </characteristic>
          </characteristics>
        </profile>
      </profiles>
