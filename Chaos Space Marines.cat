    <selectionEntry id="b81e-6eda-6e05-f55f-cf969" name="Fighter Ace" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="ed80-c098-9142-e917-cf969" name="Fighter Ace" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>d6 Results
1-2 Crack Shot: Fighter Ace has +1BS
3-4 Evasive Manoeuvers: Improves cover save by1 (to a max cover save of 3+)
5-6 Inspiring Aircraft: Fighter Ace and all friendly units within 12" of the model that are the same Faction have Fearless.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b81e-6eda-6e05-f55f-maxSelections-cf969" type="max" />
