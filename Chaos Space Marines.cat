      <selectionEntryGroups />
      <entryLinks />
      <costs>
        <cost name="Points" value="0.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="4e4a-5727-13e8-cc49-f9b7f" name="Iron Warriors" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="8df1-d76c-537e-2406-f9b7f" name="Blood Feud" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All units with the VotLW special rule re-roll failed To Hit rolls in every round of close combat when attacking Imperial Fists units. However, all Imperial Fists units have the Hatred (Iron Warriors) special rule.</description>
        </rule>
        <rule id="31d8-6208-7e87-8d7a-f9b7f" name="Iron Within, Iron Without" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units with the VotLW special rule has the FNP (6+) special rule.</description>
        </rule>
        <rule id="b4c7-5e24-1244-fded-f9b7f" name="Patrons of the Technovirus" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units of Obliterators and Mutilators are Troops choices instead of Elites choices.</description>
        </rule>
        <rule id="0d0f-6f02-e2f4-7a31-f9b7f" name="Siege Masters" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units can re-roll armour penetration rolls against buildings that do not result in a glancing hit or penetrating hit, and add 1 to the result when rolling on the Building Damage table. In addition, units of Havocs, Obliterators, and Mutilators have the Tank Hunters special rule.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="44c8-a102-8ab3-2152-f9b7f" name="New InfoLink" hidden="false" targetId="3c7d-11d6-e265-abb4" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
        <infoLink id="d896-2e1c-caf0-621c-f9b7f" name="New InfoLink" hidden="false" targetId="4378-c0f8-107a-4e3e" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
