      <characteristics><characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Jetbike (Character)</characteristic><characteristic name="WS" typeId="5.753232323444154e+23">4</characteristic><characteristic name="BS" typeId="4.2532323234441546e+23">4</characteristic><characteristic name="S" typeId="5.323232344415441e+21">4</characteristic><characteristic name="T" typeId="5.423232344415441e+21">5</characteristic><characteristic name="W" typeId="5.723232344415441e+21">1</characteristic><characteristic name="I" typeId="4.923232344415441e+21">4</characteristic><characteristic name="A" typeId="4.123232344415441e+21">2</characteristic><characteristic name="LD" typeId="4c4423232344415441232323">9</characteristic><characteristic name="Sv" typeId="5.361766523232344e+27">2+</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-350c-4efd-4ea5-de8c" name="Drop Pod" publicationId="ca571888--pubN80998" page="49" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
      <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-topped</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-4791-ed93-bcc1-a7ed" name="Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save. Depending on its particular pattern, Terminator armour may also confer additional rules and abilities to its wearer.</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-5396-45cf-7bc1-f032" name="Frost Axe" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Unwieldy, Specialist Weapon</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-e57f-85ab-c0cb-0e80" name="Frost Blade" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Specialist Weapon</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-c635-c7af-a850-9388" name="Frost Claw" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Specialist Weapon, Shred</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-7ed7-6990-8608-9abb" name="Great Frost Blade" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Reaping Blow, Master-crafted, Two-handed</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-3bc6-3f6e-aa96-c6c4" name="Power Scythe" page="" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed, Reaping Blow</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-142a-6f93-c61e-f202" name="Power Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Power armour provides a +3 armour save.</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-6460-aed3-49b4-71a8" name="Aether-rune armour" publicationId="ca571888--pubN92115" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Aether-rune armour counts as a suit of Artificer armour, granting a +2 armour save. In addition, it increases the wearer's Wounds characteristic by 1 and allows any Deny the Witch rolls taken for the wearer or the unit they have joined to be re-rolled.</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-9f8f-f861-4e60-a46f" name="Shock Ram" publicationId="ca571888--pubN85920" page="224" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When Ramming or being rammed, the Triaros counts as Front Armour 15 and rolls once on the Haywire table in addition to any damage it causes normally. When conduction Tank Shock attacks, any unit automatically suffers D6 Str 6 AP 5 hits in addition to resolving the tank shock as normal. It is not a weapon and may not be destroyed.  </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-edda-8c68-019d-a05f" name="Triaros Armoured Conveyor" publicationId="ca571888--pubN85920" page="224" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
      <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">14</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Tank, Transport</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-e2f7-20ad-9316-4393" name="Triaros Armoured Conveyor (Transport)" publicationId="ca571888--pubN66489" page="42" hidden="false" typeId="307d-047f-ca13-706b" typeName="Transport">
      <characteristics><characteristic name="Capacity" typeId="8285-4205-b6cd-8473">20</characteristic><characteristic name="Fire Points" typeId="b270-a7f9-22b2-3702">None</characteristic><characteristic name="Access Points" typeId="d17b-0342-b1dc-b8e7">Two, one of each side of the hull</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-ec51-acc6-4cc8-9086" name="Galvanic Traction Drive" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Must re-roll all failed Dangerous Terrain tests</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-f6de-b927-0fb9-5ad6" name="Djinn-sight" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Reduces enemy benefit from cover by -2. Additionally infiltrators may not be deployed within 24".</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-768c-58bf-6df4-a38f" name="Heavy Chainblade" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-4192-2556-8381-a828" name="Aether-Shock Maul" publicationId="ca571888--pubN103311" page="293" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Deflagrate</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-7feb-f487-bc1d-748e" name="Psyk-out Missiles" publicationId="ca571888--pubN103311" page="302" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
