    <selectionEntry id="mh-rad-chaos-space-marines-37ee-c4c3-9905-0174-iron-w" name="Dominator Cohort" publicationId="db9a-ae25-9e59-7f3f" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-chaos-space-marines-4202-af28-aa59-b10b-iron-w" type="max" />
      </constraints>
      <rules>
        <rule id="mh-rad-chaos-space-marines-60b6-792b-88d4-5d33-iron-w" name="Those Once Honoured" hidden="false">
          <description>A Dominator Cohort may be chosen instead of a Command Squad as a bodyguard for Perturabo. If selected in this manner they count as a Retintue unit and do not use up a separate Force Organisation slot, but no other Retinue unit may be selected for Perturabo. All model in a Dominator Cohort selected in this manner lose the Hatred (Cybernetica Cortex) and instead gain the Feel No Pain (6+) special rule. In adition, if an army includes a Domitar Cohort selected as a retinue for Perturabo, then the army may not include any 'Iron Circle' Domitar-ferrum class battle-automata maniple units.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-chaos-space-marines-4d36-a633-50ec-ebf1-iron-w" name="Implacable Advance" hidden="false" targetId="mh-rad-chaos-space-marines-5ecb-551d-0f68-3a79" type="rule" />
        <infoLink id="mh-rad-chaos-space-marines-c6a4-46d0-cf43-470e-iron-w" name="Stubborn" hidden="false" targetId="mh-rad-chaos-space-marines-7be5-30af-1a02-0a89" type="rule" />
        <infoLink id="mh-rad-chaos-space-marines-003c-9628-14b6-2c95-iron-w" name="Hatred" hidden="false" targetId="mh-rad-chaos-space-marines-7c6c-4e25-e4d4-9728" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Cybernetica Cortex)" />
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="mh-rad-chaos-space-marines-37ee-c4c3-9905-0174-iron-w" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="mh-rad-chaos-space-marines-c317-0f8c-791f-4a0b-iron-w" type="equalTo" />
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
