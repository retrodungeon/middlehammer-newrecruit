    <profile id="mh-rad-chaos-space-marines-08ebafcd-366d-43ca-2591-21133dd130d2" name="Heavy Conversion Beamer (2)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
