    <selectionEntry id="0320-96a5-5d89-dfff-f9b7f" name="Cult of Slaughter" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="1630-b58a-b0e7-2fb7-f9b7f" name="The Desperate and the Depraved" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units of Chaos Cultists from the Cults of Slaughter have a Leadership of 10 while they are within 9" of the Formation's Dark Apostle.</description>
        </rule>
        <rule id="c098-ae14-c5b4-166c-f9b7f" name="Frenzied Horde" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of each of your Movement phases, roll a dice for each unit of Chaos Cultists in the Cults of Slaughter that is within 18" of the Formation's Dark Apostle. That many slain models are returned to the unit. Each must be set up within unit coherency and not within 1" of any enemy models. Any models that cannot be set up are lost. </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="c709-1593-57ab-5e67-f9b7f" name="b3ad-2a40-c969-66d9" hidden="false" targetId="b3ad-2a40-c969-66d9-f9b7f" type="rule">
