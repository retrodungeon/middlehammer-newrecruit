    <profile id="mh-rad-chaos-space-marines-4b6b-08cb-a956-0eb3" name="Artificer Armour" publicationId="ca571888--pubN80998" page="131" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Artificer Armour confers a 2+ Armour save.  </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-21b6-668e-d5ef-a8da" name="Hand Flamer" publicationId="ca571888--pubN106502" page="177" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
