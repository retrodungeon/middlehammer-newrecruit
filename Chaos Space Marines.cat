            <characteristic name="Agility" typeId="ae34-f5c0-19af-4883">4</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="a03e-1197-cd61-95e7-f9b7f" name="Aerial Strike" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In a Dogfight, a Heldrake which is tailing an opponent at a range of up to 12" in the Attack sub-phase can make an Aerial Strike in addition to its other attacks. The Aerial Strike inflicts a S7 AP2 hit. </description>
        </rule>
        <rule id="a8f5-b26a-94e7-850a-f9b7f" name="Meteroric Descent" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Heldrake has the Vector Strike special rule while zooming. these hits are at S7</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d815-fa49-b40c-1d65-f9b7f" hidden="false" targetId="41d92af2-6429-c745-dbae-fef1ccbe7878-f9b7f" type="profile">
