        <rule id="mh-rad-chaos-space-marines-c292-4d6d-3f55-c803" name="Credo Annihilato" hidden="false">
          <description>An Army that includes at least one Primus Nullificator ignores the 0-1 restriction on Legion Nullificator units and may select them as Troops choices, but these units gain the Support Unit special rule.</description>
        </rule>
      </rules>
