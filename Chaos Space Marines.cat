ncludeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="cb17f5ff-764f-97d6-7cb8-3dffa0ce2669-6eec309" name="Twin-linked lascannon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cb17f5ff-764f-97d6-7cb8-3dffa0ce2669-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="e11cb43a-7dc8-0f94-1c00-ff70efa695bf-6eec309" name="Power scourge" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e11cb43a-7dc8-0f94-1c00-ff70efa695bf-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="be92096e-3454-beb6-29a5-6c3984e3604c-6eec309" name="Thunder hammer" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="be92096e-3454-beb6-29a5-6c3984e3604c-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="7affc032-6cd5-04d8-7446-85b4377e9ead-6eec309" name="Missile launcher w/ frag + krak" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><modifiers><modifier type="decrement" field="7affc032-6cd5-04d8-7446-85b4377e9ead-maxSelections-6eec309" value="1.0"><repeats><repeat field="selections" scope="3618e825-8eba-e33b-98ec-cac726a14d97-6eec309" value="1" repeats="1" childId="cac9a875-1399-ec11-4dac-093d7f6b2c51-6eec309" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier></modifiers><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7affc032-6cd5-04d8-7446-85b4377e9ead-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="9a815a4e-319a-5a8c-7cf8-87279651a9b4-6eec309" name="Melee Weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="b2783926-0fed-9afa-48bd-4d9057ce78c0-6eec309"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9a815a4e-319a-5a8c-7cf8-87279651a9b4-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="b2783926-0fed-9afa-48bd-4d9057ce78c0-6eec309" name="Power fist" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b2783926-0fed-9afa-48bd-4d9057ce78c0-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="31504e43-9172-1b3a-938a-a81bdf1df395-6eec309" name="Combi-bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="31504e43-9172-1b3a-938a-a81bdf1df395-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="a0f69231-b89f-9e0e-e6de-fd1a9524ab4e-6eec309" name="Heavy flamer" hidden="false" collective="false" import=