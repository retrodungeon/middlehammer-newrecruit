        </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-ba9221f1-7a8a-4d55-0c30-ca4c502fab8d-alpha--maxSelections-alpha-" type="max" />
