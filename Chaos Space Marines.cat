        <rule id="65a3-99ef-bdaf-f1d5-cf969" name="The Chosen of An'ggrath" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All bloodthirsters in the formation that are within 18" of An'ggrath have Adamantium Will, Counter-Attack and gain an extra attack.</description>
        </rule>
        <rule id="b113-7f2a-1418-8de9-cf969" name="Terror Made Manifest" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units that fail a Fear test caused by any model in this formation suffer 1 wound for each point the test was failed. No saves of any kind are allowed.</description>
        </rule>
      </rules>
