                        <condition childId="44ca-fa7f-9f9a-5d33" childName="Mark of Tzeentch" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="root-entry-self" shared="true" type="equalTo" value="0" />
                      </conditions>
