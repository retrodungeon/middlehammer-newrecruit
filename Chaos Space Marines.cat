    <selectionEntry id="9e850255-4e7d-0403-5c7d-57bca88757b3-f9b7f" name="Legacy of Ruin: Death of Kasyr Lutien" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="5e433c24-1133-7e85-b16c-11f0081a4ab6-f9b7f" name="Legacies of Ruin: Death of Kasyr Lutien" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Vehicle gains the fear special rule. In addition, when psychic tests to use Maelific powers are made by friendly psykers within 12", one D6 may be re-rolled for every Hull Point remaining.   If the test is failed, the vehicle suffers a penetrating hit in addition to the normal psyker consquences.</characteristic>
          </characteristics>
        </profile>
      </profiles>
