    <selectionEntry id="26ab-2a98-6e0c-9af6-f9b7f" name="Brethren of the Dark Covenant" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="7f76-dc93-e607-2dab-f9b7f" name="Unbridled Wrath" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of your Shooting phase, the Dark Apostle from the Brethren of the Dark Covenant can scream a litany of rage and bloodshed instead of shooting. If he does so, each other unit from the Formation that is wihin 12" is filled with unholy zeal, and gains the Zealot and Feel No Pain special rules until the start of your next turn. </description>
        </rule>
