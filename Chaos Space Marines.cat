    <selectionEntry id="mh-rad-chaos-space-marines-a505-05af-bd44-56b6" name="Aegis Defense Line" publicationId="ca571888--pubN73893" page="79" hidden="false" collective="false" import="true" type="model">
      <profiles>
        <profile id="mh-rad-chaos-space-marines-acfc-9384-8119-d9d8" name="Aegis Defence Line" publicationId="ca571888--pubN73904" page="" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A model in cover behind a defence line has a 4+ cover save. If a unit Goes to Ground, then models from the unit gain +2 to the cover save from the defence line rather than +1. Models that are in base contact with a defence line are treated as being in base contact with any enemy models who are directly opposite them and in base contact with the other side of that defence line. Units charging an enemy that is behind a defence line count as charging through difficult terrain.</characteristic></characteristics></profile>
      </profiles>
      <entryLinks>
        <entryLink id="mh-rad-chaos-space-marines-0c63-f80e-a87b-c244" hidden="false" collective="false" import="true" targetId="mh-rad-chaos-space-marines-8732-6189-cd26-de94" type="selectionEntryGroup" />
        <entryLink id="mh-rad-chaos-space-marines-72f7-b924-082c-60be" name="Obstacles List" hidden="false" collective="false" import="true" targetId="mh-rad-chaos-space-marines-ad42-921f-358f-2970" type="selectionEntryGroup" />
      </entryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50.0" />
      </costs>
    </selectionEntry>
