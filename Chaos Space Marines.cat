              <profiles>
                <profile id="mh-rad-chaos-space-marines-b451-877d-4cf9-7b0b" name="Damocles Command Rhino" publicationId="ca571888--pubN68042" page="237" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
                  <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">11</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">11</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">11</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Tank</characteristic></characteristics></profile>
                <profile id="mh-rad-chaos-space-marines-ca8f-48b2-da72-d887" name="Focused Bombardment" publicationId="ca571888--pubN68042" page="237" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
                  <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Unlimited</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Ordnance 1, Lance, Twin-linked, Barrage, Large Blast</characteristic></characteristics></profile>
              </profiles>
              <rules>
                <rule id="mh-rad-chaos-space-marines-3962-762d-b7ff-4264" name="Geo-locator Beacon" publicationId="ca571888--pubN68042" page="237" hidden="false">
                  <description>Units arriving via Deep Strike which are part of the force containing the Damocles do not scatter if they choose to arrive within 24"</description>
                </rule>
                <rule id="mh-rad-chaos-space-marines-17ba-6cef-154a-3acb" name="Command Vox Relay" publicationId="ca571888--pubN68042" page="237" hidden="false">
                  <description>Allows the controlling player to add a 1 or -1 modifer to reserve rolls while in play.  Additionally, enemy models suffer a 1 to Deep Strike Mishap table rolls.</description>
                </rule>
                <rule id="mh-rad-chaos-space-marines-d1c9-29ba-0150-bad2" name="Focused Bombardment" publicationId="ca571888--pubN68042" page="237" hidden="false">
                  <description>Once per game, may call down a bombardment in the shooting phase.  May not move in the turn it shoots this weapon.</description>
                </rule>
              </rules>
