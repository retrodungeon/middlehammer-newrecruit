    <selectionEntry id="f3de-f12e-f641-4012-f9b7f" name="The Hounds of Abaddon" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="c4be-38f8-518e-85bc-f9b7f" name="Let Slip the Hounds" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Once per game, at the start of any of your turns after the first, you can declare a massed assault. For the duration of that turn, units from this Formation can charge in the Assault phase even if they made a Run move in the same turn. </description>
        </rule>
        <rule id="f2b3-95ca-171f-81ae-f9b7f" name="Khorne's Favor" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If a unit from this Formation makes a successful charge and the total rolled for its charge range is 8 or more (before modifiers), add 1 to the Strength of its models until the end of the Assault phase.</description>
        </rule>
        <rule id="7521-9dca-5791-f6b3-f9b7f" name="The Hounds of Abaddon" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any unit that has the option to take a Mark of Khorne must do so, but at no additional points cost. </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="bb70-2ea6-6c28-00ec-f9b7f" hidden="false" targetId="cb89-94a7-0d40-027f-f9b7f" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier type="set" field="hidden" value="false">
          <repeats />
          <conditions />
          <conditionGroups>
            <conditionGroup type="or">
