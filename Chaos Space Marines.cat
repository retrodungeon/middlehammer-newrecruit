    <profile id="mh-rad-chaos-space-marines-067e9186-0fba-6430-507f-4fbaaecd0d17" name="Scorpius Bolt Shells" publicationId="ca571888--pubN80998" page="85" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
