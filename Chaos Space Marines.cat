    <profile id="mh-rad-chaos-space-marines-a1d8-f9f3-865a-9faf" name="Melta Bombs" publicationId="ca571888--pubN106502" page="183" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
