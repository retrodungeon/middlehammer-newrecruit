    <profile id="mh-rad-chaos-space-marines-48ee-9a7f-07f1-22d0-night-" name="Tartaros Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save.  Maodels in Tartarus armour may make Sweeping Advances in combat unlike other patterns of Terminator armour. If a model with Tartarus pattern armour is joined by a character equipped with a different pattern of Terminator armour or vice versa, this ability is lost. </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-b7d58e49-6b8c-56f3-df2c-472ac811a571-night-" name="Trophies of Judgement" publicationId="ca571888--pubN113187" page="57" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides Fear special rule</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-350c-4efd-4ea5-de8c-night-" name="Drop Pod" publicationId="ca571888--pubN80998" page="49" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
      <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-topped</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-4791-ed93-bcc1-a7ed-night-" name="Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save. Depending on its particular pattern, Terminator armour may also confer additional rules and abilities to its wearer.</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-768c-58bf-6df4-a38f-night-" name="Heavy Chainblade" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-6110-42cb-a1ee-b9b8-night-" name="Saturnine Terminator Armour" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Saturnine Terminator armour affords a +2 armour save and a 5+ Invulnerable save. No Run moves.
Units containing more than 25% Carapace Weapon Heavy Bolters and Autocannons (combined) become Heavy Support Choices. THIS IS NOT ENFORCED BY BATTLESCRIBE (YET)</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-239e677c-9ec8-69cf-7923-7a344b33711f-sons-o" name="Banestrike Bolter Shells" publicationId="ca571888--pubN113187" page="9" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Reduces range of Boltgun and Combi-bolters to 18" and provides the Banestrike rule.  Weapons with Banestrike change their AP value to 3 on "to-wound" rolls of a 6. </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-59304e4a-18c6-1283-455b-f79c559b207f-sons-o" name="Cataphractii Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
