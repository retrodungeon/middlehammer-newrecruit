    <selectionEntry id="mh-rad-chaos-space-marines-ba9221f1-7a8a-4d55-0c30-ca4c502fab8d-word-b" name="Anvillus Pattern Dreadclaw Drop Pod (DT)" publicationId="ca571888--pubN80998" page="45" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="mh-rad-chaos-space-marines-ba9221f1-7a8a-4d55-0c30-ca4c502fab8d-word-b-maxSelections-word-b" value="1.0">
