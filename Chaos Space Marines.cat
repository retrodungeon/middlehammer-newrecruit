        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Rapid Fire</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
      </characteristics>
    </profile>
    <profile name="Chaos Lord in Terminator Armour" id="f4ed-60c6-09ed-a2f1" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">6</characteristic>
