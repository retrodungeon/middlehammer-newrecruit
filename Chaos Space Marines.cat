    <selectionEntryGroup id="mh-rad-chaos-space-marines-314b-76e2-509a-9d48" name="Rite of War" hidden="false" collective="false" import="true">
      <modifiers>
        <modifier type="set" field="mh-rad-chaos-space-marines-a77b-7d4a-9dee-e188" value="0.0">
