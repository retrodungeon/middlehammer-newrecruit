    <profile id="mh-rad-chaos-space-marines-d890-1b84-bbd9-12d3" name="Frag Grenades" publicationId="ca571888--pubN106502" page="182" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
