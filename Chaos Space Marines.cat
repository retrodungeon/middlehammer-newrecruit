    <selectionEntry id="b728115c-2eef-e0c8-daaa-9cb1a5a51c99-f9b7f" name="The Black Mace" page="0" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="b7661c2d-7d23-7c62-dc9e-f707fcc152bc-f9b7f" name="The Black Mace" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User </characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Cursed, Daemon Weapon, Fleshbane</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="198ff03d-cd10-f868-706a-5815b7ba37db-f9b7f" name="Cursed" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When a model suffers an unsaved wound, it must take a Toughness test. If it fails, remove the model with no saves allowed.

At the end of a phase that the Black Mace caused an unsaved wound, all non vehicle models within 3" must take a toughness test. If failed, remove with no saves allowed.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="b7243ed2-a32d-3081-9114-a3f9d0e00eaa-f9b7f" hidden="false" targetId="a348281d-5867-be8c-1261-65cceb472663-f9b7f" type="rule">
