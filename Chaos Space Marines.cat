    <profile id="mh-rad-chaos-space-marines-59304e4a-18c6-1283-455b-f79c559b207f-death-" name="Cataphractii Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Cataphractii Terminator armour affords a +2 armour save and a 4+ Invulnerable save. No Run moves, Overwatch attacks, or Sweeping Advance. </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-0d8bdd64-39f0-7759-d8ca-0702ee1f0fd0-death-" name="Iliastus Assault Cannon" publicationId="ca571888--pubN113187" page="97" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4, Rending, Malfunction</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-9ad2-2e0f-1261-f494-death-" name="Power Dagger" publicationId="ca571888--pubN113187" page="89" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">-1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Specialist Weapon, Rending</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-48ee-9a7f-07f1-22d0-death-" name="Tartaros Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save.  Maodels in Tartarus armour may make Sweeping Advances in combat unlike other patterns of Terminator armour. If a model with Tartarus pattern armour is joined by a character equipped with a different pattern of Terminator armour or vice versa, this ability is lost. </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-808b-34b7-2ca8-29fd-death-" name="Tempest Rockets" publicationId="ca571888--pubN80998" page="47" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">60"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Sunder, One-shot</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-16f6-887b-504f-56da-death-" name="Hellstrike Missiles" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">72"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Sunder, One-Shot</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-350c-4efd-4ea5-de8c-death-" name="Drop Pod" publicationId="ca571888--pubN80998" page="49" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
      <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-topped</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-4791-ed93-bcc1-a7ed-death-" name="Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save. Depending on its particular pattern, Terminator armour may also confer additional rules and abilities to its wearer.</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-52ac-91fa-4fc7-e013-death-" name="Chem-munitions" publicationId="ca571888--pubN113187" page="38" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">All flame weapons (flamers, Heavy flamers, hand flamers, combi-flamers, or Flamestorm Cannons) in a unit or on a vehicle may be upgraded to Chem-munitions.  All eligible weapons must be upgraded.    Weapons with this rule gain both Shred and Gets Hot special rules. </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-3bc6-3f6e-aa96-c6c4-death-" name="Power Scythe" page="" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed, Reaping Blow</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-6110-42cb-a1ee-b9b8-death-" name="Saturnine Terminator Armour" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Saturnine Terminator armour affords a +2 armour save and a 5+ Invulnerable save. No Run moves.
Units containing more than 25% Carapace Weapon Heavy Bolters and Autocannons (combined) become Heavy Support Choices. THIS IS NOT ENFORCED BY BATTLESCRIBE (YET)</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-889ea663-40f5-0ecc-7ba9-4b68e2955022-empero" name="Grenade Harness" publicationId="ca571888--pubN80998" page="83" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
