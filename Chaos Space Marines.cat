    <selectionEntry id="338a-2e27-7fa3-58e2-f9b7f" name="Night Lords" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="e730-91dc-4eaa-d88c-f9b7f" name="In Midnight Clad" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units that have the VotLW special rule have the Fear, Night Vision, and Stealth special rules.</description>
        </rule>
        <rule id="2aad-f374-b4e8-a49e-f9b7f" name="Skyborne Horror" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units of Raptors are Troops choices instead of Fast Attack choices.</description>
        </rule>
        <rule id="c7de-670b-1990-7f5c-f9b7f" name="Terror Tactics" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units that are locked in combat with any units from a Night Lords detachment or formation must subtract 2 from their Leadership when taking Fear tests.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="547b-ca02-dbf6-9ed0-f9b7f" name="New InfoLink" hidden="false" targetId="280d-1a0c-5916-3012" type="rule">
