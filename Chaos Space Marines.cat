          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Magnus has line of sight to every unit on the battlefield when determining the targets of his psychic powers.</description>
        </rule>
        <rule id="ff77-b0c7-fbc1-66a9-f9b7f" name="Unearthly Power" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Magnus harnesses Warp Charge points on a result of 2+ when attempting to manifest psychic powers.</description>
        </rule>
      </rules>
