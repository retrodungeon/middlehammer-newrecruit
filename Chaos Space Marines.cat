-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="1a8f9dd8-49ba-40b3-2985-7fd6774eb809-6e3184a" name="CCW" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="1a8f9dd8-49ba-40b3-2985-7fd6774eb809-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="ea966f12-1bbb-9d9b-0977-d2274c6ed15d-6e3184a" name="Chainaxe" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="8" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="ea966f12-1bbb-9d9b-0977-d2274c6ed15d-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="b6da0100-9094-91b8-6c6d-464af2d4ef1f-6e3184a" name="Lightning Claw" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="b6da0100-9094-91b8-6c6d-464af2d4ef1f-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="837fc599-4838-29bd-b384-342ef81f0b61-6e3184a" name="Power Weapon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="837fc599-4838-29bd-b384-342ef81f0b61-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionE