        <profile id="4945-38c5-b949-65f0-f9b7f" name="Hellflame" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
