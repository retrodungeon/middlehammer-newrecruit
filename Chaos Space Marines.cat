        <infoLink name="Bolt Pistol" id="6807-8808-abe2-af9c" hidden="false" targetId="e9ac-c779-51bb-3c9a" type="profile" />
      </infoLinks>
      <profiles>
        <profile name="Xyclos Needler" id="6f66-e9e0-5498-c9a3" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">12"</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">2+</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">6</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 1</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2" />
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Chaos Undivided" id="5f9c-e640-cee9-78bb" hidden="false">
          <description>Models bearing this mark may re-roll failed Morale checks</description>
        </rule>
        <rule name="The Chirurgeon" id="8c19-96e1-124f-9298" hidden="false">
          <description>Fabius has a 4+ invulnerable save</description>
        </rule>
        <rule name="Rod of Torment" id="5c47-c882-3c3a-2c1f" hidden="false">
          <description>The Rod of Torment counts as a close combat weapon. However, any opponent suffering one or more wounds from the Rod of Torment is immediately disabled by the pain and removed as a casualty even if they have any remaining wounds.</description>
        </rule>
        <rule name="Xyclos Needler" id="a000-9c88-7d01-5167" hidden="false">
          <description>Always wounds on a roll of 2+. If the target is killed, place a Blast marker centered on the exploding model and roll to hit other models using the rules for blast weapons. The attacks have a Strength equal to the exploding model's Toughneed, and an AP value equal to the victim's saving throw. The Needler has a Strength of 1 against vehicles.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Retinue" id="7ef6-ab1b-6c11-c2df" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="94b0-e030-f39c-546e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <entryLinks>
            <entryLink name="Chaos Rhino" id="d490-7da6-9518-9723" collective="false" hidden="false" import="true" targetId="1692-5ed3-6679-24d4" type="selectionEntry">
              <constraints>
                <constraint id="8887-b943-873a-6d74" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
              </constraints>
            </entryLink>
          </entryLinks>
          <rules>
            <rule name="Genetic Corruption" id="2655-0e34-1e99-76f5" hidden="false">
              <description>Roll a D6 for each Enhanced Warrior at the start of the battle, after both sides have set up, but before the first turn takes place. On a D6 roll of 1 roll against on the table below.
1: The warrior goes insane and attacks his comrades. Remove the model and D3 randomly selected models below.
2 - 5: The warrior's immune system totally breaks down and he dies horribly within a few moments. Remove the model.
6: This warrior's abilites are boosted to superhuman levels. Add +1 to all his characteristics, apart from his save. Sadly he does not survive the battle, so counts as victory points.</description>
            </rule>
          </rules>
          <selectionEntries>
