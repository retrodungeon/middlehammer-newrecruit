    <selectionEntry id="mh-rad-chaos-space-marines-8a6d-1cc1-8aca-5a5a" name="Master of Armour" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="mh-rad-chaos-space-marines-7358-de21-3ee3-1c8b" value="0">
          </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="mh-rad-chaos-space-marines-7358-de21-3ee3-1c8b" type="max" />
      </constraints>
      <rules>
        <rule id="mh-rad-chaos-space-marines-72b2-66ae-1484-a2e7" name="Master of Armour" publicationId="ca571888--pubN80998" page="100" hidden="false">
          <description>A Single Sicaran Battle Tank or a Predator of any type available in the Legiones Astartes may be taken as a Company Command vehicle, counting as a HQ choice and for the purposes of selected this Rite only, counts as having the MAster of the Legion rule allowing this rite to be taken. They may also be the army's Warlord. If this is the case instead of rolling for a Warlord Trait, this vehicle has the Super-heavy Command Tank cehicle upgrade (regardless of its type) and has +1 BS at no additional cost.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-chaos-space-marines-f2cf-f729-58be-e3aa" name="Super-heavy Command Tank" hidden="false" targetId="mh-rad-chaos-space-marines-aaaf-37f2-e6e0-7a2c" type="rule" />
