    <selectionEntry id="2ed8-cefb-4372-f224-f9b7f" name="The Ravagers" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="77d2-2012-8c40-57c6-f9b7f" name="Sight of the Third Eye" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If the Chosen Champion from Draznicht's Ravagers is alive at the start of your turn, you can pick one of the units from the Formation to benefit from his prescience. For the duration of your turn, that unit can re-roll all failed To Hit rolls.</description>
        </rule>
      </rules>
      <infoLinks>
