      <rules>
        <rule name="Destroyer Hive" id="ea2b-be3a-4e35-b1a9" hidden="false">
          <description>When Typhus charges into combat he counts as using frag and blight grenades. When he is charged, Typhus and his retinue count as being in cover. In addition, the Nurgle's Rot carried by Typhus causes wounds on a 5+ instead of a 6.</description>
        </rule>
      </rules>
