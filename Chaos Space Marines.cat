          <rules>
            <rule name="Daemonic Possession (Chaos Undivided)" id="6654-7c60-395f-905a" hidden="false">
              <description>If the vehicle had a troop carrying capability then it can no longer carry any troops. The Daemon controls the vehicle and may ignore the effects of any stunned or shaken results.</description>
            </rule>
