          <rules>
            <rule name="Destroyer (Khorne)" id="2bc1-1110-2d3d-76ec" hidden="false">
              <description>If the vehicle makes a tank shock attack on an enemy unit and the enemy does not fall back, then roll a D6 for each model forced to move out of the way of the vehicle. On a D6 roll of 4+ the model suffers a wound with normal armour saves allowed.</description>
            </rule>
          </rules>
