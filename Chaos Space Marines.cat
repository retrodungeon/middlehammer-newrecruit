              </infoLinks>
              <rules>
                <rule name="Body Weapons" id="9877-12bd-33ac-41c7" hidden="false">
                  <description>Obliterators may only fire one weapon in any Shooting phase and each model may fire a different weapon from those available</description>
                </rule>
                <rule name="Obliterator Weapons" id="3417-1363-c189-2e41" hidden="false">
                  <description>Obliterators can use different weapons in different phases, so they may shoot with a ranged weapon and then assault using power fists</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
