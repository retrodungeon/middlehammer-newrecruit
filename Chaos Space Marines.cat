      <rules>
        <rule id="b09b-e257-c0a7-9b60-f9b7f" name="Enhanced Warriors" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>One Chaos Space Marine unit in the same army as Bile may be made into Enhanced Warriors.

The nominated unit has Fearless and +1 Strength for the entire game.</description>
