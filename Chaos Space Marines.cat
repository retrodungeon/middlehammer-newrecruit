      <profiles>
        <profile id="mh-rad-chaos-space-marines-7b14-baa5-c621-b2fe" name="Legion Cerberus Heavy Tank Destroyer" publicationId="ca571888--pubN80998" page="66" hidden="false" typeId="mh6-56656869636c65202853757065722048656176792923232344415441232323" typeName="Vehicle (Super Heavy)">
          <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">14</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">14</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">13</characteristic><characteristic name="Structure Points" typeId="mh6-53747275637475726520506f696e747323232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Super-heavy Vehicle</characteristic></characteristics></profile>
        <profile id="mh-rad-chaos-space-marines-fcd0-8fe4-1a50-84a7" name="Reactor Blast" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Should the Cerberus lose its last Hull Point, it rolls on the Catastrophic Damage table with a 1 modifier. The vehicle is then removed.</characteristic></characteristics></profile>
