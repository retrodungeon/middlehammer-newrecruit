    <selectionEntry id="b345-493e-9046-8f93-f9b7f" name="Helcult" page="0" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="3a36-20e8-fb38-6864-f9b7f" name="Apocalyptic Fury" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Helbrute has Rage. When rolling to hit with the Helbrute's Melee attacks, any unmodified rolls of a 1 hit a friendly model instead. Randomly determine (for each roll of a 1) which models within 6" of the Helbrute are hit instead.</description>
        </rule>
        <rule id="db3f-ddcb-2d0a-ab55-f9b7f" name="Living Idol of Chaos" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>As long as the Helbrute is alive, the Cultists have Fearless. If the Helbrute is destroyed, the cultists lose Fearless and gain Zealot.</description>
        </rule>
        <rule id="420a-ae67-2996-96d9-f9b7f" name="Human Shields" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If the Helbrute is partially obscured from one or more of the formations cultists, it recieves a 3+ Cover save but a model from the cultist unit is removed (without saves) for each successful save as a result of this rule.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="f4fa-10b7-0e31-0ca7-f9b7f" name="Chaos Cultists" hidden="false" collective="false" defaultSelectionEntryId="7490-ed47-694e-f86e-f9b7f">
