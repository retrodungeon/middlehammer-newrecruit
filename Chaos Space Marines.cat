    <profile id="mh-rad-chaos-space-marines-22211dfb-04d0-f8ba-5794-583f1883685f-empero" name="Phoenix Spear" publicationId="ca571888--pubN113187" page="28" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
