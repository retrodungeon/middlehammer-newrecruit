          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units of Khorne Berzerkers are Troops choices instead of Elites choices.</description>
        </rule>
        <rule id="8c9d-8705-e9b0-1db9-f9b7f" name="The Blessing of Khorne" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units that have the VotLW special rule have the Adamantium Will special rule.</description>
        </rule>
        <rule id="5e42-2b79-7587-2e85-f9b7f" name="The Butcher's Nails" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units that have the VotLW special rule have the Fearless and Furious Charge special rules.</description>
