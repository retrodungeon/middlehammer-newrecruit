          <infoLinks>
            <infoLink name="Close-Combat Weapon" id="a325-bbf5-5cc0-92eb" hidden="false" targetId="662b-09f1-bd5b-b334" type="profile" />
            <infoLink name="Lesser Daemon" id="94ae-8106-2b98-1494" hidden="false" targetId="e31a-f70b-f241-4d79" type="profile" />
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
