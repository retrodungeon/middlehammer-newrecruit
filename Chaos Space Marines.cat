          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="2d04-abae-d44e-b3c4-f9b7f" name="Nurgling Infestation" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any unit that attacks the Plaguereaper in the fight sub-phase suffers a 3D6, Strength 3, AP- hit at Initiative step 3 (regardless if the plaguereaper is destroyed or not).</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers>
        <modifier type="set" field="hidden" value="false">
          <repeats />
          <conditions />
          <conditionGroups>
