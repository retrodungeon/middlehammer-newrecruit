    <selectionEntry id="be3e-2b76-2fc2-46ce-f9b7f" name="Cult of Destruction (Apocalypse)" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="bf0e-b287-50b6-1332-f9b7f" name="Las-Destructor" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
          <profiles />
