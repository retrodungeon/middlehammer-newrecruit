    <profile id="mh-rad-chaos-space-marines-9b7588a6-5b9a-a011-dbb2-ed73a34a521f" name="Heavy Conversion Beamer (3)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
