            <rule id="72a7-46c8-f3ad-2c88-cf969" name="Murderous Strike" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Attacks with this special rule cause Instant Death on a To Wound roll of a 6. Roll any viable saves against these Instant Death-causing wsounds separately to any other wounds the attack causes.</description>
