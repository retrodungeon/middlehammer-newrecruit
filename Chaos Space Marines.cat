    <selectionEntry id="c086-3c8d-92f5-5490-f9b7f" name="The Chosen of Abaddon (Apocalypse)" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="be06-6bd2-ffbb-9a68-f9b7f" name="Blessed by the Chaos Gods" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each Lord or sorceror starts the battle with 1 chaos boon. Roll separately for each character.</description>
        </rule>
        <rule id="1db7-1720-cef0-7994-f9b7f" name="Protect the Despoiler" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any unit in this formation within 12" of Abaddon gets Fearless.</description>
