        <rule id="7746-cc49-27e5-6b90-f9b7f" name="Vessels of Chaos" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the beginning of each sub-fight phase, roll a single  D3 for the entire and consult the table on the Possessed Profile in Codex: Chaos Space Marines. This awarded mutation lasts until the end of turn.</description>
