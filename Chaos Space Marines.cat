    <selectionEntry id="3de21b5d-6727-1747-c64d-df79898949e1-f9b7f" name="Scrolls of Magnus" page="0" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="0900766a-1438-2905-295b-791397de3f7c-f9b7f" name="Scrolls of Magnus" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the beginning of each of the bearers turns, the bearer may choose to gain an extra power for the rest of the game.  Roll a D6 (and consult the chart in Codex:CSM under its profile) and then randomly generate a power from the selected discipline.  Each time the bearer uses the scrolls (including re-rolls), it must take a Str 3, AP,1 Ignores Cover hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3de21b5d-6727-1747-c64d-df79898949e1-maxInRoster-f9b7f" type="max" />
