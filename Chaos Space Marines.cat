    <selectionEntry id="78b1-6c65-426b-cbed-f9b7f" name="Heldrake Terror Pack" page="122" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="acba-f12b-0880-0c87-f9b7f" name="Rising Terror" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units that are within 12" of two models from a Heldrake Terror Pack reduce their Leadership by 1. Enemy units that are within 12" of three models from a Heldrake Terror Pack instead reduce their Leadership by 2, or by 3 if within 12" of four models from the Heldrake Terror Pack.</description>
        </rule>
        <rule id="516e-8dc1-9423-335c-f9b7f" name="Merciless Pursuit" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When performing a Vector Strike with a model from a Heldrake Terror Pack against a target unit that is Pinned, Falling Back, or has Gone to Ground, the target unit suffers D6 S7 AP2 hits instead of only 1 hit.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="72eb-0be5-822b-983a-f9b7f" name="Heldrakes" hidden="false" collective="false" defaultSelectionEntryId="9b2c-a661-a712-30f4-f9b7f">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <constraints>
