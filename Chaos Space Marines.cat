              </costs>
              <profiles>
                <profile name="Gatling Cannon (Frag)" id="a356-cb41-0495-56de" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
                  <comment>Shoots 3 Missiles per shot basically</comment>
                  <characteristics>
                    <characteristic name="Range" typeId="deb8-131d-bdcf-1376">48"</characteristic>
