              <selectionEntries>
                <selectionEntry id="mh-rad-chaos-space-marines-fd97-a4eb-1389-8e3f" name="Sons of Horus" hidden="false" collective="false" import="true" type="upgrade">
                  <modifiers>
                    <modifier type="set" field="hidden" value="true">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="mh-rad-chaos-space-marines-4ce4-eab0-1bee-542b" type="equalTo" />
                            </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                    <modifier type="set" field="mh-rad-chaos-space-marines-083c-fb40-0f36-91c3" value="1">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="mh-rad-chaos-space-marines-4ce4-eab0-1bee-542b" type="equalTo" />
                            </conditions>
