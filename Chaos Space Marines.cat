            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">5</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">-/4++</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="60f4-523f-d303-90ad-f9b7f" name="Psyker (Mastery Level 3)" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Be'lakor knows ALL the powers of the Telepathy Discipline</description>
        </rule>
        <rule id="429f-2235-4e37-9656-f9b7f" name="Shadow Form" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Be'lakor has a 4+ Invunerable save and shrouded. He automatically passes Dangerous Terrain tests.</description>
        </rule>
        <rule id="d39f-a9fd-2230-8722-f9b7f" name="Lord of Torment" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If one or more units fail a Ld check in the previous turn, Be'lakor gets +D3 Warp charges in the next psychic phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="3a31-0d5b-471a-60f9-f9b7f" hidden="false" targetId="3eda-669d-bd54-e3c0" type="rule">
