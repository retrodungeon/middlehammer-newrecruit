    <selectionEntry id="4b7a-adaf-c469-b2b6-cf969" name="Hellforged Hunting Pack" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="9fb9-35dc-4164-943d-cf969" name="Follow the Alpha Engine" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If this formations brass scorpion makes a successful charge, all other models in the formation can re-roll subsequent failed charge rolls in the same Assault phase.</description>
        </rule>
        <rule id="cc0f-7d2c-9070-3320-cf969" name="Swift and Bloody Vengeance" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each time a model in this formation is destroyed, all other models gain +1 Attack</description>
        </rule>
