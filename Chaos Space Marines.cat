    <selectionEntry name="Chaos Land Raider" id="fa36-6237-9cf3-0f4d" collective="false" hidden="false" import="true" type="upgrade">
      <comment>Dedicated Transport Option - Needed for dedications to work for Chosen correctly.</comment>
      <categoryLinks>
        <categoryLink name="Dedicated Transport" id="1739-7ec2-3c5b-46c8" hidden="false" primary="true" targetId="168b-a772-94f7-83f5" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="250" />
      </costs>
      <entryLinks>
        <entryLink name="Chaos Vehicle Upgrades" id="5539-4ea7-1b27-581b" collective="false" hidden="false" import="true" targetId="f364-8b4b-0063-e9ed" type="selectionEntryGroup" />
      </entryLinks>
      <infoLinks>
        <infoLink name="Chaos Land Raider" id="a468-ca04-56fb-1558" hidden="false" targetId="45e4-6250-0ecf-34fc" type="profile" />
        <infoLink name="Lascannon" id="893f-8b3c-7f4a-9056" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="2x Twin-Linked Lascannons" />
          </modifiers>
        </infoLink>
        <infoLink name="Heavy Bolter" id="aac6-bb7a-6db1-91f8" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Twin-Linked Heavy Bolter" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Fire Control" id="027d-7fd4-4526-99ab" hidden="false">
          <description>The vehicle may always fire one additional weapon system to those that would normally be able to be fired giving the speed or status of the vehicle. This shot may even be targetting at a different target than that engaged by the crew. It is conducted with a BS 2.</description>
        </rule>
        <rule name="Infernal Device" id="f643-0297-f4c6-cc78" hidden="false">
          <description>If the crew are stunned then the vehicle may still be moved directly ahead in a straight line up to its maximum move.</description>
        </rule>
      </rules>
    </selectionEntry>
  <selectionEntry name="Abaddon the Despoiler" id="71cf-98df-61ce-bfe0" hidden="false" import="true" type="unit">
      <costs>
