    <selectionEntry id="c442-5d7e-f40b-b089-f9b7f" name="Cyclopia Cabal" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="0092-721e-ddf3-4e42-f9b7f" name="Shroud of Deceit" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of each of your Psychic phases, select one model from the Cyclopia Cabal to lead it in a dark ritual. That model can attemp to manifest the Shroud of Deceit psychic power. For each other Sorcerer from this formation that is within 12", add one dice to the Psychic Test - these dice do not cost any Warp Charge points.</description>
        </rule>
      </rules>
      <infoLinks>
