hit, add a crazed marker. At the start of the next movement phase, roll a D3 (and consult the chart in its profile in Codex: Chaos Space Marines) for each marker and then remove the markers. (7th Ed wording)</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="0c128586-f4d0-2c40-63bb-ef92ad027338-6eec309" name="Range Weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="9e31e180-4325-3b85-d092-305892f3df89-6eec309"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0c128586-f4d0-2c40-63bb-ef92ad027338-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="9e31e180-4325-3b85-d092-305892f3df89-6eec309" name="Multi-melta" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9e31e180-4325-3b85-d092-305892f3df89-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="c4770237-2331-ed9f-e348-55db5510b727-6eec309" name="Power fist" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c4770237-2331-ed9f-e348-55db5510b727-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="f7e2e389-1731-616b-d520-5a289aec5fa0-6eec309" name="Combi-bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f7e2e389-1731