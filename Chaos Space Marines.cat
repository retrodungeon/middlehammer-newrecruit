        <profile name="Fueled by Rage" id="97ea-5220-0fef-dee7" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">For every Structure Point this model has lost, it gains three additional Attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tracked Behemoth" id="8fd8-ee83-8c31-071a" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model may Tank Shock or Ram using the Thunderblitz table, in the same manner as a Super-Heavy Vehicle, but it may not make Stomp Attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Destroyer" id="d71a-cb50-efba-11d4" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Melee attacks made by this model count as having the Destroyer rule.</characteristic>
          </characteristics>
        </profile>
