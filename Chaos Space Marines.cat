                <selectionEntry id="mh-rad-chaos-space-marines-d768afd7-dcf2-b2b4-ba38-ec74900ba3da" name="Saboteur" publicationId="ca571888--pubN113187" page="89" hidden="false" collective="false" import="true" type="upgrade">
                  <modifiers>
                    <modifier type="set" field="hidden" value="true">
                      </modifier>
                    </modifiers>
                  <constraints>
                    <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-d768afd7-dcf2-b2b4-ba38-ec74900ba3da-minSelections" type="min" />
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-d768afd7-dcf2-b2b4-ba38-ec74900ba3da-maxSelections" type="max" />
                  </constraints>
                  <rules>
                    <rule id="mh-rad-chaos-space-marines-118591f0-3c6e-53f1-4761-0af2a3a938a1" name="Lone Killer" publicationId="ca571888--pubN113187" page="89" hidden="false">
                      <description>May not fulfil a compulsory HQ choice nor join other units</description>
                    </rule>
                    <rule id="mh-rad-chaos-space-marines-8cfc332f-fe74-e8a2-8ef1-bc21e575a484" name="Special Deployment" publicationId="ca571888--pubN113187" page="89" hidden="false">
                      <description>Must begin the game in reserve and does not count towards the max number of units in reserve.  Deployed via reserve rules and have Outflank</description>
                    </rule>
                    <rule id="mh-rad-chaos-space-marines-da05f14c-ee48-7a8d-f8d2-aed12bf2d26f" name="Sabotage" page="" hidden="false">
                      <description>At the moment the Saboteur enters play, a special Sabotage attack is inflicted on the enemy. Controlling player selects a single enemy unit or fortification on the table. Sagotaged unit suffers D6 Srt 6 AP 3 hits if it has a toughness value, or a single automatic penetrating hit at AP2.  Cover saves may not be taken.</description>
                    </rule>
                  </rules>
                  <infoLinks>
                    <infoLink id="mh-rad-chaos-space-marines-afd7-815d-06a6-c2ab" name="New InfoLink" hidden="false" targetId="mh-rad-chaos-space-marines-7be155f9-ef45-9937-8e60-2c588cb88201" type="profile" />
