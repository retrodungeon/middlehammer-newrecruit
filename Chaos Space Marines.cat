    <selectionEntry id="5792-6a7d-3f61-a09e-f9b7f" name="Fist of the Gods" page="124" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="92be-1639-16e7-0a09-f9b7f" name="Dark Wards" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All vehicles form the Fist of the Gods have a 6++ save whilst they are within 12" of their Warpsmith.</description>
        </rule>
        <rule id="6a9f-e2fd-71c0-cd56-f9b7f" name="Unholy Blessings" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Warpsmith from this Formation has a +1 bonus when making attempts to repair a vehicle from its Formation.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
