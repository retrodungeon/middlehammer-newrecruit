        <selectionEntry name="Searchlight" id="0884-e45c-24d4-3e0f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8799-4bbf-3cc0-328a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="1" />
          </costs>
          <rules>
            <rule name="Searchlight" id="3f61-59cc-56bf-8031" hidden="false">
              <description>Used during Night Fighting missions. Allows one enemy unit spotted by the vehicle to be fired at by any other friendly unit in range and that has line of sight. But on the next turn the vehicle can be fired at by any enemy unit that has ranged and line of sight.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Smoke Launcher" id="e003-0c57-b19e-62c4" collective="false" hidden="false" import="true" type="upgrade">
