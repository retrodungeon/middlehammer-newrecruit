      <rules>
        <rule id="e423-db76-7779-87a9-f9b7f" name="Warpflame Strike" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Immediately after entering via Deep Strike, all enemy units within 6" of the Warptalons count as being hit with a weapon with Blinded.</description>
        </rule>
