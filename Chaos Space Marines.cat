    <selectionEntryGroup id="mh-rad-chaos-space-marines-befa-6205-342b-50d0" name="Exotic Melee Weapons" hidden="true" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-chaos-space-marines-6f2c-a221-7fcd-0081" type="max" />
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-7bc1-b1dd-75fe-ca7e" type="min" />
      </constraints>
      <rules>
        <rule id="mh-rad-chaos-space-marines-f282-aa46-1f1a-9a2b" name="Exotic Melee Weapns" hidden="false">
          <description>Any Independent Character may exchange a power fist for an Exotic Melee Weapon:
</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="mh-rad-chaos-space-marines-e513-35eb-42d6-b685" name="Accelerator Hammer" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-f8c9-edb1-827e-f1bd" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-f492-516c-3e7b-0310" name="Accelerator Hammer" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed, Sunder, Delayed Strike</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-chaos-space-marines-01df-981e-e795-9955" name="Delayed Strike" hidden="false">
              <description>The bearer of this weapon halves their Initiative and Attack value when using this weapon, rounding up.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="mh-rad-chaos-space-marines-13ac-9615-177e-6319" name="Two-Handed" hidden="false" targetId="mh-rad-chaos-space-marines-b11c-0ef4-af6b-d96f" type="rule" />
            <infoLink id="mh-rad-chaos-space-marines-bc59-5789-4551-2bf8" name="Sunder" hidden="false" targetId="mh-rad-chaos-space-marines-841f-9119-9f9d-5058" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-chaos-space-marines-4dcf-3bd9-4e30-4fd6" name="Aetheric Shredder Knife" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-b411-6c18-5760-9464" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-8ed0-e237-38ce-453b" name="Aetheric Shredder Knife" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Dimensional Edge</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-chaos-space-marines-3d59-0a30-692e-464a" name="Dimensional Edge" hidden="false">
              <description>Attacks from this weapon only ever cause wounds on a roll of 6, however no invulnerable saves or Feel No Pain rolls may be taken</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-chaos-space-marines-d729-1516-184f-764e" name="Arcanite Shock Maul" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-0d43-f455-ccc4-e728" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-32d6-4ade-0845-0f13" name="Arcanite Shock Maul" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed, Arcing Discharge</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-chaos-space-marines-d9a1-6fee-7de6-8369" name="Arcing Discharge" hidden="false">
              <description>Any model wounded by attacks from this weapon suffers the effects of the Concussive rule, whether the wound is saved or not.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="mh-rad-chaos-space-marines-9587-7447-9f4d-1f24" name="Concussive" hidden="false" targetId="mh-rad-chaos-space-marines-9d85-46f7-f5e6-a5f7" type="rule" />
            <infoLink id="mh-rad-chaos-space-marines-4d8f-5d11-4e2a-b370" name="Two-Handed" hidden="false" targetId="mh-rad-chaos-space-marines-b11c-0ef4-af6b-d96f" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-chaos-space-marines-9537-efdd-75e7-c362" name="Artificer Mirrorswords" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-99c2-46cf-1afd-03bb" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-5a62-5435-f1d2-c872" name="Artificer Mirrorswords" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Riposte, Paired Weapons (+1 Attack)</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-chaos-space-marines-e9e8-b6d3-fac2-8a52" name="Riposte" hidden="false">
              <description>Attacks directed at the wielder of these weapons suffer -1 to hit.</description>
            </rule>
          </rules>
