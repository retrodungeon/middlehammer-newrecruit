    <selectionEntry id="5084-bb34-db17-fff4-f9b7f" name="The Mindveil" hidden="true" collective="false" type="upgrade">
      <profiles>
        <profile id="92f2-f388-646e-3c1f-f9b7f" name="The Mindveil" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
