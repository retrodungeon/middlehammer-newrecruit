        <rule id="3861-3167-597b-cc95-f9b7f" name="Dedicated to Slaanesh" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The sonic dreadnought counts as being equipped with both Assault and Defensive grenades.</description>
        </rule>
        <rule id="d41e-6da2-5975-c733-f9b7f" name="Overdriven Sonic Weaponry" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The dreadnoughts sonic weaponry may be fired in Overdriven mode, in which all weapons must be fired in this manner. They all gain Gets Hot and Rending for these attacks.</description>
        </rule>
      </rules>
