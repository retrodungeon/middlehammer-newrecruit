    <selectionEntry id="mh-rad-chaos-space-marines-3736-b417-3bbd-72a4" name="Cyber-hawk" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-3736-b417-3bbd-72a4-maxSelections" type="max" />
      </constraints>
      <rules>
        <rule id="mh-rad-chaos-space-marines-0370-b7a6-9b74-9975" name="Cyber-hawk" publicationId="ca571888--pubN89821" page="263" hidden="false">
          <description>The Cyber-hawk may be placed anywhere on the table it may physically sit and may be moved elsewhere at the beginning of each of its owning player's turns.  Any unit with the Infantry type and the Legiones Astartes (White Scars) special rule that is firing upon an enemy which has at least one model within 6" of the Cyber-hawk may re-roll failed To Hit rolls of 1 and may re-roll charge distance.

Token representing the Cyber-hawk plays no other role in the game and may not be attacked, attack, or block line of sight.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="mh-rad-chaos-space-marines-5eb4-31b6-a79b-bcde" name="Damocles Command Rhino" publicationId="ca571888--pubN68042" page="237" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-chaos-space-marines-5eb4-31b6-a79b-bcde-maxSelections" type="max" />
        <constraint field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-chaos-space-marines-dbde-dbea-3a7e-dd1b" type="min" />
      </constraints>
      <profiles>
        <profile id="mh-rad-chaos-space-marines-9015-a27e-cfa5-ba42" name="Damocles Command Rhino" publicationId="ca571888--pubN68042" page="237" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
          <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">11</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">11</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">11</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Tank</characteristic></characteristics></profile>
        <profile id="mh-rad-chaos-space-marines-e0f4-13f9-b1fa-765b" name="Focused Bombardment" publicationId="ca571888--pubN68042" page="237" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Unlimited</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Ordnance 1, Lance, Twin-linked, Barrage, Large Blast</characteristic></characteristics></profile>
        <profile id="mh-rad-chaos-space-marines-b776-bc0b-0c88-6c0e" name="Damocles Command Rhino" publicationId="ca571888--pubN68042" page="237" hidden="false" typeId="307d-047f-ca13-706b" typeName="Transport">
          <characteristics><characteristic name="Capacity" typeId="8285-4205-b6cd-8473">6</characteristic><characteristic name="Fire Points" typeId="b270-a7f9-22b2-3702">2</characteristic><characteristic name="Access Points" typeId="d17b-0342-b1dc-b8e7">2</characteristic></characteristics></profile>
      </profiles>
      <rules>
        <rule id="mh-rad-chaos-space-marines-dfb5-4993-7b83-25c9" name="Geo-locator Beacon" publicationId="ca571888--pubN68042" page="237" hidden="false">
          <description>Units arriving via Deep Strike which are part of the force containing the Damocles do not scatter if they choose to arrive within 24"</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-1ccc-b98b-e0d4-ab85" name="Command Vox Relay" publicationId="ca571888--pubN68042" page="237" hidden="false">
          <description>Allows the controlling player to add a 1 or -1 modifer to reserve rolls while in play.  Additionally, enemy models suffer a 1 to Deep Strike Mishap table rolls.</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-254f-52fc-ca51-9d18" name="Focused Bombardment" publicationId="ca571888--pubN68042" page="237" hidden="false">
          <description>Once per game, may call down a bombardment in the shooting phase.  May not move in the turn it shoots this weapon.</description>
        </rule>
      </rules>
