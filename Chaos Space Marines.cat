                  <modifiers>
                    <modifier type="set" field="hidden" value="true">
                      <conditionGroups>
                        <conditionGroup type="or">
                          <conditions>
                            <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="mh-rad-chaos-space-marines-da40e015-a22c-ecc4-c9b8-0add9ff5d50f" type="instanceOf" />
                            <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="mh-rad-chaos-space-marines-e2bbc832-2c59-80ad-5a6f-6c8daeda79e2" type="instanceOf" />
