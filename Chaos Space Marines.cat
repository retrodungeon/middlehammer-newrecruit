    <selectionEntry id="1e5a-09d8-daa1-d0b7-f9b7f" name="Helm of the Third Eye" hidden="true" collective="false" type="upgrade">
      <profiles>
        <profile id="84e9-9fc4-2ce7-29d0-f9b7f" name="Helm of the Third Eye" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The wearer and any unit he joins can fire Overwatch even if they have the Slow and Purposeful special rule. Units that do not have the Slow and Purposeful special rule can instead fire Overwatch at BS2.</characteristic>
          </characteristics>
        </profile>
      </profiles>
