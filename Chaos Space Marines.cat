      <rules>
        <rule id="b67d-881c-ab1f-48a6-cf969" name="Blood Feast" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Keep a track of the casualties infliced by the Goredrinker. At the start of the controlling players turn, consult the chart in Codex: Khorne Daemonkin for what effects are bestowed upon the blade (effects are cumulative until model is lost or game ends).</description>
        </rule>
      </rules>
