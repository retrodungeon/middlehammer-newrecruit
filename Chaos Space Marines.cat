    <profile id="mh-rad-chaos-space-marines-ea4d-5db5-7d55-9d2c" name="Twin-Linked Iliastus Assault Cannon" publicationId="ca571888--pubN113187" page="97" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4, Rending, Malfunction, Twin-Linked</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-bfbd-2c3f-a707-205d" name="Recon Armour" publicationId="ca571888--pubN80998" page="" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Recon armour provides a +4 armour save and the model gains Infiltrate &amp; Move Through Cover</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-bd07-a2af-b873-22a8" name="Grenade Launcher (Frag)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">6</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1, Blast (3")</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-38d6-c6f6-ba78-1cc7" name="Grenade Launcher (Krak)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-6110-42cb-a1ee-b9b8" name="Saturnine Terminator Armour" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Saturnine Terminator armour affords a +2 armour save and a 5+ Invulnerable save. No Run moves.
Units containing more than 25% Carapace Weapon Heavy Bolters and Autocannons (combined) become Heavy Support Choices. THIS IS NOT ENFORCED BY BATTLESCRIBE (YET)</characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-239e677c-9ec8-69cf-7923-7a344b33711f-alpha-" name="Banestrike Bolter Shells" publicationId="ca571888--pubN113187" page="9" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Reduces range of Boltgun and Combi-bolters to 18" and provides the Banestrike rule.  Weapons with Banestrike change their AP value to 3 on "to-wound" rolls of a 6. </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-59304e4a-18c6-1283-455b-f79c559b207f-alpha-" name="Cataphractii Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Cataphractii Terminator armour affords a +2 armour save and a 4+ Invulnerable save. No Run moves, Overwatch attacks, or Sweeping Advance. </characteristic></characteristics></profile>
    <profile id="mh-rad-chaos-space-marines-0ae81fbd-a9d1-4327-f3df-1fc26dce2ab1-alpha-" name="Conversion Beamer (1)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
