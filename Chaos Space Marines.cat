    <profile id="mh-rad-chaos-space-marines-6474-3d3e-de26-3e9f" name="Rad/irad Cleanser" publicationId="ca571888--pubN66489" page="115" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
