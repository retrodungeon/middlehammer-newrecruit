      <rules>
        <rule id="498e-30b8-b3cf-8770-cf969" name="Frenzied Charge" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>when charging, roll 3D6 and add together for total charge distance.</description>
        </rule>
        <rule id="5f91-133c-6b6b-baa3-cf969" name="Runes of the Blood God" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any psyker who targets the scorpion suffers perils of the warp irrespective of a pass or failure.</description>
        </rule>
        <rule id="048b-0e07-e7bc-55ef-cf969" name="Doomsday Reactor" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Adds +2 modifier when rolling on the Catastrophic damage table.</description>
        </rule>
        <rule id="5a40-606f-0df7-4151-cf969" name="Multi-legged Terror" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When making stomp attacks, the scorpion makes D3+2 stomps</description>
        </rule>
      </rules>
