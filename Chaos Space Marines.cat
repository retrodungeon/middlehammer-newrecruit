      <rules>
        <rule id="eae6-443c-74e4-f87b-f9b7f" name="Son of Alpharius" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A squad joined by Arkos gains Counter-attacks. The squad loses the benefit when he leaves or is slain.</description>
        </rule>
        <rule id="2001-0297-278f-5680-f9b7f" name="Warlord Trait: Devious Tactician" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A player using Arkos as their warlord may re-roll the dice when determining who selects deployment zone and when seizing the initiative.</description>
        </rule>
      </rules>
