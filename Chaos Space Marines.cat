      <profiles>
        <profile name="Xyclos Needler" id="1b64-704e-0de8-c91e" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">12"</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">2+</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">6</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 3</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Always wounds on a 2+. Counts as 1 S versus vehicles.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rod of Torment" id="caca-f4d6-d70c-6872" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Any opponent suffering one or more wounds from the Rod of Torment is immediately removed as a casualty even if they have any remaining wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Characteristics" id="c699-b297-761e-85f9" hidden="false">
          <description>Fabius Bile has a randomized profile determined before each game. Roll a D6 to determine which profile is used for the entire game. This cannot be re-rolled.</description>
        </rule>
        <rule name="The Chirurgeon" id="0048-4f2c-d13b-e0ef" hidden="false">
          <description>Fabius has a 4+ invulnerable save.</description>
        </rule>
        <rule name="Enhanced Warriors" id="286e-8b24-ab93-7e1f" hidden="false">
          <description>Fabius Bile can 'enhance' Chaos Space Marine Squads under his command for +3 pts per model. Before each battle, after both sides have set up but before the first turn, roll a D6 for each enhanced squad and consult the below:
1 - Beserk Rage! Make an armour save for each warrior, removing any who fail. Those who are removed count as casualties for the purposes of Victory points. All survivors are +1 Strength
2-5 - Stable Mutitation. The enhanced warriors are +1 Strength and +1 Initiative
6 - Created a Monster! Each warrior adds +1 Strength, +1 Initiative and +1 Attack. Unfortunately, all these warriors will perish at the end of the game and so even the survivors will count as casualties for the purposes of Victory points.</description>
        </rule>
      </rules>
    </selectionEntry>
