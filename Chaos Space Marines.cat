          <characteristics><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">8</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">13</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">13</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Vehicle (Walker)</characteristic></characteristics></profile>
        <profile id="mh-rad-chaos-space-marines-bd88-2d0d-47da-e381" name="Reinforced Atomantic Shielding" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A Leviathan Dreadnought has a 4+ Invulnerable save. In addition, if the Leviathan suffers a Vehicle Explodes damage result, add D3 Str and D3" to the radius of the blast.</characteristic></characteristics></profile>
      </profiles>
      <rules>
        <rule id="mh-rad-chaos-space-marines-57b2-6a8a-402e-bc21" name="Crushing Charge" hidden="false">
          <description>When charging, the model inflicts 2 Hammer of Wrath attacks and gains 1 Initiative in the Assault phase of any turn in which it has charged.</description>
        </rule>
      </rules>
