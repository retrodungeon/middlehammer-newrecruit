                  </conditionGroups>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Coruscating Flame" id="ef82-e3e9-0cfe-7585" hidden="false">
                  <description>Any model attacking the vehicle in melee takes a Str D6, Ap 4 hit before resolving its attacks</description>
                </rule>
              </rules>
            </selectionEntry>
