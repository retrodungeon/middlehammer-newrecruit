            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1 </characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Armourbane, Fleshbane, Instant Death</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ed4752e5-fc0f-ad3a-423b-e78b860ddc3e-f9b7f" name="The Hand of Darkness" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The bearer may choose to make a single special attack using the profile presented instead of normal attacks.</description>
        </rule>
      </rules>
      <infoLinks>
