          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-f928fbec-3fae-bf16-b95c-cbfeee242824" name="Nostraman Mancatcher" publicationId="ca571888--pubN84158" page="225" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed, Ensnare</characteristic></characteristics></profile>
          </profiles>
