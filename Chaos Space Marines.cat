    <selectionEntry id="mh-rad-chaos-space-marines-a94a00ff-77c2-bc8c-1044-283e14795b55-word-b" name="Ashen Circle, The" publicationId="ca571888--pubN113187" page="75" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="mh-rad-chaos-space-marines-407a7d8c-446d-ed74-8ef0-a40e698cc36e-word-b" name="Axe-rake" publicationId="ca571888--pubN113187" page="75" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">6</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Grapple</characteristic></characteristics></profile>
      </profiles>
      <rules>
        <rule id="mh-rad-chaos-space-marines-2004ff54-0aa8-3b62-7e09-178e3ad7886b-word-b" name="Burning Descent" publicationId="ca571888--pubN113187" page="75" hidden="false">
          <description>If arriving via Deep Strike, all models within D6" suffer an immediate Strength 3 AP 5 hit.</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-49ad5371-2d46-de03-d279-7785d1ae4814-word-b" name="Scorched Earth" publicationId="ca571888--pubN113187" page="75" hidden="false">
          <description>This unit may always use a Hammer of Wrath attack, regardless of whether or not it has used its jump pack in the Movement phase, and these attacks are carried out at Str 5. The Hammer of Wrath attacks made by this unit are classed as Flamer type attacks.</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-a891ca94-0b5f-223f-399f-0291e2681f65-word-b" name="Bitter Duty" publicationId="ca571888--pubN113187" page="75" hidden="false">
          <description>May not be joined by Independent Characters</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-44d9d420-f962-f2f5-6e65-e5666ef5fdbc-word-b" name="Grapple" publicationId="ca571888--pubN113187" page="75" hidden="false">
          <description>Enemies attempting to fall back after losing an assault suffer -1 penalty.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="mh-rad-chaos-space-marines-1326-5a06-a3de-ab84-word-b" name="New CategoryLink" hidden="false" targetId="mh-rad-chaos-space-marines-a2ba-16b0-8590-b017" primary="false" />
        <categoryLink id="mh-rad-chaos-space-marines-5e34-3f7a-ea86-445b-word-b" name="New CategoryLink" hidden="false" targetId="mh-rad-chaos-space-marines-category" primary="false" />
