      <profiles>
        <profile id="1cca0062-e1a7-794b-a4d0-2eebba9499d9-f9b7f" name="Legacies of Ruin: Blood of Mackan" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
