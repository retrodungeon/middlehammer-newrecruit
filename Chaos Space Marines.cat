              <rules>
                <rule name="Warp Amp" id="57ba-df57-0b0f-e268" hidden="false">
                  <description>Enemy units within 12" from the vehicle are at -1 Ld, -2 Ld within 6" and -3 Ld if in contact. Does not stack with other Warp Amps.</description>
                </rule>
              </rules>
            </selectionEntry>
