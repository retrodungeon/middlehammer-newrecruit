          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="29a2-1022-0375-a8e8-f9b7f" name="Reknit Form" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The tower of skulls regains a lost hull point for every 10 wounds it inflicts that phase</description>
        </rule>
        <rule id="c617-5a13-51a9-62b7-f9b7f" name="Runes of the Blood God" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A psyker who targets the Tower suffers a perils of the warp regardless of circumstance. If they rolled a double 1 or double 6 they then suffer a Terrors of the Warp as well.</description>
        </rule>
