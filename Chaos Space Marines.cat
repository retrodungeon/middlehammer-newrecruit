    <selectionEntry id="mh-rad-chaos-space-marines-6683-c57a-0a90-e0f2" name="Malcador Assault Tank, Legion" publicationId="ca571888--pubN80998" page="81" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="mh-rad-chaos-space-marines-9877-af46-2c99-b1cb" name="Battle Speed" publicationId="ca571888--pubN80998" page="81" hidden="false">
          <description>When the Malcador Assault Tank moves Flat Out in the Shooting phase, it may choose to fire its traverse-mounted weapon at its full Ballistic Skill, either before or after the Flat Out move, but may fire no other weapons.</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-013b-ace3-f3a5-fd22" name="Lumbering Behemoth (Mournival)" hidden="true">
          <description> If the tank only moves 6” or less it may fire all of its weapons at full BS (ignoring that Ordnance weapons cause snap shots).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-chaos-space-marines-7d3d-d533-f9e6-b083" name="Legion Malcador Assault Tank" hidden="false" targetId="mh-rad-chaos-space-marines-0d05-348c-04c3-a0fc" type="profile" />
        <infoLink id="mh-rad-chaos-space-marines-3cfc-623c-96a5-2326" name="Obsidian Forged" hidden="false" targetId="mh-rad-chaos-space-marines-e508-0571-af75-d25c" type="rule" />
