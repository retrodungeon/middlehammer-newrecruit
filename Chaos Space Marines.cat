    <selectionEntry id="mh-rad-chaos-space-marines-4a689753-47b5-5897-1023-1b51b177ec61-world-" name="Red Butchers" publicationId="ca571888--pubN113187" page="22" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="mh-rad-chaos-space-marines-f78af474-e39a-9f06-2851-e69c7968fde0-world-" name="Unstoppable Charge" publicationId="ca571888--pubN113187" page="22" hidden="false">
          <description>May re-roll failed charge distances.</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-e3367655-99a9-6983-dbef-00d1697356f6-world-" name="Ravening Madmen" publicationId="ca571888--pubN113187" page="22" hidden="false">
          <description>Enemies always hit them on a 3 regardless of weapon skill.  May never be scoring regardless of the mission.</description>
        </rule>
        <rule id="mh-rad-chaos-space-marines-38a8d0f7-fb1e-0f11-3518-448b4ea9552d-world-" name="Hatred (Everything)" page="0" hidden="false"><description>This rule is often presented as Hatred (X) where X identifies a specific type of foe. If the special rule does not specify a type of foe, then the unit has Hatred against everyone. This can refer to a Faction, or a specific unit. For example, Hatred (Orks) means any model with the Ork Faction, whilst Hatred (Big Meks) means only Big Meks. A model striking a hated foe in close combat re-rolls all failed To Hit rolls during the first round of each close combat.</description></rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-chaos-space-marines-1eb33a2c-9135-cdb3-02e2-c899fead7a63-world-" name="Feel No Pain (6+)" hidden="false" targetId="mh-rad-chaos-space-marines-85da-2f19-3756-44de" type="rule" />
