    <selectionEntry id="2ea0-9eab-fa80-66b9-f9b7f" name="Crimson Slaughter" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="36d3-2a62-b8b7-d1ad-f9b7f" name="Renegades of the Dark Millenium" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>No units in a Crimson Slaughter Detachment or Formation can have the Veterans of the Long War special rule except Khorne Berzerkers, Plague Marines and Noise Marines.</description>
        </rule>
        <rule id="392b-86c7-9463-898c-f9b7f" name="Harbingers of the Tormented" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All models in a Crimson Slaughter force have Fear.</description>
        </rule>
      </rules>
