              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Searchlight" id="0470-8e66-97bd-e7ab" hidden="false">
              <description>Allow one unit spotted by the vehicle to be fired at by any other Chaos Space Marine units that are in range and have line of fire during a Night Fire mission, but allows the vehicle to be seen by all enemy units in their next shooting phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Smoke Launchers" id="8be2-0d8f-4d2d-fc05" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ab1b-b5f7-cedd-b8b9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="3" />
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="9766-b96f-9b19-9789" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Smoke Launchers" id="080f-5cd8-eecd-ef45" hidden="false">
              <description>One per game, after moving, the vehicle can trigger the smoke launchers. The vehicle may not fire in the same turn as it used its smoke launchers. Any penetrating hits scored by the enemy in the next shooting phase count as glancing hits instead.</description>
            </rule>
          </rules>
        </selectionEntry>
