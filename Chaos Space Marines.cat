    <profile id="mh-rad-chaos-space-marines-b8d20a55-69ff-eb96-e080-8f495bf99283" name="Legion Sergeant" publicationId="ca571888--pubN80998" page="202" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
