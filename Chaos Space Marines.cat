          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If this formation is the Primary Detachment, then you may re-roll the Warlord result.</description>
        </rule>
        <rule id="687d-6f08-f1af-0dcc-cf969" name="Lord of the Blood Host" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If this formation's HQ is in Deep Strike Reserve, you may re-roll the units reserve roll. If any of other units are placed within 6" of the HQ's Deep strike location, they may deep strike without scatter (including the turn he entered in).</description>
        </rule>
        <rule id="cfdf-3867-0e04-2ae1-cf969" name="The Blood Host Unleashed" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units suffer a -2 penalty to fear tests against units in this formation.</description>
