    <selectionEntry id="4199-5dbf-f73b-80af-f9b7f" name="Raptor Talon" page="125" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="0fca-c326-9df6-ce1f-f9b7f" name="Predatory Warriors" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units in this Formation can charge on the same turn they arrive from Deep Strike Reserve, but always count as making a disordered charge when they do so.</description>
        </rule>
        <rule id="601d-cec0-9b64-0812-f9b7f" name="Cacophonic War Cries" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units that are charged by two or more units from a Raptor Talon must subtract 2 from their Leadership until the end of the turn.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="f0b4-1e20-0800-2fac-f9b7f" name="Chaos Lord" hidden="false" collective="false" defaultSelectionEntryId="8142-9e7e-dada-4e0e-f9b7f">
