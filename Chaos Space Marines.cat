            <selectionEntry id="07b2-6b5e-bdbb-ffbc-cf969" name="2x Magma Cutters" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="bfcb-7a40-cc95-79b9-cf969" name="Magma Cutters" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
                  <profiles />
