      </categoryLinks>
      <constraints>
        <constraint id="af4c-d4e8-40d1-5466" field="selections" includeChildForces="false" includeChildSelections="true" message="A Chaos Army can only have one Chaos Lord. Note that Abaddon, Ahriman, Fabius Bile, Lucius and Typhus count as Chaos Lords according to their unit entries." percentValue="false" scope="force" shared="false" type="max" value="1" />
      </constraints>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="60" />
      </costs>
      <entryLinks>
        <entryLink name="Chaos Armory" id="78a1-34d3-16fa-2334" collective="false" hidden="false" import="true" sortIndex="5" targetId="e9b3-4e07-ad9a-6235" type="selectionEntryGroup" />
        <entryLink name="Marks of Chaos" id="561d-a82f-3839-f8b2" collective="false" hidden="false" import="true" sortIndex="4" targetId="4171-c75d-6633-1a19" type="selectionEntryGroup" />
        <entryLink name="Dark Apostle" id="5aee-5a4c-c25c-21ea" collective="false" hidden="false" import="true" sortIndex="2" targetId="5015-aeb7-40a5-2277" type="selectionEntry">
          <constraints>
            <constraint id="fdcc-b0fd-2cce-1925" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Mark of Tzeentch already adds Sorcerer to the Lord. Prevents adding the same ability twice. Models with Mark of Khorne cannot become Sorcerer's.</comment>
