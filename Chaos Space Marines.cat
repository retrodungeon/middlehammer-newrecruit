      <infoLinks>
        <infoLink name="Chaos Land Raider" id="f540-6204-85c3-45b5" hidden="false" targetId="45e4-6250-0ecf-34fc" type="profile" />
        <infoLink name="Lascannon" id="4c44-5278-dc6f-c9e1" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="2x Twin-Linked Lascannons" />
          </modifiers>
        </infoLink>
        <infoLink name="Heavy Bolter" id="a746-46ad-69ba-a98b" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Twin-Linked Heavy Bolter" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Fire Control" id="f1ae-893b-34be-bc27" hidden="false">
          <description>The vehicle may always fire one additional weapon system to those that would normally be able to be fired giving the speed or status of the vehicle. This shot may even be targeting at a different target than that engaged by the crew. It is conducted with a BS 2.</description>
        </rule>
        <rule name="Infernal Device" id="6112-5d7a-3d9b-7f07" hidden="false">
          <description>If the crew are stunned then the vehicle may still be moved directly ahead in a straight line up to its maximum move.</description>
        </rule>
      </rules>
    </selectionEntry>
