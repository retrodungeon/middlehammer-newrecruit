    <selectionEntry id="5140-2b0c-5981-f669-f9b7f" name="Warpbreacher" hidden="true" collective="false" type="upgrade">
      <profiles>
        <profile id="55ad-4d3e-eb42-33bc-f9b7f" name="Warpbreacher" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warpsmith only. Warpbreacher is an upgrade to the bearer's mechatendrils. At the start of each of your turns, the bearer can grant the Daemonic Possession Chaos Vehicle Equipment upgrade to a friendly vehicle within 3" of him, so long as the vehicle has the CSM faction and does not already have the upgrade.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
