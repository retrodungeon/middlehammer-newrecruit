    <selectionEntry id="9c55-dd66-6f7b-8bc8-f9b7f" name="Death Guard" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="f6b3-1098-0a91-3659-f9b7f" name="Gifts of Nurgle" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units that have the VotLW special rule have the Fearless and FNP special rule, but reduce their Initiative by 1. Typhus and units of Plague Marines are unaffected.</description>
        </rule>
        <rule id="9654-c6ad-2b32-0bcc-f9b7f" name="Inexorable Advance" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units that have the VotLW special rule have the Relentless special rule.</description>
        </rule>
        <rule id="c0a2-61ab-de4f-cfd5-f9b7f" name="Lords of the Plague Host" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
