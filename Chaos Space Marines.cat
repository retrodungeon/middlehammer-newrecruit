  <selectionEntry name="Chaos Lord" id="9fda-9a74-56c3-7c97" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Independent Character" id="c570-4007-ed32-4e66" hidden="false" primary="false" targetId="3c96-248b-affd-e504" />
