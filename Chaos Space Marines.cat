    <selectionEntry id="2c83-cc8e-64f7-15f1-f9b7f" name="The Bringers of Despair" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="316a-48bc-4305-c6b3-f9b7f" name="Without Equal" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Chaos Terminators that are part of this Formation (including the Terminator Champion) have a WS and BS of 5 rather than 4.</description>
        </rule>
        <rule id="556b-30ca-10e1-c462-f9b7f" name="The Despoiler's Guard" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>While Abaddon the Despoiler is joined to the unit of Chaos Terminators from this Formation, you can re-roll one Look Out, Sir roll for him in each phase.</description>
        </rule>
      </rules>
      <infoLinks>
