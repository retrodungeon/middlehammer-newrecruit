232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">37</characteristic></characteristics></profile></profiles><rules><rule id="3f631423-bfa4-988c-1b1a-b90a23b7f568-6eec309" name="Champion of Chaos" hidden="false" page="0"><description>A Model with this rule must issue and accept challenges. Where there are multiple models with this rule, the controlling player may decide.
Whenever a model with this rule kills a character, roll a D66 and consult the Chaos Boon chart. This boon remains for the rest of the game. (7th Ed wording)</description></rule></rules><selectionEntries><selectionEntry id="8d06110f-edae-658f-ced7-8018d087d1c2-6eec309" name="Melta Bomb" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8d06110f-edae-658f-ced7-8018d087d1c2-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="047d89db-9bd8-3ff6-e54f-161fd4ca4d14-6eec309" name="Gift of mutation" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="047d89db-9bd8-3ff6-e54f-161fd4ca4d14-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="7985c0b4-f9d2-68c3-11d5-da46ec8b16ab-6eec309" name="Melee Weapons" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="2" field="selections" scope="parent" shared="true" id="7985c0b4-f9d2-68c3-11d5-da46ec8b16ab-minSelections-6eec309" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="7985c0b4-f9d2-68c3-11d5-da46ec8b16ab-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5979d86f-c650-15b8-c8e4-4ed7f37b7647-6eec309" name="Close Combat Weapon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517