          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-d918-fd69-7f60-aa84-maxSelections" type="max" />
