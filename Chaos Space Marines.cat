          <rules>
            <rule id="ee79-f363-80bb-17b4-f9b7f" name="Daemonic Transport" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>The Thunderhawk gains the Daemon special rule. In addition, roll a D6 for each embark or disembark. On a 1, the thunderhawk devours D3 models (randomly determine and remove from play with no saves allowed). The model regains the amount of hull points lost in proportion to the number of models eaten.</description>
            </rule>
          </rules>
          <infoLinks />
          <modifiers />
          <constraints>
