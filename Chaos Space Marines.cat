      <rules>
        <rule name="Small Target" id="08de-c63b-0faa-6d97" hidden="false">
          <description>Nurglings' cover save is at +1. They do not block line of sight to anything behind them.</description>
        </rule>
        <rule name="Vulnerable to Blasts" id="6ab1-c4da-a43a-8e86" hidden="false">
          <description>Template, Ordnance and Blast marker weapons inflict two wounds instead of one on nurglings.</description>
        </rule>
        <rule name="Mischievous" id="2e3a-a466-2ae8-12fa" hidden="false">
          <description>Nurglings may never hold table quarters or objectives</description>
        </rule>
      </rules>
