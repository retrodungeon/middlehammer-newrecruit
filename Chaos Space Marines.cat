              <rules>
                <rule id="mh-rad-chaos-space-marines-2055-61af-8200-7ddf-world-" name="Lightning Blows" hidden="false">
                  <description>Lightning Blows: Every roll of a 6 To Hit with a Melee attack generates another attack with the same weapon at the same Initiative step. These extra attacks do not themselves generate additional attacks.</description>
                </rule>
              </rules>
              <costs>
