      <profiles>
        <profile name="Talon of Horus" id="19ff-ac48-fb4b-26f4" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignore armour saves. Re-roll failed to wound rolls</characteristic>
          </characteristics>
        </profile>
        <profile name="Talon of Horus" id="0919-f474-ab72-3d56" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24"</characteristic>
