    </rule>
    <rule id="mh-rad-chaos-space-marines-8a8f85de-a6e1-28de-4c03-98a9dd3bafd1-night-" name="Chosen Warriors" publicationId="ca571888--pubN80998" page="80" hidden="false">
      <description>All models may issue and accept challenges as if Characters.  This does not confer any of the other special rules associated with Characters.</description>
    </rule>
    <rule id="mh-rad-chaos-space-marines-659ff44e-b4b4-e754-d640-1207926a1f5b-night-" name="Grenade Harness" publicationId="ca571888--pubN80998" page="83" hidden="false">
      <description>When fired, the firing terminator and any squad they have joined count as having assault grenades in the Assault phase of that turn.</description>
    </rule>
    <rule id="mh-rad-chaos-space-marines-0d300426-e90a-4a8d-bff5-9b64949b128d-night-" name="Malfunction" publicationId="ca571888--pubN113187" page="97" hidden="false">
