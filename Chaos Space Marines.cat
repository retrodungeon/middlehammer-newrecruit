    <selectionEntry id="108e-1e74-dd9a-a63c-f9b7f" name="Black Legion Warband" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="28f9-12c3-03da-2c5f-f9b7f" name="Favoured of the Warmaster" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When a model from a Black Legion Warband ears a roll on the Chaos Boon table as a result of the Champion of Chaos special rule, roll twice on the table and choose either one or both of the results. </description>
        </rule>
        <rule id="5244-efd0-57b1-7862-f9b7f" name="Thirst for Glory" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If an enemy unit is completely destroyed by a unit from a Black Legion Warband, all other units from teh same Black Legion Warband can re-roll To Hit and To Wound rolls of 1 until the end of the phase. </description>
        </rule>
      </rules>
      <infoLinks>
