    <profile id="mh-rad-chaos-space-marines-d9f7-775b-1047-f335" name="Krak Grenade (Shooting)" publicationId="ca571888--pubN106502" page="183" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
