      <rules>
        <rule id="3a49-5262-c390-9a15-cf969" name="Meteoric Descent" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Heldrake has Vector Strike. It is resolved at Strength 7.</description>
        </rule>
        <rule id="ff0d-888b-5441-292f-cf969" name="Aerial Strike" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In a Dogfight, a Heldrake which is tailing an opponent at a range of up to 12" in the Attack sub-phase can make an Aerial Strike in addition to its other attacks. The Aerial Strike inflicts a S7 AP2 hit. </description>
        </rule>
      </rules>
