    <selectionEntry id="0ede-6d82-9959-7841-f9b7f" name="Chaos Vindicators" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="1150-185d-5885-fbfb-f9b7f" name="Linebreaker Bombardment" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If this unit contains three Chaos Vindicators that can all fire their demolisher cannons, the squadron can fire a single Linebreaker Bombardment instead of firing normally. To do so, nominate one model in the squadron as the firer; the firer's demolisher cannon changes its type from Large Blast to Apocalyptic Blast and gains the Ignores Cover special rule.</description>
        </rule>
      </rules>
