    <selectionEntry id="c987-ebac-8d44-8c2e-f9b7f" name="[FW] Greater Brass Scorpion of Khorne" page="51" hidden="true" collective="false" type="model">
      <profiles>
        <profile id="29c5-5ba1-6a1a-83de-f9b7f" name="Greater Brass Scorpion of Khorne" page="51" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">3</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">10</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">14</characteristic>
            <characteristic name="Side" typeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e">13</characteristic>
            <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">10</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">3</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">6</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">9</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Super-heavy Walker</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="1ac2-11bd-2c42-2e4c-f9b7f" name="Frenzied Charge" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>when charging, roll 3D6 and add together for total charge distance.</description>
        </rule>
        <rule id="d2a3-ee25-35e3-fd0a-f9b7f" name="Runes of the Blood God" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any psyker who targets the scorpion suffers perils of the warp irrespective of a pass or failure.</description>
        </rule>
        <rule id="dfa5-0040-b83e-f537-f9b7f" name="Doomsday Reactor" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Adds +2 modifier when rolling on the Catastrophic damage table.</description>
        </rule>
        <rule id="03a8-0ec6-e2a6-9b64-f9b7f" name="Multi-legged Terror" page="51" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When making stomp attacks, the scorpion makes D3+2 stomps</description>
        </rule>
