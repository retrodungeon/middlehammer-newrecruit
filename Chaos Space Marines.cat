            <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-chaos-space-marines-d8b6fb92-a8d4-17c6-7242-11cf388ea691-maxInForce" type="max" />
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-chaos-space-marines-d8b6fb92-a8d4-17c6-7242-11cf388ea691-maxInRoster" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-05ed8269-6285-4c7a-c7d0-220b19869739" name="Fractal Harrow-blade" publicationId="ca571888--pubN84158" page="227" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Rending, Bloody Ruin</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-chaos-space-marines-c5e5-70c2-7d03-8148" name="Bloody Ruin" hidden="false">
              <description>Every wound caused bv the bearer of the fractal harrow-blade is counted as two wounds for the purposes of determining assault results. </description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35.0" />
          </costs>
        </selectionEntry>
