    <selectionEntry id="mh-rad-chaos-space-marines-c23a1644-8684-27a2-7028-975fab8a0ccf-death-" name="Grave Warden Terminator Squad" publicationId="ca571888--pubN113187" page="40" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="mh-rad-chaos-space-marines-f90932f5-d644-fd74-fed6-023f5e2da6fe-death-" name="Death Cloud" page="" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Template</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">*</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1, Poison (3)</characteristic></characteristics></profile>
      </profiles>
      <rules>
        <rule id="mh-rad-chaos-space-marines-f31b-7934-a3dd-c1f4-death-" name="Death Cloud" hidden="false">
          <description>The Death Cloud means that any unit with a Toughness characteristic charging an unengaged unit will be forced into making a Disordered Charge while doing so. In addition, the Death Cloud can be used as a weapon with the following profile, and may also be used to make Overwatch Attacks, contrary to the usual limitations of Cataphractii Terminator armour.</description>
        </rule>
      </rules>
