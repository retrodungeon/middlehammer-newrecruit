        <selectionEntry id="e40a-1e4b-ca8c-8ee8-f9b7f" name="Ardex-defensor Mauler Bolt Cannon Turrets" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="1267-4d7b-384d-f85d-f9b7f" name="Ardex-defensor Mauler Bolt Cannon Turrets" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
