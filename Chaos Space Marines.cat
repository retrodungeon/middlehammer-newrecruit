      <rules>
        <rule id="e31b-07e0-8036-16bd-cf969" name="Run them to Ground!" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Flesh hounds in this formation have Hammer of Wrath. Chaos bikers have shred on their Hammer of Wrath attacks.</description>
        </rule>
        <rule id="59e9-21dd-a196-9fee-cf969" name="Preferred Enemy (Psykers)" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        <description>Units with this ability can always re-roll their rolls to hit in close combat against their preferred enemy. This ability does not work when attacking vehicles without a Weapon Skill characteristic</description></rule>
      </rules>
      <infoLinks>
