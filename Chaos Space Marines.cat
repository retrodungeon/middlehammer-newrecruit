    <selectionEntry id="4454-be9a-5d49-12d4-f9b7f" name="Favoured of Chaos" page="127" hidden="true" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="abdd-1756-842c-609e-f9b7f" name="Baleful Nexus of Warp Energies" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units of Possessed from the Favoured of Chaos that are within 12" of their Daemon Prince at the start of their Fight sub-phase receive the benefit of all three Mutations from their Mutation table, rather than only one.</description>
