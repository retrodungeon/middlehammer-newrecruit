      <selectionEntries>
        <selectionEntry id="mh-rad-chaos-space-marines-6ce7-cbc0-365c-642b" name="Icarian" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-0c9b-76b0-8cf5-e779" type="max" />
          </constraints>
          <rules>
            <rule id="mh-rad-chaos-space-marines-a741-f2f1-86c2-3432" name="Icarian*" publicationId="ca571888--pubN66489" page="39" hidden="false">
              <description>If stationary that turn, the Cohort may, if wished, count as having the
                                        Skyfire special rule for all its ranged weapons that turn. Units with this
                                        augment count as a Heavy Support choice instead of a troops choice for the army.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-chaos-space-marines-d48a-d06f-5332-ac4c" name="Ferrox" hidden="false" collective="false" import="true" type="upgrade">
