            <profile id="mh-rad-chaos-space-marines-c587-5d7f-6151-005d" name="Artificer Armour" publicationId="ca571888--pubN80998" page="131" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Artificer Armour confers a +2 armour save.  </characteristic></characteristics></profile>
          </profiles>
          <categoryLinks>
            <categoryLink id="mh-rad-chaos-space-marines-a318-61dd-5968-c6e4" name="New CategoryLink" hidden="false" targetId="mh-rad-chaos-space-marines-a2ba-16b0-8590-b017" primary="false" />
