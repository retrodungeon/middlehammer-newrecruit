      <selectionEntries>
        <selectionEntry id="07d0-f882-c249-0a73-f9b7f" name="Laser Destroyer Array" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="6ca3-a0b6-bd46-f32b-f9b7f" name="Laser Destroyer Array" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48"</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">9</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Ordnance 1, Twin-linked</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="7d76-ca26-5a3d-3dcf-f9b7f" name="Capacitor Fire" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>If the vindicator has not moved this turn, the laser destroyer array shots are then Ordnance 2, Twin-linked.</description>
            </rule>
            <rule id="327c-8e3a-4df2-fea2-f9b7f" name="Overcharged Fire" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>The player may declare an overcharged fire if the vehicle has not moved this turn. The Laser Destroyer array counts as Ordnance 3, Twin-linked. The player rolls a D6 after shooting the array, and loses a Hull Point (no save allowed) on the roll of a 1.</description>
            </rule>
          </rules>
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="07d0-f882-c249-0a73-minSelections-f9b7f" type="min" />
