        <rule id="dd21-e827-ed40-3965-cf969" name="Caged Fury" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When the bearer reaches 0 wounds or is removed as a casualty, you may Summon a Bloodthister of Unfettered Fury within 6" of it before removing the model. At the end of the Controlling players turn, the Bloodthirster loses D3 wounds automatically, with only Invunerable saves allowed against these wounds.</description>
        </rule>
      </rules>
