          <rules>
            <rule id="mh-rad-chaos-space-marines-1bdd-f228-3945-bbee" name="Ferrox" publicationId="ca571888--pubN66489" hidden="false">
              <description>The unit gains the Rage rule and its close combat attacks (regardless of type) gain the Rending special rule. The unit may not be upgraded to replace
their lightning guns.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-chaos-space-marines-6db2-d57d-8a51-089e" name="Destructor" hidden="false" collective="false" import="true" type="upgrade">
