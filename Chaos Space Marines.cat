        <profile id="a7c4-7cca-ba9a-5467-f9b7f" name="Huron Blackheart: The Tyrant of Badab" page="0" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
