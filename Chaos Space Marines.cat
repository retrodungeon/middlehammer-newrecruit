e" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0f295c20-7c2c-70cf-296d-4c5a543a00eb-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="55631730-ee0e-f664-cb54-e27057cf1d6b-6e3184a" name="Khorne Berzerker" hidden="false" collective="false" import="true" type="model"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="19" /></costs><constraints><constraint type="min" value="4" field="selections" scope="parent" shared="true" id="55631730-ee0e-f664-cb54-e27057cf1d6b-minSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="19" field="selections" scope="parent" shared="true" id="55631730-ee0e-f664-cb54-e27057cf1d6b-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="06317319-52bb-236f-99b4-e76a7a77e308-6e3184a" name="Plasma Pistol" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="06317319-52bb-236f-99b4-e76a7a77e308-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="085d5a68-ac99-cb15-ca85-8b230db692d6-6e3184a" name="Chain Axe" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="3" /></costs><modifiers><modifier type="increment" field="085d5a68-ac99-cb15-ca85-8b230db692d6-maxSelections-6e3184a" value="1.0"><repeats><repeat field="selections" scope="5