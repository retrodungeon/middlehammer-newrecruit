    <profile id="mh-rad-chaos-space-marines-9ad2-2e0f-1261-f494" name="Power Dagger" publicationId="ca571888--pubN113187" page="89" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
