          </constraints>
          <selectionEntries>
            <selectionEntry name="Dreadnought CCW and Twin-Linked Bolter" id="da08-0a9a-08a7-cbc3" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
