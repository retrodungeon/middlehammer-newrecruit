        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-d1fd-7c17-3b6b-f97d" type="min" />
      </constraints>
      <rules>
        <rule id="mh-rad-chaos-space-marines-cadc-883d-22d0-d133" name="Legion Inductees" publicationId="ca571888--pubN80998" page="22" hidden="false">
          <description>The unit of Battle-automata to which the Legion Praevian is attached gains the Legiones Astartes special rule possessed by the Legion Praevian or one of the following special rules: Furious Charge, Tank Hunters or Scout (when the Scout special rule is selected, it also applies to the Legion Praevian). These special rules are selected at no additional points cost.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="mh-rad-chaos-space-marines-47d7-6259-696c-876f" name="Legion Inductees" publicationId="ca571888--pubN80998" page="22" hidden="false" collective="false" import="true">
