    <profile id="mh-rad-chaos-space-marines-87c7-bd37-70f7-1933" name="Plasma Gun" publicationId="ca571888--pubN106502" page="178" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
