mpion of Chaos" hidden="false" page="0"><description>A Model with this rule must issue and accept challenges. Where there are multiple models with this rule, the controlling player may decide.
Whenever a model with this rule kills a character, roll a D66 and consult the Chaos Boon chart. This boon remains for the rest of the game. (7th Ed wording)</description></rule></rules><selectionEntries><selectionEntry id="56953706-f340-39d8-bd9b-aef5f18b8547-6eec309" name="Gift of Mutation" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="56953706-f340-39d8-bd9b-aef5f18b8547-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="4a6690e2-001e-22f6-7c69-ef5bd306b45f-6eec309" name="Melta Bombs" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4a6690e2-001e-22f6-7c69-ef5bd306b45f-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="2589d83d-1f4f-7499-a81e-6b42c48707de-6eec309" name="Doom Siren" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2589d83d-1f4f-7499-a81e-6b42c48707de-maxSelections-6eec309" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="baa91d54-ff5e-1c06-4640-757113ac4099-6eec309" name="Weapon Choice" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="2" field="selections" scope="parent" shared="true" id="baa91d54-ff5e-1c06-4640-757113ac4099-minSelections-6eec309" includeChildSelections="false" in