              <rules>
                <rule name="Plague Carrier" id="198c-d43d-c116-945e" hidden="false">
                  <description>At the end of the Chaos Shooting phase, any model that is within 6" of the vehicle is affected. Roll a D6 for each model, and on a rol of a 6 it takes a wound with normal saves allowed (but not cover saves). Models with Mark of Nurgle and all Daemon Packs, Possessed, Daemon Beasts and Great Daemons are immune.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Coruscating Flame" id="bbc9-a2d1-e974-0210" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="acea-fb4c-0959-478d" field="selections" includeChildForces="false" includeChildSelections="false" message="Tzeentch units may not be included in a force with a Nurgle army leader." percentValue="false" scope="parent" shared="true" type="max" value="1" />
              </constraints>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="1568-261f-27d9-590d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
                        <condition childId="bf11-860d-bf55-80d2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
                        <condition childId="4bde-bf7f-8300-7011" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
                        <condition childId="0323-dc21-f71b-dc94" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1" />
                        <condition childId="b1cf-c764-2ad0-c229" childName="Mark of Nurgle" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0" />
                        <condition childId="039c-5796-7006-0975" childName="Mark of Khorne" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0" />
                        <condition childId="9b41-cfd0-0af7-2496" childName="Mark of Slaanesh" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0" />
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier field="acea-fb4c-0959-478d" type="set" value="0">
                  <comment>Tzeentch units may not be included in a force with a Nurgle army leader.</comment>
                  <conditions>
                    <condition childId="a2ce-8cc6-991e-9da6" childName="Leader - Nurgle" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1" />
                  </conditions>
                </modifier>
                <modifier field="hidden" type="set" value="true">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="168b-a772-94f7-83f5" childName="Dedicated Transport" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="instanceOf" value="1" />
                        <condition childId="44ca-fa7f-9f9a-5d33" childName="Mark of Tzeentch" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="root-entry-self" shared="true" type="equalTo" value="0" />
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Coruscating Flame" id="ef82-e3e9-0cfe-7585" hidden="false">
                  <description>Any model attacking the vehicle in melee takes a Str D6, Ap 4 hit before resolving its attacks</description>
                </rule>
              </rules>
            </selectionEntry>
