                    <condition childId="f9f2-3e04-500e-863d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="1" />
                    <condition childId="f3f4-cfab-3ec3-a1c4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="1" />
                    <condition childId="855b-c003-38bd-be45" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="1" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
