osts><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a655e759-2cea-ce32-616a-f0a7c182a269-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="841152e7-59ff-6d5d-680d-020d54ddb940-6e3184a" name="Chaos Artefacts" hidden="false" collective="false" import="true"><entryLinks><entryLink id="62ddc929-47ef-713c-45ef-a29811db709f-6e3184a" name="Last Memory of Yuranthos" hidden="false" collective="false" import="true" targetId="ec5d28a5-45ee-3773-9ddb-3dfc4a77b0d7-6e3184a" type="selectionEntry" /><entryLink id="88b0fc56-8b43-911f-4cdb-8818369b4848-6e3184a" name="The Eye of Night" hidden="false" collective="false" import="true" targetId="3de21b5d-6727-1747-c64d-df79898949e1-6e3184a" type="selectionEntry"><modifiers><modifier type="set" field="3de21b5d-6727-1747-c64d-df79898949e1-maxSelections-6e3184a" value="1.0"><repeats><repeat field="selections" scope="c249076c-179f-ee38-03d4-ff84d4941348-6e3184a" value="1" repeats="1" childId="8753aed1-d804-37f5-198d-f603f5beac25-6e3184a" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="84857e34-cb39-1981-74c8-d2348f52343b-6e3184a" name="Warptalons" hidden="false" collective="false" import="true" type="unit"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-af92b17a-deb1-1555-4ae3-13ace78c4105" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="Fast Attack" hidden="false" id="84857e34-cb39-1981-74c8-d2348f52343b-slot-6e3184a" targetId="74fe-37c3-fbbf-849e" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><profiles><profile id="dd0ebe47-ad4f-c9f2-7d24-3d9e85ef9b9b-6e3184a" name="Warp Talon" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jump Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">49</characteristic></characteristics></profile></profiles><rules><rule id="e7c665a7-a6cb-8a81-197f-cd8ed4981be2-6e3184a" name="Daemon" hidden="false" page="0"><description>This model has a 4+ invulnerable save.</description></rule><rule id="58516928-c161-60b5-61ab-8a1c5d5229aa-6e3184a" name="Warpflame Strike" hidden="false" page="0"><description>Immediately after entering via Deep Strike, all enemy units within 6" of the Warptalons count as being hit with a weapon with Blinded. (7th Ed wording)</description></rule></rules><selectionEntries><selectionEntry id="8747e365-9277-4136-c0b8-c92dfe23d5a7-6e3184a" name="Warp Talon Champion" hidden="false" collective="false" import="true" type="model"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8747e365-9277-4136-c0b8-c92dfe23d5a7-minSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8747e365-9277-4136-c0b8-c92dfe23d5a7-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="806ca287-1a35-0d26-f362-e645bc16db37-6e3184a" name="Warp Talon Champion" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jump Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">49</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="5ea35fe2-d231-84ab-2f49-26d076ee2d06-6e3184a" name="Gift of Mutation" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="5ea35fe2-d231-84ab-2f49-26d076ee2d06-maxSelections-6e3184a" includeChildSelections="false" includeChildForces="