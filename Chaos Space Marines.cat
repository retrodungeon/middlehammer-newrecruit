          <rules />
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0b85-1cab-f901-3200-f9b7f" type="min" />
