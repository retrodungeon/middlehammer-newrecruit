      <rules>
        <rule id="5463-021c-c930-2129-cf969" name="Crazed!" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each time the Helbrute takes a glance/pen but isn't destroyed, place a marker next to it. At the start of your next movement phase, roll a D3 if the Helbrute has a marker. Consult the Crazed table in Codex: Khorne Daemonkin and remove all markers from the Helbrute.</description>
        </rule>
      </rules>
