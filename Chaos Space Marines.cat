                  <rules>
                    <rule id="mh-rad-chaos-space-marines-31071b30-b643-a675-cca2-cf1ca6fd5e09" name="Art of Destruction" publicationId="ca571888--pubN66500" page="191" hidden="false">
                      <description>Siege Breaker has the Tank Hunter and Wrecker Special Rules applied to his attacks and confers these rules to the heavy weapon shooting attacks of any infantry unit he joins.</description>
                    </rule>
                  </rules>
                  <infoLinks>
                    <infoLink id="mh-rad-chaos-space-marines-1e42aebd-43f5-a2f1-9b71-83c1f364275c" name="Nuncio-vox" hidden="false" targetId="mh-rad-chaos-space-marines-2a0e-e1f0-5ea0-5799" type="profile" />
                  </infoLinks>
