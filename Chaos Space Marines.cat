            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignore armour saves. Re-roll failed to wound rolls</characteristic>
          </characteristics>
        </profile>
        <profile name="Talon of Horus" id="0919-f474-ab72-3d56" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24"</characteristic>
