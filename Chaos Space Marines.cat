    <selectionEntry id="3c28-f17e-012b-546b-f9b7f" name="Khorne Tower of Skulls" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="9d1f-b47c-6d42-4618-f9b7f" name="Khorne Tower of Skulls" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f">
