    <selectionEntry id="a70a-e617-cb66-dfc0-f9b7f" name="The Skull of Monarchia" hidden="true" collective="false" type="upgrade">
      <profiles>
        <profile id="2796-e7e1-1c8e-13bc-f9b7f" name="The Skull of Monarchia" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
