      <rules>
        <rule id="7082-e391-6700-4bb3-f9b7f" name="Master of the Dead" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>While Necrosius is on the field, all Plague Zombies gain Furious Charge.</description>
        </rule>
        <rule id="bd35-4ba9-901f-c2ae-f9b7f" name="Warlord Trait: Intimmidating Presence" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units within 12" of Necrosius must use their lowest Ld value, not the highest.</description>
        </rule>
      </rules>
