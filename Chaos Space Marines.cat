      <profiles>
        <profile id="mh-rad-chaos-space-marines-78e2cfcb-9ba5-32ad-69ac-3f11fb92335f-alpha-" name="Anvillus Pattern Dreadclaw Drop Pod" publicationId="ca571888--pubN80998" page="55" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
          <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">-</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Flyer, Hover, Transport</characteristic></characteristics></profile>
        <profile id="mh-rad-chaos-space-marines-81ed-d66c-ef26-0744-alpha-" name="Anvillus Pattern Dreadclaw Drop Pod (Transport)" publicationId="ca571888--pubN80998" page="55" hidden="false" typeId="307d-047f-ca13-706b" typeName="Transport">
          <characteristics><characteristic name="Capacity" typeId="8285-4205-b6cd-8473">10 or a single Dreadnought *see Dreadclaw Transport Capacity rule</characteristic><characteristic name="Fire Points" typeId="b270-a7f9-22b2-3702">None</characteristic><characteristic name="Access Points" typeId="d17b-0342-b1dc-b8e7">One access hatch beneath the hull. Passengers can disembark at ground level within 2" of the hull.</characteristic></characteristics></profile>
      </profiles>
      <rules>
        <rule id="mh-rad-chaos-space-marines-8a85-2ac6-c4b3-8d46-alpha-" name="Dreadclaw Transport Capacity" publicationId="ca571888--pubN80998" page="55" hidden="false">
          <description>The Dreadclaw has a transport capacity of 10 or can be used to transport a single Dreadnought from the following list:

Legion Dreadnought
Legion Mortis Dreadnought
Contemptor Dreadnought
Contemptor Mortis
Contemptor-Cortus</description>
        </rule>
      </rules>
