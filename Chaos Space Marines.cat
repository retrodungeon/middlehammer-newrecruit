    <selectionEntryGroup id="mh-rad-chaos-space-marines-5527-f4ef-035b-11c2" name="Wargear" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="mh-rad-chaos-space-marines-b4ea-a586-86a9-02eb" name="Nuncio-vox" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-chaos-space-marines-8ccf-07cb-9064-9762" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-chaos-space-marines-48c0-02c8-a254-42e2" name="Command Company Nuncio-vox" page="" hidden="true" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Units arriving via Deep Strike within 6"  of a Command Company Nuncio-vox do not scatter.  When barrage weapons are used by the controlling player, line of sight may be drawn from any model equipped with a Nuncio-vox as well as the firing model itself. Range is still drawn from the firing model.  It may not be used inside a vehicle.
Any unit equipped with a Command Company Nuncio Vox can benefit from the Cognis Signum carried by the Master of Signals (but still only one unit per turn)</characteristic></characteristics></profile>
          </profiles>
          <infoLinks>
            <infoLink id="mh-rad-chaos-space-marines-44af-c1bd-9c26-f6d2" name="Nuncio-vox" hidden="false" targetId="mh-rad-chaos-space-marines-2a0e-e1f0-5ea0-5799" type="profile">
              </infoLink>
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-chaos-space-marines-91c7-90a8-a1ae-cde0" name="Vexilla, Legion" hidden="false" collective="false" import="true" type="upgrade">
