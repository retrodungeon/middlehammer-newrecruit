    <selectionEntry id="25eb-e12f-75c5-55f2-d3f7b" name="Omniscient Oracles" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="d2e1-ceaf-f3a0-7512-d3f7b" name="Knowledgs of Past, Present, and Future" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Kairos Fateweaver and the Lords of Change from the Omniscient Oracles can re-roll any rolls of 1 when making Psychic tests, To Hit, or To Wound rolls. In addition, whilst all models from this Formation are on the battlefield, you can choose to re-roll any failed attempt to Seize the Initiative and any Reserve Rolls.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
