    <selectionEntry id="a567e325-4907-1e0f-0a93-b2e3f562a1f8-d3f7b" name="Daemon of Tzeentch" page="0" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="d44f-e23e-352b-b086-d3f7b" name="Daemon of Tzeentch" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Daemons of Tzeentch have the Daemon and Hatred (Daemons of Nurgle) special rules. When manifesting psychic powers, Daemons of Tzeentch have a +3 modifier to their Leadership. In addition, Daemons of Tzeentch re-roll all saving throw results of 1.</description>
        </rule>
      </rules>
      <infoLinks>
