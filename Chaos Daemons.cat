    <selectionEntry id="9b75f082-4d5c-8f8e-3c7d-a72b6d8d346a-d3f7b" name="Lesser Locus of Transmogrification" page="0" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="5174-24cf-5ace-a739-d3f7b" name="Lesser Locus of Transmogrification" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Pink Horror in this model's unit is slain in close combat, the unit that inflicted the unsaved wound immediately suffers a S3 AP- hit. Each time a Blue Horror in this model's unit is slain in close combat, the unit that inflicted the unsaved wound immediately suffers a S2 AP- hit. Each time a Brimstone Horror in this model's unit suffers an unsaved wound in close combat, the unit that inflicted the unsaved wound immediately suffers a S1 AP- hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks />
      <costs>
        <cost name="Points" value="10.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
