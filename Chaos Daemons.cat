      <infoLinks>
        <infoLink name="Epidemius" id="7434-2285-f23e-6ba0" hidden="false" type="profile" targetId="e7aa-dbdf-d3b7-5f57" />
        <infoLink name="Cloud of Flies" id="017e-e47e-0221-6f67" hidden="false" type="profile" targetId="3d37-8d1d-12b2-bd73" />
