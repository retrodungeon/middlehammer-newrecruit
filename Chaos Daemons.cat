    <selectionEntry id="0753fde3-8dfb-11a6-c449-39a9b91d3d93-d3f7b" name="An'ggrath the Unbound" hidden="false" collective="false" type="model">
      <profiles>
        <profile id="e6b0e0f0-8fdb-44c8-dff2-a296f7adb317-d3f7b" name="An'ggrath the Unbound - Demon Lord of Khorne" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
