            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">6+</characteristic>
          </characteristics>
        </profile>
        <profile id="c386-5769-c9ac-f44a-d3f7b" name="Brass Collar of Bloody Vengeance" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">See Collar of Khorne.  In addition, any Psyker that takes a Psychic test within 12" of Karank suffers Perils of the Warp on any double.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="4bb1-eb1d-c83e-1ad9-d3f7b" name="Prey of the Blood God" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of the game, before deployment, nominate one character in the enemy army; this is Karanak's quarry. Karanak re-rolls all failed To Hit and To Wound rolls against the nominated model and his unit whilst the target model is alive.</description>
        </rule>
      </rules>
