    <selectionEntry id="1cd321b1-b131-875d-9d25-9929053cfd50-d3f7b" name="Instrument of Chaos" page="0" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="52d1-2c93-33de-b6d1-d3f7b" name="Instrument of Chaos" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the Daemon bearing this Gift is involved in a fight which results in a draw, its side counts as having won by one wound.  If both side include an Instrument of Chaos, the result remians a draw.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
      <infoLinks />
      <modifiers />
      <constraints>
