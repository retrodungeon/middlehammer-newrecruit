      <rules>
        <rule id="7ce0-98ef-69e4-fb4b-d3f7b" name="Incorporeal" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>This weapon has an AP value equal to the target's Initiative value. Against targets with an I higher than 6, resolve Attacks from this weapon at AP-. Against vehicles, hits are resolved at AP1.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
