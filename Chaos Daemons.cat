            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">After resolving bearer's close combat attacks, add 1 model to friendly Plaguebearer units within 12" of the bearer for each enemy model that was slain. Models must be placed in coherency and more than 1" away from enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6538-5d1c-0256-5506-maxSelections-d3f7b" type="max" />
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6538-5d1c-0256-5506-maxInRoster-d3f7b" type="max" />
