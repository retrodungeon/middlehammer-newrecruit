      </entryLinks>
      <profiles>
        <profile name="Oracle of Eternity" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="e7ed-7a95-b33d-895e">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Fateweaver and all friendly units within 6" may re-roll all failed Armour, Invulnerable and Cover saves. However, for every unsaved wound suffered by Fateweaver, take a Ld test. If the test is failed, he retreats in shock and is removed as a casualty.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="a9cb-ed71-e87a-fa70" includeChildSelections="true" includeChildForces="true" />
      </constraints>
    </selectionEntry>
