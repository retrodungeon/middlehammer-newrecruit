      <entryLinks />
      <costs>
        <cost name="Points" value="20.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="21a5-9eb3-eda1-39da-d3f7b" name="Tallyband" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="c7ea-1d4e-3b8b-5e3c-d3f7b" name="Distracting Swarm of Flies" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units canont fire Overwatch against units from a Tallyband.</description>
        </rule>
        <rule id="08e6-f036-544f-c3b8-d3f7b" name="Enfeebling Nausea" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of each Assault phase, enemy units that are locked in combat with any units from a Tallyband must pass a Leadership test or reduce their Strength and Toughness characteristics by 1 for the duration of that phase.</description>
        </rule>
      </rules>
      <infoLinks>
