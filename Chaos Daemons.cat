                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Meele, Souleater, Specialist Weapon</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="800f-65a8-388b-c648-d3f7b" name="Souleater" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>At the end of any fight sub-phase where this weapon has inflicted an unsaved wound, roll a D6. on a 2+, the bearer gains an additional wound (up to a max of 10).</description>
            </rule>
          </rules>
          <infoLinks />
          <modifiers />
