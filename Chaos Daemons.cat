          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of a Fight sub-phase in which the bearer slays an enemy Monster or Character, add 1 to its A for the rest of the game.</characteristic>
