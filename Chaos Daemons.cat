          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Pink Horror in this model's unit is slain, it splits into four Blue Horrors instead of two. Each time a Blue Horror in this model's unit is slain, it splits into two pairs of Brimstone Horrors instead of one.</characteristic>
          </characteristics>
        </profile>
