    <selectionEntry id="0c1bfed3-f6ff-c810-fa80-9494794a1bdd-d3f7b" name="Daemon of Slaanesh" page="0" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="92c0-6864-b67a-d069-d3f7b" name="Daemon of Slaanesh" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Daemons of Slaanesh have the Daemon, Fleet, Hatred (Daemons of Khorne) and Rending special rules. In addition, units composed entirely of Daemons of Slaanesh run an additional 3" (this will normally be D6+3"). Units that are entirely composed of Cavalry models instead Run an additional D6". Vehicles that are not Walkers move an extra 3" whenever they move Flat Out instead.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="80be-06c5-2673-7f6f-d3f7b" hidden="false" targetId="39c6-1f20-a156-47f4" type="rule">
