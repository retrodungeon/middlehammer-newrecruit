            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Decapitating Blow, Searing Gore, Specialist Weapon</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="fe0e-4ead-55dd-db9c-d3f7b" name="Searing Gore" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each time a model is removed as the result of an attack by this weapon, its unit immediately suffers an additional D3 S3 AP4 hits. Wounds caused by these hits are allocated starting with the closest target model to bearer.</description>
        </rule>
      </rules>
      <infoLinks>
