    <selectionEntry id="d633-a25a-cf63-7966-d3f7b" name="Heralds Anarchic" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="2871-2d1d-dbf7-b455-d3f7b" name="Warp Conduits" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Add one dice to your Warp Charge pool in each Psychic phase for each model from the Heralds Anarchic that is on the battlefield.</description>
        </rule>
      </rules>
