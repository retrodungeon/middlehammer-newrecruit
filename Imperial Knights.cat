    <profile id="b460-6389-8095-3046-e2031" name="Thermal Cannon" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
