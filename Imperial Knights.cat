                <selectionEntry id="d773-2f8d-b832-ff40-9103a" name="Cerastus Shock Lance" page="0" hidden="false" collective="false" type="upgrade">
                  <profiles>
                    <profile id="4730-3b18-1f2e-e8cc-9103a" name="Cerastus Shock Lance (Melee)" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
                      <profiles />
