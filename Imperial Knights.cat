          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="b31a-e1d7-e57b-8cd7-9103a" name="The Forgotten Knight" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Gerantius's ion shield confers a 3+ invulnerable save instead of the normal 4+. He cannot have a Warlord trait, and does not use the rules for Knightly Ranks.</description>
        </rule>
        <rule id="0da2-3928-cd23-2eab-9103a" name="Striker" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Gerantius can shoot in the same turn that he runs (he cannot run and charge). In addition he must re-roll results of "1" on the Stomp table.</description>
        </rule>
      </rules>
