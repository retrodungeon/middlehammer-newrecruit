  <selectionEntryGroup id="4cb5-2fdf-b8d4-9a81-4ed8d" name="Arcana Mechanicum" hidden="false" collective="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="4cb5-2fdf-b8d4-9a81-maxSelections-4ed8d" type="max" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="d62f-a958-4f38-3178-4ed8d" name="The Scryerskull Perspicatus" page="78" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="2970-6861-b1fc-1c0d-4ed8d" name="The Scryerskull Perspicatus" page="78" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each of your turns, a model with the Scryerskull Perspicatus can choose either to identify a single Mysterious Objective or to scry an enemy vehicle anywhere on the battlefield. If you choose to scry a vehicle, any friendly units with the Cult Mechanicus or Skitarii Faction re-roll failed armour penetration rolls against that vehicle, and can choose to re-roll glancing hits scored on it in an attempt to instead get a penetrating hit, until the start of your next turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules />
          <infoLinks />
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <repeats />
              <conditions>
                <condition field="selections" scope="ancestor" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" childId="0909-cd10-dc33-e5ef-4ed8d" type="instanceOf" />
              </conditions>
              <conditionGroups />
            </modifier>
            <modifier type="set" field="6f18-a8fc-2c5b-9517" value="0.0">
              <repeats />
              <conditions>
                <condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2d00-59e5-8d39-b7dc" type="instanceOf" />
              </conditions>
              <conditionGroups />
            </modifier>
          </modifiers>
          <constraints>
