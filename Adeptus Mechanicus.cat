                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Shred</characteristic>
              </characteristics>
            </profile>
            <profile id="753b-7e68-b893-aff1-4ed8d" name="Anzion's Pseudogenetor" page="79" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When fighting in close combat, a model equipped with this relic makes D6 additional attacks using the Anzion's Pseudorgenetor profile, in addition to any close combat attacls it makes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules />
