      </costs>
    </selectionEntry>
    <selectionEntry id="9543-4c8e-0c7c-8a2a-4ed8d" name="Holy Requisitioner" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="b287-d2af-c7c4-8988-4ed8d" name="Apparition Extremis" page="69" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All units in this Formation must be placed in Deep Strike Reserve. Make one unique roll for Reserve for the entire Formation (with the option to re-roll if you want). If the roll is successful, all units in the Formation arrive from Reserve. First, place the Tech-Priest Dominus, he doesn't scatter if it's located at 6" or less of an Objective Marker. Breachers units don't scatter if they're situated at 6" or less of the Tech-Priest Dominus.</description>
        </rule>
        <rule id="2bf5-e374-1e76-f7ad-4ed8d" name="Inhuman Avarice" page="69" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If any Breachers units in this Holy Requisitioner Formation are at 6" or less of any Objective Marker, they gain Counter-attack and Zealot.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0cb0-0ec9-4338-fa02-4ed8d" hidden="false" targetId="6fc0-ebe5-6c64-7c9f" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
