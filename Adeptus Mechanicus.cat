    <selectionEntry id="172c-4280-03bd-e04d-4ed8d" name="Tech-Priest Enginseer" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="b4a5-983d-f8fc-7dbf-4ed8d" name="Awaken the Machine" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>In each of your shooting phases, instead of firing his weapons, the Enginseer may choose a single friendly Astra Militarum vehicle within 12". That vehicle gains the Power of the Machine Spirit SR until the end of the turn.</description>
        </rule>
      </rules>
