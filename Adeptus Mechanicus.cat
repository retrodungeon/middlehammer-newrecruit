      </costs>
    </selectionEntry>
    <selectionEntry id="788f-112f-c63a-9226-4ed8d" name="Numinous Conclave" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="3cda-8ef1-7b73-aa5b-4ed8d" name="The Corpuscarii Giveth" page="68" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If there is any Fulgurite unit of the same Numinous Concalve Formation at 6" or less, the Corpuscarii Gauntlets are Assault 3. If the Corpuscarii causes any unsaved Wound, the enemy unit is considered "Electrified" until the end of the Assault phase.</description>
        </rule>
        <rule id="7b51-2f92-2e28-8a74-4ed8d" name="The Fulgurites Taketh Away" page="68" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Fulgurite Electro-priests in this Numinous Conclave Formation re-roll to Wound using their electroleech staves if there is any "Electrified" unit locked in close combat.</description>
        </rule>
        <rule id="b712-2ffb-7a36-b0f5-4ed8d" name="Crusader" page="163" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A unit that contains at least one model with this special rule rolls an extra dice when making Run moves, and uses the highest result rolled. In addition, a unit that contains at least one model with this special rule adds D3 to its Sweeping Advance totals (roll each time).</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="af43-cb01-a4ad-fab9-4ed8d" name="Fulgurite Electro-Priests" hidden="false" collective="false" defaultSelectionEntryId="72f0-5fda-3034-8cc3-4ed8d">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="dad1-e3c2-6052-95aa-4ed8d" type="min" />
            <constraint field="selections" scope="parent" value="3.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8654-94bf-60a9-a158-4ed8d" type="max" />
