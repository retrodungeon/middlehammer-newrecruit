        <selectionEntry id="7871-e4e5-2867-4982" name="Chooser of the Slain" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f17e-d81d-8244-c7e7" type="notInstanceOf" />
