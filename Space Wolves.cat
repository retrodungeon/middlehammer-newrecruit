      <rules>
        <rule id="mh-rad-space-wolves-d756-fdcd-63df-b60d" name="Hexagrammatic Wards" publicationId="ca571888--pubN103311" page="293" hidden="false">
          <description>When targetted with shooting attack, close combat attack or Witchfire psychic power by a model with the Daemon or Daemon of the Ruinstorm special rule, a model with hexagrammatic wards may re-roll any failed invulnerable saves made against that attack.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
      </costs>
