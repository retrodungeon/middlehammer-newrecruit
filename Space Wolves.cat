      </costs>
      <infoLinks>
        <infoLink name="Iron Priest" id="f8d0-80ea-d90a-59df" hidden="false" targetId="70dc-5372-0f00-5a0e" type="profile" />
        <infoLink name="Runic Armour" id="c679-0e9b-c366-a106" hidden="false" targetId="eac9-dbf2-fa70-a3c7" type="profile" />
        <infoLink name="Servo-arm" id="9944-7a8a-fff3-b8a0" hidden="false" targetId="3bb0-d10e-9059-eb84" type="profile" />
        <infoLink name="Thunder Hammer" id="234d-5cd8-67ec-8918" hidden="false" targetId="4cb2-e19a-4b72-594d" type="profile" />
        <infoLink name="Frag Grenades" id="cc3b-333a-77cc-1d92" hidden="false" targetId="6e7c-a63e-3bc6-5bc9" type="profile" />
        <infoLink name="Krak Grenades" id="ebec-fa78-e857-700d" hidden="false" targetId="0a12-b99c-7d80-2ab6" type="profile" />
        <infoLink name="And They Shall Know No Fear" id="26d8-ce1b-e0a1-0869" hidden="false" targetId="73f8-658e-9da5-beba" type="rule" />
        <infoLink name="Acute Senses" id="c314-2269-a19f-3b74" hidden="false" targetId="253f-bb05-f8fd-fffd" type="profile" />
        <infoLink name="Counter-Attack" id="f6ec-3ee8-caeb-6f72" hidden="false" targetId="98cd-d727-4827-db44" type="profile" />
      </infoLinks>
      <profiles>
        <profile name="Battlesmith" id="fbbe-1d17-0f00-bf1f" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If an Iron Priest is in base contact with a damaged vehicle during the Shooting phase, he can attempt to repair it instead of firing. Roll a D6 and add +1 for each Thrall-Servitor with a servo-arm in the unit. If the result is 5 or more, then either a weapon destroyed result or immobilised result (owning player's choice) will be repaired. If a weapon destroyed result is repaired, that weapon can be fired in the following Shooting phase. The iron Priest cannot repair if he has gone to ground or is falling back.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapon" id="bc96-7ca0-be59-52d9" defaultSelectionEntryId="76f6-b85d-c5ed-d544" hidden="false">
          <constraints>
            <constraint id="2342-b3c7-0c89-8f75-min" field="selections" scope="self" shared="true" type="min" value="1" />
            <constraint id="2342-b3c7-0c89-8f75-max" field="selections" scope="self" shared="true" type="max" value="1" />
          </constraints>
          <selectionEntries>
