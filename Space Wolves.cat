        <profile name="Wolfkin" id="5ba2-0045-af2c-b4a0" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any unit of Fenrisian Wolves may re-roll any failed Morale tests if they are within 12" of a Thunderwolf Cavalry model.</characteristic>
