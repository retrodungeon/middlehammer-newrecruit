                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When rolling to wound with a grav-weapon, or to determine the effect on a vehicle, the bearer may re-roll the result.</characteristic>
