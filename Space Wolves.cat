        <characteristic name="I" typeId="8517-a46c-d6df-9c75">4</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">2</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">3+ (4+ Invulnerable)</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolf Scout" id="243b-f26f-d86f-db25" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
        <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">4</characteristic>
        <characteristic name="S" typeId="09af-e927-0c3c-9d88">4</characteristic>
        <characteristic name="T" typeId="ff29-f8b2-5b20-b686">4</characteristic>
        <characteristic name="W" typeId="4a81-ac45-a71c-c71e">1</characteristic>
        <characteristic name="I" typeId="8517-a46c-d6df-9c75">4</characteristic>
        <characteristic name="A" typeId="a535-0722-3bc1-4d3c">1</characteristic>
        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">8</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Thunderclap" id="98bd-a581-95eb-2cda" hidden="false" typeId="8c68-ad11-33db-e3c4" typeName="Psychic Power">
      <characteristics>
        <characteristic name="Power" typeId="1638-2569-4ea3-9b0a">Psychic shooting attack. Place the large blast marker so that it is touching the Rune Priest. Any enemy model touched by the marker takes a S3 hit with an AP of 5.</characteristic>
      </characteristics>
    </profile>
    <profile name="Living Lightning" id="537e-4a80-f3fa-82d1" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">Unlimited</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">7</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">5</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault D6</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Psychic shooting attack</characteristic>
      </characteristics>
    </profile>
    <profile name="Storm Caller" id="e675-45e6-5a20-7ca8" hidden="false" typeId="8c68-ad11-33db-e3c4" typeName="Psychic Power">
      <characteristics>
        <characteristic name="Power" typeId="1638-2569-4ea3-9b0a">Used at the beginning of the turn. Until the beginning of the Rune Priest's next turn, he and all friendly squads within 6" of him benefit from a 5+ cover save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tempest's Wrath" id="8560-0b84-96b3-b013" hidden="false" typeId="8c68-ad11-33db-e3c4" typeName="Psychic Power">
      <characteristics>
        <characteristic name="Power" typeId="1638-2569-4ea3-9b0a">Used at the beginning of the turn. Until the beginning of the Rune Priest's next turn, all enemy Skimmers, Jetbikes, Jump Infantry and units deployed by Deep Strike that end their move within 24" of the Rune Priest treat all terrain as difficult and dangerous.</characteristic>
      </characteristics>
    </profile>
    <profile name="Fury of the Wolf Spirits (Freki)" id="bd2f-e190-de8a-6e1f" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">5</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">-</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 3</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Psychic shooting attack</characteristic>
      </characteristics>
    </profile>
    <profile name="Fury of the Wolf Spirits (Geri)" id="dda5-fdff-1143-4e0d" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 2</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Psychic shooting attack</characteristic>
      </characteristics>
    </profile>
    <profile name="Murderous Hurricane" id="c1f4-69aa-8d2b-6038" hidden="false" typeId="8c68-ad11-33db-e3c4" typeName="Psychic Power">
      <characteristics>
        <characteristic name="Power" typeId="1638-2569-4ea3-9b0a">Shooting Psychic Attack. An enemy unit within 18" of the Rune Priest takes 3D6 Strength 3 hits with AP -. Next turn that unit treats all terrain as both Difficult and Dangerous.</characteristic>
      </characteristics>
    </profile>
    <profile name="Jaws of the World Wolf" id="dc7a-6437-8486-3725" hidden="false" typeId="8c68-ad11-33db-e3c4" typeName="Psychic Power">
      <characteristics>
        <characteristic name="Power" typeId="1638-2569-4ea3-9b0a">Psychic Shooting attack. Trace a straight line along the board, starting from the Rune Priest and ending 24" away. Monstrous creatures, Beasts, Cavalry, Bikes or Infantry models touched by this line must pass an Initiative test or be removed from play. Monstrous Creatures may subtract one from their dice roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Frost Blade" id="0cc6-1183-fd4f-e2da" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Frost blades or axes are power weapons that add +1 to the user's strength.</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolf Claw" id="334d-cbb2-8528-92cc" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A Wolf Claw is a lightning claw that allows the wielder to either re-roll his To Hit rolls or re-roll his To Wound rolls - the owner must choose at the beginning of each Close Combat phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Belt of Russ" id="b654-3daa-c0f2-2e58" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The bearer has a 4+ Invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Chooser of the Slain" id="22cc-d702-f88c-4b7c" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">An army that includes a Chooser of the Slain may place a Chooser marker anywhere upon the battlefield before the enemy has deployed. This marker must be smaller than the Rune Priest model and cannot be destroyed. Enemy units may not use their Infiltrate rule to deploy within 18" of a Chooser marker. Should the Rune Priest make a Shooting attack at a target that has line of sight to the Chooser marker, he may treat his BS as one higher than normal.</characteristic>
      </characteristics>
    </profile>
    <profile name="Runic weapon" id="05e7-f557-4925-4036" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Runic weapons are a force weapon. Furthermore, whenever an enemy model succeeds on a Psychic test within 24" of the bearer, roll a dice - on the roll of a 4+ that power is nullified. A runic weapon always wounds Daemon models on the roll of a 2+. This special ability has no effect on vehicle models.</characteristic>
      </characteristics>
    </profile>
    <profile name="Fang of Morkai" id="fcef-56b7-9fd5-d8dc" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">All models in the same squad as the bearer are Fearless.</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolf Amulet" id="c58c-7e9f-f584-6ba4" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The bearer gains a 4+ Invulnerable save</characteristic>
      </characteristics>
    </profile>
    <profile name="Mark of the Wulfen" id="fb5b-236f-bf5d-067f" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A model bearing the Mark of the Wulfen has the Rending special rule in close combat. Furthermore he replaces his usual Attacks characteristic with D6+1, rolled immediately prior to when the model makes his attacks. These attacks are made using the mark models' claws and teeth, and hence are not affected by wargear, additional hand weapons and so on, though they may be bolstered by other factors (bonus from charging, Logan Grimnar's Living legend ability, etc).</characteristic>
      </characteristics>
    </profile>
    <profile name="Thunderwolf Mount" id="56ef-2c97-346a-47c4" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A character with a Thunderwolf Mount has the unit type of Cavalry, adds +1 Strength, +1 Toughness , and +1 Attack to his profile, and has the Rending special rule in close combat with any attack that does not use a special close combat weapon. However, he may only join Thunderwolf Cavalry or Fenrisian Wolves units.</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolf Tail Talisman" id="a3a6-d8c5-66e4-56b4" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">If a model with a Wolf Tail Talisman or the unit he is with is affected by an enemy psychic power, roll a D6. On the roll of 5+ that power is nullified.</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolftooth Necklace" id="dee4-517f-9d1a-f205" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">In close combat, a model with a Wolftooth necklace always hits on the roll of a 3+ regardless of comparative Weapon Skills.</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolf Standard" id="5a4c-7ef4-ef3c-394f" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Once per game, a unit that includes a wolf standard may call upon the power of the wolf. For the duration of the next Assault phase, all models in that unit may re-roll any dice rolls of a 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saga of the Wolfkin" id="350d-1360-c2da-ebfe" hidden="false" typeId="7128-e7c3-9116-6f29" typeName="Saga">
      <characteristics>
        <characteristic name="Description" typeId="77c8-ced4-c929-3e49">Fenrisian Wolves and Cyberwolves in the same army as the character have Initiative 5 and Leadership 7.</characteristic>
        <characteristic name="Oath" typeId="7c9b-c9de-3c29-3868">Honour of the Wolfkin: At least one Fenrisian Wolf or Thunderwolf should survive the battle.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saga of the Bear" id="a13e-a2ae-fb32-5899" hidden="false" typeId="7128-e7c3-9116-6f29" typeName="Saga">
      <characteristics>
        <characteristic name="Description" typeId="77c8-ced4-c929-3e49">The character has the Eternal Warrior Rule</characteristic>
        <characteristic name="Oath" typeId="7c9b-c9de-3c29-3868">Visit fury upon the evil ones: Deal the death blow to an enemy character before the end of the game.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saga of Majesty" id="fb2c-4d02-0b68-4520" hidden="false" typeId="7128-e7c3-9116-6f29" typeName="Saga">
      <characteristics>
        <characteristic name="Description" typeId="77c8-ced4-c929-3e49">Any unit within 6", including the character and his unit, may re-roll failed Morale tests.</characteristic>
        <characteristic name="Oath" typeId="7c9b-c9de-3c29-3868">Lead by example: A hero that falls back or goes to ground is unworthy of the name; avoid this at all costs.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saga of the Hunter" id="22cd-9aa5-9422-11f3" hidden="false" typeId="7128-e7c3-9116-6f29" typeName="Saga">
      <characteristics>
        <characteristic name="Description" typeId="77c8-ced4-c929-3e49">The character has the ability to outflank and the Stealth rule.</characteristic>
        <characteristic name="Oath" typeId="7c9b-c9de-3c29-3868">Attack unseen: A true hunter always attacks from an unexpected angle and hense this character should be held in reserve at the beginning of the game.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saga of the Warrior Born" id="3215-b6e5-8fd5-834f" hidden="false" typeId="7128-e7c3-9116-6f29" typeName="Saga">
      <characteristics>
        <characteristic name="Description" typeId="77c8-ced4-c929-3e49">During the Assault phase, the character gets a bonus to his Attack equal to the number of models he killed during the previous Assault phase.</characteristic>
        <characteristic name="Oath" typeId="7c9b-c9de-3c29-3868">Reap a great tally: Keep the models killed by this character to one side - if he kills ten or more models he's upheld his reputation as a champion of Fenris. You might like to keep a record of particularly impressive tallies.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saga of the Beastslayer" id="bef1-f9c0-5835-0846" hidden="false" typeId="7128-e7c3-9116-6f29" typeName="Saga">
      <characteristics>
        <characteristic name="Description" typeId="77c8-ced4-c929-3e49">The character may re-roll failed To Hit rolls against walkers, monstrous creatures, and models with a Toughness of 5 or more.</characteristic>
        <characteristic name="Oath" typeId="7c9b-c9de-3c29-3868">Fear not the Beast: To show that he is not afraid of the mightiest evils, the character should have slain a model of one of the types listed above before the end of the game.</characteristic>
      </characteristics>
    </profile>
    <profile name="Saga of the Iron Wolf" id="a8c6-09f3-62af-133f" hidden="false" typeId="7128-e7c3-9116-6f29" typeName="Saga">
      <characteristics>
        <characteristic name="Description" typeId="77c8-ced4-c929-3e49">Any vehicle containing the character may move an extra D3", and the character adds one to any Repair roll he makes.</characteristic>
        <characteristic name="Oath" typeId="7c9b-c9de-3c29-3868">Take the fight to the Enemy: The character can prove the effectiveness of his armoured assaults by ending the battle within the enemy deployment zone.</characteristic>
      </characteristics>
    </profile>
    <profile name="Runic Armour" id="eac9-dbf2-fa70-a3c7" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A model in runic armour has a 2+ armour save. Furthermore the wearer of runic armour has a 5+ invulnerable save against all wounds caused by psychic attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bjorn the Fell-Handed" id="d3c5-42f2-cd4f-a839" hidden="false" typeId="acd3-2539-3641-1250" typeName="Walker Vehicle">
      <characteristics>
        <characteristic name="WS" typeId="3d9c-8977-9b95-824b">6</characteristic>
        <characteristic name="BS" typeId="ea47-07be-ab4a-6569">6</characteristic>
        <characteristic name="STR" typeId="a630-c404-957f-a49f">7</characteristic>
        <characteristic name="F" typeId="3549-2d9e-3052-b396">13</characteristic>
        <characteristic name="S" typeId="94fc-8af8-d4d4-7b1a">12</characteristic>
        <characteristic name="R" typeId="4eca-6e3c-2053-e75a">10</characteristic>
        <characteristic name="I" typeId="f706-f227-5d93-0fe3">3</characteristic>
        <characteristic name="A" typeId="12be-9dd2-0dd7-b17a">4</characteristic>
      </characteristics>
    </profile>
