        <profile name="Oath of War" id="c743-7c66-4950-b121" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The Wolf Priest may nominate one unit type at the beginning of the game - 'infantry' or 'monstrous creatures', for example. He and any squad he joins have the Preferred Enemy rule against that enemy type.</characteristic>
