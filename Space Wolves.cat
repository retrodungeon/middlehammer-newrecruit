    <profile id="77cd0765-7ddf-d654-cc86-3de641888ae3-821f2" name="Terminator Armour" page="99" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 5+ Invul Sv, Relentless, Bulky, Deep Strike, may not make Sweeping Advances.</characteristic>
      </characteristics>
    </profile>
    <profile id="54499d02-5c6c-4ba2-831c-7b6be78574fa-821f2" name="The Armour of Russ" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 4+ Invul Sv. Furthermore, when fighting in a challenge, the wearer's opponent suffers a -5I (to a minimum of 1).</characteristic>
      </characteristics>
    </profile>
    <profile id="794e1a0c-a688-9e15-7548-5a3935b3c36b-821f2" name="The Axe Langnvast" page="126" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2-handed Power Weapon, Adds +1 to its user's Strength and allows them to re-roll any assault Hits which fail to Wound.</characteristic>
      </characteristics>
    </profile>
    <profile id="6ec50cc6-f4ff-6618-f66f-fafb9928dcab-821f2" name="The Axe Morkai" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May be used singled-handed (1A) as a Frost Blade, or double-handed (2A) as a Power Fist. Can mix both types as you choose.</characteristic>
      </characteristics>
    </profile>
