    <selectionEntry id="c803-fdf8-a5f4-55c5-821f2" name="The Firehowlers" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="ec7f-3211-d5e6-8ac3-821f2" name="Eager for Combat" page="36" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Firehowlers units can re-roll failed charge rolls.</description>
        </rule>
        <rule id="41f3-3ad9-5a4f-ed35-821f2" name="Bloodcurdling Charge" page="36" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units attempting to fire Overwatch at a charging Firehowlers unit must first pass a Leadership test or be unableto fire Overwatch for the duration of that Assault phase. In addition, units from this formation cause Fear on the turn they charge. Enemy units with the And They Shall Know No Fear or Fearless special rules are immune to the effects of Bloodcurdling Charge.</description>
        </rule>
        <rule id="2bd2-3404-9968-76be-821f2" name="Rising Fury" page="36" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If you roll a 10 or more when determining the charge distance of a Firehowlers unit, all models in that unit have the Furious Charge special rule that turn.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c803-fdf8-a5f4-55c5-maxSelections-821f2" type="max" />
