      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1/User*</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3/4*</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-2a0e-e1f0-5ea0-5799" name="Nuncio-vox" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If one of the controlling player’s units wishes to arrive on the battlefield via Deep Strike and chooses to do so within 6" of a unit equipped with a nuncio-vox, then it will not scatter. When barrage weapons are being used by the controlling player, line of sight may be drawn from any model in their force equipped with a nuncio-vox as well as the firing model itself (range is still drawn from the firing model, etc). Note that the nuncio-vox model must already be on the table at the start of the turn for it to be used (and cannot be used from inside a vehicle).  </characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-d187-89fe-0b05-808e" name="Legion Vexilla" publicationId="ca571888--pubN80998" page="132" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A unit with a Legion Vexilla may re-roll failed Morale checks.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-3a71-7de1-1948-3655" name="Flamer" publicationId="ca571888--pubN106502" page="177" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Template</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">5</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-0fef-f304-fdfe-b082" name="Heavy Chainsword" publicationId="ca571888--pubN106502" page="180" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">5</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-8ae4-74e5-7700-3804" name="Meltagun" publicationId="ca571888--pubN106502" page="178" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1, Melta</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-87c7-bd37-70f7-1933" name="Plasma Gun" publicationId="ca571888--pubN106502" page="178" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Rapid Fire, Gets Hot</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-c554-a05e-607c-5831" name="Heavy Flamer" publicationId="ca571888--pubN106502" page="177" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Template</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-a1d8-f9f3-865a-9faf" name="Melta Bombs" publicationId="ca571888--pubN106502" page="183" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Armourbane, Unwieldy</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-d890-1b84-bbd9-12d3" name="Frag Grenades" publicationId="ca571888--pubN106502" page="182" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">-</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-d9f7-775b-1047-f335" name="Krak Grenade (Shooting)" publicationId="ca571888--pubN106502" page="183" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-f095-0842-a6b1-5404" name="Jump Pack" publicationId="ca571888--pubN105292" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers Jump Unit rules.  </characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-271e-6286-86cc-06dd" name="Heavy Bolter" publicationId="ca571888--pubN106502" page="177" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 3</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-97a5-0583-4a2b-c44e" name="Graviton Gun" publicationId="ca571888--pubN106502" page="177" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">Special</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast, Concussive, Graviton Pulse*, Haywire</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-c1d3-0c64-3702-f5f9" name="Lascutter" publicationId="ca571888--pubN80998" page="135" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">9</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Unwieldly, Cumbersome</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-7b47-c268-cdaf-fa1e" name="Narthecium" publicationId="ca571888--pubN80998" page="132" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">While any model carrying this specialised medical and alchemical gear in a unit is in play, all models with the Legiones Astartes special rule, including any Independent Characters with the Legiones Astartes special rule that have joined the unit, gain the Feel No Pain special rule.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-0434-8c4b-9614-73dd" name="Space Marine Bike" publicationId="ca571888--pubN105292" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">+1 Toughness, cannot Go to Ground, and cannot be Pinned, not slowed down by difficult terrain, treat all difficult terrain as dangerous, Move 3D6" when Falling Back, Turbo-boost up to 12".  Bikes have the Hammer of Wrath, Jink, Relentless and Very Bulky special rules.
Each Bike in a unit can fire with one weapon for each rider on the Bike. Thus a Space Marine Attack Bike with a driver and passenger in sidecar can fire two weapons.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-3c28-4994-00ed-bbe5" name="Space Marine Jetbike" publicationId="ca571888--pubN105292" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">+1 Toughness, 2+ Save, cannot Go to Ground, and cannot be Pinned, not slowed down by difficult terrain, treat all difficult terrain as dangerous, Move 3D6" when Falling Back, Turbo-boost up to 24". Jjetbike have the Hammer of Wrath, Jink, Relentless and Very Bulky special rules.
Jetbikes can move over all other models and terrain freely. However, if a moving Jetbike begins or ends its move in difficult terrain, it must take a Dangerous Terrain test. Jetbikes cannot end their move over other models or impassable terrain, except that they can end their move on top of impassable terrain if it is actually possible to place the models on top of it. If they do so, they treat the impassable terrain as dangerous terrain.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-376f-adc9-b9bf-7fc9" name="Augury Scanner" publicationId="ca571888--pubN80998" page="131" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Models cannot be deployed using the Infiltrate special rule within 18" of a model with an augury scanner, regardless of line of sight. At the end of the enemy Movement phase, if a friendly unit contains at least one model equipped with an augury scanner, all of the ranged weapons in that unit can be fired against any one enemy unit that has arrived from reserve within 18" and line of sight as if it were the controlling player’s Shooting phase. If this rule is used, these weapons cannot be fired again until the end of the controlling player’s next turn, but the firing models may shoot different weapons if they have any.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-7b4d-1c91-ab33-1b12" name="Plasma Grenades" publicationId="ca571888--pubN105292" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-79c7-90f6-b453-e799" name="Extra Armour" publicationId="ca571888--pubN105292" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Vehicles equipped with extra armour count Crew Stunned results from the Vehicle Damage table as Crew Shaken results instead.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-cb4a-644f-bd8d-7d97" name="Flare Shield" publicationId="ca571888--pubN80998" page="132" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A flare shield operates against shooting attacks that strike the vehicle’s front arc. It reduces the strength of attacks by weapons with the Template or Blast type by -2, and other shooting attacks’ Strength by -1. A flare shield has no effect on close combat attacks or attacks inflicted with the Destroyer special rule.  </characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-1578-d22a-060c-4700" name="Machine Spirit" publicationId="ca571888--pubN80998" page="132" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A vehicle equipped with a Machine Spirit gains the Power of the Machine Spirit special rule.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-7861-701e-b6d5-be87" name="Predator Cannon" publicationId="ca571888--pubN67227" page="93" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-890c-3cfe-af38-b022" name="Magna-Melta" publicationId="ca571888--pubN106502" page="178" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Large Blast, Melta</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-c2dc-5db9-b18b-d360" name="Flamestorm Cannon" publicationId="ca571888--pubN106502" page="177" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Template</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 1</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-6875-ee73-2a85-6a97" name="Smoke Launchers" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Once per game, instead of shooting or flat out movements/running, the vehicle can activate smoke launchers. May not fire its weapons that turn but recieves a 5+ cover save until next player turn. Unaffected by weapon destroyed, crew shaken and crew stunned results.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-1cce-972c-022a-2590" name="Lascannon" publicationId="ca571888--pubN106502" page="178" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">9</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-c5c3-cf81-76c6-b0c0" name="Auxiliary Drive" publicationId="ca571888--pubN80998" page="131" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A vehicle with an auxiliary drive may repair Immobilised results it suffers on a D6 roll of 4+ at the start of the controlling player's Movement phase.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-35a2-2083-1522-cd61" name="Dozer Blade" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Vehicles equipped with dozer blades treat their front armour as one higher than normal when ramming. The vehicle can re-roll failed Dangerous Terrain tests.</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-a117-de7b-6200-3076" name="Hunter-killer Missile" publicationId="ca571888--pubN105292" page="" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Infinite</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, One Use Only</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-40e6-c95c-7c8d-cf02" name="Frag Missile" publicationId="ca571888--pubN106502" page="178" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">6</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-13df-d6b0-3f33-bf9b" name="Plasma Cannon" publicationId="ca571888--pubN106502" page="178" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast (3"), Gets Hot</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-c9ab-e5ee-05cd-da3e" name="Plasma Executioner" publicationId="ca571888--pubN113187" page="127" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 3, Blast (3")</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-d55f-eed0-800f-5789" name="Autocannon" publicationId="ca571888--pubN106502" page="176" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 2</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-94da-501b-a2f5-6c61" name="Battlecannon" publicationId="ca571888--pubN106502" page="176" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">72"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Ordance 1, Large Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-8194-4688-65b3-f996" name="Chainfist" publicationId="ca571888--pubN106502" page="180" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Armourbane, Specialist Weapon, Unwieldy</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-3b26-3098-155f-0e58" name="Dreadnought Close Combat Weapon" publicationId="ca571888--pubN106502" page="180" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-c019-5c9a-c1f4-4b4f" name="Force Axe" publicationId="ca571888--pubN106502" page="180" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
