          <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">-</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Sniper, Anti-Materiel Rounds</characteristic></characteristics></profile>
      </profiles>
      <rules>
        <rule id="mh-rad-space-wolves-b5fe-8e85-50c0-5c44" name="Anti-Materiel Rounds" hidden="false">
          <description>Models firing Anti-Material Rounds lose Precision Shots when firing them. In addition the unit containing modesl using these rounds suffer -1 to their cover saves in the next turn.</description>
