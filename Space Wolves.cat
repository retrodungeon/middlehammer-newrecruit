  <selectionEntry name="Wolf Guard Pack" id="d967-b68c-2836-1353" hidden="false" import="true" type="unit">
      <infoLinks>
        <infoLink name="Acute Senses" id="99f9-e5f6-9469-98f9" hidden="false" targetId="253f-bb05-f8fd-fffd" type="profile" />
        <infoLink name="And They Shall Know No Fear" id="5c66-92ba-9873-bd79" hidden="false" targetId="73f8-658e-9da5-beba" type="rule" />
        <infoLink name="Counter-Attack" id="9e0f-7664-78ee-e4c0" hidden="false" targetId="98cd-d727-4827-db44" type="profile" />
      </infoLinks>
      <rules>
        <rule name="Pack Leaders" id="437f-3964-f2f5-b8a0" hidden="false">
          <description>Before the battle, each Wolf Guard has the option of being split off from his pack and assigned to lead a different pack from the following list: Blood Claws, Swiftclaw Bike Packs, Grey Hunters, Wolf Scouts, Long Fangs. Only one Wolf Guard may join each pack in this manner. Wolf Guard in Terminator armour, with jump packs or mounted on Space Marine Bikes may not join Wolf Scouts units.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="One Wolf Guard may take the Mark of the Wulfen" id="aa59-f923-5f08-6144" hidden="false" import="true" type="upgrade">
