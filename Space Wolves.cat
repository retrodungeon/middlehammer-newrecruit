    <selectionEntry id="mh-rad-space-wolves-09ee-4370-1462-2cb5" name="Questoris Knight Crusader" publicationId="ca571888--pubN91142" page="112" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-space-wolves-09ee-4370-1462-2cb5-maxSelections" type="max" />
      </constraints>
