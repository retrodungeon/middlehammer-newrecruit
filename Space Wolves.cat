    <profile id="mh-rad-space-wolves-e1d88320-50a5-edf3-0542-004b2f5c917e" name="Space Marine Legion Crew" publicationId="ca571888--pubN80998" page="65" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
