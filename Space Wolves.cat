          </constraints>
          <rules>
            <rule id="6707-165f-6253-c0f2" name="Chooser of the Slain" hidden="false">
              <description>Enemy infiltrators may not set up using their special rules against a Space Wolves army that includes a Rune Priest with a Chooser of the Slain unless they first roll a 4+ on 1D6 (roll separately for each unit). In addition, Rune Priests that have a Chooser of the Slain count as having an additional close combat weapon in close combat.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
