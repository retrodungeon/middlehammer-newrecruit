    <profile id="b8391d3e-f7b1-64eb-1d19-0887431b1207-821f2" name="Psychic - Murderous Hurricane" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
