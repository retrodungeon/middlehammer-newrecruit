    <selectionEntry id="mh-rad-space-wolves-6d35-9295-4cdc-0b41" name="Sicaran Arcus Strike Tank (Heresy)" publicationId="ca571888--pubN103311" page="" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="mh-rad-space-wolves-ca1f-4141-8ceb-4057" name="Ripple Fire" hidden="false">
          <description>On any turn in which the Sicaran Arcus does not move in both the Movement phase and the Shooting phase, the controlling player may choose to have the twin arcus launcher fire twice in the Shooting phase. If the controlling player chooses to fire the weapon twice, both attacks must target the same unit and use the same profile.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-space-wolves-8b05-bbb1-fc4d-0d00" name="Sicaran Pattern Tank" hidden="false" targetId="mh-rad-space-wolves-b33b-ae25-d3ca-3b18" type="profile">
