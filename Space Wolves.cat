        <infoLink name="Krak Grenades" id="ae47-6f4a-5712-3c20" hidden="false" targetId="0a12-b99c-7d80-2ab6" type="profile" />
        <infoLink name="Power Weapon" id="410e-7628-4757-bc78" hidden="false" targetId="31dd-6647-d267-e3c2" type="profile" />
