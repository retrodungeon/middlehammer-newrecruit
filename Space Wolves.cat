        <selectionEntry id="mh-rad-space-wolves-a7f7-d43f-fe35-8091" name="Hurricane Talons" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-space-wolves-6110-a5b8-a641-51c8" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-space-wolves-d7ca-53a0-dffa-73ef" name="Hurricane Talons" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Shred, Paired Weapons (+1 Attack), Storm of Claws</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-space-wolves-2dad-e809-4979-7210" name="Storm of Claws" hidden="false">
              <description>The bearer fights with an additional D3 extra attacks, rolled each round of combat. However, all attacks are made with a WS penalty equal to the number of bonus attacks.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="mh-rad-space-wolves-c873-5235-b309-ce25" name="Paired Weapons" hidden="false" targetId="mh-rad-space-wolves-f495-679e-1976-68d1" type="rule" />
            <infoLink id="mh-rad-space-wolves-e3be-a101-1983-a6b3" name="Shred" hidden="false" targetId="mh-rad-space-wolves-89da-0cb5-bee4-8ec2" type="rule" />
            <infoLink id="mh-rad-space-wolves-cd97-bec1-222e-8b67" name="Two-Handed" hidden="false" targetId="mh-rad-space-wolves-b11c-0ef4-af6b-d96f" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-space-wolves-392f-d1ef-3ec8-4eb2" name="Hydragyros Executioner Blade" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-space-wolves-2137-c81b-8830-df2d" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-space-wolves-0937-2b49-dfe4-2893" name="Hydragyros Executioner Blade" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Two-handed, Grants –2 Initiative</characteristic></characteristics></profile>
          </profiles>
          <infoLinks>
            <infoLink id="mh-rad-space-wolves-dea4-fd4a-38b1-e160" name="Two-Handed" hidden="false" targetId="mh-rad-space-wolves-b11c-0ef4-af6b-d96f" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="mh-rad-space-wolves-44fe-201d-d864-5ffb" name="Nanofractal Falchion" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-space-wolves-a436-e33c-8aff-2998" type="max" />
          </constraints>
          <profiles>
            <profile id="mh-rad-space-wolves-882e-df21-75d5-ae9f" name="Nanofractal Falchion" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Rending, Fleshbane</characteristic></characteristics></profile>
          </profiles>
          <infoLinks>
            <infoLink id="mh-rad-space-wolves-7f53-e4d6-0ce2-6a4e" name="Rending" hidden="false" targetId="mh-rad-space-wolves-8269-2cd6-9236-16e7" type="rule" />
            <infoLink id="mh-rad-space-wolves-df7a-e195-1278-75b2" name="Fleshbane" hidden="false" targetId="mh-rad-space-wolves-4575-0a0a-caaf-e4bf" type="rule" />
          </infoLinks>
