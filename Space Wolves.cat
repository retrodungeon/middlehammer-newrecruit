    <selectionEntry name="Lone Wolf" id="ab44-84c1-3187-8e13" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
      </costs>
      <infoLinks>
        <infoLink name="Lone Wolf" id="fd9b-74d6-c08c-c960" hidden="false" targetId="a506-d747-57d8-dca2" type="profile" />
