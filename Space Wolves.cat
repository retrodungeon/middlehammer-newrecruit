    <selectionEntry id="d371-b7fd-89b8-5a87-821f2" name="Spear of Russ" page="44" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="c574-839f-4977-7a33-821f2" name="Alpha Machine Spirits" page="44" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Vehicles from a Spear of Russ have the Power of the Machine Spirit special rule whilst they are within 12" of any Land Raiders, Land Raider Crusaders or Land Raider Redeemers from the same Formation.</description>
        </rule>
        <rule id="3216-05b4-6914-c16d-821f2" name="Lord of Iron" page="44" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of each of your Shooting phases, nominate one vehicle from a Spear of Russ that is either transporting, or is within 6" of, any Iron Priests from the same Formation. That vehicle gains a special rule from the following list for that phase: Monster Hunter, Precision Shots, Preferred Enemy, Tank Hunters.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
