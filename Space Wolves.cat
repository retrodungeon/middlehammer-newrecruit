      <rules>
        <rule id="fbb0-cc5b-774b-bec5-821f2" name="Duty or Death" page="32" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Krom can re-roll all failed saving throws when he is within 3" of an Objective Marker.</description>
        </rule>
        <rule id="39b5-3c6b-8034-6934-821f2" name="The Fierce-eye" page="32" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Krom can re-roll failed To Wound rolls in close combat.</description>
        </rule>
      </rules>
