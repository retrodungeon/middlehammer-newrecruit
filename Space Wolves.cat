    <rule id="6b027d06-7ca1-de2c-e2f6-670a3ab0f557-821f2" name="Protect the King!" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>As long as Logan Grimnar is alive and on the battlefield, all models in this Formation have the Fearless special rule. If Logan Grimnar is slain, the Fearless special rule is replaced with the Zealot special rule.</description>
    </rule>
    <rule id="8a33f832-04c0-1581-2fa6-7d2824f0ff99-821f2" name="Psychic Choirs" page="0" hidden="false">
      <profiles />
      <rules />
