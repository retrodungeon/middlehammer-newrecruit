    <profile id="28f2e6a3-fa58-f06d-3128-d5047027c925-821f2" name="Wolf Standard" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any friendly units with the Space Wolves Faction within 12" of the model bearing this banner re-roll failed Morale checks and Pinning tests. In addition, all models in friendly units with the Space Wolves Faction within 6" of the bearer gain +1 Attack.</characteristic>
      </characteristics>
    </profile>
    <profile id="54f11d4d-0b4f-2b56-fbaa-84078f164193-821f2" name="Wolf Tail Talisman" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the bearer or his unit is affected by an enemy Psychic power, that power is nullified by rolling 5+ on a D6</characteristic>
      </characteristics>
    </profile>
    <profile id="6ef616e4-a297-8f77-7b23-b584599c2654-821f2" name="Wolftooth Necklace" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Against models with a WS, bearer always Hits in close combat on a 3+</characteristic>
