    <selectionEntry id="mh-rad-space-wolves-6683-c57a-0a90-e0f2" name="Legion Malcador Assault Tank (Heresy)" publicationId="ca571888--pubN80998" page="81" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="mh-rad-space-wolves-9877-af46-2c99-b1cb" name="Battle Speed" publicationId="ca571888--pubN80998" page="81" hidden="false">
          <description>When the Malcador Assault Tank moves Flat Out in the Shooting phase, it may choose to fire its traverse-mounted weapon at its full Ballistic Skill, either before or after the Flat Out move, but may fire no other weapons.</description>
        </rule>
        <rule id="mh-rad-space-wolves-013b-ace3-f3a5-fd22" name="Lumbering Behemoth (Mournival)" hidden="true">
          <description> If the tank only moves 6” or less it may fire all of its weapons at full BS (ignoring that Ordnance weapons cause snap shots).</description>
        </rule>
      </rules>
      <infoLinks>
