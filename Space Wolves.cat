        <infoLink name="Fearless" id="53f3-eba2-12ae-4b05" hidden="false" targetId="1380-eda3-7a3b-055c" type="profile" />
      </infoLinks>
      <profiles>
        <profile name="Wolf Helm of Russ" id="643d-dc68-a293-f0fe" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Any Space Wolves unit that can trace a line of sight to Ulrik may re-roll any failed Morale tests they are called upon to make. In addition, any enemy with the Indipendent Character special rule who wants to allocate any close combat attacks towards Ulrik must first pass a Leadership test. If they fail they may not attack at all that turn as they quail before Ulrik's terrifying gaze.</characteristic>
          </characteristics>
        </profile>
        <profile name="Slayer's Oath" id="85a8-cddb-462f-e9fa" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">When Ulrik and any model in the squad he has joined allocate their attacks against a model with a Toughness of 5 or more, they may re-roll all failed rolls to Hit and To Wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mentor" id="20f0-e8b7-2f5b-25e7" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">You may pick one other model in the army as having been personally trailed by Ulrik (this may not be a Unique model). This model gains +1 Weapon Skill, to a maximum of 6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
