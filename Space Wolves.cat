          <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 18, </characteristic></characteristics></profile>
      </profiles>
      <rules>
        <rule id="mh-rad-space-wolves-6a05-3aaa-0c64-0a52" name="Rolling Thunder" publicationId="ca571888--pubN106705" hidden="false">
          <description>On any turn in which the Sicaran Punisher does not move in both the Movement phase and Shooting phase, the controlling player may choose to have the punisher rotary cannon gain the Rending special rule for any shooting attacks made that turn.</description>
        </rule>
      </rules>
