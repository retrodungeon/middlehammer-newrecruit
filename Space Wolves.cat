            <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dd66-ca3b-f6b8-30ef" type="max" />
          </constraints>
          <rules>
            <rule id="caf7-c198-159e-a9fd" name="Wolf Totem" hidden="false">
              <description>Add +1 to the Space Marine combat resolution score of any assault that takes place within 6" of the Wolf Totem.
However, if the model bearing the standard is slain in close combat, then the enemy model that slew him captures the standard gains the +1 bonus to combat resolution from then on. It is possible for the model to change hands multiple times per game.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20.0" />
          </costs>
