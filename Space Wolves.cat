          </constraints>
          <profiles>
            <profile id="mh-rad-space-wolves-28f7-f63a-cfa6-6210" name="Gyrocyclic Reaver Blade" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Grants +1 Attack</characteristic></characteristics></profile>
          </profiles>
