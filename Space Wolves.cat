    <selectionEntry id="mh-rad-space-wolves-5e9c6a5f-b807-27ae-8a84-90129437976b" name="Legion Veteran Tactical Squad (Heresy)" publicationId="ca571888--pubN80998" page="20" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="name" value="Veteran Breacher Squad, Legion">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition field="selections" scope="mh-rad-space-wolves-5e9c6a5f-b807-27ae-8a84-90129437976b" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="mh-rad-space-wolves-0fca-0434-a505-7b7a" type="equalTo" />
                <condition field="selections" scope="mh-rad-space-wolves-5e9c6a5f-b807-27ae-8a84-90129437976b" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="mh-rad-space-wolves-10d4-f9ae-1350-b4ab" type="equalTo" />
                <condition field="selections" scope="mh-rad-space-wolves-5e9c6a5f-b807-27ae-8a84-90129437976b" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="mh-rad-space-wolves-284a-0cf6-3cb7-3aec" type="equalTo" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        </modifiers>
      <rules>
        <rule id="mh-rad-space-wolves-4a499844-30b4-d34f-f4b6-0d423502748f" name="Veteran Tactics" publicationId="ca571888--pubN80998" page="28" hidden="false">
          <description>Before the game begins, you must select one of the following special abilities for the squad:

- Resolve: The unit gains the Stubborn special rule.
- Weaponmasters: The unit gains 1 Weapon Skill.
- Machine Killers: The unit gains 1 on their Armour Penetration rolls.
- Stalkers: The unit gains the Scout special rule.
- Xenobane: The unit may re-roll To Wound rolls against Monstrous Creatures and Gargantuan Creatures.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-space-wolves-c2177d28-cdfd-5ccd-13ae-12fafad8bb4f" name="Implacable Advance" hidden="false" targetId="mh-rad-space-wolves-5ecb-551d-0f68-3a79" type="rule" />
