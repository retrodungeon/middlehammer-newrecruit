    </profile>
    <profile id="97e36767-02b8-1a05-9140-e8ba096e3c29-821f2" name="Armour of Asvald Stormwrack" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 4+ Invul Sv, Bulky, Deep Strike, It Will Not Die, Relentless, may not make Sweeping Advances.</characteristic>
      </characteristics>
    </profile>
    <profile id="f672f65a-522d-9ad2-0ec9-b3304385dbe9-821f2" name="Armoured Cockpit" page="6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Ignore Crew Shaken or Crew Stunned on a 4+</characteristic>
      </characteristics>
    </profile>
    <profile id="6370155d-69ef-fd4a-a94b-4957e3c9dde1-821f2" name="Assault Drill" page="171" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">DCCW; +D6 to pen. bunkers, fortifications, bastions, other buildings &amp; any vehicle classed as stationary that turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="7ea5e1f0-19de-ebb7-69f7-7a7faed89eb4-821f2" name="Assault Drill In-built Heavy Flamer" page="171" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In addition to normal use, if the DCCW inflicts a pen. hit against a building/vehicle that is occupied, but the target is not destroyed outright, then all models inside suffer a single Heavy Flamer hit automatically after the Dreadnought's other attacks have been resolved (Str 5, Ap 4, distributed as per wounds from a shooting attack). This flamer hit only occurs once per Combat phase, not once per hit.</characteristic>
      </characteristics>
    </profile>
    <profile id="ea1b2ee9-dd66-d035-b8fa-aef8719f33c1-821f2" name="Atomantic Shielding" page="6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invul Sv against shooting/explosions; 6+ Invul Sv against close combat. If the Contemptor suffers a 'Vehicle Explodes' damage result, add +1" to blast radius.</characteristic>
      </characteristics>
    </profile>
    <profile id="69781626-a109-0c47-0c2a-eb30a475e2d5-821f2" name="Avenger Bolt Cannon" page="139" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
