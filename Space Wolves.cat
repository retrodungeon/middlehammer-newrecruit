        <modifier affects="self.entries.forces.2771-5c25-e782-cd67" field="hidden" scope="force" type="set" value="true" />
        <modifier affects="self.entries.forces.86cf-b25b-4370-1d18" field="hidden" scope="force" type="set" value="false" />
      </modifiers>
      <profiles>
        <profile name="Living Legend" id="7467-3fae-8bbe-a693" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Once per game, Logan can call use this ability. For the rest of the player turn, all friendly models within 18" get +1 Attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="The High King" id="e8ee-06f8-46d4-d254" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model may choose one of the following special rules at the beginning of each turn: Fearless, Tank Hunter, Relentless, Preferred Enemy. Logan and any unit he is with have that rule for the duration of that player turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Axe of Morkai" id="c01d-d8c8-3fd4-a036" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Logan may use this weapon as a Frost Blade or a Power Fist. Logan may allocate his Attacks as he sees fit between these two modes; for example, taking two of his Attacks as power fist attacks and the rest as frost blade attacks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="The Great Wolf" id="cba1-ccf4-2ecd-1fe5" hidden="false">
          <description>Wolf Guard units count as Troops in any army that includes Logan Grimnar.</description>
        </rule>
      </rules>
    </selectionEntry>
