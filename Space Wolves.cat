      </constraints>
      <rules>
        <rule id="b644-fafd-eeb8-da38" name="Wolf Priest" hidden="false">
          <description>If a Wold Priest joins a Wulfen pack, you may choose whether or not it is subject to the Animal Rage rule each turn, so long as the Wolf Priest is with the pack. If the pack moves due to the Animal Rage rule, the Wolf Priest will move with them, but may not fire any weapons in the Shooting phase. A Wolf Priest may not take the Mark of the Wulfen.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="992a-203a-8505-4eaa" name="Scouts" hidden="false" targetId="8979-e442-986d-39d3" type="rule" />
