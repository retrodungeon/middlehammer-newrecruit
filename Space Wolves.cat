    <profile id="mh-rad-space-wolves-352f5f7a-45e0-0416-e7cd-1cb8f985b0ac" name="Legion Standard" publicationId="ca571888--pubN80998" page="90" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">All of the Controlling player's unist with the Legiones Astartes special rule within 6" of a Legion Standard (including its bearer) are Fearless.  </characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-959ff616-ce22-b9ee-1ee6-2496b305e880" name="Mantle of the Elder Drake" publicationId="ca571888--pubN113187" page="65" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers Eternal Warrior</characteristic></characteristics></profile>
