    <selectionEntryGroup id="mh-rad-space-wolves-314b-76e2-509a-9d48" name="Rite of War" hidden="false" collective="false" import="true">
      <modifiers>
        <modifier type="set" field="mh-rad-space-wolves-a77b-7d4a-9dee-e188" value="0.0">
          <conditionGroups>
            <conditionGroup type="and">
