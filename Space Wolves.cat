      </characteristics>
    </profile>
    <profile id="f7db025a-18cf-7403-3c97-a7c384c6fe2c-821f2" name="Psychic Hood" page="68" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit/model is targeted by an enemy psychic power and is within 6" of a friendly model with a psychic hood, the wearer may attempt to Deny the Witch as if he were in the unit.</characteristic>
      </characteristics>
    </profile>
