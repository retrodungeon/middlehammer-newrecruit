                    <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-space-wolves-0df0a0f1-9ddf-f57b-cada-26dce57443ec-minSelections" type="min" />
