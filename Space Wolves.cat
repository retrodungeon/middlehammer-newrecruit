    <profile id="72e202d2-1299-f96f-6688-145b6679593c-821f2" name="Teleport Beacon" page="186" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units arriving by teleport (using deep strike), which are part of the force containing the Damocles, do not scatter if they choose to arrive within 12" of Damocles.</characteristic>
      </characteristics>
    </profile>
    <profile id="46cd6439-2dc3-2f42-0174-cb6b696f29e3-821f2" name="Teleport Homer" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Terminator models in the same army as the Teleport Homer wishing to Deep Strike within 6" of the model will not scatter, so long as the equipped model has not moved Flat Out whilst hovering or is operating as a Flyer that turn.</characteristic>
      </characteristics>
    </profile>
