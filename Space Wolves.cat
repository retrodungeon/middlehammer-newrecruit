    <selectionEntry id="mh-rad-space-wolves-9fb7-a82a-11cb-fc8e" name="Legion Seeker Squad (Heresy)" publicationId="ca571888--pubN80998" page="48" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="mh-rad-space-wolves-3376-8a4e-a355-3135" name="Special Issue Ammunition" publicationId="ca571888--pubN80998" page="48" hidden="false">
          <description>Seeker Space Marines are equipped with Kraken, Scorpius and Tempest bolt shells for their bolters (and combi-weapons where applicable), and may choose which to use each turn they fire.</description>
        </rule>
        <rule id="mh-rad-space-wolves-8e27-703d-8305-4072" name="Marked for Death" publicationId="ca571888--pubN80998" page="48" hidden="false">
          <description>After deployment, each Seeker unit may specify a single enemy unit or Independent Character as being 'Marked for Death.'  The Legion Seeker unit now counts as having the Preferred Enemy special rule against the chosen target.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="mh-rad-space-wolves-6da5-b3bc-7b45-09c5" name="Precision Shots" hidden="false" targetId="mh-rad-space-wolves-4771-b711-0e74-3aee" type="rule" />
        <infoLink id="mh-rad-space-wolves-b7bc-ba3c-fb91-828c" name="Implacable Advance" hidden="false" targetId="mh-rad-space-wolves-5ecb-551d-0f68-3a79" type="rule" />
        <infoLink id="mh-rad-space-wolves-efac-d597-94c8-2160" name="Preferred Enemy" hidden="false" targetId="mh-rad-space-wolves-4dd2-fcb0-de6a-5b70" type="rule">
          <modifiers>
            <modifier type="append" field="name" value=": Marked for Death" />
          </modifiers>
        </infoLink>
        <infoLink id="mh-rad-space-wolves-6a68-ab9d-b08d-21aa" name="Bleed &amp; Harry" hidden="false" targetId="mh-rad-space-wolves-3950-14f9-8267-c9f2" type="rule">
