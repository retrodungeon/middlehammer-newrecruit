    <profile id="2a082ab7-f452-75cc-db90-c06aab31bcc6-821f2" name="Psychic - Jaws of the World Wolf" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Focussed Witchfire, Warp Charge 2, targets a single non-vehicle unit within 18". A model hit by Jaws of the World Wolf must take an Initiative test. Monstrous Creatures automatically pass this test. If the test is passed, nothing happens, but if the test is failed the model is removed from play.</characteristic>
      </characteristics>
    </profile>
    <profile id="e34ffa5f-8d61-8031-d326-6ca292b559fd-821f2" name="Psychic - Living Lightning" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
