        <infoLink name="Infiltrate" id="beca-bb2a-fcac-5441" hidden="false" targetId="db64-5b1f-d306-b354" type="profile" />
        <infoLink name="Move Through Cover" id="b963-19f1-7674-e165" hidden="false" targetId="25f7-501a-6b03-6c3b" type="profile" />
        <infoLink name="Scouts" id="dfcb-3696-32e3-7cee" hidden="false" targetId="e289-1576-b63b-c142" type="profile" />
      </infoLinks>
      <profiles>
        <profile name="Behind Enemy Lines" id="fb23-c7aa-cbcd-5eb9" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a Wolf Scout unit makes use of its ability to outflank, roll a dice when it enters play to see where it may be deployed. On the roll of a 1 the Wolf Scout unit enters play from the short table edge to the owning player's left, on a 2 they enter play from the short table edge to the owning player's right, and on a 3-6 they enter play from any table edge the Space Wolves player wishes. This may even be his opponent's table edge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="One Wolf Scout may take the Mark of the Wulfen" id="5a28-28c6-d049-43f6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="728c-1b12-411e-b9b0" field="selections" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
          </costs>
          <infoLinks>
            <infoLink name="Mark of the Wulfen" id="cbcd-f522-aeb2-c5a0" hidden="false" targetId="fb5b-236f-bf5d-067f" type="profile" />
