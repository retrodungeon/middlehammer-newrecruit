      <profiles>
        <profile name="Bran Redmaw" id="bc71-c116-b3be-4391" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
          <characteristics>
            <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">6</characteristic>
            <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
            <characteristic name="S" typeId="09af-e927-0c3c-9d88">4(5)</characteristic>
            <characteristic name="T" typeId="ff29-f8b2-5b20-b686">4</characteristic>
            <characteristic name="W" typeId="4a81-ac45-a71c-c71e">3</characteristic>
            <characteristic name="I" typeId="8517-a46c-d6df-9c75">5</characteristic>
            <characteristic name="A" typeId="a535-0722-3bc1-4d3c">4</characteristic>
            <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">10</characteristic>
            <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="The Axe Langnvast" id="63ab-d2f8-189d-592b" hidden="false" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Langnvast is a two-handed power weapon which adds +1 to its user's Strength and allows its wielder to re-roll any assault hits which fail to wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Patient Killers" id="32ab-ec5a-e6c9-16b1" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If Bran is leading the army then a single Grey Hunter squad may use the Infiltrate and Behind Enemy Lines special rules.</characteristic>
          </characteristics>
        </profile>
        <profile name="Curse of the Redmaw" id="6491-72bd-2ff0-f25d" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the start of each of Bran's controllers Movement phase expect for the first, before moving units, Roll a D6. On turn 2 Bran will succumb to the Curse of the Wulfen on a 6+, on turn 3 it will be on a 5+,, on turn 4 on a 4+ and any further turns on a 3+. Add +1 to this roll for each Space Wolves unit locked in combat that turn.


Once Bran Succumbs to the Curse he transforms into the Redmaw, replace the model with the Redmaw. The Redmaw enters play with the number of wounds Bran had when the curse came into effect and with only the wargear and Special rules detailed on the Redmaw profile, he completely replaces Bran Redmaw and is not affected by any effects previously applied to Bran by either friendly or enemy models. He remains a HQ choice for all purposes.</characteristic>
          </characteristics>
        </profile>
      </profiles>
