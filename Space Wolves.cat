      <rules />
      <infoLinks />
      <modifiers />
    </rule>
    <rule id="0c2affa2-72e0-1236-2a77-26fbdd3f8a16-821f2" name="Warlord Trait: Saga of the Beastslayer" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
    </rule>
    <rule id="84fff1dd-54a7-d042-f56f-8a3d60b2e320-821f2" name="Warlord Trait: Saga of the Hunter" page="0" hidden="false">
