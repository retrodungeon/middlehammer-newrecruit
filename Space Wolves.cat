  <selectionEntry id="0912-3fbd-f268-8a4b" name="Wulfen Pack" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="6b42-9a45-2001-a488" name="Animal Rage" hidden="false">
          <description>At the beginning of the 13th Company Movement phase, each Wulfen pack must advance a normal move + D6" towards the nearest enemy instead of moving normally. The extra D6" is not affected by difficult terrain.</description>
        </rule>
      </rules>
      <infoLinks>
