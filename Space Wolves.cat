    <selectionEntry id="3394-d9b2-b771-5506-821f2" name="Strike Force Daggerfist" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="6b19-9d19-fe1c-7afb-821f2" name="Wulfenkin" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Add 1 to the Attacks of any Strike Force Daggerfist model whose unit is within 6" of the Formation's unit of Wulfen at the start of the Assault phase. This effect lasts until the end of the phase.</description>
        </rule>
        <rule id="39fd-37ed-cef6-b094-821f2" name="Oath of Protection" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enemy units can only target Strike Force Daggerfist's unit of Wulfen if they are the closest target from this Formation to the attacking unit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f88b-3258-0a31-e733-821f2" hidden="false" targetId="06f450df-e80c-eb11-efe2-3808f6891556-821f2" type="rule">
