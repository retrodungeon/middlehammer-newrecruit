            <infoLink name="Fearless" id="eefd-77c3-d4fe-f20e" hidden="false" targetId="1380-eda3-7a3b-055c" type="profile" />
          </infoLinks>
          <profiles>
            <profile name="The Redmaw" id="23ae-c9d9-2822-79f8" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
              <characteristics>
