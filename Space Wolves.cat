    <selectionEntry id="d408-e002-ff9b-7c2c-821f2" name="&quot;Ice Storm Assault Pack&quot;" page="126" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="9a26-c5cc-dc5f-cd02-821f2" name="Hailstorm Assault" page="126" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Units that disembark from Flyers in this Wing have the Fleet rule on the turn they disembark, as long as the Wing was in an Attack Pattern when the unit disembarked.</description>
        </rule>
        <rule id="7c49-2486-66fd-47c4-821f2" name="Ice Storm" page="126" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If an enemy unit suffers unsaved Wounds from any dispersed helfrost attacks made by two or more models from this Wing, it is frozen until the start of your next turn. A frozen unit cannot voluntarily move in any way and has its Weapon Skill charactersitic reduced to 1.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="cff4-b7ca-72be-fb05-821f2" hidden="false" targetId="eb48-0c21-ebfb-bd70-821f2" type="rule">
