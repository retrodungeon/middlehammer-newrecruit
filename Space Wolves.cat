    <profile id="65628817-28ff-f337-5c81-118a5b0a0865-821f2" name="Chooser of the Slain" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">An army that includes a Chooser (must be smaller than the Rune Priest. Cannot be destroyed) may place it anywhere on the battlefield before the enemy has deployed. Enemy units may not use Infiltrate to deploy within 18" of the Chooser. Rune Priest gains +1BS for any Shooting attack at an enemy that has Line of Sight to the Chooser. Doesn't modify the BS1 of a Snap Shot</characteristic>
      </characteristics>
    </profile>
    <profile id="b9acf151-1b3a-6d61-fc07-074c4ed705f2-821f2" name="Combi-Weapons" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bolter may be fired every turn, secondary weapon may be fired once. (Combi-plasma does have Rapid Fire). Cannot fire both in same turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="a95ace0e-b272-e2f5-5bbf-6a0ceeef9705-821f2" name="Command Vox Relay" page="186" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
