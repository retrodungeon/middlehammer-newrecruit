      </characteristics>
    </profile>
    <profile name="Lone Wolf in Terminator Armour" id="23ff-7e9b-f431-8dea" hidden="false" typeId="0967-823d-dd82-4e47" typeName="Unit">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
