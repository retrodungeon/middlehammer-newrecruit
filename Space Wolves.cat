    <profile id="mh-rad-space-wolves-10b59cf4-3c97-e3e0-2185-853bcde6d112" name="Iron Halo" page="0" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers 4++ Invulnerable Save</characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-2e87b8ca-7cd1-78b9-2116-246015e7935e" name="Armoured Ceramite" publicationId="ca571888--pubN80998" page="88" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A vehicle with this wargear is not subject to the additional D6 armour penetration caused by weapons with the Melta special rule.  </characteristic></characteristics></profile>
    <profile id="mh-rad-space-wolves-4478-5959-bcfd-925d" name="Laser Destroyer Array" publicationId="ca571888--pubN91142" page="15" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
