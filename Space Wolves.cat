        <selectionEntry id="045c-6e43-26f0-2b72" name="Great Company Banner" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4460-b4d3-e105-f93a" type="notInstanceOf" />
