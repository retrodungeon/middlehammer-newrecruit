    <profile id="c68f-44f8-d5eb-96bc-a53d8" name="Holo-fields" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with holo-fields has a 5+ invulnerable save unless it is Immobilised.</characteristic>
      </characteristics>
    </profile>
