          <rules>
            <rule id="c511-e02f-bed5-9a7a-a53d8" name="Silence" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Enemy units within 3" of the Visarch use the lowest Leadership characteristic in their unit, rather than the highest.</description>
