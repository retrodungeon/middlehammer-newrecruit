  <selectionEntry id="e474-6fd1-755b-bc23" name="Wild Rider Chief" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="8c79-aca2-3f0b-f893" name="Chief of the Wild Riders" hidden="false">
          <description>The Chief will never fall back under any circumstances and cannot be pinned. This ability is conferred to any unit led by the Chief.</description>
        </rule>
      </rules>
      <infoLinks>
