      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="80" />
      </costs>
      <infoLinks>
        <infoLink name="Avatar" id="1608-42e0-ae3f-3b75" hidden="false" targetId="500a-7b19-a01d-3d88" type="profile" />
        <infoLink name="Fearless" id="e7de-d68e-802c-deb3" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
        <infoLink name="Independent Character" id="6f31-8a8b-e0d1-8a47" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
        <infoLink name="Monstorous Creature" id="c200-6924-b3b2-f740" hidden="false" targetId="445e-e873-2a3f-776f" type="rule" />
        <infoLink name="Invulnerable Saving Throw" id="ba5d-c58a-f1c5-6b60" hidden="false" targetId="97b3-810d-a09e-872b" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Inspiring" id="d069-fa96-bd87-fbb1" hidden="false">
          <description>Any Eldar unit with a model within 12" of the Avatar become fearless in close combat. Also, if the Avatar is in close combat, all Eldar units with a model within 12" add +1 to their score when determining who won a round of close combat.</description>
        </rule>
        <rule name="Daemon" id="4557-3d8c-7f0f-7f4e" hidden="false">
          <description>An Avatar is affected by weapons or abilities that use special rules against Daemons.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Farseer" id="cc6c-88bb-a192-34d4" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Seer Council" id="3c24-71a2-ddf5-aff3" primary="false" targetId="2169-8d5b-499e-5bc6" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40" />
      </costs>
      <entryLinks>
        <entryLink name="Eldar Armoury" id="41be-ee5d-ad2f-a55f" collective="false" hidden="false" import="true" sortIndex="2" targetId="c347-83e2-7f11-3074" type="selectionEntryGroup" />
        <entryLink name="Farseer Psychic Powers" id="b8d9-faaf-f08e-627d" collective="false" hidden="false" import="true" sortIndex="1" targetId="6f8b-71e8-4378-aba2" type="selectionEntryGroup" />
        <entryLink name="Warlock Bodyguard" id="b79d-6b65-676c-76d4" collapsible="true" collective="false" hidden="false" import="true" sortIndex="3" targetId="8461-d2e6-c311-fe84" type="selectionEntryGroup" />
        <entryLink name="Wave Serpent" id="ad02-cf73-6c98-783e" collapsible="true" collective="false" hidden="false" import="true" sortIndex="4" targetId="d7ab-d578-0ff9-f627" type="selectionEntry">
          <constraints>
            <constraint id="8041-82ea-8c83-5111" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
