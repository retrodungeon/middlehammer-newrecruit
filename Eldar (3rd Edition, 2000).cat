      <selectionEntries>
        <selectionEntry id="891f-5cd2-05a4-1399" name="Avatar of the Bloody-Handed God" hidden="false" collective="false" import="true" type="unit">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8561-c047-f70c-fa30" type="min" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0888-d2a5-fd76-b67b" type="max" />
          </constraints>
          <rules>
            <rule id="24ab-ac1c-e05c-d36c" name="Inspiring" hidden="false">
              <description>Any Eldar unit with a model within 12" of the Avatar become fearless in close combat. Also, if the Avatar is in close combat, all Eldar units with a model within 12" add +1 to their score when determing who won a round of close combat.</description>
            </rule>
            <rule id="3e19-eb8f-024c-0a64" name="Daemon" hidden="false">
              <description>An Avatar is affected by weapons or abilites that use special rules against Daemons.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="9d3e-b887-50db-a304" name="Avatar" hidden="false" targetId="500a-7b19-a01d-3d88" type="profile" />
