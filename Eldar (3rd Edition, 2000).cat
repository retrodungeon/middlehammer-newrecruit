                <condition childId="mh-armylist-1369-4fc1-fe31-48dd-d1e2-e6ed-e01f-ae6f" childName="Ulthwe The Damned (2000)" field="selections" scope="force" shared="true" type="atLeast" value="1" includeChildSelections="true" />
              </conditions>
