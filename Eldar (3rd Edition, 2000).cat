              </constraints>
              <rules>
                <rule id="9c50-9ed7-424c-177a" name="Family Banner" hidden="false">
                  <description>While the Family Banner is still on the table, the Chief and his Kinsmen may re-roll any missed close combat attacks on the same turn that they charged into an assault.</description>
