    <selectionEntryGroup name="Eldar Vehicle Upgrades" id="ad83-1ee9-ea12-cb0b" collapsible="true" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Crystal Targeting Matrix" id="613e-e3a4-b0be-0fc1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="78a4-fd0c-54ca-b61c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" />
          </costs>
          <rules>
            <rule name="Crystal Targeting Matrix" id="6022-e12a-7589-6c95" hidden="false">
              <description>The vehicle may shoot during the movement phase rather than the shooting phase. Moving, shooting, and then completing its move. All the normal restrictions apply to the number of weapons that can be fired due to the total distance moved (both before and after shooting).</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Holo-field" id="f6cd-6dfe-a20d-e599" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9fd2-b6a5-ad24-557f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" />
          </costs>
          <modifiers>
            <modifier field="9fd2-b6a5-ad24-557f" type="set" value="0">
              <conditions>
                <condition childId="d7ab-d578-0ff9-f627" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Holo-field" id="f987-2a20-f54e-5a6e" hidden="false">
              <description>When rolling on the Damage table against this vehicle, the enemy must roll two dice and apply the lowest result.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Scythes" id="dbb1-3d00-fcfb-e293" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b3e0-5228-6b87-7746" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
          <rules>
            <rule name="Scythes" id="a08b-1217-d6cb-fda6" hidden="false">
              <description>Any enemy model that rolls a 1 to hit the vehicle in close combat suffers a Strength 5 hit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Spirit Stone" id="9735-f0ad-2434-2ba6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bcda-2e22-4042-df00" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
          <rules>
            <rule name="Spirit Stone" id="69c7-f5a5-853a-87b9" hidden="false">
              <description>If the vehicle suffers a 'crew shaken' result, roll a D6. On a 4+ the vehicle is instead un affected. If the vehicle suffers a 'crew stunned' result, roll a D6. On a 4 or 5 treat the result as a 'crew shaken' result instead, and on a 6 the result is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Star Engines" id="4777-1d41-f54b-d370" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3f3c-0890-655f-ffbc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
          </costs>
          <rules>
            <rule name="Star Engines" id="8a45-e3f3-f12a-c1cd" hidden="false">
              <description>Instead of firing any weapons the vehicle may move 2D6" in a straight line during the shooting phase. A vehicle may not use its star engines in the same turn that it embarks or disembarks units.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Vectored Engines" id="dfc1-ebc7-51ee-348d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9262-09e2-ec6b-146c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
          <rules>
            <rule name="Vectored Engines" id="47f6-a168-6c97-80df" hidden="false">
              <description>The vehicle may re-roll any failed Difficult Terrain tests.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
