        <selectionEntry name="Augment" id="97eb-5445-d9fe-ccf5" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="2585-cdc1-80b7-c393" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Augment" id="f7d7-9c32-8d4a-db4d" hidden="false">
              <description>Use when a Farseer in the Seer Council successfully uses a psychic power. The warlock must pass a Psychic test, and if successful the range of the Farseer's power is doubled. Each Farseer power can only be augmented once per turn, and the Warlock must be in the Seer Council to use Augment. If any Warlock fails to augment a power, a second Warlock may attempt to augment the same power.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Eldar Armoury" id="c347-83e2-7f11-3074" collapsible="true" collective="false" hidden="false" import="true">
