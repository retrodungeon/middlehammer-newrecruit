        <rule name="Reckless" id="b99c-ac2a-8169-2fb9" hidden="false">
          <description>Nuadhu ignores all 'crew stunned' and 'crew shaken' results on the Damage tables.</description>
        </rule>
        <rule name="Hit and Run" id="98d8-35f1-e2bb-618d" hidden="false">
          <description>Naudhu can make hit=and-run attacks just like an Eldar jetbike. This means he can always move 6" in the assault phase, as long as he did not move more than 12" in the movement phase.</description>
        </rule>
        <rule name="Chief of the Wild Riders" id="a5ce-5c76-f901-8b0a" hidden="false">
          <description>Any unit lead by Nuagha will never fall back and cannot be pinned.</description>
        </rule>
      </rules>
