        <modifier field="error" type="add" value="A Warlock cannot be taken in a Wraithguard unit if Iyanna is already attached.">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="89c0-c22f-a947-63e0" childName="Iyanna Arienal, Spiritseer of Iyandan" field="selections" scope="parent" shared="true" type="equalTo" value="1" />
                <condition childId="ec2f-166f-1795-507b" childName="Warlock" field="selections" scope="parent" shared="true" type="greaterThan" value="0" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Ghostvoice" id="0387-267f-8333-f9a6" hidden="false">
          <description>Any Wraithguard unit with a model within 6" of a Spiritseer does not have to test for Wraithsight, just as if a Warlock was accompanying the unit.</description>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5331-6f75-4f69-e3b1" childName="Spiritseer" field="selections" scope="self" shared="true" type="equalTo" value="0" />
              </conditions>
            </modifier>
          </modifiers>
        </rule>
      </rules>
