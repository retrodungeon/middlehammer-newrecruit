    </profile>
    <profile name="Enhance" id="4d75-e148-e135-7ceb" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">All models in the Warlock's squad, including the Warlock, add +1 WS and +1 I. Additional Enhance have no effect.</characteristic>
      </characteristics>
    </profile>
    <profile name="Executioner" id="ca79-8127-4045-b637" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">User +2</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">May not be used to gain +1 A with a pistol or additional CCW. Ignores armour saves.</characteristic>
      </characteristics>
    </profile>
    <profile name="Powerblades" id="183d-c848-8cc2-2f0f" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Models equipped with powerblades gets +1 Attack. This can be in addition to the +1 Attack for being armoed with an additional close combat weapon or pistol for a total of +2 attacks. Ignores all armour saves.</characteristic>
      </characteristics>
    </profile>
