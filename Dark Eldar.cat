      <profiles />
      <rules>
        <rule id="5d9e-608c-aacc-bdd0-32f57" name="Fighter Ace" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>D6 Result
1-2: +1BS
3-4: can pivot up to 180° before moving in the Movement phase
5-6: All friendly units within 12" that are from the same faction have Hatred</description>
