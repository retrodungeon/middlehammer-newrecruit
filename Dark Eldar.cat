          <modifiers />
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Sentient Blade</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="1113-94c9-c60c-4f6c-32f57" name="Sentient Blade" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When fighting with the Djin Blade, the wielder gains +2 bonus Attacks. Immediately after resolving all of the attacks made with this weapon, roll a single D6 - on a result of 1, the model using this weapon immediately suffers a single Wound, with no saves of any kind allowed. </description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0531-06d8-d779-1f80-maxSelections-32f57" type="max" />
        <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0531-06d8-d779-1f80-maxInForce-32f57" type="max" />
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0531-06d8-d779-1f80-maxInRoster-32f57" type="max" />
      </constraints>
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks />
      <costs>
        <cost name="Points" value="30.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="f0ea-20f2-e27f-6f5e-32f57" name="The Parasite's Kiss" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="48b0-eb48-46c9-b1b8-32f57" name="The Parasite's Kiss" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12"</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">1</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistol, Master-crafted, Poisoned (2+), Soul-leech</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9f12-9d99-e596-ec5d-32f57" name="Soul-leech" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each time the bearer inflicts an unsaved Wound with the Parasite's Kiss it immediately gains one Wound lost previously in the battle. </description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints>
