                          <characteristics>
                            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The Klaivex may nominate an enemy Independent Character at the beginning of each round of combat. The Klaivex has Preferred Enemy when attacking that model.</characteristic>
