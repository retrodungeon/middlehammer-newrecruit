    <profile name="Haywire Blaster" id="2eab-4372-f3f9-feef" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
