    <selectionEntry id="be6eeaa7-1b22-3afe-b5e6-8fe2914008ed-32f57" name="Lelith Hesperax" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="3893e84b-3ad3-9d83-4dc7-967ab49a4864-32f57" name="Quicksilver Dodge" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Lelith Hesperax has a 4+ invulnerable save. This is increaded to a 3+ invulnerable save against all wounds inflicted in the Fight sub-phase. </description>
        </rule>
        <rule id="cf478bd9-a182-df7e-6a5a-f9eed10f1bcb-32f57" name="The Penetrating Blade" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Armour saves cannot be taken against Wounds inflicted by Lelith Hesperax's Melee weapons. </description>
        </rule>
        <rule id="99a38eb5-c532-be1e-366f-b0d308854209-32f57" name="A League Apart" page="0" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Lelith Hesperax re-rolls all failed To Hit and To Wound rolls whilst fighting a challenge.</description>
        </rule>
      </rules>
      <infoLinks>
