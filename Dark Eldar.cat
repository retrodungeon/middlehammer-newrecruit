    <profile id="4a026ee8-4697-3535-950b-172d2440a07e-1cb1e" name="Shock Prow" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with a shock prow can Tank Shock and Ram even if it is not a tank. In addition, when the vehicle executes a Ram, it is treated as having a front Armour Value of 14 when working out the effect of the Ram upon both the vehicle and it's target. </characteristic>
      </characteristics>
    </profile>
