        <infoLink name="Urien Rakarth" id="d3a8-1354-0e4b-c1f4" hidden="false" targetId="307d-d44c-9a4d-551c" type="profile" />
        <infoLink name="Destructor" id="942a-ba69-ad44-cff7" hidden="false" targetId="471b-0158-fba8-ed84" type="profile" />
        <infoLink name="Stinger" id="7e34-8760-84d8-fe85" hidden="false" targetId="cbf4-a511-e9f6-e8e5" type="profile" />
        <infoLink name="Poisoned Blade" id="88c4-bf39-9e1a-6f56" hidden="false" targetId="c04e-5394-eec7-116c" type="profile" />
      </infoLinks>
      <modifiers>
        <modifier field="error" type="add" value="Urien can only be included in a force that also has an Archon">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="28bb-2ff2-0f7f-da5b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="0" />
                <condition childId="7a61-a52d-11c2-0a92" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="0" />
                <condition childId="e8e8-6964-113f-e463" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="equalTo" value="0" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Crucible of Malediction" id="7310-3afa-1d43-2c4d" hidden="false">
          <description>Once per battle.
A character carrying a crucible may use it in the Shooting Phase instead of moving or shooting. When the crucible is used the enarest enemy psyker must pass a Leadership test. Subtract 1 from the psyker's Ld if he is within 12" of the model with the crucible, and add +1 to his Ld if he is over 24" away.
If the test if ailed the psyker is removed from play with no saves of any kind allowed. If the nearest psyker passes his Leadership test then the next nearest must pass, and so on until either all psykers have passed, or one has failed.</description>
        </rule>
        <rule name="Master Haemonculus" id="a1b9-7bd9-c272-4226" hidden="false">
          <description>Urien is a master of his craft, and the weapons he uses are amongst the finest examples of their kind. To reflect their superior quality Urien's weapons automatically wound if they hit - no 'to wound' roll is required. Armor Saves are taken normally.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Uber Grotesques" id="dac9-2144-2969-6831" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="1795-c4d9-4052-6a8c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="5" />
            <constraint id="065f-b3a3-34db-c407" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="0" />
          </constraints>
          <costs>
