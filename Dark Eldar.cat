    <selectionEntry id="42fe-1008-fd38-e8f9-32f57" name="Battle Formation: Dark Olympaid" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="cea0-9aa8-810b-70a0-32f57" name="Frenzied Beasts" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Beastmasters, Donorian Clawed Fiends, Khymerae and Razorwing Flocks in a Dark Olympiad all have combat drugs in addition to their other wargear.</description>
        </rule>
        <rule id="5851-daeb-92f7-afe7-32f57" name="The Grand Finale" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>An army that includes a Dark Olympiad rolls an extra dice on the chart when determining which combat drugs are available, and applies two of the results generated instead of the usual one. Note that an army that includes a both a Dark Olympiad and Duke Sliscus could roll three dice and choose two results.</description>
        </rule>
        <rule id="579e-6c99-8ed8-8a7a-32f57" name="Orgy of Scarlet" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Once the game has begun, whenever a unit from the Dark Olympiad gains a pain token for destroying an enemy unit, choose a Dark Eldar unit within 24" and within line of sight; that unit also gains a pain token.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="573a-a78c-32a5-9b9f-32f57" name="Leader" hidden="false" collective="false" defaultSelectionEntryId="0fa0-fa50-2962-c1c6-32f57">
