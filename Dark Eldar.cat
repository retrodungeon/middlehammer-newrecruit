    <selectionEntry id="1ee76c8f-1feb-def0-d489-e669e66726f4-1cb1e" name="Formation: Scarlet Epicureans" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="c832ffa2-28ae-e282-f067-29988d1b0fc4-1cb1e" name="Macabre Collectors" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All units of Wracks from this Formation that are within 12" of this Formation's Haemonculus have the Precision Strikes special rule.</description>
        </rule>
        <rule id="b7dab4a4-4dd0-3ee7-067b-651bb30ea98e-1cb1e" name="Master of Epicureans" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The units of Wracks in this Formation treat the current turn as being one higher than it actually is when determining what special rules they benefit from as the result of the Power from Pain special rule. This is cumulative with the Master of Pain or Father of Pain special rules.</description>
        </rule>
      </rules>
