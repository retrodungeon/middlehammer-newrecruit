    <profile name="Talos Sting" id="7167-7aae-8511-5690" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24"</characteristic>
