          </costs>
          <infoLinks>
            <infoLink name="Uber Grotesque" id="8815-089d-0e7c-f9ae" hidden="false" targetId="da72-b1ae-3c7e-2ff3" type="profile" />
            <infoLink name="Feel No Pain" id="6f19-aa11-9aa0-13fc" hidden="false" targetId="aaa1-7514-608a-4fa3" type="rule" />
