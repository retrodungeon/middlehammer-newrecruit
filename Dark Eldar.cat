        <profile id="7986-3e69-5134-09ea-32f57" name="Warlord Trait: Favoured of Ynnead" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
