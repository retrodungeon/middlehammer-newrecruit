                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+2</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Silence, Two-Handed</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="c7bc-7b94-da58-cbef-32f57" name="Silence" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Enemy units within 3" of the Visarch use the lowest Leadership characteristic in their unit, rather than the highest.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="cc9b-7a6d-dcca-960a-32f57" name="" hidden="false" targetId="b11c-0ef4-af6b-d96f" type="rule">
