        <profile name="Bladevanes" id="f27e-4e8b-1b11-b1c7" hidden="false" typeId="456a-26d9-cb27-bd5c" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">When moving with Turbo Boosters, a Reaver unit may slash its foes with its bladevanes. Mark the start and end points of the unit's move, and trace an imaginary line between the two points. Once the move is complete, the unit inflicts D3 S4 AP- hits per Reaver on one unengaged, non-vehicle unit that lies under the line, resolved immediately. Cover saves may be taken as normal.</characteristic>
          </characteristics>
        </profile>
      </profiles>
