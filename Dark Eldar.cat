          <rules>
            <rule id="11ba8b96-ef14-7ab6-e517-d00859ffe02b-32f57" name="Kill Shock" page="104" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>By concentrating the beam of energy,  the storm vortex's power is greatly enhanced so that when it strikes a vehicle, it takes D3 Haywire rolls. Against targets with Toughness, wounds inflict Instant Death on a To Wound 5+ roll (regardless of target's Toughness).</description>
            </rule>
          </rules>
