        <infoLink name="Fearless" id="a20a-ff2c-8537-b12c" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Skimmer" id="3fb1-9cd3-e116-19c4" hidden="false">
          <description>The Talos can move over difficult terrain without penalty. However if it starts or finishes its move in difficult terrain it will suffer a wound with no save on a D6 roll of 1.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Asdrubael Vect" id="e8e8-6964-113f-e463" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
