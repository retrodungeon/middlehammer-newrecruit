    <profile name="Implosion Missile" id="3c0d-173d-d755-9559" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">48"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">*</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Blast, One Shot</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Models hit by an implosion missile must take a characteristic test based on their Wounds value (i.e the one on their profile, not their current Wounds). If they fail the test, they implode spectactularly and suffer instant death regardless of Toughness. Cover saves and Invulnerable saves may be taken as normal. Vehicles are unaffected by implosion missiles.</characteristic>
      </characteristics>
    </profile>
