    <selectionEntry id="23d0-041d-6c56-5e1e-32f57" name="Battle Formation: Carnival of Pain" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="9dc1-8625-a4eb-fe9a-32f57" name="Pain Amplifiers" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All non-vehicle enemy units within 12" of a Talos Pain Engine or a Cronos Parasite Engine from the Carnival of Pain have their Toughness characteristic reduced by one.
In addition, friendly units chosen from Codex: Dark Eldar that are within 12" of at least one model in this formation and have one or more pain tokens have their Feel No Pain special rule improved by one - usually to Feel No Pain (4+). A Dark Eldar unit with four or more pain tokens instead has its Feel No Pain special rule improved by two - usually to Feel No Pain (3+).</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="f27e-1068-7b4c-744e-32f57" name="Leader" hidden="false" collective="false" defaultSelectionEntryId="5d7b-a24d-73ac-a043-32f57">
