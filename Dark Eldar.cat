    <selectionEntry id="26c782d6-c475-5095-1281-52e377d351b5-1cb1e" name="Formation: Carnival of Pain" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="da572b22-c90c-d54f-3bfa-833c469ea5da-1cb1e" name="Lord of Pain" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>As long as Urien Rakarth (or the Haemonculus from the Grotesquerie Formation) is alive, his Father/Master of Pain special rule affects all non-vehicle units in this Formation.</description>
        </rule>
        <rule id="09fd4bc8-299e-de6c-7fa7-80f5bbbc08a2-1cb1e" name="The Torturer's Art" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All non-vehicle models from the Carnival of Pain re-roll failed To Wound rolls of a 1 in close combat.</description>
        </rule>
      </rules>
