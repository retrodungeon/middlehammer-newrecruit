            </modifier>
          </modifiers>
          <rules>
            <rule name="Sarissa" id="03a4-83b3-5bbd-61ce" hidden="false">
              <description>In any Assault phase in which the model charges, her close combat hits to wound may be re-rolled.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
