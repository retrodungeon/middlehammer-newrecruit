        <selectionEntry id="0932-1743-bbef-144b" name="Holy Censer" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3c96-248b-affd-e504" type="notInstanceOf" />
                    <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="64ce-a67d-45b0-215d" type="notInstanceOf" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2e10-4008-8f67-4940" type="max" />
          </constraints>
          <rules>
            <rule id="3016-9970-2bc8-0760" name="Holy Censer" hidden="false">
              <description>A unit with a character carrying the Censer only takes morale checks from shooting if it loses 50% or more of its number in one turn, rather than 25%.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
          </costs>
        </selectionEntry>
        <selectionEntry id="bccf-992f-38c7-a5d2" name="Litanies of Faith" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a9ea-0268-3b35-6ea1" type="max" />
          </constraints>
          <rules>
            <rule id="0528-5378-b926-c6b2" name="Litanies of Faith" hidden="false">
              <description>Once per game the character equipped with the Litanies of Faith can trigger an Act of Faith without testing for success or spending any Faith Points.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" />
          </costs>
        </selectionEntry>
        <selectionEntry id="2ac4-8d52-d954-c3c9" name="Master-crafted Weapon" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6b51-52a8-cf35-b692" type="max" />
          </constraints>
