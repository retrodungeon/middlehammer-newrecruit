          <selectionEntries />
          <selectionEntryGroups />
          <entryLinks />
          <costs>
            <cost name="Points" value="0.0" typeId="6f18-a8fc-2c5b-9517" />
          </costs>
        </selectionEntry>
        <selectionEntry id="71e8-2646-ed7b-be12-abc68" name="Acheron Pattern Flame Cannon" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="87ff-0d01-e83a-6355-abc68" name="Acheron Pattern Flame Cannon" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
