        <infoLink name="Land Raider" id="c0ac-3102-5e0a-2d97" hidden="false" targetId="1c32-32ba-aedd-b38c" type="profile" />
        <infoLink name="Twin-Linked" id="ac07-a951-d216-a17f" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
