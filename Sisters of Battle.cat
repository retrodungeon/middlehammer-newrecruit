        <selectionEntry id="98bb-4aec-e4d2-0554" name="Pintle-mounted Storm Bolter" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a95e-08d5-f2b4-a3d9" type="max" />
          </constraints>
