          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3ccb-567e-04dd-e7ff" type="max" />
          </constraints>
          <rules>
            <rule id="b70d-ec7b-9472-f96b" name="Simulacrum Imperialis" hidden="false">
              <description>A unit containing a model with a Simulacrum Imperialis may roll an extra D6 when advancing after an assault and discard the lowest dice.</description>
