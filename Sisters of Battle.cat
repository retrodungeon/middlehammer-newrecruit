            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3c96-248b-affd-e504" type="notInstanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4287-fd78-a018-a535" type="max" />
          </constraints>
          <rules>
            <rule id="3076-2899-b3cb-8c2b" name="Praesidium Provectiva" hidden="false">
              <description>A model equipped with a Praesidium Protectiva may take a 4+ invulnerable save in an assault instead of its normal armour save. The save my only be used against one opponent per turn (the defender chooses which one), and cannot be combined with a Rosarius save.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
          </costs>
        </selectionEntry>
