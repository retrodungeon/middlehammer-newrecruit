    <selectionEntry id="a063-c048-be5d-bf3b" name="Redemptionists" hidden="false" collective="false" import="true" type="unit">
      <selectionEntries>
        <selectionEntry id="cdf4-9165-5823-aced" name="Exterminators" hidden="false" collective="false" import="true" type="upgrade" sortIndex="4">
          <modifiers>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="3">
              <repeats>
                <repeat field="selections" scope="a063-c048-be5d-bf3b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false" />
              </repeats>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fd9a-3731-0e1d-52a2" type="max" />
          </constraints>
          <profiles>
            <profile id="9f88-b707-bbb7-bcf3" name="Exterminators" hidden="false" typeId="7279-038a-b87a-ed0c" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="a08a-36f8-2fd3-b843">Exterminators are used once per battle in the first round of an assault. Exterminator attacks are resolved at Initiative 8 and are in addition to the models' normal attacks. Roll a D6 for every enemy model in a unit fighting against the Redemptionists. The score required to hit the enemy depends upon the number of models in the Redemptionists unit. Models are hit by a S4 AP5 weapon.
* 1 to 5 Models: 6+ to hit
* 6 to 10 Models: 5+ to hit
* 11 to 15 Models: 4+ to hit
* 16 to 20 Models: 3+ to hit</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="740e-7670-823d-acd0" name="Upgrade One Model to Redemptor Priest" hidden="false" collective="false" import="true" type="upgrade" sortIndex="3">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5f88-2c85-4c8c-2309" type="max" />
          </constraints>
          <rules>
            <rule id="efc1-f9c8-c3a4-9a74" name="Sacred Rites" hidden="false">
              <description>A Redemptor Priest adds +1 Faith point.</description>
            </rule>
            <rule id="8b80-eea9-aea8-3809" name="Fearless" hidden="false">
              <description>While the Redemptor Priest is alive the squad they lead never has to fall back and is assumed to automatically pass any MOrale checks it is required to make (even against attacks that allow no test to be taken). Note that the unit can be pinned as normal.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="ed3d-2fed-8c86-ab63" name="Redemptor Priest" hidden="false" targetId="7a2e-db91-289e-f505" type="profile" />
          </infoLinks>
          <entryLinks>
            <entryLink id="7e27-4ee8-8368-addf" name="Ministorum Armoury" hidden="false" collective="false" import="true" targetId="e775-ee49-af8b-227b" type="selectionEntryGroup" />
          </entryLinks>
          <costs>
