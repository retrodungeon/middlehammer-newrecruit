          <modifiers>
            <modifier field="name" type="set" value="2x Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
        <infoLink name="Storm Bolter" id="97d4-7a50-2cb4-26c5" hidden="false" targetId="4c6c-9de1-00a8-8016" type="profile">
