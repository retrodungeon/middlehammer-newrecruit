    <selectionEntryGroup id="5f23-0a3c-4088-e032" name="Wargear" hidden="false" collective="false" import="true" collapsible="true">
      <selectionEntries>
        <selectionEntry id="1e06-5e36-3420-398f" name="Bionics" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="199e-25a1-20a2-d42e" type="max" />
          </constraints>
          <rules>
            <rule id="eec9-9f33-b22e-7716" name="Bionics" hidden="false">
              <description>If a model with bionics is killed, instead of removing it, place it on its side. Roll a D6 at the start of the next turn; on a roll of a 6 the model stands back up with 1 wound.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
        </selectionEntry>
        <selectionEntry id="1354-7327-ac13-aef8" name="Book of St Lucius" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a72e-ec01-371e-fa0f" type="max" />
          </constraints>
          <rules>
            <rule id="ffff-7861-f807-8516" name="Book of St Lucius" hidden="false">
              <description>Any units which have a model within 6" of the bearer of the Book of St. Lucius may user the bear's leadership for any Morale or Pinning tests they are required to take.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
        </selectionEntry>
