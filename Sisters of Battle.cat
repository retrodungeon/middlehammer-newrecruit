    <selectionEntry name="Seraphim Squad" id="dd8b-8f26-9f10-7ab1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Adepta Sororitas" id="92c7-a2fb-c9a3-cbbb" hidden="false" primary="false" targetId="bd50-bb90-bb09-3002" />
        <categoryLink name="Fast Attack" id="48a6-f6b0-e30c-a070" hidden="false" primary="true" targetId="74fe-37c3-fbbf-849e" />
