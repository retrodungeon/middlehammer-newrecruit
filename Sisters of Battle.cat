            <infoLink id="e59e-d179-11d3-fca4" name="Melta Bombs" hidden="false" targetId="87d0-8c40-7bcb-8cbb" type="profile" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
        <selectionEntry id="d639-96ca-be4e-6f7b" name="Purity Seals" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9bbf-9069-6aba-9931" type="max" />
          </constraints>
          <rules>
            <rule id="7988-ad0f-fce1-b22b" name="Purity Seals" hidden="false">
              <description>If a model wearing purity seals falls back, roll one extra D6 for fall back distance, and then discards one dice of your choice.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
        <selectionEntry id="da87-c0f5-12c7-e16f" name="Simulacrum Imperialis" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
