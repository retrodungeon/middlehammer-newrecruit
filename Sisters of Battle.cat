          </costs>
        </selectionEntry>
        <selectionEntry id="8a24-deb3-99e0-2df3" name="Sacred Banner of the Order Militant" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b3bb-c4aa-64a1-e24f" type="notInstanceOf" />
              </conditions>
            </modifier>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3601-f467-dd69-f9b1" type="notInstanceOf" />
              </conditions>
            </modifier>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="78f5-6d13-2873-6ee9" type="instanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1273-e50d-b746-3712" type="instanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="73a2-40cc-c7c6-1f3b" type="instanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="740e-7670-823d-acd0" type="instanceOf" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="set" field="df15-a74c-f208-93a4" value="0">
              <conditions>
                <condition field="6f18-a8fc-2c5b-9517" scope="force" value="2000" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="any" type="lessThan" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="df15-a74c-f208-93a4" type="max" />
          </constraints>
          <rules>
            <rule id="8efd-321e-938c-08b3" name="Sacred Banner of the Order Militant" hidden="false">
              <description>A unit with a model within 12" of the Sacred Banner of the Order Militant may roll 3 dice for any Morale or Pinning test and discard the highest dice. However, if the model bearing the banner is slain in close combat, then the enemy model that slew her captures the banner and the enemy gains this bonus instead. It is possible for the banner to be recovered by the Sisters of Battle, which causes the new model to hold the banner.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="60" />
          </costs>
        </selectionEntry>
        <selectionEntry id="5925-0429-7d37-fac9" name="Sacred Standard" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3601-f467-dd69-f9b1" type="notInstanceOf" />
              </conditions>
            </modifier>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="78f5-6d13-2873-6ee9" type="instanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1273-e50d-b746-3712" type="instanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="73a2-40cc-c7c6-1f3b" type="instanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="740e-7670-823d-acd0" type="instanceOf" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="26f4-2e21-8db7-288e" type="max" />
          </constraints>
          <rules>
            <rule id="bdd2-0adb-b5ab-bf5a" name="Sacred Standard" hidden="false">
              <description>Any Imperial Units within 6" of the Sacred Standard adds +1 to its combat resolution score. However, if the model bearing the banner is slain in close combat, then the enemy model that slew her captures the banner and the enemy gains this bonus instead. It is possible for the banner to be recovered by the Sisters of Battle, which causes the new model to hold the banner.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
