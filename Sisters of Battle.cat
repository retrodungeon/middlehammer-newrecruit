      </entryLinks>
      <infoLinks>
        <infoLink name="Rhino" id="8e1f-f4fe-de86-c84f" hidden="false" targetId="d47a-fbaf-2b6c-eada" type="profile" />
        <infoLink name="Storm Bolter" id="32d1-daa5-726f-25a9" hidden="false" targetId="4c6c-9de1-00a8-8016" type="profile" />
      </infoLinks>
      <rules>
        <rule name="Reliability" id="d3c3-0b6c-693f-6d3f" hidden="false">
          <description>If a Rhino is immobilised and spends a turn without firing any weapons its drive may be able to effect a temporary repair that turn. On a D6 roll of 6 the vehicle will be free to move in its next Movement phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Witch Hunter Land Raider" id="fbb0-c9e3-f72d-bf33" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Troops" id="5488-f460-a08e-0863" hidden="false" primary="true" targetId="default-category" />
