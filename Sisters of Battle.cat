        </selectionEntry>
        <selectionEntry name="Auspex" id="8a15-8a5e-778b-1758" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0758-cf67-c5c3-2ba9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="2" />
          </costs>
          <rules>
            <rule name="Auspex" id="17ae-17da-09fe-42f5" hidden="false">
              <description>If enemy infiltrators set up within 4D6" of a model with a auspex, then that model and the unit they are attached to is allowed to take a "free" shot at them. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Sarissa" id="ac64-4b1f-3ffe-a12f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1e1e-4f5a-6097-20e3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
