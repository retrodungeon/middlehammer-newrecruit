    <selectionEntry id="7e37-251b-7349-60b3-abc68" name="Formation - Ecclesiarchy Battle Conclave" page="0" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="d389-6501-120f-445b-abc68" name="Formation - Ecclesiarchy Battle Conclave" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All models in the Formation form a single unit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="68ed-e4b1-c5f5-0707-abc68" name="New InfoLink" hidden="false" targetId="102846c2-5cb2-a2bc-5273-7fb66aceaca7-abc68" type="rule">
