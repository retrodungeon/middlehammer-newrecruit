    <selectionEntry id="6eda-f5c2-38ab-492a-abc68" name="FW - Cerastus Knight-Acheron" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="05a1-9838-4cec-dc96-abc68" name="Cerastus Knight-Acheron" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413">
          <profiles />
