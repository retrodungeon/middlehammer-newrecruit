    <selectionEntry name="Cyclops (IA)" id="c4bd-73dd-7301-aaf6" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" />
