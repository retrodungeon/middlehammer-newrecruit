    <selectionEntry id="87ab-8b2c-4923-a708" name="Seraphim Squad" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="2b33-f0d6-cf96-000b" name="Sacred Rites" hidden="false">
          <description>Each Saraphim squad adds +1 Faith Points.</description>
        </rule>
        <rule id="2f85-f389-30e1-fac8" name="Hit &amp; Run" hidden="false">
          <description>Seraphim may choose to leave close combat. Declare this at the end of an Assault phase after all morale checks have been taken. The Seraphim then fall back 3D6 in any direction and regroup at the end of the move. Enemy models may only consolidate.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4b5d-2b7a-ddad-34c1" name="Jump Packs" hidden="false" targetId="2563-092a-a5bc-992f" type="rule" />
