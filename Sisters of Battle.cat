          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
          </costs>
        </selectionEntry>
        <selectionEntry id="3d74-e7cb-fbd6-4fff" name="Medicus Ministorum" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1db3-e2fb-0044-4358" type="notInstanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="eb74-3941-fd11-b29b" type="max" />
          </constraints>
          <rules>
            <rule id="b0d4-0426-fe31-c89b" name="Medicus Ministorum" hidden="false">
              <description>A model with the Medicus Ministorum allows the squad to ignore its first failed armour save per turn. This cannot negate hits from weapons that inflict instant death. It cannot be used if the Sister Hospitaller is in base contact with the enemy. Note this cannot be used to save a model if it did not take an armour save.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
          </costs>
        </selectionEntry>
        <selectionEntry id="79c3-5acd-5640-0de2" name="Melta Bombs" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bd7c-89c8-0903-769d" type="max" />
          </constraints>
