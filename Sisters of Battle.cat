      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May drop a single flare per turn, dropped as bombs and scattered.  Leave the marker in place until the end of the turn.  Any unit targeting an enemy unit within 12" of the Flare gains the Night Vision rule for that shootingi phase.  Does not apply to Split Fire attacks on other units.  </characteristic>
      </characteristics>
    </profile>
