      <profiles />
      <rules />
      <infoLinks />
      <modifiers>
        <modifier type="increment" field="0a31-2253-0968-e491-8730e" value="1">
          <repeats>
            <repeat field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5ee8-78a4-e8ec-2a83-8730e" repeats="1" roundUp="false" />
