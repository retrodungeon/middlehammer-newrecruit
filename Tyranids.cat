    <selectionEntry id="6d2b-3117-1ec5-ed93-8730e" name="Harridan" page="0" hidden="false" collective="false" type="model">
      <profiles />
      <rules>
        <rule id="c56f-adf0-022c-1e7c-8730e" name="Gargoyle Brood" page="162" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>May act as an Open-topped transport and carry up to 20 Gargoyles of a single unit. If he is slain, the Gargoyles each pass an Initiative test or are removed as casualties. </description>
        </rule>
      </rules>
