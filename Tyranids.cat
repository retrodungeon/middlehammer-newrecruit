    <selectionEntry id="8957-7e4a-9bcb-6d1c-8730e" name="Pyrovore Brood" page="51" hidden="false" collective="false" type="unit">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries>
        <selectionEntry id="1066-1396-2446-027a-8730e" name="Pyrovore" page="0" hidden="false" collective="false" type="model">
          <profiles />
          <rules>
            <rule id="2506-937d-e78a-1b57-8730e" name="Volatile" page="51" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>If a Pyrovore is slain by a Wound that inflicted Instant Death, every unit suffers a
Strength 3 AP- hit for each model (excluding Pyrovores) within D6" of the slain Pyrovore
(resolve damage before removing the Pyrovore as a casualty).</description>
