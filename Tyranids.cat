            <constraint type="max" value="3" field="selections" scope="parent" shared="true" id="ee6f-620d-9dc6-1cbd" />
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <infoLinks>
        <infoLink name="Lash Whip" id="fd18-ffb8-b52a-a143" hidden="false" type="profile" targetId="03cb-0385-2167-e4be" />
        <infoLink name="Instinctive Behaviour - Feed" id="fd4b-4d0e-f9d8-23f5" hidden="false" type="profile" targetId="033b-00cf-e0e1-c66c" />
      </infoLinks>
      <profiles>
        <profile name="Spore Cloud" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="04f4-9d79-d429-4c8d">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The Venomthrope and any friendly units within 6" of the unit, can claim a 5+ cover save against any shooting attacks. In addition, these units count as being armed with defensive grenades and any non-vehicle enemy model that assaults one of these units must take a dangerous terrain test to represent the toxic effect of the spore cloud. Should the venomthrope be killed, these bonuses are immediately lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Toxic Touch" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="1d99-652c-553a-bf44">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">A Venomthrope's close combat attacks are Poisoned (2+)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
        <entryLink import="true" name="Mycetic Spore" hidden="false" id="240d-af9c-6ec1-1feb" type="selectionEntry" targetId="c059-7987-8ef4-3a9c">
