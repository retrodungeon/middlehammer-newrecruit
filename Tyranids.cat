      <profiles>
        <profile name="Alpha Warrior" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="5941-99b4-20b2-3b39">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a Tyranid Prime joins a unit of Tyranid Warriors then the entire unit uses the Tyranid Prime's Weapon Skill and Ballistic Skill. Thiese benefits are immediately lost if the Tyranid Prime is slain or leaves the unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
