    <profile name="Acid Spray" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="22d1-385f-56f0-8466">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">Template</characteristic>
