        <infoLink name="Scything Talons" id="9d45-0cbf-5d42-3ebe" hidden="false" type="profile" targetId="4142-8bec-e73c-f7b7" />
        <infoLink name="Instinctive Behaviour - Feed" id="b762-bf2e-248b-4667" hidden="false" type="profile" targetId="033b-00cf-e0e1-c66c" />
