    <selectionEntry type="unit" import="true" name="The Doom of Malan'tai" hidden="false" id="be4b-26de-f016-d121">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="90" />
      </costs>
      <infoLinks>
        <infoLink name="The Doom of Malan'tai" id="ff37-a286-4083-a3b2" hidden="false" type="profile" targetId="463b-78ff-04f9-d748" />
        <infoLink name="Claws and Teeth" id="3514-889d-3923-b73f" hidden="false" type="profile" targetId="7c9d-9e0a-cc00-defb" />
        <infoLink name="Instinctive Behaviour - Feed" id="b179-d02c-19ae-e508" hidden="false" type="profile" targetId="033b-00cf-e0e1-c66c" />
