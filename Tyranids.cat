            <modifier field="name" type="set" value="Twin-Linked Bio-Cannon" />
          </modifiers>
        </profile>
      </profiles>
      <rules>
        <rule name="Mass Points" id="05e6-6aee-e8e5-83ce" hidden="false">
          <description>The Harridan has 3 mass points</description>
        </rule>
        <rule name="Scything Claws" id="197c-96ac-3357-4c9a" hidden="false">
          <description>Instead of firing its bio-cannons the Harridan may use its scything claws to swoop down on the enemy and attack in close combat. TO do this the Harridan is moved into contact with an enemy unit - it can still be fired at as normal. It then makes it two attacks. Afterwords the Harridan flies off using the normal flyer rules.</description>
        </rule>
        <rule name="Gargoyle Brood" id="ddfb-0c8c-f607-c9fa" hidden="false">
          <description>The Gargoyle Brood can be deployed as if disembarking from a vehicle. Place the Gargoyle Brood on the table with 2" of the Harridan. They may move as normal in the Tyranid player's next turn.
If the Harridan is hit by a blast weapon while the Gargoyles are attacked then the Gargoyles are hit as well. If the Harridan is shot down then the Gargoyles immediately deploy from the point where the Harridan was destroyed.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Gargoyle Brood" id="811a-796d-13e5-c764" collective="false" hidden="false" import="true" type="unit">
          <constraints>
            <constraint id="73e5-b16b-6779-f5d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
