    <selectionEntry name="Ripper Swarm" id="6d78-faad-79fd-b133" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <infoLinks>
        <infoLink name="Instinctive Behavior" id="838c-51c1-598d-0bb4" hidden="false" targetId="dea2-e710-8473-b3ed" type="rule" />
        <infoLink name="Shoot the Big Ones!" id="a535-a1e3-55be-b55c" hidden="false" targetId="e5fa-b52a-258b-5e3d" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Mindless" id="b3f5-3283-0948-68a6" hidden="false">
          <description>A ripper swarm never has to fall back and is assumed to automatically pass any Morale checks it is required to take, even against attacks which normally force their target to fall back with no test taken. Rippers cannot be pinned. For the purposed of mission objectives, Ripper Swarms cannot capture table quarters, hold objectives, or count as surviving troups in a Meat Grinder battle.</description>
        </rule>
        <rule name="Vulnerable to Blasts" id="739d-e2a1-a793-3269" hidden="false">
          <description>Template and blast weapons inflict two wounds instead of one on Ripper Swarms</description>
        </rule>
        <rule name="Small Targets" id="e468-ead0-7b3a-d2c8" hidden="false">
          <description>Ripper Swarm's cover saves are improved by +1.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Rippers" id="8666-c59f-3323-5a9d" collective="false" defaultSelectionEntryId="c216-469e-c778-886b" hidden="false" import="true" sortIndex="1">
