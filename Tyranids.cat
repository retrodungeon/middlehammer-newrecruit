    <profile name="Flesh Hooks" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="29d2-7727-8aaa-e025">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">6"</characteristic>
