          <infoLinks>
            <infoLink name="Gargoyle" id="dcec-278d-8aea-fcc1" hidden="false" targetId="c3d2-4b27-25dc-cc65" type="profile" />
            <infoLink name="Fleshborer" id="8d2a-5897-44c2-3160" hidden="false" targetId="36de-021e-7ce1-8b11" type="profile" />
            <infoLink name="Bio-plasma" id="84cd-d6b1-d2b9-8cdf" hidden="false" targetId="5611-7e2e-662f-0506" type="rule" />
            <infoLink name="Deep Strike" id="51d9-633a-a259-48b4" hidden="false" targetId="5715-6219-5059-9bcf" type="rule" />
            <infoLink name="Instinctive Behavior" id="df50-1470-27cf-817a" hidden="false" targetId="dea2-e710-8473-b3ed" type="rule" />
            <infoLink name="Shoot the Big Ones!" id="7cf0-ca86-e797-6241" hidden="false" targetId="e5fa-b52a-258b-5e3d" type="rule" />
          </infoLinks>
          <rules>
            <rule name="Fleet of Wing" id="0de6-97b6-4e0b-653b" hidden="false">
              <description>Instead of shooting the unit may move an additional D6" in the shooting phase</description>
            </rule>
            <rule name="Wings" id="5232-dfee-0aeb-08e8" hidden="false">
              <description>Gargoyles can move 12" in the Movement phase and they will advance and fall back 3D6" instead of 2D6". They ignore terrain moved over, but may not enter difficult or impassable terrain. Gargoyles forced to enter difficult or impassible terrain for any reason are removed as casualties.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Gargoyles" id="8aee-aaae-d493-2e10" collective="false" defaultSelectionEntryId="78e9-2d39-acbf-f0a0" hidden="false" import="true">
