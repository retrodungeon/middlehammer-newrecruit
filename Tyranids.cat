      <rules>
        <rule name="Bounding Leap" id="ed66-2bdd-c5f3-e7d7" hidden="false">
          <description>In the Assault phase the unit may assault up to 12". They also advance and fall back 3D6". Also they get their full number of attacks in close combat while only be within 2" of an enemy model.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
