        <selectionEntry id="8dab0e93-d98a-aaae-7eed-11f57558c0d6-8730e" name="The Ymgarl Factor" page="0" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules>
            <rule id="c67b13a5-0b92-9e76-73d6-31f379afd931-8730e" name="The Ymgarl Factor" page="68" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>At the start of every Assault phase, a model with the Ymgarl Factor must alter their form into one of the three listed below. The bonus gained lasts until the end of the phase. The same form cannot be chosen in two consecutive turns.

- Slashing Claws: The model has +1 Strength.
- Tentacled Limbs: The model has +1 Attack.
- Protective Carapace: The model's armour save is improved by 1.</description>
            </rule>
          </rules>
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8dab0e93-d98a-aaae-7eed-11f57558c0d6-maxSelections-8730e" type="max" />
