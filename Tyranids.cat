        <infoLink name="Paroxysm" id="648b-60fc-eced-111a" hidden="false" type="profile" targetId="8591-bb24-f8f4-acc0" />
        <infoLink name="Psychic Scream" id="786a-c7b9-026a-4734" hidden="false" type="profile" targetId="1f20-ad5f-1a3a-b262" />
      </infoLinks>
      <profiles>
        <profile name="Bone Sabres" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="bd4c-f4e0-d3c2-0328">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Bone Sabre's attacks inflict instant death regardless of opponent's Toughness. In addition, any successful invulnerable saves made against hits inflicted by the Bone Sabres must be re-rolled.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Monstrosity" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="2f0d-6e98-dd47-b0d7">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The Swarmlord has a Synapse range of 18". In addition, the Swarmlord may use two Psychic powers a turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Swarm Leader" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="1788-b5ed-9dd6-fed8">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the beginning of your Shooting phase, the Swarmlord can bestow one of the following special abilities onto any one friendly unit within 18": Acute Senses, Preferred Enemy or Furious Charge. These benefits last until the end of your turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Alien Cunning" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="ed07-6c57-c8ef-b693">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Whilst the Swarmlord is alive, you must add 1 to any of your reserve rolls. In addition, if any of your units arrive using the outflank ability, you may re-roll the dice to determine which table edge they arrive from.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
