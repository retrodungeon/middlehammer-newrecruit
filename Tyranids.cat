          <entryLinks />
          <costs>
            <cost name="Points" value="0.0" typeId="6f18-a8fc-2c5b-9517" />
          </costs>
        </selectionEntry>
        <selectionEntry id="dfdd-7fb7-2175-51d9-8730e" name="Psyker (Mastery Level 2)" page="0" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="67c5-0761-0684-ed2a-8730e" name="Psychic Overload: Warp Charge 2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Psychic Overload is a focussed witchfire power with a range of 24". The target must take a Leadership test on a 3D6. Vehicles are treated as having a Leadership of 10. If the test is failed, non-vehicle models suffer D3 Wounds with no armour or cover saves allowed, and vehicle models suffers a single glancing hit with no cover saves allowed.  The Psyker can attempt to manifest this psychic power up to 3 times in each of its Psychic phases. Each attempt is resolved separately. However, an enemy unit cannot be selected as the target of Psychic Overload manifested by the same Psyker more than once each Psychic phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="49bb-5704-6a98-c6a1-8730e" name="Psychic Powers" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>A Maleceptor always knows the Psychic Overload psychic power. A Maleceptor generates its remaining powers from the Powers of the Hive Mind.</description>
            </rule>
          </rules>
          <infoLinks>
