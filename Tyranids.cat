    <selectionEntry name="Lictors" id="dce0-4e85-7b46-b0a5" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <infoLinks>
        <infoLink name="Scything Talons" id="748e-eb34-b1b2-ffa3" hidden="false" targetId="959a-831b-05aa-b8cf" type="rule" />
        <infoLink name="Rending Claws" id="b6bc-a4e7-943f-b963" hidden="false" targetId="8560-537e-b897-32f0" type="rule" />
        <infoLink name="Flesh Hooks" id="e275-fd50-21f1-f083" hidden="false" targetId="38cf-0395-332e-7590" type="rule" />
        <infoLink name="Fearless" id="7728-3bd0-f87e-5449" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
        <infoLink name="Shoot the Big Ones!" id="4896-3178-9dd0-70d5" hidden="false" targetId="e5fa-b52a-258b-5e3d" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Secret Deployment" id="2502-5d93-588d-5d75" hidden="false">
          <description>See the secret deployment rule in Codex: Tyranids</description>
        </rule>
        <rule name="Stealth" id="5e1e-a819-c518-405b" hidden="false">
          <description>A Lictor always recieves a 5+ cover save, even in the open. If actually in cover, the cover save granted by the terrain is improved by 2.</description>
        </rule>
        <rule name="Hit and Run" id="e29f-fc2e-5e7a-9e78" hidden="false">
          <description>At the end of any Assault phase, after all Morale checks have been taken, the Lictor can choose to immediately fall back 3D6" and regroup at the end of the move. Enemy models may not pursue the Lictor, but may consolidate.</description>
        </rule>
        <rule name="Independent" id="d818-cffc-5d39-afe2" hidden="false">
          <description>Lictors cannot capture table quarters, hold objectives, or count as surviving troups in a Meat Grinder battle.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Lictor" id="7174-e1f9-6f0d-0416" collective="false" defaultSelectionEntryId="c000-b229-d7e0-43e8" hidden="false" import="true" sortIndex="1">
