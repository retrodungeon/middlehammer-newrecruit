      <selectionEntries>
        <selectionEntry id="7c7b-b18d-3738-9666-8730e" name="Scything Talons" page="0" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules />
          <infoLinks>
            <infoLink id="5442-36cb-324d-b9ff-8730e" hidden="false" targetId="cecef41d-6b13-9342-c9af-17fc684c15df-8730e" type="profile">
              <profiles />
