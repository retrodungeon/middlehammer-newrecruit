          </profiles>
          <rules>
            <rule id="3a47268d-e372-5a74-2e8c-0b1b8c8c32d1-8730e" name="Assimilate" page="0" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>If this weapon's close combat attacks cause an enemy model to be removed as a casualty,
the model equipped with the Maw-claws of Thyrax gains the Preferred Enemy special rule
against all units chosen from the same codex as the model removed as a casualty.</description>
            </rule>
          </rules>
