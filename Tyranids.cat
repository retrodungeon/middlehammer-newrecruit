        <infoLink targetId="d421-bc38-3f2d-7fee" id="79c3-81bf-e2bc-7162" type="profile" name="Living Bomb" hidden="false" />
      </infoLinks>
      <profiles>
        <profile name="Orbital Deployment" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="ea77-5f68-89e5-dc9c">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Spore Mine Clusters are always deployed in the following manner. After both sides have selected their deployment zone, but before any units are deployed, all of your Spore Mine Clusters must Deep Strike onto the board. If any scatter off the board or into impassable terrain the entire cluster is destroyed as described in the 1-2 result on the Deep Strike Mishap table. After they have landed, the Spore Mines in the cluster are treated as individual Spore Mines (see Living Bomb)</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
