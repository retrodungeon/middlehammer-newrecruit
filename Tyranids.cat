        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
      </characteristics>
    </profile>
    <profile name="Stranglethorn Cannon" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="b1f6-94cd-91f8-1517">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">36"</characteristic>
