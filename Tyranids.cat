          <profiles>
            <profile id="7e9bbd4c-8f55-df86-4d1a-79bad9de25aa-8730e" name="Mucolid Spore" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
