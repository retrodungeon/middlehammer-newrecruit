      <constraints>
        <constraint field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0a31-2253-0968-e491-8730e" type="max" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="5541-980a-c16b-e017-8730e" name="Tyrant Guard" page="86" hidden="false" collective="false" type="model">
          <profiles />
          <rules>
            <rule id="6c9c-9992-21fd-c4f5-8730e" name="Blind Rampage" page="46" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>If a Hive Tyrant (or the Swarmlord) is killed whilst part of a unit of
Tyrant Guard (see the Shieldwall special rule, below), from the end of that turn the
surviving Tyrant Guard have the Furious Charge and Rage special rules for the remainder
of the battle.</description>
            </rule>
            <rule id="ca28-0bad-3d20-a420-8730e" name="Shieldwall" page="46" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>A single Hive Tyrant (or the Swarmlord) may join a unit of Tyrant Guard
exactly as if it were an Independent Character. A Hive Tyrant (or the Swarmlord) in a unit
that contains at least one model with this special rule automatically passes Look Out, Sir
rolls.</description>
            </rule>
