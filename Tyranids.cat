    <profile name="Spike Rifle" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="c1ad-8cb3-666e-ac6a">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">18"</characteristic>
