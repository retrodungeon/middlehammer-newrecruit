        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
      </characteristics>
    </profile>
    <profile name="Rupture Cannon" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="95da-185c-8c2a-797c">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">48"</characteristic>
