    <selectionEntry name="Mutable Ripper Swarm Brood" id="028f-e350-5be7-102c" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <infoLinks>
        <infoLink name="Instinctive Behavior" id="ddf8-4841-3671-a034" hidden="false" targetId="dea2-e710-8473-b3ed" type="rule" />
        <infoLink name="Shoot the Big Ones!" id="6ced-99a3-ab9e-28d8" hidden="false" targetId="e5fa-b52a-258b-5e3d" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Mindless" id="e98d-e0ac-0c59-cb51" hidden="false">
          <description>A ripper swarm never has to fall back and is assumed to automatically pass any Morale checks it is required to take, even against attacks which normally force their target to fall back with no test taken. Rippers cannot be pinned. For the purposed of mission objectives, Ripper Swarms cannot capture table quarters, hold objectives, or count as surviving troops in a Meat Grinder battle.</description>
        </rule>
        <rule name="Small Targets" id="9ac2-ebf2-c367-f2a1" hidden="false">
          <description>Ripper Swarm's cover saves are improved by +1.</description>
        </rule>
        <rule name="Vulnerable to Blasts" id="6851-429e-df22-3b87" hidden="false">
          <description>Template and blast weapons inflict two wounds instead of one on Ripper Swarms</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Ripper Swarms" id="a3e2-1f36-b1a4-aeae" collective="false" defaultSelectionEntryId="c570-61e0-7a5f-052c" hidden="false" import="true" sortIndex="1">
