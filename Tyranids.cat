    <selectionEntry id="8d7b-9399-1808-fa01-8730e" name="Harpy" page="93" hidden="false" collective="false" type="model">
      <profiles />
      <rules>
        <rule id="f9e4-503d-cb8b-97f4-8730e" name="Sonic Screech" page="57" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When a Harpy charges into combat, all enemy models in the combat
suffer -5 to their Initiative
(to a minimum of 1) until the end of that Assault phase.</description>
