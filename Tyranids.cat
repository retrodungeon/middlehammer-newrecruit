            <selectionEntry id="cd19-7428-ec2e-25cf-8730e" name="Incendiary Ichor" page="132" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="129f-2e99-482c-d311-8730e" name="Incendiary Ichor" page="132" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whenever the Hierophant Bio-titan suffers an unsaved wound in the Fight sub-phase, centre a Large Blast (5 ") template over the model which caused the wound. All models, other than the Hierophant Bio-titan, underneath the template suffer an immediate wound themselves, with no armour saves of any kind allowed. Vehicles under the template suffer D3 Glancing hits instead. All wounds caused by this biomorph count for combat resolution.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules />
              <infoLinks />
              <modifiers />
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cd19-7428-ec2e-25cf-maxSelections-8730e" type="max" />
