          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="410d-ed07-e811-1dc6" type="max" />
          </constraints>
          <rules>
            <rule id="e72b-932c-8756-2d5c" name="Regimental Standard" hidden="false">
              <description>Add +1 to the combat resolution score of any assault that takes place within 6" of a Regimental Standard. If the model bearing the standard is slain in close combat then the enemy model that slew him captures the standard and the enemy gets the +1 bonus from then on. A standard can change hands several times in a single battle.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
          </costs>
        </selectionEntry>
