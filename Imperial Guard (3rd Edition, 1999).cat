        <selectionEntry id="da15-c866-538e-ce07" name="Colonel 'Snake' Stranski" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ba58-8aa0-e9e1-a6bb" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ae98-d9c9-d540-b252" type="min" />
          </constraints>
          <rules>
            <rule id="9ae1-2e26-408b-b289" name="All Guns Blazing" hidden="false">
              <description>While riding in his Chimera, Stranski may fire both his plasma pistols from the hatch. He can fire these in addition to any other weapons the Chimera is firing and he can fire them regardless of how far the Chimera travelled.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="8681-6f20-ee4c-e455" name="Colonel" hidden="false" targetId="6cd0-8cde-3bf9-8d07" type="profile">
              <modifiers>
                <modifier type="set" field="name" value="Colonel 'Snake' Stranski" />
              </modifiers>
            </infoLink>
            <infoLink id="3915-18d3-ad91-5071" name="Plasma Pistol" hidden="false" targetId="7b91-b670-d042-7c88" type="profile">
              <modifiers>
                <modifier type="set" field="name" value="Twin-Linked Plasma Pistol" />
              </modifiers>
