    <selectionEntry id="beba-f3ec-f257-0211" name="Ogryns" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="dbcb-ee0e-ee80-c9f0" name="Bulky" hidden="false">
          <description>Ogryns take up two spaces each in a transport vehicle.</description>
        </rule>
        <rule id="5686-3561-34ca-efa3" name="It's Dark in Dere!" hidden="false">
          <description>Ogryn squads not led by a Bone'ead will only embark if there is an Officer or a Commissar within 12" of the squad. Ogryn may still start the game embarked.</description>
