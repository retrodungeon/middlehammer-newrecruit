    <selectionEntry id="bb16-f01c-0c2c-4ac3" name="Baneblade (IA)" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="d994-18c1-4552-54ca" name="Difficult Terrain" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule id="eb24-fa00-b574-ae7b" name="Lumbering Vehicle" hidden="false">
          <description>The Baneblade can move up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="d93b-00cc-1025-f641" name="Ordnance" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="f731-f583-c01e-0d89" name="Targetting" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons. The co-axial autocannon must fire at the same target as the Baneblade Battle Cannon</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6879-bf00-b23b-7cf2" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="3x Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
        <infoLink id="324b-4008-2325-6cd5" name="Twin-Linked" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
        <infoLink id="9bc4-5f0b-3b65-5f7c" name="Baneblade" hidden="false" targetId="6533-238a-6e25-f216" type="profile" />
        <infoLink id="a0ab-c516-9d85-8c3a" name="Baneblade Battle Cannon" hidden="false" targetId="85dd-b3a9-328b-96d5" type="profile" />
        <infoLink id="55d2-ca06-f9aa-225c" name="Demolisher" hidden="false" targetId="720f-5c52-b5ff-ee75" type="profile" />
        <infoLink id="2004-4ac5-79ef-4ce8" name="Lascannon" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="2x Lascannons" />
          </modifiers>
        </infoLink>
        <infoLink id="19f9-8fe5-e6b8-f2b9" name="Autocannon" hidden="false" targetId="6128-e2af-037e-4d1a" type="profile" />
      </infoLinks>
      <entryLinks>
        <entryLink id="716a-d0b5-bad9-7d77" name="Vehicle Upgrades" hidden="false" collective="false" import="true" targetId="c0af-40a7-0f54-9847" type="selectionEntryGroup" />
      </entryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="634" />
      </costs>
    </selectionEntry>
    <selectionEntry id="5e44-508d-e6b7-6cb3" name="Shadowsword (IA)" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="81c2-c35c-e537-ce08" name="Targetting" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons.</description>
        </rule>
        <rule id="0ce2-4553-0e7b-9c50" name="Ordnance" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="6d5b-8bc8-caef-d433" name="Difficult Terrain" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule id="5e66-0279-abc9-15e3" name="Lumbering Vehicle" hidden="false">
          <description>Moves up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="100b-e9a8-3414-5384" name="Tank Shock" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="e4bf-6f57-c31e-e47d" name="Shadowsword" hidden="false" targetId="80ea-0efb-aac5-cfc9" type="profile" />
        <infoLink id="6475-548d-8bc5-9734" name="Volcano Cannon" hidden="false" targetId="7e64-0b48-b422-af0e" type="profile" />
        <infoLink id="25e3-c7be-7685-3991" name="Titan Killer" hidden="false" targetId="b333-4165-9b69-fc6a" type="rule" />
        <infoLink id="4dc7-15cb-ba0f-39fd" name="Twin-Linked" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
        <infoLink id="0e01-dd23-584c-298d" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="Two Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <entryLinks>
        <entryLink id="1653-8f48-3ff0-b401" name="Vehicle Upgrades" hidden="false" collective="false" import="true" targetId="c0af-40a7-0f54-9847" type="selectionEntryGroup" />
      </entryLinks>
      <costs>
