              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="69bb-7334-e036-7dd4" type="max" />
          </constraints>
          <rules>
            <rule id="1fa8-edec-196d-617f" name="Smoke Launchers" hidden="false">
              <description>Once per game, after completing movement, a vehicle with smoke launchers may trigger them. The vehicle cannot fire and use its smoke launchers in the same turn. Any penetrating hits scored by the enemy in the next Shooting phase count as glancing hits.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="3" />
          </costs>
        </selectionEntry>
        <selectionEntry id="6c35-d694-60a7-53bb" name="Track Guards" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
