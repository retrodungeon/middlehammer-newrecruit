            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dcc2-0f23-1cbb-2f20" type="max" />
          </constraints>
        </entryLink>
        <entryLink id="dba4-fa13-6539-5e0e" name="Tanith Infantry Squad" hidden="false" collective="false" import="true" targetId="46e9-46e2-3d2a-8eaa" type="selectionEntry" defaultAmount="1,1">
          <constraints>
            <constraint field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3b66-9e01-91a7-219d" type="min" />
