    <selectionEntry id="e11a-b8f5-b754-644b" name="Captain Obadiah Schfeer (IA)" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="5e28-244d-ab0a-ac19" name="My Boys Love It" hidden="false">
          <description>Obadiah's tank is converted to varry a loud speaker system. Over this, he broadcasts orders to the rest of the company and loud Varolian martial music to inspire the boys and frighten the enemy (Varolian martial music is very loud, long, and to the untrained ear, quite painful). When Obadiah's tank forces a Tank Shock test on an enemy unit, they must make the test at -1 to their Leadership.</description>
        </rule>
        <rule id="6afa-183e-ca93-73a9" name="Tank Hunters" hidden="false">
          <description>Add +1 to all Armour Penetration rolls</description>
        </rule>
        <rule id="504a-17ee-2559-7e95" name="Improved Comms" hidden="false">
          <description>The Imperial Guard player may re-roll one Reserves roll per turn, and to re-roll the dice when checking to see if an enemy unit or obstacle is hit by a preliminary bombardment</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8768-c327-df46-40bc" name="Leman Russ Vanquisher" hidden="false" targetId="919f-bf50-b35d-742e" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="Steel Dog Alpha" />
            <modifier type="set" field="b109-f88e-dcc7-8a24" value="4" />
          </modifiers>
