          </constraints>
          <rules>
            <rule id="d2ce-0ead-a7fc-333e" name="Track Guards" hidden="false">
              <description>The vehicle treats 'Immobilised' results as 'Crew Stunned' on a roll of a 4+. This does not combine with the extra armour ability.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
