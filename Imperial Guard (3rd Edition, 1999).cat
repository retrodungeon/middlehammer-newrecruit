              </constraints>
              <rules>
                <rule id="6e79-e206-fada-c71c" name="Recovery Vehicle" hidden="false">
                  <description>The Atlast can drag any destroyed or immobilised vehicle (friend or foe) that starts the turn in contact with it. Both vehicles may move up to D6" and must remain in base contact at the end of the move. Neither vehicle may shoot in the same turn that they are towing or being towed, except that the vehicle may fire one weapon at the Atlast if it is able and wants.</description>
                </rule>
              </rules>
              <infoLinks>
