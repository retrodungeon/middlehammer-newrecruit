    <selectionEntry id="5829-a79d-bb5a-4cfe" name="Earthshaker Platform (IA)" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="998e-e776-4170-a8cb" name="Indirect Fire" hidden="false">
          <description>May fire the earthshaker in Indirect File mode instead of direct fire. A weapon that does so changes its range to G36"-240".</description>
