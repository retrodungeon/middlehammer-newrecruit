    <profile name="Dark Lance" id="8fc4-ffbc-ce70-c5bf" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">36"</characteristic>
