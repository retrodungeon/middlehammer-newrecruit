                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User /+2</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3/2</characteristic>
