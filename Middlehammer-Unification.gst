      </characteristics>
    </profile>
    <profile name="Multi-laser" id="5202-9bae-1ed3-47ca" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">36"</characteristic>
