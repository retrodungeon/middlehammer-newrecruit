        <profile name="Venerable Dreadnought" id="e517-6fb2-82e7-7ea8" hidden="false" typeId="acd3-2539-3641-1250" typeName="Walker Vehicle">
          <characteristics>
            <characteristic name="WS" typeId="3d9c-8977-9b95-824b">5</characteristic>
