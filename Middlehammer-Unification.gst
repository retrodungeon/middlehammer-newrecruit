      </characteristics>
    </profile>
    <profile name="Eradicator Nova Cannon" id="509c-ef81-c7b7-352d" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">36"</characteristic>
