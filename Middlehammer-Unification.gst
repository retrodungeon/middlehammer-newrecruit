        <selectionEntry id="a51a-2f2a-a9b1-431b" name="Numinasta's Casket of Electromancy" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="9196-172b-5766-d9fe" name="Numinasta's Casket of Electromancy" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <profiles />
              <rules />
              <infoLinks />
