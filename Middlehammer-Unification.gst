    <profile name="Storm Bolter" id="a37b-6942-f8fb-4aee" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
