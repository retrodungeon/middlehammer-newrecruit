    <profile name="Wraithcannon" id="3da4-191b-40b4-847a" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">12"</characteristic>
