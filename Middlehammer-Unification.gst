        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
      </characteristics>
    </profile>
    <profile name="Chimera Armored Transport" id="6c7f-e0f5-f0d6-396d" hidden="false" typeId="0092-3322-1b28-b657" typeName="Vehicle">
