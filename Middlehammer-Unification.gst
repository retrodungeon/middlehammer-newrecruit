              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer of Desvalle's Holy Circle has a 4+ invulnerable save. Furthermore, enemy units cannot arrive via Deep Strike anywhere within 12" of the bearer. If an enemy unit arriving via Deep Strike scatters within 12" of the bearer, they automatically suffer a Deep Strike Mishap.</characteristic>
              </characteristics>
            </profile>
