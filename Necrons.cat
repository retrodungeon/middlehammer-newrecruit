    <selectionEntry id="7778-0328-be22-96f7-d6d91" name="(Apoc) Doom Scythe Deathbringer Flight" page="" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="9a89-feb3-1037-b417-d6d91" name="Cage of Destruction" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any unit that is hit by three or more death ray shots from this formation in a single Shooting phase is caught in a Cage of Destruction. The target suffers a number of Strength 10 AP2 hits equal to half the number of models in that unit, in addition to the hits inflicted normally by the death rays.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks>
        <entryLink id="631e-1c5c-0a7c-4092-d6d91" name="" hidden="false" targetId="468ac47c-8d53-0aa6-c9d6-4e0d3225b020-d6d91" type="selectionEntry">
