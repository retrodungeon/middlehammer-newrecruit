    <selectionEntry id="9605-3b01-4680-5ca1" name="Wraiths" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="6e17-91e9-e720-9012" name="Phase Shift" hidden="false">
          <description>Wraiths have a 3+ invulnerable save. When attacking models in or behind cover, Wraiths count as having frag grenades so will strike simultaneously.</description>
        </rule>
        <rule id="d471-4acf-b35d-a272" name="Wraithflight" hidden="false">
          <description>Wraiths move in the same manner as jetbikes but they regard no terrain as impassable and never have to take Difficult Terrain tests. Wraiths cannot end their move "inside" objects to avoid being shot at. They cannot move through enemy models or vehicles either.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="cc9a-472d-1f5c-b1a3" name="Phase Out" hidden="false" targetId="d2b0-ba08-4fb1-d9f3" type="rule" />
