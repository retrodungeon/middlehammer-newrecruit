    <selectionEntry id="0d75-e685-adb6-c36b-d6d91" name="Formation: Anrakyr's Strategic Decurion" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="738b-1895-d164-70d6-d6d91" name="Grand Strategy" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>You re-roll the dice when attempting to Seize the Initiative. Furthermore, as long as Anrakyr the Traveller has not been removed as a casualty, you can re-roll Reserve Rolls.</description>
