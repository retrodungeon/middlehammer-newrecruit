      <rules>
        <rule id="934a-76fb-8bac-7103" name="Destroyers" publicationId="263c-b15e-84a3-a711" page="19" hidden="false">
          <description>Destroyers may move and fire thieir gauss cannons.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="e0e3-7c80-25a4-3d77" name="Gauss Cannon" hidden="false" targetId="96af-6622-de74-9cb8" type="profile" />
