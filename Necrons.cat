      </characteristics>
    </profile>
    <profile id="f17c-2719-c9f6-605d-d6d91" name="Warlord Trait: Scorn of the Ages" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and any model in a unit he is part of have the Hatred special rule.</characteristic>
      </characteristics>
    </profile>
    <profile id="ee3e-5023-e620-67f5-d6d91" name="Gauss Flayer" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
