    <selectionEntry id="1e88-d98c-d696-d244" name="Catacomb Command Barge (Homebrew)" hidden="true" collective="false" import="true" type="upgrade">
      <comment>Normal-Skimmer-OpenTopped
Armor = 11-11-11 = 5+30+20=55
Opentopped = -5
Living Metal = 50
Transport = 1
Fast = 20
Skimmer=20</comment>
      <modifiers>
        </modifiers>
      <rules>
        <rule id="9bfe-a8de-a142-c57f" name="Chariot" hidden="false">
          <description>If the Catacomb Command Barge is assaulted the Necron Lord embarked on it may make melee attacks on the models assaulting it. Resolve the attacks in Initiative order as normal. If the Catacomb Command Barge is destroyed before the Necron Lord can attack then he may not make these attacks.</description>
        </rule>
      </rules>
      <infoLinks>
