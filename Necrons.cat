    <selectionEntry id="c972-c7ac-3c7d-a548-d6d91" name="Transdimensional Beamer" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="0a50-26c5-9f8f-ae1b-d6d91" name="Transdimensional Beamer" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12"</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Exile Ray</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="d410-2418-037e-a9dc-d6d91" name="Exile Ray" page="" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When firing a weapon with this special rule, a To Wound roll of a 6 wounds automatically, regardless of the target's Toughness, and the Wound has the Instant Death special rule. Against vehicles and buildings, an Armour Penetration roll of a 6 causes a penetrating hit, regardless of the target's Armour Value.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks />
      <costs>
        <cost name="Points" value="10.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="5389-3269-2a3c-d4a6-d6d91" name="Sepulchral Scarabs" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="964f-7451-cff1-3414-d6d91" name="Sepulchral Scarabs" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model gains the It Will Not Die special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
