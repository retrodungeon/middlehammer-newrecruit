    <selectionEntry id="ba26-b765-f98e-0142-d6d91" name="(FW) Necron Tomb Fortress" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="e182-bec4-ddcd-05d2-d6d91" name="Necron Tomb Fortress" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This fortification comprises two Necron Tomb Citadel Realm of BAttle tiles placed on the table so that each tile has the entirety of any one edge tile edge in contact with the other tile.</characteristic>
