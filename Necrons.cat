            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3b1f00e2-08fa-eaf7-f2af-fd2a772e4e3b-maxSelections-d6d91" type="max" />
          </constraints>
