        </selectionEntry>
        <selectionEntry id="453f6011-4272-1a4d-4f08-d9411d8ebaeb-d6d91" name="Power Crucible" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="9002b680-5cde-6c2a-eac7-e2bd3523f291-d6d91" name="Power Crucible" hidden="false" typeId="286c-0cd4-7630-47d0" typeName="Building">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers>
                </modifiers>
              <characteristics>
                <characteristic name="Armour Value" typeId="83f8-a458-93f9-3e46">14</characteristic>
                <characteristic name="Transport Capacity" typeId="0e9c-76b3-2877-614d">-</characteristic>
                <characteristic name="Access Points" typeId="13de-08da-586d-f7c0">-</characteristic>
                <characteristic name="Fire Points" typeId="0767-d18e-a48d-3b39">-</characteristic>
                <characteristic name="Hull Points" typeId="d1d7-bcc6-18cd-c948">-</characteristic>
                <characteristic name="Building Type" typeId="ff97-f5f0-521b-eaf4">Power Crucible</characteristic>
              </characteristics>
            </profile>
            <profile id="b9cc-107d-0d60-5c4d-d6d91" name="Power Crucible (Details)" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each of these structures generates a defensive power field around the tomb complex and also amplifies the Necron ability for self-repair and reconstruction.  Unless all the Power Crucibles have been destroyed, the following rules apply for all units on the surface of the Tomb Citadel or Tomb Fortress: Defence field</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="c9fec350-8095-a0ab-8ffb-99e3bab4570c-d6d91" name="Defence Field" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Units on the surface of the Tomb Citadel, or docked with it, as well as the Tomb Ziggurat and the Power Crucible, have a 3+ invulnerable save against shooting attacks.</description>
            </rule>
          </rules>
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="453f6011-4272-1a4d-4f08-d9411d8ebaeb-minSelections-d6d91" type="min" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="453f6011-4272-1a4d-4f08-d9411d8ebaeb-maxSelections-d6d91" type="max" />
          </constraints>
