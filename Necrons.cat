    <selectionEntry id="58a58910-eaff-f4fa-8225-677cc74c8d6a-d6d91" name="Night Scythe" hidden="false" collective="false" type="model">
      <profiles>
        <profile id="ccf08a95-2d3e-983d-6b7c-a982978ec20b-d6d91" name="Night Scythe" hidden="false" typeId="3a08-ea03-a598-8615">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">4</characteristic>
            <characteristic name="Front" typeId="3a4e-bc1d-4a12-7176">11</characteristic>
            <characteristic name="Side" typeId="d12e-7bdb-191c-4849">11</characteristic>
            <characteristic name="Rear" typeId="a4cb-791a-6a75-4e4a">11</characteristic>
            <characteristic name="HP" typeId="93e6-d4b1-28a8-944b">3</characteristic>
