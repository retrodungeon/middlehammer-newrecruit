    <selectionEntry id="d450-12e3-bb56-1724" name="Scarab Swarms" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="0815-f6b7-716f-f502" name="Swarms" hidden="false">
          <description>Scarab Swarms move and fight in the same manner as jetbikes, but don't get the +1 Toughness bonus and may move through difficult terrain with no need to take a Difficult Terrain test. For the purpose of mission objectives, Scarabs can't capture table quarters, hold objectives, or count as surviving troops in a Meat Grinder battle.</description>
        </rule>
        <rule id="779d-5b7e-fd51-46ff" name="Vulnerable to Blasts" hidden="false">
          <description>Template, Ordnance and Blast marker weapons inflict two wounds instead of one on Scarab swarms. A weapon of Strength 6 or higher will, of course, instantly kill a swarm as normal.</description>
        </rule>
        <rule id="e70a-7402-90f5-9fae" name="Small Target" hidden="false">
          <description>Being extremely hard to hit in cover, the swarm's cover save is at a +1. Note that this doesn't give them a cover save if they wouldn't normally get one.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="401a-a9d0-ef96-6675" name="Fearless" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
        <infoLink id="29f2-3b1b-3c9e-efc4" name="Deep Strike" hidden="false" targetId="5715-6219-5059-9bcf" type="rule" />
        <infoLink id="bae3-7952-bd71-955e" name="Jetbikes" hidden="false" targetId="4556-3c66-6ed4-87a0" type="rule" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="6a13-0ac0-1b3d-44cf" name="Fast Attack" hidden="false" targetId="74fe-37c3-fbbf-849e" primary="true" />
      </categoryLinks>
      <selectionEntries>
