    <selectionEntry id="51b4b225-69e4-b541-cc60-0795d097282c-d6d91" name="Tesseract Vault" page="" hidden="false" collective="false" type="model">
      <profiles>
        <profile id="c1bcde48-2a5e-b25f-468e-4595eb7a58f7-d6d91" name="Tesseract Vault" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">14</characteristic>
            <characteristic name="Side" typeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e">14</characteristic>
            <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">14</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">9</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Super-heavy Vehicle, Skimmer)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="759d-0eef-5afb-0ffb-d6d91" name="The Bound Coalescent" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When a Tesseract Vault uses Powers of the C'tan, measure line of sight and distance from the C'tan itself and resolve the attack at Ballistic Skill 5.</description>
        </rule>
        <rule id="b982-3f4c-f351-ed38-d6d91" name="Vengeance of the Enchained" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When a Tesseract Vault loses its last Hull Point, it always suffers a Titanic Explosion! - there is no need to roll on the Catastrophic Damage table.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6ed0955e-db42-d118-ef63-d483c497364f-d6d91" hidden="false" targetId="461bbe4e-d707-b924-e36c-3506a4b46feb-d6d91" type="rule">
