    <selectionEntry id="6a23-f5e5-3524-26e7" name="Pariahs" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="cce2-a46f-55e9-d9dd" name="Souless" hidden="false">
          <description>Any enemy unit with a model within 12" of a Pariah counts as having Leadership 7, unless it would normally be less than that.</description>
        </rule>
        <rule id="4939-faa3-a772-62eb" name="Psychic Abomination" hidden="false">
          <description>Any psyker within 6" of a Pariah at the start of their turn must take a Morale check or fall back along with any squad they are leading. If the psyker is in close combat at the time and fails the Morale check, he will not fall back but will only hit on a 6 in the Assault phase for that turn.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9444-2c42-39f3-26e9" name="Fearless" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
      </infoLinks>
