            <rule id="9d1a5a6e-5cf0-62a3-53d9-03324b63f73e-65c94" name="Containment Field " hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            <description>The containment field of the Tesseract Singularity Chamber provides the Tesseract Ark with a 5+ invulnerable save.</description></rule>
            <rule id="e9a0287a-2385-3da8-d340-d38b1a3c00e6-65c94" name="Gravitational Flux" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            <description>Any model trying to assault or ram the Tesseract Ark must take a Dangerous Terrain test, and any unit charging the Tesseract Ark is always forced into making a Disordered Charge by doing so.</description></rule>
            <rule id="28c5d32d-46ae-cde8-3a23-410918b6b8b1-65c94" name="Unleashed Power" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            <description>The Tesseract Singularity Chamber can unleash its energies as a shooting attack fro the vehicle's forward arc.  Pick one of the energy modes each time the Tesseract is fired:</description></rule>
          </rules>
