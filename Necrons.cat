    <selectionEntry id="8efd-6549-beac-11c5-d6d91" name="(Apoc) Lawbringer Phalanx" page="" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="128c-cc25-492c-fb5b-d6d91" name="Apotheosis Orb" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Triarch Praetorian units from this formation within 6" of the Triarch Stalker have 2+ Strength and 2+ to their Reanimation Protocols rolls.</description>
        </rule>
        <rule id="35fc-52e2-49d1-5571-d6d91" name="Power Flare" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Triarch Stalker's ranged weapon has +2 Strength.  If it has a heat ray, this applies to both profiles.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks>
