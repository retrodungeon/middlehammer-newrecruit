          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ecc6-2673-db44-1d27-d6d91" name="Dread" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models in enemy units that are within 12" this model subtract 2 from their Leadership characteristic.</description>
        </rule>
        <rule id="b03b-37bb-fe9c-bf9c-d6d91" name="Grand Illusion" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Immediately after all forces have deployed and all Scout redeployments have been made, you may remove this model and/or up to D3 other friendly units within 12" of it from the table. Each unit that is removed in this manner can either be immediately deployed again using the normal Deployment rules, or placed in Reserve.</description>
        </rule>
      </rules>
