    <selectionEntry id="9677-a3a7-2111-8c0f-d6d91" name="Formation: Judicator Battalion" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="f48a-ee66-b3b7-0852-d6d91" name="Target Designated" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of each of the controlling player's Shooting phases, nominate one enemy unit within line of sight of a Triarch Stalker from this Formation. All units from this Formation can re-roll failed To Hit, To Wound and armour penetration rolls against the nominated unit until the end of the phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4ecb-21bd-091d-499f-d6d91" hidden="false" targetId="7ecc-bc3d-6e22-63dc" type="rule">
