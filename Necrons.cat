        <selectionEntry id="7fe8-23b1-83e0-1004-d6d91" name="Empathic Obliterator" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="e52d-83cd-8c41-e166-d6d91" name="Empathic Obliterator" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
