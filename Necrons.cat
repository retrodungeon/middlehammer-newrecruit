        <infoLink name="Particle Whip" id="5020-f55f-ee41-6f96" hidden="false" type="profile" targetId="c74a-9967-0fc9-a025" />
        <infoLink name="Living Metal" id="19ee-8ab9-3e18-a289" hidden="false" type="rule" targetId="2290-30ee-3a0d-005c" />
        <infoLink name="Eternity Gate Portal of Exile" id="3664-b6fa-92f4-ba37" hidden="false" type="profile" targetId="ec6a-b2b1-fff4-bcc0" />
      </infoLinks>
      <profiles>
        <profile name="Eternity Gate" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="ff71-6bad-7887-9ca7">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The Eternity gate can be used in one of two ways in each of your turns, as a Dimensional corridor or a Portal of exile. The eternity gate cannot be destroyed separately from the Monolith.</characteristic>
          </characteristics>
        </profile>
        <profile name="Eternity Gate (Dimensional Corridor)" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="324d-7839-3d86-7168">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the start of the Movement phase, choose one friendly unengaged non-vehicle Necron unit on the battlefield or in reserve. That unit immediately phases out from its current position and 'disembarks' from the Monolith's portal. Any models that cannot be placed are removed as casualties, but the move is otherwise trated exactly as disembarking from a vehicle that has moved at combat speed</characteristic>
          </characteristics>
        </profile>
        <profile name="Monolith Deep Strike" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="f42e-9421-984c-00bd">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a Monolith is held in reserve, it must arrive by Deep Strike.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
