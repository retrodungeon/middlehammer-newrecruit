    <selectionEntry id="34c3-538e-2654-e4da-d6d91" name="Formation: Annihilation Nexus" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="3826-b9a6-fbd1-6f55-d6d91" name="Quantum Deflection" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If the Doomsday Ark from this Formation's quantum shielding is deactivated at the start of any of the controlling player's Movement phases, you can nominate an Annihilation Barge from this Formation within 6" that has active quantum shielding. That Annihilation Barge's quantum shielding is immediately deactivated, and the Doomsday Ark's quantum shielding is immediately reactivated.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups />
      <entryLinks>
        <entryLink id="4242-7515-f39f-6aa7-d6d91" name="" hidden="false" targetId="695305da-e640-f652-6ab1-465350a7a581-d6d91" type="selectionEntry">
