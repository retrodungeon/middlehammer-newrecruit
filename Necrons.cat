          <rules>
            <rule id="5796-e313-9f70-48b2-d6d91" name="Wraith Form" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Canoptek Wraiths have a 3+ invulnerable save.</description>
            </rule>
            <rule id="7758-51c4-2e26-de12-d6d91" name="Wraithflight" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>When moving, Canoptek Wraiths can move over all other models and terrain as if they were open ground.  However, they cannot end their move on top of other models and can only end their move on top of impassable terrain if it is possible to actually place the models on top of it.</description>
            </rule>
          </rules>
