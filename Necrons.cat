    <selectionEntry id="dac9-7a63-1c57-2715-d6d91" name="Formation: Reclamation Legion" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="0d94-b1ba-ef1c-a456-d6d91" name="Enhanced Reanimation Protocols" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>You can re-roll Reanimation Protocols rolls of 1 for the Overlord from this Formation (or the model taken in place of the Overlord) and units from this Formation that are within 12" of him.</description>
