    <selectionEntry id="bec4-e2a4-5c6b-a459-d6d91" name="Formation: Oppressor Flight" page="" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="9bed-939a-7cd8-33fc-d6d91" name="Command Asset Located" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>You can re-roll To Wound rolls of 1 and Armour Penetration rolls of 1 for units from this Formation if the target is an enemy HQ unit.</description>
        </rule>
        <rule id="f6cc-4e02-c8c6-20d1-d6d91" name="Energy Transference" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If the Formation is in an Attack Pattern at the start of your turn, pick a single friendly Necron vehicle that is in Reserve. That vehicle can Deep Strike to the battlefield within 6" of the Night Scythe from this Formation and will not scatter. Then roll for any remaining Reserves normally.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups />
