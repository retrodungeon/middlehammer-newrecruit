    <selectionEntry id="bd2c-af7c-ac62-984b-d6d91" name="(Apoc) Court of the Flayer King" page="" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="e2a4-5846-9dda-c783-d6d91" name="Infectious Frenzy" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All models in the Formation and all Flayed Ones and Necron Warrior units within 18" have the Rage and Hatred special rules.</description>
        </rule>
        <rule id="47a5-b9e8-43b9-01f3-d6d91" name="Unstoppable Madness" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All models in the formation have the Feel No Pain special rule. However, the result needed to avoid being wounded depends on the turn number. On game Turn 1, they have Feel No Pain (3+). On Turn 2, they have Feel No Pain (4+). From Turn 3 onwards they have Feel No Pain (5+).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8c73-c249-0e1d-04ee-d6d91" name="" hidden="false" targetId="243a-b08c-3c8c-c363" type="rule">
