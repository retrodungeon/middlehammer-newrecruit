      <infoLinks>
        <infoLink targetId="347c-eae2-8f72-1ae9" id="1279-177d-7cfa-e658" type="rule" name="Heavy" hidden="false" />
        <infoLink name="Necron Monolith" id="e58b-ea9c-eec3-03b5" hidden="false" type="profile" targetId="1732-5a5e-895a-7976" />
        <infoLink name="Tank" id="59d4-196b-0a05-46f6" hidden="false" type="rule" targetId="3475-46b4-28e6-8fb0" />
