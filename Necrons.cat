          <rules>
            <rule id="8254-9266-18e9-fc31-d6d91" name="Exile Blast" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>This weapons hits are randomly allocated. The number of models under the blast template must immediately pass a Strength test or be removed as casualties with no saves of any kind allowed. Models with no Strength value automatically pass, but if a vehicle without a Strength value or a building, they suffer an automatic penetrating hit instead with no saves possible.</description>
            </rule>
          </rules>
