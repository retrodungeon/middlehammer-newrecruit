                <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="436d-7107-7997-f63d-d6d91" name="Stormcaller" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>At the start of the Necron Shooting phase, roll a D6 for each enemy unit within 18" of the Stormcaller. On a roll of a 6, that unit suffers D3 Strength 8 AP5 hits. These hits are allocated using Random Allocation, and vehicles affected are hit on their side armour.</description>
            </rule>
          </rules>
