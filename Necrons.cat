      <profiles />
      <rules />
      <infoLinks />
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <repeats />
          <conditions>
            <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="5035-9fad-cd58-1bce" type="notInstanceOf" />
