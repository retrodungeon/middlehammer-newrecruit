    <selectionEntry id="b97aa461-706c-46d4-7be7-caa5c2416260-d6d91" name="Ghost Ark" hidden="false" collective="false" type="model">
      <profiles>
        <profile id="7920e9c4-4253-07bb-ce2f-03cfae481686-d6d91" name="Ghost Ark" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
