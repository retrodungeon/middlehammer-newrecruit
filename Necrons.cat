    <selectionEntry id="7b0ebefb-e0b5-3c82-a026-05ccb6bc7cdc-d6d91" name="Artefact: Solar Thermasite" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="bde9cfcb-80b9-4f37-3be9-e3a31b690af5-d6d91" name="Solar Thermasite" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
