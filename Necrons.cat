          </constraints>
        </entryLink>
      </entryLinks>
      <costs>
        <cost name="Points" value="0.0" typeId="6f18-a8fc-2c5b-9517" />
      </costs>
    </selectionEntry>
    <selectionEntry id="4030-6c6e-f1af-2142-d6d91" name="(Apoc) Host of the Red Harvest" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries>
        <selectionEntry id="6351-0bcb-35db-732c-d6d91" name="Combined Fire" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="9662-a203-780d-2f98-d6d91" name="Gauss Obliterator" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36"</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">D</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1</characteristic>
              </characteristics>
            </profile>
            <profile id="99db-39a8-1899-97b3-d6d91" name="Host of the Red Harvest" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per Shooting phase, six or more Destroyers in the formation can combine their shooting attacks into a single attack with one of these two listed profiles: Gauss Torrent or Gauss Obliterator.  All of the models that participate must be in range and have line of sight to the target.  Nominate one Destroyer as the firing model.</characteristic>
              </characteristics>
            </profile>
            <profile id="1ee9-375a-4cb6-9ffa-d6d91" name="Gauss Torrent" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Template</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Torrent</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules />
          <infoLinks>
            <infoLink id="88bb-66a5-9873-42e6-d6d91" name="" hidden="false" targetId="5039-18f0-a9ed-0938" type="rule">
