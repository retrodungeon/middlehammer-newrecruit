        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Specialist Weapon, Unwieldy, Two-handed, +D6 Armour Pen</characteristic>
      </characteristics>
    </profile>
    <profile id="f8b7d6ab-57de-4759-01b3-d37c7a935c83-ebe4f" name="Extra Armour" page="70" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Vehicles equipped with extra arnour count Crew Stunned results from the Vehicle Damage table as a Crew Shaken result instead.</characteristic>
      </characteristics>
    </profile>
