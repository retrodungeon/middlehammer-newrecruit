      <rules>
        <rule name="Lumbering Vehicle" id="d2a5-bfe0-4eb7-581c" hidden="false">
          <description>The Rogal Dorn can move up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
      </rules>
