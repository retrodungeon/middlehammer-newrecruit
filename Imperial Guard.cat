    <selectionEntry type="unit" import="true" name="Vendetta Gunship Squadron" hidden="false" id="a01b-097a-2a17-45b1" collective="false">
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Vendetta" hidden="false" id="2e90-8208-737e-668b" collective="false">
          <costs>
