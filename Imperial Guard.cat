            <characteristic typeId="45fd-0f50-e1d0-907c" name="Notes" />
          </characteristics>
        </profile>
        <profile name="Supreme Commander" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="9120-419e-7270-b3f2">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Creed can issue up to four orders each turn. He has a command radius of 24". Creed can use 'For the Honour of Cadia!', 'Bring it Down!', 'Fire on my Target!', 'Get Back in the Fight!', 'First Rank, FIRE! Second Rank, FIRE!', 'Incoming!' and 'Move! Move! Move!'</characteristic>
          </characteristics>
        </profile>
        <profile name="Tactical Genius" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="5198-2eea-288d-b2ba">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">During deployment, choose a single infantry or vehicle unit in your army. That unit has the Scouts special rule for the duration of the battle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink targetId="e3eb-5eda-1ba9-14d6" id="dfd4-4fb7-2589-c83e" type="rule" name="Unique Senior Officer" hidden="false" />
