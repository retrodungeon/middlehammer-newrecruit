    <selectionEntry id="e7ef-e433-9126-7068" name="Hellhound" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="df77-fcbc-aa21-5142" name="Move 'n Shoot" hidden="false">
          <description>A Hellhound that moves over 6" can shoot in the shooting phase but only with its Inferno Cannon. If it moves over 6" it must fire the caccnon via a side or rear facing.</description>
        </rule>
        <rule id="c5f3-5ee6-1a64-ad74" name="Fuel Tanks" hidden="false">
          <description>All glancing hits are treated as penetrating hits instead.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="5baf-4035-fd58-8eb5" name="Hellhound" hidden="false" targetId="8d33-84eb-ee2f-6531" type="profile" />
        <infoLink id="0f08-3024-92a7-75ae" name="Inferno Cannon" hidden="false" targetId="6a00-06f9-5972-4b79" type="profile" />
        <infoLink id="bcdd-8e00-29d0-a518" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile" />
