        <selectionEntryGroup id="fb3b-3f0a-d5f7-07e5" name="Snipers" hidden="false" collective="false" import="true" defaultSelectionEntryId="1008-66eb-342b-ad8f">
          <constraints>
            <constraint field="selections" scope="parent" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1edf-5dae-2b2a-126d" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="19bd-126d-f5f7-ad02" type="min" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="1008-66eb-342b-ad8f" name="Tanith Master Sniper" hidden="false" collective="false" import="true" type="model">
              <rules>
                <rule id="7bfa-998e-123f-56ac" name="Ambush" hidden="false">
                  <description>Set up using the Ambush rules in Codex: Catachans page 20.</description>
                </rule>
                <rule id="033c-a9a3-02ed-436f" name="Camouflage" hidden="false">
                  <description>Tanith Snipers have a 3+ cover save that cannot be improved or reduced by any factors (Camo Cloak already included).</description>
                </rule>
                <rule id="82a2-ed7d-9ac9-22e3" name="Master Snipers" hidden="false">
                  <description>Tanith Master Snipers may re-roll a failed to wound roll but must accept the second result.</description>
                </rule>
                <rule id="98f2-80ac-cb0d-829d" name="Disappear" hidden="false">
                  <description>Tanith Master Snipers never move. During your Movement phase, you may remove the sniper, representing the Master Sniper merging back into the shadows. Once removed, a Master Sniper may not return to the battlefield but doesn't count as having been killed for Victory point purposes. Tanith Master Snipers cannot claim table quarters or other objectives and don't have to be killed for an attacker to win Meat Ginder or Grand Assault.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="fc0d-36d3-0a9a-5c82" name="Tanith Master Sniper" hidden="false" targetId="fe14-8df0-8592-4466" type="profile" />
                <infoLink id="0df2-524a-f5d8-6f2e" name="Sniper Rifle" hidden="false" targetId="3825-4a6b-6aaa-8c99" type="profile" />
                <infoLink id="2e1a-c5d5-6e42-3933" name="Camo Cloak" hidden="false" targetId="647d-f731-5d52-f8e4" type="rule" />
              </infoLinks>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
