          <selectionEntries>
            <selectionEntry id="9476-41bb-aaa9-1a41" name="Atlas Recovery Vehicle (IA)" hidden="false" collective="false" import="true" type="unit">
              <modifiers>
                </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="99c1-1c57-3c13-c223" type="max" />
              </constraints>
              <rules>
                <rule id="e517-3a08-8947-0212" name="Recovery Vehicle" hidden="false">
                  <description>The Atlast can drag any destroyed or immobilized vehicle (friend or foe) that starts the turn in contact with it. Both vehicles may move up to D6" and must remain in base contact at the end of the move. Neither vehicle may shoot in the same turn that they are towing or being towed, except that the vehicle may fire one weapon at the Atlast if it is able and wants.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="098f-2c20-b6bc-6a1b" name="Atlas" hidden="false" targetId="cd29-822f-abf7-7f05" type="profile" />
