    <profile id="2d926960-3e1a-9010-be4a-43f52fe1f61d-ebe4f" name="Vendetta" page="0" hidden="false" typeId="3a08-ea03-a598-8615">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">3</characteristic>
