      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">No longer open-topped</characteristic>
      </characteristics>
    </profile>
    <profile id="f8b7d6ab-57de-4759-01b3-d37c7a935c83-0f066" name="Extra Armour" page="70" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
