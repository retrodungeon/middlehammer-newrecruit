    <profile id="d7589bd3-defb-f757-2bad-c588e6864b0e-ebe4f" name="Spotter's Magnoculars" page="96" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn a model equipped with Spotter's Magnoculars may target one enemy unit within 60" and in their line of sight, instead of firing any weapons that Shooting phase. Any models in the same unit equipped with a Sniper Rifle may target the selected enemy unit, regardless of range (they must still have line of sight to the target unit) and gain the Night Vision rule for the remainder of the Shooting phase.</characteristic>
      </characteristics>
    </profile>
