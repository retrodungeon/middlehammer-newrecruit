    <profile id="fb1f6c9a-5446-7579-7255-317e7b4f5037-0f066" name="Infrared Targeting" page="6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
