    <rule id="207f14e2-a794-768f-3ef6-41cd369f27dc-45e2d" name="Target Acquired" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Once per shooting phase, the owning player may nominate a single enemy unit within line of sight to the Command Squad. All units in the Heavy Weapons Company within 12" of the Command Squad must fire at this target but they count their weapons ass twin-linked for that round of shooting.</description>
    </rule>
