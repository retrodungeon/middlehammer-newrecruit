    <selectionEntry id="bb16-f01c-0c2c-4ac3" name="Baneblade (IA)" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="d994-18c1-4552-54ca" name="Difficult Terrain" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule id="eb24-fa00-b574-ae7b" name="Lumbering Vehicle" hidden="false">
          <description>The Baneblade can move up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="d93b-00cc-1025-f641" name="Ordnance" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="f731-f583-c01e-0d89" name="Targetting" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons. The co-axial autocannon must fire at the same target as the Baneblade Battle Cannon</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6879-bf00-b23b-7cf2" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="3x Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
        <infoLink id="324b-4008-2325-6cd5" name="Twin-Linked" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
        <infoLink id="9bc4-5f0b-3b65-5f7c" name="Baneblade" hidden="false" targetId="6533-238a-6e25-f216" type="profile" />
        <infoLink id="a0ab-c516-9d85-8c3a" name="Baneblade Battle Cannon" hidden="false" targetId="85dd-b3a9-328b-96d5" type="profile" />
        <infoLink id="55d2-ca06-f9aa-225c" name="Demolisher" hidden="false" targetId="720f-5c52-b5ff-ee75" type="profile" />
