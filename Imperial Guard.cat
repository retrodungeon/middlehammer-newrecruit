        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 1</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Place the template so that the narrow end is within 12" of the weapon and the large end is no closer to the weapon than the narrow end. The inferno cannon is then treated like any other template weapon.</characteristic>
      </characteristics>
    </profile>
