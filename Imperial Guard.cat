      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The first time an enemy unit attempts to charge a vehicle with Fire Barrels, that unit suffers D6 S4 AP5 hits, Randomly Allocated.</characteristic>
