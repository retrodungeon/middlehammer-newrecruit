    <profile id="c72d228c-5a29-17c4-17ed-2c0630a9f42d-6122e" name="Mine Plough ABG" page="245" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Roll 2D6 for Dangerous Terrain tests - test is only failed on double 1. Any time the vehicle moves through an enemy Infantry unit as part of a Tank Shock &amp; is not destroyed, the enemy unit takes D3+1 S2 Ap- hits.</characteristic>
      </characteristics>
