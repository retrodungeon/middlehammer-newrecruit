        <infoLink name="Autocannon" id="7921-3890-883a-b977" hidden="false" targetId="6128-e2af-037e-4d1a" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Co-axial Autocannon" />
          </modifiers>
        </infoLink>
        <infoLink name="Searchlight" id="8a0c-bda2-3174-9ff8" hidden="false" targetId="f055-41c4-5db5-4372" type="rule" />
        <infoLink name="Smoke Launchers" id="fad9-31ea-68fe-fc39" hidden="false" targetId="51f3-87b2-5634-c751" type="rule" />
        <infoLink name="Heavy Bolter" id="e2ef-5d2e-693c-7fee" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Pintle-Mounted Heavy Bolter" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Hardened Crew" id="84f3-5627-6aa8-d3a3" hidden="false">
          <description>The vehicle treats all 'Driver Stunned' results on the damage tables as 'Crew Shaken' instead.</description>
        </rule>
        <rule name="Skilled Gunnery" id="68d7-83ec-00c9-e555" hidden="false">
          <description>Nominate a single weapon at the start of the shooting phase. You may re-roll any misses to-hit rolls with that weapon this turn. For ordnance, this allows you to re-roll the scatter dice.</description>
        </rule>
        <rule name="Tank Shock" id="8385-46dc-6233-d6e6" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
        <rule name="Ordnance" id="7eba-79d1-a4ae-df58" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="14fe-5ed0-a6fe-e3b3" hidden="false">
          <description>Moves up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Difficult Terrain" id="520a-2b2a-f913-f417" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule name="Targeting" id="8e1c-42f8-cd02-5cbd" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons.</description>
        </rule>
      </rules>
    </selectionEntry>
