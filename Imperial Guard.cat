            <characteristic name="I" typeId="8517-a46c-d6df-9c75">3</characteristic>
            <characteristic name="A" typeId="a535-0722-3bc1-4d3c">4</characteristic>
            <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">8</characteristic>
            <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">4+</characteristic>
          </characteristics>
        </profile>
        <profile name="Loyal to the End" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="6324-4308-50bb-9e63">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Nork has the Look out - Arghh! rule. In addition, a Commissar (of either tank) will never shoot Nork as a result of the Summary Execution rule. If a Commissar shoots Nork's Commander, however, Nork immediately retaliates - remove the Commissar from play.</characteristic>
          </characteristics>
        </profile>
        <profile name="Heroic Sacrifice" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="6e59-dcf3-c3e8-543a">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Should Nork lose his final Wound in close combat, the enemy unit that inflicted te wound immediately suffers D6 Strength 6 hits.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Ripper Gun" id="1a03-03f1-43e8-2fc2" hidden="false" type="profile" targetId="ed62-0f0f-8a33-44ce" />
        <infoLink name="Frag Grenades" id="6687-8029-9f95-d87a" hidden="false" type="profile" targetId="6e7c-a63e-3bc6-5bc9" />
        <infoLink name="Feel No Pain" id="aff7-798b-5689-9ead" hidden="false" type="profile" targetId="d22d-ca74-1014-8212" />
        <infoLink name="Furious Charge" id="4f38-5d52-6408-2627" hidden="false" type="profile" targetId="8f63-946f-5992-31e0" />
        <infoLink name="Stubborn" id="b088-c889-c87b-9bf4" hidden="false" type="profile" targetId="5493-e844-f447-39ae" />
        <infoLink name="Bulky" id="b777-1282-a044-ae78" hidden="false" type="profile" targetId="1c0a-0c56-c294-9c52" />
      </infoLinks>
      <rules>
        <rule name="Bodyguard" id="39a8-c580-d17f-cf65" hidden="false">
          <description>One Company Command Squad in your army may take Nork Deddog. If a Command Squad includes Nork Deddog it may not take any Bodyguards as Regimental Advisors.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Commander Chenkov" hidden="false" id="d722-9c22-3e4a-02c2">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50" />
      </costs>
      <profiles>
        <profile name="Commander Chenkov" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="5f9c-23df-e5ab-08af">
          <characteristics>
            <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
            <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">4</characteristic>
