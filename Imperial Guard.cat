        <infoLink name="Improved Comms" id="758b-c49c-714f-e6b3" hidden="false" targetId="b71b-97b6-7ac6-b71f" type="rule" />
        <infoLink name="Smoke Launchers" id="6567-64ae-2cd4-1756" hidden="false" targetId="51f3-87b2-5634-c751" type="rule" />
        <infoLink name="Searchlight" id="9c34-8eff-85d7-ddee" hidden="false" targetId="f055-41c4-5db5-4372" type="rule" />
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="My Boys Love It" id="860f-0fb6-25b1-733b" hidden="false">
          <description>Obadiah's tank is converted to varry a loud speaker system. Over this, he broadcasts orders to the rest of the company and loud Varolian martial music to inspire the boys and frighten the enemy (Varolian martial music is very loud, long, and to the untrained ear, quite painful). When Obadiah's tank forces a Tank Shock test on an enemy unit, they must make the test at -1 to their Leadership.</description>
        </rule>
        <rule name="Tank Hunters" id="8db4-8192-8ecc-8884" hidden="false">
          <description>Add +1 to all Armour Penetration rolls</description>
        </rule>
      </rules>
    </selectionEntry>
