    <selectionEntry type="unit" import="true" name="Ministorum Priest" hidden="false" id="7c7c-b2c1-383b-da5e">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" />
      </costs>
      <profiles>
        <profile name="Righteous Fury" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="be9a-0996-258c-a2d4">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">A Priest and his unit re-roll any failed To Hit rolls in close combat on the turn in which they assault. Righteous Fury has no effect on Ogryns or Ratlings.</characteristic>
          </characteristics>
        </profile>
      </profiles>
