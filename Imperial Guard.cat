    <selectionEntry id="7c5f-c897-1ea8-c4d3" name="Tanith Command HQ" hidden="false" collective="false" import="true" type="unit">
      <infoLinks>
        <infoLink id="0827-4f7e-9e14-971a" name="Infiltrators" hidden="false" targetId="b4ea-750c-d9a4-e398" type="rule" />
        <infoLink id="529d-267e-4898-bf70" name="Absolute Direction" hidden="false" targetId="ea86-cee4-a47b-c214" type="rule" />
