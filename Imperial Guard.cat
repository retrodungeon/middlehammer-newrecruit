      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Has Adamantium Will.</characteristic>
      </characteristics>
    </profile>
