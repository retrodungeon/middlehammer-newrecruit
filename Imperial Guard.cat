        </profile>
        <profile name="Loner" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="d9f5-137c-86de-6f9e">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any order issued to this unit will automatically fail.</characteristic>
          </characteristics>
        </profile>
        <profile name="He's Behind You!" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="7895-6286-5c46-b2fd">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Marbo always starts the game in reserve, even in missions that do not normally use this rule. When Marbo becomes available he is placed anywhere on the battlefield that is more than 1" away from an enemy model. Marbo may not move or assault in the turn he arrives, although he can shoot normally.</characteristic>
          </characteristics>
        </profile>
      </profiles>
