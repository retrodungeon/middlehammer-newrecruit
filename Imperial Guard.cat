          <modifiers>
            <modifier type="set" field="name" value="2x Lascannons" />
          </modifiers>
        </infoLink>
        <infoLink id="19f9-8fe5-e6b8-f2b9" name="Autocannon" hidden="false" targetId="6128-e2af-037e-4d1a" type="profile" />
      </infoLinks>
