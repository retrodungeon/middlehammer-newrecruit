    <selectionEntry id="2aa4-9ffa-1f3a-f926" name="Salamander Command Vehicle (IA)" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="5b59-4401-c040-df2f" name="Surveyor" hidden="false">
          <description>If enemy infiltrators set up with 4D6" of a model with a surveyor then the model is allowed to take a 'free' shot at them. If the model is part of a unit, the whole unit may shoot. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
        </rule>
        <rule id="7d60-bc40-8aad-f8b1" name="Improved Comms" hidden="false">
          <description>The Imperial Guard player may re-roll one Reserves roll per turn, and to re-roll the dice when checking to see if an enemy unit or obstacle is hit by a preliminary bombardment</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="ab7f-edcf-b4ad-572c" name="Salamander" hidden="false" targetId="e46b-5e10-d5a2-ee74" type="profile" />
        <infoLink id="5922-b0f8-0e5b-b56b" name="Heavy Flamer" hidden="false" targetId="6d36-2c09-dfc3-f257" type="profile" />
