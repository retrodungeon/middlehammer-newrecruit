    <rule id="7e129f9f-7ace-4d29-45d5-2791e000a4a7-45e2d" name="Artillery Bombardment" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>The Master of Ordnance may make a shooting attack: Infinite Range, S9, AP3, Ordnance 1, Barrage, Large Blast.  If scatter die rolls hit, scatter 2D6" anyway.  scatter 3D6" if an arrow rolls.  Reduce scatter by BS if within LoS.</description>
    </rule>
    <rule id="9867-10ad-3c79-85d9-45e2d" name="Artillery Command" page="158" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>The Company Commander from this Formation can issue the 'Smite at Will!', 'Suppressive Fire!' and 'Fire on my Target!' orders to units of vehicles from this Formation. Units of vehicles from this Formation count as having a Leadership characteristic of 8 for the purposes of seeing whether the order has been understood.</description>
    </rule>
    <rule id="49db581d-f4cf-5484-7557-33cb73cdeba6-45e2d" name="Artillery Tractor" page="75" hidden="false">
