      </costs>
      <profiles>
        <profile name="Guardsman Marbo" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="6335-0fc7-f16e-9b83">
          <characteristics>
            <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">5</characteristic>
            <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">5</characteristic>
