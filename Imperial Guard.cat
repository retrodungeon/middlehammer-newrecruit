    <selectionEntry type="unit" import="true" name="Valkyrie Assault Carrier Squadron" hidden="false" id="1156-d40c-0610-c2e6" collective="false">
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Valkyrie" hidden="false" id="751b-3908-9932-ac1d" collective="false">
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="100" />
          </costs>
          <profiles>
            <profile name="Transport" typeId="9a37-e4d2-11fe-9e81" typeName="Transport" hidden="false" id="b2ae-7415-f753-8786">
              <characteristics>
                <characteristic name="Capacity" typeId="7cdf-4c80-a83d-200c">12</characteristic>
                <characteristic name="Access Points" typeId="6e42-3bd5-70a6-724f">One on each side of the hull and one at the rear.</characteristic>
                <characteristic typeId="aa94-ae0c-98e7-5923" name="Fire Points" />
              </characteristics>
            </profile>
            <profile name="Grav Chute Insertion" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="5155-531f-eee0-cba0">
              <characteristics>
                <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a Valkyrie or Vendetta moved flat out, passengers may still disembark, but they must do so as follows. Nominate any point over which the Valkyrie or Vendetta moved over and deploy the squad as if it were deep striking onto that point. If the unit scatters, every model must immediately take a dangerous terrain test. If any of the models cannot be deployed, the unit is destroyed as described in the 1-2 result on the Deep Strike Mishap table.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink targetId="1b9a-dab7-7eaf-d2de" id="9141-95de-bafd-5594" type="profile" name="Valkyrie" hidden="false" />
