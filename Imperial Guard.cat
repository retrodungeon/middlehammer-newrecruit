        <profile name="Gung-ho" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="b3e8-6af1-b293-da07">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Colonel Straken has the Fearless universal special rule, as does his Command Squad</characteristic>
          </characteristics>
        </profile>
        <profile name="Cold Steel and Courage" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="521e-7542-6c87-ed06">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Friendly units within 12" of Straken have the Counter-attack and Furious Charge universal special rules. This includes Colonel Straken and his Command Squad.</characteristic>
          </characteristics>
        </profile>
        <profile name="Man of Adamantium" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="1593-4723-73be-4f03">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Straken's close combat attacks ignore armour saves and roll and additional D6 for armour penetration.</characteristic>
          </characteristics>
        </profile>
      </profiles>
