    <profile name="Guardsman" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="b2de-546d-01f6-63e5">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">3</characteristic>
