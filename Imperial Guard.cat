        <profile name="Two hot-shot laspistols" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="c4d4-5569-3a9b-3c8d">
          <characteristics>
            <characteristic name="Range" typeId="9b9e-0c24-e409-a801">6"</characteristic>
            <characteristic name="Str." typeId="1ebc-896c-43de-904a">3</characteristic>
            <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">3</characteristic>
