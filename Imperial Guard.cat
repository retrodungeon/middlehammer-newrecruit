    <rule id="30ba-9d4a-0253-e5c4-45e2d" name="Battle Group Vox-net" page="168" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>When an officer from this Detachment issues an order to a unit from this Detachment, roll an additional dice for the Leadership test and discard the highest roll.</description>
    </rule>
    <rule id="d2cb-04d9-b969-d8f5-45e2d" name="Battlefield Doctrines" page="159" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>If a vehicle from this Formation that is within 6" of an Enginseer from this Formation suffers a penetrating hit, your opponent must roll two dice on the Vehicle Damage table and discard the highest.</description>
    </rule>
    <rule id="0a090012-f12d-cd74-02ba-be2bf569ed79-45e2d" name="Behind Enemy Lines" page="46" hidden="false">
