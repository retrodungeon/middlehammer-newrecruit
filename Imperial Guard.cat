    <selectionEntry id="c596-2da2-eaae-4936" name="Nork Deddog" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="fcfc-fdcd-e8f3-cd4d" name="Very Loyal" hidden="false">
          <description>So long as the commander is alive, Nork must remain within 2" of him if at all possible.</description>
        </rule>
        <rule id="d051-cbe5-8432-ccee" name="Bodyguard" hidden="false">
          <description>If Nork is within 2" of the commander he may choose to take any shooting hit on that commander instead. Additionally, in close combat, after models have moved but before combats are resolved, Nork and his commander may swap places if they are within 2" of each other.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="296c-8169-bfe5-9165" name="Nork Deddog" hidden="false" targetId="6701-6289-32e6-901d" type="profile" />
        <infoLink id="c895-43f8-e22a-1033" name="Ripper Gun" hidden="false" targetId="3d57-a43d-1066-0f5d" type="profile" />
        <infoLink id="ffff-13ae-ef6f-daee" name="Frag Grenades" hidden="false" targetId="9dd4-e950-2419-5934" type="profile" />
        <infoLink id="c89f-09ea-941a-ef28" name="Carapace Armor" hidden="false" targetId="f1bf-49f9-4094-c2f9" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="55" />
      </costs>
    </selectionEntry>
