            <modifier type="set" field="name" value="Two Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
        <infoLink id="d2ea-5e9c-44b3-a24a" name="Heavy Flamer" hidden="false" targetId="6d36-2c09-dfc3-f257" type="profile">
          <modifiers>
