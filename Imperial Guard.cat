        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1</characteristic>
      </characteristics>
    </profile>
    <profile id="8caeed8c-2735-7a51-e69c-4b05176d47a6-ebe4f" name="Flamestorm Cannon" page="21" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Template</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1</characteristic>
      </characteristics>
    </profile>
    <profile id="8b60fc27-ff30-70ab-a1ad-2a50855c9938-ebe4f" name="Flare or Chaff Launcher" page="6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Single use. If used during the opposing player's Shooting phase, they grant the equipped vehicle a 4+ Invul Sv against all weapons with the Missile type or with the word 'Missile' in their name. The use of flare or chaff launchers in an opponent's Shooting phase must be declared after the opposing player has made a To Hit roll, but before any Armour Penetration rolls are made. Flare or chaff launchers may also be used during the Dogfight phase. They are only used during the Attack sub-phase and only if the equipped vehicle has already declared it will Jink. When used in the Dogfight phase, they increase the equipped vehicle's Jink save by one step and make that save an Invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile id="2606862c-04f8-43b0-9f29-f20b58fa508e-ebe4f" name="Frag Assault Launchers" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit charging into close combat, on the same turn it disembarks from a vehicle equipped with this upgrade, counts as being equipped with frag grenades.</characteristic>
      </characteristics>
    </profile>
    <profile id="6504b864-90fa-59cc-1102-95134a06a894-ebe4f" name="Frag Grenades" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">8"</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">3</characteristic>
