        <infoLink name="Bolt Pistol" id="b117-e25e-8bca-c7d3" hidden="false" targetId="e9ac-c779-51bb-3c9a" type="profile" />
        <infoLink name="Camo-Cloak" id="3f5c-0164-685f-635c" hidden="false" targetId="5146-a032-a0dc-383e" type="rule" />
        <infoLink name="It's For Your Own Good!" id="ab5e-47a7-7a65-97a2" hidden="false" targetId="dc4b-c001-e685-417b" type="rule" />
        <infoLink name="Fearless" id="a79f-c1ae-4b3b-ed29" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
        <infoLink name="Independent Character" id="ae6b-a765-b5e2-defb" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Front-liner" id="6af9-50fe-a77f-377f" hidden="false">
          <description>If there is an assault occurring within 12" of Gaunt at the start of the Imperial Guard player's turn and he is not in combat, he must immediately move towards the nearest combat in his Movement phase and assault the enemy models in that combat if at all possible. However, when Gaunt charges into an assault, all Tanith Imperial Guard models in that combat benefit from +1A for that round only (including Gaunt).</description>
        </rule>
        <rule name="Leader" id="fb54-7d6d-5f2f-d08f" hidden="false">
          <description>Any Imperial Guard squad within 12" of Gaunt may use his Leadership value for all Morale and Pinning tests.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Colonel Schaffer's Last Chancers" id="716e-a8f1-ad1c-56d1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HQ" id="0a61-c8a7-ebb8-d6f8" hidden="false" primary="true" targetId="ac8d-efba-1884-d3ad" />
        <categoryLink name="Infantry" id="82ac-90a4-3486-39c9" hidden="false" primary="false" targetId="6953-6bba-0bb9-d49d" />
