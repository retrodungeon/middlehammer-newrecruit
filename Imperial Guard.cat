          </costs>
        </selectionEntry>
        <selectionEntry id="9e6a-1336-ed1c-c575" name="Chief Medical Officer Dorden" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e3c6-b4fc-e96b-93d2" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="71eb-fc8d-3c85-1fae" type="min" />
          </constraints>
          <rules>
            <rule id="6b7d-0f9c-052c-e0d4" name="Expert Medic" hidden="false">
              <description>Dorden allows his unit to ignore both the first and second failed armor saving throw each turn. He may not use this ability if he is in base-to-base contact with any enemy models.</description>
            </rule>
            <rule id="ba81-721a-20bf-17bc" name="Oath" hidden="false">
              <description>Dorden may not ever fire his laspistol in the Shooting phase, but may use it as a weapon in the Assault phase.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="91ed-e0c7-c507-8bc8" name="Dordon" hidden="false" targetId="c01a-35bb-9d90-33e4" type="profile" />
            <infoLink id="25a6-7887-3050-c6c8" name="Laspistol" hidden="false" targetId="95a9-d270-d218-1772" type="profile" />
            <infoLink id="5414-5814-2300-1ba0" name="Close Combat Weapon" hidden="false" targetId="46d5-85f2-d932-f0a2" type="profile" />
            <infoLink id="9f62-fe63-6f35-8f7e" name="Frag Grenades" hidden="false" targetId="9dd4-e950-2419-5934" type="profile" />
            <infoLink id="e22e-3b00-e3b2-24c9" name="Camo Cloak" hidden="false" targetId="647d-f731-5d52-f8e4" type="rule" />
            <infoLink id="d054-c0f6-5136-f7e6" name="Medi-pack" hidden="false" targetId="16d3-73ab-2527-3e33" type="rule" />
            <infoLink id="fb91-73ec-1640-56da" name="Tanith Knife" hidden="false" targetId="36d3-c20f-b78f-7bf9" type="rule" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="18" />
