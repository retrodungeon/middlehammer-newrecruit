    <rule id="15c94625-405c-6b67-5cdb-0fdceae5c11b-45e2d" name="Blessings of the Omnissiah" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Instead of shooting, may repair a friendly vehicle embarked or in base contact.  Need 5+, adding +1 for each Servitor with servo-arm in unit. Success restores hull point, or repairs destroyed weapon, or repairs Immobilised.</description>
    </rule>
    <rule id="2c8f402b-390f-51d2-56de-0ece624f7228-45e2d" name="Blind" page="159" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Hit units test Initiative at end of phase. Failure reduces Weapon and Ballistic skills to 1 until end of next turn.  Units cannot blind themselves nor anything without Initiative.</description>
    </rule>
    <rule id="28229793-5a76-65af-2656-afba3c979585-45e2d" name="Born in the Saddle" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>All Rough Rider units within 12" of the Rough Rider Command Squad have the Skilled Rider rule.</description>
    </rule>
    <rule id="5c2de08f-f776-f604-3ef8-7bf32346626b-45e2d" name="Broad Spectrum Camouflage" page="55" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
    </rule>
    <rule id="d2c5a26e-bba9-1699-76e4-0bea6bcdaeb6-45e2d" name="Brotherhood of Psykers" page="159" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Model's unit is Psyker with Mastery Level 1. Manifest from any one model with rule. Hits from Perils or anty-Psyker weapons are randomly allocated.</description>
    </rule>
    <rule id="32b0b507-82e7-5304-1a9c-b69fb2f5ae98-45e2d" name="Bulky" page="159" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Occupies double Transport Capacity</description>
    </rule>
    <rule id="d5dcc13b-10ee-d6ca-e6ef-6b324bdb737e-45e2d" name="Camouflage" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
    </rule>
