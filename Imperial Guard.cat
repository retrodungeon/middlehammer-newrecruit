    <profile id="b532d8d0-e89f-9c89-4023-4eb83747a2cf-6122e" name="Leman Russ Punisher" page="21" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
