      </costs>
      <modifiers>
        </modifiers>
    </selectionEntry>
  <selectionEntry id="a4d7-56cb-bf76-4ef6" name="Sly Marbo" hidden="false" collective="false" import="true" type="model">
      <profiles>
        <profile id="52e3-bb06-5689-86d7" name="Ripper Pistol" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">12'</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">X</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">6</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Pistol</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Re-roll failed rolls to wound</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="342c-70b4-c4bc-856f" name="May Move" hidden="false">
          <description>Unlike other Snipers, Sly may move after he has been revealed. You may removed him in your movement phase as if he was a normal Sniper, but write down new coordinates for a square adjacent to the one he disappeared from. He may reappear there using the Ambush rules from the start of his next turn.</description>
        </rule>
        <rule id="8f83-e0f0-15a9-df85" name="Envenomed Blade" hidden="false">
          <description>Sly's knife is treated as a power weapon and the toxins on it allow Sly to re-roll any failed rolls to wound in close combat.</description>
        </rule>
        <rule id="2227-bae0-ca6b-4d86" name="Always Operates Alone" hidden="false">
          <description>Sly is an independent character and may not join another unit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="afc7-977a-c1d4-a012" name="Sly Marbo" hidden="false" targetId="85b0-84d8-0f08-a2d7" type="profile" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="135" />
      </costs>
    </selectionEntry>
    <selectionEntry id="eb4c-ad79-916c-8155" name="Colonel Iron Hand Straken" hidden="false" collective="false" import="true" type="model">
      <rules>
        <rule id="8ef6-6b2d-a5c7-ef83" name="Unique Bionics" hidden="false">
          <description>Straken's arm mimics the effect of a power fist, but devices in the chest allow him to strike using his initiative value instead of going last. In addition he counts as having bionics. If Straken ever makes his special bionics saving roll, then it is assumed his bionic arm has been disabled and he can no longer use it.</description>
        </rule>
        <rule id="19be-3ee9-f418-b3bc" name="Gung Ho" hidden="false">
          <description>Straken, the unit he is with and any friendly units with a model within 6" of him may re-roll failed Morale &amp; Pinning tests. In addition, they may always attempt to regroup.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f069-948b-47a8-57f4" name="Straken" hidden="false" targetId="a095-74b7-64a2-04bc" type="profile" />
        <infoLink id="aa89-05a3-26db-24c7" name="Shotgun" hidden="false" targetId="9882-0cca-b1d2-8e0b" type="profile" />
        <infoLink id="5421-665a-1439-b6d5" name="Plasma Pistol" hidden="false" targetId="7b91-b670-d042-7c88" type="profile" />
        <infoLink id="dd8e-b6cf-7690-d0c6" name="Power Fist" hidden="false" targetId="a161-ed4b-bcb7-0a01" type="profile" />
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="130" />
      </costs>
    </selectionEntry>
