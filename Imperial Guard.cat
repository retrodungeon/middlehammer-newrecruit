      </entryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="70" />
      </costs>
    </selectionEntry>
    <selectionEntry id="2418-a403-e4cb-b865" name="Rough Rider Squad" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="9e88-47d6-7c42-1561" name="Trot" hidden="false">
          <description>Rough Rider units may choose to trot during the movement phase. If they do they may move up to 9" in the movement phase. But they may only charge 9" in that turns assault phase and may only shoot pistols and may not enter or cross difficult terrain.</description>
        </rule>
      </rules>
