    <selectionEntry name="Deathstrike (Homebrew)" id="ed4a-1c1c-add9-add6" collective="false" hidden="true" import="true" type="unit">
      <comment>Armor:12-10-10=10+10+10=30
Fully Armoured Upcharge for &lt; 43 armour = 20
Normal Speed = 10
Heavy Bolter=15</comment>
      <categoryLinks>
        <categoryLink name="Heavy Support" id="c48c-6aa7-2747-61a6" hidden="false" primary="true" targetId="9260-7d57-be5c-bd52" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="135" />
      </costs>
      <infoLinks>
        <infoLink name="Deathstrike" id="4e84-2dfb-ce99-f2b9" hidden="false" targetId="f94b-cd00-5041-58ce" type="profile" />
        <infoLink name="Heavy Bolter" id="5b52-4d93-9aba-a423" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile" />
      </infoLinks>
      <modifiers>
        </modifiers>
      <profiles>
        <profile name="Deathstrike Missile" id="8a0f-4f1f-bdf4-1fd1" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">G24"-960"</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">10</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Heavy 1, Ordnance</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">One Shot Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Deathstrike Missile" id="c0d5-84f7-a786-cdd1" hidden="false">
          <description>Once the final position of the missile has been determined, mark the impact location with a counter. Roll D3+3" to determine the blast radius. All models fully or partially in range of the blast are hit. Note that its full strength 10 is used for armour penetration regardless of the vehicle's position.</description>
        </rule>
        <rule name="Ignore Cover" id="ef61-2c08-727d-0a3c" hidden="false">
          <description>Cover saves may not be taken against hits caused by a Deathstrike missile.</description>
        </rule>
        <rule name="Five minutes to launch..." id="ddaf-764e-60a2-46ca" hidden="false">
          <description>A deathstrike missile may not be fired on the first turn of the game or if the vehicle has moved that turn. When firing, roll a dice and apply the following modifiers:
+1 for each full turn
-1 for each weapon destroyed
-1 if crew shaken/stunned

On a roll of 6 or more, the Deathstrike Missile can be fired. A natural roll of 6 will always result in the missile being launched, regardless of negative modifiers.</description>
        </rule>
        <rule name="Assured Destruction" id="f752-ccde-dde6-dc28" hidden="false">
          <description>The Deathstrike Missile cannot be destroyed by a weapon destroyed result, only delayed. A crew shaken or stunned result does not prevent the missile from being fired.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Rogal Dorn Battle Tank (Homebrew)" id="6c7f-0481-5c89-073c" hidden="true" import="true" type="unit">
      <comment>Rogal Dorm Battle Tank
- Normal Tank
- 14-14-13 (30+80+40 = 150pts)
- Lumbering (10pts)</comment>
