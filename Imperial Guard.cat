        <profile name="Desert Raider" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="4ffc-2899-1482-e18e">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Al'rahem can issue up to two orders each turn. He has a command radius of 12". Al'rahem can use the Bring it Down!, First Rank, FIRE! Second Rank, FIRE! and Like the Wind! orders.</characteristic>
          </characteristics>
        </profile>
        <profile name="Claw of the Desert Tigers" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="e6b3-f798-f04d-3c3a">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The Claw of the Desert Tigers is a power weapon that inflicts instant death, regardless of the victim's Toughness.</characteristic>
          </characteristics>
        </profile>
      </profiles>
