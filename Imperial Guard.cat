      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Count Crew Stunned results as Crew Shaken instead.</characteristic>
      </characteristics>
    </profile>
    <profile id="c4cef05c-de45-0078-ff77-d2b887f48dc3-0f066" name="Fire Barrels" page="71" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
