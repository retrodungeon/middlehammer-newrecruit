        <infoLink name="Twin-Linked" id="4101-8ed8-a848-593f" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
        <infoLink name="Baneblade" id="cc13-f787-a7af-a043" hidden="false" targetId="4321-e143-0b27-abd0" type="profile" />
        <infoLink name="Baneblade Battle Cannon" id="b634-5b9b-c3c2-7b34" hidden="false" targetId="85dd-b3a9-328b-96d5" type="profile" />
        <infoLink name="Demolisher" id="1590-8ee4-14bb-5813" hidden="false" targetId="720f-5c52-b5ff-ee75" type="profile" />
        <infoLink name="Lascannon" id="fc6b-770f-af65-dc52" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="2x Lascannons" />
          </modifiers>
        </infoLink>
        <infoLink name="Autocannon" id="3b85-41d5-71cb-a0ac" hidden="false" targetId="6128-e2af-037e-4d1a" type="profile" />
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Difficult Terrain" id="8977-4122-70ad-063e" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="80e8-fba9-910e-c4e6" hidden="false">
          <description>The stormsword can move up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Ordnance" id="aa27-f9bd-e5dc-18a7" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Targeting" id="ac0c-492f-d963-3c21" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons. The co-axial autocannon must fire at the same target as the Baneblade Battle Cannon</description>
        </rule>
      </rules>
    </selectionEntry>
