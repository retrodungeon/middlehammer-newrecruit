    <profile id="0edf1da7-620d-16dc-37ab-a1009b402ee7-ae8da" name="Icon of Righteous Spite" page="177" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
