      <modifiers>
        </modifiers>
      <rules>
        <rule id="7fa1-2a93-866a-936c" name="Towing Vehicle" hidden="false">
          <description>The Trojan may move an Earthshaker, Hydra, or Manticore platform fitted with carriages that is limbered to the Trojan. Limbering and unlimbering a platform takes an entire turn each, and neither the Trojan or platform may fire weapons or move during that turn.</description>
        </rule>
      </rules>
