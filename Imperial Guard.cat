    <selectionEntry id="c677-3d14-02e9-21d2" name="Tarantula Sentry Gun (IA)" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="224e-fabb-3ad3-dbb8" name="Firing Modes" hidden="false">
          <description>At deployment, you must select a firing mode. It cannot be changed once the game begins.

Point Defence Mode: Choose a fixed 90 degree arc. The gun will engage enemy targets up to 24" away within the arc.

Sentry Mode: The gun will fire at the nearest enemy target within 12" that it can see.</description>
        </rule>
        <rule id="811f-51a7-c784-f56b" name="Targeting Priority" hidden="false">
          <description>A heavy bolter Sentry gun will fire at the nearest non-vehicle unit it can hit. A lascannon Sentry gun will fire at the closest enemy vehicle it can hit. If no preferred target can be hit they will shoot at non-preferred targets.</description>
        </rule>
        <rule id="61c8-7bf5-2a8a-9d15" name="Damage" hidden="false">
          <description>A Tarantula is destroyed by any glancing or penetrating hit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="43b7-cd56-fb10-41e1" name="Immobile" hidden="false" targetId="468c-bd45-5505-589a" type="rule" />
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="5419-3f2c-93b9-1a3d" name="Sentry Gun" hidden="false" collective="false" import="true" type="upgrade">
