          </constraints>
          <rules>
            <rule id="9ae1-2e26-408b-b289" name="All Guns Blazing" hidden="false">
              <description>While riding in his Chimera, Stranski may fire both his plasma pistols from the hatch. He can fire these in addition to any other weapons the Chimera is firing and he can fire them regardless of how far the Chimera travelled.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="8681-6f20-ee4c-e455" name="Colonel" hidden="false" targetId="6cd0-8cde-3bf9-8d07" type="profile">
              <modifiers>
                <modifier type="set" field="name" value="Colonel 'Snake' Stranski" />
              </modifiers>
            </infoLink>
            <infoLink id="3915-18d3-ad91-5071" name="Plasma Pistol" hidden="false" targetId="7b91-b670-d042-7c88" type="profile">
              <modifiers>
                <modifier type="set" field="name" value="Twin-Linked Plasma Pistol" />
              </modifiers>
            </infoLink>
            <infoLink id="55fe-392f-f7aa-22ca" name="Twin-Linked" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
            <infoLink id="4f4b-4034-4e7b-191b" name="Trademark Item" hidden="false" targetId="0630-f0bd-6da5-e593" type="rule" />
            <infoLink id="87ec-04dd-4e54-792b" name="Frag Grenades" hidden="false" targetId="9dd4-e950-2419-5934" type="profile" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="263" />
      </costs>
    </selectionEntry>
    <selectionEntry id="7f91-71cf-ff50-c98b" name="Maximillian Weisemann (IA)" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="0c3b-9478-0d3e-6185" name="Hardened Crew" hidden="false">
          <description>The vehicle treats all 'Driver Stunned' results on the damage tables as 'Crew Shaken' instead.</description>
        </rule>
        <rule id="bcbd-5c95-aba2-a3fd" name="Skilled Gunnery" hidden="false">
          <description>Nominate a single weapon at the start of the shooting phase. You may re-roll any misses to-hit rolls with that weapon this turn. For ordnance, this allows you to re-roll the scatter dice.</description>
        </rule>
        <rule id="0d2c-85c6-a6eb-fbc9" name="Tank Shock" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
        <rule id="9998-7380-82ff-bd8f" name="Ordnance" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="6e84-3943-9c33-e66d" name="Lumbering Vehicle" hidden="false">
          <description>Moves up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="41b9-da1a-e0ff-8f20" name="Difficult Terrain" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule id="4e5d-5b1f-9081-83bf" name="Targetting" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="56ac-a275-5af7-4733" name="Baneblade" hidden="false" targetId="6533-238a-6e25-f216" type="profile">
          <modifiers>
            <modifier type="set" field="de63-2aba-c18c-6d47" value="4" />
            <modifier type="set" field="name" value="212 Arethusa" />
          </modifiers>
        </infoLink>
        <infoLink id="f96a-907a-c763-ab65" name="Twin-Linked" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
        <infoLink id="7bb7-a11b-a908-8aee" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="3x Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
        <infoLink id="a722-1870-0824-c213" name="Lascannon" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="2x Twin-Linked Lascannons" />
          </modifiers>
        </infoLink>
        <infoLink id="d276-0543-401b-622b" name="Demolisher" hidden="false" targetId="720f-5c52-b5ff-ee75" type="profile" />
        <infoLink id="6771-8f66-51c0-17dc" name="Baneblade Battle Cannon" hidden="false" targetId="85dd-b3a9-328b-96d5" type="profile" />
        <infoLink id="ab44-3b85-df91-a083" name="Autocannon" hidden="false" targetId="6128-e2af-037e-4d1a" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="Co-axial Autocannon" />
          </modifiers>
        </infoLink>
        <infoLink id="90fa-4461-dae4-f192" name="Searchlight" hidden="false" targetId="4877-41b8-d9e1-6da3" type="rule" />
        <infoLink id="6689-6e83-3981-cc4f" name="Smoke Launchers" hidden="false" targetId="8573-0653-d612-e4de" type="rule" />
        <infoLink id="1d2d-f195-c21d-04dd" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="Pintle-Mounted Heavy Bolter" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="761" />
      </costs>
    </selectionEntry>
    <selectionEntry id="05a8-f26f-828b-b9ec" name="Stormsword (IA)" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="b9cf-6452-5c74-20cc" name="Targetting" hidden="false">
          <description>Instead of picking one target for the Stormsword, pick a target for each of its weapons. The co-axial heavy bolter must fire at the same target as the Siege Cannon.</description>
        </rule>
        <rule id="e4b5-42cb-b996-38f8" name="Ordnance" hidden="false">
          <description>The stormsword may fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule id="7eb3-bf83-9bbd-5f1b" name="Lumbering Vehicle" hidden="false">
          <description>The stormsword can move up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="d0d8-ac21-0a8e-24f3" name="Difficult Terrain" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="ce64-306e-cb71-6009" name="Stormsword" hidden="false" targetId="4650-2e47-08cf-dbec" type="profile" />
        <infoLink id="a9ba-86c5-f53b-e819" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
