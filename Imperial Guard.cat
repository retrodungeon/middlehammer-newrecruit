    <rule id="7e8a1d81-6c13-e9f7-639d-f244743d51e8-45e2d" name="Awaken the Machine" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>May give a single friendly Astra Militarium vehicle within 12" Power of the Machine Spirit until end of turn.</description>
    </rule>
