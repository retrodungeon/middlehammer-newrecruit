        <selectionEntry id="489c-245d-eb1c-6e2b" name="Rough Terrain Modification" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bb16-f01c-0c2c-4ac3" type="instanceOf" />
