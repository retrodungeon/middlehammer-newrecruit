    <rule id="9c49a9ac-b424-8a55-e98d-025bdd01c169-45e2d" name="Cavalry" page="67" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Can move 12" and treats difficult terrain as dangerous instead.  Falls back 3D6". Also has Fleet and Hammer of Wrath.</description>
    </rule>
    <rule id="9e8aba5a-82c9-d51c-4be3-ed88779b7114-45e2d" name="Chain of Command" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>May only be Warlord if no other Senior Officers.</description>
    </rule>
    <rule id="37b87a40-ea3b-1668-9f82-f5c017f1fccf-45e2d" name="Clarion Vox-net" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Friendly units within 18" may use this model's Leadership for Pinning, Morale, and Fear.</description>
    </rule>
    <rule id="78f1-65d7-84d0-d8c4-45e2d" name="Clear the Area" page="157" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Units from an Assault Company have the Preferred Enemy special rule against enemy units within 6" of an Objective Marker.</description>
    </rule>
    <rule id="65b9-2404-35f6-42d1-45e2d" name="Close-ranged Fire Support" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>All weapons fired by Battlegroup Hammerblow's Baneblade and Leman Russ Squadron have the twin-linked special rule so long as the target is within 12" of another unit from this formation. </description>
    </rule>
