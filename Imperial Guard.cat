            <infoLink id="1cae-2786-6584-4153" name="Melta Bombs" hidden="false" targetId="87d0-8c40-7bcb-8cbb" type="profile" />
            <infoLink id="97c4-941a-c080-02c2" name="Corbec" hidden="false" targetId="5d20-f9c5-0d47-27bf" type="profile" />
          </infoLinks>
