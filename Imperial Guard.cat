      </entryLinks>
      <infoLinks>
        <infoLink name="Priest" id="28be-156a-1a26-2618" hidden="false" targetId="b7fa-4aca-4193-886d" type="profile" />
        <infoLink name="Close Combat Weapon" id="0c94-f464-e42c-c7c4" hidden="false" targetId="46d5-85f2-d932-f0a2" type="profile" />
        <infoLink name="Advisor" id="b0bd-f512-681a-c248" hidden="false" targetId="4ac0-5e0f-ed0b-1910" type="rule" />
      </infoLinks>
      <modifiers>
        <modifier field="19e6-fb33-4b84-6249" type="set" value="0">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="b855-cc69-a67d-4db7" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1" />
                <condition childId="c8cd-3b3a-8431-f6e9" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1" />
                <condition childId="c329-7e5f-f2ff-302d" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1" />
                <condition childId="0089-0280-21c7-a810" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1" />
                <condition childId="6cd4-fe92-4bbc-e9fa" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="notEqualTo" value="1" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Fanatical" id="17ec-bf7b-4419-7646" hidden="false">
          <description>A Priest and the unit he is assigned to may re-roll any failed to hit rolls once in the turn they charge while the Priest lives.</description>
        </rule>
        <rule name="Righteous Fury" id="b09d-9132-2ca1-b17c" hidden="false">
          <description>A unit including a Priest must charge in the Assault phase if there is an enemy in reach. In addition, such is the state of agitation that they always count as moving even if the models are stationary, so would be unable to fire heavy weapons.</description>
        </rule>
      </rules>
    </selectionEntry>
