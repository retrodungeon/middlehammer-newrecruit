        <profile name="Nork Deddog" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="fa7f-9f1f-8018-bb67">
          <characteristics>
            <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
            <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">3</characteristic>
