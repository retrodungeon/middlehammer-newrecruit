        <infoLink name="Shadowsword" id="8b79-b7e8-a6aa-11ec" hidden="false" targetId="869a-cdbc-90fa-8e32" type="profile" />
        <infoLink name="Volcano Cannon" id="2fa1-e294-fe44-4efd" hidden="false" targetId="7e64-0b48-b422-af0e" type="profile" />
        <infoLink name="Titan Killer" id="cf25-79aa-a289-25fd" hidden="false" targetId="b333-4165-9b69-fc6a" type="rule" />
        <infoLink name="Twin-Linked" id="d4a7-e736-c746-66b0" hidden="false" targetId="ebe5-6318-0fba-b84c" type="rule" />
        <infoLink name="Heavy Bolter" id="28a1-a8bb-f426-8f12" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Two Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Targeting" id="38cd-0dd4-eb2a-e57c" hidden="false">
          <description>Instead of picking one target, pick a target for each weapons.</description>
        </rule>
        <rule name="Ordnance" id="988a-a04a-ee22-9279" hidden="false">
          <description>May fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Difficult Terrain" id="3a84-d9dc-c5f4-376a" hidden="false">
          <description>Ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="2a39-5cea-f3c2-b1f7" hidden="false">
          <description>Moves up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Tank Shock" id="dd76-a01f-3105-7c2f" hidden="false">
          <description>Enemy infantry must test at -1 Leadership if they are Tank Shocked.</description>
        </rule>
      </rules>
    </selectionEntry>
