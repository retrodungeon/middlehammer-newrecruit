    <selectionEntry id="349f-c266-b9c8-7678" name="Griffon" hidden="false" collective="false" import="true" type="unit">
      <infoLinks>
        <infoLink id="dad1-9890-9b26-331e" name="Griffon" hidden="false" targetId="1b3f-5c1c-065a-6248" type="profile" />
        <infoLink id="22ea-1505-ee92-bfde" name="Griffon Mortar" hidden="false" targetId="ebcc-b45a-6232-fc77" type="profile" />
        <infoLink id="9e5b-9579-3440-34d8" name="Open-Topped" hidden="false" targetId="4795-fd7c-2846-78ba" type="rule" />
        <infoLink id="88c7-666e-1921-11fa" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile" />
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="6089-1491-11c8-1be3" name="Siege Shells" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3789-34f8-5c92-799d" type="max" />
          </constraints>
          <rules>
            <rule id="3a03-7163-fcfc-76a5" name="Siege Shells" hidden="false">
              <description>Choose to fire a siege round instead of a normal round. These rounds use the small Blast template, but roll 2D6+5 when rolling for Armour Penetration against bunkers and buildings instead of the normal 2D6 choose the highest. Siege shells affect models inside buildings on a 4+ instead of a 6.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="75" />
      </costs>
      <entryLinks>
        <entryLink import="true" name="Vehicle Upgrades" hidden="false" id="ce68-a1b8-9a5f-9611" type="selectionEntryGroup" targetId="c0af-40a7-0f54-9847" />
      </entryLinks>
    </selectionEntry>
    <selectionEntry id="7fe1-28b7-b695-d844" name="Lord Commander Solar Macharius" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3c92-9336-0a7c-1f9c" type="max" />
      </constraints>
      <rules>
        <rule id="191a-83f8-bf50-b296" name="Helm of Macharius" hidden="false">
          <description>Macharius has a 3+ invulnerable save.</description>
        </rule>
        <rule id="dd61-3899-d803-3413" name="Command Presence" hidden="false">
          <description>Any Imperial Guard unit within 12" of Macharius takes Morale and Pinning checks using his Leadership of 10</description>
        </rule>
        <rule id="7138-1cd1-de6f-1b0e" name="Ferocious Charge" hidden="false">
          <description>Macharius adds D3 attacks when he charges, instead of the normal +1.</description>
        </rule>
        <rule id="9200-768f-4d17-d36a" name="Old War Wounds" hidden="false">
          <description>Macharius's WS and A characteristics are determined randomly at the start of the battle.</description>
        </rule>
        <rule id="35ef-a5ed-22d7-fd20" name="Master Strategist" hidden="false">
          <description>An army including Macharius may choose to go first in any mission where this is normally decided randomly.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="163b-befa-459b-d142" name="Macharius" hidden="false" targetId="e07c-426c-a0e5-c4b9" type="profile" />
        <infoLink id="f39d-7a38-34f9-b348" name="Trademark Item" hidden="false" targetId="0630-f0bd-6da5-e593" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Crimson Cloak" />
          </modifiers>
        </infoLink>
        <infoLink id="a588-fc92-da5c-4667" name="Bolt Pistol" hidden="false" targetId="e9ac-c779-51bb-3c9a" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="Master-crafted Bolt Pistol" />
          </modifiers>
        </infoLink>
        <infoLink id="1301-2b88-61e8-4d4d" name="Power Weapon" hidden="false" targetId="5774-7187-2616-dd8a" type="profile">
          <modifiers>
            <modifier type="set" field="name" value="Master-crafted Power Weapon" />
          </modifiers>
        </infoLink>
