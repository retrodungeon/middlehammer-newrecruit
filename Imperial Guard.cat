              </characteristics>
            </profile>
            <profile name="Servo-arm" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="16e4-5969-6f0d-ab02">
              <characteristics>
                <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A servo-arm grants a model and additional close combat attack that strikes at Initiative 1, Strength 8 and ignores armour saves.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Two Servitors may replace their Servo-arm with" id="1985-b47c-a388-01c7" hidden="false" collective="true">
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Heavy Bolter" hidden="false" id="bdbc-bdfa-fcd0-a7c7">
                  <costs>
                    <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" />
                  </costs>
                  <infoLinks>
                    <infoLink name="Heavy Bolter" id="5466-04b6-399d-dcdd" hidden="false" type="profile" targetId="a9ff-3d1e-c9e1-c169" />
