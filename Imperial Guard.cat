      <selectionEntries>
        <selectionEntry id="afb3-fb25-eea1-cee6" name="Indirect Fire" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cb6f-6863-7eeb-23e6" type="max" />
          </constraints>
          <rules>
            <rule id="af42-28ee-5fcd-1215" name="Indirect Fire" hidden="false">
              <description>May fire the earthshaker in Indirect File mode instead of direct fire. A weapon that does so changes its range to G36"-240".</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" />
