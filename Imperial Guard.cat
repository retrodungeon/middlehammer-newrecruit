          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="any" field="6f18-a8fc-2c5b-9517" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="lessThan" value="1500" />
