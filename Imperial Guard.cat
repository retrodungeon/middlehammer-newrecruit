          <selectionEntries>
            <selectionEntry id="70c6-f71d-0dc9-9255" name="Atlas Recovery Vehicle (IA)" hidden="false" collective="false" import="true" type="unit">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2b21-cdaa-ed72-0323" type="max" />
              </constraints>
              <rules>
                <rule id="6e79-e206-fada-c71c" name="Recovery Vehicle" hidden="false">
                  <description>The Atlast can drag any destroyed or immobilised vehicle (friend or foe) that starts the turn in contact with it. Both vehicles may move up to D6" and must remain in base contact at the end of the move. Neither vehicle may shoot in the same turn that they are towing or being towed, except that the vehicle may fire one weapon at the Atlast if it is able and wants.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="49bf-355c-0169-a5ae" name="Atlas" hidden="false" targetId="cd29-822f-abf7-7f05" type="profile" />
                <infoLink id="a221-6986-0323-52e9" name="Heavy Bolter" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile" />
