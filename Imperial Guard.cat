    <profile id="e77378bf-b3c2-98a1-a696-c7f2af2ea660-0f066" name="Dozer Blade" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Vehicles equipped with dozer blades treat their front armour as one higher than normal when ramming. Furthermore the vehicle can re-roll failed Dangerous Terrain tests.</characteristic>
      </characteristics>
    </profile>
    <profile id="229eee6f-aa7e-89b9-a858-861b90fdcc5a-0f066" name="Enclosed Crew Compartment" page="52" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
