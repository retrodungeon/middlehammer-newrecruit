    </rule>
    <rule id="0a31b24f-a0eb-5320-5252-63f4c38569e9-45e2d" name="Aura of Discipline" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>Any friendly Codex: Astra Militarum unit within 6" uses his Leadership for Pinning, Morale, and Fear tests.</description>
    </rule>
    <rule id="2df4c82f-a131-4460-f090-e74a510707fa-45e2d" name="Auto-targeting" page="5" hidden="false">
