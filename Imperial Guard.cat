    <selectionEntry name="Atlas Recovery Vehicle (IA)" id="a368-8d72-199b-23aa" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="85" />
      </costs>
      <entryLinks>
        <entryLink name="Vehicle Upgrades" id="e34d-6893-55e4-10f4" collective="false" hidden="false" import="true" targetId="0ad0-e8db-2347-229f" type="selectionEntryGroup" />
      </entryLinks>
      <infoLinks>
        <infoLink name="Atlas" id="ad49-1dcf-6f28-cc15" hidden="false" targetId="2dd0-c5aa-34d6-3575" type="profile" />
        <infoLink name="Heavy Bolter" id="c9c2-c2ea-58aa-c983" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile" />
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Recovery Vehicle" id="aa2f-1f2d-f893-80fa" hidden="false">
          <description>The Atlast can drag any destroyed or immobilised vehicle (friend or foe) that starts the turn in contact with it. Both vehicles may move up to D6" and must remain in base contact at the end of the move. Neither vehicle may shoot in the same turn that they are towing or being towed, except that the vehicle may fire one weapon at the Atlast if it is able and wants.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Cyclops (IA)" id="11d2-9ada-a903-a290" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" />
      </costs>
      <entryLinks>
        <entryLink name="Chimera" id="2798-0aad-7e01-2144" collective="false" hidden="false" import="true" targetId="c74d-d67b-4511-8b3a" type="selectionEntry">
          <constraints>
            <constraint id="cb1d-0fa1-a7de-a40c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Cyclops" id="2a75-3948-831d-3609" hidden="false" targetId="0fec-d2b4-d14c-dd2c" type="profile" />
        <infoLink name="Demolition Charge" id="ddca-4691-ef45-4c1c" hidden="false" targetId="60f0-36e3-b539-71ac" type="profile" />
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Remote Controlled" id="0d8f-dce0-8133-2233" hidden="false">
          <description>The Cyclops is controlled by a single guardsman, or by the crew of a transporting Chimera. It moves independently of its controller, but it must remain with 48" of the controller, otherwise it simple stops and cannot do anything until control is restored.
During the Imperial Guard Shooting Phase the Cyclops can be detonated. Place the Ordnance template centered on the Cyclops. It is destroyed during the explosion.</description>
        </rule>
        <rule name="Damage" id="8d49-1a3f-3c45-9e18" hidden="false">
          <description>The Cyclops is destroyed by any glancing or penetrating hits. When rolling for armour penetration, if a weapon scores a 6, and this results in a penetrating hit, then the Cyclops explodes as normal.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Operator" id="717d-6ac8-84d1-8658" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="29e1-c48a-0386-3c36" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
            <constraint id="4c44-e023-4c9a-6cde" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
          <infoLinks>
            <infoLink name="Guardsman" id="1578-d2ab-7c36-a866" hidden="false" targetId="6bf1-0ba3-6f1d-d612" type="profile" />
            <infoLink name="Laspistol" id="01d3-f48d-f33a-f99a" hidden="false" targetId="95a9-d270-d218-1772" type="profile" />
            <infoLink name="Independent Character" id="15b0-0e23-75b3-9bb1" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
