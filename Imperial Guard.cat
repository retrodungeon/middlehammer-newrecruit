      <entryLinks>
        <entryLink name="Vehicle Upgrades" id="9f64-adbe-cd94-d396" collective="false" hidden="false" import="true" targetId="0ad0-e8db-2347-229f" type="selectionEntryGroup" />
      </entryLinks>
      <infoLinks>
        <infoLink name="Stormblade" id="4785-62ba-3eac-2912" hidden="false" targetId="6397-1c06-e9d4-7c0a" type="profile" />
        <infoLink name="Heavy Bolter" id="819f-548e-47c4-507a" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Two Twin-Linked Heavy Bolters" />
          </modifiers>
        </infoLink>
        <infoLink name="Lascannon" id="2d41-4670-7e44-c0bd" hidden="false" targetId="a160-d79e-e7a9-2e9c" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Two Turret Mounted Lascannons" />
          </modifiers>
        </infoLink>
        <infoLink name="Heavy Bolter" id="0d6c-0800-3f0b-00c7" hidden="false" targetId="b9aa-366b-bd62-4692" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Hull Mounted Heavy Bolter" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        </modifiers>
      <rules>
        <rule name="Difficult Terrain" id="8f09-56f4-adb3-ece3" hidden="false">
          <description>The Stormsword can ignore low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal, but if they roll a 1 they lose D3" of movement, just as if they had suffered an Engines Damaged result, instead of being immobilised.</description>
        </rule>
        <rule name="Lumbering Vehicle" id="267d-665f-dcfb-9229" hidden="false">
          <description>The stormsword can move up to 6" a turn. It must always move straight ahead, but can pivot by up to 90 degrees at the end of the move.</description>
        </rule>
        <rule name="Ordnance" id="da1d-0b2e-4311-cf32" hidden="false">
          <description>The stormsword may fire Ordnance and still fire other weapons. It may fire Ordnance even if it moved.</description>
        </rule>
        <rule name="Targeting" id="456f-6034-bf6b-703f" hidden="false">
          <description>Instead of picking one target for the Stormsword, pick a target for each of its weapons. The co-axial heavy bolter must fire at the same target as the Siege Cannon.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Plasma Blastgun" id="37e6-934f-427f-6e0e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d24e-1d14-edaa-2c22" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
            <constraint id="1ea0-c12c-85a0-ad9a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
          <infoLinks>
            <infoLink name="Titan Killer" id="65f5-2b75-f6a6-2109" hidden="false" targetId="b333-4165-9b69-fc6a" type="rule" />
            <infoLink name="Plasma Blastgun" id="b5b7-c2cc-553b-cbdf" hidden="false" targetId="1946-2b91-fbb1-1404" type="profile" />
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Captain Obadiah Schfeer (IA)" id="0f62-9403-92b7-0e71" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="234" />
