                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Phasing Hits</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="28e70b7e-93f6-9b6e-8cf8-c9aae730ecda-0937d" name="Phasing Hits" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Each successful To Wound roll of a 6 made by a Phase sword results in a Phasing Wound. Invulnerable saves cannot be taken against Phasing Wounds.</description>
            </rule>
