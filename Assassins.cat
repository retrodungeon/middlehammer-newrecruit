        <selectionEntry id="8f9f-ecb9-acbe-72ab-0937d" name="Frenzon" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="f145-b65a-03f9-20be-0937d" name="Frenzon" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <profiles />
              <rules />
              <infoLinks />
