    <profile name="Kustom Mega-blasta" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="6cc4-37a2-1053-bc7b">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
