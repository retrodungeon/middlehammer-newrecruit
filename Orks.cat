      </characteristics>
    </profile>
    <profile name="Snazzgun" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="5499-c093-a33b-9799">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">5</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">D6</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Roll once each Shooting phase to determine the unit's AP, but only after the target has been chosen.</characteristic>
      </characteristics>
    </profile>
    <profile name="Slugga" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="6af5-d755-49e5-700d">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">6</characteristic>
