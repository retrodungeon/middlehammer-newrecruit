            <characteristic name="T" typeId="ff29-f8b2-5b20-b686">2</characteristic>
            <characteristic name="W" typeId="4a81-ac45-a71c-c71e">1</characteristic>
            <characteristic name="I" typeId="8517-a46c-d6df-9c75">3</characteristic>
            <characteristic name="A" typeId="a535-0722-3bc1-4d3c">1</characteristic>
            <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">5</characteristic>
            <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
