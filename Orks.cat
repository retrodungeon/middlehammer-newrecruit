    <profile id="c0eff1d5-cadd-e3dd-37c1-aba29f3b0981-d4a5a" name="Mek's Tools" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In each of your Shooting phases, instead of firing, a model with Mek's Tools may choose to repair a single friendly vehicle if in base contact or embarked upon it. On a 5+ roll, repair one of the following: Weapon Destroyed, Immobilised, Hull Point. This is effective immediately.</characteristic>
      </characteristics>
    </profile>
    <profile id="11de3fac-b29a-ec0c-fa96-1570fc473030-d4a5a" name="Mek-arms" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Grant +D3A in the 1st round of any close combat, in addition to the usual +1A for charging. Count as Big Choppa attacks. Also count as Mek Tools.</characteristic>
      </characteristics>
    </profile>
