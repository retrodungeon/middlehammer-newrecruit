          </profiles>
          <rules>
            <rule id="45e0-2e25-e3b5-5c95" name="Grot Oiler" hidden="false">
              <description>Each Grot Oilder in base-to-base contact with a Mekboy gives them a +1 bonus to the dice roll for using their Mek's Tools up to a maximum of +3. A roll of 1 still always fails.</description>
            </rule>
          </rules>
