    <selectionEntry id="4fb4-db5f-551f-a05d" name="Big Squiggoth (IA)" hidden="false" collective="false" import="true" type="unit" publicationId="f5c8-02b4-8873-cb63" page="13">
      <modifiers>
        </modifiers>
      <rules>
        <rule id="64bb-3ebd-a651-5a30" name="Transport" hidden="false">
          <description>A Squiggoth may carry up to 10 Orks in the howdah. Orks being transported may leave the Squiggoth as if they were exiting an open-topped vehicle.</description>
        </rule>
        <rule id="cbf3-605a-d567-e85b" name="Monstrous Creature" hidden="false">
          <description>Rolls 2D6 for vehicle armour penetration and ignores armour saving throws.</description>
        </rule>
      </rules>
