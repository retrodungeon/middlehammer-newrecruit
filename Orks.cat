    </rule>
    <rule id="36fd8bde-62aa-c292-dc10-814bd36c78d1-d4a5a" name="Wall of Steel" page="60" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>All models in this Formation with the Hammer of Wrath special rule inflict D3 hits instead of the usual 1.</description>
    </rule>
    <rule id="e0387285-c637-31a0-e2d3-6b870c40f53a-d4a5a" name="Warlord" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
    </rule>
    <rule id="beccfd4d-727c-b85e-2bc7-82d4855fc906-d4a5a" name="Warlord Trait 2: Bellowing Tyrant" page="92" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>The Warlord, and all friendly units with the Orks Faction within 12" of him, re-roll failed Morale checks and Pinning tests.</description>
    </rule>
    <rule id="0e8be61b-6e57-3d48-57b1-4c67ac179cac-d4a5a" name="Warlord Trait: Biker Boss" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
    </rule>
    <rule id="806f3f6a-03d4-bf6d-545c-899c8e3ff182-d4a5a" name="Warlord Trait 4: Brutal but Kunnin'" page="92" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>The Warlord can re-roll one failed To Hit or To Wound roll each turn.</description>
    </rule>
    <rule id="8084e188-4887-867e-255f-ce7808d6e43d-d4a5a" name="Warlord Trait 5: Kunnin' but Brutal" page="92" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>The Warlord can re-roll one failed armour or invulnerable saving throw each turn.</description>
    </rule>
    <rule id="eb9e8a70-c303-ed50-5ee0-1fd389e31d7f-d4a5a" name="Warlord Trait: Mek Master" page="0" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
    </rule>
