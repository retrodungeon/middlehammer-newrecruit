        <infoLink name="Psyker" id="4091-abf8-750e-783d" hidden="false" type="profile" targetId="d241-1e73-a625-ec7d" />
        <infoLink name="Weirdboy Psychic Powers" id="54eb-74bd-a5e2-160a" hidden="false" type="profile" targetId="5f6c-49a8-31a2-05dc" />
      </infoLinks>
      <profiles>
        <profile name="Nest of Vipers" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="dc8a-b808-7204-335c">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Old Zogwort has an additional D6 Attacks at an Initiative of 4. All of Zogwort's Attacks are Poisoned 2+</characteristic>
          </characteristics>
        </profile>
        <profile name="Zogwort's Curse" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="6c08-f697-b898-7bd0">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Zogwort has the ability to transform a powerful enemy into a squig. Zogwort may use his curse as a psychic power instead of rolling on the Weirdboy Psychic power chart. Choose an indipendent Character model that is in Zogwort's line of sight. If that model is within 18", both players roll a dice. If the Ork player scores higher, the target model is replaced with an angry Squig under the control of your opponent. You must provide the Squig model. It has no wargear or special rules, but is an Independent Character that counts as infantry.</characteristic>
          </characteristics>
        </profile>
        <profile name="Squig" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="a84c-8619-2ec1-abc4">
          <characteristics>
            <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
            <characteristic name="BS" typeId="63a5-4be2-9cc0-7723">0</characteristic>
