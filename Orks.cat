    <profile name="Squig Hound" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="682d-f744-6245-dd2a">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Each time a unit with a Squig-hound fails a Morale test it may remove D3 Gretchin models to re-roll that Morale test.</characteristic>
      </characteristics>
    </profile>
