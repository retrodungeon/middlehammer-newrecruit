    <selectionEntry type="unit" import="true" name="Looted Wagon" hidden="false" id="8814-6340-dc3b-3609">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" />
      </costs>
      <infoLinks>
        <infoLink name="Looted Wagon" id="e30a-e72f-10ab-f606" hidden="false" type="profile" targetId="40ca-7daa-5c96-5ef2" />
