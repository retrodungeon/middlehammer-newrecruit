    <profile id="6e1e636f-8114-d76a-7ae4-67c4b5822b70-d4a5a" name="Mega Armour" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, Bulky, Slow &amp; Purposeful.</characteristic>
      </characteristics>
    </profile>
    <profile id="43b9d5bd-4beb-e7d6-4c96-c051aa7a4ac2-d4a5a" name="Mega Force Field" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bearer &amp; all models within 6" receive a 4+ Invul Sv against shooting attacks. If the bearer is embarked in a vehicle, then the vehicle receives a 4+ Invul Sv against shooting attacks instead.</characteristic>
      </characteristics>
    </profile>
    <profile id="11771ec9-419f-c316-2c17-7238f71725ea-d4a5a" name="Mega-charga" page="107" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">One use, declared at the start of any Movement phase; roll 1D6. On a 1, vehicle is immobilised (no Sv allowed, but no Hull Point lost). On any other result, vehicle gains Fleet for the duration of the turn.</characteristic>
      </characteristics>
    </profile>
