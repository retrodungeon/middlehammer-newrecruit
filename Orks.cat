      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer, and all models within 6", receive a 5+ invulnerable save against any shooting attacks. If the bearer is embarked in a vehicle, then the vehicle receives a 5+ invulnerable save against any shooting attacks instead.</characteristic>
