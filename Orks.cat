    <profile name="Rokkit Launcha" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="21ca-215a-88b3-e23c">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
