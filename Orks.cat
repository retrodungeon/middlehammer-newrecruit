      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Unit type Bike, +1T, 4+ Armour Sv. When turbo-boosting, this model can move up to 18" instead of 12" and counts its cover save as being 1 point higher than normal until the start of its next turn. Equipped with twin-linked kustom dakkablastas.</characteristic>
      </characteristics>
    </profile>
