  <selectionEntry type="unit" import="true" name="Ghazghkull Thraka" hidden="false" id="6abe-ecc3-945d-68ee">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="225" />
      </costs>
      <infoLinks>
        <infoLink name="Ghazghkull" id="9e65-1074-4070-c381" hidden="false" type="profile" targetId="c959-f24c-cdb9-0d5b" />
        <infoLink name="Cybork Body" id="7011-19e0-cd1c-1f5e" hidden="false" type="profile" targetId="db0c-7be3-0871-ec2d" />
