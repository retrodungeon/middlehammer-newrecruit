        <infoLink name="Open-topped" id="bd19-0f50-3807-832f" hidden="false" type="rule" targetId="21d9-2669-1dba-9fb2" />
      </infoLinks>
      <profiles>
        <profile name="Looted Wagon" typeId="9a37-e4d2-11fe-9e81" typeName="Transport" hidden="false" id="06a4-267d-fd6a-a6a9">
          <characteristics>
            <characteristic name="Capacity" typeId="7cdf-4c80-a83d-200c">12 Models. Models in Mega-armour count as two models. A Looted Wagon with a boomgun loses its transport capacity altogether.</characteristic>
            <characteristic name="Access Points" typeId="6e42-3bd5-70a6-724f">If a Looted Wagon has the 'ard case upgrade it has one access point at the rear.</characteristic>
            <characteristic name="Fire Points" typeId="aa94-ae0c-98e7-5923">If a Looted Wagon has the 'ard case upgrade it has three fire points, one on either side of the hull and one at the rear.</characteristic>
          </characteristics>
        </profile>
        <profile name="Don't Press Dat" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="ec0e-a1e8-3a81-ec3e">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Each Looted Wagon must roll a dice at the start of each Ork Movement phase. On the roll of a 1, that vehicle must move directly forward as far as possible as the Orks inside get carried away. This can potentially mean that the Wagon may Tank Shock an enemy unit. Passengers may not disembark this turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="May take one of the following" id="2c8e-cbc0-ac5e-970f" hidden="false">
          <selectionEntries>
