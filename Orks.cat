          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6c6a-7f24-4946-085e" type="max" />
          </constraints>
          <rules>
            <rule id="3226-941b-8308-0566" name="Mega Armor" hidden="false">
              <description>An Ork in Mega Armor gains a 2+ armor save and is armed with a shoota and power claw for free. However, an Ork in mega armor always moves as if in difficult terrain.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="1d10-4a50-92d9-413c" name="Shoota" hidden="false" targetId="894f-1760-04e4-77c4" type="profile" />
            <infoLink id="efe0-552e-b3bc-19f6" name="Power Claw" hidden="false" targetId="ff9c-5b94-680f-36d5" type="profile" />
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" />
          </costs>
        </selectionEntry>
        <selectionEntry id="75d0-445f-ba7d-e7ff" name="Mega Boosta" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1518-7a1b-daac-0172" type="notEqualTo" />
              </conditions>
            </modifier>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0f34-c6de-6cb3-3e55" type="max" />
          </constraints>
          <rules>
            <rule id="8ca3-abc6-30b0-e0df" name="Mega Boosta" hidden="false">
              <description>An Ork with Mega Boostas rerolls the dice to determine the distance they move when they are wearing Mega Armor. If a unit of Orks in Mega Armor includes some with Mega Boosters and some without, only the ones with Mega Boosters will gain the benefit of the re-roll while the others move the original distance rolled.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
        </selectionEntry>
        <selectionEntry id="ae8f-ac13-375a-f10c" name="Mekboy's Tools" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fdd0-6bc8-710f-4b77" type="notInstanceOf" />
                    <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b4e1-5f13-9303-52ad" type="notInstanceOf" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e61c-ef10-b8df-39a5" type="max" />
          </constraints>
          <rules>
            <rule id="c8f3-91f0-a6d4-7a26" name="Mekboy's Tools" hidden="false">
              <description>A Mekboy equipped with Mekboy's Tools can attempt to repair a vehicle which has suffered an "Immobilised" or "Weapon Destroyed" damage result, or to fix a Big Gun that has been destroyed. If the Mekboy is in base-to-base contact with the vehicle or Big Gun at the end of his movement phase roll a D6. On a 1 the repair fails and the vehicle or Big Gun may not be repaired for the rest of the game. On a 2-5 the Mekboy fails the repair. On a 6 the repair succeeds and the Vehicle's weapon is fixed, or it is no longer immobilized, or a Big Gun is fixed.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="2" />
          </costs>
        </selectionEntry>
        <selectionEntry id="c7c7-636c-43d6-6278" name="Squighound" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
