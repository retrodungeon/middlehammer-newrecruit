                    <profile name="Mork's Teeth" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="7b3a-500e-8b89-e335">
                      <characteristics>
                        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">These count as having an extra close combat weapon. The bearer may re-roll all failed rolls to hit in an assault.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Ambush" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="b9a2-594b-0a53-c19e">
                      <characteristics>
                        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If the owning player chooses, Snikrot and his unit may be held in reserve. When Snikrot and his unit become available from Reserve, they may move on from any table edge.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Killa Reputation" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="039c-9b19-e878-0b82">
                      <characteristics>
                        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If Snikrot and his unit win a combat, the enemy suffers an additional -1 modifier to their Leadership</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
