      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Unit type Jump. A unit made up exclusively of models with rokkit packs can choose to use them to Run 2D6" in the Shooting phase instead of the normal D6" even if it used them in the Movement phase. If it does so, every model in the unit must take a Dangerous Terrain test.</characteristic>
      </characteristics>
    </profile>
