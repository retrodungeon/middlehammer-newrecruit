    <selectionEntry id="e2e8-e321-6af7-930b" name="Battle Fortress (IA)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        </modifiers>
      <rules>
        <rule id="5718-1065-8748-b598" name="Lumbering" hidden="false">
          <description>Can move up to 6" per turn and it must always move straight ahead. It can pivot up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="6bc0-ad77-3274-ae9c" name="Difficult Terrain" hidden="false">
          <description>The vehicle ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal. However, if they roll a 1 they are not immobilised, but instead lose D3" of movement.</description>
        </rule>
        <rule id="4918-d737-8658-b939" name="Targeting" hidden="false">
          <description>Instead of picking one target, pick a target for each of its weapons</description>
        </rule>
        <rule id="7e7f-2828-a657-c2e8" name="Tank Shock" hidden="false">
          <description>Enemy infantry test at -1 to their Leadership if they are Tank Shocked by a Battle Fortress</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2410-e412-b415-844f" name="Battle Fortress" hidden="false" targetId="9388-8c78-ce61-689c" type="profile" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="7390-7e76-6d15-df61" name="Super-Heavy" hidden="false" targetId="5968-f35e-18fd-612b" primary="true" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="09a6-d50c-c027-6098" name="Bolt-on Big Shootas" hidden="false" collective="false" import="true" type="upgrade" sortIndex="2">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="af57-b743-6037-fdd4" type="max" />
          </constraints>
          <rules>
            <rule id="c8bb-7695-756e-7bb2" name="Bolt-on Big Shootas" hidden="false">
              <description>These weapons must be fired by the Ork mob onboard.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="bdfd-07e0-ac57-2a42" name="Big Shoota" hidden="false" targetId="b467-e518-11c9-c23a" type="profile">
              <modifiers>
                <modifier type="set" field="name" value="Bolt-on Big Shoota" />
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
        </selectionEntry>
        <selectionEntry id="c3be-a758-856d-132f" name="Krusher (IA)" hidden="false" collective="false" import="true" type="upgrade" sortIndex="4">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e3a6-0077-1959-88e9" type="max" />
          </constraints>
          <rules>
            <rule id="6993-e3cb-2b06-a0d7" name="Krusher (IA)" hidden="false">
              <description>If the Battlewagon makes a Tank Shock attack on an enemy unit and the enemy don't fall back, then roll a D6 for each model forced to move out of the way of the vehicle. On a 4+ they are caught and crushed, and suffer a wound with normal armour saves allowed.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
          </costs>
        </selectionEntry>
      </selectionEntries>
