      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Ork vehicles with red paint jobs add +1" to their move when they move Flat Out.</characteristic>
      </characteristics>
    </profile>
    <profile id="f162bd89-3afc-8415-8305-a6ea6c221881-d4a5a" name="Refractor Field" page="71" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
