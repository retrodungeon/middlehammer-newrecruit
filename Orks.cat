          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="41ea-4c02-8e0f-1322" type="max" />
          </constraints>
          <rules>
            <rule id="d7b7-0ea4-ebd7-070c" name="Super Stikkbombz" hidden="false">
              <description>Super Stikkbombz work just like krak stikkbombz but have a armor penetration roll of 10+2D6. On a roll of double ones the attack is resolved like normal but the Mekboy using them sufffers a wound that may attempt to be saved as normal.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
        </selectionEntry>
        <selectionEntry id="5eff-36fe-24fc-062e" name="Tankbusta Bombz" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1518-7a1b-daac-0172" type="equalTo" />
              </conditions>
            </modifier>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6a8a-7456-8bf9-aea8" type="max" />
          </constraints>
          <rules>
            <rule id="a175-0086-1b2a-078f" name="Tankbusta Bombz" hidden="false">
              <description>Tankbusta Bombz are used like krak stikkbombz to attack vehicles and bunkers, however Tankbusta Bombz have an armor penetration roll of 6+(D6x2).</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="3" />
          </costs>
        </selectionEntry>
        <selectionEntry id="18ce-1821-0982-20b3" name="Waaagh! Banner" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="increment" field="6f18-a8fc-2c5b-9517" value="5">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="838f-024c-52e0-08f2" type="instanceOf" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="force" value="1" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="2d83-1003-8f92-21e7" type="max" />
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6228-12b5-5d73-67f5" type="max" />
          </constraints>
          <rules>
            <rule id="dcf2-f833-a29e-7456" name="Waaagh! Banner" hidden="false">
              <description>Any mob that has one or more models within 12" of the banner may re-roll their Power of the WAAAGH! test when they charge.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
