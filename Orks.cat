4 Brutal but Kunnin'
5 Kunnin' but Brutal
6 Might is Right</description>
    </rule>
    <rule id="c9d28c63-1a53-8878-f2a2-146ed01dc705-d4a5a" name="Warlord Trait: Planetstrike Attacker" hidden="true">
      <profiles />
      <rules />
