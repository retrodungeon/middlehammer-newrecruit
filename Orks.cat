        <profile name="Bike of the Aporkalypse" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="9a1b-97c5-0817-aa11">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Wazdakka follows the rules for Warbikes. Furthermore, when Wazdakka's bike uses a Turbo Boost he may still fire his weapon that turn.</characteristic>
