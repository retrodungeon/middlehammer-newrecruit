        <characteristic name="Ld" typeId="ddd5-77eb-4cc8-9eab">9</characteristic>
        <characteristic name="Sv" typeId="c1e7-f1bd-8acd-7595">2+</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Oilers" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="3cb5-80d6-bdae-a403">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A Grot Oiler allows a Mek to re-roll a failed Mek's Tools repair roll. Remove the Oiler model once he has been used. Oiler models are purely decorative.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Orderly" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="8220-f421-4cb9-b49d">
      <characteristics>
        <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">A Grot Orderley allows a Painboy's unit to re-roll a single 'Feel No Pain' roll. Remove the Orderly model once he has been used. The Orderly model is purely decorative.</characteristic>
      </characteristics>
    </profile>
    <profile name="'Ard Boy Nob" typeId="0967-823d-dd82-4e47" typeName="Unit" hidden="false" id="cb5b-6539-f69d-9bc2">
      <characteristics>
        <characteristic name="WS" typeId="15b1-a34a-6e7c-332e">4</characteristic>
