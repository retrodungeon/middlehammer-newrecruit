      <profiles>
        <profile name="Battlewagon" typeId="9a37-e4d2-11fe-9e81" typeName="Transport" hidden="false" id="4d21-d6f9-c526-7949">
          <characteristics>
            <characteristic name="Capacity" typeId="7cdf-4c80-a83d-200c">20 Models. Models in Mega Armour count as two models. A Battlewagon with a Killkannon has a transport capacity of 12.</characteristic>
            <characteristic name="Access Points" typeId="6e42-3bd5-70a6-724f">If a Battlewagon has the 'ard case upgrade it has five fire points, two on either side of the hull and one at the rear.</characteristic>
            <characteristic name="Fire Points" typeId="aa94-ae0c-98e7-5923">If a Battlewagon has the 'ard case upgrade it has three access points, one on either side of the hull and one at the rear.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
