      <infoLinks>
        <infoLink id="e0b4-eb1b-4bc4-c008" name="Battlewagon" hidden="false" targetId="ac4a-a177-0659-3450" type="profile" />
        <infoLink id="fc2f-d4ae-3a83-d45e" name="Open-Topped" hidden="false" targetId="4795-fd7c-2846-78ba" type="rule" />
