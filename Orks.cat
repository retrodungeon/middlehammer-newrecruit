          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6883-ddfc-dcb4-f5c1" type="max" />
          </constraints>
          <rules>
            <rule id="e85d-7c11-4d82-a137" name="Kustom Force Field" hidden="false">
              <description>Kustom Force Fields provides a 5+ cover saving throw to all models with 6". All vehicles with 6" are treated as being hull down. The force field has no effect in close combat or against shooting within 6" of the operator.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
          </costs>
        </selectionEntry>
