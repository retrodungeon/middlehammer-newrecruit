    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Old Zogwort" hidden="false" id="af2e-abbe-0ad6-80f6">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="145" />
      </costs>
      <infoLinks>
        <infoLink name="Old Zogwort" id="d0ed-82a2-6f17-ed21" hidden="false" type="profile" targetId="e4a4-f964-b4ff-8591" />
        <infoLink name="Independent Character" id="54f3-49f8-f4dd-0a95" hidden="false" type="profile" targetId="db9c-91d8-5b8a-ee16" />
