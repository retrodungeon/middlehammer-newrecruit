    <rule id="27bfa0f0-99b3-07f0-4d55-b3018862e55d-d4a5a" name="Glory Hogs" page="65" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>In a mission that has the First Blood Secondary Objective, the Ork player receives double the normal number of Victory Points from that objective if the first casualty to be removed is an enemy vehicle that was destroyed by an attack made by one or more units of Tankbustas.</description>
    </rule>
