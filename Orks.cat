      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Unit type Bike, +1T, 4+ Armour Sv. Furthermore, if a model on a warbike turbo-boosts, it counts its cover save as being 1 point higher than normal until the start of its next turn. Warbikes are fitted with a twin-linked dakkagun.</characteristic>
      </characteristics>
    </profile>
