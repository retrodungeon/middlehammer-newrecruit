    <profile id="d48d4b34-4cb3-0801-6bbc-c367c58df69b-d4a5a" name="Squig Hound" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with a squig hound fails a Morale check it suffers D6 Strength 3 AP- hits and must then re-roll the failed Morale check. If the re-roll is failed, it cannot be re-rolled again, and the squig hound will not inflict any further hits.</characteristic>
      </characteristics>
    </profile>
    <profile id="e78e5295-6e2c-9389-56d9-cfe46b133003-d4a5a" name="Stikkbomb Chukka" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
