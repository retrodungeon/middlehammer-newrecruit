                <characteristic name="Ld" typeId="f47e-b15a-8f58-703c">5</characteristic>
                <characteristic name="Sv" typeId="b309-5233-122f-82bb">-</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="ecb9-bdbd-30f3-c9b1" name="Grot Orderly" hidden="false">
              <description>Each Grot Orderly in base-to-base contact with a Mad Dok gives them a +1 bonus to the dice roll for using their Dok's Tools up to a maximum of +3. A roll of 1 still always inflicts a wound.</description>
            </rule>
          </rules>
          <costs>
