    <profile id="029a-3293-1666-7100" name="Servo-Harness (Plasma Cutter)" book="Codex: Space Marines" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
      <profiles/>
      <rules/>
