                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="If your Warlord and his unit do not move in their Movement phase, then he and his unit have the Fearless and Counter-attack special rules until the start of their next turn."/>
                  </characteristics>
                </profile>
                <profile id="68f4-3dd0-bc0b-ce0c" name="Warlord Trait: Architect of War" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Whilst your Warlord is embarked inside a building, all damage rolls against that building suffer a -1 penalty, to a minimum of 1."/>
                  </characteristics>
                </profile>
                <profile id="64fa-590f-3ec5-a88e" name="Warlord Trait: Fleet Commander" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Once per game, your Warlord can call down an orbital strike in his Shooting phase.  This counts as firing a ranged weapon with Orbital Strike profile."/>
                  </characteristics>
                </profile>
                <profile id="ecd2-496e-6de5-a445" name="Warlord Trait: Siege Lord" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord and his unit add 1 to the result when rolling on the Building Damage table."/>
                  </characteristics>
                </profile>
                <profile id="f78f-9b73-69fd-554b" name="Warlord Trait: Tenacious Opponent" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
