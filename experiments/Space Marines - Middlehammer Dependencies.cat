        <profile id="9f12-2480-e372-af0b" name="Lucius Pattern Dreadnought Drop Pod (Transport)" book="IA Volume 2" hidden="false" profileTypeId="b3a8-0452-7436-44d1" profileTypeName="Transport">
          <profiles/>
          <rules/>
          <infoLinks/>
