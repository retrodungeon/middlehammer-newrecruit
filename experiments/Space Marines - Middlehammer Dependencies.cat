          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="When taking Morale tests, all friendly units within 24&quot; of the bearer can use his Leadership characteristic instead of their own.  Furthermore, nominate a single friendly unit within 12&quot; of the bearer at the start of each of his Shooting phases.  That unit can re-roll all To Hit rolls of 1 in that Shooting phase."/>
          </characteristics>
        </profile>
      </profiles>
