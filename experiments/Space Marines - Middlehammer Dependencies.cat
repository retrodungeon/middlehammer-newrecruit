                <profile id="9234-1534-1814-b05a" name="Warlord Trait: Never Give Up" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
