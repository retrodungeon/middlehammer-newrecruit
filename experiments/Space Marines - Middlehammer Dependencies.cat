      <profiles/>
      <rules>
        <rule id="142a-8aa3-48b6-49c7" name="Fight like Demigods" book="Gathering Storm: Rise of the Primarch" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Add 1 to the Weapon Skill and Ballistic Skill characterisitcs of all models in this Formation</description>
        </rule>
        <rule id="f529-930a-4112-a478" name="The Primarch&apos;s Chosen" book="Gathering Storm: Rise of the Primarch" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>While a unit from this Formation is within 3&quot; of Roboute Guilliman, he can make Look Out, Sir rolls as if he was part of that unit.</description>
