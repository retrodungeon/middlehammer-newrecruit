                <profile id="d33d-782c-fe8c-7759" name="Warlord Trait: Expert Instructor" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="If your Warlord does not make a Shooting attack or Run in the Shooting phase, you can nominate one friendly model within 12&quot; of him.  That model can use your Warlord&apos;s Ballistic Skill this phase."/>
