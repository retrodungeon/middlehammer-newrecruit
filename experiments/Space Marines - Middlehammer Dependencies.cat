          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Friendly Howling Griffons units from either Codex: Space Marines or the Space Marine Siege Assault Vanguard army list, and at least one model within 12&quot; of Chaplain Dreadnought Titus gain the Fearless special rule.</description>
        </rule>
