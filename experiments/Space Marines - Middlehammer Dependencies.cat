    <selectionEntry id="93d1-148b-bf4e-223e" name="Chapter Relic (IH): The Gorgon&apos;s Chain" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="d546-fef4-952e-40bb" name="Chapter Relic (IH): The Gorgon&apos;s Chain" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="The Bearer of the Gorgon&apos;s Chain has the following special rules, depending on how many unsaved Wounds he has suffered during the battle.  0: The bearer has a 3+ invulnerable save, +1 to his Feel No Pain rolls, and the Eternal Warrior special rule. 1: The bearer has a 3+ invulnerable save, and the Eternal Warrior special rule. 2: The bearer has a 3+ invulnerable save. 3+: The bearer has a 4+ invulnerable save.  Each time the bearer suffers an unsaved Wound, or recovers a Wound as a reuslt of the It Will Not Die rule, the effects of the Gorgon&apos;s Chain change immediately; you should roll the bearer&apos;s saves individually."/>
          </characteristics>
        </profile>
      </profiles>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1d70-40a2-27c8-e1df" type="max"/>
