    <selectionEntry id="5aa2-4e16-b9f9-56f2" name="Wing Leader (Space Marines)" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="ea84-73f7-e4d0-4e93" name="1-2: Know no Fear" book="Death from the Skies" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Ignore Crew Stunned and Crew Shaken results that are inflicted on the Wing Leader (Hull Points are lost normally)"/>
          </characteristics>
        </profile>
        <profile id="2aaa-08e1-712b-3475" name="5-6: Chapter Champion" book="Death from the Skies" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="The Wing Leader has a 5+ invulnerable save.  In addition, if the To Hit roll for an attack made by the Wing Leader in a Dogfight is a 6, then the attack receives the Armourbane special rule."/>
          </characteristics>
        </profile>
        <profile id="1388-2e5d-182e-c83f" name="3-4: Angel of Death" book="Death from the Skies" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="The Wing Leader can re-roll To Wound and Armour Penetration rolls of 1"/>
          </characteristics>
        </profile>
      </profiles>
      <rules/>
      <infoLinks>
