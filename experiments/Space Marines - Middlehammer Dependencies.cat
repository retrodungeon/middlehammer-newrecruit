    </profile>
    <profile id="3e9f-e7e4-7e8b-9395" name="Conversion Beamer (42&quot; - 72&quot;)" book="Codex: Space Marines" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
      <profiles/>
      <rules/>
