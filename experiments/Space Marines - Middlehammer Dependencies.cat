          <profiles>
            <profile id="4533-2ca3-fb9e-650b" name="The Empereor&apos;s Sword" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
              <profiles/>
              <rules/>
              <infoLinks/>
