            <selectionEntry id="5fcb-8a32-9fdd-5f5b" name="Raven Guard" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="2973-4722-d750-f548" name="Warlord Trait: Vanish into the Gloom" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="When your Warlord&apos;s unit is chosen as the target of a shooting attack, it can immediately Vanish into the Gloom, moving up to D6&quot;.  Models from your Warlord&apos;s unit that are in cover at the end of this move receive +1 to their cover saving throws against that shooting attack.  The firing unit cannot choose a different target, even if your Warlord&apos;s unit is now out of range or line of sight.  Your Warlord&apos;s unit can only Vanish into the Gloom once per turn and cannot do so at all if Falling Back or charging."/>
                  </characteristics>
                </profile>
                <profile id="5e0c-5c1f-bef2-74a8" name="Warlord Trait: Silent Stalker" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Enemy units wishing to fire Overwatch at your Warlord or his unit must first pass a Leadership test.  If your Warlord charged through dificult terrain, subtract 2 from the enemy unit&apos;s Leadership when they take this test."/>
                  </characteristics>
                </profile>
                <profile id="cafa-1394-c6f8-a2ae" name="Warlord Trait: Concentrated Attack" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="At the start of your Charge phase, pick an enemy unit within your Warlord&apos;s line of sight.  Until the end of the phase, Raven Guard units can re-roll charge rolls against that unit."/>
                  </characteristics>
                </profile>
                <profile id="0a56-cba4-ebde-190b" name="Warlord Trait: Exit Strategy" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="When rolling for Variable Game Length, you can add or subtract 1 from the result if your Warlord is on the battlefield."/>
                  </characteristics>
                </profile>
                <profile id="9f44-2896-4a1f-59a5" name="Warlord Trait: Master of Shadows" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Once per game, as long as your Warlord is on the battlefield, you can declare in your Movement phase that Night Fighting rules are in effect until the start of your next turn."/>
                  </characteristics>
                </profile>
                <profile id="f5fc-01a2-8fe8-bcb2" name="Warlord Trait: Swift and Deadly" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Once per battle, your Warlord, and any unit he has joined, can charge even if they Ran in the preceding Shooting phase."/>
                  </characteristics>
                </profile>
              </profiles>
              <rules/>
              <infoLinks/>
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <repeats/>
