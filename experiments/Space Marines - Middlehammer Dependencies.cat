          <profiles>
            <profile id="bd5e-f97d-300e-55dc" name="Malleus Argyrum" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
