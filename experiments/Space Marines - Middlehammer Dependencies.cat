    <selectionEntry id="f2e4-0348-180a-5247" name="Formation: Land Raider Spearhead" book="Codex: Space Marine" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="dc4d-a2c9-6c71-d40a" name="Armoured Behemoths" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Models from this Formation ignore Crew Shaken, Crew Stunned, Weapon Destroyed, and Imobilised results on the Vehicle Damage table as long as they are within 6&quot; of at least one other model from this Formation when the roll is made.</description>
        </rule>
        <rule id="3597-9318-1198-f891" name="Even the Mightiest Shall Fall" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Models in this Formation can re-roll failed To Wound rolls or armour penetration rolls when shooting at gargantuan creatures, super-heavy vehicles or buildings that have the Mighty Bulwark special rule.</description>
        </rule>
      </rules>
      <infoLinks/>
      <modifiers/>
      <constraints/>
      <selectionEntries/>
      <selectionEntryGroups>
        <selectionEntryGroup id="0b92-10c8-b6d5-17c7" name="Land Raiders" hidden="false" collective="false" defaultSelectionEntryId="81a7-cd4e-b759-5c4e">
