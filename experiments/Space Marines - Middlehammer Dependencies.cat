    <selectionEntry id="fe6c-f459-7cb6-e3b8" name="Formation: Suppression Force" book="Codex: Space Marine" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="c429-8131-ad66-03f8" name="Datalink Telemetry" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>One Land Speeder from this Formation can nominate an enemy unit within 18&quot; and in line of sight in its Shooting phase.  It cannot do this in the same turn it moves Flat Out. Until the end of the phase, all shooting attacks made with Whirlwind multiple missile launchers by models in this Formation against the nominated target can re-roll To Hit rolls and are treated as having an infinite range.</description>
        </rule>
      </rules>
      <infoLinks/>
      <modifiers/>
      <constraints/>
      <selectionEntries/>
      <selectionEntryGroups/>
