            <selectionEntry id="276a-f653-dc2c-9f1a" name="Black Templars" hidden="false" collective="false" categoryEntryId="(No Category)" type="upgrade">
              <profiles/>
              <rules>
                <rule id="b3d9-f874-840d-ee20" name="The Lost Librarius" book="Codex: Space Marines" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <description>Librarians may not be included in Detachments of Black Templars.</description>
                </rule>
                <rule id="370f-dc59-e708-1e16" name="Righteous Zeal" book="Codex: Space Marines" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <description>If a Black Templars unit suffers one or more casualties in the Shooting phase or as a result of Overwatch, all models in that unit gain the Counter-Attack and Rage special rules until the end of the turn.</description>
                </rule>
                <rule id="179b-af14-99fb-794f" name="Holy Crusaders" book="Codex: Space Marines" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <description>Black templars models have the Crusader and Adamantium Will special rules.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="305d-1511-4f8b-ff9b" name="" hidden="false" targetId="f987-c2a3-1a7a-9703" type="rule">
