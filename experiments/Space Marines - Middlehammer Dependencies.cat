    <profile id="0d38-f544-7735-7185" name="Camo Cloak" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="A model wearing a camo cloak has +1 cover save.  If it does not already have a cover save, it gains a 6+ cover save."/>
      </characteristics>
    </profile>
    <profile id="d7f6-a7c2-1226-d7db" name="Cluster Mines" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="After your army deploys, Scouts redeploy and Infiltrators deploy, but before the roll to Seize the Initative, each unit with cluster mines in your army may booby-trap a single piece of battlefield terrain on the table. The piece of battlefield terrain should be marked with a small marker to remind both players that it has been booby-trapped.  Enemy models treat booby-trapped pieces of battlefield terrain as dangerous terrain.  Note that having multiple units booby-trap the same piece of battlefield terrain has no additional effect.  A Unit with cluster mines which begins the game in Reserve may still booby-trap a piece of battlefield terrain."/>
      </characteristics>
    </profile>
    <profile id="8320-5def-f3d2-8d1f" name="Combat Shield" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="A combat shield confers a 6+ invulnerable save."/>
      </characteristics>
    </profile>
    <profile id="100a-97d1-2306-b9df" name="Hellfire Shells" book="Codex: Space Marines" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
