    <selectionEntry id="6f6c-cab8-512b-6c1f" name="Formation: Shadow Force" book="Angels of Death" page="67" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="fb77-8bc6-d26a-e9cc" name="Swift Redeployment" book="Supplement: Angels of Death" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Non-vehicle units in this Formation can re-roll the dice when determining their Run moves, and vehicle lunits in this Formation can move an additioanl 6&quot; when moving Flat Out.</description>
        </rule>
      </rules>
      <infoLinks>
