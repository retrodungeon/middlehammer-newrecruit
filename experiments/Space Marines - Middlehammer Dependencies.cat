    <forceEntry id="20b8-569d-7a0a-0d17" name="SM IH Fist of Medusa Strike Force" hidden="false">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <constraints/>
      <categoryEntries>
        <categoryEntry id="bf93-7277-bf48-16f7" name="Core" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
