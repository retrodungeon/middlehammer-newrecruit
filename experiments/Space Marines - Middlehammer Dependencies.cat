    <profile id="32f2-8965-df9f-0e0f" name="Tartaros Terminator Armour" book="Datasheet: Tartaros Terminator Squad" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
