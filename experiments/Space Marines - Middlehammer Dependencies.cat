            <selectionEntry id="b2f7-ca3e-dadc-94af" name="Raven Guard" hidden="false" collective="false" categoryEntryId="(No Category)" type="upgrade">
              <profiles/>
              <rules>
                <rule id="4fbf-58ee-81ca-985d" name="Winged Deliverance" book="Codex: Space Marines" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <description>Raven Guard units with the Jump unit type may use their jump packs in both the Movement and Assault phases of the same turn. Furthermore, when they make Hammer of Wrath attacks, Raven Guard models can re-roll failed To Wound rolls.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="7601-fdc8-00ec-382e" name="" hidden="false" targetId="b7ae-4da2-017f-1a5b" type="rule">
