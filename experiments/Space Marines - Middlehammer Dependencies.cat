    <selectionEntry id="7283-b32e-d6f4-cbbc" name="Formation: Centurion Siegebreaker Cohort" book="Codex: Space Marine" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="1fcd-092b-3f96-99bd" name="Demolition Specialists" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Units from this Formation which contain a model with an omniscope re-roll failed armour penetration rolls against buildings, and can choose to re-roll glancing hits against a building in an attempt to instead get a penetrating hit - but the second result must be kept.</description>
        </rule>
        <rule id="8e43-464b-803a-bd27" name="Seismic Devastation" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>If a building or Transport vehicle loses its last Hull Point as the result of attacks made in the Assault Phase by models in this Formation, any unit embarked in the building or vehicle immediately suffers 2D6 Strength 6 AP4 hits with the Ignores Cover special rule. These Wounds are Randomly Allocated, and are in addition to any hits that the unit would normally suffer.</description>
        </rule>
      </rules>
      <infoLinks/>
      <modifiers/>
      <constraints/>
      <selectionEntries/>
      <selectionEntryGroups/>
      <entryLinks>
        <entryLink id="20c1-fcd5-c889-4151" name="" hidden="false" targetId="fb1b-d00b-3c7b-605e" type="selectionEntry">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <constraints>
