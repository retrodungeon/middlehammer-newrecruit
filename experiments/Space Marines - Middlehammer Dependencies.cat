    <profile id="0e99-c456-60c1-aad1" name="Conversion Beamer (0&quot; - 18&quot;)" book="Codex: Space Marines" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
