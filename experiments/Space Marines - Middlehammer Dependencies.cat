    <profile id="20b1-50bc-0ebf-dbac" name="Armourium Cherub" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="One use only.  One model in a unit equipped with an armorium cherub can re-roll all failed To Hit rolls in one Shooting phase."/>
      </characteristics>
    </profile>
    <profile id="8b0e-5fbf-a080-2cd4" name="Helical Targeting Array" book="IA: Aeronautica" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="If the Contemptor-Mortis remains stationary in the Movement phase, it gains the Skyfire and Interceptor special rules for that turn."/>
      </characteristics>
    </profile>
    <profile id="de00-6118-2843-0d85" name="Armoured Ceramite" book="IA: Aeronautica" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Melta weapons do not roll an extra D6 armour penetration when shooting a vehicle equipped with armoured ceramite."/>
      </characteristics>
    </profile>
    <profile id="7320-3dec-26ec-618a" name="Warlord Trait: Storm of Fire" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="At the start of each of your Shooting phases, nominate on friendly unit within 12&quot; of your Warlord that is drawn from the same Chapter as your Warlord.  That unit&apos;s ranged weapons have the Rending special rule until the end of the phase."/>
      </characteristics>
    </profile>
    <profile id="87f6-4c43-800a-9440" name="Warlord Trait: Rites of War" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="All models in your Warlord&apos;s Detachment can use his Leadership value in place of their own."/>
      </characteristics>
    </profile>
    <profile id="2c97-2290-20db-4a3e" name="Void Shield" book="IA: Volume 6" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Each hit scored against a Titan will instead hit a void shield (whilst at least one remains active).  Close combat attacks come from inside the shield and therefore are not stopped.  Void shields have an Armour Value of 12.  A Glancing hit or Penetrating hit (or any hit from a Destroyer Weapon) scored against a void shield causes it to collapse.  After all void shields have collapsed, further hits strike the Titan instead.  At the end of each of the Titan&apos;s turns, roll a D6 for each collapsed void shield.  Each roll of 5+ instantly restores one collapsed shield."/>
      </characteristics>
    </profile>
