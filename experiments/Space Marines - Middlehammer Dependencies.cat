          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>All Rhinos, Razorbacks and Land Raiders in a primary detachment commanded by Tarnus Vale gain an Invulnerable save of 5+ against glancing hits.</description>
