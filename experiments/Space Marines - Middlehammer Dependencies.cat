      </characteristics>
    </profile>
    <profile id="dd65-9f0c-f224-f43a" name="Cyclone Missile Launcher (Frag Missile)" book="Codex: Space Marines" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
