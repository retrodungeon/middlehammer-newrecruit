        <rule id="ad13-e346-3d26-eedf" name="Hard as Stone" book="IA: Volume 9" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>During any turn, the controlling player may choose to pass or fail any Morale check that Mordaci Blaylock or a squad which he has joined is subject to. Both Mordaci Blaylock and any squad he joins are also immune to Pinning.</description>
        </rule>
        <rule id="38a3-fafc-14d6-8feb" name="Terminator Attack" book="IA: Volume 9" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>All Novamarines Terminator squads and Terminator Assault squads included in the army count as both scoring and denial units.</description>
        </rule>
      </rules>
