      <profiles>
        <profile id="b851-3aaa-ca18-6378" name="Blessed Autosimulacra" book="IA: Datasheets" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="If a vehicle has suffered Hull Point damage at the end of the controlling player&apos;s turn, roll a D6. On a 6, one lost Hull Point is restored."/>
