                <profile id="8eb2-44bb-405b-47f7" name="Warlord Trait: Miraculous Constitution" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
