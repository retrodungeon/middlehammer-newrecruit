              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="dd80-fff2-8d17-1582" name="Feedback" book="IA: Apocalypse" hidden="false">
              <profiles/>
              <rules/>
              <infoLinks/>
              <modifiers/>
              <description>If a weapon with this type fail it Penetration roll against a target vehicle&apos;s armour or fails a To Wound roll against a target model roll a D6. If the result is a 1, dangerous energy feedback along the beam causes the firing model to lose 1 Hull Point or Wound.</description>
            </rule>
            <rule id="30cc-f45f-1735-0cae" name="Shock Pulse" book="IA: Apocalypse" hidden="false">
              <profiles/>
              <rules/>
              <infoLinks/>
              <modifiers/>
              <description>Any vehicle (including super-heavy vehicles) that suffers a Penterating hit from a weapon with this type may only fire Snap Shots in the following game turn.</description>
            </rule>
          </rules>
          <infoLinks>
