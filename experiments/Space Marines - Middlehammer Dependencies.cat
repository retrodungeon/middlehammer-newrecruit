        <profile id="a047-f0c4-4972-8a96" name="Warlord Trait: Proud to Live, Proud to Die, Hard to Kill" book="IA: Volume 9" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="When calculating the victors of any and all assaults that take place within 12&quot; of Carab Culln, the Red Scorpions player adds +1 to their score.  If Carab Culln is involved in a challenge during that particular Assault phase, bonus is increased to +2. However, Carab Culln may never benefit from the Look Out, Sir rule."/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="112f-0776-1e75-0e5d" name="Master of Battle" book="IA: Volume 9" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>All units with the Chapter Tactics (Red Scorpions) in the same detachment as Carab Culln may use his Leadership value for determining the effects of all Pinning Tests and Morale Checks</description>
        </rule>
