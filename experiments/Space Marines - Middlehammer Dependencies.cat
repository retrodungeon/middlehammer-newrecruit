    <selectionEntry id="0e99-6a9e-bd14-214e" name="Formation: Anti-Air Defence Force" book="Codex: Space Marine" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="88d4-8102-2132-a934" name="Formation: Anti-Air Defence Force" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>If a Hunter from this Formation causes a hit on an emey Flyer or Flying Monstrous Creature when firing its skyspear missile launcher, all stalkers in this Formation add 1 to their Ballistic Skill until the end of the phase when firing at the same target unit.	</description>
        </rule>
      </rules>
