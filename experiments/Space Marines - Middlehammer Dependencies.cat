      <profiles>
        <profile id="2645-9acd-3b83-3280" name="Chapter Relic (IF): The Banner of Staganda" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
