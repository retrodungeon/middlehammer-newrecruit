        <profile id="b91b-989b-9305-6ef3" name="Warlord Trait: Legendary Fighter" book="IA: Volume 9" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="An army gains 1 Victory point for each enemy character slain by the Warlord in a challenge."/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="0e3c-d139-f1f2-7005" name="The Tyrant&apos;s Champion" book="IA: Volume 9" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>All friendly units, but not Independent Characters, chosen from Codex: Space Marines or the Space Marine Siege Assault Vanguard army list with the Chapter Tactics (Astral Claws) special rule as part of the same detachment as Corien Sumatris gain +1 WS while within 12&quot; of him. Any squad he joins gains the Furious Charge special rule while he is part of the squad.</description>
        </rule>
      </rules>
