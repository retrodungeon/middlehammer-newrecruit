            <selectionEntry id="f7c6-5c64-2a71-1f89" name="White Scars" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="6ba6-ba1a-21c6-6c8e" name="Warlord Trait: Deadly Ambush" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="You can add or subtract 1 from the result of any Reserve Rolls you make while your Warlord is on the battlefield or in Reserve"/>
                  </characteristics>
                </profile>
                <profile id="ee2f-44e5-562a-54e5" name="Warlord Trait: Hammer of the Khan" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord has the Hammer of Wrath special rule.  If he already has this special rule, he makes D3 additional attacks instead of 1."/>
                  </characteristics>
                </profile>
                <profile id="67ac-789f-9408-c1ad" name="Warlord Trait: Master Rider" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Add 1 to the result of any Jink saves you make for your Warlord if he is equipped with a Space Marine bike.  If he is not, treat this result as Deadly Ambush instead."/>
                  </characteristics>
                </profile>
                <profile id="7eb7-4aed-8377-9b1e" name="Warlord Trait: Hunter&apos;s Insticts" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord has the Monster Hunter and Tank Hunters special rules."/>
                  </characteristics>
                </profile>
                <profile id="cf07-9e01-7433-1788" name="Warlord Trait: Unrivalled Hunter" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
