                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord has the Hatred (Psykers) and Preferred Enemy (Psykers) special rules."/>
                  </characteristics>
                </profile>
                <profile id="984b-dfc7-5128-12e3" name="Warlord Trait: Furious Indignation" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="If your Warlord&apos;s unit fails a Morale check in the Psychic or Shooting phase, then instead of Falling Back they will immediately move 2D6&quot; towards the nearest enemy unit (but must end this move 1&quot; away from other units as normal)."/>
                  </characteristics>
                </profile>
                <profile id="91ab-1a1d-2a78-b2c7" name="Warlord Trait: Honour Demands Combat" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="You can re-roll failed charge rolls for your Warlord and his unit."/>
                  </characteristics>
                </profile>
                <profile id="6ecb-814f-e428-4fbe" name="Warlord Trait: Master Swordsman" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Add 1 to your Warlord&apos;s Weapon Skill and Attacks characteristics."/>
                  </characteristics>
                </profile>
                <profile id="b8dd-f01f-fad5-52a6" name="Warlord Trait: Unyielding Determination" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord and all friendly units within 12&quot; of him re-roll all failed Morale, Pinning, and Fear tests."/>
                  </characteristics>
                </profile>
                <profile id="ecda-2396-6cb0-d544" name="Warlord Trait: Oathkeeper" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
