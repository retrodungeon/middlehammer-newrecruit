    <selectionEntry id="629a-bba7-5ad0-a402" name="(FW) Bray&apos;arth Ashmantle" hidden="false" collective="false" categoryEntryId="" type="model">
      <profiles>
        <profile id="a939-882c-d2e7-bf24" name="Warlord Trait: Engine of Destruction" book="IA: Volume 10" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="The army gains 1 Victory point for each vehicle with at least one Armour Value of 12 or more and/or Independent Character that Bray&apos;arth Ashmantle destroys in an assault which involves no other friendly models in the combat."/>
          </characteristics>
        </profile>
        <profile id="fef3-d1f5-b31c-4e38" name="Bray&apos;arth Ashmantle" book="IA: Volume 10" hidden="false" profileTypeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" profileTypeName="Walker">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="WS" characteristicTypeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e" value="6"/>
            <characteristic name="BS" characteristicTypeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5" value="5"/>
            <characteristic name="S" characteristicTypeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b" value="6"/>
            <characteristic name="Front" characteristicTypeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f" value="13"/>
            <characteristic name="Side" characteristicTypeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e" value="12"/>
            <characteristic name="Rear" characteristicTypeId="0a9f33cb-0412-420a-89d2-20707c360bd2" value="10"/>
            <characteristic name="I" characteristicTypeId="a558b3ef-04d0-440e-a312-bac3255bf592" value="4"/>
            <characteristic name="A" characteristicTypeId="5dff3e7c-e024-4030-a71d-03195ec06ea7" value="4"/>
            <characteristic name="HP" characteristicTypeId="ae95a1af-719f-4365-b951-33cd3ca9148a" value="4"/>
            <characteristic name="Type" characteristicTypeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" value="Vehicle (Walker)"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="3859-ca86-68b3-b64c" name="Wrought by Vulkan" book="IA: Volume 10" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Bray&apos;arth Ashmantle&apos;s Dreadnought chassis, the &apos;Iron Dragon&apos; is a unique relic immune to the particular effects of the Melta, Rending, Armourbane, and Lance special rules.  Any other rules which either reduce his Armour Value or allow attacks which target him to roll more than one dice when making an Armour Penetration check have no effect against the Dreadnought.</description>
        </rule>
        <rule id="9c11-040c-deaf-fe9b" name="Burning Wrath" book="IA: Volume 10" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Bray&apos;arth Ashmantle may forfeit one of his usual close combat attacks in order to inflict one automatic S5 AP4 hit on every model (friend and foe) in base contact with him at Initiative step one. The rest of his attacks are made as normal. Note that this is not the effect of a single weapon and so is not affected by Weapon Destroyed results.</description>
        </rule>
      </rules>
