        <selectionEntry id="2bac-ce64-be38-6d28" name="Land Raider Excelsior" hidden="false" collective="false" type="model">
          <profiles>
            <profile id="952e-ae20-49e2-5df2" name="Land Raider Excelsior" book="Warhammer World Exclusive" hidden="false" profileTypeId="725a358c-765b-498c-8de5-399fc0c0725f" profileTypeName="Vehicle">
