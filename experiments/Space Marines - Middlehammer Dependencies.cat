        <profile id="5f6f-b391-8906-6eca" name="Warlord Trait: Angel of Death" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Shadow Captain Solaq has the Fear special rule. Furthermore, enemy units locked in combat with the Warlord must take Fear tests on 3D6"/>
          </characteristics>
        </profile>
        <profile id="f30b-9c1b-6148-b467" name="Chapter Relic: The Raven Helm" book="Supplement: War Zone Damocles" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Non-vehicle units that target Shadow Captain Solaq or his unit with a shooting attack must first pass a Leaderhsip test. If this test is failed, that unit can only fire snap Shots for the rest of the turn."/>
          </characteristics>
        </profile>
      </profiles>
