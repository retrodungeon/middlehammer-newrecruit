        <profile id="aa5a-4668-61f2-021c" name="Warlord Trait: Legendary Fighter" book="IA: Volume 10" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="The army gains 1 Victory point for each enemy character slain by the Warlord in a challenge."/>
