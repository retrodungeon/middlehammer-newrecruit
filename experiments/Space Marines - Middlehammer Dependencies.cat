    <profile id="b718-b82d-98a1-0ea3" name="Warlord Trait: Champion of Humanity" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
