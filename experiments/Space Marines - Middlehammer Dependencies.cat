    <selectionEntry id="1998-cd2d-3636-614c" name="Formation: Shadowstrike Kill Team" book="Angels of Death" page="63" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="36e4-fc22-3c24-3b5f" name="On Time..." book="Supplement: Angels of Death" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Instead of rolling to see whether a unit of Vanguarg Veterans from this Formation arrives from Reserve, you can choose whether to pass or fail that roll.</description>
        </rule>
        <rule id="228b-3ca2-0b8b-279e" name="...On Target" book="Supplement: Angels of Death" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Vanguard Veteran Squads from this Formation can charge on the turn they arrive from Deep Strike if the first model is placed within 9&quot; of at least two Scout Squads from this Formation.</description>
        </rule>
      </rules>
      <infoLinks/>
      <modifiers/>
      <constraints/>
      <selectionEntries/>
      <selectionEntryGroups/>
