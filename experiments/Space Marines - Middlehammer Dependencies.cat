              <profiles>
                <profile id="799a-e733-85d6-6c58" name="Warlord Trait: Anvil of Strength" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
