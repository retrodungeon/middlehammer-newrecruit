    <selectionEntry id="c36d-33cd-532d-28c9" name="(FW) Caestus Assault Ram" hidden="false" collective="false" type="model">
      <profiles>
        <profile id="19f6-6c11-bf3f-bad9" name="Caestus Assault Ram" book="IA: Aeronautica" hidden="false" profileTypeId="3a08-ea03-a598-8615" profileTypeName="Flyer">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="BS" characteristicTypeId="9878-e3f6-b7b4-7225" value="4"/>
            <characteristic name="Front" characteristicTypeId="3a4e-bc1d-4a12-7176" value="13"/>
            <characteristic name="Side" characteristicTypeId="d12e-7bdb-191c-4849" value="13"/>
