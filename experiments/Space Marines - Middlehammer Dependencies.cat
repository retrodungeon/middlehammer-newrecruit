                  </characteristics>
                </profile>
                <profile id="469b-45a2-ec4e-a3d1" name="Warlord Trait: Warden of Ultramar" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
