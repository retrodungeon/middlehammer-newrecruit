    <selectionEntry id="c00d-9ee7-8e27-dc95" name="Chapter Relic (IH): The Tempered Helm" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="28ff-00f6-1344-015b" name="Chapter Relic (IH): The Tempered Helm" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
