                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="As long as your Warlord is alive, at the beginning of each of your turns, you can discard an active Tactical Objective.  If you do so, you can generate a new Tactical Objective.  Re-roll this result if you are not playing a mission with the Tactical Objectives special rule."/>
                  </characteristics>
                </profile>
                <profile id="e004-2bc6-d643-4fae" name="Warlord Trait: Adept of the Codex" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
