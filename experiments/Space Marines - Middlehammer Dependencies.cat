            <selectionEntry id="ae1a-0131-077a-64f8" name="Novamarines" hidden="false" collective="false" type="model">
              <profiles/>
              <rules/>
              <infoLinks>
                <infoLink id="e5ca-e1fc-9df1-14b8" name="" hidden="false" targetId="b297-3dd6-2ea1-5b85" type="rule">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                </infoLink>
              </infoLinks>
              <modifiers>
                <modifier type="set" field="d20f-acb0-75de-c05d" value="1">
                  <repeats/>
                  <conditions/>
                  <conditionGroups>
                    <conditionGroup type="and">
