                <profile id="c8d2-1dea-b023-4cf3" name="Warlord Trait: Storm of Fire" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="At the start of each of your Shooting phases, nominate on friendly unit within 12&quot; of your Warlord that is drawn from the same Chapter as your Warlord.  That unit&apos;s ranged weapons have the Rending special rule until the end of the phase."/>
                  </characteristics>
                </profile>
                <profile id="f5f4-9635-ea5f-d931" name="Warlord Trait: The Imperium&apos;s Sword" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
