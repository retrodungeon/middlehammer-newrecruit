      <selectionEntries>
        <selectionEntry id="fac2-d750-07b2-f55c" name="Chapter Relic: Moonfang" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="8663-2861-6cda-5fab" name="Chapter Relic: Moonfang" book="Codex: Space Marines" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
              <profiles/>
              <rules/>
              <infoLinks/>
              <modifiers/>
              <characteristics>
                <characteristic name="Range" characteristicTypeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" value="-"/>
                <characteristic name="Strength" characteristicTypeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" value="User"/>
                <characteristic name="AP" characteristicTypeId="6abee736-f8d3-498e-97ac-a5c68445609f" value="3"/>
                <characteristic name="Type" characteristicTypeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" value="Melee, Prey&apos;s Bane"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="781a-4076-6f7d-53a4" name="Prey&apos;s Bane" book="Codex: Space Marines" hidden="false">
              <profiles/>
              <rules/>
              <infoLinks/>
              <modifiers/>
              <description>When attacking with a weapon that has this special rule, a To Wound roll of 6 causes a Wound regardless of the target&apos;s Toughness.  This Wound is resolved with the Instant Death special rule.</description>
            </rule>
          </rules>
          <infoLinks/>
          <modifiers/>
