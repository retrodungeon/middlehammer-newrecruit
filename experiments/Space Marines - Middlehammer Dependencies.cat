    <profile id="43b5-e1a1-2660-1b32" name="Artificer Armour" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Artificer Armour confers a 2+ Armour Save."/>
      </characteristics>
    </profile>
    <profile id="1f6d-19c4-e3e6-eb87" name="Terminator Armour" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Terminator armour confers a 2+ Armour Save and a 5+ Invulnerable save. Furthermore, models in Terminator Armour have the Bulky, Deep Strike, and Relentless special rules, and may not make Sweeping Advances."/>
      </characteristics>
    </profile>
    <profile id="f6a7-807d-9dab-4e7c" name="Ceramite Plating" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Melta weapons do not roll an extra D6 armour penetration when shooting a vehicle equipped with ceramite plating at half range or less."/>
      </characteristics>
    </profile>
    <profile id="8ce0-96c6-57d8-df37" name="Frag Assault Launchers" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Any unit charging into close combat on the same turn as it disembarks from a transport vehicle equipped with frag assault launchers counts as having frag grenades."/>
      </characteristics>
    </profile>
    <profile id="eab5-fdde-e721-fd3a" name="Siege Shield" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="A vehicle with a siege shield automatically passes Dangerous Terrain tests."/>
      </characteristics>
    </profile>
    <profile id="d1d7-06a9-ef45-864b" name="Storm Shield" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="A storm shield confers a 3+ invulnerable save. In addition, a model equipped with a storm shield can never claim the +1 Attack for being armed with two Melee weapons in an assault."/>
      </characteristics>
    </profile>
    <profile id="da6b-8ab5-1a7b-d846" name="Teleport homer" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Friendly unit composed entirely of models in Terminator armour do not scatter when they Deep Strike, so long as the first model is placed within 6&quot; of the teleport homer&apos;s bearer.  For this to work, the bearer of the teleport homer must have been on the battlefield at the start of the turn."/>
      </characteristics>
    </profile>
    <profile id="b5b3-1240-b17a-26ff" name="Combi-Bolter" book="Supplement: Angels of Death" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Range" characteristicTypeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" value="24&quot;"/>
        <characteristic name="Strength" characteristicTypeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" value="4"/>
        <characteristic name="AP" characteristicTypeId="6abee736-f8d3-498e-97ac-a5c68445609f" value="5"/>
        <characteristic name="Type" characteristicTypeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" value="Rapid Fire, Twin-linked"/>
      </characteristics>
    </profile>
    <profile id="ce80-9d54-555b-abf3" name="Atomantic Shielding" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="A Contemptor Dreadnought has a 5+ invulnerable save against all shooting attacks, and a 6+ invulnerable save against all close combat attacks. In addition, if a Contemptor Dreadnought suffers an Explodes! result on the Vehicle Damage table, add 1&quot; to the radius of the resulting explosion."/>
      </characteristics>
    </profile>
    <profile id="5a0f-751c-e77a-5c81" name="Cataphractii Terminator Armour" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
      <profiles/>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Cataphractii Terminator armour confers a 2+ Armour Save and a 4+ invulnerable save.  Furthermore, models in Cataphractii Terminator armour have the Bulky, Deep Strike, and Slow and Purposeful special rules.  A Terminator Captain wearing Cataphractii Terminator armour also re-rolls invulnerable saving throws of 1 to represent the overlapping energy fields projected from both his iron halo and his armour&apos;s in-built shield generators.  A model wearing Cataphractii Terminator armour counts as wearing Terminator Armour for the purposes of embarking within Transport vehicles, the use of teleport homers, and for the purposes of Formation Restrictions."/>
      </characteristics>
    </profile>
