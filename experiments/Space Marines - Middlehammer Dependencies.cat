                <profile id="fb7f-9e58-ea8f-d520" name="Warlord Trait: Merciless Resolve" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
