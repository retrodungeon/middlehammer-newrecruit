    <selectionEntry id="3115-3d92-ac62-43d6" name="Chapter Relic (IF): The Angel of Sacrifice" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="b337-305d-1971-64ee" name="Chapter Relic (IF): The Angel of Sacrifice" book="Supplement: Angels of Death" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Range" characteristicTypeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464" value="-"/>
            <characteristic name="Strength" characteristicTypeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" value="+2"/>
            <characteristic name="AP" characteristicTypeId="6abee736-f8d3-498e-97ac-a5c68445609f" value="4"/>
            <characteristic name="Type" characteristicTypeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" value="Melee, Concussive, Only in Death"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5da2-ac82-0cc0-922c" name="Only in Death" book="Supplement: Angels of Death" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>If the bearer of the Angel of Sacrifice loses his last Wound in the Assault phase, he is not removed as a casualty until after all close combat attack have been resolved, and can thus still attack if he is slain either by Overwatch or by a close combat attack made at a higher Initiative step.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="003a-63eb-0001-c1fb" name="" hidden="false" targetId="d0ea-e2a6-032d-8754" type="rule">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
        </infoLink>
      </infoLinks>
      <modifiers/>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b36d-6bb4-81cd-18b8" type="max"/>
      </constraints>
      <selectionEntries/>
      <selectionEntryGroups/>
      <entryLinks/>
      <costs>
        <cost name="pts" costTypeId="points" value="10.0"/>
      </costs>
    </selectionEntry>
