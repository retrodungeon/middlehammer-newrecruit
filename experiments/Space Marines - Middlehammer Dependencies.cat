            </selectionEntry>
            <selectionEntry id="983e-4995-e88b-3806" name="Salamanders" hidden="false" collective="false" categoryEntryId="(No Category)" type="upgrade">
              <profiles/>
              <rules>
                <rule id="d39c-1768-01dd-831c" name="Flamecraft" book="Codex: Space Marines" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <description>Salamanders models have the Feel No Pain (4+) special rule against Wounds caused by flamer weapons (as defined in Warhammer 40,000: The Rules). Furthermore, when using flamer weapons, Salamanders models can re-roll failed To Wound rolls and armour penetration rolls that do not result in a glancing or penetrating hit.</description>
                </rule>
                <rule id="f75b-6fbf-6f82-ad5d" name="Master Artisans" book="Codex: Space Marines" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <description>During army selection, each Salamanders character may upgrade one of his weapons (even one purchased as an upgrade, but not a Chapter Relic or Relic of Nocturne) to have the Master-Crafted special rule</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f154-b45a-5ce2-ea3a" name="" hidden="false" targetId="3c7d-11d6-e265-abb4" type="rule">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                </infoLink>
                <infoLink id="aa7d-88aa-1b57-5566" name="" hidden="false" targetId="609e-1ee4-78c1-0ba1" type="rule">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                </infoLink>
