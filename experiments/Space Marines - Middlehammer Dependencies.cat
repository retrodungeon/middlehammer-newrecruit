    <selectionEntry id="b9fb-fe5e-fa95-3411" name="Chapter Relic (WS): The Hunter&apos;s Eye" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="f329-aae6-e151-3c6c" name="Chapter Relic (WS): The Hunter&apos;s Eye" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="A model equipped with the Hunter&apos;s Eye adds one to his Ballistic Skill and all his ranged weapons have the Ignores Cover special rule.  Whilst a model equipped with the Hunter&apos;s Eye is part of a unit, all other ranged weapons carried by models in that unit also have the Ignores Cover special rule."/>
          </characteristics>
        </profile>
      </profiles>
