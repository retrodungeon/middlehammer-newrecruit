            <selectionEntry id="9dc7-a061-d8cc-5b1b" name="Imperial Fists" hidden="false" collective="false" categoryEntryId="(No Category)" type="upgrade">
              <profiles/>
              <rules>
                <rule id="c357-ca21-fb9a-5841" name="Centurion Warsuits" book="Codex: Space Marines" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <description>Centurion Devastator Squads can be taken as elites choices as well as heavy support choices in an Imperial Fists or Sentinels of Terra detachment.

Centurion Assault Squads can be taken as fast attack choices as well as elites choices in an Imperial Fists or Sentinels of Terra detachment.</description>
                </rule>
                <rule id="9318-4da5-fa41-11bf" name="Close Ranged Bolter Dril" book="Suppliment: Sentinels of Terra" hidden="false">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers>
                    <modifier type="set" field="hidden" value="true">
                      <repeats/>
                      <conditions>
                        <condition field="selections" scope="force" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" childId="a18e-b381-e89e-29d2" type="lessThan"/>
                      </conditions>
                      <conditionGroups/>
                    </modifier>
                  </modifiers>
                  <description>Models with this rule re-roll all failed To Hit rolls made with boltguns when firing at a target up to half the weapon&apos;s maximum range away.  This rule does not apply to models firing Hellfire, Kraken, Vengeance or Dragonfire rounds.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="ac8b-4c2e-22b3-7369" name="" hidden="false" targetId="3e00-873e-d988-ce5c" type="rule">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers>
                    <modifier type="set" field="hidden" value="true">
                      <repeats/>
                      <conditions>
                        <condition field="selections" scope="force" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" childId="a18e-b381-e89e-29d2" type="equalTo"/>
                      </conditions>
