          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="cde8-4782-945c-649a" name="Reinforced Atomantic Shielding" book="IA: Datasheets" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>A Leviathan Dreadnought has a 4+ invulnerable save. In addition, if the Leviathan suffers a Vehicle Explodes damage result, add +D3 Str and +D3&quot; to the radius of the blast.</description>
        </rule>
        <rule id="36ac-ca83-0d91-db33" name="Crushing Charge" book="IA: Datasheets" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>When charging, the model inflicts 2 Hammer of Wrath attacks and gains +1 Initiative in the Assault phase of any turn in which it has charged.</description>
        </rule>
        <rule id="36f5-fdb7-dbbb-7211" name="Relic of Darkness" book="IA: Datasheets" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Counts as a Relic of the Armoury, but may not take a Legacy of Glory upgrade. In addition, a model with this special rule is immune to Malediction psychic powers, can never be a scoring unit and must always make charges and Sweeping Advances if they are able. A model with this special rule may not benefit from any rules or bonuses usually conferred by being part of a particular Chapter, detachment, or formation.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9c21-f0df-0350-529c" name="" hidden="false" targetId="7ecc-bc3d-6e22-63dc" type="rule">
