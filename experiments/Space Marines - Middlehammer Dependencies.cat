                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="When firing the heavy conversion beamer, place the blast marker over a target within 72&quot; and then roll for scatter.  Once the final location of the blast marker has been determined, measure the distance from the firer to the center of the blast marker and consult the chart below to determine the effect.  If this distance is greater than 72&quot;, the shot mises.  If it is not clear which of the profiles to use, the controlling player can choose."/>
