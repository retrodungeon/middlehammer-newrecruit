    <selectionEntry id="18bf-3b9b-1e38-57ee" name="Formation: Strike Force Ultima" book="Strike Force Ultima Box" page="" hidden="false" collective="false" type="upgrade">
      <profiles/>
      <rules>
        <rule id="fcab-7a7b-8468-65df" name="Ultimate Strike" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>During deployment, all units in this Formation must be placed in Reserve. All non-vehicle units from this Formation must either be embarked on a Transport vehicle from the Formation, or placed in Deep Strike Reserve. All of the units in this Formation, including Flyers, arrive from Reserve on your first turn (there is no need to roll).</description>
        </rule>
        <rule id="075c-3100-ce65-c46c" name="Ultimate Storm" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>When a unit from this Formation arrives from Reserve, or disembarks from a Transport vehicle for the 1st time, all ranged weapons carried by models in the unit add 1 to the number of shots they can make until the end of the turn.</description>
        </rule>
      </rules>
