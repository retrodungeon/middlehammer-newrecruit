              <profiles>
                <profile id="e830-dd6c-fcb8-2ac6" name="Aquila Aegis Field" book="Warhammer World Exclusive" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
