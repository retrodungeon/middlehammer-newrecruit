            <characteristic name="Strength" characteristicTypeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45" value="+3"/>
            <characteristic name="AP" characteristicTypeId="6abee736-f8d3-498e-97ac-a5c68445609f" value="2"/>
            <characteristic name="Type" characteristicTypeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2" value="Melee, Blind, Incandescant"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5f57-4b09-5007-0897" name="Incandescent" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>At the end of an Assault phase in which the bearer made one or more To Hit rolls with the Burning Blade, roll a D6.  On a roll of 2+, nothing happens.  On a roll of a 1, the bearer takes a Strength 4 AP2 hit.</description>
        </rule>
      </rules>
