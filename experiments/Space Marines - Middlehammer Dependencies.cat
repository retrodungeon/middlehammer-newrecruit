    <selectionEntry id="66b1-3ec6-d7fc-c7c5" name="Formation: Wrathful Crusade" book="" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="09fa-e37a-49ca-baa2" name="​ Collective Fanaticism" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>​If the Wrathful Crusade contains the maximum number of units, then all units in this Formation gain the Zealot special rule.</description>
        </rule>
        <rule id="1482-1b21-a272-e920" name="​ Unbridled Fury" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>​All units in the Wrathful Crusade can re-roll failed charge rolls. In addition, if you roll a 10 or more when determining the charge distance of a unit from the Wrathful Crusade, all models in that unit have the Furious Charge special rule for that turn</description>
        </rule>
      </rules>
      <infoLinks/>
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <repeats/>
          <conditions>
