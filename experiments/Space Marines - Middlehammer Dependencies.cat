            <selectionEntry id="8318-cf5a-df3f-1973" name="Ultramarines" book="Gathering Storm: Rise of the Primarch" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="791f-ddf9-c117-f6c8" name="Warlord Trait: Paragon of War" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
