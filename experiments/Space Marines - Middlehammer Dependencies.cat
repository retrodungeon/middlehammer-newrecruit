                  </characteristics>
                </profile>
                <profile id="69d8-801f-f1c5-2659" name="Warlord Trait: Wise Commander" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
