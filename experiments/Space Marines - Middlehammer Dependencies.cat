                <profile id="ad99-d8ba-62d2-137e" name="Warlord Trait: Merciless Warrior" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
