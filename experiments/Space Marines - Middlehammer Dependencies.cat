    <selectionEntry id="e570-4cbc-6389-003a" name="Formation: Ultramarines 1st Company" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="ce31-7b58-3ecf-163c" name="Veteran Doctrine" book="Supplement: Blood Oath" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>When activating either the Devastator, Assault or Tactical Doctrine as part of the Ultramarines Chapter Tactics, units from this Formation instaed re-roll all failed to Hit rolls in the Shooting and Assault phases of that turn.</description>
