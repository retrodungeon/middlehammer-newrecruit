                <profile id="ae3a-db18-f069-f260" name="Warlord Trait: Pain is for Lesser Warriors" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
