            <selectionEntry id="f83f-c102-c344-65cb" name="Space Marines" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="70ff-0b3a-8abc-0b18" name="Warlord Trait: Angel of Death" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord has the Fear special rule. Furthermore, enemy units locked in combat with the Warlord must take Fear tests on 3D6"/>
                  </characteristics>
                </profile>
                <profile id="7202-3a16-ba4b-f41b" name="Warlord Trait: Champion of Humanity" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord, and all friendly units within 12&quot; of your Warlord with a Faction that is part of the Armies of the Imperium must re-roll failed Morale checks, Pinning tests, and fear tests."/>
                  </characteristics>
                </profile>
                <profile id="7701-e440-7f9f-3427" name="Warlord Trait: Iron Resolve" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord has the Feel No Pain special rule."/>
                  </characteristics>
                </profile>
                <profile id="47f1-ab89-a2a1-3291" name="Warlord Trait: Rites of War" book="Codex: Space Marines" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="All models in your Warlord&apos;s Detachment can use his Leadership value in place of their own."/>
                  </characteristics>
