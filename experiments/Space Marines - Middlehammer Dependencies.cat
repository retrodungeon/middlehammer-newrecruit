    <selectionEntry id="9181-a819-5447-e8b4" name="Formation: 1st Company Task Force" book="Codex: Space Marine" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="29c5-988c-bef2-1efe" name="Extremis Level Threat" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>At the start of the game, before deployment, nominate one unit in the enemy army.  Units in this Formation have the Preferred Enemy special rule when making attacks against the nominated unit.</description>
        </rule>
        <rule id="0ff3-e411-5db7-025b" name="Terrifying Proficiency" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Enemy units subtrat 2 from their Leadership whilst they are within 12&quot; of at least three units from this Formation.</description>
        </rule>
      </rules>
