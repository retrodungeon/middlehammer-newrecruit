    <selectionEntry id="66d4-6e65-9f4f-df65" name="Formation: Armoured Task Force" book="Codex: Space Marine" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="bc77-261f-c407-c23b" name="Paregoric Cant" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Vehicles from this Formation ignore the effects of Crew Shaken and Crew Stunned results while they are within 6&quot; of the Techmarine or a Techmarine Gunner from this Formation</description>
        </rule>
        <rule id="20ea-84ab-0f34-7f3b" name="The Will of the Omnissiah" book="Codex: Space Marines" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>The Techmarine and Techmarine Gunners from this Formation have a +1 bonus when making Blessings of the Omnissiah rolls to repair vehicles from this Formation.</description>
        </rule>
      </rules>
      <infoLinks/>
      <modifiers/>
      <constraints/>
      <selectionEntries/>
      <selectionEntryGroups>
