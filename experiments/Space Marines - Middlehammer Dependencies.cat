          <profiles>
            <profile id="b07e-a549-5d8d-e2c7" name="Dreadfire Heavy Flamer (Heavy Flamer)" book="IA: Volume 10" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles/>
              <rules/>
