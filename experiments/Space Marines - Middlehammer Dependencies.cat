    <selectionEntry id="8b71-4c20-4dba-0ec6" name="Formation: Stormbringer Squadron" book="Angels of Death" page="60" hidden="false" collective="false" type="unit">
      <profiles/>
      <rules>
        <rule id="22fb-3127-2922-c405" name="Locate and Secure" book="Supplement: Death from the Skies" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Scout Squads from this Formation (bot not their Land Speeder Storms) have the Objective Secured special rule.</description>
        </rule>
        <rule id="8d52-3d37-b713-be88" name="Outrider Support" book="Supplement: Death from the Skies" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Land Speeder Storms from this Formation receive a +1 bonus to any Jink saves if they are within 6&quot; of a Land Speeder from this formation.</description>
        </rule>
        <rule id="d7ed-daf3-795a-76c5" name="Rapid Deployment" book="Supplement: Death from the Skies" hidden="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <description>Scout Squads from this Formation can disembark from their Land Speeder Storm after it has moved, so long as it has not moved more than 12&quot;.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="bcb7-dadf-bcb7-4ce0" name="" hidden="false" targetId="4764-48d9-da41-afaa" type="rule">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
        </infoLink>
      </infoLinks>
      <modifiers/>
      <constraints/>
      <selectionEntries/>
      <selectionEntryGroups/>
      <entryLinks>
        <entryLink id="f992-0ac3-c94c-4d92" name="" hidden="false" targetId="6f08-194e-a422-37e6" type="selectionEntry">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
