                <profile id="8e06-3f4e-3ead-b4aa" name="Warlord Trait: Forge Master" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
