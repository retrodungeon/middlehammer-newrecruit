    <selectionEntry id="e8da-4376-f352-15a4" name="Chapter Relic (UM): The Standard of Macragge Involate" book="Gathering Storm: Rise of the Primarch" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="65c0-a56a-5485-aec1" name="The Standard of Macragge Involate" book="Gathering Storm: Rise of the Primarch" page="" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers/>
          <characteristics>
            <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Friendly Ultramarines units within 12&quot; of the bearer of this standard add 1 to their Leadership characteristic.  In addition, the bearer and his unit have +1 attack while the bearer is alive.  Finally, roll a dice each time a friendly Ultramarines Infantry model is killed within 6&quot; of this standard, before removing the model as a casualty; on a 6+ that Space Marine can make an out-of-sequence shooting attack if it is the Movement, Psychic or Shooting phase, or pile in and make its attacks if it is the Fight sub-phase (at the normal Initiative step)."/>
          </characteristics>
        </profile>
      </profiles>
      <rules/>
      <infoLinks/>
      <modifiers/>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a187-1926-d5ec-815e" type="max"/>
      </constraints>
      <selectionEntries/>
      <selectionEntryGroups/>
      <entryLinks/>
      <costs>
        <cost name="pts" costTypeId="points" value="60.0"/>
      </costs>
    </selectionEntry>
