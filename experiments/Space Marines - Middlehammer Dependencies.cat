            <profile id="7aa1-1514-59c1-68a8" name="Psyk-out Grenades" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" profileTypeName="Weapon">
