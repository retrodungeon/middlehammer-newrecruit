        <selectionEntryGroup id="7402-157b-0813-4d40" name="Forgeworld" hidden="false" collective="false">
          <profiles/>
          <rules/>
          <infoLinks/>
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <repeats/>
              <conditions>
                <condition field="selections" scope="force" value="0.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" childId="bb6a-5a75-ad72-502d" type="equalTo"/>
              </conditions>
