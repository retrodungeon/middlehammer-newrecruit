                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord and all friendly units within 6&quot; of him have the Split Fire special rule."/>
                  </characteristics>
                </profile>
                <profile id="a9f5-781e-9522-b72d" name="Warlord Trait: Noble Visage" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
                  <profiles/>
                  <rules/>
                  <infoLinks/>
                  <modifiers/>
                  <characteristics>
                    <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="Your Warlord, and all friendly units within 12&quot; of your Warlord with a Faction that is part of the Armies of the Imperium, must re-roll failed Morale checks, Pinning Tests, and Fear tests."/>
                  </characteristics>
                </profile>
                <profile id="9c02-e06b-cdfa-20c9" name="Warlord Trait: Master of Strategy" book="Gathering Storm: Rise of the Primarch" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
