                <profile id="9b32-278c-c4cf-b2b4" name="Warlord Trait: Lord of Fire" book="Supplement: Angels of Death" hidden="false" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" profileTypeName="Wargear Item">
