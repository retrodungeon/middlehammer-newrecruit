      <infoLinks />
      <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="mh-sh-ee8b-68c8-02226-2d18-hide-05eaf" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-ee8b-68c8-02226-2d18" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers>
