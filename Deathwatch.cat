        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with a siege shield automatically passes Dangerous Terrain tests.</characteristic>
      </characteristics>
    </profile>
    <profile id="78739177-210f-dafa-9225-76de4f2837e5-05eaf" name="Signum " page="195" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Shooting phase, a model with a signum can choose to use it instead of shooting. If he does so, one model in his unit is Ballistic Skill 5 for the remainder of the Shooting phase. Declare that the signum is being used before any rolls To hit are made.</characteristic>
      </characteristics>
    </profile>
    <profile id="b2b9d48b-7476-c812-d0c9-621c3c072d46-05eaf" name="Smoke Launchers " hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, instead of shooting or moving flat out, may gain a 5+ cover save</characteristic>
      </characteristics>
    </profile>
