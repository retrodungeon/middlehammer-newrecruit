      <selectionEntries>
        <selectionEntry id="a3ac-a95a-08ed-a3b9-05eaf" name="Twin-linked Castigator Pattern Bolt Cannon" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="7a0a-6e4f-78b5-0f08-05eaf" name="Castigator Pattern Bolt Cannon" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
