      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units do not scatter when they Deep Strike, so long as the first model is placed within 6" of a model with a locator beacon. The locator beacon must have been on the battlefield at the start of the turn in order for it to be used. </characteristic>
