    </profile>
    <profile id="6c3b-b7f0-3a27-8d8e-05eaf" name="Atomantic Shielding" page="57" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Contemptor Dreadnought has a 5+ invulnerable save against all shooting attacks, and a 6+ invulnerable save against all close combat attacks. In addition, if a Contemptor Dreadnought suffers an Explodes! result on the Vehicle Damage table, add 1" to the radius of the resulting explosion.</characteristic>
      </characteristics>
    </profile>
    <profile id="37591ce3-75cb-04e3-fbf3-b24c277514e0-05eaf" name="Auspex " page="194" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Forego shooting to make an enemy unit within 12" reduce it's cover save by 1, untill the end of the phase. This does not count as choosing a target for his unit to shoot at.</characteristic>
      </characteristics>
    </profile>
    <profile id="e229-ef43-2e39-fdc2-05eaf" name="Auspex Array" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Corvus Blackstar equipped with an Auspex Array has the Strafing Run special rule.</characteristic>
      </characteristics>
    </profile>
    <profile id="e2d3e5e2-de81-804c-7e43-396a4dfd1b34-05eaf" name="Autocannon" page="176" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
