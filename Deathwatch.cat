    <profile id="deaa33cb-d0a7-5bd2-c810-d77f2f26d12c-05eaf" name="Artificer Armour " page="196" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Confers a 2+ armour save</characteristic>
      </characteristics>
    </profile>
