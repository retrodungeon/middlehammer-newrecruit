    <profile id="b43dc580-1947-00a2-3d67-03bde443112b-05eaf" name="Digital Weapons " page="194" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model armed with digital weapons can re-roll a single failed to wound roll in each assault phase.</characteristic>
      </characteristics>
    </profile>
    <profile id="ecb6-c34d-f547-f095-05eaf" name="Dominus Aegis" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model equipped with the Dominus Aegis does not move in the Movement phase, its unit gains a 4+ invulnerable save until the start of your next Movement phase.</characteristic>
      </characteristics>
    </profile>
