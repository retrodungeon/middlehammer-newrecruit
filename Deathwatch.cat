            </profile>
            <profile id="f45d-0282-ab4d-3be3-05eaf" name="Atrapos Lascutter - Close Combat" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
