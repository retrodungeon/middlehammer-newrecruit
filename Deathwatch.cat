        <selectionEntryGroup id="fece-f090-e9cb-6281-05eaf" name="Legacies of Glory (Walker+SH)" hidden="true" collective="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <constraints />
          <selectionEntries>
            <selectionEntry id="323f-63ad-69d3-88b6-05eaf" name="Ullanor Crusade" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="063e-d003-6ef5-4f33-05eaf" name="Ullanor Crusade" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Adreadnought with the Ullanor Crusade gains the Hatred (Orks) Special Rule  Enemy models charging a vehicle with the Ullanor Crusade Legacy of Glory must re-roll successful To Hit rolls in the first round of each combat.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules />
              <infoLinks />
              <modifiers />
              <constraints>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="323f-63ad-69d3-88b6-maxInRoster-05eaf" type="max" />
              </constraints>
              <selectionEntries />
              <selectionEntryGroups />
              <entryLinks />
              <costs>
                <cost name="Points" value="40.0" typeId="6f18-a8fc-2c5b-9517" />
              </costs>
            </selectionEntry>
            <selectionEntry id="2d0a-bfcf-7ac4-8a71-05eaf" name="War of Murder" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="83b4-510f-411c-d7a6-05eaf" name="War of Murder" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
