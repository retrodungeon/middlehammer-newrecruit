        <constraint field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cba2-17fe-f1c4-0d4c-minInForce-05eaf" type="min" />
        <constraint field="selections" scope="force" value="-1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cba2-17fe-f1c4-0d4c-maxInForce-05eaf" type="max" />
        <constraint field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cba2-17fe-f1c4-0d4c-minInRoster-05eaf" type="min" />
        <constraint field="selections" scope="roster" value="-1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cba2-17fe-f1c4-0d4c-maxInRoster-05eaf" type="max" />
        <constraint field="6f18-a8fc-2c5b-9517" scope="parent" value="0.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="cba2-17fe-f1c4-0d4c-minPoints-05eaf" type="min" />
        <constraint field="6f18-a8fc-2c5b-9517" scope="parent" value="-1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="cba2-17fe-f1c4-0d4c-maxPoints-05eaf" type="max" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="be85-6006-90ca-32c0-05eaf" name="Storm Bolter" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules />
          <infoLinks>
            <infoLink id="b015-44bc-4752-2bf2-05eaf" hidden="false" targetId="505e-a5aa-edab-6d5b" type="profile">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            </infoLink>
          </infoLinks>
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="be85-6006-90ca-32c0-maxSelections-05eaf" type="max" />
          </constraints>
          <selectionEntries />
          <selectionEntryGroups />
          <entryLinks />
          <costs>
            <cost name="Points" value="5.0" typeId="6f18-a8fc-2c5b-9517" />
          </costs>
        </selectionEntry>
        <selectionEntry id="a557-20cf-4e88-c03c-05eaf" name="Extra Armour" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules />
          <infoLinks>
            <infoLink id="391f-5842-560e-757e-05eaf" hidden="false" targetId="fcd538df-29d4-d39a-d1bd-f89dc0a34e57-05eaf" type="profile">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            </infoLink>
          </infoLinks>
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a557-20cf-4e88-c03c-maxSelections-05eaf" type="max" />
          </constraints>
          <selectionEntries />
          <selectionEntryGroups />
          <entryLinks />
          <costs>
            <cost name="Points" value="10.0" typeId="6f18-a8fc-2c5b-9517" />
          </costs>
        </selectionEntry>
        <selectionEntry id="0ff9-317c-95e0-63de-05eaf" name="Hunter-killer Missle" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules />
          <infoLinks>
            <infoLink id="4802-cf80-6559-b2de-05eaf" hidden="false" targetId="ee350a03-c47c-8a67-c1fc-dcd3eef7cec9-05eaf" type="profile">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            </infoLink>
          </infoLinks>
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0ff9-317c-95e0-63de-maxSelections-05eaf" type="max" />
          </constraints>
