              <entryLinks />
              <costs>
                <cost name="Points" value="100.0" typeId="6f18-a8fc-2c5b-9517" />
              </costs>
            </selectionEntry>
            <selectionEntry id="e160-96ce-294c-64a8-05eaf" name="Shrouded Provenance" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="b85b-c67e-1a57-e38c-05eaf" name="Shrouded Provenance" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Venerable special rule.  The vehicle always counts as an Ally of Convience to units in its own detachment, and as a Desperate Ally to units in any allied detachment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules />
