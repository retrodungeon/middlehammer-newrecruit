    <profile id="7e2d-4943-2ce8-e635-05eaf" name="Banebolts of Eryxia" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model that is equipped with Banebolts of Eryxia can use the following special issue ammunition (pg 105), in addition to any other type it can normally use.                                                                                                                                                  Bolt Pistol  - Range 12", Str5, AP4, Pistol, Kill-shot                                                                                                                                                                                 Boltgun - Range 24", Str5, AP4, Assault 1, Kill-shot                                                                                                                                                                                 Stalker Boltgun - Range 30", Str X, AP4, Heavy 2, Kill-shot, Sniper</characteristic>
      </characteristics>
    </profile>
    <profile id="cfec-9be0-3f59-c9f9-05eaf" name="Biker" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
