ions="false" includeChildForces="false" /></constraints><infoLinks><infoLink id="b791f173-28e8-5acd-6270-4e947ff805d5-6e468ff" name="Shuriken Catapult" hidden="false" targetId="2aeaea12-f1a5-919c-768b-f77cfaf89b59-6e468ff" type="profile" /></infoLinks></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="1fd05348-4004-4a30-5c4f-00874baf064b-6e468ff" name="Windrider Jetbikes" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="125da977-4f52-7dcf-a292-dbf2e30013eb-6e468ff" name="Guardian Jetbike" hidden="false" collective="false" import="true" type="model"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="17" /></costs><constraints><constraint type="min" value="3" field="selections" scope="parent" shared="true" id="125da977-4f52-7dcf-a292-dbf2e30013eb-minSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="125da977-4f52-7dcf-a292-dbf2e30013eb-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a4c96d4e-b434-091d-f6b8-b8b5a7881297-6e468ff" name="Windrider Guardian" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="41"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Eldar Jetbike</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">41</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="ec4f98eb-b619-4e73-b95f-733b64692261-6e468ff" name="Cannon Upgrade" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="f4123c7b-d683-68af-15a2-58c531e1e46f-6e468ff" name="Shuriken Cannons" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><modifiers><modifier type="increment" field="f4123c7b-d683-68af-15a2-58c531e1e46f-maxSelections-6e468ff" value="1.0"><repeats><repeat field="selections" scope="5265dd4b-2dfc-4479-b182-377892a2de63-6e468ff" value="3" repeats="1" childId="125da977-4f52-7dcf-a292-dbf2e30013eb-6e468ff" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier></modifiers><constraints><constraint type="max" value="0" field="selections" scope="parent" shared="true" id="f4123c7b-d683-68af-15a2-58c531e1e46f-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><infoLinks><infoLink id="cd8f8a46-cad7-2cd9-3793-3dd42482ee0b-6e468ff" name="Shuriken Cannon" hidden="false" targetId="193817ff-c3a2-fd0f-b5d1-efaa03aab10c-6e468ff" type="profile" /></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="46569d44-c83b-b024-c7bd-dc325716ad09-6e468ff" name="Wraithblades" hidden="false" collective="false" import="true" type="unit"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-92f294e0-536a-11b1-3a71-966cee78c0c6" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="Elites" hidden="false" id="46569d44-c83b-b024-c7bd-dc325716ad09-slot-6e468ff" targetId="978c-e18f-8aeb-f4c1" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><rules><rule id="946286e6-5aa1-ee58-99d7-71e09bdd48f7-6e468ff" name="Fearless" hidden="false" page="35"><description>Fearless troops automatically pass all Morale and Pinning tests they are required to take, and will never fall back. They can however go to ground voluntarily. This special rule is gained by any independent character joining a fearless unit. However, as long as a fearless character stays with a unit that is not fearless, he loses this special rule. If a unit that is falling back suddenly gains this rule, it will automatically regroup at the beginning of its next Movement phase, regardless of all normal restrictions on regrouping.


Note: units with the Fearless ability are subject to the No Retreat! rule.</description></rule><rule id="b01ac1c8-e0e3-b793-6db0-8c0d61566dca-6e468ff" name="Bulky" hidden="false" page="35"><description>Bulky models count as two models for the purposes of Transport Capacity. (7th Ed wording)</description></rule></rules><infoLinks><infoLink id="b14a9424-22f4-dff3-655f-ebf72d8e3c55-6e468ff" name="Ancient Doom" hidden="false" targetId="e1ee54e9-46e1-48a5-268c-4956b2697149-6e468ff" type="rule" /></infoLinks><selectionEntryGroups><selectionEntryGroup id="fb6ab417-eb03-5218-263e-b2221ba3c248-6e468ff" name="Wraithblades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="cf70ffd1-271f-1de5-d380-86f85fa4aa62-6e468ff" name="Wraithblades" hidden="false" collective="false" import="true" type="model" page="36"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="32" /></costs><constraints><constraint type="min" value="5" field="selections" scope="parent" shared="true" id="cf70ffd1-271f-1de5-d380-86f85fa4aa62-minSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="cf70ffd1-271f-1de5-d380-86f85fa4aa62-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2bea59f6-406e-816e-b1c0-56edb351910b-6e468ff" name="Wraithblades" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="49"><modifiers><modifier type="set" field="mh6-5361766523232344415441232323" value="3+/4++"><conditions><condition type="equalTo" value="1" field="selections" scope="cf70ffd1-271f-1de5-d380-86f85fa4aa62-6e468ff" childId="0b8a12f4-a60d-adb3-25d9-0a1b86d0ad91-6e468ff" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232