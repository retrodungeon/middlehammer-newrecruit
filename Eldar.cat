          </characteristics>
        </profile>
        <profile id="6e1a-db95-8c8b-3948-c5359" name="Warlord Trait: Favoured of Ynnead" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and their unit can make a Soulburst action when they are within 14" of a unit that is destroyed, rather than 7".</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="6086-2f1b-bc4a-62dd-c5359" name="Gyrinx Familiar" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of each Psychic phase, generate D3 extra Warp Charge points.  Only Yvraine can use these Warp Charge points.</description>
        </rule>
        <rule id="cb55-a275-4d61-ec64-c5359" name="Herald of Ynnead" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Whenever an Aeldari model is slain within 7" of Yvraine, roll a dice.  On a 4+, Yvraine immediately regains a lost Wound.  If that model was a Psyker, add 1 to Yvraine's Master Level (to a maximum of Master Level 4) and immediately generate another psychic power for her.</description>
        </rule>
      </rules>
