      </infoLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="210" />
      </costs>
      <profiles>
        <profile name="Rune Armour" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="a884-fdc2-eeaf-ce09">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The bearer gains a 3+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Divination" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="2849-6069-1b89-8058">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">After both sides have deployed at the start of a game, the Eldar player may reposition D3+1 units in his army. No unit may be moved outside of its deployment zone.</characteristic>
          </characteristics>
        </profile>
        <profile name="Staff of Ulthamar" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="65cc-0965-7af8-d951">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This staff counts as a power weapon. If Eldrad is not in an assault it can allow Eldrad to use a third psychic power per turn, which may be a psychic power he has already used that turn. In combat it always wounds on a roll of 2+ and ignores armour saves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
