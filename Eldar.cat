        <selectionEntry id="8234e19b-943d-cea4-5d5f-855bf746ca5f-2adcd" name="The Helm of Spite" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="356d-228e-2d05-843f-2adcd" name="The Helm of Spite" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer of the Helm of Spite, and all friendly units with the Dark Eldar Faction within 12" of the bearer, have the Adamantium Will special rule. In addition, enemy Psykers that are within 12" of the bearer suffer Perils of the Warp when they roll any double when making a Psychic test. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules />
          <infoLinks>
            <infoLink id="2fbe-d3a2-b51e-09ea-2adcd" hidden="false" targetId="8714-46ad-62c0-ce35" type="rule">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            </infoLink>
          </infoLinks>
          <modifiers />
