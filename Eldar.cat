          <characteristics>
            <characteristic name="Capacity" typeId="7cdf-4c80-a83d-200c">12 Models or 5 Wraithguard and up to two accompanying characters.</characteristic>
            <characteristic name="Access Points" typeId="6e42-3bd5-70a6-724f">Rear access ramp</characteristic>
            <characteristic name="Fire Points" typeId="aa94-ae0c-98e7-5923" />
