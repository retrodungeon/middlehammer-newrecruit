    <selectionEntry id="5fca-9e86-dece-bf9e-c5359" name="Cloudstrike Squadron" page="143" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="72dd-e50c-dc82-143d-c5359" name="Cloudstrike" page="143" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If all models in the formation move Flat Out, they gain the Shrouded special rule until the start of their next turn.</description>
        </rule>
        <rule id="743c-84dc-bb1a-0caa-c5359" name="Supercharged" page="143" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If none of the models in the formation shoot in the Shooting phase, then in their next Shooting phase all of the unit's Pulse Lasers and Bright Lances have the Twin-linked and Lance special rules.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="97e8-7109-75ad-9f2f-c5359" hidden="false" targetId="243a-b08c-3c8c-c363" type="rule">
