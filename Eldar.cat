Note: units with the Fearless ability are subject to the No Retreat! rule.</description></rule><rule id="0e1a43ce-e573-5d46-ff10-68b49119547e-6e468ff" name="Bulky" hidden="false" page="35"><description>Bulky models count as two models for the purposes of Transport Capacity. (7th Ed wording)</description></rule></rules><infoLinks><infoLink id="c2f80348-b263-6561-59cb-08da1db62514-6e468ff" name="Ancient Doom" hidden="false" targetId="e1ee54e9-46e1-48a5-268c-4956b2697149-6e468ff" type="rule" /></infoLinks><selectionEntryGroups><selectionEntryGroup id="bb0204cd-44e4-1ae0-2a61-fad331591073-6e468ff" name="Wraithguard" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="7b620a54-f9ff-7068-b722-77d97fdfd2b6-6e468ff" name="Wraithguard" hidden="false" collective="false" import="true" type="model" page="36"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="32" /></costs><constraints><constraint type="min" value="5" field="selections" scope="parent" shared="true" id="7b620a54-f9ff-7068-b722-77d97fdfd2b6-minSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="7b620a54-f9ff-7068-b722-77d97fdfd2b6-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3bcc55ee-0b85-8f65-9988-2686ea1eff9b-6e468ff" name="Wraithguard" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="49"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">5</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">6</characteristic><characteristic name="W