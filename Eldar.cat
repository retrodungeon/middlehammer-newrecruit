ic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0895377f-5e29-2ab6-4572-03942c7960ea-6e468ff" name="Heavy Weapons Platform" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><modifiers><modifier type="increment" field="0895377f-5e29-2ab6-4572-03942c7960ea-maxSelections-6e468ff" value="1.0"><repeats><repeat field="selections" scope="e75897bb-ecd6-22b3-49f1-3cf22ec4fc28-6e468ff" value="10" repeats="1" childId="a6b18cfa-38a5-5afd-6f30-bc446947643c-6e468ff" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier></modifiers><constraints><constraint type="max" value="0" field="selections" scope="parent" shared="true" id="0895377f-5e29-2ab6-4572-03942c7960ea-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a3eab13e-21ff-fc32-0de0-2f8c88f6322e-6e468ff" name="Heavy Weapon Platform" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">-</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">-</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">-</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">-</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">-</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">-</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">40</characteristic></characteristics></profile></profiles><rules><rule id="0c9e75bc-e02f-0760-b5b1-a835cfaf2458-6e468ff" name="Relentless" hidden="false" page="41"><description>Relentless models can shoot with rapid fire and heavy weapons counting as stationary, even if they moved in the previous Movement phase, and are also allowed to assault in the same turn they fire them. Note that a relentless independent character must still abide by the assaulting limitations of any unit it has joined, if the unit is not itself relentless.</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="7cdb5a06-a78d-df8b-72cd-1937b8a9a2ec-6e468ff" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7cdb5a06-a78d-df8b-72cd-1937b8a9a2ec-minSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7cdb5a06-a78d-df8b-72cd-1937b8a9a2ec-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="8a48049d-b717-d486-30a7-236dcc5053e6-6e468ff" name="Brightlance" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8a48049d-b717-d486-30a7-236dcc5053e6-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="0166dfa9-61c8-ce56-6ec7-0ab97a4b1faa-6e468ff" name="Brightlance" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472