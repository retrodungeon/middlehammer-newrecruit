          <entryLinks />
          <costs>
            <cost name="Points" value="15.0" typeId="6f18-a8fc-2c5b-9517" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups />
      <entryLinks />
    </selectionEntryGroup>
