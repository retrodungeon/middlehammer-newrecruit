    <selectionEntry id="52bf-8451-c54a-5e3c-c5359" name="Gemini Revenant Squad" page="46" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="9035-b628-d8f8-7151-c5359" name="Mindlink" page="46" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The psychic link between the Revenants in the Gemini Squad has two effects:

- If one of the Revenants scores a hit on a target during the Shooting phase, the other Revenant treats its weapons as Twin-linked if it targets that same unit that phase.

- If an enemy unit's shooting attack hits a Revenant Titan's holo-field, place a Forewarned Counter next to the other member of the Gemini Squad (a small coin will do). All subsequent shooting attacks that target a Revenant with a Forewarned Counter can only be made as Snap Shots. Remove all Forewarned Counters at the end of each phase.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="8943-450c-e196-f3a4-c5359" name="Revenant Titans - 2 required" hidden="false" collective="false" defaultSelectionEntryId="5fb3-0cf5-8ae9-ebd1-c5359">
