        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">This weapon also counts as a power weapon.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scorpion's Bite" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="e418-fda3-af45-8e48">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">A model with mandiblasters has +2 A.</characteristic>
