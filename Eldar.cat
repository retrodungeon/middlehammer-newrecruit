      <rules>
        <rule id="9169-f360-b7b7-bc4c-2adcd" name="Curse of the Void" page="168" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any unit, friendly or enemy, within the Faction Craftworld Eldar, Dark Eldar, Eldar Corsairs or Harlequin suffers a -1 modifier to their Leadership value while within 12" of at least one Corsair Malevolent Band. In addition, a Corsair Malevolent Band never counts as a Scoring unit under any circumstances.</description>
        </rule>
      </rules>
