              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly units within 12" of a model with the Laughing God's Eye have the Adamantium Will special rule.</characteristic>
              </characteristics>
