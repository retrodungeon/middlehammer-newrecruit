    <selectionEntry id="5c65-a715-ee8e-b471-c5359" name="Halls of Martial Splendour" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="2886-11f0-1936-76c1-c5359" name="Halls of Martial Splendour" page="141" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Battlehost must replace the Farseer with an Autarch. When fighting in a Challenge, an Autarch from this Formation may re-roll any missed To Hit rolls.</description>
        </rule>
      </rules>
