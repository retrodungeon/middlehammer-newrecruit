          </costs>
        </selectionEntry>
        <selectionEntry id="1069-6b35-b3c6-b25b-c5359" name="The Spirit Stone of Anath'lan" page="156" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules>
            <rule id="fa8e-9838-9532-79f4-c5359" name="The Spirit Stone of Anath'lan" page="156" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Every time the bearer of the Spirit Stone of Anath'lan attempts to manifest a psychic power, he can choose to reduce the Warp Charge cost by 1 (to a minimum of 1). If he does so, he cannot use his rune armour's invulnerable save until the start of his next turn.</description>
            </rule>
          </rules>
          <infoLinks />
          <modifiers />
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1069-6b35-b3c6-b25b-maxSelections-c5359" type="max" />
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1069-6b35-b3c6-b25b-maxInRoster-c5359" type="max" />
          </constraints>
          <selectionEntries />
          <selectionEntryGroups />
          <entryLinks />
          <costs>
            <cost name="Points" value="15.0" typeId="6f18-a8fc-2c5b-9517" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups />
      <entryLinks />
    </selectionEntryGroup>
