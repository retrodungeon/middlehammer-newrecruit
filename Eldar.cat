    <selectionEntry id="c405-2527-e5e4-fb30-c5359" name="Crossroads of Eternity" page="141" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="8a05-f819-3777-6186-c5359" name="Crossroads of Eternity" page="141" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Battlehost may include 0-1 Harlequin Troupe (see Codex: Harlequins) and/or 0-1 Corsair Reaver Bands (see Corsairs). These units are treated as having the Faction: Eldar for the duration of the game.

* Battlescribe Users: Please add an Unbound force of allied Corsairs and/or Harlequins to add these units.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers>
        <modifier type="set" field="c405-2527-e5e4-fb30-minSelections-c5359" value="1.0">
