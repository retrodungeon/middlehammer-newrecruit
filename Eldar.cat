    <selectionEntry id="6610-75e5-7637-d9cb-c5359" name="Runeweaver Host" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="1b19-f417-93f5-3c77-c5359" name="Weaver of Runes" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>By focusing his will upon an enemy threat, the Farseer guides the destructive beam of his accompanying Fire Prism with unerring accuracy. The Fire Prism's weapons all have the Twin-Linked special rule when targeting an enemy unit that the Runeweaver Host's Farseer has line of sight to.</description>
