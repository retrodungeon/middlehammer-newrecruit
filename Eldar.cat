    <selectionEntry id="45f2-33b4-0390-d32f-c5359" name="Shroud of Kurnous" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="880d-e37e-b47f-2d29-c5359" name="Psychic Shield" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any Crimson Hunter from this Wing that is within 8" of the Wing's Hemlock Wraithfighter adds 2 to any Deny the Witch rolls. In addition, the pilot of the Hemlock Wraithfighter has the Shrouding psychic power from the Telepathy discipline, in addition to the other psychic powers it normally has.</description>
        </rule>
      </rules>
      <infoLinks>
