    <profile id="95c5-ed3e-dc55-fdae-c5359" name="Scattershield" page="154" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has a 5+ Invulnerable Save. Whenever the bearer passes one or more saving throws using its Scattershield, all enemy units within 6" must test as if they had just been hit by a weapon with the Blind special rule.</characteristic>
      </characteristics>
    </profile>
