    <selectionEntry id="a16e-6101-9645-75a9-c5359" name="Skyreaver Raiding Echelon [FW]" page="184" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="a771-853c-f8db-d60e-c5359" name="Orbital Reavers" page="183" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>On any turn in which a unit chosen as part of this Formation disembarks from the Vampire Raider, the Vampire Raider gains the Assault Vehicle special rule.</description>
        </rule>
        <rule id="d6c9-a07d-b091-f61c-c5359" name="Troop Bay Refit" page="183" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A Vampire Raider taken as part of this Formation may transport Artillery models, with crewman using up a single Transport Capacity point and each Artillery model using up 3 Transport Capacity points.</description>
        </rule>
        <rule id="142f-96eb-5ffd-b6b9-c5359" name="Skyreaver Raiding Echelon [FW]" page="184" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>- All non-vehicle units in this Formation must begin play embarked on the Vampire Raider.
- This Formation may not include more Vaul's Wrath Support Batteries than it does Guardian Defender units.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
