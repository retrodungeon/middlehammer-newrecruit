        <infoLink name="Rune Armour" id="5eeb-36ce-03c1-3cb4" hidden="false" targetId="96ee-79a8-217a-28a7" type="rule">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5331-6f75-4f69-e3b1" childName="Spiritseer" field="selections" scope="self" shared="true" type="equalTo" value="0" />
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="0f94-6042-0450-0c3e" type="increment" value="5">
          <repeats>
            <repeat childId="cc6c-88bb-a192-34d4" childName="Farseer" field="selections" includeChildSelections="true" repeats="1" roundUp="false" scope="force" shared="true" value="1" />
          </repeats>
        </modifier>
        <modifier field="0f94-6042-0450-0c3e" type="set" value="-1">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="mh-al-00db-baa2-10b1-b4c6" childName="Ulthwe Strike Force (Eye of Terror 2003)" field="selections" scope="force" shared="true" type="atLeast" value="1" includeChildSelections="true" />
                <condition childId="mh-al-d1e2-e6ed-e01f-ae6f" childName="Ulthwe The Damned (2000)" field="selections" scope="force" shared="true" type="atLeast" value="1" includeChildSelections="true" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="error" type="add" value="A Warlock cannot be taken in a Wraithguard unit if Iyanna is already attached.">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="89c0-c22f-a947-63e0" childName="Iyanna Arienal, Spiritseer of Iyandan" field="selections" scope="parent" shared="true" type="equalTo" value="1" />
                <condition childId="ec2f-166f-1795-507b" childName="Warlock" field="selections" scope="parent" shared="true" type="greaterThan" value="0" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Ghostvoice" id="0387-267f-8333-f9a6" hidden="false">
          <description>Any Wraithguard unit with a model within 6" of a Spiritseer does not have to test for Wraithsight, just as if a Warlock was accompanying the unit.</description>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5331-6f75-4f69-e3b1" childName="Spiritseer" field="selections" scope="self" shared="true" type="equalTo" value="0" />
              </conditions>
            </modifier>
          </modifiers>
        </rule>
      </rules>
