      <rules>
        <rule id="c5f2-a430-d080-8ae8-c5359" name="Hand of Asuryan" page="102" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When determining Warlord Traits of Asurmen, he always has D3 traits from the Warlord Traits table in Codex: Craftworlds (pg 148) - re-roll any duplicates.</description>
        </rule>
        <rule id="1ca6-e4b1-8809-71d2-c5359" name="Shield of Grace" page="102" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Asurmen has a 4+ invulnerable save. This is increased to a 3+ invulnerable save whilst he is fighting in a challenge.</description>
        </rule>
      </rules>
