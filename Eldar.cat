ink id="c0b15920-d9de-6a66-a81b-ca248e883107-6eb40c7" name="Shuriken Cannon" hidden="false" targetId="193817ff-c3a2-fd0f-b5d1-efaa03aab10c-6eb40c7" type="profile" /></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="fa609975-2b91-8d32-ffc6-a0df95156ea7-6eb40c7" name="Exarch Powers" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="fa609975-2b91-8d32-ffc6-a0df95156ea7-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5e468685-ccad-5262-1d6f-08e29ffe00d0-6eb40c7" name="Fast Shot" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5e468685-ccad-5262-1d6f-08e29ffe00d0-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="b1ca9d18-6438-6d18-c1e5-998281ad205c-6eb40c7" name="Fast Shot" hidden="false" page="30"><description>A model with this special rule always fires one more shot than is normal for its weapon. For example, if its weapon is Heavy 2, it fires 3 shots. (7th Ed wording)</description></rule></rules></selectionEntry><selectionEntry id="0a2d0c21-0dd4-918e-7d74-ee5418a545e1-6eb40c7" name="Marksman's Eye" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0a2d0c21-0dd4-918e-7d74-ee5418a545e1-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="c90f4766-59e4-703c-9a7f-60472570cfd6-6eb40c7" name="Marksman's Eye" hidden="false" page="30"><description>This model makes Precision Shots on a 5+, rather than a 6+. (7th Ed wording)</description></rule></rules></selectionEntry><selectionEntry id="286b0198-e9cf-f226-e196-21d68a518686-6eb40c7" name="Night Vision" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="286b0198-e9cf-f226-e196-21d68a518686-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="eef865e5-025a-fa37-b80f-e7eac3ef7842-6eb40c7" name="Night Vision" hidden="false" page="30"><description>When the Night Fighting mission special rule is in use, such models may choose to re-roll the test to determine how far they can see, but must abide by the new result. Characters with this rule confer it onto any unit they join, as long as they are part of the unit. Units with this rule confer it onto any characters joining them, as long as they are part of the unit.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><entryLinks><entryLink id="4d5a9dd8-ac5b-61e3-01ca-3d9e8554f8ff-6eb40c7" name="Wave Serpent" hidden="false" collective="false" import="true" targetId="153d96fe-17a3-f037-42dd-c83b5c96987b-6eb40c7" type="selectionEntry" /></entryLinks></selectionEntry><selectionEntry id="9d1ebe0e-1fb9-4309-aeec-49018c4124c6-6eb40c7" name="Dire Avengers" hidden="false" collective="false" import="true" type="unit" page="31"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-d4e4b879-0116-1793-f2fe-cefc53dce1ca" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="Troops" hidden="false" id="9d1ebe0e-1fb9-4309-aeec-49018c4124c6-slot-6eb40c7" targetId="default-category" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><profiles><profile id="b45ec2cf-ddfd-02fe-535c-06fe312b22fa-6eb40c7" name="Plasma grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62 (40K)</characteristic></characteristics></profile></profiles><rules><rule id="a7dfd6e9-64e2-9e3b-64a1-e05ba1385078-6eb40c7" name="Counter-attack" hidden="false" page="35"><description>When a unit with this rule is assaulted by the enemy it must take a Leadership test. If the test is successful all models in the unit get the +1 assault bonus to their attacks, exactly as if they too had assaulted that turn.


This rule cannot be used if, when assaulted, the unit was already locked in combat from a previous turn.</description></rule></rules><infoLinks><infoLink id="a358f4c3-5105-c186-d2c4-6e4bda12013e-6eb40c7" name="Avenger Shuriken Catapult" hidden="false" targetId="c59314d7-b8c6-b395-a5d2-8d05727ff5c6-6eb40c7" type="profile" /><infoLink id="89d5ee6f-3d07-5a7a-528a-9ef305a0c01f-6eb40c7" name="Fleet" hidden="false" targetId="49de9cf6-23f8-f8e9-b2ec-4c00a0a7c290-6eb40c7" type="rule" /><infoLink id="80ec524b-30b6-94bb-64af-60bebac5a210-6eb40c7" name="Battle Focus" hidden="false" targetId="5e977264-3e5c-6769-c082-47089686719b-6eb40c7" type="rule" /><infoLink id="44e3ad56-8dbe-235c-38c6-e8c7173af42a-6eb40c7" name="Ancient Doom" hidden="false" targetId="e1ee54e9-46e1-48a5-268c-4956b2697149-6eb40c7" type="rule" /></infoLinks><selectionEntryGroups><selectionEntryGroup id="5ad9f4e0-d736-5c6c-b2c5-47ab942783a0-6eb40c7" name="Dire Avengers" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="07e1cc08-ff6d-c83b-67ad-8c0c29bae7d8-6eb40c7" name="Dire Avenger" hidden="false" collective="false" import="true" type="model"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="13" /></costs><constraints><constraint type="min" value="5" field="selections" scope="parent" shared="true" id="07e1cc08-ff6d-c83b-67ad-8c0c29bae7d8-minSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="07e1cc08-ff6d-c83b-67ad-8c0c29bae7d8-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7961725a-fb65-112e-eafa-b699ee959aef-6eb40c7" name="Dire Avenger" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="31"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="