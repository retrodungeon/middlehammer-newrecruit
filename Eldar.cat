      </profiles>
      <rules>
        <rule id="6ab7-a415-3d7a-c82d-c5359" name="Khaine Awakened" page="137" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Avatar, and all friendly units with the Eldar faction within 12" of the Avatar, have the Fearless, Furious Charge and Rage special rules.</description>
        </rule>
        <rule id="8514-4e5d-69d4-e7e5-c5359" name="Molten Body" page="137" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Avatar is unaffected by all Pyromancy psychic powers, all flamer weapons as defined in the 40k Rulebook, and all attacks that have the Melta and/or Soul Blaze special rules.</description>
        </rule>
      </rules>
