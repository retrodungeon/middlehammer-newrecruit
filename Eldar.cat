/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="479c9c7b-a4c1-7163-75cb-d95dabcfcb7d-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="479c9c7b-a4c1-7163-75cb-d95dabcfcb7d-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="3a94a6cc-5b23-26ea-f94e-e9836611a6b5-6eb40c7" name="Soulshrive" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Melee</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3*</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Master-crafted, Spiritstealer</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="a0971a95-9742-9289-3e88-6fc37ea3a80d-6eb40c7" name="The Wraithforge Stone" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a0971a95-9742-9289-3e88-6fc37ea3a80d-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="a0971a95-9742-9289-3e88-6fc37ea3a80d-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="5814dbe7-e529-63f0-de18-f8186925d3ed-6eb40c7" name="The Wraithforge Stone" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName