                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Rending, Vaul's Work</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="68bf-2ea1-0f2f-ee5b-c5359" name="Vaul's Work" page="156" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>The bearer of this weapon has the Fearless special rule. In a challenge, Attacks made with this weapon have the Fleshbane and Instant Death special rules.</description>
            </rule>
          </rules>
          <infoLinks>
