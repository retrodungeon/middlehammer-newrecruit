    </profile>
    <profile name="The Fire Axe" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="cf70-b1b4-0696-22a1">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This weapon confers +1S to attacks and allows the bearer to attack as a monstrous creature (Ignores armour saves, rolls 2D6+5 for armour penetration).</characteristic>
      </characteristics>
    </profile>
