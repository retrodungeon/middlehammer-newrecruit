    <selectionEntry id="e357-d954-03fb-c901-c5359" name="Khaine's Hawks Squadron [FW]" page="180" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="172b-abe3-986a-2e81-c5359" name="Khaine's Hawks Squadron [FW]" page="180" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Nightwings bought as part of this Formation form a vehicle squadron and must take the same upgrades.</description>
        </rule>
        <rule id="5d9e-d441-84a2-a240-c5359" name="Aerial Predators" page="180" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When targeting a Zooming enemy Flyer, each Nightwing from this Formation may choose to add the Ignores Cover special rule to any one weapon attack per turn.</description>
        </rule>
        <rule id="1253-3506-b338-d1f2-c5359" name="Orbital Interceptors" page="180" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If a Khaine's Hawks Squadron is in Reserves during a game in which an enemy flyer is brought into play from Reserves, then the Khaine's Hawks Squadron's controlling player may re-roll all attempts to bring the Khaine's Hawks Squadron into play in their next turn.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
