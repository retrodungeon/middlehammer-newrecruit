    <selectionEntry id="aae6-d642-2180-326d-c5359" name="Tomb-ship of Fallen Heroes" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="79d8-d22c-391f-b3e1-c5359" name="Tomb-ship of Fallen Heroes" page="141" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Battlehost must replace the Farseer with a Spiritseer or a Wraithseer, and may include 0-1 Wraithlord. If a Wraithlord or Wraithseer is chosen as the army's Warlord then two D6 are rolled to determine its Warlord Trait and the controlling player may select which result to use.</description>
        </rule>
      </rules>
