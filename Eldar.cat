      <profiles />
      <rules>
        <rule id="e84e-1574-557c-141c-c5359" name="Rites of Battle" page="142" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Immediately after determining Warlord Traits, choose either Weapon Skill or Ballistic Skill. All units in this Formation add 1 to the chosen characteristic.</description>
        </rule>
        <rule id="d6e7-e1bf-98ee-5f78-c5359" name="Shrinekeepers" page="142" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models from this Formation can re-roll failed Morale, Pinning and Fear tests.</description>
        </rule>
      </rules>
