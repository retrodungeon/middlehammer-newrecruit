      <rules>
        <rule name="Spiritseer" id="d750-cb29-05e9-c934" hidden="false">
          <description>Any Wraithguard unit with a model within 12" of Arienal does not need to test for its Wraithsight, just as if the unit was accompanied by a Warlock.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Nuadha 'Fireheart', Wild Rider of Saim Hann" id="a194-de6c-6011-05e1" collective="false" hidden="false" import="true" type="unit">
      <constraints>
