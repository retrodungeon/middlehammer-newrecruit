    <selectionEntry id="9cf8-1cbe-7d3a-e0d9-c5359" name="Falcons" page="131" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="44db-f69b-651f-25f4-c5359" name="Cloudstrike" page="131" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If a Falcon squadron contains three models, all models in the squadron gain the Deep Strike special rule. When the squadron arrives by Deep Strike, the first Falcon placed does not scatter and the scond and third Falcons can be placed anywhere within 4" of the first Falcon.</description>
        </rule>
      </rules>
