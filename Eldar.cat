    <selectionEntry id="029f-b65d-7332-1004-c5359" name="Ghost Warrior Warhost" page="47" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="4139-2726-840f-07ea-c5359" name="Ghost Warrior Warhost (Restriction)" page="474" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The entire formation must fight on foot: no Dedicated Transports may be taken as upgrades.</description>
        </rule>
        <rule id="aecc-ecf6-4891-df85-c5359" name="Revered Ancients" page="47" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Every friendly Eldar unit within 12" of a unit from this formation has the Fearless special rule.</description>
        </rule>
        <rule id="7493-d6bb-1302-aa78-c5359" name="Wrath of the Slain" page="47" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Nominate a codex immediately before determining Warlord traits. Whilst a unit from this formation is within 6" of at least one of the formation's Spiritseers, that unit has the Preferred Enemy special rule against all units from the nominated codex.</description>
        </rule>
      </rules>
