    <selectionEntry id="b59c-d0bf-457b-3a43-c5359" name="Children of Khaine" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="6056-3191-d372-c0c2-c5359" name="Children of Khaine" page="178" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Guardian Defender squads must be replaced with Storm Guardian squads. In addition, all Storm Guardian models that score a 6 on any To Hit roll in the first turn of any assault gain +1 to their Strength when resolving that attack.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers>
        <modifier type="set" field="b59c-d0bf-457b-3a43-minSelections-c5359" value="1.0">
          <repeats />
          <conditions>
