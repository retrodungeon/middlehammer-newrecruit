    <selectionEntry id="2dbe-44d6-8c5b-6397-c5359" name="Hammer of Vaul [FW]" page="183" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="4354-1b38-0d62-8cd6-c5359" name="Pride of the Host" page="183" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If all of the models in this Formation are destroyed, the opposing player gains +1 Victory Point - this counts as a Secondary Objective.</description>
        </rule>
        <rule id="5e76-8d89-14ca-c8d1-c5359" name="Icon of Glory" page="183" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All models from the same army within 6" of any part of a vehicle's hull from this Formation may re-roll failed Regroup tests.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
