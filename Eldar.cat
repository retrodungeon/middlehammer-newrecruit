-11b1-3a71-966cee78c0c6" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="Troops" hidden="false" id="4bdb2c53-7027-49ee-8572-0ea44ae05977-slot-6e468ff" targetId="default-category" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><profiles><profile id="074f9a29-68d7-1ace-9054-f0ab80db446e-6e468ff" name="Chainsword" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Melee</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">60 (40K)</characteristic></characteristics></profile><profile id="7fdfa4ce-356c-55a0-c2ce-cfa6a5db6c05-6e468ff" name="Plasma grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62 (40K)</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="368f5617-8504-7889-eb59-27aaf39f0697-6e468ff" name="Fleet" hidden="false" targetId="49de9cf6-23f8-f8e9-b2ec-4c00a0a7c290-6e468ff" type="rule" /><infoLink id="22eca497-f077-2e3c-fe43-629b20a4b0f4-6e468ff" name="Battle 