    <profile id="8669-a743-a9c7-345f-2adcd" name="Star Engines" page="155" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A non-Walker vehicle with this upgrade can move up to 24" when making a Flat Out. A Walker with this upgrade instead Runs an additional 3" (this will normally be D6+3").</characteristic>
      </characteristics>
    </profile>
    <profile id="0fc6-d1be-3c70-ffdb-2adcd" name="Starcannon" page="151" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
