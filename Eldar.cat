      </constraints>
      <selectionEntries>
        <selectionEntry id="7c4b-1337-47bd-e37f-c5359" name="The Celestial Lance" hidden="false" collective="false" type="upgrade">
          <profiles />
          <rules>
            <rule id="6203-df4d-0138-e6aa-c5359" name="Impact" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>The Melee profile given above is only used during a Assault phase in which the wielder made a sucessful charge. In all other Assault phases, the Celestial Lance is treated as a close combat weapon.</description>
            </rule>
            <rule id="b607-7980-0ec2-8a37-c5359" name="Spirit Shatter" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>When a Character or Montrous Creature is reduced to 0 Wounds by an Attack from this weapon, during a turn in which the wielder charges, centre the large blast marker over the victim before removing the model as a casualty. All models under the blast marker (friend or foe, but not the bearer os the Celestial Lance), suffer a single hit with a Strength equal to the victim's Toughness characteristic and AP-.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="1047-c0a5-2d13-a182-c5359" name="" hidden="false" targetId="cb0d-87b3-87a2-81d6" type="rule">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
            </infoLink>
            <infoLink id="59c7-ba0f-9513-8c53-c5359" name="" hidden="false" targetId="5e41-1a1d-ee36-0756-c5359" type="profile">
              <profiles />
