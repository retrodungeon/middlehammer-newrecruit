          <rules>
            <rule id="f7c4-414b-9935-cc4a-c5359" name="Voidshot" page="101" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>When rolling To Wound for a weapon that has this special rule, a roll of 6 causes a Wound with the Instant Death special rule. When making an Armour Penetration roll for a weapon that has this special rule, a roll of 6 causes a penetrating hit, regardless of the vehicle's Armour Value.</description>
            </rule>
          </rules>
