    <selectionEntry id="4161-e029-1703-1556-c5359" name="Hornet Swarm [FW]" page="182" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="73bc-2458-3574-29a3-c5359" name="Swift Assault" page="182" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>On the turn in which this squadron enters play from Reserves, it may use the Jink special rule and fire all weapons at full BS (as long as the squadron does not also move Flat Out, in which case the restrictions of the Skimmer Assault special rule apply).</description>
        </rule>
        <rule id="5327-a53e-d349-8777-c5359" name="Death Knell" page="182" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When rolling to bring a Hornet Swarm squadron into play from Reserves, the score require to bring them into play is 2+, as long as the controlling player achieved at least one Primary or Secondary objective in their previous turn.</description>
        </rule>
        <rule id="a565-8144-25b5-cd92-c5359" name="Hornet Swarm" page="182" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Hornets bought as part of this Formation form a Vehicle Squadron and must take the same upgrades.</description>
        </rule>
      </rules>
