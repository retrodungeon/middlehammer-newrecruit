      <rules>
        <rule id="d34a-5ada-ae43-6e69-2adcd" name="Force of Wil" page="158" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Eldar Corsair units within 12" that can draw a line of sight to a model with this special rule may re-roll all failed Regroup tests.</description>
        </rule>
        <rule id="925b-7164-ec24-923b-2adcd" name="Psyker (Corsair Prince)" page="158" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A Corsair Prince who is upgraded to a Psyker may select powers from the Divination or Telekinesis Disciplines.</description>
        </rule>
      </rules>
