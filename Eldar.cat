      <selectionEntries>
        <selectionEntry id="7c1f-9e4c-4507-b52b-c5359" name="Wasp Jump Pack" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="70a3-3977-891c-d785-c5359" name="Wasp Jump Pack" page="218" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This can be used in either the Movement phase or Assault phase, but not both in the same turn. If used in the Movement phase, the Wasp Assault Walker may move up to 12" and no less than 8" in any direction, ignoring intervening terrain and models - when moving in this fashion, the Wasp Assault Walker may only fire Snap Shots in the following Shooting phase. If used in the Assault phase, the Wasp Assault Walker may roll an additional D6 when determining Charge distance and use the two highest results, and additionally gains the Hammer of Wrath special rule for that phase, inflicting D6+1 hits instead of just one.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules />
          <infoLinks />
          <modifiers />
