="true" id="4ef0c7db-1d89-7f25-dfe8-15f3cfca7d29-minSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4ef0c7db-1d89-7f25-dfe8-15f3cfca7d29-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e5c86928-961a-2aca-2808-b382db6eee5b-6e468ff" name="D-Impaler" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">D</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Primary Weapon 1, Massive Blast (7") Distort Rift</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="8d155bbd-877c-447e-f965-92b5da247816-6e468ff" name="Auxiliary Weapon" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8d155bbd-877c-447e-f965-92b5da247816-minSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8d155bbd-877c-447e-f965-92b5da247816-maxSelections-6e468ff" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="bc0919a1-d0a1-7154-82d2-f2478410b2ca-6e468ff" name="Shuriken cannon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selec