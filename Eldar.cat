        <characteristic name="Capacity" typeId="e1d2-e9ec-26d6-1f11">30 infantry. It mat carry Wraithguard, which count as two models each. It may carry support platforms, which count as two models in addition to the crew.</characteristic>
      </characteristics>
    </profile>
    <profile name="Diresword" id="bcd4-96c8-0ff6-eafd" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignores Armour Saves. A multi-wound model that suffers a wound from a diresword must pass a Leadership test or die automatically.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sword of Asur" id="0d3c-c54b-2d98-d764" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Re-roll misses to hit.
Ignores Armour Saves. A multi-wound model that suffers a wound from a diresword must pass a Leadership test or die automatically.</characteristic>
      </characteristics>
    </profile>
    <profile name="Silent Death" id="c32e-30c0-02a6-afe3" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">5</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">5</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 1</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Throw Silent Death at an enemy unit like a normal shooting attack. If it hits, you may roll to hit again. Keep rolling to hit until you miss or get 4 hits total. Roll to wound and take armour saves for each hit as usual. Each model in the target unit can only be hit once. Counts as a power weapon in close combat.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scorpion's Bite" id="f79c-daaf-0041-c5a0" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
        <characteristic name="S" typeId="24d8-2110-08fa-d844">4</characteristic>
        <characteristic name="AP" typeId="25ce-028f-0aae-2855">-</characteristic>
        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Special attack made at +2 I in addition to the bearer's other attacks. Make one attack hitting on a 4+.</characteristic>
      </characteristics>
    </profile>
