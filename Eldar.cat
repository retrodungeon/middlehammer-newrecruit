    <selectionEntry id="184c-1a37-bde7-381d-c5359" name="Wraith Titans [FW]" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="82e7-c7d0-610a-035c-c5359" name="Close Support" page="184" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>So long as a Wraith Knight chosen as part of this Formation is within 6" of an Eldar Titan also chosen as part of this Formation, any enemy unit which declares a charge on the Eldar Titan must instead target the Wraith Knight with their charge, as long as the Wraith Knight is no further from the enemy unit than the Eldar Titan.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
