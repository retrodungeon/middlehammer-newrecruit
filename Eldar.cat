fe60e3-6eb40c7" name="Fast Shot" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="64b60496-6f5f-8280-422b-8c4c1bfe60e3-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="0b9b521b-6d33-4c85-7579-93a5973f3a64-6eb40c7" name="Fast Shot" hidden="false" page="30"><description>A model with this special rule always fires one more shot than is normal for its weapon. For example, if its weapon is Heavy 2, it fires 3 shots. (7th Ed wording)</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="1bca1f97-c876-1521-ae43-e22c8a794bba-6eb40c7" name="Fire Dragon" hidden="false" collective="false" import="true" type="model"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="22" /></costs><constraints><constraint type="min" value="5" field="selections" scope="parent" shared="true" id="1bca1f97-c876-1521-ae43-e22c8a794bba-minSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="1bca1f97-c876-1521-ae43-e22c8a794bba-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="221012cb-4a0b-6df4-55ab-07db6feba87c-6eb40c7" name="Fire Dragon" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">3</ch