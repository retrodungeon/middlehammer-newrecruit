    <selectionEntry id="a034-42ae-8fc7-74c3-c5359" name="Shadow Spectres Shrine [FW]" page="180" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="e3df-b12a-d426-d0e4-c5359" name="Shadow Spectre Shrine" page="180" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Only one unit in this Formation may include an Exarch.</description>
        </rule>
        <rule id="ace0-d914-5107-1ed5-c5359" name="Rites of the Twilight" page="180" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All models in this Formation roll an additional D6 for all Thrust moves and select the two highest dice to determine the distance they may move.</description>
        </rule>
        <rule id="07e6-9d4c-d71f-d790-c5359" name="Shrinekeepers" page="180" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models from this Formation can re-roll failed Morale checks, Pinning tests and Fear tests.</description>
        </rule>
        <rule id="8b7f-6a9f-184d-eff9-c5359" name="Spectral Blade" page="180" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All enemy models within 12" of an Exarch that is part of this Formation must re-roll all successful Fear tests.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
