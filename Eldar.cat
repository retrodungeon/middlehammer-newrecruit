    <selectionEntry id="9525-9d32-6d67-7698-c5359" name="On Lonely Paths" page="141" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="24ba-eca4-622e-f07f-c5359" name="On Lonely Paths" page="141" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>The Battlehost must include 1-3 units of Eldar Rangers. While within 12" of an Eldar Rangers unit from this Battlehost, all Guardian units that are a part of the Battlehost gain the Move Through Cover special rule.</description>
        </rule>
