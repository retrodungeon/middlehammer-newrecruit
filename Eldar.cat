      <rules>
        <rule id="b6c3-f173-723a-9221-c5359" name="Warlord Trait: Mark of the Imcomparable Hunter" page="148" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </rule>
        <rule id="338d-9220-f042-a055-c5359" name="Crack Shot" page="105" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>A model with this special rule can re-roll one failed To Hit or To Wound roll, or Armour Penetration roll, per turn.</description>
        </rule>
        <rule id="f220-9eb5-0faf-05c7-c5359" name="Unquenchable Resolve" page="105" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the end of any phase in which Fuegan suffers one or more unsaved Wounds, his Strength and Attacks increase by 1 for each unsaved Wound suffered. These characteristic bonuses last for the rest of the game.</description>
        </rule>
      </rules>
