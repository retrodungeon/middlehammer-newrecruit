        <selectionEntry id="30a3-9149-0622-275b-c5359" name="Crescendo" page="93" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="923c-b22f-90cb-f5e0-c5359" name="Crescendo" page="93" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12"</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistol, Bladestorm, Quickfire</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="93aa-a20c-8b2a-9cc1-c5359" name="Quickfire" page="93" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>A model firing this weapon can fire a number of times equal to its Attacks characteristic. All of these shots must be made at the same target unit.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="0981-ca62-8e98-f844-c5359" hidden="false" targetId="ce57-25dd-7d75-6574-c5359" type="rule">
              <profiles />
              <rules />
