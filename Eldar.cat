        <infoLink name="Alean - The Steed of Khaine" id="973c-ee03-e9c6-68cf" hidden="false" targetId="8ab9-b5a4-c3e8-20d3" type="rule" />
        <infoLink name="Shuriken Cannon" id="88af-feec-640e-1e76" hidden="false" targetId="925b-d150-8e56-0832" type="profile" />
