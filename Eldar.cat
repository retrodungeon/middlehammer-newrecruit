    <selectionEntry id="7357-7bba-7aec-2d23-c5359" name="Skyhunters Squadron [FW]" page="183" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="35b1-1145-e508-32c4-c5359" name="Skyhunters Squadron" page="183" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Lynx bought as part of this Formation form a Vehicle Squadron and must take the same upgrades.</description>
        </rule>
        <rule id="2000-e723-d97d-1c42-c5359" name="On Wings of Flame" page="183" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When deployed onto the table using the Deep Strike special rule, a Skyhunter Squadron gains a 4+ cover save until the start of its controlling player's next turn.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
