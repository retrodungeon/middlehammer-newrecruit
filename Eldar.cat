    <selectionEntry id="984e-c5ce-a702-f990-c5359" name="Wraithseer [FW]" page="213" hidden="false" collective="false" type="model">
      <profiles>
        <profile id="bf6b-70f4-8f51-200c-c5359" name="Wraithseer" page="213" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Monsterous Creature (Character)</characteristic>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">8</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">8</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">4</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+/5++</characteristic>
          </characteristics>
        </profile>
        <profile id="4d78-a214-fba7-f2c3-c5359" name="Wraithseer" page="213" hidden="false" typeId="bc97-dea9-9e88-bb7d">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Mastery Level" typeId="ca56-02c3-af4b-ea2a">1</characteristic>
            <characteristic name="Disciplines" typeId="ea53-f5c7-08e4-980c">Wraithseers do not generate their psychic powers using the standard rules. Instead, they automatically gain all three Wraithseer powers.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="c6c8-78c4-9b70-61c2-c5359" name="Wraithseer Powers" page="213" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Enliven (1 warp charge): This is a Blessing which targets a single friendly unit of Wraithguard, Wraithblades, or a single Wraithlord. Whilst the power is in effect, the target unit gains the Fleet special rule.

Foreboding (1 warp charge): Foreboding is a Witchfire power with the following profile: Range 18" Str 3 AP5 Assault D6, Aether Shock

Aether Shock: If this attack hits then the targeted unit must take a Pinning test with a -2 Ld penalty.

Deliverance (1 warp charge): This is a Blessing which targets a single friendly unit of Wraithguard, Wraithblades, or a single Wraithlord. Whilst the power is in effect, the target unit gains the Feel No Pain (5+) special rule.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f2a1-e476-f027-f3a9-c5359" hidden="false" targetId="7a42-bcc8-95a0-302d" type="rule">
