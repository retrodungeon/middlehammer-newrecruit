    <selectionEntry id="1ac1-ceda-dee4-00dc-c5359" name="Dire Avenger Shrine" page="143" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="124b-9c5d-5cc7-f680-c5359" name="Killing Strike" page="143" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Once per game, in the Shooting phase, this Formation can perform a Killing Strike. For the duration of that phase, all Avenger Shuriken Catapults carried by models in this Formation are Assault 3 instead of Assault 2.</description>
        </rule>
        <rule id="cffa-f956-b416-e99e-c5359" name="Rites of the Avenger" page="143" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All models in this Formation add 1 to their Ballistic Skill.</description>
        </rule>
        <rule id="0183-9e85-1968-2e14-c5359" name="Shrinekeepers" page="143" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models from this Formation can re-roll failed Morale, Pinning and Fear tests.</description>
        </rule>
      </rules>
