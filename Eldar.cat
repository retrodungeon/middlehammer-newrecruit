      <rules>
        <rule id="70a5-571b-8254-756f-c5359" name="Warlord Trait: Twilight Terror" page="139" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Any enemy unit within 12" of Irillyth or any unit he has joined must pass a Leadership test when attempting to make a Shooting attack against Irillyth or the unit he has joined. If they fail this test, they may only fire Snap Shots. The effects of the Shadow of Death apply to this test.</description>
        </rule>
      </rules>
