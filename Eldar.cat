      </constraints>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="80" />
      </costs>
      <infoLinks>
        <infoLink name="Avatar" id="1608-42e0-ae3f-3b75" hidden="false" targetId="500a-7b19-a01d-3d88" type="profile" />
        <infoLink name="Fearless" id="e7de-d68e-802c-deb3" hidden="false" targetId="b137-13a1-eb97-c5e5" type="rule" />
        <infoLink name="Independent Character" id="6f31-8a8b-e0d1-8a47" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
        <infoLink name="Monstorous Creature" id="c200-6924-b3b2-f740" hidden="false" targetId="445e-e873-2a3f-776f" type="rule" />
        <infoLink name="Invulnerable Saving Throw" id="ba5d-c58a-f1c5-6b60" hidden="false" targetId="97b3-810d-a09e-872b" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Inspiring" id="d069-fa96-bd87-fbb1" hidden="false">
          <description>Any Eldar unit with a model within 12" of the Avatar become fearless in close combat. Also, if the Avatar is in close combat, all Eldar units with a model within 12" add +1 to their score when determining who won a round of close combat.</description>
        </rule>
        <rule name="Daemon" id="4557-3d8c-7f0f-7f4e" hidden="false">
          <description>An Avatar is affected by weapons or abilities that use special rules against Daemons.</description>
        </rule>
      </rules>
    </selectionEntry>
