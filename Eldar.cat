        <selectionEntry id="1473-8af9-a3cd-f368-c5359" name="The Laughing God's Eye" page="93" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="6460-d507-3f30-70ee-c5359" name="The Laughing God's Eye" page="93" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
