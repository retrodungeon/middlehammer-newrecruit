        <rule name="Divination" id="4e87-7ad5-f7e3-7efc" hidden="false">
          <description>After both sides have deployed at the start of the game, the Eldar player my reposition D3 units in his army up to 6" from its original position within the normal deployment zone. Additionally, when using reserves the Elday player may add +1 to a single reserve roll each turn.</description>
        </rule>
      </rules>
