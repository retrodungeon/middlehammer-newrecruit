        <rule id="3542-6817-d0c6-ab2a-c5359" name="Sun's Brilliance" page="106" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When Baharroth enters play from Deep Strike, all enemy units within 6" must take a test as if hit by a weapon with the Blind special rule. Models that are immune to the Blind special rule are immune to Sun's Brilliance.</description>
