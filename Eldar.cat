    </profile>
    <profile id="ca07-70a6-88ea-513a-c5359" name="Ghosthelm" page="153" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with a Ghosthelm suffers an unsaved Wound from Perils of the Warp, he can prevent it by immediately expending a Warp Charge (if he has one).</characteristic>
      </characteristics>
    </profile>
    <profile id="3fa1-5935-b7ab-8fad-c5359" name="Ghostplate Armour" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Ghostplate Armour confers a 4+ Armour Save and a 6+ Invulnerable Save.</characteristic>
      </characteristics>
    </profile>
    <profile id="0324-5273-11b6-af80-c5359" name="Ghostspear" page="225" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
