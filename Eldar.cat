    <selectionEntry id="ee7f-3b83-10f0-46ac-c5359" name="Lord of the Undying Host [FW]" page="179" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="cee9-e7fa-ce95-5c44-c5359" name="Wisdom from Beyond the Veil" page="179" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If taken as the army's Warlord, the Wraithseer may roll two D6 when determining the Warlord Trait to be used and select which dice to use.</description>
        </rule>
        <rule id="73f3-4b08-0073-df73-c5359" name="Bound to Serve" page="179" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Wraithblade units from this Formation may re-roll missed close combat attacks of a '1' on the turn they charge into a combat that includes the Wraithseer chosen as part of this Formation.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
