e" includeChildForces="false" /></constraints><profiles><profile id="e3b5f512-4952-5ee4-9156-8c2cf0193e30-6eb40c7" name="Soulshrive" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Melee</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3*</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Master-crafted, Spiritstealer</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="3cd5caeb-cec1-dc65-51b7-18215be871bf-6eb40c7" name="The Wraithforge Stone" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3cd5caeb-cec1-dc65-51b7-18215be871bf-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="3cd5caeb-cec1-dc65-51b7-18215be871bf-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="8adcdeb7-40f6-424c-351f-a629ebd47d9d-6eb40c7" name="The Wraithforge Stone" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323" /><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="81519aa7-5962-017e-980c-7ca34d42f025-6eb40c7" name="Guardian Helm of Xellethon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="81519aa7-5962-017e-980c-7ca34d42f025-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="81519aa7-5962-017e-980c-7ca34d42f025-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="926d8c0b-0e4a-65ec-f4f1-c1d77e2d0ec8-6eb40c7" name="Guardian Helm of Xellethon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323" /><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="b547bed9-7dad-a23c-021f-e54a5b883acd-6eb40c7" name="Spear of Teuthlas" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b547bed9-7dad-a23c-021f-e54a5b883acd-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b547bed9-7dad-a23c-021f-e54a5b883acd-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="0a95e4d1-934b-7239-0523-87ffecd43b41-6eb40c7" name="Spear of Teuthlas (Melee)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Melee</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armorbane, Fleshbane, Rending</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="4b3bb6e1-6deb-eee3-789a-d52544defa98-6eb40c7" name="Spear of Teuthlas" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">9</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Fleshbane, Rending</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="514f99d4-08e1-4b3f-329e-e6cd66a909fb-6eb40c7" name="Remnants of Glory" hidden="false" collective="false" import="true"><modifiers><modifier type="set" field="514f99d4-08e1-4b3f-329e-e6cd66a909fb-maxSelections-6eb40c7" value="0.0"><conditions><condition type="atLeast" value="1" field="selections" scope="9035a7a3-c92d-45de-aa8f-459d8667db69-6eb40c7" childId="cbc017b5-3150-7686-fc39-6928fccf3499-6eb40c7" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier type="set" field="514f99d4-08e1-4b3f-329e-e6cd66a909fb-maxSelections-6eb40c7" value="-1.0"><conditions><condition type="equalTo" value="0" field="selections" scope="9035a7a3-c92d-45de-aa8f-459d8667db69-6eb40c7" childId="cbc017b5-3150-7686-fc39-6928fccf3499-6eb40c7" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint type="max" value="-1" field="selections" scope="parent" shared="true" id="514f99d4-08e1-4b3f-329e-e6cd66a909fb-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e9712a96-6b4a-9603-88a8-2729a6a726af-6eb40c7" name="The Phoenix Gem" hidden="false" collective="false" import="true" type="upgrade" page="69"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e9712a96-6b4a-9603-88a8-2729a6a726af-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e9712a96-6b4a-9603-88a8-2729a6a726af-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="d73588ce-eba3-73ec-e472-ba6e24f75b4f-6eb40c7" name="The Phoenix Gem" hidden="false" page="69"><description>One use only. Immediately before the bearer of the Phoenix Gem is removed as a casualty, roll a D6. On a score of 1, remove the model as a casualty. On a score of 2-6, centre the large blast marker over the model. Each unit (friend or foe) suffers a number of Strength 4 AP5 hits equal to the number of models from their unit, excluding the bearer, that are at least partially under the template. If at least one unsaved Wound is caused, the bearer is not removed as a casualty, but remains in play with a single Wound remaining. If no unsaved Wounds are caused, remove the model as a casualty. (7th Ed wording)</description></rule></rules></selectionEntry><selectionEntry id="859c217b-7a0f-7772-fcfa-8cf4f63eab40-6eb40c7" name="The Spirit Stone of Anath'lan" hidden="false" collective="false" import="true" type="upgrade" page="69"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="859c217b-7a0f-7772-fcfa-8cf4f63eab40-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="859c217b-7a0f-7772-fcfa-8cf4f63eab40-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="15cf5085-9934-0977-3b84-d50996c59fad-6eb40c7" name="The Spirit Stone of Anath'lan" hidden="false" page="69"><description>Every time the bearer of the Spirit Stone of Anath'lan attempts to manifest a psychic power, he can choose to reduce the Warp Charge cost by 1 (to a minimum of 1). If he does so, he cannot use his rune armour's invulnerable save until the start of his next turn. (7th Ed wording)</description></rule></rules></selectionEntry><selectionEntry id="f6e9334b-7025-92ff-c997-e5c496a13572-6eb40c7" name="Uldanorethi Long Rifle" hidden="false" collective="false" import="true" type="upgrade" page="69"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f6e9334b-7025-92ff-c997-e5c496a13572-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f6e9334b-7025-92ff-c997-e5c496a13572-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="9363035c-d90c-e72b-efe4-df6b5fc5acfe-6eb40c7" name="Uldanorethi Long Rifle" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="69"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">120"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">X</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Sniper</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="a251894a-bd9d-a812-4315-394c0b53eb82-6eb40c7" name="Faolchu's Wing" hidden="false" collective="false" import="true" type="upgrade" page="69"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a251894a-bd9d-a812-4315-394c0b53eb82-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="a251894a-bd9d-a812-4315-394c0b53eb82-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="8a73b866-2f58-252f-9d3d-47568a695dff-6eb40c7" name="Faolchu's Wing" hidden="false" page="69"><description>A model with Faolchú's Wing can Run up to 48" in its Shooting phase, provided that it did not manifest any psychic powers or shoot this turn. If it does so it cannot shoot or charge for the remainder of the turn. However, the model can re-roll failed cover saves until the start of its next turn. (7th Ed wording)</description></rule></rules></selectionEntry><selectionEntry id="7babd3eb-a57f-cdbc-0a1a-81faafd5e388-6eb40c7" name="Firesabre" hidden="false" collective="false" import="true" type="upgrade" page="69"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7babd3eb-a57f-cdbc-0a1a-81faafd5e388-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="7babd3eb-a57f-cdbc-0a1a-81faafd5e388-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="2033a71d-9eb9-0f9e-29ff-1de3a0be4d9d-6eb40c7" name="Firesabre" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="69"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Melee</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Soulblaze, Wildfire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="acd2eafa-0296-fec1-00ef-6aafc21d7ab0-6eb40c7" name="Mantle of the Laughing God" hidden="false" collective="false" import="true" type="upgrade" page="69"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="acd2eafa-0296-fec1-00ef-6aafc21d7ab0-maxSelections-6eb40c7" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="acd2eafa-0296-fec1-00ef-6aafc21d7ab0-maxInRoster-6eb40c7" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="29e19fdb-bc98-7aee-24d3-cae2f82a7eea-6eb40c7" name="Mantle of the Laughing God" hidden="false" page="69"><description /></rule></rules></selectionEntry><selectionEntry id="b5314972-9b61-d178-fd59-fdf8e52d5b85-6eb40c7" name="Shard of Anaris" hidden="false" collective="false" import="true" type="upgrade" page="69"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b5314972-9b61-d178-fd59-fdf8e52d5b85-maxSelections-6e