              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9cf4-1314-20f4-e879" type="max" />
              </constraints>
              <rules>
                <rule id="9c50-9ed7-424c-177a" name="Family Banner" hidden="false">
                  <description>While the Family Banner is still on the table, the Chief and his Kinsmen may re-roll any missed close combat attacks on the same turn that they charged into an assault.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" />
