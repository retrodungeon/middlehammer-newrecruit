    <selectionEntry id="6bed-7fdf-fed1-3f07-c5359" name="Wraith Host" page="145" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="1917-9737-95e9-8fb9-c5359" name="Guided Wraithsight" page="145" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Wraithguard, Wraithblades, Wraithlords and Wraithknights from this Formation can re-roll failed To Hit rolls against enemy units that are within 18" of the Spiritseer from this Formation.</description>
