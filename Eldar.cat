        <selectionEntry id="90fd-8347-6bea-3a77-c5359" name="Mask of Jain Zar" page="103" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="e978-76d3-2e02-f263-c5359" name="Mask of Jain Zar" page="103" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models cannot fire Overwatch against Jain Zar or a unit she has joined, and enemy models within 6" of Jain Zar subtract 5 from their Weapon Skill and Initiative (to a minimum of 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
