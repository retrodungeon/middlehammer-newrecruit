    <selectionEntry type="unit" import="true" name="Asurmen" hidden="false" id="c8e5-e2d1-c8d2-a9e5">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="230" />
      </costs>
      <profiles>
        <profile name="Sword of Asur" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="e8c4-1d22-77d0-bf89">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">The Sword of Asur is a diresword that allows Asurmen to re-roll misses in close combat.</characteristic>
          </characteristics>
        </profile>
        <profile name="Disciplines (Dire Avengers)" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="167d-6ec6-c09b-65b2">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If the Phoenix Lord is leading a squad of their Aspect, the whole squad becomes Fearless. Phoenix Lords cannot join Aspect Warrior squads not of their Aspect. Note that if a squad has two of the same Exarch power, they are not cumulative.</characteristic>
          </characteristics>
        </profile>
        <profile name="Battle Fate" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="f207-cec6-c022-aec9">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">This model has a 4+ Invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
