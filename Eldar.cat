    <selectionEntry id="c247-a310-f563-6418-c5359" name="Seer Council" page="141" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="45dc-1514-93cf-8988-c5359" name="Psychic Bond" page="141" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Both Farseers must join the Warlock Conclave before deployment, and cannot leave the unit.</description>
        </rule>
        <rule id="a137-ef26-62e4-eea0-c5359" name="Path of the Seer" page="141" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If this Formation is chosen as your Primary Detachment, you can re-roll the result when rolling on the Warlord Traits table in Codex: Craftworlds.</description>
        </rule>
        <rule id="edd2-cf38-155a-d670-c5359" name="Psychic Might" page="141" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When models from this Formation make Psychic tests, results of 3+ will harness a Warp Charge point instead of results of 4+.</description>
        </rule>
        <rule id="abf6-0360-5da9-56ad-c5359" name="Formation Restrictions (Seer Council)" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If any Farseer or Warlock in this Formation upgrades to be a Farseer Skyrunner or Warlock Skyrunner, all other models must also do so.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
