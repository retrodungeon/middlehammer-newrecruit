            <profile id="c140-0d76-105a-dabc-c5359" name="The Maugetar (Shrieker)" page="107" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
