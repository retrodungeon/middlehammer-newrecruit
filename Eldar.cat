          </characteristics>
        </profile>
        <profile id="3a23-b0f7-404c-267c-c5359" name="Warp Breach (3 Members)" page="181" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">72"</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">D</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Ordnance 1, Massive Blast (7"), Twin-Linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="d22d-89cd-83d1-5a24-c5359" name="Fist of Vaul" page="181" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All Warp Hunters bought as part of this Formation form a vehicle squadron and must take the same upgrades.</description>
        </rule>
        <rule id="ec54-57ea-7fe9-2ca4-c5359" name="Warp Breach" page="181" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Multiple Warp Hunters may choose to forfeit their individual shooting attacks in order to make a single Warp Breach attack and the profile for the Warp Breach attack is based on the number of Warp Hunters taking part in the attack. When making a Warp Breach attack, the target must be within valid line of sight and range for all the participating Warp Hunters.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
      <selectionEntryGroups>
        <selectionEntryGroup id="d9ce-6b45-174b-9eb6-c5359" name="2 - 3 Warp Hunters, with the same upgrades" hidden="false" collective="false" defaultSelectionEntryId="76ec-6a12-e5b9-47a7-c5359">
