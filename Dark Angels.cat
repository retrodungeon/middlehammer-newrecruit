    <selectionEntry id="e071-3e76-a931-987a-bf89a" name="The Hammer of Caliban" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="444c-b8cb-c2d2-aa02-bf89a" name="Hammer of Heretics" page="145" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>This Formation's Techmarine must begin the game embarked upon this Formation's Land Raider, Land Raider Crusader or Land Raider Redeemer. Whilst the Techmarine from this Formation is embarked upon the Transport vehicle from this Formation, that vehicle's Ballistic Skill is increased to 5.</description>
        </rule>
        <rule id="2dc0-1be6-6498-dcfa-bf89a" name="Might of the Lion" page="145" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All vehicles in the formation form a single Vehicle Squadron, but count as 2 units when calculating VPs if completely destroyed.</description>
        </rule>
      </rules>
