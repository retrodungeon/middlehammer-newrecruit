              <profiles>
                <profile id="7f9d-ac3e-9de9-259b-bf89a" name="Macro-Bomb Cluster Payload" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
