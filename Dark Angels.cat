3" Blast, Rocket Barrage</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="b776f053-4245-bca1-1b47-932fb4ac7ab2-6ed3225" name="Searchlight" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After firing all weapons can illuninate the unit it shot at and it's self during night fighting</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile><profile id="97e2b451-caf0-c6cd-ccd5-f4ae53f391ab-6ed3225" name="Siege Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Auto Pass Dangerous terrain</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile><profile id="e0decf04-46c9-fe9d-9c05-3d8716a33857-6ed3225" name="Signum" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Forego shoting to grant one other model in his unit BS 5, declare before any rolls are made.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile><profile id="4d58db03-31f8-4a5c-0b0d-53db43a768a9-6ed3225" name="Smoke Launchers" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Once per game, instead of shooting or moving flat out, may gain a 5+ cover save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile><profile id="4dcb57ac-2315-ef64-624f-e0743e960ca7-6ed3225" name="Space Marine" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="aed09071-b18e-76b9-53b6-1c38261bc944-6ed3225" name="Space Marine Bike" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Change unit type to Bike, and gives +1 to Toughness. has built-in Twinlinked Bolter.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile><profile id="419232a4-1844-2460-787c-189a0ef6707d-6ed3225" name="Space Marine Sergeant" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">1</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c7243ad2-e53f-3a82-0a57-4c134ca873b8-6ed3225" name="Standard of Devastation" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinnning tests and all models within 6" treat their bolters as Salvo 2/4 instead of rapid fire.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile><profile id="9fbc229a-4789-8149-7902-6b9c78c2ef6c-6ed3225" name="Standard of Fortitude" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angles within 12" re-roll failed morale and pinning tests and have Feel no Pain (5+)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile><profile id="fed2780e-cc32-cc8c-bd2f-da3229d52904-6ed3225" name="Standard of Retribution" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinning tests and have the Counter-Attack special rule.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile><profile id="a524478f-9b6f-7834-89dd-37518b0c9810-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile><profile id="619a0136-86e6-1470-bd0e-d586455fd3b7-6ed3225" name="Storm Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++ but can never count as having 2 close combat weapons</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile><profile id="da17c2bf-7a1a-baa5-b0ea-21f26b78fd64-6ed3225" name="Teleport Homer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly Terminato