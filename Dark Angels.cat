        <infoLink name="Independent Character" id="3260-dbe4-989e-68e0" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
      </infoLinks>
      <rules>
        <rule name="Know Thine Enemy" id="30c7-e913-2e44-c790" hidden="false">
          <description>The Dark Angels player may, if they choose, demand that their opponent set up D6 units before any of the Dark Angels deploy. The Dark Angel's player may pick which D6 units are affected, even if units must normally be deployed in a special order during the mission set-up.</description>
        </rule>
        <rule name="Weaken Resolve" id="bd63-d267-f375-9e9f" hidden="false">
          <description>Attempt to use this power when an enemy unit with a model within 12" has to take a Morale check. On a successful Psychic test then the enemy unit must take its Morale check on a 3D6 added together. This power may only be used once per player turn.</description>
        </rule>
      </rules>
