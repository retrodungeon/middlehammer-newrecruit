        <infoLink name="Independent Character" id="d5e7-c7a9-4de9-e66c" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule" />
      </infoLinks>
      <rules>
        <rule name="No Retreat" id="cbaa-7d5f-fcf8-0123" hidden="false">
          <description>As long as Azrael is on the table all members of the Dark Angels army count as being stubborn, including members of the Ravenwing.</description>
        </rule>
        <rule name="No Surrender" id="ecd5-08f3-4de8-8dc8" hidden="false">
          <description>In any scenario that has a variable turn limit, you may re-roll the dice if the mission ends, if you want.</description>
        </rule>
      </rules>
