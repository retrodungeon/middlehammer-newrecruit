></modifier></modifiers><categoryLinks><categoryLink name="HQ" hidden="false" id="fef857ab-30ae-5ccf-6497-548391d63665-slot-6ed3225" targetId="ac8d-efba-1884-d3ad" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="145" /></costs><constraints><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="fef857ab-30ae-5ccf-6497-548391d63665-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="94124edc-6c0b-8e0f-df81-121b293fea17-6ed3225" name="Ezekiel" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="54"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Unique, Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">54</characteristic></characteristics></profile></profiles><rules><rule id="e8df57ab-9506-ca81-c055-347d29733a82-6ed3225" name="Psyker (Mastery Level 3)" hidden="false" page="0"><description>May choose 2 Psychic Powers from Divination, Pyromancy, Telepathy and Telekinesis</description></rule><rule id="50e9007f-e6b5-d4a8-d8ee-69b2fed48d16-6ed3225" name="Warlord Trait: The Hunt" hidden="false" page="56"><description>+1 Victory point if your Warlord or his unit kill enemy Warlord in the Assault phase.</description></rule></rules><selectionEntries><selectionEntry id="44bc44cf-0359-0ed5-d9ad-eff9d35fdd70-6ed3225" name="Psychic Hood" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="44bc44cf-0359-0ed5-d9ad-eff9d35fdd70-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="44bc44cf-0359-0ed5-d9ad-eff9d35fdd70-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3efdd9b1-a137-fae2-6ebb-becc734714aa-6ed3225" name="Psychic Hood" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="68"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Each Time a unit (or model) is targeted by an enemy psychic power and is within 6" of a frieldly model with a psychic hood, the wearer may attempt to deny the witch as if he were in the unit.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">68</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="18606452-90e8-3672-16c8-2a82a7b81697-6ed3225" name="Book of Salvation" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="18606452-90e8-3672-16c8-2a82a7b81697-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="18606452-90e8-3672-16c8-2a82a7b81697-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="797b6d08-73a1-8a4e-8592-81ff31fe003f-6ed3225" name="Book of Salvation" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="54"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly Dark Angels within 6" add 1 to their WS</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">54</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b77ada99-e3b0-181f-a377-2145036c3499-6ed3225" name="Unique Psychic Power: Mind Worm" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b77ada99-e3b0-181f-a377-2145036c3499-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b77ada99-e3b0-181f-a377-2145036c3499-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a14f18c6-82ce-fcb6-bdc4-1a8b140f9668-6ed3225" name="Mind Worm" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="54"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Warp Charge 1, Assault D3, Ignores Cover, Sap Will (For each unsaved wound a model suffers, that model's WS, BS, I and Ld are r