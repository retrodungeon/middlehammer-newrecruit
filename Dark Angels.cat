          <profiles>
            <profile id="mh-rad-dark-angels-cd373701-efd9-95bf-dcdf-65e6ec404e38" name="Luminiferous Resonator" publicationId="ca571888--pubN84158" page="227" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">10*</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Salvo 3/6</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-dark-angels-9101-e657-9a00-098a" name="Luminiferous Resonator" hidden="false">
              <description>Strength value is compared to the target's Leadership instead of toughness. The weapon has no effect on vehicles or any model without a Leadership characteristic.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35.0" />
          </costs>
        </selectionEntry>
