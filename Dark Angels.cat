      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Shred, Master-crafted, Rending, Specialist Weapon</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-067e9186-0fba-6430-507f-4fbaaecd0d17" name="Scorpius Bolt Shells" publicationId="ca571888--pubN80998" page="85" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
