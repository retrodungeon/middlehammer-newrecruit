          <profiles>
            <profile id="mh-rad-dark-angels-6a07-1ff8-d5ad-09e9" name="Zeroth Conductor Shield" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
              <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Zeroth conductor shield is counted as a combat shield. An enemy unit that charges the bearer of the Zeroth conductor shield sustains 0 6 Str 8 AP 2 Blind hits at Initiative step 10.</characteristic></characteristics></profile>
          </profiles>
