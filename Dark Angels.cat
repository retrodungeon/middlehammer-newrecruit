ing through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="4a588186-6d9b-6f49-8d8e-c79aae8bc709-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="560956b4-bffa-00fd-5cd8-c88814dc7d56-6ed3225" name="Unit Type" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="560956b4-bffa-00fd-5cd8-c88814dc7d56-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="560956b4-bffa-00fd-5cd8-c88814dc7d56-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="cc12f4b5-72bc-63d4-dfcf-864ca1c4f087-6ed3225" name="Space Marine Bike" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cc12f4b5-72bc-63d4-dfcf-864ca1c4f087-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profi