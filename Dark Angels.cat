      <rules>
        <rule id="f831-97bf-77d3-4651-bf89a" name="Severing Cut" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Each time a non-vehicle model suffers a wound, roll a D6. On a 4+, the model suffers D3 extra wounds which must be saved separately using the weapon's profile. These to not generate extra wounds.</description>
        </rule>
      </rules>
