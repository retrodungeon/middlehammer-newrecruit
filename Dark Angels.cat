      <rules>
        <rule id="e988-0f14-6bd6-04ee-bf89a" name="Reactor Meltdown" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If the Reaver Titan suffers a Titanic Explosion! result on the Catastrophic Damage Table, it plasma reactor goes nuclear! All hits from this Titanic Explosion! are resolved as being froma Destroyer Weapon.</description>
        </rule>
      </rules>
