ntry><selectionEntry id="42f640a0-9ee9-5232-9048-1e6af9952469-6ed3225" name="Combat Shield" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="42f640a0-9ee9-5232-9048-1e6af9952469-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a36ea735-67a8-271b-0759-92f659bd0383-6ed3225" name="Combat Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">6++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a5f595ac-4a5a-aa51-f433-80063e43dec6-6ed3225" name="Infravisor" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a5f595ac-4a5a-aa51-f433-80063e43dec6-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f56dfb2d-d246-3dd7-37e4-c090a0e2b8f6-6ed3225" name="Infravisor" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Has night vision, but sounts as Initive 1 for blind tests</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8fbcef7d-0029-55c2-b3c5-8aab98d28193-6ed3225" name="Melta Bombs" hidden="false" collective="false" import="true" type="upgrade" page="62"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8fbcef7d-0029-55c2-b3c5-8aab98d28193-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="55ad3dfe-8d79-ddfe-843e-34dc60b0575e-6ed3225" name="Melta Bombs" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="75ed5961-b796-23b0-8c0a-a75b336f2d69-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="75ed5961-b796-23b0-8c0a-a75b336f2d69-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="215b66f6-3c71-ce5d-da7e-8a9416dfd422-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b16d2bbb-58be-5850-7838-0782e277eabb-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b16d2bbb-58be-5850-7838-0782e277eabb-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="35ddc7a6-7e1e-8685-3543-47379bc03e8e-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e550c074-e207-4fbc-224a-ca7587f1f92d-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e550c074-e207-4fbc-224a-ca7587f1f92d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b9d06f39-0963-0356-23d6-20f609f64a59-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1cf8ad25-12f1-bed9-4b3b-1d37c4e2f966-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1cf8ad25-12f1-bed9-4b3b-1d37c4e2f966-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ae280c8d-6fb8-c28c-7aef-57e335205da2-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="94462e0b-bf4e-ed38-7de9-5f817b88ac6f-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="94462e0b-bf4e-ed38-7de9-5f817b88ac6f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="fa79ba10-6928-004f-4128-ed67f25c9d7b-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="33eafc00-0f95-5385-ff20-5df4bbd91f8d-6ed3225" name="Command Squad" hidden="false" collective="false" import="true" type="model" page="33"><categoryLinks><categoryLink name="No Force Org Slot" hidden="false" id="33eafc00-0f95-5385-ff20-5df4bbd91f8d-slot-6ed3225" targetId="be45-5314-4388-5bfd" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><modifiers><modifier type="increment" field="33eafc00-0f95-5385-ff20-5df4bbd91f8d-maxInRoster-6ed3225" value="1.0"><conditions><condition type="equalTo" value="1" field="selections" scope="roster" childId="85fcc0d3-b135-dd2b-83fa-2bcc97e4449e-6ed3225" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier type="increment" field="33eafc00-0f95-5385-ff20-5df4bbd91f8d-maxInRoster-6ed3225" value="1.0"><conditions><condition type="equalTo" value="1" field="selections" scope="roster" childId="ca7afccf-ee37-ccd7-0627-fa8de1534c99-6ed3225" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier type="increment" field="33eafc00-0f95-5385-ff20-5df4bbd91f8d-maxInRoster-6ed3225" value="1.0"><conditions><condition type="equalTo" value="1" field="selections" s