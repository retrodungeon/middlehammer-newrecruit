                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">10</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Blast, Blind, Rift Vortex</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="0757-27a8-8522-6035-bf89a" name="Rift Vortex" page="150" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>If any double is rolled when rolling for scatter for an attack made by this weapon, resolve the rest of the attack as if the weapon had the Vortex special rule.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="d40f-13da-906d-123f-bf89a" hidden="false" targetId="3d3c-398b-775d-72ff" type="rule">
