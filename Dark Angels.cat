  <profile id="mh-rad-dark-angels-fde1-0fa8-0a36-2bed" name="Atomantic Deflector" publicationId="ca571888--pubN89821" page="239" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Grants a 5+ Invulnerable save against shooting attacks and explosions which originate from the front arc.  In addition, when suffering a Vehicle Explodes results, add 1" to the radius of the blast.  </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-10f9-2548-8824-2e2a" name="Atomantic Overcharge" publicationId="ca571888--pubN89821" page="239" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">At the beginning of the controlling players turn, they may declare that the Contemptor-Cortus is overcharging its Atomantic reactor.  They may then apply one of the following bonuses until the end of the player turn:  - Rage special rule - 1" Move and Charge distances - 2" Run distance - 1 Initiative  At the end of its player turn, rolla  D6.  On a roll of a 1, lose a hull point.  If this is enough to wreck the dreadnought, it suffers an immediate Vehicle Explodes and the blast is increased by D3" instead of the usual 1".  </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-239e677c-9ec8-69cf-7923-7a344b33711f" name="Banestrike Bolter Shells" publicationId="ca571888--pubN113187" page="9" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Reduces range of Boltgun and Combi-bolters to 18" and provides the Banestrike rule.  Weapons with Banestrike change their AP value to 3 on "to-wound" rolls of a 6. </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-38d51988-0d1a-0974-c0df-0bb6a5b2a693" name="Boarding Shield" publicationId="ca571888--pubN80998" page="89" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Boarding shields confer a 6+ invulnerable save, increased to 5+ in close combat. Models which have successfully charged any unit in which the majority of the models are equipped with boarding shields do not gain bonus Attacks from charging. However, if the charged unit was already locked in combat from a previous turn, the attackers gain bonus Attacks as normal. Boarding shields are far heavier and more cumbersome than combat shields; models equipped with them cannot claim the extra attack for being armed with an additional close combat weapon, and may not use any weapon with the Two-handed special rule.</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-99a47c75-0410-1c54-8124-3adcbd64aa7e" name="Breacher Charge" publicationId="ca571888--pubN80998" page="86" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Special</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, One Use, Blast, Wrecker</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-59304e4a-18c6-1283-455b-f79c559b207f" name="Cataphractii Terminator Armour" publicationId="ca571888--pubN80998" page="133" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Cataphractii Terminator armour affords a +2 armour save and a 4+ Invulnerable save. No Run moves, Overwatch attacks, or Sweeping Advance. </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-4687f5b1-f0b1-12bd-8cc7-27f9f25befaf" name="Cognis-signum" publicationId="ca571888--pubN80998" page="88" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Model equipped with Cognis-sigum gains Night Vision special rule.  In addition, in lieu of firing a weapon in the Shooting phase, a single designated unit of the controlling player's choice withing 6" of the signum-equipped model (excluding Independent Characters and Super-Heavies) gains a bonus of 1 to their BS for that shooting phase.  </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-244f6dcc-d526-1cef-a743-6120614e3898" name="Combat Shield" publicationId="ca571888--pubN80998" page="89" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers 6+ invulnverable save, increasing to a 5+ in close combat.</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-0ae81fbd-a9d1-4327-f3df-1fc26dce2ab1" name="Conversion Beamer (1)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">&lt; 18"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">-</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-bf49e57d-4c20-456e-40fc-2325493da257" name="Conversion Beamer (2)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">18" - 42"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-b2930d75-e708-3443-a9ba-fbba33fdf5a7" name="Conversion Beamer (3)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">42" - 72"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-a544-0b30-4b15-43ff" name="Cortex Designator" publicationId="ca571888--pubN89821" page="232" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When a model with this wargear makes a successful shooting attack against an enemy unit, any automata in the same unit gain Preferred Enemy when targeting that same enemy unit until the end of the controlling player's current turn.  </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-6e80-170b-509c-fd64" name="Cyclone Missile Launcher (Frag)" publicationId="ca571888--pubN80998" page="92" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">6</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 2, Blast</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-5847-5921-80a7-195d" name="Cyclone Missile Launcher (Krak)" publicationId="ca571888--pubN80998" page="92" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 2</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-889ea663-40f5-0ecc-7ba9-4b68e2955022" name="Grenade Harness" publicationId="ca571888--pubN80998" page="83" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">-</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 2, Blast, One use</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-abdf1422-184a-f8f9-9544-621c2e1c646f" name="Ground Tracking Auguries" publicationId="ca571888--pubN80998" page="43" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides Strafing Run special rule.  </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-0ee6cae6-b6fa-f0e7-6a77-0112ac6710a1" name="Heavy Conversion Beamer (1)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">&lt; 18"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">-</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Large Blast, Firing Calibration</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-08ebafcd-366d-43ca-2591-21133dd130d2" name="Heavy Conversion Beamer (2)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">18" - 42"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Large Blast, Firing Calibration</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-9b7588a6-5b9a-a011-dbb2-ed73a34a521f" name="Heavy Conversion Beamer (3)" publicationId="ca571888--pubN80998" page="82" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">42" - 72"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Large Blast, Firing Calibration</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-0d8bdd64-39f0-7759-d8ca-0702ee1f0fd0" name="Iliastus Assault Cannon" publicationId="ca571888--pubN113187" page="97" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 4, Rending, Malfunction</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-b4c9d27d-b3cf-28bd-3367-b1bfddd5c401" name="Illum Flares" publicationId="ca571888--pubN80998" page="90" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">May drop a single flare per turn.  Fired just as bombs - flare is placed after scattering.  Leave in place until the end of the turn.  Any unit targeting an enemy within 12" of the flare gains Night Vision for the shooting phase.  Split fire does not apply.  </characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-dae18398-f03c-63ac-5477-470244e1e687" name="Kraken Bolt Shells" publicationId="ca571888--pubN80998" page="85" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">30"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Rapid Fire</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-e74f-98b3-0573-f35a" name="Legatine Axe" publicationId="ca571888--pubN68042" page="231" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Melee, Specialist Weapon, Cutting Strike</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-b8d20a55-69ff-eb96-e080-8f495bf99283" name="Legion Sergeant" publicationId="ca571888--pubN80998" page="202" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
      <characteristics><characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="5.753232323444154e+23">4</characteristic><characteristic name="BS" typeId="4.2532323234441546e+23">4</characteristic><characteristic name="S" typeId="5.323232344415441e+21">4</characteristic><characteristic name="T" typeId="5.423232344415441e+21">4</characteristic><characteristic name="W" typeId="5.723232344415441e+21">1</characteristic><characteristic name="I" typeId="4.923232344415441e+21">4</characteristic><characteristic name="A" typeId="4.123232344415441e+21">2</characteristic><characteristic name="LD" typeId="4c4423232344415441232323">9</characteristic><characteristic name="Sv" typeId="5.361766523232344e+27">3+</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-fbcef7de-124c-9b95-7895-480adc6bc027" name="Legion Space Marine" publicationId="ca571888--pubN80998" page="202" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
      <characteristics><characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="5.753232323444154e+23">4</characteristic><characteristic name="BS" typeId="4.2532323234441546e+23">4</characteristic><characteristic name="S" typeId="5.323232344415441e+21">4</characteristic><characteristic name="T" typeId="5.423232344415441e+21">4</characteristic><characteristic name="W" typeId="5.723232344415441e+21">1</characteristic><characteristic name="I" typeId="4.923232344415441e+21">4</characteristic><characteristic name="A" typeId="4.123232344415441e+21">1</characteristic><characteristic name="LD" typeId="4c4423232344415441232323">8</characteristic><characteristic name="Sv" typeId="5.361766523232344e+27">3+</characteristic></characteristics></profile>
    <profile id="mh-rad-dark-angels-352f5f7a-45e0-0416-e7cd-1cb8f985b0ac" name="Legion Standard" publicationId="ca571888--pubN80998" page="90" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
      <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">All of the Controlling player's unist with the Legiones Astartes special rule within 6" of a Legion Standard (including its bearer) are Fearless.  </characteristic></characteristics></profile>
