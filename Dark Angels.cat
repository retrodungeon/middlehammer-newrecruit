465736372697074696f6e23232344415441232323">Forego shooting to make an enemy unit within 12" reduce it's cover save by 1, untill the end of the phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fc8324eb-aadc-1e9b-19f8-23215f7223f8-6ed3225" name="Combat Shield" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fc8324eb-aadc-1e9b-19f8-23215f7223f8-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="020f29f4-37e5-08f8-f86f-4228a68c6dde-6ed3225" name="Combat Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">6++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1d663292-e576-04b7-2a57-414e69aec1c3-6ed3225" name="Infravisor" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1d663292-e576-04b7-2a57-414e69aec1c3-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4032aca3-b32d-816c-3c8e-c273c268db81-6ed3225" name="Infravisor" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Has night vision, but sounts as Initive 1 for blind tests</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="eadfb308-585c-f070-b080-327ed66955a4-6ed3225" name="Melta Bombs" hidden="false" collective="false" import="true" type="upgrade" page="62"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="eadfb308-585c-f070-b080-327ed66955a4-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1372cc9e-f083-cdb2-6d7d-5f328ea53b5c-6ed3225" name="Melta Bombs" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c967ecfd-64c9-48ec-348a-011b3916777a-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c967ecfd-64c9-48ec-348a-011b3916777a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2caa9825-a012-2c1f-80f7-19016ae5a375-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f1faeaba-ffc7-5617-17b1-d7c4bdaf7ea8-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f1faeaba-ffc7-5617-17b1-d7c4bdaf7ea8-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bee5d010-f8ab-a29f-076c-fb64722194fa-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0a1e6b08-7e7b-ebbf-bd8d-f6c6b27c2521-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0a1e6b08-7e7b-ebbf-bd8d-f6c6b27c2521-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f8729ea4-e9da-627c-cbbf-29aad7c94175-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="301fdcdc-74d2-87b1-09e5-c8e18cd07a01-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="301fdcdc-74d2-87b1-09e5-c8e18cd07a01-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="41289222-c15f-6821-38ab-641b40c20891-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2e61d0c0-8995-fdd7-4635-e24aab979e9e-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2e61d0c0-8995-fdd7-4635-e24aab979e9e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b0c40629-e70d-31f1-56ce-90661b476958-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0a3a2f8d-bdf5-fdd3-0979-d66e09939d0c-6ed3225" name="Artificer Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0a3a2f8d-bdf5-fdd3-0979-d66e09939d0c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="281f01c6-ab29-a23c-cc05-61e73b099aa0-6ed3225" name="Artificer Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Confers a 2+ Armour Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="87613501-9567-3efe-7e3