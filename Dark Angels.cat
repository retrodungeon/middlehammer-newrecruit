    <profile id="d6cf6530-fbce-d598-1e5b-2656f638ed27-bf89a" name="Locator Beacon" page="154" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendlies do not scatter when deep striking within 6"</characteristic>
      </characteristics>
    </profile>
    <profile id="64c821df-0977-4051-2d1e-fac759d3ef32-bf89a" name="LoG: Ancient Mariner" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When the vehicle or any models it has transported triggers a roll  on the Archeotech Artefact table or any Mysterious Terrain table, the result may be re-rolled.</characteristic>
      </characteristics>
    </profile>
    <profile id="80b3419f-dc26-b69f-0b44-e6740b427eb2-bf89a" name="LoG: Battle of Calth" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Preferred Enemy (Chaos Space Marines) special rule. In addition, enemy Warlords within 12" suffer -1 to their leadership characteristic.</characteristic>
      </characteristics>
    </profile>
    <profile id="722aa143-10b0-6415-5edc-5dca6bf5db53-bf89a" name="LoG: Battle of Keylek" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any of the vehicles weapons that use any size of blast marker gain the Ignores Cover special rule.</characteristic>
      </characteristics>
    </profile>
    <profile id="a96755a1-16f4-a3e0-e3cd-fb157ff64fb3-bf89a" name="LoG: Battle of Sarosh" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, one of the vehicles weapons gains the Skyfire, Interceptor, Tank Hunters and Night Vision special rules. The use of this rule should be declared before any to hit rolls are made.</characteristic>
      </characteristics>
    </profile>
    <profile id="a169b9f1-d23e-cc77-ac5d-aa93a3733ee5-bf89a" name="LoG: Battle of Signus Prime" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has the Preferred Enemy (Chaos Demons) special rule. In addition, friendly Space Marines who begin the turn within 6" of the vehicle gain the Furious Charge special rule until the end of that turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="c4ec0c46-4b06-33e1-54d7-083a6efa64e1-bf89a" name="LoG: Battle of Terra" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the It Will Not Die special rule.</characteristic>
      </characteristics>
    </profile>
    <profile id="efb16a3b-4862-c9a3-800f-b99cef9dfe80-bf89a" name="LoG: Battle of the Phall System" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228" />
      </characteristics>
    </profile>
    <profile id="d043c075-9108-ba33-9338-a06d02f4f182-bf89a" name="LoG: Burning of Prospero" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Adamantium Will special rule. The bonus granted by this special rule is increased to +2 against Witchfire type psychic powers.</characteristic>
      </characteristics>
    </profile>
    <profile id="141a3032-05ee-0e10-34b4-1e4b9e591f78-bf89a" name="LoG: Icon of Glory" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has either +1 BS or +1 WS (declared before the game begins). Should the army's warlord be within 2" of the vehicle, the range of any Command Trait he has rolled on the warlord traits table is increased by 6".  In missions that use Objectives and Victory points to determine the winner, the destruction of the vehicle counts as an additional Secondary Objective, earning the opposing player an extra +1 Victory point.</characteristic>
      </characteristics>
    </profile>
    <profile id="54a8cfc3-d255-fb03-896c-88f79edf3ad4-bf89a" name="LoG: Isstvan III" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has the Preferred Enemy (Chaos Space Marines) special rule. In addition, it automatically passes Dangerous Terrain tests incurred for passing through ruins and similar terrain.</characteristic>
      </characteristics>
    </profile>
    <profile id="7c23a6dc-2c27-cab7-b758-2916c7621566-bf89a" name="LoG: Isstvan V Dropsite Massacre" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle never scatters when entering play via the Deep Strike special rule.</characteristic>
      </characteristics>
    </profile>
    <profile id="09252d24-ec6b-3580-66f4-a5d43143a7cd-bf89a" name="LoG: Schism of Mars" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Tank Hunter special rule. When targeting enemy models with the Daemonforge special rule, it gains +1 BS. In addition, it ignores the effects of the Haywire special rule on a D6 roll of 4+.</characteristic>
      </characteristics>
    </profile>
    <profile id="b8a33e99-3d1c-79aa-1eb1-a4b9de9f5eb3-bf89a" name="LoG: Shrouded Provenance" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Venerable special rule.  The vehicle always counts as an Ally of Convience to units in its own detachment, and as a Desperate Ally to units in any allied detachment.</characteristic>
      </characteristics>
    </profile>
    <profile id="7132c5c0-b0da-11b9-0509-7b1663dd921f-bf89a" name="LoG: Thramas Crusade" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly Space Marine models within 12" of the vehicle gain the Fearless special rule.</characteristic>
      </characteristics>
    </profile>
    <profile id="965dcc0c-40f2-1925-666a-930a8034744c-bf89a" name="LoG: Ullanor Crusade" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A dreadnought with the Ullanor Crusade Legacy of Glory gains the Hatred (Orks) Special Rule  Enemy models charging a vehicle with the Ullanor Crusade Legacy of Glory must re-roll successful To Hit rolls in the first round of each combat.</characteristic>
      </characteristics>
    </profile>
    <profile id="83f87dba-4278-117d-0721-b374a7c150aa-bf89a" name="LoG: War of Murder" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Monster Hunter special rule. In addition, friendly Space Marine units within 6" of the vehicle gain the Fearless special rule.</characteristic>
      </characteristics>
    </profile>
