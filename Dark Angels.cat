            <profile id="mh-rad-dark-angels-4b9b-5722-32ac-970c" name="Pariah Bolter" publicationId="ca571888--pubN89821" page="222" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">16"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">5</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Assault 2</characteristic></characteristics></profile>
