b5b57a7-d8c0-b20a-40db-ee9aa6f8f322-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a2d61b18-7b85-7264-19c2-c015212bd6f0-6ed3225" name="Corvus Hammer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">=</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Rending</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="05f9200a-b5fa-7ab6-6e0b-911b63260b03-6ed3225" name="Power Maul" hidden="false" collective="false" import="true" type="upgrade" page="61"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="12" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="05f9200a-b5fa-7ab6-6e0b-911b63260b03-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="418d2708-2a7a-19fc-3868-9f53be862345-6ed3225" name="Power Maul" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="d37a38b2-4db1-72a8-5a96-d3d941c86696-6ed3225" name="Corvus Hammer" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d37a38b2-4db1-72a8-5a96-d3d941c86696-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d37a38b2-4db1-72a8-5a96-d3d941c86696-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5ba15b06-933a-e66c-9a8c-063acf980e46-6ed3225" name="Corvus Hammer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">=</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Rending</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="706f31b5-39c3-faab-6f91-79b3ee10c6b4-6ed3225" name="Plasma Talon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="706f31b5-39c3-faab-6f91-79b3ee10c6b4-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="706f31b5-39c3-faab-6f91-79b3ee10c6b4-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b307fa6a-e70c-6fea-4a70-8c3173a7cf46-6ed3225" name="Plasma Talon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Gets Hot, Twin Linked</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="47e3c44a-8cdc-d8ec-17da-939c5c8a3329-6ed3225" name="Teleport Homer" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="47e3c44a-8cdc-d8ec-17da-939c5c8a3329-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="47e3c44a-8cdc-d8ec-17da-939c5c8a3329-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8b598f70-e98d-ff8d-4d9a-1279178fc6f2-6ed3225" name="Teleport Homer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly Terminators do not scatter when placed within 6", model must have started the turn on the board</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fb4dd711-b96f-1367-1a5c-3ff8f73515c6-6ed3225" name="Ravenwing Grenade Launcher" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><modifiers><modifier type="set" field="fb4dd711-b96f-1367-1a5c-3ff8f73515c6-maxSelections-6ed3225" value="2.0"><conditions><condition type="equalTo" value="5" field="selections" scope="7f72619c-14c3-a4f8-fed3-e45743ca8706-6ed3225" childId="b244796b-d435-9a08-fb44-5445ee883672-6ed3225" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier type="set" field="fb4dd711-b96f-1367-1a5c-3ff8f73515c6-maxSelections-6ed3225" value="3.0"><conditions><condition type="equalTo" value="8" field="selections" scope="7f72619c-14c3-a4f8-fed3-e45743ca8706-6ed3225" childId="b244796b-d435-9a08-fb44-5445ee883672-6ed3225" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fb4dd711-b96f-1367-1a5c-3ff8f73515c6-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="0d08e740-a09f-5159-eb73-3d836ecf3e41-6ed3225" name="Ravenwing Grenade Launcher (Stasis)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">-</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Stasis Anomaly</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="6add520e-b159-85a3-a02b-8ac6d496daca-6ed3225" name="Ravenwing Grenade Launcher (Rad)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Rad Charge</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c5284f1e-e451-9e11-c909-f13782f9dd3f-6ed3225" name="Ravenwing Grenade Launcher (Krak)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="2e129ba3-dae5-3473-5780-ad698454a9dc-6ed3225" name="Ravenwing Grenade Launcher (Frag)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles><rules><rule id="a6aaf955-dcb5-6fcc-340d-5728c6286fd5-6ed3225" name="Stasis Anomaly" hidden="false" page="0"><description>Every model in a unit hit by one or more weapons with this special rule suffers a -1 penalty to their  Weapon Skill and Initiative, to a minimum of 1, until the end of the turn.</description></rule><rule id="b21ce0d2-a12c-16f0-26a7-e9c23bd022b9-6ed3225" name="Rad Charge" hidden="false" page="0"><description>Every model in a unit hit by one or more rad shells suffers a -1 penalty to their Toughness until the end of the turn ( this can affect the victims' Instant Death threshold) .</description></rule></rules></selectionEntry><selectionEntry id="4774da41-a6a1-0a8d-cc7a-06b55e933758-6ed3225" name="Grim Resolve" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="4774da41-a6a1-0a8d-cc7a-06b55e933758-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4774da41-a6a1-0a8d-cc7a-06b55e933758-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="5cf913b3-07e4-13c1-7df5-6d0ca3f8318b-6ed3225" name="Grim Resolve" hidden="false" page="28"><description>A model with this rule has Stubborn. In addition they may never choose to fail a morale check.</description></rule><rule id="a120ccc5-958d-2d3b-0fe4-59433ba8f03d-6ed3225" name="Stubborn" hidden="false" page="43"><description>Ignore all negative Ld modifiers, if the unit has Fearless as well ignore this rule.</description></rule></rules></selectionEntry><selectionEntry id="510cc5ec-8fbc-a2d4-b2ad-ce8af63eb13b-6ed3225" name="Power Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="510cc5ec-8fbc-a2d4-b2ad-ce8af63eb13b-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="510cc5ec-8fbc-a2d4-b2ad-ce8af63eb13b-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1a246ac6-8af8-441e-c5dd-896fd1314e10-6ed3225" name="Power Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Standard Space Marine Power Armour.  Confers a 3+ Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="e129ae1e-d848-64b6-8993-ff3408b0e716-6ed3225" name="Frag and Krak Grenades" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e129ae1e-d848-64b6-8993-ff3408b0e716-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e129ae1e-d848-64b6-8993-ff3408b0e716-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2586dba9-7dc5-25d6-89b3-af63daaff5a0-6ed3225" name="Frag Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Don't suffer Initive penalty for charging through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="26d9a90a-0e56-db78-b58c-583f21248c55-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="04d07443-73ee-92e8-7fcf-7e0b8ae8c819-6ed3225" name="Bolt Pistol" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="04d07443-73ee-92e8-7fcf-7e0b8ae8c819-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="04d07443-73ee-92e8-7fcf-7e0b8ae8c819-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="fb11263b-409b-4cd9-e16b-e833bf849500-6ed3225" name="Bolt Pistol" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Pistol</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="b244796b-d435-9a08-fb44-5445ee883672-6ed3225" name="Black Knight" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="42" /></costs><constraints><constraint type="min" value="2" field="selections" scope="parent" shared="true" id="b244796b-d435-9a08-fb44-5445ee883672-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="9" field="selections" scope="parent" shared="true" id="b244796b-d435-9a08-fb44-5445ee883672-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1d0150ee-db83-0008-d039-34d511ceb12c-6ed3225" name="Ravenwing Black Kinght" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-6ed3225" name="Ravenwing Command Squad" hidden="false" collective="false" import="true" type="upgrade"><categoryLinks><categoryLink name="No Force Org Slot" hidden="false" id="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-slot-6ed3225" targetId="be45-5314-4388-5bfd" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><modifiers><modifier type="increment" field="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-maxInRoster-6ed3225" value="1.0"><repeats><repeat field="selections" scope="roster" value="1" repeats="1" childId="cc12f4b5-72bc-63d4-dfcf-864ca1c4f087-6ed3225" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-maxInRoster-6ed3225" value="1.0"><repeats><repeat field="selections" scope="roster" value="1" repeats="1" childId="2a82b1dd-01bc-1dca-9570-9095e332d62b-6ed3225" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-maxInRoster-6ed3225" value="1.0"><repeats><repeat field="selections" scope="roster" value="1" repeats="1" childId="740fb9fc-0a1f-dda6-af90-ea0eb0d3d9a2-6ed3225" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-maxInRoster-6ed3225" value="1.0"><repeats><repeat field="selections" scope="roster" value="1" repeats="1" childId="94de84f8-98ba-674a-02ee-7f7a2bade157-6ed3225" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier><modifier type="increment" field="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-maxInRoster-6ed3225" value="1.0"><repeats><repeat field="selections" scope="roster" value="1" repeats="1" childId="15e8e31a-7595-459a-eaac-d49459975b25-6ed3225" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false" /></repeats></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint type="max" value="0" field="selections" scope="roster" shared="true" id="b1f5f798-b379-d5e3-cad1-cf768b48e4e4-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="320c1e0c-b1e6-dcf2-dcee-382b57c714dc-6ed3225" name="Skilled Rider" hidden="false" page="41"><description>Automatically passes Dangerous Terrain and recieves +1 to Jink saves</description></rule><rule id="4468298c-6beb-e692-b706-3fc51fe4f7b1-6ed3225" name="Scouts" hidden="false" page="41"><description>After all deployment but before first turn a unit with this rule may redeploy, if it is Infantry, Artillery, Walker or a Monstrous Creature it may redeploy anywhere within 6", all other unit types may redelpoy anywhere within 12".
Any unit that redelpoys with this rule may not charge on the first turn.
If held in reserve, the unit gains outflank.</description></rule><rule id="373054d9-0d92-af1f-4310-b34501e75549-6ed3225" name="Hit &amp; Run" hidden="false" page="38"><description>Take an Initiative test at the end of the assault phase, if succesful choose a direction and roll 3D6, move that far ignoring all models in base contact, if this would take you within 1" of another unit stop 1" away, treat all terrain as dangerous. The unit left makes an immediate D6" consolidation. </description></rule><rule id="ae4b9d4e-6274-6658-3f92-a451c16ffd26-6ed3225" name="And They Shall Know No Fear" hidden="false" page="33"><description>Automatically regroups, can act normally on the turn it regroups, not killed by sweeping advances and is immune to fear.</description></rule></rules><selectionEntries><selectionEntry id="e5d18b55-efc5-7350-fdb1-9eb7c46d979d-6ed3225" name="Black Knight" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40" /></costs><constraints><constraint type="min" value="3" field="selections" scope="parent" shared="true" id="e5d18b55-efc5-7350-fdb1-9eb7c46d979d-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="5" field="selections" scope="parent" shared="true" id="e5d18b55-efc5-7350-fdb1-9eb7c46d979d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7e786a35-57d3-8e98-1459-23c6f03a435b-6ed3225" name="Ravenwing Black Kinght" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="b45bde3b-810a-89a7-42bb-c38ed408dee0-6ed3225" name="Corvus Hammer" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b45bde3b-810a-89a7-42bb-c38ed408dee0-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b45bde3b-810a-89a7-42bb-c38ed408dee0-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b304eec6-93e0-8224-0e33-2f5212ce7378-6ed3225" name="Corvus Hammer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">=</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Rending</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="26ee51eb-b859-4b2e-bf6b-8324b1a8c60c-6ed3225" name="Plasma Talon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="26ee51eb-b859-4b2e-bf6b-8324b1a8c60c-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="26ee51eb-b859-4b2e-bf6b-8324b1a8c60c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d285be20-e0fb-ed82-2ff4-3126794bacd6-6ed3225" name="Plasma Talon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Gets Hot, Twin Linked</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="91ebb444-bc0b-c4ba-63f4-8b1db7b444a9-6ed3225" name="Teleport Homer" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="91ebb444-bc0b-c4ba-63f4-8b1db7b444a9-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="91ebb444-bc0b-c4ba-63f4-8b1db7b444a9-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="58c09934-cc4b-9f21-874f-e236a9a44886-6ed3225" name="Teleport Homer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly Terminators do not scatter when placed within 6", model must have started the turn on the board</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1c55d071-03d1-e608-fa2f-ba72baf0e2d3-6ed3225" name="Ravenwing Apothecary" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1c55d071-03d1-e608-fa2f-ba72baf0e2d3-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8c41fe45-2d60-b25e-87b6-fdbd3bd54a74-6ed3225" name="Ravenwing Apothecary" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles><rules><rule id="6471ac40-e3ba-f413-f110-b519dbfa7ef6-6ed3225" name="Feel No Pain" hidden="false" page="0"><description>Ignore unsaved wounds on a 5+, treat it as saved wound</description></rule></rules></selectionEntry><selectionEntry id="072d21b1-1156-fdda-cf5e-854883eb90e4-6ed3225" name="Ravenwing Champion" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="072d21b1-1156-fdda-cf5e-854883eb90e4-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="94dba2d7-3619-f14e-8116-8d0c9d2c7ec7-6ed3225" name="Ravenwing Champion" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">1</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">9</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="2cb19cb7-e85b-fd43-564f-7ce86f9f5ed9-6ed3225" name="Ravenwing Grenade Launcher" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2cb19cb7-e85b-fd43-564f-7ce86f9f5ed9-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="714f39bd-35cc-8907-f90d-7c2f34cbecda-6ed3225" name="Ravenwing Grenade Launcher (Stasis)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">-</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Every model hit suffers -1 to Weapon Skill and Initiative</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="50f45a7b-d12a-8693-e91c-0cad20094709-6ed3225" name="Ravenwing Grenade Launcher (Rad)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Every model hit suffers -1 to Toughness</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="cfc4b60b-963b-208e-799d-95707d6d534b-6ed3225" name="Ravenwing Grenade Launcher (Krak)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="5cfccf08-6d5b-5d3c-de7a-e26a980e02d1-6ed3225" name="Ravenwing Grenade Launcher (Frag)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="61b72995-fc6b-12cc-9c67-5843c2e744df-6ed3225" name="Grim Resolve" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="61b72995-fc6b-12cc-9c67-5843c2e744df-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="61b72995-fc6b-12cc-9c67-5843c2e744df-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="bf44437c-e70e-8585-edd6-7feb34b15925-6ed3225" name="Grim Resolve" hidden="false" page="28"><description>A model with this rule has Stubborn. In addition they may never choose to fail a morale check.</description></rule><rule id="d841dada-69c3-30a1-88e1-71600d39e308-6ed3225" name="Stubborn" hidden="false" page="43"><description>Ignore all negative Ld modifiers, if the unit has Fearless as well ignore this rule.</description></rule></rules></selectionEntry><selectionEntry id="c455ed56-9f1f-44ff-f506-c5a0a33a91a3-6ed3225" name="Power Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c455ed56-9f1f-44ff-f506-c5a0a33a91a3-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c455ed56-9f1f-44ff-f506-c5a0a33a91a3-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ade4f98b-3207-1fdc-b00f-5c8722d7b830-6ed3225" name="Power Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Standard Space Marine Power Armour.  Confers a 3+ Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="07a1a783-ce33-8863-3194-23dcf14b151c-6ed3225" name="Frag and Krak Grenades" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="07a1a783-ce33-8863-3194-23dcf14b151c-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="07a1a783-ce33-8863-3194-23dcf14b151c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="08f6fba3-b6dd-69f9-76b2-34a7dce32b0b-6ed3225" name="Frag Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Don't suffer Initive penalty for charging through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="34ef81c2-a6a9-b438-bc80-54681eac1d66-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5087dc87-19d2-df9a-81e1-be74375d6991-6ed3225" name="Bolt Pistol" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5087dc87-19d2-df9a-81e1-be74375d6991-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5087dc87-19d2-df9a-81e1-be74375d6991-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e22a979a-afed-c5da-f0b1-61d078fffba5-6ed3225" name="Bolt Pistol" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Pistol</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="06fdf5f0-8cdb-76e2-20be-4d110452ffca-6ed3225" name="Banner" hidden="false" collective="true" import="true"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="06fdf5f0-8cdb-76e2-20be-4d110452ffca-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="05012162-6890-e137-6673-3564b5d7e3b0-6ed3225" name="Revered Standard" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="05012162-6890-e137-6673-3564b5d7e3b0-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d6dc2808-112e-6655-6dd6-b43217cfa634-6ed3225" name="Revered Standard" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinning tests, and all friendly Dark Angels within 6" have Crusader USR</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f0b58ea0-1e5e-71bc-988e-7b6fe64748b2-6ed3225" name="Ravenwing Company Banner" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f0b58ea0-1e5e-71bc-988e-7b6fe64748b2-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f0b58ea0-1e5e-71bc-988e-7b6fe64748b2-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="dc036d1e-09ae-2b6f-fed8-2e15f9a0797a-6ed3225" name="Ravenwing Company Banner" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Ravenwing units within 12" automatically pass their Hit &amp; Run checks and roll 4D6 instead of 3D6 for distance.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="6b75dda1-e4f8-7b89-7a76-b184a7aa9279-6ed3225" name="Sacred Standards" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6b75dda1-e4f8-7b89-7a76-b184a7aa9279-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="6b75dda1-e4f8-7b89-7a76-b184a7aa9279-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="6df3ec37-2ba4-af76-3d82-fdf9b07f2972-6ed3225" name="Retribution" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6df3ec37-2ba4-af76-3d82-fdf9b07f2972-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5e618ab1-dca3-86f0-26f6-6cd83ef1663b-6ed3225" name="Standard of Retribution" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinning tests and have the Counter-Attack special rule.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="703228bc-e5fb-7c22-0544-22fe32f6ad20-6ed3225" name="Devastation" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="65" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="703228bc-e5fb-7c22-0544-22fe32f6ad20-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5faa01b1-6268-80f0-5a62-61055f9e47a8-6ed3225" name="Standard of Devastation" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinnning tests and all models within 6" treat their bolters as Salvo 2/4 instead of rapid fire.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="682e1b8a-d0d4-58ec-8dce-1bf4e08dcc13-6ed3225" name="Fortitude" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="85" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="682e1b8a-d0d4-58ec-8dce-1bf4e08dcc13-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3f69d4a7-e43e-70cb-d04f-9a58482608ae-6ed3225" name="Standard of Fortitude" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angles within 12" re-roll failed morale and pinning tests and have Feel no Pain (5+)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="3eaeaf88-c265-125e-a0fa-c16174d3a4ae-6ed3225" name="Ravenwing Darkshroud" hidden="false" collective="false" import="true" type="model"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="Fast Attack" hidden="false" id="3eaeaf88-c265-125e-a0fa-c16174d3a4ae-slot-6ed3225" targetId="74fe-37c3-fbbf-849e" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="80" /></costs><profiles><profile id="cf55a00b-ee15-e275-22e2-51d29ba95c5c-6ed3225" name="Darkshroud" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">10</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">10</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Fast, Skimmer</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">2</characteristic></characteristics></profile></profiles><rules><rule id="6224783c-9d59-0d04-009a-4fca09fb5435-6ed3225" name="Deep Strike" hidden="false" page="36"><description>Read the BRB, it's too complicated to explain in a small space.</description></rule><rule id="4be30665-d47e-d357-6852-db69ea433177-6ed3225" name="Icon of Old Caliban" hidden="false" page="0"><description>Friendly Dark Angels within 12" add 1 to their combat resolution</description></rule><rule id="6c69b8ff-b7ce-e6eb-5918-da28f4a98b80-6ed3225" name="Shroud of Angels" hidden="false" page="0"><description>The Darkshroud has Shrouded Special Rule and all friendlies within 6" have stealth</description></rule><rule id="1ac22326-57ab-5120-eee2-975dfd455972-6ed3225" name="Scouts" hidden="false" page="41"><description>After all deployment but before first turn a unit with this rule may redeploy, if it is Infantry, Artillery, Walker or a Monstrous Creature it may redeploy anywhere within 6", all other unit types may redelpoy anywhere within 12".
Any unit that redelpoys with this rule may not charge on the first turn.
If held in reserve, the unit gains outflank.</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="6588738c-459d-6db6-4be8-a3d6abdc67eb-6ed3225" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6588738c-459d-6db6-4be8-a3d6abdc67eb-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6588738c-459d-6db6-4be8-a3d6abdc67eb-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5b9ed1bf-3688-f31c-049d-0aed6d103ac9-6ed3225" name="Heavy Bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5b9ed1bf-3688-f31c-049d-0aed6d103ac9-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="44472df9-b613-c5f0-a55a-d4f6558e3659-6ed3225" name="Heavy Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 3</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5e565c04-f65a-8603-9cab-f23198ec7e64-6ed3225" name="Assault Cannon" hidden="false" collective="false" import="true" type="upgrade"><costs