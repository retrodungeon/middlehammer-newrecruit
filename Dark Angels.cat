    <selectionEntry id="mh-rad-dark-angels-27575b75-5e1e-26ab-1074-fa91b73e2216" name="Archmagos Draykavac" publicationId="ca571888--pubN84158" page="300" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="mh-rad-dark-angels-27575b75-5e1e-26ab-1074-fa91b73e2216-maxInForce" type="max" />
