            <profile id="mh-rad-dark-angels-fbc12189-58a3-0699-3908-d662b373a6d4" name="Parthinian Serpent" publicationId="ca571888--pubN84158" page="225" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Skyfire, Precision Shots, Interceptor, Pinning, Preternatural Targeting</characteristic></characteristics></profile>
          </profiles>
          <rules>
            <rule id="mh-rad-dark-angels-d0c3-c6f1-9347-97fe" name="Preternatural Targeting" publicationId="ca571888--pubN84158" page="225" hidden="false">
              <description>The Parthinian Serpent is always used at the user's full Ballistic Skill, even when making snap shots</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="mh-rad-dark-angels-9570-73e9-af9c-1aa0" name="Skyfire" hidden="false" targetId="mh-rad-dark-angels-be7f-8146-6cb8-9a53" type="rule" />
