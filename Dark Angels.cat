      </profiles>
      <rules>
        <rule id="mh-rad-dark-angels-6a05-3aaa-0c64-0a52" name="Rolling Thunder" publicationId="ca571888--pubN106705" hidden="false">
          <description>On any turn in which the Sicaran Punisher does not move in both the Movement phase and Shooting phase, the controlling player may choose to have the punisher rotary cannon gain the Rending special rule for any shooting attacks made that turn.</description>
        </rule>
      </rules>
