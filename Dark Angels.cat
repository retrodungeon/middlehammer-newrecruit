            <profile id="de19-67d5-fa5e-fd71-bf89a" name="Atrapos Lascutter - Close Combat" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
              <rules />
              <infoLinks />
