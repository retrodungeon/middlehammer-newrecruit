          <rules>
            <rule id="mh-rad-dark-angels-1855-d1f8-f212-35bb" name="Charge-blade" publicationId="690c-3e82-3080-6bc0" hidden="false">
              <description>At the start of any Fight sub-phase, the controlling player may choose to activate the charge cells. If this is done, it affects all models in the unit with a charge-blade. Affected units gain the Rending and Gets Hot special rules until the end of that Fight sub-phase. </description>
            </rule>
          </rules>
