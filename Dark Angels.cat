                            <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="mh-rad-dark-angels-da40e015-a22c-ecc4-c9b8-0add9ff5d50f" type="instanceOf" />
