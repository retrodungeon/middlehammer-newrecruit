" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">re-roll failed dangerous terrain tests</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="89275e47-16fa-6311-75b0-de224408d227-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="89275e47-16fa-6311-75b0-de224408d227-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="31b9bada-c949-b9a0-3164-d471e514abc8-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b70cf094-2bee-7e4c-d74b-305ecd2f2c6f-6ed3225" name="Extra Armour" hidden="false" collective="false" import="true" type="upgrade" page="87"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b70cf094-2bee-7e4c-d74b-305ecd2f2c6f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id=