        <profile name="Lion Helm" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="daa7-74a4-5e2d-10e9">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">The Lion Helm is carried by the Helmer Bearer, which is represented on the tabletop by a separate miniature. This model is purely cosmetic. The Lion Helm grants Azrael and any unit he joins a 4+ Invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sword of Secrets" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="2620-41af-8cc4-17e9">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This is a Master-crafted Power Weapon which allows the wielder to strike at Strength 6 in close combat.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lion's Wrath (Boltgun)" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="f1f6-fa1c-e58c-1559">
