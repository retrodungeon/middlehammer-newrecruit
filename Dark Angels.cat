          <rules>
            <rule id="b230-8385-e7ef-f8b1-bf89a" name="Vast Stasis Anomaly" page="129" hidden="false">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <description>Any unit hit by one or more weapons with this special rule reduces its Weapon Skill and Initiative by 3 (to a minimum of 1) until the end of the turn. Furthermore, if a model suffers one or more unsaved Wounds from this weapon, it must pass a separate initiative test for each Wound suffered or be removed from play as a casualty. </description>
            </rule>
          </rules>
          <infoLinks />
          <modifiers />
