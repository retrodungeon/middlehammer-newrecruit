    <selectionEntry id="2344-b0c0-a2ef-7905-bf89a" name="Librarius Conclave" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="c35d-cc74-6e71-385b-bf89a" name="Focused Interromany" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If one other model from this formation is present within 12", double the range on the Mind Worm psychic power.</description>
        </rule>
        <rule id="2cec-83e3-47c7-7f0e-bf89a" name="Empyric Connection" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>At the start of the psychic phase, pick a model from this formation.This model can cast all psychic powers of other models within 12" and succeeds on a roll of 3+. However, no other model from this formation within 12" may manifest psychic powers.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
      <selectionEntries />
