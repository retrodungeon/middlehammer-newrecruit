lectionEntry><selectionEntry id="06bafcfc-c413-b4af-49cf-8621401caf11-6ed3225" name="Inner Circle" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="06bafcfc-c413-b4af-49cf-8621401caf11-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="06bafcfc-c413-b4af-49cf-8621401caf11-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="71d23e7d-de78-184e-9c64-795b4c120c07-6ed3225" name="Preferred Enemy (Chaos Space Marines)" hidden="false" page="40"><description>Reroll all failed to hit and to wound rolls of 1 against the chosen enemy in both shooting and assault.</description></rule><rule id="5779647d-0709-ec08-c27b-fbc79140e25e-6ed3225" name="Fearless" hidden="false" page="35"><description>Automatically pass all LD tests but cannot go to ground or use the "Our Weapons Are Usless" rule.</description></rule></rules></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="c943c712-1997-a4b6-5734-6bb5e7c79d3f-6ed3225" name="Basic Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="d9dea146-ed99-e0ab-3f86-25a9a9b69cbd-6ed3225" name="Bolt Pistol" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d9dea146-ed99-e0ab-3f86-25a9a9b69cbd-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d9dea146-ed99-e0ab-3f86-25a9a9b69cbd-maxSelections-6ed3225" includ