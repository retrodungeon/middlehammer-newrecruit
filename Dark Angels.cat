              <profiles>
                <profile id="mh-rad-dark-angels-37ec-645d-9358-b6c0" name="Grav-flux Bombard" publicationId="ca571888--pubN89821" page="236" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
                  <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">*</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Large Blast, Ignores Cover, Pinning, Graviton Collapse, Torsion Crusher</characteristic></characteristics></profile>
              </profiles>
              <rules>
                <rule id="mh-rad-dark-angels-14f8-f868-6371-7bae" name="Graviton Collapse" hidden="false">
                  <description>Instead of rolling To Wound normally with this weapon, any model caught in its blast must instead roll equal to or under their Strength on 2D6 or suffer a wound. Against targets with an Armour value, roll 3D6 for armour penetration instead. After the graviton pulse weapon has been fired, leave the Blast marker in place. This area now counts as both difficult terrain and dangerous terrain for the next turn thanks to the gravity flux.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="mh-rad-dark-angels-6c7a-366d-20fe-16c4" name="Ignores Cover" hidden="false" targetId="mh-rad-dark-angels-476c-b962-06e5-d12e" type="rule" />
