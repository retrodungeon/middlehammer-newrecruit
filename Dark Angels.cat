    <selectionEntry id="f17d-2de0-9d81-978a-bf89a" name="* Leviathan Dreadnought" hidden="true" collective="false" type="model">
      <profiles>
        <profile id="6319-3908-5c4c-16ec-bf89a" name="Leviathan Dreadnought" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">8</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">13</characteristic>
            <characteristic name="Side" typeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e">13</characteristic>
            <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">12</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">4</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Walker)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="b076-bc4f-8e83-0a8a-bf89a" name="Reinforced Atomantic Shielding" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Confers a 4++. Also add D3 to Str and radius of the blast when exploding.</description>
        </rule>
        <rule id="82e3-427d-d0e5-d55e-bf89a" name="Crushing Charge" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Inflicts 2 Hammer of Wrath attacks and gains +1 I in the turn it charges.</description>
        </rule>
        <rule id="c4fa-8501-b605-cda0-bf89a" name="Relic of Darkness" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Counts as a Relic of the Armoury, but may not take a Legacy of Glory. Immune to Malediction powers. Never is scoring and always must charge and sweeping advance if able. May not benefit from any bonuses conferred from Formations or Detachments.</description>
        </rule>
        <rule id="f3d1-8cd0-c5c1-aacc-bf89a" name="Reduce attacks" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>For each weapon replaced with a Leviathan Storm Cannon, reduce the models attacks by 1.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="3d4c-59d6-ef8b-2075-bf89a" hidden="false" targetId="7ecc-bc3d-6e22-63dc" type="rule">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </infoLink>
      </infoLinks>
      <modifiers>
