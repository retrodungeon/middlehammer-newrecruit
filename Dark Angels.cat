      <selectionEntries>
        <selectionEntry id="e015-7cad-95ac-1312-bf89a" name="Phased Plasma-fusil" page="0" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="a783-7098-369a-31b5-bf89a" name="Phased Plasma-fusil" page="0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
              <profiles />
