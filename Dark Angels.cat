    <selectionEntry id="mh-rad-dark-angels-223c-852c-a656-649e" name="Inner Circle Knights Cenobium (Heresy)" publicationId="690c-3e82-3080-6bc0" page="163" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="mh-rad-dark-angels-af92-4de2-92b5-3792" name="Order Exemplars" hidden="false">
          <description>Before the start of play each unit of Inner Circle Knights must be assigned an Order from the following list – the entire unit must be of the same Order:

