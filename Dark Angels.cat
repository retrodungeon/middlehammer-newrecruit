er" shared="true" id="c92373ee-f27f-c573-bead-e85ce3c64c91-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="988df20d-fef9-6140-543e-c91698b0b29f-6ed3225" name="Mace of Redemption" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Bane of The Traitor, Blind, Concussive</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles><rules><rule id="35c759f2-d961-8022-a851-2a150af4ad16-6ed3225" name="Bane of the Traitor" hidden="false" page="62"><description>When a Weapon with this Special Rule is used to attack a model from Codex: Chaos Space Marines, the AP is improved by 1 (to a max of 1)</description></rule></rules></selectionEntry><selectionEntry id="563038cf-77fe-092b-2966-504dcf8fdf5a-6ed3225" name="Monster Slayer of Caliban" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="563038cf-77fe-092b-2966-504dcf8fdf5a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="563038cf-77fe-092b-2966-504dcf8fdf5a-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="e52127e7-6ce7-746b-3db2-03d31b4d625a-6ed3225" name="Monster Slayer of Caliban D6=5-6" hidden="false" ty