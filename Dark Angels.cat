          <modifiers />
          <description>Belial re-rolls all failed To Hit rolls when fighting in a challenge.</description>
        </rule>
        <rule id="6d64-8a27-5979-563b-bf89a" name="Tactical Precision" page="99" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Belial and his unit do not scatter when arriving by Deep Strike.</description>
