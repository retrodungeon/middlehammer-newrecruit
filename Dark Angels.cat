den="false" page="35"><description>Automatically pass all LD tests but cannot go to ground or use the "Our Weapons Are Usless" rule.</description></rule></rules></selectionEntry><selectionEntry id="192a4884-01ed-cc57-b799-026ff72bfacd-6ed3225" name="Lion's Roar" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="192a4884-01ed-cc57-b799-026ff72bfacd-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="192a4884-01ed-cc57-b799-026ff72bfacd-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="48ed4c07-3351-117c-478e-8170163c2b6b-6ed3225" name="Lion's Roar" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter) / 7 (Lion's Roar)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter) / 2 (Lion's Roar)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Bolter) / Assault 1, Blast, Gets Hot, Master Crafted, One Shot (Lion's Roar)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7570bd0e-ebaa-2e6f-c7ea-d066af8eb10c-6ed3225" name="Mace of Redemption" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="pa