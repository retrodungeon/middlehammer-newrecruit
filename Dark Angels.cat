    <selectionEntry id="8313-b345-ab89-55ea-bf89a" name="Ravenwing Support Squadron" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="4541-9b80-28c7-d0ec-bf89a" name="Ravenshield" page="143" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>May fire overwatch if another Ravenwing unit within 24" is being assaulted. To fire a template weapon, they must be within 6" of the charged friendly unit.</description>
        </rule>
        <rule id="1e40-70b9-b4e3-8a0f-bf89a" name="Support squadron" page="143" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All vehicles in the formation form a single Vehicle Squadron, but count as 2 units when calculating VPs if completely destroyed.</description>
        </rule>
      </rules>
