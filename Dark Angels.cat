    <selectionEntry id="f86b-d8f1-11fb-ff76-bf89a" name="Ravenwing Attack Squadron" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="70d3-3cd2-845f-ee84-bf89a" name="Attack Squadron" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If the Ravenwing Land Speeder or Vengeance from this formation scores one or more hits in the shooting phase against an enemy unit, all models from this formation's Ravenwing Bike Squad or Ravenwing Attack Bike Squad add 1 to their BS when shooting at the same target for the rest of the phase. </description>
        </rule>
        <rule id="7cda-1aee-ed76-9cc6-bf89a" name="Summon the Deathwing" page="142" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Friendly units composed entirely of models with the Deathwing special rule do not scatter when they Deep Strike, so long as the first model is placed within 12" of a model from this Ravenwing Attack Squadron Formation. For this to work, the model from this Formation must have been on the battlefield at the start of the turn. </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4cf2-a582-df98-36c5-bf89a" hidden="false" targetId="1794-e0e0-bedf-e46b" type="rule">
