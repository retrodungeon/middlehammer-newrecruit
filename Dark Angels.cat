"false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5554d796-d8f0-c6b8-3b69-cb30fb13d6ef-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="026dce40-0795-5125-f987-85bbd6faee4b-6ed3225" name="Interrogator-Chaplain" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="30"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+ / 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">30</characteristic></characteristics></profile></profiles><rules><rule id="8a5b7b23-df30-f504-8dcc-930f2a14e1bc-6ed3225" name="Deathwing Assault" hidden="false" page="44"><description>Units composed entirely composed of models with this rule and wearing Terminator Armour can choose to make a Deathwing Assault.
Immediatly after determining Warlord Traits, tell your opponent which units are making a Deathwing Assault, and make a secret note on weather it happens during turn 1 or turn 2. All units chosen arrive then with no need to roll for deep strike reserves.</description></rule><rule id="5e41209a-200f-c7b1-00da-c9a6791e18bc-6ed3225" name="Vengeful Strike" hidden="false" page="44"><description>When a model with this rule arrives from Deep Strike, it treats all ranged weapons as having Twin Linked until end of turn.</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="5b80165b-3ad1-ccfc-2315-7308ef2ef1e4-6ed3225" name="Terminator Weapons" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup id="e899ded2-39cc-7bcd-2d12-d49fb243b1e2-6ed3225" name="Left Hand" hidden="false" collective="false" import="true" defaultSelectionEntryId="c0e53849-0b1a-6c94-d7f5-cca231287759-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e899ded2-39cc-7bcd-2d12-d49fb243b1e2-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e899ded2-39cc-7bcd-2d12-d49fb243b1e2-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="c0e53849-0b1a-6c94-d7f5-cca231287759-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c0e53849-0b1a-6c94-d7f5-cca231287759-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="feff3275-63d3-7135-6c5f-d846a8deba64-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415