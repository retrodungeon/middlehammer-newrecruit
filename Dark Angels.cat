lectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ac78c946-aacb-4628-cee1-48745957492e-6ed3225" name="Transport" hidden="false" collective="false" import="true" defaultSelectionEntryId="102c0b8c-53a8-2acf-b13b-d4fc333ec134-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="ac78c946-aacb-4628-cee1-48745957492e-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ac78c946-aacb-4628-cee1-48745957492e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="102c0b8c-53a8-2acf-b13b-d4fc333ec134-6ed3225" name="No Transport" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="102c0b8c-53a8-2acf-b13b-d4fc333ec134-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="2aa1c4dd-f07d-10cd-51dd-d67ed95e2880-6ed3225" name="Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2aa1c4dd-f07d-10cd-51dd-d67ed95e2880-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="17ab6132-9ac5-ab11-2aa4-ba36e1fa2108-6ed3225" name="Drop Pod" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-Topped, Transport (10 models or 1 Dreadnought)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile></profiles><rules><rule id="7311ad23-19f0-8064-7df3-1f40a8f46ccb-6ed3225" name="Immobile" hidden="false" page="0"><description>A Drop Pod cannot move once it has entered the battle, and counts in all respects as a vehicle that has suffered an Immobilised damage result (which cannot be repaired)</description></rule><rule id="d95457e2-108f-8784-a603-05fbee9b0658-6ed3225" name="Drop Pod Assault" hidden="false" page="0"><description>At the beginning of your first turn, half rounding up of your drop pods come in via Deep Strike</description></rule><rule id="78d1f889-ac80-29a0-be3c-e8a2b1c43989-6ed3225" name="Internal Guidance System" hidden="false" page="0"><description>Reduce the ammount of scatter by the minimum required to prevent landing on terrain or another model. If the Drop Pod scatters off the table roll on the Deep Strike Mishap table.</description></rule></rules><selectionEntries><selectionEntry id="7fc7a4a3-0674-5fc0-59d4-be4eb436318b-6ed3225" name="Locator Beacon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7fc7a4a3-0674-5fc0-59d4-be4eb436318b-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="937c8e5e-aa31-75ce-10a6-41f7b72959dc-6ed3225" name="Locator Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendlies do not scatter when deep striking within 6"</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="9e3ef647-5f7b-f0db-d7ce-82caf6f7dda6-6ed3225" name="Weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="267bb8a4-bddf-891c-60c8-c8a162985355-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="9e3ef647-5f7b-f0db-d7ce-82caf6f7dda6-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9e3ef647-5f7b-f0db-d7ce-82caf6f7dda6-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="267bb8a4-bddf-891c-60c8-c8a162985355-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="267bb8a4-bddf-891c-60c8-c8a162985355-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f90daeb5-33b8-06cc-127b-80139a268563-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteri