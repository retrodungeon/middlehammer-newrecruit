acteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-Topped, Transport (10 models or 1 Dreadnought)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile></profiles><rules><rule id="7311ad23-19f0-8064-7df3-1f40a8f46ccb-6ed3225" name="Immobile" hidden="false" page="0"><description>A Drop Pod cannot move once it has entered the battle, and counts in all respects as a vehicle that has suffered an Immobilised damage result (which cannot be repaired)</description></rule><rule id="d95457e2-108f-8784-a603-05fbee9b0658-6ed3225" name="Drop Pod Assault" hidden="false" page="0"><description>At the beginning of your first turn, half rounding up of your drop pods come in via Deep Strike</description></rule><rule id="78d1f889-ac80-29a0-be3c-e8a2b1c43989-6ed3225" name="Internal Guidance System" hidden="false" page="0"><description>Reduce the ammount of scatter by the minimum required to prevent landing on terrain or another model. If the Drop Pod scatters off the table roll on the Deep Strike Mishap table.</description></rule></rules><selectionEntries><selectionEntry id="7fc7a4a3-0674-5fc0-59d4-be4eb436318b-6ed3225" name="Locator Beacon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7fc7a4a3-0674-5fc0-59d4-be4eb436318b-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="937c8e5e-aa31-75ce-10a6-41f7b72959dc-6ed3225" name="Locator Beacon" hidden="false" typeId="mh6-57617267656172204974