208e-799d-95707d6d534b-6ed3225" name="Ravenwing Grenade Launcher (Krak)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="5cfccf08-6d5b-5d3c-de7a-e26a980e02d1-6ed3225" name="Ravenwing Grenade Launcher (Frag)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="61b72995-fc6b-12cc-9c67-5843c2e744df-6ed3225" name="Grim Resolve" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="61b72995-fc6b-12cc-9c67-5843c2e744df-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="61b72995-fc6b-12cc-9c67-5843c2e744df-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="bf44437c-e70e-8585-edd6-7feb34b15925-6ed3225" name="Grim Resolve" hidden="false" page="28"><description>A model with this rule has Stubborn. In addition they may never choose to fail a morale check.</description></rule><rule id="d841dada-69c3-30a1-88e1-71600d39e308-6ed3225" name="Stubborn" hidden="false" page="43"><description>Ignore all negative Ld modifiers, if the unit has Fearless as well ignore this rule.</description></rule></rules></selectionEntry><selectionEntry id="c455ed56-9f1f-44ff-f506-c5a0a33a91a3-6ed3225" name="Power Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c455ed56-9f1f-44ff-f506-c5a0a33a91a3-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c455ed56-9f1f-44ff-f506-c5a0a33a91a3-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ade4f98b-3207-1fdc-b00f-5c8722d7b830-6ed3225" name="Power Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Standard Space Marine Power Armour.  Confers a 3+ Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="07a1a783-ce33-8863-3194-23dcf14b151c-6ed3225" name="Frag and Krak Grenades" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="07a1a783-ce33-8863-3194-23dcf14b151c-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="07a1a783-ce33-8863-3194-23dcf14b151c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="08f6fba3-b6dd-69f9-76b2-34a7dce32b0b-6ed3225" name="Frag Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Don't suffer Initive penalty for charging through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="34ef81c2-a6a9-b438-bc80-54681eac1d66-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5087dc87-19d2-df9a-81e1-be74375d6991-6ed3225" name="Bolt Pistol" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5087dc87-19d2-df9a-81e1-be74375d6991-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5087dc87-19d2-df9a-81e1-be74375d6991-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e22a979a-afed-c5da-f0b1-61d078fffba5-6ed3225" name="Bolt Pistol" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Pistol</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="06fdf5f0-8cdb-76e2-20be-4d110452ffca-6ed3225" name="Banner" hidden="false" collective="true" import="true"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="06fdf5f0-8cdb-76e2-20be-4d110452ffca-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="05012162-6890-e137-6673-3564b5d7e3b0-6ed3225" name="Revered Standard" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="05012162-6890-e137-6673-3564b5d7e3b0-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d6dc2808-112e-6655-6dd6-b43217cfa634-6ed3225" name="Revered Standard" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinning tests, and all friendly Dark Angels within 6" have Crusader USR</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f0b58ea0-1e5e-71bc-988e-7b6fe64748b2-6ed3225" name="Ravenwing Company Banner" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f0b58ea0-1e5e-71bc-988e-7b6fe64748b2-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f0b58ea0-1e5e-71bc-988e-7b6fe64748b2-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="dc036d1e-09ae-2b6f-fed8-2e15f9a0797a-6ed3225" name="Ravenwing Company Banner" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Ravenwing units within 12" automatically pass their Hit &amp; Run checks and roll 4D6 instead of 3D6 for distance.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="6b75dda1-e4f8-7b89-7a76-b184a7aa9279-6ed3225" name="Sacred Standards" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6b75dda1-e4f8-7b89-7a76-b184a7aa9279-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="6b75dda1-e4f8-7b89-7a76-b184a7aa9279-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="6df3ec37-2ba4-af76-3d82-fdf9b07f2972-6ed3225" name="Retribution" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6df3ec37-2ba4-af76-3d82-fdf9b07f2972-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5e618ab1-dca3-86f0-26f6-6cd83ef1663b-6ed3225" name="Standard of Retribution" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinning tests and have the Counter-Attack special rule.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="703228bc-e5fb-7c22-0544-22fe32f6ad20-6ed3225" name="Devastation" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="65" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="703228bc-e5fb-7c22-0544-22fe32f6ad20-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5faa01b1-6268-80f0-5a62-61055f9e47a8-6ed3225" name="Standard of Devastation" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinnning tests and all models within 6" treat their bolters as Salvo 2/4 instead of rapid fire.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="682e1b8a-d0d4-58ec-8dce-1bf4e08dcc13-6ed3225" name="Fortitude" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="85" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="682e1b8a-d0d4-58ec-8dce-1bf4e08dcc13-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3f69d4a7-e43e-70cb-d04f-9a58482608ae-6ed3225" name="Standard of Fortitude" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angles within 12" re-roll failed morale and pinning tests and have Feel no Pain (5+)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="3eaeaf88-c265-125e-a0fa-c16174d3a4ae-6ed3225" name="Ravenwing Darkshroud" hidden="false" collective="false" import="true" type="model"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="Fast Attack" hidden="false" id="3eaeaf88-c265-125e-a0fa-c16174d3a4ae-slot-6ed3225" targetId="74fe-37c3-fbbf-849e" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="80" /></costs><profiles><profile id="cf55a00b-ee15-e275-22e2-51d29ba95c5c-6ed3225" name="Darkshroud" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">10</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">10</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">10</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Fast, Skimmer</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">2</characteristic></characteristics></profile></profiles><rules><rule id="6224783c-9d59-0d04-009a-4fca09fb5435-6ed3225" name="Deep Strike" hidden="false" page="36"><description>Read the BRB, it's too complicated to explain in a small space.</description></rule><rule id="4be30665-d47e-d357-6852-db69ea433177-6ed3225" name="Icon of Old Caliban" hidden="false" page="0"><description>Friendly Dark Angels within 12" add 1 to their combat resolution</description></rule><rule id="6c69b8ff-b7ce-e6eb-5918-da28f4a98b80-6ed3225" name="Shroud of Angels" hidden="false" page="0"><description>The Darkshroud has Shrouded Special Rule and all friendlies within 6" have stealth</description></rule><rule id="1ac22326-57ab-5120-eee2-975dfd455972-6ed3225" name="Scouts" hidden="false" page="41"><description>After all deployment but before first turn a unit with this rule may redeploy, if it is Infantry, Artillery, Walker or a Monstrous Creature it may redeploy anywhere within 6", all other unit types may redelpoy anywhere within 12".
Any unit that redelpoys with this rule may not charge on the first turn.
If held in reserve, the unit gains outflank.</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="6588738c-459d-6db6-4be8-a3d6abdc67eb-6ed3225" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6588738c-459d-6db6-4be8-a3d6abdc67eb-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6588738c-459d-6db6-4be8-a3d6abdc67eb-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5b9ed1bf-3688-f31c-049d-0aed6d103ac9-6ed3225" name="Heavy Bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5b9ed1bf-3688-f31c-049d-0aed6d103ac9-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="44472df9-b613-c5f0-a55a-d4f6558e3659-6ed3225" name="Heavy Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 3</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5e565c04-f65a-8603-9cab-f23198ec7e64-6ed3225" name="Assault Cannon" hidden="false" collective="false" import="true" type="upgrade"><costs