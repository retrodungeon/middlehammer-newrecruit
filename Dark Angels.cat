    <selectionEntry id="c76a-8279-12c9-4488-bf89a" name="Battle Demi Company" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="b5c8-1d90-6a25-4124-bf89a" name="Supreme Fire Discipline" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Unless jinking, all units in this formation with the Grim Resolve Special Rule fire Overwatch at full BS when part of a Lion's Blade.</description>
        </rule>
        <rule id="723a-d8f2-75f0-f267-bf89a" name="Company Support" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If The Lion's Blade includes 2 Demi Battle companys, whereas one includes a Company Master and the other a Chaplain, all Rhinos, Razorbacks and Drop Pods for units in a Demi Battle Company are free. Cost for upgrades still has to be paid.</description>
        </rule>
        <rule id="ab79-2b13-df46-e334-bf89a" name="Fire Discipline" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Models in this formation with the Grim Resolve SR fire overwatch at BS3.</description>
        </rule>
