  <selectionEntry id="fea8a00b-565f-c79e-1619-656b8a98e675-6ed3225" name="Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fea8a00b-565f-c79e-1619-656b8a98e675-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b2776cb2-0722-2338-21e7-800825600ef3-6ed3225" name="Drop Pod" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-Topped, Transport (10 models or 1 Dreadnought)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile></profiles><rules><rule id="15a9f252-1821-807c-6ef3-63e7fbaef655-6ed3225" name="Immobile" hidden="false" page="0"><description>A Drop Pod cannot move once it has entered the battle, and counts in all respects as a vehicle that has suffered an Immobilised damage result (which cannot be repaired)</description></rule><rule id="296cd1a8-88da-2d7c-41b7-540e4cd79c91-6ed3225" name="Drop Pod Assault" hidden="false" page="0"><description>At the beginning of your first turn, half rounding up of your drop pods come in via Deep Strike</description></rule><rule id="a4e138dd-c387-7cd3-e7ca-eab73530629e-6ed3225" name="Internal Guidance System" hidden="false" page="0"><description>Reduce the ammount of scatter by the minimum required to prevent landing on terrain or another model. If the Drop Pod scatters off the table roll on the Deep Strike Mishap table.</description></rule></rules><selectionEntries><selectionEntry id="58eeb97d-f6b1-bc5a-8c27-9907458a5b84-6ed3225" name="Locator Beacon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="58eeb97d-f6b1-bc5a-8c27-9907458a5b84-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="31d5f958-6143-d1f0-cd43-8754b1144e53-6ed3225" name="Locator Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendlies do not scatter when deep striking within 6"</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="0253b425-d4d3-4677-59e9-e4bf2124479f-6ed3225" name="Weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="a8a7c16f-47fb-a536-fc42-81373b90fcff-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0253b425-d4d3-4677-59e9-e4bf2124479f-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0253b425-d4d3-4677-59e9-e4bf2124479f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a8a7c16f-47fb-a536-fc42-81373b90fcff-6ed3225" name="Storm Bolter" hidden="false" collectiv