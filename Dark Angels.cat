        <selectionEntryGroup id="mh-rad-dark-angels-3ff7-c378-993d-3ca4" name="Replace all six Hellstrike Missiles with:" hidden="false" collective="false" import="true" defaultSelectionEntryId="mh-rad-dark-angels-0ecd-0df9-359c-bce5">
          <selectionEntries>
            <selectionEntry id="mh-rad-dark-angels-8abf-30bb-5d38-1e04" name="Six Cluster Bombs" page="0" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-dark-angels-213e-1e88-0640-ae8c" type="max" />
              </constraints>
              <profiles>
                <profile id="mh-rad-dark-angels-20d1-2efc-01ec-cdcb" name="Heavy Bomb" publicationId="ca571888--pubN80998" page="73" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
                  <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">Bomb</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 1, Apocalyptic Barrage (6), One Use</characteristic></characteristics></profile>
              </profiles>
              <rules>
                <rule id="mh-rad-dark-angels-59fa-8449-34d4-0fe0" name="Bombing Run" page="" hidden="false">
                  <description>You can elect to have the Thunderhawk drop one Heavy Bomb Cluster per bombing run. The Thunderhawk has enough
bombs to do this three times over the course of a game</description>
                </rule>
              </rules>
