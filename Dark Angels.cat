    <selectionEntry id="mh-rad-dark-angels-24b2-3331-008d-2bd8" name="Achilles-Alpha Pattern Land Raider (Heresy)" publicationId="ca571888--pubN80998" page="55" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="mh-rad-dark-angels-94d2-c021-2e07-133a" name="Achilles-Alpha Pattern Land Raider" publicationId="ca571888--pubN80998" page="55" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle">
          <characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">14</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">14</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">14</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Tank, Transport</characteristic></characteristics></profile>
        <profile id="mh-rad-dark-angels-ff5a-79dd-62ff-4dfd" name="Achilles-Alpha Pattern Land Raider (Transport)" publicationId="ca571888--pubN80998" page="67" hidden="false" typeId="307d-047f-ca13-706b" typeName="Transport">
          <characteristics><characteristic name="Capacity" typeId="8285-4205-b6cd-8473">6</characteristic><characteristic name="Fire Points" typeId="b270-a7f9-22b2-3702">None</characteristic><characteristic name="Access Points" typeId="d17b-0342-b1dc-b8e7">One access hatch on each side of the hull.</characteristic></characteristics></profile>
        <profile id="mh-rad-dark-angels-7ef6-2d10-39a3-a6e4" name="Enhanced Ferromantic Rites" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Land Raider Achilles-Alpha is not subject to the effects of the Melta and Lance special rules by attacks made against it.  In addition it reduces the effects of all rolls on the damage chart by -1 (except Destroyer hits).</characteristic></characteristics></profile>
        <profile id="mh-rad-dark-angels-8552-49ad-ca3e-9d57" name="Galvanic Traction Drive" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
          <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Must re-roll failed Dangerous Terrain tests.</characteristic></characteristics></profile>
      </profiles>
      <infoLinks>
