cs><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Grants the Adamantium Will and Fear rules</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile><profile id="c9f4a0ee-a619-5d04-4718-5b9f11ef731e-6ed3225" name="Plasma Cannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Blast, Gets Hot</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">57</characteristic></characteristics></profile><profile id="d1102aeb-7e61-6277-b82b-d1201d008faa-6ed3225" name="Plasma Gun" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Gets Hot</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">57</characteristic></characteristics></profile><profile id="5512b587-eb4b-834c-ef00-ec97b749ee91-6ed3225" name="Plasma Pistol" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Pistol</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">57</characteristic></characteristics></profile><profile id="bcdb9960-ecbf-2a99-d03c-f1208a48d87a-6ed3225" name="Plasma Talon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">18"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Gets Hot, Twin Linked</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="bbd39632-83ce-3852-d0c9-b3cf462a85fe-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile><profile id="7378e53b-4daf-2474-c71e-cae7dcf7da90-6ed3225" name="Power Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Standard Space Marine Power Armour.  Confers a 3+ Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="e0fa4048-05e7-2a3e-8e36-0fbd0172d760-6ed3225" name="Power Axe" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Unwieldy</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="50dced6e-e52f-b8ba-8a81-c6270e42b492-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++.  If the bearer is embarked upon a Transport vehicle, the power field’s effects only apply to models embarked upon that vehicle.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile><profile id="2b710a71-7efd-6039-ac46-d382f649ae75-6ed3225" name="Power Fist" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="60"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Specialist Weapon, Unwieldly</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">60</characteristic></characteristics></profile><profile id="5ed90215-c179-9088-644e-82a18e57ba63-6ed3225" name="Power Lance" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1 (Charge) / User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3 (Charge) / 4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="e8001e9e-b963-7adf-9986-c6d352912100-6ed3225" name="Power Maul" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="c2240ed0-58f9-b7aa-bc54-a6107c4cf942-6ed3225" name="Power Sword" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="0641f77a-0902-3d1e-a25b-bc21828bc8ce-6ed3225" name="Psychic Hood" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="68"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Each Time a unit (or model) is targeted by an enemy psychic power and is within 6" of a frieldly model with a psychic hood, the wearer may attempt to deny the witch as if he were in the unit.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">68</characteristic></characteristics></profile><profile id="fb623a87-d501-5f91-0b94-1fcef620228c-6ed3225" name="Ravenwing Attack Bike" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">8</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="18cf5c89-4385-d490-f1da-3319ea745c83-6ed3225" name="Ravenwing Biker" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e697420547970652323234441544123