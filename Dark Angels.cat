stics></profile><profile id="f7b37eab-477c-b5c3-09a8-adc6ef910f83-6ed3225" name="Smoke Launchers" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Once per game, instead of shooting or moving flat out, may gain a 5+ cover save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="d92e573f-fefe-c317-9552-e4328767075f-6ed3225" name="Turret Weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="9a315f4f-c067-79bf-e2d8-25699fa3dd9c-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d92e573f-fefe-c317-9552-e4328767075f-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d92e573f-fefe-c317-9552-e4328767075f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="9a315f4f-c067-79bf-e2d8-25699fa3dd9c-6ed3225" name="Autocannon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9a315f4f-c067-79bf-e2d8-25699fa3dd9c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="605dff22-f8e6-2b9f-04b3-fddeb99bbab1-6ed3225" name="Autocannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">48"</characteristic><char