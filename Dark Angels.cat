      <infoLinks />
      <modifiers />
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Model can either move 12" during the Movement phase, or gain the Hammer of Wrath special rule in the Assault phase. (not both)</characteristic>
      </characteristics>
    </profile>
