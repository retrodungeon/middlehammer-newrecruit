          </constraints>
          <selectionEntries />
          <selectionEntryGroups />
          <entryLinks />
          <costs>
            <cost name="Points" value="0.0" typeId="6f18-a8fc-2c5b-9517" />
          </costs>
        </selectionEntry>
        <selectionEntry id="3c5a-f52a-432b-dd9c-bf89a" name="Blessed Autosimulacra" page="0" hidden="false" collective="false" type="upgrade">
          <profiles>
            <profile id="bc37-4656-47c4-b811-bf89a" name="Blessed Autosimulacra" page="0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
              <profiles />
              <rules />
              <infoLinks />
              <modifiers />
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a vehicle has suffered Hull Point damage at the end of the controlling player's turn, roll a D6. On a 6, one lost Hull Point is restored.</characteristic>
