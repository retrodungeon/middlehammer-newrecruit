aracteristics></profile></profiles></selectionEntry><selectionEntry id="68beddb8-f857-8881-5272-252ebaa2fb28-6ed3225" name="Two Flamestorm Cannon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="68beddb8-f857-8881-5272-252ebaa2fb28-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="68beddb8-f857-8881-5272-252ebaa2fb28-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="0eedd80e-fec6-8d5b-1c6a-84564330ac2b-6ed3225" name="Flamestorm Cannon" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Template</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="c13a7edd-48b5-9e1e-0d84-d59fc3c05003-6ed3225" name="Deathwing Vehicle" hidden="false" collective="false" import="true" type="upgrade" page="40"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c13a7edd-48b5-9e1e-0d84-d59fc3c05003-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c13a7edd-48b5-9e1e-0d84-d59fc3c05003-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="bd478b1a-8bd6-7995-39cf-23a5bff5315e-6ed3225" name="Preferred Enemy (Chaos Space Marines)" hidden="false" page="40"><description>Reroll all failed to hit and to wound rolls of 1 against the chosen enemy in both shooting and assault.</description></rule><rule id="56649de0-8cb9-141c-f6f8-925292a384cc-6ed3225" name="Deathwing Vehicle" hidden="false" page="0"><description>Preferred Enemy (Chaos Space Marines), you may make your opponent re-roll any vehicle damage result</description></rule></rules></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="dc487a29-4150-244a-4ba6-06e1a6fa5538-6ed3225" name="Vehicle Options" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="8931b17c-46b2-b046-c6cd-ffcb2b84b073-6ed3225" name="Dozer Blade" hidden="false" collective="false" import="true" type="upgrade" page="87"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8931b17c-46b2-b046-c6cd-ffcb2b84b073-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d9df6615-9b29-2a67-7947-7c6582ed728f-6ed3225" name="Dozer Blade" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">re-roll failed dangerous terrain tests</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e4aa0bed-2759-16be-8bb8-dd0e5cab0869-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2