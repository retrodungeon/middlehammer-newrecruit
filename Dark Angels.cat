    <profile id="mh-rad-dark-angels-d2b5-89d1-10e2-f3f0" name="Charnabal Sabre" publicationId="ca571888--pubN106502" page="181" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
