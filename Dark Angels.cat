true" id="3a82532a-713d-7021-cab2-35ba2099d98c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="43e6d0cb-c1e4-9837-1697-ce3daa42cab0-6ed3225" name="Multi Melta" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Melta</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="cb2889bf-46aa-e674-b0c4-028d76f3980e-6ed3225" name="Smoke Launchers and Searchlight" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="cb2889bf-46aa-e674-b0c4-028d76f3980e-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cb2889bf-46aa-e674-b0c4-028d76f3980e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3c90223c-ca3d-dca7-35a7-2c1226695105-6ed3225" name="Searchlight" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After firing all weapons can illuninate the unit it shot at and it's self during night fighting</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile><profile id="b0338906-30f6-0ec6-5d0f-1d0f585a8bfe-6ed3225" name="Smoke Launchers" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Once per game, instead of shooting or moving flat out, may gain a 5+ cover save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8a4420a5-75e5-0bdf-ffa5-0d9d4fbe338c-6ed3225" name="Frag Assault Launcher" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8a4420a5-75e5-0bdf-ffa5-0d9d4fbe338c-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8a4420a5-75e5-0bdf-ffa5-0d9d4fbe338c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="fa6e7326-0787-141d-74f6-e0b1c921aeb6-6ed3225" name="Frag Assault Launcher" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Any unit charging in to combat in the same turn as disembarking from this vehicle counts as having frag grenades</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="490ca752-1201-99cf-bd37-4ad256e83b2e-6ed3225" name="Twin Linked Assault Cannon" hidden="false" collective="false" import="true" type="upgrade"><costs><co