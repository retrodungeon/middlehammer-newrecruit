acteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="83ac9466-da9e-2c11-2d75-f08e913a9152-6ed3225" name="Shroud of Heroes" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="83ac9466-da9e-2c11-2d75-f08e913a9152-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="83ac9466-da9e-2c11-2d75-f08e913a9152-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="79b5814d-83e4-32e6-2c6c-124b83741fa5-6ed3225" name="Shroud of Heroes" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="67"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Grants Feel No Pain (5+), in addition as long as the wearer is not in a unit he has Shrouded</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="723f6f92-580b-cc4a-9c12-a2d87c7fa77a-6ed3225" name="Terminator Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="723f6f92-580b-cc4a-9c12-a2d87c7fa77a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f50b0f34-29b1-7064-f54b-f0a5d158a509-6ed3225" name="Terminator Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+/5++, have the Bulky, Deep Strike, Relentless, Deathwing Assault and Vengeful Strike special rules, and may not make sweeping advances.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile><profile id="fdcb6a24-1046-8a3f-b37b-180e54afc2aa-6ed3225" name="Librarian" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="31"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">2</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">4</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">2</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+ / 5++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">31</characteristic></characteristics></profile></profiles><rules><rule id="44c89514-2e46-88ed-04d1-36d0331161ac-6ed3225" name="Vengeful Strike" hidden="false" page="44"><description>When a model with this rule arrives from Deep Strike, it treats all ranged weapons as having Twin Linked until end of turn.</description></rule><rule id="2cd91917-71a8-90fe-35d6-72d1be13a018-6ed3225" name="Deathwing Assault" hidden="false" page="44"><description>Units composed entirely composed of models with this rule and wearing Terminator Armour can choose to make a Deathwing Assault.
Immediatly after determining Warlord Traits, tell your opponent which units are making a Deathwing Assault, and make a secret note on weather it happens during turn 1 or turn 2. All units chosen arrive then with no need to roll for deep strike reserves.</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="74369aad-ae31-ab01-3b41-5e99a6a59fcb-6ed3225" name="Terminator Weapons" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup id="0bd86184-e1b5-89c0-687a-e474f4ec6093-6ed3225" name="Left Hand" hidden="false" collective="false" import="true" defaultSelectionEntryId="a3758137-d43b-3050-71fb-d0aab5e4ce13-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0bd86184-e1b5-89c0-687a-e474f4ec6093-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0bd86184-e1b5-89c0-687a-e474f4ec6093-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a3758137-d43b-3050-71fb-d0aab5e4ce13-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a3758137-d43b-3050-71fb-d0aab5e4ce13-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d66a931b-63d3-b451-a2e3-dfd61345c774-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c78da463-95e4-989d-e160-aaca761595db-6ed3225" name="Combi-Plasma" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c78da463-95e4-989d-e160-aaca761595db-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="14cc923f-d73a-2e18-8572-ee4fcd16bbb9-6ed3225" name="Combi Plasma" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter)/ 7 (Plasma)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter)/ 2 (Plasma)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Both) / Gets Hot, One Shot (Plasma)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">57</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="82c7b737-c168-0ab7-d1e3-a82c5aef3a97-6ed3225" name="Combi-flamer" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="82c7b737-c168-0ab7-d1e3-a82c5aef3a97-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3e95d6be-945d-2b69-b0da-79a3fa47ab89-6ed3225" name="Combi-Flamer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24" (Bolter)/ Template (Flamer)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Bolter)/ Assault 1, One Shot (Flamer)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="96ccaf99-4384-efca-1540-57958bcbb9da-6ed3225" name="Combi-Melta" hidden="false" collective="false" import="true" type="upgrade" page="57"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="96ccaf99-4384-efca-1540-57958bcbb9da-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f9f94b00-e8d7-e080-685b-852f98aec281-6ed3225" name="Combi-Melta" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24" (Bolter)/ 12" (Melta)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter)/ 8 (Melta)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter) / 1 (Melta)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Bolter) / Assault 1, Melta, One Shot (Melta)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56/57</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e678ebac-f0ef-45d3-9bd7-cc7f0d00be7e-6ed3225" name="Special Issue Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="5beec7ff-dddd-1427-46d7-7fc96d410605-6ed3225" name="Auspex" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5beec7ff-dddd-1427-46d7-7fc96d410605-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="cb309068-ccd1-5357-207d-7df0b04c8c24-6ed3225" name="Auspex" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Forego shooting to make an enemy unit within 12" reduce it's cover save by 1, untill the end of the phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b1d4a666-2caf-8007-c731-77feb151f141-6ed3225" name="Combat Shield" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b1d4a666-2caf-8007-c731-77feb151f141-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="56e92526-6f40-3d13-e9e2-cd6432e528cc-6ed3225" name="Combat Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">6++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d39fc011-ef9b-eecb-6783-8b0b68173b43-6ed3225" name="Infravisor" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d39fc011-ef9b-eecb-6783-8b0b68173b43-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3c41dfbc-30b5-ba40-0377-b948d820acec-6ed3225" name="Infravisor" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Has night vision, but sounts as Initive 1 for blind tests</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="77b94c6c-151b-2e61-b1bc-26583d4923c0-6ed3225" name="Melta Bombs" hidden="false" collective="false" import="true" type="upgrade" page="62"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="77b94c6c-151b-2e61-b1bc-26583d4923c0-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7f5f044e-5ef6-1e7e-523c-7990cabc1e65-6ed3225" name="Melta Bombs" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d6ac9a7b-2b34-e9db-e55f-2e21ebe808d4-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d6ac9a7b-2b34-e9db-e55f-2e21ebe808d4-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2a8f3ce1-ed90-38f6-4b3a-f40d568eb2bd-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a3a0ac02-b946-6da8-94cb-9065f446195c-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a3a0ac02-b946-6da8-94cb-9065f446195c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="152916d0-98ca-539d-40b8-af2ee1299213-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8912b898-9e5b-6deb-8b51-583ee306a9fa-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8912b898-9e5b-6deb-8b51-583ee306a9fa-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c7b8292c-3620-0598-b141-2621bc952da4-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b4da9b97-aef8-01fb-e709-a49bc429bfb5-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b4da9b97-aef8-01fb-e709-a49bc429bfb5-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c868a6f7-2d46-cbc5-435b-a1592f007cfd-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3e686ff7-0d77-4806-916c-255b9d17a345-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3e686ff7-0d77-4806-916c-255b9d17a345-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="dab4604e-54a5-9a72-5919-f6744a79b4d3-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="4d930ed2-7359-512e-07d6-0d241312b291-6ed3225" name="Righ