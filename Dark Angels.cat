      <rules>
        <rule id="7904-7f9d-86af-4081-bf89a" name="Transport Capacity - 10" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        </rule>
        <rule id="6621-5ff0-54b9-c2f5-bf89a" name="Supersonic" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        <description>A vehicle with the Supersonic rule that moves flat out may move up to 36".</description></rule>
        <rule id="9392-d111-167b-cf10-bf89a" name="Misericorde" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        <description>Can transport 10 models with Power, Artificer or Terminator-armour and ignores the rules for Bulky.</description></rule>
        <rule id="f570-7ccf-c0ee-dde6-bf89a" name="Caestus Ram" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        <description>When conducting a ram attack, the player rolls 2D6 and picks the highest number when determining if it has penetraded the target's armour and adds +1 to any rolls on the damage chart. Also confers a 5++ against attacks made to the front armour, including damage from a ram.</description></rule>
      </rules>
