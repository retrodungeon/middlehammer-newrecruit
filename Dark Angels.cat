    <selectionEntry id="mh-rad-dark-angels-bba4-7c3f-7979-9204" name="Forward Deployment Protocol" publicationId="690c-3e82-3080-6bc0" page="162" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="force" value="3.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="mh-rad-dark-angels-8491-2122-ba29-014d" type="max" />
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-dark-angels-6cc6-671c-f337-a63d" type="max" />
      </constraints>
      <rules>
        <rule id="mh-rad-dark-angels-4c48-b6fd-039d-441b" name="Forward Deployment Protocol" publicationId="690c-3e82-3080-6bc0" page="162" hidden="false">
          <description>If deployed no more than 17 inches from a Priority Target unit, gain the Rage special rule until the end of the second game turn.</description>
        </rule>
