      <rules>
        <rule id="40bf-85e6-6f6a-f5f6-bf89a" name="Supreme Strategist" page="139" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>When determining Warlord Traits for Azrael, choose any trait from the Dark Angels Warlord Traits table.</description>
        </rule>
        <rule id="c9cf-c1f0-1710-a0c5-bf89a" name="Rites of Battle" page="139" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>All friendly models with the Dark Angels Faction can use Azrael's Leadership value in place of their own.</description>
        </rule>
        <rule id="7c7a-2250-66c4-00f2-bf89a" name="Master Tactician" page="139" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Add 1 to your Seize the Initiative-roll.</description>
        </rule>
      </rules>
