-ec29-3ed8450886ea-6ed3225" name="Ravenwing Company Banner" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Ravenwing units within 12" automatically pass their Hit &amp; Run checks and roll 4D6 instead of 3D6 for distance.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile><profile id="e6a2617b-0c8a-bf61-4667-135d52f65185-6ed3225" name="Ravenwing Grenade Launcher (Frag)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="9dfc6638-b34b-ea22-61e1-6d1f6b07cf46-6ed3225" name="Ravenwing Grenade Launcher (Krak)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="1527d1cd-5694-e1d0-3445-70b971965212-6ed3225" name="Ravenwing Grenade Launcher (Rad)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Every model hit suffers -1 to Toughness</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="7afb28a0-2411-0d63-1c71-2e8103b112aa-6ed3225" name="Ravenwing Grenade Launcher (Stasis)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">-</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Every model hit suffers -1 to Weapon Skill and Initiative</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="86e9a32a-96b9-cc34-56b6-dbde1453456a-6ed3225" name="Ravenwing Veteran Sgt" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Bike (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">5</characteristic><characteristic name="W" typeId="mh6-57