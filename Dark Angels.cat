teristics></profile></profiles><rules><rule id="3b3a4069-cf2b-68e4-d289-681a017af6f5-6ed3225" name="Assault Vehicle" hidden="false" page="0"><description>Passengers may assault the same turn they disembark</description></rule><rule id="82279ecd-e78f-b993-06a3-51049dd892fa-6ed3225" name="Power of the Machine Spirit" hidden="false" page="0"><description>So long as the vehicle dosen't move flat out or pop smoke, it may fire an additional weapon than normal and may fire at a different target.</description></rule></rules><selectionEntries><selectionEntry id="10d45ff3-5855-dfd9-b3bc-4252f07f0da4-6ed3225" name="Multi Melta" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="10d45ff3-5855-dfd9-b3bc-4252f07f0da4-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="05b1552d-54b3-315c-fe4f-1208714b6686-6ed3225" name="Multi Melta" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Melta</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="b271c17f-5127-8d26-520f-08047499f0e6-6ed3225" name="Smoke Launchers and Searchlight" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b271c17f-5127-8d26-520f-08047499f0e6-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b271c17f-5127-8d26-520f-08047499f0e6-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8fa792dc-b20a-af28-076d-7607104c3ec4-6ed3225" name="Searchlight" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After firing all weapons can illuninate the unit it shot at and it's self during night fighting</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile><profile id="7b04a77a-bfaf-5b89-f9b0-e80f9e09a6d8-6ed3225" name="Smoke Launchers" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Once per game, instead of shooting or moving flat out, may gain a 5+ cover save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d27b60e1-f106-0d5a-5079-5688e6539673-6ed3225" name="Frag Assault Launcher" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d27b60e1-f106-0d5a-5079-5688e6539673-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d27b60e1-f106-0d5a-5079-5688e653967