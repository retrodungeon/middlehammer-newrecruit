ed3225" name="Melta Bombs" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="aabadfe9-6c94-00ad-f226-bdc317ce519a-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="aabadfe9-6c94-00ad-f226-bdc317ce519a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6f6e4b1a-2e0e-3304-0b4a-917ad23fed82-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ee907432-1d20-1b57-d9ea-18c7712c7e75-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ee907432-1d20-1b57-d9ea-18c7712c7e75-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b8daf801-c283-f062-665e-eaa632185d16-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c36a9554-8301-b9b8-81dd-9386b519f8db-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c36a9554-8301-b9b8-81dd-9386b519f8db-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="49679f3b-51ef-5297-f76a-cecf178f04d2-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a10c5c29-b92b-50a5-50a4-199c968c02bb-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a10c5c29-b92b-50a5-50a4-199c968c02bb-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="849706fa-36aa-c8af-2cd2-731b971f3c85-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8e12a99f-14ca-78ba-ee29-bd880b8f101c-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8e12a99f-14ca-78ba-ee29-bd880b8f101c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="18bc81ad-1f25-4837-839f-ecf1a7b4c723-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="318349ca-566d-3032-f1eb-1796045b3826-6ed3225" name="Unit Type" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="318349ca-566d-3032-f1eb-1796045b3826-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="318349ca-566d-3032-f1eb-1796045b3826-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5e77fadd-03a6-71d8-dc5f-23a1dacff74e-6ed3225" name="Jump Infantry" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5e77fadd-03a6-71d8-dc5f-23a1dacff74e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f5529f0e-b90d-07e5-0b87-93db897895d6-6ed3225" name="Jump Pack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Follows the rules for Jump Infantry in the BRB page 47</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="59559af6-4708-7c11-83a9-b9ee96d931b9-6ed3225" name="Interrogator-Chaplain" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="30"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Jump Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">3+ / 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">30</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="290817d9-d1bd-d4cf-5a51-80685ede9998-6ed3225" name="Infantry" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="290817d9-d1bd-d4cf-5a51-80685ede9998-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="71c9e186-b0fa-2b0d-8029-a7d40a3f013f-6ed3225" name="Interrogator-Chaplain" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="30"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><charact