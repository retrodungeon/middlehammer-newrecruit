me="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Don't suffer Initive penalty for charging through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="94f5f7dc-008e-09f2-65bc-56c1426b4961-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cee62892-b2c1-29fd-0ca8-3f95163c42d2-6ed3225" name="Power Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="cee62892-b2c1-29fd-0ca8-3f95163c42d2-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cee62892-b2c1-29fd-0ca8-3f95163c42d2-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f9f0ce88-5870-e710-522a-d3b69fdfb46f-6ed3225" name="Power Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Standard Space Marine Power Armour.  Confers a 3+ Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="2c2e0738-0a74-83fb-0497-55c3036b4c92-6ed3225" name="Grim Resolve" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2c2e0738-0a74-83fb-0497-55c3036b4c92-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2c2e0738-0a74-83fb-0497-55c3036b4c92-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="5ce0e8c1-c00d-7907-347d-e93a06739691-6ed3225" name="Grim Resolve" hidden="false" page="28"><description>A model with this rule has Stubborn. In addition they may never choose to fail a morale check.</description></rule><rule id="1873f564-8d9b-39a8-bcd9-ed38b9eab46f-6ed3225" name="Stubborn" hidden="false" page="43"><description>Ignore all negative Ld modifiers, if the unit has Fearless as well ignore this rule.</description></rule></rules></selectionEntry><selectionEntry id="117ca857-7195-966f-879b-05eee0e83eee-6ed3225" name="Apothecary" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="117ca857-7195-966f-879b-05eee0e83eee-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="9be14cac-9aa3-57d1-20bf-5e5b9b1e849d-6ed3225" name="Narthecium" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Descriptio