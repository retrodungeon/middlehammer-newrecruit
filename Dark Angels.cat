aracteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="3c9755ab-37a1-4c06-68ec-4d38b0f6c967-6ed3225" name="Deathwing Terminator Squad" hidden="false" collective="false" import="true" type="unit"><categoryLinks><categoryLink name="Elites" hidden="false" id="3c9755ab-37a1-4c06-68ec-4d38b0f6c967-slot-6ed3225" targetId="978c-e18f-8aeb-f4c1" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><modifiers><modifier type="set" field="3c9755ab-37a1-4c06-68ec-4d38b0f6c967-maxInRoster-6ed3225" value="0.0"><conditionGroups><conditionGroup type="or"><conditions><condition type="equalTo" value="1" field="selections" scope="roster" childId="47dbe873-d068-d716-369b-664d7994667f-6ed3225" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="equalTo" value="1" field="selections" scope="roster" childId="ca7afccf-ee37-ccd7-0627-fa8de1534c99-6ed3225" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint type="max" value="-1" field="selections" scope="roster" shared="true" id="3c9755ab-37a1-4c06-68ec-4d38b0f6c967-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="e3716c29-2583-1fb6-bd63-6b6eca850c80-6ed3225" name="Teleport Homer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly Terminators do not scatter when placed within 6", model must have started the turn on the board</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles><rules><rule id="c4cafdd6-b93d-2b8f-44ed-732f28747069-6ed3225" name="Deathwing Assault" hidden="false" page="44"><description>Units composed entirely composed of models with this rule and wearing Terminator Armour can choose to make a Deathwing Assault.
Immediatly after determining Warlord Traits, tell your opponent which units are making a Deathwing Assault, and make a secret note on weather it happens during turn 1 or turn 2. All units chosen arrive then with no need to roll for deep strike reserves.</description></rule><rule id="8895991a-8999-c341-bbcc-b76e2e8e173a-6ed3225" name="Split Fire" hidden="false" page="42"><description>Take A leadership test, if passed each model may fire at a different target than the rest of the unit, if failed all models fire at the same target</description></rule><rule id="8ed98eef-c327-cbba-b198-c7a6ced18928-6ed3225" name="Vengeful Strike" hidden="false" page="44"><description>When a model with this rule arrives from Deep Strike, it treats all ranged weapons as having Twin Linked until end of turn.</description></rule></rules><selectionEntries><selectionEntry id="dbfc2a18-45df-0073-c58e-0610dca90073-6ed3225" name="Deathwing Terminators" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="44" /></costs><constraints><constraint type="min" value="4" field="selections" scope="parent" shared="true" id="dbfc2a18-45df-0073-c58e-0610dca90073-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="9" field="selections" scope="parent" shared="true" id="dbfc2a18-45df-0073-c58e-0610dca90073-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c251463d-7119-a484-f931-f2e0bcb75d54-6ed3225" name="Deathwing Terminator" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">4</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic n