If held in reserve, the unit gains outflank.</description></rule></rules><selectionEntries><selectionEntry id="b119357f-ab51-a3ef-ca49-27a8b6234c02-6ed3225" name="Scouts" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="12" /></costs><constraints><constraint type="min" value="4" field="selections" scope="parent" shared="true" id="b119357f-ab51-a3ef-ca49-27a8b6234c02-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="9" field="selections" scope="parent" shared="true" id="b119357f-ab51-a3ef-ca49-27a8b6234c02-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="d3c81f4d-4ede-6e67-063c-1f965e2a5290-6ed3225" name="Sergeant" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="12" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d3c81f4d-4ede-6e67-063c-1f965e2a5290-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d3c81f4d-4ede-6e67-063c-1f965e2a5290-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d51f8d7b-519a-91ee-8f0f-209a01b9ad12-6ed3225" name="Scout Sergeant" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="0"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="1" field="selections" scope="d3c81f4d-4ede-6e67-063c-1f965e2a5290-6ed3225" childId="9051c785-9c5a-1833-bfbc-03392670f4db-6ed3225" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><characteristics><characteristic name="Unit Type" typeId="m