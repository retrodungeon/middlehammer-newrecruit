ort="true" type="upgrade" page="87"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7df9b783-48c0-70da-4bd8-c2d3c13bf591-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="49027dad-84cc-09bf-fdb5-70f5de97bb71-6ed3225" name="Hunter Killer Missile" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="87"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Unlimited</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, One Shot</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="062486b3-f348-2b9f-75b2-bd287e50e63b-6ed3225" name="Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="062486b3-f348-2b9f-75b2-bd287e50e63b-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b9300e99-1bbd-2722-60ae-393e17b3dc7e-6ed3225" name="Drop Pod" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-Topped, Transport (10 models or 1 Dreadnought)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile></profiles><rules><rule id="0b1a549b-eab8-f145-a762-f87e2b4d7000-6ed3225" name="Immobile" hidden="false" page="0"><description>A Drop Pod cannot move once it has entered the battle, and counts in all respects as a vehicle that has suffered an Immobilised damage result (which cannot be repaired)</description></rule><rule id="700feff6-a38d-d23f-4d21-c448e352a52e-6ed3225" name="Drop Pod Assault" hidden="false" page="0"><description>At the beginning of your first turn, half rounding up of your drop pods come in via Deep Strike</description></rule><rule id="8524e409-599c-fdf4-c10b-68a0d4ae50ff-6ed3225" name="Internal Guidance System" hidden="false" page="0"><description>Reduce the ammount of scatter by the minimum required to prevent landing on terrain or another model. If the Drop Pod scatters off the table roll on the Deep Strike Mishap table.</description></rule></rules><selectionEntries><selectionEntry id="a5773ce7-b88b-60a4-6159-249ca34be0e2-6ed3225" name="Locator Beacon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a5773ce7-b88b-60a4-6159-249ca34be0e2-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2ab67dfb-3e09-d22d-81a7-9ab5678c0d3a-6ed3225" name="Locator Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="