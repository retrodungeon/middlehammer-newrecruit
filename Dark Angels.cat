        <rule id="2e4e-ef30-aa0d-fffe-bf89a" name="Warlord Trait: The Hunt" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
        <description>If this model is chosen as your Warlord, it has the Warlord Trait "The Hunt": +1 Victory point if your Warlord or his unit kill enemy Warlord in the Assault phase.</description></rule>
