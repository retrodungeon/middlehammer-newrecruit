1131-2d3397c9750d-6ed3225" name="Melta Bombs" hidden="false" collective="false" import="true" type="upgrade" page="62"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0b29a2db-4b7e-d5c8-1131-2d3397c9750d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d6fd5a19-c877-3cc7-e55e-3441e9074566-6ed3225" name="Melta Bombs" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="66441360-c009-4ea0-745a-5a2023b8b149-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="66441360-c009-4ea0-745a-5a2023b8b149-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4ecf5e06-ebe2-c80c-a446-6b1e40238b83-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e1618a81-cde0-d7a7-2a53-ee2cf74861d0-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e1618a81-cde0-d7a7-2a53-ee2cf74861d0-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8e0a7c34-84ec-0424-53a9-6710d16cb3e7-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fd464228-07e7-bc42-777b-4e10cfb3d428-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fd464228-07e7-bc42-777b-4e10cfb3d428-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e39759b7-5afa-d1f1-bafa-ae9ae8aa0eb1-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="48612666-cc2e-5815-7f11-b2c67a071cb5-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="48612666-cc2e-5815-7f11-b2c67a071cb5-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="af9cb28c-3c1b-8fee-e989-6a7c367aaa8a-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b19608b6-333a-46ba-3bb1-c9ef5c75aeed-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b19608b6-333a-46ba-3bb1-c9ef5c75aeed-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d05eb3d6-1b24-7398-fe84-9e8715ec2004-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0a9be465-59cf-166c-6e84-b167c98ecb63-6ed3225" name="Terminator Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="40" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0a9be465-59cf-166c-6e84-b167c98ecb63-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a12dead4-100e-d692-ab3a-617c17556c7a-6ed3225" name="Company Master" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="29"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+ / 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">29</characteristic></characteristics></profile></profiles><rules><rule id="38a6f0a9-6a7c-3520-cdf0-2daaf468724f-6ed3225" name="Deathwing Assault" hidden="false" page="44"><description>Units composed entirely composed of models with this rule and wearing Terminator Armour can choose to make a Deathwing Assault.
Immediatly after determining Warlord Traits, tell your opponent which units are making a Deathwing Assault, and make a secret note on weather it happens during turn 1 or turn 2. All units chosen arrive then with no need to roll for deep strike reserves.</description></rule><rule id="b3527968-e79b-763d-1358-d6f9869f3715-6ed3225" name="Vengeful Strike" hidden="false" page="44"><description>When a model with this rule arrives from Deep Strike, it treats all ranged weapons as having Twin Linked until end of turn.</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="2cac8351-be25-a030-25b0-eb9e10819f2a-6ed3225" name="Terminator Weapons" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup id="565be3c0-f5b6-9a82-840a-8ff4e94bcde0-6ed3225" name="Left Hand" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="565be3c0-f5b6-9a82-840a-8ff4e94bcde0-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="565be3c0-f5b6-9a82-840a-8ff4e94bcde0-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="4901745d-79f5-b7f2-773c-3e8b23647a89-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4901745d-79f5-b7f2-773c-3e8b23647a89-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="378674a1-f848-f30a-891a-d1ef5ad986f0-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a13c38b7-040d-ea5a-f2c3-9072fe82c4d3-6ed3225" name="Combi-Plasma" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a13c38b7-040d-ea5a-f2c3-9072fe82c4d3-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bd7705d1-642e-faac-592c-1edb9713efa2-6ed3225" name="Combi Plasma" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter)/ 7 (Plasma)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter)/ 2 (Plasma)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Both) / Gets Hot, One Shot (Plasma)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">57</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5f3687c3-d2f7-4936-1a97-5198367ae06d-6ed3225" name="Combi-flamer" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><cons