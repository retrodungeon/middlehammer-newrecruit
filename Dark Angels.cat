 Shot</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="74fa6c6c-45b2-9d79-ed33-0052284d6821-6ed3225" name="Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="74fa6c6c-45b2-9d79-ed33-0052284d6821-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3aecada9-7756-623b-45d6-28a1309482d2-6ed3225" name="Drop Pod" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-Topped, Transport (10 models or 1 Dreadnought)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile></profiles><rules><rule id="d12f427b-17d5-3c72-4791-4efb4d6bf43f-6ed3225" name="Immobile" hidden="false" page="0"><description>A Drop Pod cannot move once it has entered the battle, and counts in all respects as a vehicle that has suffered an Immobilised damage result (which cannot be repaired)</description></rule><rule id="47bf8542-9b24-93a7-6715-8670c290ccef-6ed3225" name="Drop Pod Assault" hidden="false" page="0"><description>At the beginning of your first turn, half rounding up of your drop pods come in via Deep Strike</description></rule><rule id="d32e520a-2819-7b47-6a37-5193328203c3-6ed3225" name="Internal Guidance System" hidden="false" page="0"><description>Reduce the ammount of scatter by the minimum required to prevent landing on terrain or another model. If the Drop Pod scatters off the table roll on the Deep Strike Mishap table.</description></rule></rules><selectionEntries><selectionEntry id="90beeaf8-1f6a-a7cb-b3c2-a1250270077f-6ed3225" name="Locator Beacon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="90beeaf8-1f6a-a7cb-b3c2-a1250270077f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="9c331ced-399e-5cb9-d6c4-28111256faa0-6ed3225" name="Locator Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendlies do not scatter when deep striking within 6"</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="819a6589-2df0-f54b-0f56-27c68eea0e7c-6ed3225" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="819a6589-2df0-f54b-0f56-27c68eea0e7c-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="819a6589-2df0-f54b-0f56-27c68eea0e7c-maxSelections-6ed3225" includeChildSelections="false" in