520e-b159-85a3-a02b-8ac6d496daca-6ed3225" name="Ravenwing Grenade Launcher (Rad)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Rad Charge</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="c5284f1e-e451-9e11-c909-f13782f9dd3f-6ed3225" name="Ravenwing Grenade Launcher (Krak)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile><profile id="2e129ba3-dae5-3473-5780-ad698454a9dc-6ed3225" name="Ravenwing Grenade Launcher (Frag)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">6</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles><rules><rule id="a6aaf955-dcb5-6fcc-340d-5728c6286fd5-6ed3225" name="Stasis Anomaly" hidden="false" page="0"><description>Every model in a unit hit by one or more weapons with this special rule suffers a -1 penalty to their  Weapon Skill and Initiative, to a minimum of 1, until the end of the turn.</description></rule><rule id="b21ce0d2-a12c-16f0-26a7-e9c23bd022b9-6ed3225" name="Rad Charge" hidden="false" page="0"><description>Every model in a unit hit by one or more rad shells suffers a -1 penalty to their Toughness until the end of the turn ( this can affect the victims' Instant Death threshold) .</description></rule></rules></selectionEntry><selectionEntry id="4774da41-a6a1-0a8d-cc7a-06b55e933758-6ed3225" name="Grim Resolve" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="4774da41-a6a1-0a8d-cc7a-06b55e933758-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4774da41-a6a1-0a8d-cc7a-06b55e933758-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="5cf913b3-07e4-13c1-7df5-6d0ca3f8318b-6ed3225" name="Grim Resolve" hidden="false" page="28"><description>A model with this rule has Stubborn. In addition they may never choose to fail a morale check.</description></rule><rule id="a120ccc5-958d-2d3b-0fe4-59433ba8f03d-6ed3225" name="Stubborn" hidden="false" page="43"><description>Ignore all negative Ld modifiers, if the unit has Fearless as well ignore this rule.</description></rule></rules></selectionEntry><selectionEntry id="510cc5ec-8fbc-a2d4-b2ad-ce8af63eb13b-6ed3225" name="Power Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="510cc5ec-8fbc-a2d4-b2ad-ce8af63eb13b-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="510cc5ec-8fbc-a2d4-b2ad-ce8af63eb13b-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1a246ac6-8af8-441e-c5dd-896fd1314e10-6ed3225" name="Power Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="0"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Standard Space Marine Power Armour.  Confers a 3+ Sv</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="e129ae1e-d848-64b6-8993-ff3408b0e716-6ed3225" name="Frag and Krak Grenades" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e129ae1e-d848-64b6-8993-ff3408b0e716-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e129ae1e-d848-64b6-8993-ff3408b0e716-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2586dba9-7dc5-25d6-89b3-af63daaff5a0-6ed3225" name="Frag Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e677468232