>67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="346df135-6516-8014-490c-eecdca974517-6ed3225" name="Mace of Redemption" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="346df135-6516-8014-490c-eecdca974517-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="346df135-6516-8014-490c-eecdca974517-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="4bccac7c-fdfd-7256-412d-f9ffbc62cadf-6ed3225" name="Mace of Redemption" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Bane of The Traitor, Blind, Concussive</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles><rules><rule id="5b2b11a7-4816-1986-c0eb-5bde23419bb9-6ed3225" name="Bane of the Traitor" hidden="false" page="62"><description>When a Weapon with this Special Rule is used to attack a model from Codex: Chaos Space Marines, the AP is improved by 1 (to a max of 1)</description></rule></rules></selectionEntry><selectionEntry id="208e655f-068a-bcf3-f257-03eb6973a933-6ed3225" name="Monster Slayer of Caliban" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="208e655f-068a-bcf3-f257-03eb6973a933-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="208e655f-068a-bcf3-f257-03eb6973a933-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="a01bc6fe-15b4-e49d-9b76-dbe5843d836f-6ed3225" name="Monster Slayer of Caliban D6=5-6" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Instant Death</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile><profile id="51b9c64b-d667-25da-0ceb-369eb0b952d3-6ed3225" name="Monster Slayer of Caliban D6=1" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile><profile id="51ff776e-5372-68cc-2453-d54687fa1be4-6ed3225" name="Monster Slayer of Caliban D6=2-4" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="005df69c-3e1a-83f8-58bc-b8201b74642e-6ed3225" name="Shroud of Heroes" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="005df69c-3e1a-83f8-58bc-b8201b74642e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="005df69c-3e1a-83f8-58bc-b8201b74642e-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="3201700a-b90c-db50-ffec-53280ebbd35e-6ed3225" name="Shroud of Heroes" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="67"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Grants Feel No Pain (5+), in addition as long as the wearer is not in a unit he has Shrouded</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="5554d796-d8f0-c6b8-3b69-cb30fb13d6ef-6ed3225" name="Terminator Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5554d796-d8f0-c6b8-3b69-cb30fb13d6ef-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="026dce40-0795-5125-f987-85bbd6faee4b-6ed3225" name="Interrogator-Chaplain" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="30"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">5</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+ / 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">30</characteristic></characteristics></profile></profiles><rules><rule id="8a5b7b23-df30-f504-8dcc-930f2a14e1bc-6ed3225" name="Deathwing Assault" hidden="false" page="44"><description>Units composed entirely composed of models with this rule and wearing Terminator Armour can choose to make a Deathwing Assault.
Immediatly after determining Warlord Traits, tell your opponent which units are making a Deathwing Assault, and make a secret note on weather it happens during turn 1 or turn 2. All units chosen arrive then with no need to roll for deep strike reserves.</description></rule><rule id="5e41209a-200f-c7b1-00da-c9a6791e18bc-6ed3225" name="Vengeful Strike" hidden="false" page="44"><description>When a model with this rule arrives from Deep Strike, it treats all ranged weapons as having Twin Linked until end of turn.</description></rule></rules><selectionEntryGroups><selectionEntryGroup id="5b80165b-3ad1-ccfc-2315-7308ef2ef1e4-6ed3225" name="Terminator Weapons" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup id="e899ded2-39cc-7bcd-2d12-d49fb243b1e2-6ed3225" name="Left Hand" hidden="false" collective="false" import="true" defaultSelectionEntryId="c0e53849-0b1a-6c94-d7f5-cca231287759-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e899ded2-39cc-7bcd-2d12-d49fb243b1e2-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e899ded2-39cc-7bcd-2d12-d49fb243b1e2-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="c0e53849-0b1a-6c94-d7f5-cca231287759-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c0e53849-0b1a-6c94-d7f5-cca231287759-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="feff3275-63d3-7135-6c5f-d846a8deba64-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2c506e3d-397e-d745-9033-902e89e88adc-6ed3225" name="Combi-Plasma" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2c506e3d-397e-d745-9033-902e89e88adc-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4b73af77-79f3-0bfb-983a-875ad1be1f08-6ed3225" name="Combi Plasma" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter)/ 7 (Plasma)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter)/ 2 (Plasma)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Both) / Gets Hot, One Shot (Plasma)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">57</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="03395382-7d60-d7c2-8ebb-aa8a10f05f7f-6ed3225" name="Combi-flamer" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="03395382-7d60-d7c2-8ebb-aa8a10f05f7f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a60c7e4f-dfff-80b1-ac26-beb8133b203b-6ed3225" name="Combi-Flamer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24" (Bolter)/ Template (Flamer)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Bolter)/ Assault 1, One Shot (Flamer)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="d3b4a7e2-0a64-130c-e390-7dfa11018001-6ed3225" name="Combi-Melta" hidden="false" collective="false" import="true" type="upgrade" page="57"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="6" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d3b4a7e2-0a64-130c-e390-7dfa11018001-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bb90602e-0987-05f1-cf8a-e26e11d16d33-6ed3225" name="Combi-Melta" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24" (Bolter)/ 12" (Melta)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter)/ 8 (Melta)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter) / 1 (Melta)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Bolter) / Assault 1, Melta, One Shot (Melta)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56/57</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c9a7a285-081f-dd3a-2902-b3839cb71e19-6ed3225" name="Right Hand" hidden="false" collective="false" import="true" defaultSelectionEntryId="7751def8-119f-486c-4754-e0c758c9ec02-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c9a7a285-081f-dd3a-2902-b3839cb71e19-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c9a7a285-081f-dd3a-2902-b3839cb71e19-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="7751def8-119f-486c-4754-e0c758c9ec02-6ed3225" name="Crozius Arcanum" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7751def8-119f-486c-4754-e0c758c9ec02-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c78d0d7c-80ca-ce0a-d9e1-7c46144ff721-6ed3225" name="Crozius Arcanum" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive (replaces chain sword in the options)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f61b8a27-1263-98d3-38ea-5af58d448d24-6ed3225" name="Special Issue Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="2697bd79-1e2f-102e-fbe4-037c32a783cc-6ed3225" name="Auspex" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2697bd79-1e2f-102e-fbe4-037c32a783cc-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4996688a-bb4c-d799-693b-efa210144651-6ed3225" name="Auspex" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Forego shooting to make an enemy unit within 12" reduce it's cover save by 1, untill the end of the phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7eebb388-d784-39fb-c81c-c0ad997ea582-6ed3225" name="Combat Shield" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7eebb388-d784-39fb-c81c-c0ad997ea582-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6d7d0a7d-6634-a283-281a-46027ebe3173-6ed3225" name="Combat Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">6++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7406856e-b220-9c0e-2c76-1460f751e41d-6ed3225" name="Infravisor" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7406856e-b220-9c0e-2c76-1460f751e41d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="998a118f-11e9-46b8-2bab-271a0a32062d-6ed3225" name="Infravisor" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Has night vision, but sounts as Initive 1 for blind tests</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="11cb278b-24db-062d-00e5-9db69cfe23b7-6ed3225" name="Melta Bombs" hidden="false" collective="false" import="true" type="upgrade" page="62"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="11cb278b-24db-062d-00e5-9db69cfe23b7-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ca48a245-9b09-717c-a1dd-271a4652ad96-6ed3225" name="Melta Bombs" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a2e921b7-59cc-5b37-d29e-8a0c1a71f4ad-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a2e921b7-59cc-5b37-d29e-8a0c1a71f4ad-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="365c96dd-1151-3885-06a6-e5b7410cd40a-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2865dafe-7148-49f1-cb8a-1555427c6cea-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2865dafe-7148-49f1-cb8a-1555427c6cea-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="75aeea02-8802-6585-9296-1100e30970bc-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fcf7274a-5a01-f30a-ec0e-16e2d239e0ee-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fcf7274a-5a01-f30a-ec0e-16e2d239e0ee-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="715bc875-e84f-63f1-38bc-79a500f581ea-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3b370601-4535-5b52-0e2d-69a3a30b3b7c-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3b370601-4535-5b52-0e2d-69a3a30b3b7c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7385f8a5-8cf1-6feb-6adc-c7aec4517cd5-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bd9fc09f-fdeb-c928-68f3-3ed78e2af30a-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bd9fc09f-fdeb-c928-68f3-3ed78e2af30a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="edee8748-adbe-e571-1b01-9eb052e43064-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup><selectionEntryGroup id="cd923977-3f15-5475-ba7d-d203877f4f1c-6ed3225" name="Chapter Relics" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="267a04d3-94ed-05e8-d1cf-17854dd7ea8f-6ed3225" name="Foe Smiter" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="267a04d3-94ed-05e8-d1cf-17854dd7ea8f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="267a04d3-94ed-05e8-d1cf-17854dd7ea8f-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="ed907bcf-8ea1-aca9-022e-6eb434f25630-6ed3225" name="Foe Smiter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 3, Master Crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bf84fa0f-4eaa-87f0-fa72-736fc0c8fced-6ed3225" name="Lion's Roar" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bf84fa0f-4eaa-87f0-fa72-736fc0c8fced-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="bf84fa0f-4eaa-87f0-fa72-736fc0c8fced-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="12b73371-120d-b5f7-b5f9-1fe7e0b13a43-6ed3225" name="Lion's Roar" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter) / 7 (Lion's Roar)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter) / 2 (Lion's Roar)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Bolter) / Assault 1, Blast, Gets Hot, Master Crafted, One Shot (Lion's Roar)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="41ede28d-5fac-be15-6125-b6fc1618a52d-6ed3225" name="Mace of Redemption" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="41ede28d-5fac-be15-6125-b6fc1618a52d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="41ede28d-5fac-be15-6125-b6fc1618a52d-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="39398bd7-b87a-1c94-9675-3103d14254c6-6ed3225" name="Mace of Redemption" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Bane of The Traitor, Blind, Concussive</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles><rules><rule id="d3ac6236-62f2-f117-1487-4ec095fb401c-6ed3225" name="Bane of the Traitor" hidden="false" page="62"><description>When a Weapon with this Special Rule is used to attack a model from Codex: Chaos Space Marines, the AP is improved by 1 (to a max of 1)</description></rule></rules></selectionEntry><selectionEntry id="8b1bd2c2-f9a0-416a-234a-be93572c2a0e-6ed3225" name="Monster Slayer of Caliban" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8b1bd2c2-f9a0-416a-234a-be93572c2a0e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8b1bd2c2-f9a0-416a-234a-be93572c2a0e-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="0af8689f-f093-4888-a82f-b1869cb616f5-6ed3225" name="Monster Slayer of Caliban D6=5-6" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Instant Death</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile><profile id="eae3fbf2-4598-81c1-5456-82f6074e9fd1-6ed3225" name="Monster Slayer of Caliban D6=1" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile><profile id="4f72f474-d4f2-7625-f33a-4bfafbc6e775-6ed3225" name="Monster Slayer of Caliban D6=2-4" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cd7292bf-aa64-5104-35a8-7247e5a5fdaa-6ed3225" name="Shroud of Heroes" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cd7292bf-aa64-5104-35a8-7247e5a5fdaa-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="cd7292bf-aa64-5104-35a8-7247e5a5fdaa-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="512e5a65-ba3a-6a0f-ccf3-84b8576988de-6ed3225" name="Shroud of Heroes" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="67"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Grants Feel No Pain (5+), in addition as long as the wearer is not in a unit he has Shrouded</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="6f22a1b0-a00d-e35a-118a-d9df6776915d-6ed3225" name="Land Raider" hidden="false" collective="false" import="true" type="unit"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="Heavy Support" hidden="false" id="6f22a1b0-a00d-e35a-118a-d9df6776915d-slot-6ed3225" targetId="9260-7d57-be5c-bd52" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="250" /></costs><constraints /><profiles><profile id="fdcdffed-3418-ca80-fb0d-6526eb23ede0-6ed3225" name="Land Raider" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">14</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">14</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">14</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Tank, Transport (10 Models)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">4</characteristic></characteristics></profile></profiles><rules><rule id="11a4626e-3ddc-a075-e314-2ae3e24f655f-6ed3225" name="Assault Vehicle" hidden="false" page="0"><description>Passengers may assault the same turn they disembark</description></rule><rule id="54786678-badf-493f-8256-6d924b3fd87c-6ed3225" name="Power of the Machine Spirit" hidden="false" page="0"><description>So long as the vehicle dosen't move flat out or pop smoke, it may fire an additional weapon than normal and may fire at a different target.</description></rule></rules><selectionEntries><selectionEntry id="b0531b3b-26d5-4cf9-2192-de8caa4718be-6ed3225" name="Multi Melta" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b0531b3b-26d5-4cf9-2192-de8caa4718be-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b2ac200b-282c-56b9-d787-2f02d4e7a82c-6ed3225" name="Multi Melta" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="57"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Melta</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="10e629b1-7317-aec8-06f2-8a821c45cd33-6ed3225" name="Twin Linked Heavy Bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="10e629b1-7317-aec8-06f2-8a821c45cd33-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="10e629b1-7317-aec8-06f2-8a821c45cd33-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5f0f2608-c8c7-bbab-5471-6a1afb64dd1a-6ed3225" name="Heavy Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">36"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 3</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ee54a5a7-4376-df52-bd44-14c45d223ae9-6ed3225" name="Twin Linked Lascannon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="par