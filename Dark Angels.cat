46823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="31539cde-e7b1-742f-08a4-86f80dc870d1-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="31539cde-e7b1-742f-08a4-86f80dc870d1-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="be7b2b0b-1239-b4d6-64ae-c11e93ed191f-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1c1fc3f3-72f5-dcec-a32e-c6d8f38109c5-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1c1fc3f3-72f5-dcec-a32e-c6d8f38109c5-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="81f464b5-9b82-3205-cb11-443ce8613361-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="efd556ca-9ef1-b8ad-d5f3-c9a65f328cb6-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="efd556ca-9ef1-b8ad-d5f3-c9a65f328cb6-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="28f72dac-11af-e762-cfbf-ae64b401b154-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a2223792-30ae-385c-19ff-b4f2e42a949c-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a2223792-30ae-385c-19ff-b4f2e42a949c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e1da2b93-2e88-785b-bc5a-95cd9f2e0ca6-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="35460dd9-7328-b0af-df7c-50df49848186-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="35460dd9-7328-b0af-df7c-50df49848186-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e2f26507-27d6-0a83-32d9-1f723c036a2a-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups></selectionEntry><selec