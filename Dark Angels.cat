      </characteristics>
    </profile>
    <profile id="e6a2617b-0c8a-bf61-4667-135d52f65185-bf89a" name="Ravenwing Grenade Launcher (Frag)" page="150" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
