        <selectionEntry id="mh-rad-dark-angels-7a92a6a2-8aaf-e81c-89e6-1c33fcdd29bb" name="Grav Gauntlet" publicationId="ca571888--pubN84158" page="226" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-dark-angels-7a92a6a2-8aaf-e81c-89e6-1c33fcdd29bb-minSelections" type="min" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-dark-angels-7a92a6a2-8aaf-e81c-89e6-1c33fcdd29bb-maxSelections" type="max" />
