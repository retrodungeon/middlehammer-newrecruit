ints" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b6c0d523-131e-d472-72f2-57500f46d088-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b6c0d523-131e-d472-72f2-57500f46d088-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="32a9c4d3-1890-d2ca-1e5a-7ae5493eafc4-6ed3225" name="Stasis Bomb" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Bomb, Large Blast, Vast Stasis Anomaly, One Use Only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles><rules><rule id="1082df5a-045d-6e4b-14e9-1b9b533b40aa-6ed3225" name="Vast Stasis Anomaly" hidden="false" page="0"><description>Every model in a unit hit by one or more weapons with this special rule suffers a -3 penalty to its Weapon
