    <selectionEntry id="cdc81bca-4285-8678-278f-adad935206f0-bf89a" name="Icon of Glory" hidden="false" collective="false" type="upgrade">
      <profiles>
        <profile id="2ad875a3-23fc-d2fd-bc6c-8f2ac348e7f6-bf89a" name="Icon of Glory" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has either +1 BS or +1 WS (declared before the game begins). Should the army's warlord be within 2" of the vehicle, the range of any Command Trait he has rolled on the warlord traits table is increased by 6".  In missions that use Objectives and Victory points to determine the winner, the destruction of the vehicle counts as an additional Secondary Objective, earning the opposing player an extra +1 Victory point.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules />
      <infoLinks />
      <modifiers />
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cdc81bca-4285-8678-278f-adad935206f0-maxSelections-bf89a" type="max" />
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cdc81bca-4285-8678-278f-adad935206f0-maxInRoster-bf89a" type="max" />
      </constraints>
