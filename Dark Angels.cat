    <selectionEntry id="mh-rad-dark-angels-7c81-4f38-1f4e-ac6b" name="Mine Plough" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="mh-rad-dark-angels-93df-8954-23ad-b8d4" type="max" />
      </constraints>
      <rules>
        <rule id="mh-rad-dark-angels-4fc9-2c63-c634-2a9f" name="Mine Plough" hidden="false">
          <description>A vehicle equipped with a mine plough rolls 2D6 when making a Dangerous Terrain test instead of just one dice. The test is only failed if the result of both rolls is 1s. In addition, whenever the vehicle moves through an enemy Infantry unit as part of a Tank Shock move and is not destroyed, the enemy unit takes D3+1 S2 AP- hits.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10.0" />
      </costs>
    </selectionEntry>
