                <profile id="mh-rad-dark-angels-d14d-ddf8-a290-9243" name="Aiolos Missile Launcher" publicationId="ca571888--pubN68042" page="215" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
                  <characteristics><characteristic name="Range" typeId="52616e676523232344415441232323">60"</characteristic><characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic><characteristic name="Type" typeId="8b10-045a-f593-605e">Heavy 3, Pinning, Independent Tracking</characteristic></characteristics></profile>
              </profiles>
              <rules>
                <rule id="mh-rad-dark-angels-8d9a-63ee-1c0d-c54f" name="Independent Tracking" publicationId="ca571888--pubN106705" hidden="false">
                  <description>This weapon may fire at a different target to that of the Deredeo’s other shooting attacks if desired and ignores intervening obstacles to line of sight in open terrain. When firing at vehicles, it attacks their Side Armour value.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="35.0" />
              </costs>
            </selectionEntry>
            <selectionEntry id="mh-rad-dark-angels-87cb-ffc2-cdc0-b05d" name="Atomantic Pavaise" publicationId="ca571888--pubN68042" page="215" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="mh-rad-dark-angels-87cb-ffc2-cdc0-b05d-maxSelections" type="max" />
              </constraints>
              <profiles>
                <profile id="mh-rad-dark-angels-f233-f854-26d4-735f" name="Atomantic Pavaise" publicationId="ca571888--pubN68042" page="215" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear">
                  <characteristics><characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">This reinforced shield increases the Deredeo’s own invulnerable save to 4+ against shooting attacks, and grants friendly infantry models within 3" of the Deredeo’s base an invulnerable save of 6+ against shooting attacks or boosts an invulnerable save they already possess by +1 (5+ becoming 4+, etc) to a maximum of 3+.

Note that the pavaise’s bonus has no effect on invulnerable saves in close combat, and its benefits do not stack with the effects of other atomantic pavaises, or other special rules, psychic powers or items of wargear which boost an existing invulnerable save.

A Deredeo Dreadnought with an atomantic pavaise adds +D3 to its Blast radius, rather than +1, if it explodes, and has an explosion Strength of 5.</characteristic></characteristics></profile>
              </profiles>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50.0" />
              </costs>
            </selectionEntry>
