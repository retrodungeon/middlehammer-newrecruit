max" value="1" field="selections" scope="parent" shared="true" id="e2a3457b-8f64-c3a4-618f-6f4fc8901ea4-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="336e5c62-b3b1-6ddd-02ee-ff86b513c63a-6ed3225" name="Drop Pod" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-Topped, Transport (10 models or 1 Dreadnought)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile></profiles><rules><rule id="09a6b28f-89e7-696e-688a-7aba085da864-6ed3225" name="Immobile" hidden="false" page="0"><description>A Drop Pod cannot move once it has entered the battle, and counts in all respects as a vehicle that has suffered an Immobilised damage result (which cannot be repaired)</description></rule><rule id="3e352b9b-7156-b02d-6f9f-b00b5d23b546-6ed3225" name="Drop Pod Assault" hidden="false" page="0"><description>At the beginning of your first turn, half rounding up of your drop pods come in via Deep Strike</description></rule><rule id="4970f2aa-602e-8932-1b21-392e8a5afa15-6ed3225" name="Internal Guidance System" hidden="false" page="0"><description>Reduce the ammount of scatter by the minimum required to prevent landing on terrain or another model. If the Drop Pod scatters off the table roll on the Deep Strike Mishap table.</description></rule><rule id="1056f330-ff1a-7576-53d3-f7d3ff984fbb-6ed3225" name="Non Jump Infantry" hidden="false" page="0"><description>Assault units that drop their Jump Packs for a Drop Pod or Rhino are no longer Jump Infantry, just regular Infantry.
All other rules apply</description></rule></rules><selectionEntries><selectionEntry id="df96c64b-b531-7413-d2ab-6f766759dc2d-6ed3225" name="Locator Beacon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df96c64b-b531-7413-d2ab-6f766759dc2d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="72cbd9a6-a5a5-65e9-7483-564492ef2f3c-6ed3225" name="Locator Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendlies do not scatter when deep striking within 6"</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="51602d8b-e711-2b39-7592-2f03ba94dd38-6ed3225" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="51602d8b-e711-2b39-7592-2f03ba94dd38-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="51602d8b-e711-2b39-7592-2f03ba94dd38-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="692f99d6-20ea-2c21-1f50-245348f4289d-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="692f