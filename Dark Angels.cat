t" shared="true" id="d3c417ab-8af7-8e5b-749a-4ca9eff96e12-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d3c417ab-8af7-8e5b-749a-4ca9eff96e12-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="606ea93a-c3cb-ddae-4c1a-5f6c8c076ac9-6ed3225" name="Frag Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Don't suffer Initive penalty for charging through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="3376e62b-83e8-fd2d-0244-04d739f5302a-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4a13ca2f-7f2f-872e-9372-1d6ed6e5454a-6ed3225" name="Grim Resolve" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="4a13ca2f-7f2f-872e-9372-1d6ed6e5454a-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4a13ca2f-7f2f-872e-9372-1d6ed6e5454a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="756bc70d-c5d0-2634-04df-e4c278bfac49-6ed3225" name="Grim Resolve" hidden="false" page="28"><description>A model with this rule has Stubborn. In addition they may never choose to fail a morale check.</description></rule><rule id="cca47f01-225d-a5ce-bff4-5559515dd1c0-6ed3225" name="Stubborn" hidden="false" page="43"><description>Ignore all negative Ld modifiers, if the unit has Fearless as well ignore this rule.</description></rule></rules></selectionEntry><selectionEntry id="d7631e0b-54d0-b183-6929-4b2e34d12dce-6ed3225" name="Inner Circle" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d7631e0b-54d0-b183-6929-4b2e34d12dce-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d7631e0b-54d0-b183-6929-4b2e34d12dce-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="f543a10d-f54f-3ade-a32f-1ed197c37bc8-6ed3225" name="Preferred Enemy (Chaos Space Marines)" hidden="false" page="40"><description>Reroll all failed to hit and to wound rolls of 1 against the chosen enemy in both shooting and assault.</description></rule><rule id="bf6eed91-5e9a-28ea-c881-19b46f4ac7c2-6ed3225" name="Fearless" hid