    <selectionEntry id="d8b76567-44b1-af2e-32d0-0c0b2c4a3b22-bf89a" name="Ravenwing Grenade Launcher" page="0" hidden="false" collective="false" type="upgrade">
      <profiles />
      <rules>
        <rule id="0d6fd111-c31a-1e88-d015-7864ef01b893-bf89a" name="Rad Charge" page="150" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>On a to-wound roll of 6, two wounds are caused independent from the targets toughness.</description>
        </rule>
        <rule id="bcbff654-417a-5db3-5766-bbd078088c0c-bf89a" name="Stasis Anomaly" page="150" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>Every model of a unit hit by one or more weapons with this special rule suffers a -1 penalty to their Weapon Skill and Initiative, to a minimum of 1, until the end of the turn.</description>
        </rule>
      </rules>
      <infoLinks>
