ame="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">1</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Armourbane, Unwieldly, Against Vehicles and MCs only</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a2e921b7-59cc-5b37-d29e-8a0c1a71f4ad-6ed3225" name="Digital Weapons" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a2e921b7-59cc-5b37-d29e-8a0c1a71f4ad-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="365c96dd-1151-3885-06a6-e5b7410cd40a-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2865dafe-7148-49f1-cb8a-1555427c6cea-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2865dafe-7148-49f1-cb8a-1555427c6cea-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="75aeea02-8802-6585-9296-1100e30970bc-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fcf7274a-5a01-f30a-ec0e-16e2d239e0ee-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fcf7274a-5a01-f30a-ec0e-16e2d239e0ee-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="715bc875-e84f-63f1-38bc-79a500f581ea-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3b370601-4535-5b52-0e2d-69a3a30b3b7c-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3b370601-4535-5b52-0e2d-69a3a30b3b7c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7385f8a5-8cf1-6feb-6adc-c7aec4517cd5-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bd9fc09f-fdeb-c928-68f3-3ed78e2af30a-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bd9fc09f-fdeb-c928-68f3-3ed78e2af30a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="edee8748-adbe-e571-1b01-9eb052e43064-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup><selectionEntryGroup id="cd923977-3f15-5475-ba7d-d203877f4f1c-6ed3225" name="Chapter Relics" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="267a04d3-94ed-05e8-d1cf-17854dd7ea8f-6ed3225" name="Foe Smiter" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="267a04d3-94ed-05e8-d1cf-17854dd7ea8f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="267a04d3-94ed-05e8-d1cf-17854dd7ea8f-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="ed907bcf-8ea1-aca9-022e-6eb434f25630-6ed3225" name="Foe Smiter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 3, Master Crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bf84fa0f-4eaa-87f0-fa72-736fc0c8fced-6ed3225" name="Lion's Roar" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bf84fa0f-4eaa-87f0-fa72-736fc0c8fced-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="bf84fa0f-4eaa-87f0-fa72-736fc0c8fced-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="12b73371-120d-b5f7-b5f9-1fe7e0b13a43-6ed3225" name="Lion's Roar" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4 (Bolter) / 7 (Lion's Roar)</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5 (Bolter) / 2 (Lion's Roar)</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire (Bolter) / Assault 1, Blast, Gets Hot, Master Crafted, One Shot (Lion's Roar)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="41ede28d-5fac-be15-6125-b6fc1618a52d-6ed3225" name="Mace of Redemption" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="41ede28d-5fac-be15-6125-b6fc1618a52d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="41ede28d-5fac-be15-6125-b6fc1618a52d-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="39398bd7-b87a-1c94-9675-3103d14254c6-6ed3225" name="Mace of Redemption" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Bane of The Traitor, Blind, Concussive</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles><rules><rule id="d3ac6236-62f2-f117-1487-4ec095fb401c-6ed3225" name="Bane of the Traitor" hidden="false" page="62"><description>When a Weapon with this Special Rule is used to attack a model from Codex: Chaos Space Marines, the AP is improved by 1 (to a max of 1)</description></rule></rules></selectionEntry><selectionEntry id="8b1bd2c2-f9a0-416a-234a-be93572c2a0e-6ed3225" name="Monster Slayer of Caliban" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8b1bd2c2-f9a0-416a-234a-be93572c2a0e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8b1bd2c2-f9a0-416a-234a-be93572c2a0e-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="0af8689f-f093-4888-a82f-b1869cb616f5-6ed3225" name="Monster Slayer of Caliban D6=5-6" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Instant Death</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile><profile id="eae3fbf2-4598-81c1-5456-82f6074e9fd1-6ed3225" name="Monster Slayer of Caliban D6=1" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile><profile id="4f72f474-d4f2-7625-f33a-4bfafbc6e775-6ed3225" name="Monster Slayer of Caliban D6=2-4" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="67"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+1</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">67</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cd7292bf-aa64-5104-35a8-7247e5a5fdaa-6ed3225" name="Shroud of Heroes" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="50" /></costs><constraints><constraint type="max" value="1" field="selections" scope