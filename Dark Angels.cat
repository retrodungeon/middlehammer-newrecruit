All other rules apply</description></rule></rules><selectionEntries><selectionEntry id="f0b2e148-1b32-c43d-b7a5-558969130914-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f0b2e148-1b32-c43d-b7a5-558969130914-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f0b2e148-1b32-c43d-b7a5-558969130914-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="66893bce-78e4-e7ab-a483-6663b6721666-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d2ff14d2-1666-1df7-a6ed-3c1442ed40b5-6ed3225" name="Smoke Launchers and Searchlight" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d2ff14d2-1666-1df7-a6ed-3c1442ed40b5-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d2ff14d2-1666-1df7-a6ed-3c1442ed40b5-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e05af110-c35e-daf7-49de-9ae5a47dbee7-6ed3225" name="Searchlight" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">After firing all weapons can illuninate the unit it shot at and it's self during night fighting</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile><profile id="daca591f-6b77-238c-ac6c-61eda63ffc25-6ed3225" name="Smoke Launchers" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Once per game, instead of shooting or moving flat out, may gain a 5+ cover save</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="2c8af157-a4d0-096b-1e47-ab81aff139f3-6ed3225" name="Vehicle Options" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="ad17c8b6-8671-3620-59a9-8c8f20ed1524-6ed3225" name="Dozer Blade" hidden="false" collective="false" import="true" type="upgrade" page="87"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ad17c8b6-8671-3620-59a9-8c8f20ed1524-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="380f9d23-613c-f5c9-955a-3ffdccac8847-6ed3225" name="Dozer Blade" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">re-roll failed dangerous terrain tests</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="89275e47-16fa-6311-75b0-de224408d227-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="89275e47-16fa-6311-75b0-de224408d227-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="31b9bada-c949-b9a0-3164-d471e514abc8-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b70cf094-2bee-7e4c-d74b-305ecd2f2c6f-6ed3225" name="Extra Armour" hidden="false" collective="false" import="true" type="upgrade" page="87"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b70cf094-2bee-7e4c-d74b-305ecd2f2c6f-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8784ca08-bfa3-6967-aa34-fd30e2d9992e-6ed3225" name="Extra Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="87"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Stunned counts as Shaken</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8dfa1d81-6edf-7010-ccff-545e4d74eb86-6ed3225" name="Hunter Killer Missile" hidden="false" collective="false" import="true" type="upgrade" page="87"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8dfa1d81-6edf-7010-ccff-545e4d74eb86-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e729aeed-40c8-822c-c9a9-398694a151c3-6ed3225" name="Hunter Killer Missile" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="87"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">Unlimited</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">8</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, One Shot</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">87</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="e2a3457b-8f64-c3a4-618f-6f4fc8901ea4-6ed3225" name="Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e2a3457b-8f64-c3a4-618f-6f4fc8901ea4-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="336e5c62-b3b1-6ddd-02ee-ff86b513c63a-6ed3225" name="Drop Pod" hidden="false" typeId="mh6-56656869636c6523232344415441232323" typeName="Vehicle" page="0"><characteristics><characteristic name="BS" typeId="mh6-425323232344415441232323">4</characteristic><characteristic name="Front" typeId="mh6-46726f6e7423232344415441232323">12</characteristic><characteristic name="Side" typeId="mh6-5369646523232344415441232323">12</characteristic><characteristic name="Rear" typeId="mh6-5265617223232344415441232323">12</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Open-Topped, Transport (10 models or 1 Dreadnought)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /><characteristic name="HP" typeId="mh6-485023232344415441232323">3</characteristic></characteristics></profile></profiles><rules><rule id="09a6b28f-89e7-696e-688a-7aba085da864-6ed3225" name="Immobile" hidden="false" page="0"><description>A Drop Pod cannot move once it has entered the battle, and counts in all respects as a vehicle that has suffered an Immobilised damage result (which cannot be repaired)</description></rule><rule id="3e352b9b-7156-b02d-6f9f-b00b5d23b546-6ed3225" name="Drop Pod Assault" hidden="false" page="0"><description>At the beginning of your first turn, half rounding up of your drop pods come in via Deep Strike</description></rule><rule id="4970f2aa-602e-8932-1b21-392e8a5afa15-6ed3225" name="Internal Guidance System" hidden="false" page="0"><description>Reduce the ammount of scatter by the minimum required to prevent landing on terrain or another model. If the Drop Pod scatters off the table roll on the Deep Strike Mishap table.</description></rule><rule id="1056f330-ff1a-7576-53d3-f7d3ff984fbb-6ed3225" name="Non Jump Infantry" hidden="false" page="0"><description>Assault units that drop their Jump Packs for a Drop Pod or Rhino are no longer Jump Infantry, just regular Infantry.
All other rules apply</description></rule></rules><selectionEntries><selectionEntry id="df96c64b-b531-7413-d2ab-6f766759dc2d-6ed3225" name="Locator Beacon" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df96c64b-b531-7413-d2ab-6f766759dc2d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="72cbd9a6-a5a5-65e9-7483-564492ef2f3c-6ed3225" name="Locator Beacon" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendlies do not scatter when deep striking within 6"</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="51602d8b-e711-2b39-7592-2f03ba94dd38-6ed3225" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="51602d8b-e711-2b39-7592-2f03ba94dd38-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="51602d8b-e711-2b39-7592-2f03ba94dd38-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="692f99d6-20ea-2c21-1f50-245348f4289d-6ed3225" name="Storm Bolter" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="692f99d6-20ea-2c21-1f50-245348f4289d-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5e377582-41b9-0995-61cb-b1e8a916ea03-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="96cce09c-2d8b-4027-13ff-79ea7cc1c973-6ed3225" name="Deathwind Launcher" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="96cce09c-2d8b-4027-13ff-79ea7cc1c973-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="009077ec-1a22-1cf5-7fce-2ab5f6ee6ac3-6ed3225" name="Deathwind Launcher" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="0"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">5</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Heavy 1, Large Blast</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="ca7afccf-ee37-ccd7-0627-fa8de1534c99-6ed3225" name="Azrael" hidden="false" collective="false" import="true" type="unit" page="52"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="HQ" hidden="false" id="ca7afccf-ee37-ccd7-0627-fa8de1534c99-slot-6ed3225" targetId="ac8d-efba-1884-d3ad" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="215" /></costs><constraints><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="ca7afccf-ee37-ccd7-0627-fa8de1534c99-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="df385a55-2d04-9d26-c762-3f663de32a3b-6ed3225" name="Azrael" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="52"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Unique Infantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">4</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">4</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">52</characteristic></characteristics></profile></profiles><rules><rule id="2758f442-1f26-99ef-c91c-568c94898bd4-6ed3225" name="Supreme Grand Master of the Dark Angels" hidden="false" page="92"><description>In a primary detachment that contains Azrael, Ravenwing Attack Squadrons and Deathwing Terminator Squads are troops instead of their normal Force Organisation categories.</description></rule><rule id="78145c89-4318-8a2f-1ad4-3f586d14e936-6ed3225" name="Warlord Trait" hidden="false" page="53"><description>Pick (do not roll) on the Dark Angels Warlord table on Page 28</description></rule><rule id="05f44f09-b12c-98df-ada1-bcb1fedb2828-6ed3225" name="Rites of Battle" hidden="false" page="53"><description>All models in Codex: Dark Angels 6th use his Azrael's Ledership as long as he is on the table.</description></rule><rule id="4acb66b4-cf15-c85f-886d-787164b8ca66-6ed3225" name="Independant Character" hidden="false" page="0"><description>Independent Characters can join and leave other non-vehicle non-'loner' units. Although Independent Characters may join with other Independent Characters to form a powerful multi-character unit.
An Independent Character counts as having joined a unit if he ends his move within 2" of them, if he is within 2" of more than one unit you must declare which unit he is joining.
An Independent Character may leave his unit and join another one in the same movement phase, but he may not join a unit in any other phase.
An Independent Character cannot join or leave a unit that is locked in combat or falling back, he also may not leave a unit that has gone to ground.

Look out Sir is taken on a 2+

If a unit with an Independent Character in it has fallen to below 25% they test as if they had 25% remaning

When an Independent Character joins a unit he looses all special rules that the unit does not have unless the rule says it applys to the unit (eg Stubborn) and vice versa

If the unit is suffering from ongoing effects (eg blind, soul blaze) and the Independent Character leaves the unit, he is still suffering from those effects as well, but they to not transfer to a new unit he joins.</description></rule></rules><selectionEntries><selectionEntry id="07c34a97-8986-db57-662e-efb6edc750e3-6ed3225" name="Lion Helm" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="07c34a97-8986-db57-662e-efb6edc750e3-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="07c34a97-8986-db57-662e-efb6edc750e3-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f6dbb122-177a-1c93-b41a-6ea98cfeb285-6ed3225" name="Lion Helm" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="53"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++ to Azrael and his unit</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">53</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="de73899f-9be6-ff7f-f2b9-665ebf245834-6ed3225" name="Lion's Wrath" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="de73899f-9be6-ff7f-f2b9-665ebf245834-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="de73899f-9be6-ff7f-f2b9-665ebf245834-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="141fbf41-4d01-f845-6758-c92ab231bd5a-6ed3225" name="Lion's Wrath (Bolter)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="53"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Master Crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">53</characteristic></characteristics></profile><profile id="5a97138f-2624-f9cf-6cc0-dde3063d8107-6ed3225" name="Lion's Wrath (plasma)" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="53"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">7</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Rapid Fire, Blind, Gets-Hot, Master Crafted, One Shot</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">53</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5480be97-fd14-1796-041d-b0b17750a54e-6ed3225" name="Protector" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5480be97-fd14-1796-041d-b0b17750a54e-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5480be97-fd14-1796-041d-b0b17750a54e-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="49de2daa-d3fa-5ee2-8727-7debf3757a2e-6ed3225" name="Protector" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="53"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Artificier Armour that grants Feel No Pain (6+) to Azrael</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">53</characteristic></characteristics></profile></profiles><rules><rule id="5761c3c1-2e55-4ee6-e843-6df630adecd6-6ed3225" name="Feel No Pain (6+)" hidden="false" page="0"><description>Ignore unsaved wounds on a 6+, treat it as saved wound</description></rule></rules></selectionEntry><selectionEntry id="3c586f75-d852-0dc5-5f77-0e5c0caea537-6ed3225" name="Sword of Secrets" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><profiles><profile id="4e349952-a720-0527-611c-1b138c578ca5-6ed3225" name="Sword of Secrets" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="53"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">+2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Master Crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">53</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="013887d0-a7d8-bdab-09ca-d188d99a9cd7-6ed3225" name="Frag and Krak Grenades" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="013887d0-a7d8-bdab-09ca-d188d99a9cd7-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="013887d0-a7d8-bdab-09ca-d188d99a9cd7-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="17e09507-e81f-1179-560d-5902416bb5b5-6ed3225" name="Frag Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Don't suffer Initive penalty for charging through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="4b453c8f-f6e3-5fb7-2334-87e3bb2c7a28-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="06bafcfc-c413-b4af-49cf-8621401caf11-6ed3225" name="Inner Circle" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="06bafcfc-c413-b4af-49cf-8621401caf11-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="06bafcfc-c413-b4af-49cf-8621401caf11-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="71d23e7d-de78-184e-9c64-795b4c120c07-6ed3225" name="Preferred Enemy (Chaos Space Marines)" hidden="false" page="40"><description>Reroll all failed to hit and to wound rolls of 1 against the chosen enemy in both shooting and assault.</description></rule><rule id="5779647d-0709-ec08-c27b-fbc79140e25e-6ed3225" name="Fearless" hidden="false" page="35"><description>Automatically pass all LD tests but cannot go to ground or use the "Our Weapons Are Usless" rule.</description></rule></rules></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="c943c712-1997-a4b6-5734-6bb5e7c79d3f-6ed3225" name="Basic Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="d9dea146-ed99-e0ab-3f86-25a9a9b69cbd-6ed3225" name="Bolt Pistol" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d9dea146-ed99-e0ab-3f86-25a9a9b69cbd-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d9dea146-ed99-e0ab-3f86-25a9a9b69cbd-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f8eb0846-2c91-ecd6-37c6-33f2aef10934-6ed3225" name="Bolt Pistol" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">12"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Pistol</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="7839e062-8139-9fac-a9c3-1741a3a98f46-6ed3225" name="Frag and Krak Grenades" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7839e062-8139-9fac-a9c3-1741a3a98f46-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7839e062-8139-9fac-a9c3-1741a3a98f46-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5628f19b-4eb7-6443-c853-ab923a604c0e-6ed3225" name="Frag Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">3</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">-</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1, Blast, Don't suffer Initive penalty for charging through cover</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="cb513d37-0954-fa19-542b-1cda1ba09db7-6ed3225" name="Krak Grenades" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="62"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">8" (thrown)/-(Melee)</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">6</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">4</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 1(Thrown)/Only on Vehicles and MCs (Melee)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">62</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="47dbe873-d068-d716-369b-664d7994667f-6ed3225" name="Belial" hidden="false" collective="false" import="true" type="model" page="56"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="HQ" hidden="false" id="47dbe873-d068-d716-369b-664d7994667f-slot-6ed3225" targetId="ac8d-efba-1884-d3ad" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="190" /></costs><constraints><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="47dbe873-d068-d716-369b-664d7994667f-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="1cb27538-f1ea-e508-0a31-0b2b8e0af283-6ed3225" name="Belial" hidden="false" typeId="mh6-556e697423232344415441232323" typeName="Unit" page="56"><characteristics><characteristic name="Unit Type" typeId="mh6-556e6974205479706523232344415441232323">Unique, INfantry (Character)</characteristic><characteristic name="WS" typeId="mh6-575323232344415441232323">6</characteristic><characteristic name="BS" typeId="mh6-425323232344415441232323">5</characteristic><characteristic name="S" typeId="mh6-5323232344415441232323">4</characteristic><characteristic name="T" typeId="mh6-5423232344415441232323">4</characteristic><characteristic name="W" typeId="mh6-5723232344415441232323">3</characteristic><characteristic name="I" typeId="mh6-4923232344415441232323">5</characteristic><characteristic name="A" typeId="mh6-4123232344415441232323">3</characteristic><characteristic name="LD" typeId="mh6-4c4423232344415441232323">10</characteristic><characteristic name="Save" typeId="mh6-5361766523232344415441232323">2+/4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles><rules><rule id="eaa51c22-45e9-36af-b6c8-7ff6fa99ced1-6ed3225" name="Grand Master of the Deathwing" hidden="false" page="92"><description>In a primary Detachment that contains Belial, Deathwing Terminator Squads are troops choices instead of elites.</description></rule><rule id="f4678128-115a-65f4-46a3-eee003ec7604-6ed3225" name="Warlord Trait: The Hunt" hidden="false" page="56"><description>+1 Victory point if your Warlord or his unit kill enemy Warlord in the Assault phase.</description></rule><rule id="061a12cb-41aa-45af-71b0-a1d2e9afd538-6ed3225" name="Marked for Retribution" hidden="false" page="56"><description>Belial's shooting attacks are precision Shots on a to hit roll of 5+</description></rule><rule id="eb8ecfdf-6d1b-04e6-b324-dea6f8cf1ad5-6ed3225" name="Tactical Precision" hidden="false" page="56"><description>Belial and any unit he has joined with Inner Circle rule do not scatter when Deep Striking.</description></rule><rule id="cf8a3d81-2e27-4439-608c-887b8ae2e0f9-6ed3225" name="Deathwing Assault" hidden="false" page="44"><description>Units composed entirely composed of models with this rule and wearing Terminator Armour can choose to make a Deathwing Assault.
Immediatly after determining Warlord Traits, tell your opponent which units are making a Deathwing Assault, and make a secret note on weather it happens during turn 1 or turn 2. All units chosen arrive then with no need to roll for deep strike reserves.</description></rule><rule id="1e78a1d3-86fd-50f4-20ad-f1bcb9084ba4-6ed3225" name="Independant Character" hidden="false" page="0"><description>Independent Characters can join and leave other non-vehicle non-'loner' units. Although Independent Characters may join with other Independent Characters to form a powerful multi-character unit.
An Independent Character counts as having joined a unit if he ends his move within 2" of them, if he is within 2" of more than one unit you must declare which unit he is joining.
An Independent Character may leave his unit and join another one in the same movement phase, but he may not join a unit in any other phase.
An Independent Character cannot join or leave a unit that is locked in combat or falling back, he also may not leave a unit that has gone to ground.

Look out Sir is taken on a 2+

If a unit with an Independent Character in it has fallen to below 25% they test as if they had 25% remaning

When an Independent Character joins a unit he looses all special rules that the unit does not have unless the rule says it applys to the unit (eg Stubborn) and vice versa

If the unit is suffering from ongoing effects (eg blind, soul blaze) and the Independent Character leaves the unit, he is still suffering from those effects as well, but they to not transfer to a new unit he joins.</description></rule><rule id="9168b0b9-7ca6-d5a7-3893-b3e464f69b51-6ed3225" name="Inner Circle" hidden="false" page="28"><description>Fearless and Preferred Enemy (Chaos Space Marines)</description></rule><rule id="34f8cdd0-c9c8-e9f8-c4e9-8f3b7f08d3fc-6ed3225" name="Vengeful Strike" hidden="false" page="44"><description>When a model with this rule arrives from Deep Strike, it treats all ranged weapons as having Twin Linked until end of turn.</description></rule></rules><selectionEntries><selectionEntry id="82df67ef-a3fc-d0db-af83-7f7c89def565-6ed3225" name="Iron Halo" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="82df67ef-a3fc-d0db-af83-7f7c89def565-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="82df67ef-a3fc-d0db-af83-7f7c89def565-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="cbbfcc72-e20a-cbc8-9f1e-28d7bd9abffb-6ed3225" name="Iron Halo" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c1792ac5-23c0-83d5-fbea-618dc2a41992-6ed3225" name="Terminator Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c1792ac5-23c0-83d5-fbea-618dc2a41992-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c1792ac5-23c0-83d5-fbea-618dc2a41992-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d76cd98e-25d3-0f10-9f4f-3f2b7fe519b5-6ed3225" name="Terminator Armour" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="65"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">2+/5++, have the Bulky, Deep Strike, Relentless, Deathwing Assault and Vengeful Strike special rules, and may not make sweeping advances.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">65</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7ea025b1-1f36-01da-1016-e7afd06fd81c-6ed3225" name="Teleport Homer" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7ea025b1-1f36-01da-1016-e7afd06fd81c-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7ea025b1-1f36-01da-1016-e7afd06fd81c-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="963a39a8-9b7b-dc7f-03f8-df7e857d32dc-6ed3225" name="Teleport Homer" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Friendly Terminators do not scatter when placed within 6", model must have started the turn on the board</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="31f0df69-2560-e2b9-f0a4-7d8b90d4b70b-6ed3225" name="Weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="aefde39b-2523-8640-8c14-b26969d20f07-6ed3225"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="31f0df69-2560-e2b9-f0a4-7d8b90d4b70b-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="31f0df69-2560-e2b9-f0a4-7d8b90d4b70b-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="aefde39b-2523-8640-8c14-b26969d20f07-6ed3225" name="Storm Bolter and Sword of Silence" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="aefde39b-2523-8640-8c14-b26969d20f07-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="40909e0a-1b0d-e98b-2084-80350c7ab233-6ed3225" name="Sword of Silence" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Fleshbane, Master Crafted</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile><profile id="afb4dbeb-f07c-a921-2721-c5b6d97f3a15-6ed3225" name="Storm Bolter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="56"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">24"</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">4</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">5</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Assault 2</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">56</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5f6b334f-8116-54ec-0b33-526a455f5376-6ed3225" name="Thunder Hammer and Storm Shield" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5f6b334f-8116-54ec-0b33-526a455f5376-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3118d143-74c8-42fe-228e-5e46df1253d1-6ed3225" name="Thunder Hammer" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="61"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">x2</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">2</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Concussive, Specialist Weapon, Unwieldy</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile><profile id="508750ef-cc91-6cee-c5db-3a4a057f815e-6ed3225" name="Storm Shield" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++ but can never count as having 2 close combat weapons</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="818f884a-ff45-86da-93c7-f9654b1bf970-6ed3225" name="Twin Lightning Claws" hidden="false" collective="false" import="true" type="upgrade" page="56"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="818f884a-ff45-86da-93c7-f9654b1bf970-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="fe88b57f-1655-faef-5fca-62c179265e1a-6ed3225" name="Lightning Claws" hidden="false" typeId="mh6-576561706f6e23232344415441232323" typeName="Weapon" page="60"><characteristics><characteristic name="Range" typeId="mh6-52616e676523232344415441232323">-</characteristic><characteristic name="Strength" typeId="mh6-537472656e67746823232344415441232323">User</characteristic><characteristic name="AP" typeId="mh6-415023232344415441232323">3</characteristic><characteristic name="Type" typeId="mh6-5479706523232344415441232323">Melee, Shred, Specialist Weapon</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">60</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="ecdaacdf-dedf-b731-5234-7874996ff995-6ed3225" name="Chaplain" hidden="false" collective="false" import="true" type="model" page="30"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="equalTo" value="0" field="selections" scope="force" childId="mh-al-971c8ac3-1351-8b76-8576-f7cd9f85ab84" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><categoryLinks><categoryLink name="HQ" hidden="false" id="ecdaacdf-dedf-b731-5234-7874996ff995-slot-6ed3225" targetId="ac8d-efba-1884-d3ad" primary="true" /></categoryLinks><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="90" /></costs><rules><rule id="d83620ea-41cd-18ea-86ff-77cec3bca740-6ed3225" name="Independant Character" hidden="false" page="0"><description>Independent Characters can join and leave other non-vehicle non-'loner' units. Although Independent Characters may join with other Independent Characters to form a powerful multi-character unit.
An Independent Character counts as having joined a unit if he ends his move within 2" of them, if he is within 2" of more than one unit you must declare which unit he is joining.
An Independent Character may leave his unit and join another one in the same movement phase, but he may not join a unit in any other phase.
An Independent Character cannot join or leave a unit that is locked in combat or falling back, he also may not leave a unit that has gone to ground.

Look out Sir is taken on a 2+

If a unit with an Independent Character in it has fallen to below 25% they test as if they had 25% remaning

When an Independent Character joins a unit he looses all special rules that the unit does not have unless the rule says it applys to the unit (eg Stubborn) and vice versa

If the unit is suffering from ongoing effects (eg blind, soul blaze) and the Independent Character leaves the unit, he is still suffering from those effects as well, but they to not transfer to a new unit he joins.</description></rule><rule id="64406d3f-9c96-17c5-e0bc-aa7ae6b32700-6ed3225" name="Zealot" hidden="false" page="43"><description>Unit this Character is joined to has Fearless and Hatred (Everything)</description></rule></rules><selectionEntries><selectionEntry id="78f1e2e8-ec2b-8fbc-958e-959ef656c641-6ed3225" name="Rosarius" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="78f1e2e8-ec2b-8fbc-958e-959ef656c641-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="78f1e2e8-ec2b-8fbc-958e-959ef656c641-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="522daad9-8f2f-8f74-629e-2af412fcdab7-6ed3225" name="Rosarius" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d8fb291a-1c0f-962b-9c71-0d8030434ff7-6ed3225" name="Power Armour" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" /></costs><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d8fb291a-1c0f-962b-9c71-0d8030434ff7-minSelections-6ed3225" includeChildSelections="false" includeChi