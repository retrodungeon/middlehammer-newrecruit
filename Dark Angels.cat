        <selectionEntry id="mh-rad-dark-angels-4863-a07f-6d59-b8e4" name="Legion Storm Eagle Assault Gunship" publicationId="ca571888--pubN80998" page="57" hidden="false" collective="false" import="true" type="upgrade">
