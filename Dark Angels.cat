" typeId="mh6-5361766523232344415441232323">3+ / 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">30</characteristic></characteristics></profile><profile id="45063325-4aee-f1d2-dc71-8a921714b0c7-6ed3225" name="Space Marine Bike" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Change unit type to Bike, and gives +1 to Toughness. has built-in Twinlinked Bolter.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles><rules><rule id="ad91d170-2b88-84b4-7552-3c82e5eb18e2-6ed3225" name="Skilled Rider" hidden="false" page="41"><description>Automatically passes Dangerous Terrain and recieves +1 to Jink saves</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup><selectionEntryGroup id="a34cb35d-f34f-8da6-85eb-909b85befdc5-6ed3225" name="Chapter Relics" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="05accc68-10f8-b2c6-ff4d-ab1fa856671a-6ed3225" name="Foe Smiter" hidden="false" collective="false" import="true" type="upgrade" page="67"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="05accc68-10f8-b2c6-ff4d-ab1fa856671a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="05accc68-10f8-b2c6-ff4d-ab1fa856671a-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><profiles><profile id="5081ba35-27ee-8061-740a-f725f31be975-6ed3225" name="Foe Smiter" hidden="false" typeId="mh6-576561706f6e23232344415441232323" t