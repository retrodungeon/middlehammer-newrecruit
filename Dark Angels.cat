5479706523232344415441232323">Melee, Concussive (replaces chain sword in the options)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">61</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f61b8a27-1263-98d3-38ea-5af58d448d24-6ed3225" name="Special Issue Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="2697bd79-1e2f-102e-fbe4-037c32a783cc-6ed3225" name="Auspex" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2697bd79-1e2f-102e-fbe4-037c32a783cc-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4996688a-bb4c-d799-693b-efa210144651-6ed3225" name="Auspex" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Forego shooting to make an enemy unit within 12" reduce it's cover save by 1, untill the end of the phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7eebb388-d784-39fb-c81c-c0ad997ea582-6ed3225" name="Combat Shield" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7eebb388-d784-39fb-c81c-c0ad997ea582-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6d7d0a7d-6634-a283-281a-46027ebe3173-6ed3