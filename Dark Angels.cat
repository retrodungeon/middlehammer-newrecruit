        <rule id="0d6fd111-c31a-1e88-d015-7864ef01b893-bf89a" name="Rad Charge" page="150" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>On a to-wound roll of 6, two wounds are caused independent from the targets toughness.</description>
