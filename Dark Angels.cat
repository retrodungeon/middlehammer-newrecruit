      <profiles>
        <profile id="6e0a-34b2-f900-44a3-bf89a" name="Typhon Heavy Siege Tank" hidden="false" typeId="725a358c-765b-498c-8de5-399fc0c0725f">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
