"6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="98b997e9-aa07-3879-d78b-03628d2220f0-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="cd65f802-14df-fd37-12e5-9755cfd44f4b-6ed3225" name="Digital Weapons" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">Re-roll a single failed to wound roll in the assault phase</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6eab35ee-814e-f7dc-4c5d-d40791748d38-6ed3225" name="Porta-Rack" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6eab35ee-814e-f7dc-4c5d-d40791748d38-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="0b965c28-4958-b391-178b-d93088c560f0-6ed3225" name="Porta-Rack" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">If the bearer kills an enemy character in close combat he gains Preferred Enemy (current enemy) and Fear. In addition any enemy Teleport Homers and Locator Beacons can be used as if they were your own.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="87b1117d-c31e-a1f5-99e7-dc9bdc0479ad-6ed3225" name="Conversion Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="15" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="87b1117d-c31e-a1f5-99e7-dc9bdc0479ad-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b799249e-a3fb-025d-19f0-3bae0a8f9491-6ed3225" name="Conversion Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">4++, at the end of a phase in which the bearer passes one or more saves, all units within D6" take a Blind test, frientlies may reroll failed rolls</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d2752e05-216c-f94c-081f-2f887d2680db-6ed3225" name="Displacer Field" hidden="false" collective="false" import="true" type="upgrade" page="63"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d2752e05-216c-f94c-081f-2f887d2680db-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="970a7265-94ff-25e5-ccb3-3543eda53a91-6ed3225" name="Displacer Field" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="63"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">3++, at the end of the phase in which the bearer passes one or more saves granted by the field, he suffers 'displacement'. Scatter D6", reduce by the minimum ammount to prevent colliding with another unit or impassible terrain. In the assault phase this happens at Initive step 1, after all blows have been struck and he may immediatly make a pile in move.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">63</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="40a5982f-fba8-3dd4-01ef-3d7514e08f41-6ed3225" name="Power Field Generator" hidden="false" collective="false" import="true" type="upgrade" page="64"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="30" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="40a5982f-fba8-3dd4-01ef-3d7514e08f41-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="500706b2-03e8-0a8e-3fc3-f27fc26af573-6ed3225" name="Power Field Generator" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="64"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All models within 3" have 4++</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">64</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup><selectionEntryGroup id="669fe0c2-d58a-c87d-9a2e-5a3d43af081a-6ed3225" name="Sacred Standards" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="669fe0c2-d58a-c87d-9a2e-5a3d43af081a-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="roster" shared="true" id="669fe0c2-d58a-c87d-9a2e-5a3d43af081a-maxInRoster-6ed3225" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3d745e3e-0d13-6d34-0a77-87325947aeab-6ed3225" name="Retribution" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="45" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3d745e3e-0d13-6d34-0a77-87325947aeab-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="be6adaab-3e73-94eb-e3ef-2ff5107915f6-6ed3225" name="Standard of Retribution" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinning tests and have the Counter-Attack special rule.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d11c157c-8c69-61ee-a5df-9574b59a9b11-6ed3225" name="Devastation" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="65" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d11c157c-8c69-61ee-a5df-9574b59a9b11-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="fea64256-e412-7994-1340-17b5991ecc78-6ed3225" name="Standard of Devastation" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angels within 12" re-roll failed morale and pinnning tests and all models within 6" treat their bolters as Salvo 2/4 instead of rapid fire.</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7d765c1c-ec5d-e790-3432-03ce44d16656-6ed3225" name="Fortitude" hidden="false" collective="false" import="true" type="upgrade" page="66"><costs><cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="85" /></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7d765c1c-ec5d-e790-3432-03ce44d16656-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5eeb5aff-10d9-448b-4578-9c7e7f9e1b53-6ed3225" name="Standard of Fortitude" hidden="false" typeId="mh6-57617267656172204974656d23232344415441232323" typeName="Wargear Item" page="66"><characteristics><characteristic name="Description" typeId="mh6-4465736372697074696f6e23232344415441232323">All friendly Dark Angles within 12" re-roll failed morale and pinning tests and have Feel no Pain (5+)</characteristic><characteristic name="Pg" typeId="mh6-506723232344415441232323">66</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="752dd257-e1d1-086b-bf61-1ed8e79b6160-6ed3225" name="Sergeant Options" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup id="52051a5c-ac55-30c4-73aa-03265c70219b-6ed3225" name="Right Hand" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="52051a5c-ac55-30c4-73aa-03265c70219b-minSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="52051a5c-ac55-30c4-73aa-03265c70219b-maxSelections-6ed3225" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5fef0ddb-ae01-d5af-535d-ae877214a80e-6ed3225" 