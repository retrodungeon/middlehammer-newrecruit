      <rules>
        <rule id="mh-rad-dark-angels-4a28-1a1c-d853-5feb" name="Rite of Command" publicationId="ca571888--pubN89821" page="233" hidden="false">
          <description>Confers the Master of the Legion special rule, and may take a Legion Command Squad.  Must be the army's Warlord, unless their Legion's Primarch is also present.  A Delegatus may be taken in armies below the 1000pt threshold for Master of the Legion.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0.0" />
