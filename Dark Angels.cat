            <selectionEntry id="89e8-6ef1-f419-5cb1-bf89a" name="Plasma Blastgun" page="0" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="c402-7dae-d027-e0dd-bf89a" name="Plasma Blastgun (Rapid)" page="136" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48">
                  <profiles />
                  <rules />
                  <infoLinks />
