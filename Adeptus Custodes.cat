    <selectionEntry id="1aa5-3857-2b14-0929-4c9a0" name="Venerable Contemptor Dreadnought" hidden="false" collective="false" type="model">
      <profiles>
        <profile id="e1b0-8b0d-840b-1820-4c9a0" name="Contemptor Dreadnought" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Walker">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic>
