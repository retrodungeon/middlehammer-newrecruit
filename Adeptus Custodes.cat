            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Walker)</characteristic>
          </characteristics>
        </profile>
        <profile id="e6ba-6a42-329f-1a27-4c9a0" name="Atomantic Shielding" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Contemptor Dreadnought has a 5+ invulnerable save against all shooting attacks, and a 6+ invulnerable save against all close combat attacks. In addition, if a Contemptor Dreadnought suffers an Explodes! result on the Vehicle Damage table, add 1" to the radius of the resulting explosion.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="2916-a2d1-0e2a-353b-4c9a0" name="Venerable" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If a Venerable Contemptor Dreadnought suffers a penetrating hit, you can make your opponent re-roll the result on the Vehicle Damage table.  You must accept the second result, even if it is worse than the first.</description>
        </rule>
      </rules>
