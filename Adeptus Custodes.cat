                    <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="115c-0fc0-6960-be0d-4c9a0" type="max" />
                  </constraints>
                  <selectionEntries />
                  <selectionEntryGroups />
                  <entryLinks />
