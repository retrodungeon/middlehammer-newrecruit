            <selectionEntry id="3de0-2887-d103-8c8a-4c9a0" name="Storm Shield" hidden="false" collective="false" type="upgrade">
              <profiles>
                <profile id="5215-abf9-6a93-cd29-4c9a0" name="Storm Shield" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <profiles />
                  <rules />
                  <infoLinks />
                  <modifiers />
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A storm shield confers a 3+ invulnerable save. In addition, a model equipped with a storm shield can never claim the +1 Attack for being armed with two Melee weapons in an assault.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
