                  <profiles>
                    <profile id="4e36-538b-a577-a600-4c9a0" name="Sentinel Blade (Melee)" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
