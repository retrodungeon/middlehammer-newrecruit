                    <profile id="33a8-0d0b-4d6f-fca4-4c9a0" name="Sentinel Blade (Ranged)" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <profiles />
