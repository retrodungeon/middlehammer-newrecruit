  </sharedSelectionEntries><sharedRules><rule id="8f9c-799a-a4b4-9939-4c9a0" name="Aegis of The Emperor" hidden="false">
      <profiles />
      <rules />
      <infoLinks />
      <modifiers />
      <description>​Models with the Aegis of the Emperor special rule have a 5+ invulnerable save. In addition, non-vehicle models with the Aegis of the Emperor special rule have the Eternal Warrior special rule.</description>
    </rule>
