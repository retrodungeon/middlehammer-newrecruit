    <selectionEntry id="0a97-8b37-7990-e884-2d6b9" name="Bulwark of Purity" page="125" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="64ba-09d4-5d54-41ae-2d6b9" name="Bulwark Formation" page="125" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>While three or more units from this Formation are on the battlefield, you can add 1 to the result when making Deny the Witch tests.</description>
        </rule>
        <rule id="dd90-972c-5672-4a0f-2d6b9" name="Aura of Purity" page="125" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>While three or more units from this Formation are on the battlefield, if any unit from this Formation successfully manifests the Banishment psychic power, all units with the Daemon special rule within 12" of any unit from this Formation are affected.</description>
        </rule>
      </rules>
      <infoLinks />
      <modifiers />
      <constraints />
