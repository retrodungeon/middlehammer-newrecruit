              <rules>
                <rule name="Auspex" id="8bc2-c581-ba7f-438f" hidden="false">
                  <description>If enemy infiltrators set up within 4D6" of a model with a auspex, then that model and the unit they are attached to is allowed to take a "free" shot at them. These shots are taken before the battle begins and may cause the infiltrators to fall back.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Bionics" id="27f2-5158-f13e-ddac" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9a68-840b-e146-4865" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
              </constraints>
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
              </costs>
              <infoLinks>
                <infoLink name="Bionics" id="0dcd-024d-4daa-ee0b" hidden="false" targetId="4053-eb3d-7c9c-241d" type="rule" />
              </infoLinks>
            </selectionEntry>
            <selectionEntry name="Frag Grenades" id="3626-4659-e452-c36b" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="eb41-d8cf-eed2-c934" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
