    <selectionEntry name="Inquisitorial Storm Troopers" id="d993-03c9-2f08-148a" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Troops" id="3482-074e-f53d-c2a6" hidden="false" primary="true" targetId="default-category" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <selectionEntries>
