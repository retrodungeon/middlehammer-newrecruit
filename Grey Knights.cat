          </infoLinks>
        </selectionEntry>
        <selectionEntry name="Improved Comms" id="cc1c-5a0a-6afa-4411" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="274e-b89c-88c6-bd04" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="20" />
          </costs>
          <rules>
            <rule name="Improved Comms" id="e00a-4575-167a-3a60" hidden="false">
              <description>The Imperial Guard player may re-roll one Reserves roll per turn, and to re-roll the dice when checking to see if an enemy unit or obstacle is hit by a preliminary bombardment</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mine Sweeper" id="fa4a-3101-43cf-b408" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="88ea-3553-b372-c356" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1503-9582-1e82-99d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Mine Sweeper" id="1b3c-c013-2a5e-002e" hidden="false">
              <description>The vehicle may enter a minefield without being attack. Any minefield the vehicle moves across is cleared and removed from play</description>
            </rule>
          </rules>
        </selectionEntry>
