          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1503-9582-1e82-99d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0" />
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Armoured Crew Compartment" id="28e6-5f73-f613-d4fe" hidden="false">
              <description>The vehicle no longer counts as being open-topped.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Camo Netting" id="b1ab-af97-a681-188f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2b8f-f20f-2d3a-418d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="1" />
          </costs>
          <rules>
            <rule name="Camo Netting" id="8eef-ec12-daa1-3bb6" hidden="false">
              <description>In scenarios using the Hidden Set-up rules, vehicles carrying camo netting can be set up hidden anywhere in their deployment zone.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Extra Armor" id="1199-e306-57d1-acb9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="70fd-cf0c-48de-77c8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="5" />
          </costs>
          <rules>
            <rule name="Extra Armour" id="af3b-6cdc-1d1c-df37" hidden="false">
              <description>Count the 'Crew Stunned' result as 'Crew Shaken' instead</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Hunter-Killer Missile" id="7de6-6150-8297-4e29" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
