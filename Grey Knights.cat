    <profile id="f2685b65-fe71-d41f-17aa-cebcfbe2ba6b-2d6b9" name="Warlord Trait: First to the Fray" page="86" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
