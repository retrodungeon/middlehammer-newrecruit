        <infoLink name="Grand Strategy" id="ecb4-fe85-9ddc-a3f0" hidden="false" targetId="bf13-d912-60cd-055b" type="profile" />
        <infoLink name="Preffered Enemy (Daemons)" id="b5c1-a6dd-f9d1-88a5" hidden="false" targetId="fab9-6d08-37e0-a3e3" type="profile" />
