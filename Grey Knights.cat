        <profile name="Psyber-eagle" id="100b-aac7-905b-a947" hidden="false" typeId="8e6f-7553-28c5-95a0" typeName="Weapons">
          <characteristics>
            <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24"</characteristic>
            <characteristic name="Str." typeId="1ebc-896c-43de-904a">4</characteristic>
            <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">-</characteristic>
            <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault D6</characteristic>
            <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c" />
          </characteristics>
        </profile>
        <profile name="Spy Network" id="5b90-87c3-e5fb-7210" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Coteaz allows you to re-roll the dice to Seize the Initiative, or force your opponent to re-roll his.</characteristic>
          </characteristics>
        </profile>
        <profile name="I've Been Expecting You" id="8da4-138d-1559-f86f" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If an enemy unit arrives from reserve within 12" of Coteaz and within his line of sight, Coteaz and his unit can immediately make an out-of-sequence shooting attack against it. There is no limit on how many times the ability can be used in a turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Formosa" id="6d4c-5b5d-f50a-21cc" hidden="false" typeId="ccb3-7790-3139-7975" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Inquisitorial Henchmen warbands are Troop choices in an army that includes Inquisitor Coteaz, and are not limited by the number of Inquisitors in your army.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Inquisitor Karamazov" id="c799-6985-b404-9720" hidden="false" import="true" type="unit">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="200" />
      </costs>
      <infoLinks>
        <infoLink name="Inquisitor Karamazov" id="d8b4-de52-e08a-29d7" hidden="false" targetId="ff6b-62b5-65fa-bdc0" type="profile" />
