        <infoLink name="Krak Grenades" id="4d9f-671d-898d-189a" hidden="false" targetId="0a12-b99c-7d80-2ab6" type="profile" />
        <infoLink name="Psyk-out Grenade" id="6222-d7fb-7654-96c8" hidden="false" targetId="70b8-e5d9-c9d5-2e4e" type="profile" />
