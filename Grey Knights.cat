    <selectionEntry id="287c5df6-fa4e-9a0c-0a46-34e1d1067625-2d6b9" name="Brother-Captain Stern" page="61" hidden="false" collective="false" type="unit">
      <profiles />
      <rules>
        <rule id="a3f2e5db-bc77-52e9-7699-ee91818b03d4-2d6b9" name="The Strands of Fate" page="61" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>May re-roll one to hit, to wound or saving throw each phase.
However, for every dice re-rolled using this rule, your opponent can re-roll one to hit, to wound or saving throw at any point later in the game.</description>
        </rule>
        <rule id="beba5b32-6419-f217-cd2b-89390dcc9124-2d6b9" name="Zone of Banishment" page="61" hidden="false">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
          <description>If he succesfully manifests the Banishment psychic power, it targets all enemy units with the Daemon rule that are within 12" instead of a single unit within 24"</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f8cf6f67-c941-ec78-b0d0-7f91ea551426-2d6b9" hidden="false" targetId="bd5040b8-5a79-28c3-8006-68b2f0c9ccd9-2d6b9" type="rule">
