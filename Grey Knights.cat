        <infoLink name="Thunder Hammer" id="4789-5f9b-3f5a-85be" hidden="false" targetId="9edb-0754-ffa8-9dd3" type="profile">
          <modifiers>
            <modifier field="name" type="set" value="Daemonhammer" />
          </modifiers>
