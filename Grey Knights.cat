      <profiles>
        <profile id="f0165c62-77bd-2ab3-49eb-94c8ee19ad40-2d6b9" name="Cerastus Knight-Acheron" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413">
          <profiles />
          <rules />
          <infoLinks />
          <modifiers />
