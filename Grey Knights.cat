    <selectionEntry name="Inquisitorial Storm Troopers" id="d993-03c9-2f08-148a" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Troops" id="3482-074e-f53d-c2a6" hidden="false" primary="true" targetId="default-category" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
      </costs>
      <selectionEntries>
        <selectionEntry name="Krak Grenades" id="d16d-b555-4a4c-e986" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f83a-fa45-55cf-ac54" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <costs>
            <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="0" />
          </costs>
          <modifiers>
            <modifier field="6f18-a8fc-2c5b-9517" type="increment" value="2">
              <repeats>
                <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1" />
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Storm Troopers" id="be5f-3517-982d-bc1e" collective="false" defaultSelectionEntryId="584f-34cb-ab6f-bdc3" hidden="false" import="true">
          <constraints>
            <constraint id="b5c7-93e7-da3c-f8e8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="5" />
            <constraint id="1fe0-5e68-02bb-c85a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="10" />
          </constraints>
          <selectionEntries>
            <selectionEntry name="Storm Trooper" id="584f-34cb-ab6f-bdc3" collective="false" hidden="false" import="true" type="model">
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="10" />
