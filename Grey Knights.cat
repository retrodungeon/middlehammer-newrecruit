          <rules>
            <rule name="Null Rod" id="659b-9ff4-b9f4-7695" hidden="false">
              <description>Counts as a power weapon. Additionally, no psychic powers whatsoever may affect the character with this item or the squad he has joined, regardless of the source. Also, the character with this item and the squad he is with may not use any psychic powers of their own.</description>
            </rule>
