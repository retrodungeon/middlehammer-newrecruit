            <modifier field="name" type="set" value="Sword of St. Aquitaine" />
            <modifier field="492d-1f80-b777-26f2" type="set" value="If the Sword of St. Aquitaine causes a wound, and the bearer passes the Daemon Weapon Mastery test, he may force the entirety of the next game turn to be fought using the Night Fight rules." />
