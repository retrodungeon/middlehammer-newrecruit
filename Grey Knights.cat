          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="The Strands of Fate" id="d35c-9cf1-1396-3483" hidden="false">
          <description>Stern may re-roll one dice roll per phase. Keep track of the number of times Stern uses this ability in a given player turn. His opponent may subsequently re-roll one of his own units' dice per use of this ability. Any re-rolls garnered in this way that are not utilised by the end of the player turn are lost.</description>
        </rule>
        <rule name="Daemonic Nemesis" id="c451-7c48-58bd-24ab" hidden="false">
          <description>Any opponent using the Adversaries rules may upgrade their Greater Daemon to Chaos to a Lord of Change for no extra cost.</description>
        </rule>
      </rules>
      <selectionEntries>
